            <form method="post" action="/Identity/Account/Logout">
                <button type="submit" class="nav-link text-danger w-100 text-start sign-out-button">
                    <i class="fas fa-sign-out-alt"></i><span class="nav-label"> Sign Out</span>
                </button>
            </form>
        </div>
    </nav>
</div>

<BlazorContextMenu.ContextMenu Id="navLinkContextMenu" Template="Win11Style">
    <BlazorContextMenu.Item OnClick="HandleAddToFavourites" CssClass="win11-menu-item">
        <i class="fas fa-star win11-icon text-warning"></i> Add to Favourites
    </BlazorContextMenu.Item>
</BlazorContextMenu.ContextMenu>

@code {
    [Parameter]
    public bool IsSidebarCollapsed { get; set; }

    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }

    private int favouritesCount = 0;
    private bool isFinancialExpanded = false;
    private bool isAccountSetupExpanded = false;
    private bool isBankSetupExpanded = false;
    private bool isVouchersExpanded = false;
    private bool isReportsExpanded = false;
    private bool isExportExpanded = false;
    private bool isPayrollExpanded = false;
    private bool isHR_Reports_Expanded = false;
    private bool isSystemExpanded = false;
    private bool isSystem_Reports_Expanded = false;
    private bool isStockExpanded = false;
    private bool isProductionExpanded = false;
    private bool isCompanyExpanded = false;
    private bool isDashboardsExpanded = false;
    private bool isIntraOfficeExpanded = false;
    private bool isSetupsExpanded = false;

    protected override async Task OnInitializedAsync()
    {
        await PermissionService.InitializeAsync();
        FavouriteService.OnFavouritesChanged += HandleFavouritesChanged;
        await LoadFavouritesCountAsync();
    }

    private async Task LoadFavouritesCountAsync()
    {
        try
        {
            favouritesCount = await FavouriteService.GetCurrentUserFavouritesCountAsync();
        }
        catch { }
    }

    private void HandleFavouritesChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadFavouritesCountAsync();
            StateHasChanged();
        });
    }

    private async Task HandleAddToFavourites(BlazorContextMenu.ItemClickEventArgs e)
    {
        if (e.Data is NavLinkContextData data && !string.IsNullOrEmpty(data.OptionId))
        {
            var result = await FavouriteService.AddCurrentUserFavouriteAsync(
                data.OptionId,
                data.Title,
                data.Href,
                data.Module,
                data.IconClass);

            NotificationService.Notify(new Radzen.NotificationMessage
            {
                Severity = result.Success ? Radzen.NotificationSeverity.Success : Radzen.NotificationSeverity.Info,
                Summary = "Favourites",
                Detail = result.Message,
                Duration = 3000
            });
        }
    }

    public void Dispose()
    {
        FavouriteService.OnFavouritesChanged -= HandleFavouritesChanged;
    }

    private async Task ToggleNavMenu()
    {
        await OnToggleSidebar.InvokeAsync();
    }

    private void NavigateSetups()
    {
        if (!PermissionService.HasModuleAccess("Setup")) return;
        isSetupsExpanded = !isSetupsExpanded;
        NavigationManager.NavigateTo("/setup");
    }

    private void NavigateDashboards()
    {
        if (!PermissionService.HasModuleAccess("DashBoard")) return;
        isDashboardsExpanded = !isDashboardsExpanded;
        NavigationManager.NavigateTo("/dashboards");
    }

    private void NavigateIntraOffice()
    {
        if (!PermissionService.HasModuleAccess("IntraOffice")) return;
        isIntraOfficeExpanded = !isIntraOfficeExpanded;
        NavigationManager.NavigateTo("/office");
    }

    // Dual-action: navigate to module dashboard AND expand its sub-menu
    private void NavigateFinancial()
    {
        if (!PermissionService.HasModuleAccess("Accounts")) return;
        isFinancialExpanded = !isFinancialExpanded;
        NavigationManager.NavigateTo("/financial");
    }

    private void NavigateExport()
    {
        if (!PermissionService.HasModuleAccess("Export")) return;
        isExportExpanded = !isExportExpanded;
        NavigationManager.NavigateTo("/export");
    }

    private void NavigatePayroll()
    {
        if (!PermissionService.HasModuleAccess("Payroll")) return;
        isPayrollExpanded = !isPayrollExpanded;
        NavigationManager.NavigateTo("/payroll");
    }

    private void NavigateStock()
    {
        if (!PermissionService.HasModuleAccess("Stock")) return;
        isStockExpanded = !isStockExpanded;
        NavigationManager.NavigateTo("/stock");
    }

    private void NavigateProduction()
    {
        if (!PermissionService.HasModuleAccess("Production")) return;
        isProductionExpanded = !isProductionExpanded;
        NavigationManager.NavigateTo("/production");
    }

    private void NavigateCompany()
    {
        if (!PermissionService.HasModuleAccess("Company")) return;
        isCompanyExpanded = !isCompanyExpanded;
        NavigationManager.NavigateTo("/company");
    }

    // Sub-section toggles (no navigation — these expand nested sub-groups)
    private void ToggleAccountSetup() => isAccountSetupExpanded = !isAccountSetupExpanded;
    private void ToggleVouchers()     => isVouchersExpanded     = !isVouchersExpanded;
    private void ToggleBanks()        => isBankSetupExpanded    = !isBankSetupExpanded;
    private void ToggleReports()      => isReportsExpanded      = !isReportsExpanded;
    private void ToggleHR_Reports()       => isHR_Reports_Expanded    = !isHR_Reports_Expanded;
    private void ToggleSystem()           => isSystemExpanded         = !isSystemExpanded;
    private void ToggleSystem_Reports()   => isSystem_Reports_Expanded= !isSystem_Reports_Expanded;
}