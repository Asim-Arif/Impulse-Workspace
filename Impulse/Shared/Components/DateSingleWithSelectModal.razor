@using DataAccessLibrary.Models.ReportModels
@using DataAccessLibrary.Models.ViewModels
@using Blazored.Typeahead

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); z-index: 1050; font-family: 'Calibri', 'Segoe UI', sans-serif;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content cip-rpt-modal-content">
                <div class="modal-header cip-rpt-header d-flex align-items-center justify-content-between">
                    <h5 class="modal-title text-white">
                        <i class="fa fa-filter me-2"></i>@Title
                    </h5>
                    <button type="button" class="btn btn-sm p-0 border-0" @onclick="Cancel">
                        <span class="cip-rpt-close-x">&times;</span>
                    </button>
                </div>

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="mb-1 fw-bold" style="font-size: 0.85rem;">@LabelText</label>
                        <BlazoredTypeahead SearchMethod="SearchData" EnableDropDown="true"
                                           Data="LocalOptions"
                                           TValue="GenericDropDownModel"
                                           TItem="GenericDropDownModel"
                                           Value="SelectedOption"
                                           ValueChanged="SelectedResultChanged"
                                           ValueExpression="@(() => SelectedOption)"
                                           Placeholder="@PlaceholderText"
                                           MaximumSuggestions="1000">
                            <SelectedTemplate Context="selectedcard">
                                @SelectedOption?.DropDownValue_Description
                            </SelectedTemplate>
                            <ResultTemplate Context="result">
                                @result.DropDownValue_Description
                            </ResultTemplate>
                        </BlazoredTypeahead>
                    </div>

                    <div class="cip-rpt-date-display text-center mb-3">
                        <small class="text-uppercase text-muted fw-normal" style="font-size: 0.7rem; letter-spacing: 1px; opacity: 0.8;">
                            Target Date
                        </small>
                        <h4 class="text-primary mb-0">
                            @SelectedDate.ToString("dd-MMM-yyyy")
                        </h4>
                    </div>

                    <div class="form-group">
                        <label class="mb-1 fw-bold" style="font-size: 0.85rem;">Select Date:</label>
                        <input type="date" class="form-control cip-rpt-input-custom" @bind="SelectedDate" />
                    </div>
                </div>

                <div class="modal-footer border-0 bg-light">
                    <button class="btn btn-outline-secondary border-0" @onclick="Cancel">Cancel</button>
                    <button class="btn btn-primary px-4 fw-bold shadow-sm" style="border-radius: 8px;" @onclick="Submit">
                        Generate Report
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = "Select Parameters";
    [Parameter] public string LabelText { get; set; } = "Select Department:";
    [Parameter] public string PlaceholderText { get; set; } = "Search Department...";

    private bool IsVisible { get; set; }
    private DateTime SelectedDate { get; set; } = DateTime.Today;

    private List<GenericDropDownModel> LocalOptions { get; set; } = new();
    private GenericDropDownModel? SelectedOption { get; set; }

    private TaskCompletionSource<DateSingleSelectionResult> _tcs = null!;

    public Task<DateSingleSelectionResult> Show(List<GenericDropDownModel> dataOptions, string title = "Select Parameters")
    {
        LocalOptions = dataOptions;
        Title = title;
        SelectedOption = LocalOptions.FirstOrDefault();
        SelectedDate = DateTime.Today;

        IsVisible = true;
        _tcs = new TaskCompletionSource<DateSingleSelectionResult>();
        StateHasChanged();
        return _tcs.Task;
    }

    private async Task<IEnumerable<GenericDropDownModel>> SearchData(string searchText)
    {
        return await Task.FromResult(LocalOptions
            .Where(x => x.DropDownValue_Description?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
            .ToList());
    }

    private async Task SelectedResultChanged(GenericDropDownModel? selectedValue)
    {
        SelectedOption = selectedValue;
        await Task.CompletedTask;
    }

    private void Submit()
    {
        IsVisible = false;
        _tcs.SetResult(new DateSingleSelectionResult(
            true,
            SelectedDate,
            SelectedOption?.DropDownValue_ID ?? "0"
        ));
    }

    private void Cancel()
    {
        IsVisible = false;
        _tcs.SetResult(new DateSingleSelectionResult(
            false,
            DateTime.MinValue,
            string.Empty
        ));
    }
}
