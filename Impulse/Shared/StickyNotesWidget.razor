@using DataAccessLibrary.Models.IntraOffice
@using Impulse.Services.IntraOffice
@using Microsoft.AspNetCore.Components.Authorization
@implements IAsyncDisposable
@inject IIntraOfficeService IntraOfficeService
@inject ILogger<StickyNotesWidget> Logger
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject StickyNoteNotificationService NotificationService

@foreach (var note in notes)
{
    var isMin = minimizedNoteIds.Contains(note.Id);
    <div class="sticky-note @(isMin ? "minimized" : "")" 
         style="left:@(note.XPos)px; top:@(note.YPos)px; background-color: @GetColorHex(note.Color);" 
         id="note-@note.Id" data-id="@note.Id">
        
        <div class="sticky-header" onmousedown="beginDragJS(event, @note.Id)">
            <select onchange="saveNoteJS(@note.Id)" id="note-color-@note.Id" class="note-color-picker">
                <option value="yellow" selected="@(note.Color == "yellow")">Yellow</option>
                <option value="blue" selected="@(note.Color == "blue")">Blue</option>
                <option value="pink" selected="@(note.Color == "pink")">Pink</option>
                <option value="green" selected="@(note.Color == "green")">Green</option>
            </select>
            <div class="d-flex align-items-center gap-1">
                <button type="button" class="btn-minimize-note" @onclick:stopPropagation="true" @onclick="() => ToggleMinimize(note.Id)" title="@(isMin ? "Expand note" : "Minimize note")">
                    <i class="bi @(isMin ? "bi-arrows-expand" : "bi-dash")" id="minimize-icon-@note.Id"></i>
                </button>
                <button type="button" class="btn-close-note" @onclick:stopPropagation="true" @onclick="() => DeleteNote(note.Id)" title="Close note">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        </div>
        
        <div id="note-content-@note.Id" class="note-content-wrapper @(isMin ? "d-none" : "")">
            <textarea class="sticky-content" onchange="saveNoteJS(@note.Id)" id="note-text-@note.Id" placeholder="Type your note here...">@note.Content</textarea>
            
            <div class="sticky-footer">
                <small><i class="bi bi-clock"></i> Reminder:</small>
                <input type="datetime-local" class="reminder-input" onchange="saveNoteJS(@note.Id)" id="note-reminder-@note.Id" value="@(note.ReminderTime?.ToString("yyyy-MM-ddTHH:mm"))" />
            </div>
        </div>
    </div>
}

<button class="btn-add-note" id="btn-add-sticky-note" onclick="triggerAddNewNote()" title="Add Sticky Note • Drag to move">
    <i class="bi bi-grip-vertical opacity-50" style="pointer-events: none; margin-right: 2px;"></i>
    <i class="bi bi-sticky" style="pointer-events: none;"></i>
    <span style="margin-left: 6px; pointer-events: none;">New Sticky Note</span>
</button>

<style>
    .sticky-note {
        position: fixed !important;
        z-index: 99999 !important;
        width: 300px;
        min-height: 250px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        padding: 10px 12px;
        border-radius: 8px;
        pointer-events: auto;
        display: flex;
        flex-direction: column;
        color: #212529;
        box-sizing: border-box;
    }
    
    .sticky-note.minimized {
        min-height: unset !important;
        height: auto !important;
        padding-bottom: 6px !important;
    }
    
    .sticky-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        cursor: move;
        user-select: none;
    }
    
    .note-color-picker {
        background: rgba(255,255,255,0.65);
        border: 1px solid rgba(0,0,0,0.1);
        border-radius: 4px;
        font-size: 0.75rem;
        padding: 2px 4px;
        color: #333;
        cursor: pointer;
    }
    
    .btn-close-note, .btn-minimize-note {
        background: transparent;
        border: none;
        color: #333;
        cursor: pointer;
        opacity: 0.7;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .btn-close-note:hover { opacity: 1; background: rgba(220, 53, 69, 0.2); color: #dc3545; }
    .btn-minimize-note:hover { opacity: 1; background: rgba(0, 0, 0, 0.08); }
    
    .sticky-content {
        flex: 1;
        width: 100%;
        min-height: 140px;
        background: transparent;
        border: none;
        resize: none;
        font-family: inherit;
        font-size: 0.82rem;
        color: #212529;
        outline: none;
    }
    
    .sticky-footer {
        margin-top: 8px;
        font-size: 0.75rem;
        border-top: 1px solid rgba(0,0,0,0.1);
        padding-top: 6px;
    }
    
    .reminder-input {
        width: 100%;
        margin-top: 4px;
        font-size: 0.75rem;
        padding: 4px 6px;
        border: 1px solid rgba(0,0,0,0.2);
        border-radius: 4px;
        background: rgba(255,255,255,0.7);
        color: #333;
    }
    
    .note-content-wrapper {
        display: flex;
        flex-direction: column;
        flex: 1;
    }
    .note-content-wrapper.hidden {
        display: none !important;
    }
    .btn-add-note {
        display: none !important;
    }
    
    .btn-add-note:hover {
        transform: scale(1.05);
        box-shadow: 0 6px 14px rgba(0,0,0,0.25);
    }

    .btn-add-note.is-dragging {
        cursor: grabbing !important;
        transform: scale(1.08) !important;
        box-shadow: 0 10px 24px rgba(0,0,0,0.35) !important;
        transition: none !important;
    }
    
    .drag-overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        z-index: 1049;
        cursor: grabbing;
    }
</style>

@code {
    public static event Action? OnAddStickyNote;
    public static void TriggerAddNote() => OnAddStickyNote?.Invoke();

    private List<StickyNote> notes = new();
    private DotNetObjectReference<StickyNotesWidget>? objRef;
    private string? UserId;
    private HashSet<int> minimizedNoteIds = new();

    protected override async Task OnInitializedAsync()
    {
        OnAddStickyNote += HandleExternalAddNote;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            UserId = user.Identity.Name;
        }

        if (string.IsNullOrEmpty(UserId))
        {
            UserId = "Zeeshan";
        }

        notes = await IntraOfficeService.GetStickyNotesAsync(UserId);
        NotificationService.OnReminderReceived += HandleReminder;
    }

    private void HandleExternalAddNote()
    {
        InvokeAsync(async () => await AddNewNote());
    }

    private void HandleReminder(string targetUserId, int noteId, string content, string color)
    {
        if (targetUserId == UserId)
        {
            InvokeAsync(async () => 
            {
                try { 
                    await JSRuntime.InvokeVoidAsync("playReminderSound"); 
                } 
                catch (Exception ex) { 
                    Logger.LogError(ex, "Failed to invoke playReminderSound JS.");
                }
                
                try {
                    await JSRuntime.InvokeVoidAsync("alert", $"STICKY NOTE REMINDER!\n\n{content}");
                } catch { }
                
                var existingNote = notes.FirstOrDefault(n => n.Id == noteId);
                if (existingNote != null)
                {
                    existingNote.IsReminderSent = true;
                    StateHasChanged();
                }
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("registerStickyNotesWidget", objRef);
        }
        await JSRuntime.InvokeVoidAsync("initStickyNoteButtonDrag");
    }

    public ValueTask DisposeAsync()
    {
        OnAddStickyNote -= HandleExternalAddNote;
        NotificationService.OnReminderReceived -= HandleReminder;
        objRef?.Dispose();
        return ValueTask.CompletedTask;
    }

    private void ToggleMinimize(int id)
    {
        if (!minimizedNoteIds.Add(id))
            minimizedNoteIds.Remove(id);
        StateHasChanged();
    }

    private async Task DeleteNote(int id)
    {
        notes.RemoveAll(n => n.Id == id);
        StateHasChanged();
        if (!string.IsNullOrEmpty(UserId))
        {
            await IntraOfficeService.DeleteStickyNoteAsync(id, UserId);
        }
    }

    [JSInvokable]
    public async Task DeleteNoteJS(int id)
    {
        await DeleteNote(id);
    }

    [JSInvokable]
    public async Task ToggleMinimizeJS(int id)
    {
        ToggleMinimize(id);
        await Task.CompletedTask;
    }

    [JSInvokable]
    public async Task UpdateNotePositionJS(int id, int x, int y)
    {
        var note = notes.FirstOrDefault(n => n.Id == id);
        if (note != null)
        {
            note.XPos = x;
            note.YPos = y;
            await IntraOfficeService.SaveStickyNoteAsync(note);
        }
    }

    [JSInvokable]
    public async Task UpdateNoteContentJS(int id, string content, string color, string? reminderTime)
    {
        var note = notes.FirstOrDefault(n => n.Id == id);
        if (note != null)
        {
            note.Content = content;
            note.Color = color;
            if (DateTime.TryParse(reminderTime, out var dt))
                note.ReminderTime = dt;
            else
                note.ReminderTime = null;

            await IntraOfficeService.SaveStickyNoteAsync(note);
        }
    }

    [JSInvokable]
    public async Task AddNewNoteJS()
    {
        await AddNewNote();
    }

    private async Task AddNewNote()
    {
        if (string.IsNullOrEmpty(UserId))
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            UserId = authState.User.Identity?.Name ?? "Zeeshan";
        }

        int baseLeft = Math.Min(350 + ((notes.Count % 6) * 40), 900);
        int baseTop = 120 + ((notes.Count % 6) * 35);

        var newNote = new StickyNote
        {
            UserId = UserId,
            Content = "",
            Color = "yellow",
            XPos = baseLeft,
            YPos = baseTop,
            CreatedAt = DateTime.UtcNow
        };

        newNote.Id = await IntraOfficeService.SaveStickyNoteAsync(newNote);
        notes.Add(newNote);
        StateHasChanged();
    }

    private string GetColorHex(string color)
    {
        return color switch
        {
            "yellow" => "#fff9c4",
            "blue" => "#bbdefb",
            "pink" => "#f8bbd0",
            "green" => "#c8e6c9",
            _ => "#fff9c4"
        };
    }
}
