@using DataAccessLibrary.Models.IntraOffice
@using Impulse.Services.IntraOffice
@using Microsoft.AspNetCore.Components.Authorization
@inject IAiAssistantService AiAssistantService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="ai-chatbot-root" id="ai-chatbot-root">
    @if (!isOpen)
    {
        <!-- Floating Pill / Button -->
        <button class="ai-chatbot-launcher shadow-lg" id="ai-chatbot-launcher" @onclick="ToggleOpen" title="Chat with IntraBot Enterprise AI • Drag to move">
            <div class="ai-launcher-glow"></div>
            <i class="bi bi-grip-vertical opacity-50" style="pointer-events: none; margin-right: -2px; font-size: 0.85rem;"></i>
            <div class="ai-launcher-icon">
                <i class="bi bi-stars"></i>
            </div>
            <span class="ai-launcher-text">Ask AI</span>
            <span class="ai-launcher-badge"></span>
        </button>
    }
    else
    {
        <!-- Expanded Chat Window -->
        <div class="ai-chatbot-window shadow-lg animate-fade-in" id="ai-chatbot-window">
            <!-- Header -->
            <div class="ai-chat-header" id="ai-chat-header" style="cursor: grab;" title="Drag to move chat window">
                <div class="d-flex align-items-center gap-2">
                    <div class="ai-avatar-wrap">
                        <div class="ai-avatar-icon">
                            <i class="bi bi-robot"></i>
                        </div>
                        <span class="ai-online-status"></span>
                    </div>
                    <div>
                        <div class="ai-header-title">IntraBot Enterprise AI</div>
                        <div class="ai-header-subtitle">
                            <span class="ai-engine-badge">GPT-4o Frontier AI</span> • Online
                        </div>
                    </div>
                </div>
                <div class="ai-header-actions">
                    <button class="ai-btn-icon" @onclick="GoToFullPage" title="Open Full Screen Assistant">
                        <i class="bi bi-arrows-angle-expand"></i>
                    </button>
                    <button class="ai-btn-icon" @onclick="ClearChat" title="Clear Conversation">
                        <i class="bi bi-trash3"></i>
                    </button>
                    <button class="ai-btn-icon" @onclick="ToggleOpen" title="Minimize Chat">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <!-- Quick Action Suggestion Chips -->
            <div class="ai-quick-chips">
                <button type="button" class="ai-chip" @onclick='() => SendQuickPrompt("What are my pending tasks and their priorities?")'>
                    📋 My Tasks
                </button>
                <button type="button" class="ai-chip" @onclick='() => SendQuickPrompt("Do I have any pending minutes awaiting my approval?")'>
                    📄 Pending Minutes
                </button>
                <button type="button" class="ai-chip" @onclick='() => SendQuickPrompt("Give me a comprehensive executive summary of our CRM pipeline and financials.")'>
                    📊 Pipeline Valuation
                </button>
                <button type="button" class="ai-chip" @onclick='() => SendQuickPrompt("What are the latest company announcements?")'>
                    📢 Announcements
                </button>
                <button type="button" class="ai-chip" @onclick='() => SendQuickPrompt("What products do we manufacture and export?")'>
                    📦 Product Catalog
                </button>
                <button type="button" class="ai-chip" @onclick='() => SendQuickPrompt("Draft a professional follow-up email to a prospective client.")'>
                    ✉️ Draft Email
                </button>
            </div>

            <!-- Chat Message List -->
            <div class="ai-chat-body" id="ai-chat-scroll-container">
                @foreach (var msg in messages)
                {
                    <div class="ai-msg-row @(msg.Role == "user" ? "user-row" : "bot-row")">
                        @if (msg.Role != "user")
                        {
                            <div class="ai-bot-avatar">
                                <i class="bi bi-stars"></i>
                            </div>
                        }

                        <div class="ai-msg-bubble @(msg.Role == "user" ? "user-bubble" : "bot-bubble")">
                            <div class="ai-msg-content">
                                @((MarkupString)FormatMarkdown(msg.Content))
                            </div>
                            <div class="ai-msg-meta d-flex align-items-center justify-content-between">
                                <span class="ai-timestamp">@msg.Timestamp.ToString("HH:mm")</span>
                                @if (msg.Role != "user")
                                {
                                    <div class="ai-bubble-tools">
                                        <button class="ai-tool-btn" @onclick="() => SpeakMessage(msg.Content)" title="Read aloud">
                                            <i class="bi bi-volume-up"></i>
                                        </button>
                                        <button class="ai-tool-btn" @onclick="() => CopyMessage(msg.Content)" title="Copy text">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                            @if (msg.Role != "user")
                            {
                                var followUps = ExtractSuggestions(msg.Content);
                                if (followUps.Any())
                                {
                                    <div class="ai-followup-wrap mt-2 pt-2 border-top">
                                        <small class="text-muted d-block mb-1" style="font-size: 0.68rem;"><i class="bi bi-lightning-charge text-warning me-1"></i>Suggested Next Steps:</small>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var f in followUps)
                                            {
                                                <button type="button" class="ai-followup-btn" @onclick="() => SendQuickPrompt(f)">
                                                    @f
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        @if (msg.Role == "user")
                        {
                            <div class="ai-user-avatar">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        }
                    </div>
                }

                @if (isThinking)
                {
                    <div class="ai-msg-row bot-row">
                        <div class="ai-bot-avatar">
                            <i class="bi bi-stars"></i>
                        </div>
                        <div class="ai-msg-bubble bot-bubble thinking-bubble">
                            <div class="ai-typing-indicator">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                            <span class="ai-thinking-label">IntraBot is thinking...</span>
                        </div>
                    </div>
                }
            </div>

            <!-- Voice Recording Indicator -->
            @if (isListeningVoice)
            {
                <div class="ai-voice-active-bar">
                    <span class="ai-recording-dot"></span>
                    <span>Listening to your voice... Speak now</span>
                    <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-auto" @onclick="StopVoice">
                        Cancel
                    </button>
                </div>
            }

            <!-- Input Footer -->
            <div class="ai-chat-footer">
                <div class="ai-input-wrap">
                    <textarea class="ai-input-field" 
                              rows="1"
                              placeholder="Ask anything (company data, analysis, general query)..." 
                              @bind="userInput" 
                              @bind:event="oninput"
                              @onkeydown="HandleKeyDown"
                              disabled="@isThinking"></textarea>
                    
                    <button class="ai-action-btn @(isListeningVoice ? "btn-voice-active" : "")" 
                            @onclick="ToggleVoiceInput" 
                            title="@(isListeningVoice ? "Stop voice dictation" : "Voice dictation (speech-to-text)")"
                            type="button">
                        <i class="bi @(isListeningVoice ? "bi-mic-fill text-danger" : "bi-mic")"></i>
                    </button>

                    <button class="ai-action-btn ai-send-btn" 
                            @onclick="SendMessageAsync" 
                            disabled="@(string.IsNullOrWhiteSpace(userInput) || isThinking)"
                            title="Send query"
                            type="button">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
                <div class="ai-footer-note">
                    <small>IntraBot Enterprise • AI answers any query & integrates live ERP/CRM data</small>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .ai-chatbot-root {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9999;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    /* Floating Launcher Button */
    .ai-chatbot-launcher {
        display: none !important;
        position: relative;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #db2777 100%);
        color: #ffffff;
        border: none;
        border-radius: 50px;
        cursor: grab;
        user-select: none;
        -webkit-user-select: none;
        touch-action: none;
        font-weight: 600;
        font-size: 0.85rem;
        letter-spacing: 0.3px;
        box-shadow: 0 10px 25px -5px rgba(99, 102, 241, 0.5), 0 8px 10px -6px rgba(99, 102, 241, 0.3);
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .ai-chatbot-launcher:hover {
        transform: translateY(-2px) scale(1.03);
        box-shadow: 0 15px 30px -5px rgba(99, 102, 241, 0.6), 0 10px 12px -6px rgba(99, 102, 241, 0.4);
    }

    .ai-chatbot-launcher.is-dragging {
        cursor: grabbing !important;
        transform: scale(1.06) !important;
        box-shadow: 0 18px 36px -5px rgba(99, 102, 241, 0.7) !important;
        transition: none !important;
    }

    .ai-launcher-icon {
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        animation: pulseIcon 2s infinite ease-in-out;
    }

    .ai-launcher-badge {
        position: absolute;
        top: -3px;
        right: -3px;
        width: 12px;
        height: 12px;
        background-color: #10b981;
        border: 2px solid #ffffff;
        border-radius: 50%;
        animation: pulseGreen 1.8s infinite;
    }

    @@keyframes pulseGreen {
        0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
        100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    @@keyframes pulseIcon {
        0%, 100% { transform: rotate(0deg) scale(1); }
        50% { transform: rotate(15deg) scale(1.15); }
    }

    /* Expanded Chat Window */
    .ai-chatbot-window {
        width: 410px;
        max-width: calc(100vw - 32px);
        height: 590px;
        max-height: calc(100vh - 80px);
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid rgba(226, 232, 240, 0.9);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.18), 0 0 0 1px rgba(0, 0, 0, 0.05);
        animation: chatSlideUp 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes chatSlideUp {
        from { opacity: 0; transform: translateY(20px) scale(0.97); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* Header */
    .ai-chat-header {
        padding: 12px 16px;
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .ai-avatar-wrap {
        position: relative;
    }

    .ai-avatar-icon {
        width: 34px;
        height: 34px;
        background: linear-gradient(135deg, #6366f1, #a855f7);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        color: white;
    }

    .ai-online-status {
        position: absolute;
        bottom: -2px;
        right: -2px;
        width: 10px;
        height: 10px;
        background: #10b981;
        border: 2px solid #1e1b4b;
        border-radius: 50%;
    }

    .ai-header-title {
        font-weight: 700;
        font-size: 0.88rem;
        letter-spacing: 0.2px;
        color: #f8fafc;
    }

    .ai-header-subtitle {
        font-size: 0.72rem;
        color: #cbd5e1;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .ai-engine-badge {
        background: rgba(99, 102, 241, 0.3);
        padding: 1px 6px;
        border-radius: 4px;
        font-weight: 600;
        font-size: 0.65rem;
        color: #a5b4fc;
    }

    .ai-header-actions {
        display: flex;
        gap: 4px;
    }

    .ai-btn-icon {
        background: rgba(255, 255, 255, 0.08);
        border: none;
        color: #e2e8f0;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        cursor: pointer;
        transition: background 0.15s;
    }

    .ai-btn-icon:hover {
        background: rgba(255, 255, 255, 0.2);
        color: #ffffff;
    }

    /* Quick Chips */
    .ai-quick-chips {
        display: flex;
        gap: 6px;
        padding: 8px 12px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        overflow-x: auto;
        scrollbar-width: none;
        white-space: nowrap;
    }

    .ai-quick-chips::-webkit-scrollbar {
        display: none;
    }

    .ai-chip {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        color: #334155;
        border-radius: 14px;
        padding: 3px 10px;
        font-size: 0.72rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s;
        flex-shrink: 0;
    }

    .ai-chip:hover {
        background: #eef2ff;
        border-color: #6366f1;
        color: #4f46e5;
    }

    /* Chat Body */
    .ai-chat-body {
        flex: 1;
        padding: 14px 12px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
        background: #fdfdfd;
    }

    .ai-msg-row {
        display: flex;
        gap: 8px;
        max-width: 90%;
    }

    .bot-row {
        align-self: flex-start;
    }

    .user-row {
        align-self: flex-end;
        flex-direction: row-reverse;
    }

    .ai-bot-avatar {
        width: 26px;
        height: 26px;
        background: #e0e7ff;
        color: #4338ca;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .ai-user-avatar {
        width: 26px;
        height: 26px;
        background: #f1f5f9;
        color: #64748b;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .ai-msg-bubble {
        padding: 9px 13px;
        border-radius: 12px;
        font-size: 0.81rem;
        line-height: 1.45;
        position: relative;
        word-break: break-word;
    }

    .bot-bubble {
        background: #f1f5f9;
        color: #1e293b;
        border-bottom-left-radius: 2px;
        border: 1px solid #e2e8f0;
    }

    .user-bubble {
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        color: #ffffff;
        border-bottom-right-radius: 2px;
    }

    .ai-msg-content p {
        margin-bottom: 6px;
    }

    .ai-msg-content p:last-child {
        margin-bottom: 0;
    }

    .ai-msg-content ul, .ai-msg-content ol {
        margin: 4px 0 6px 18px;
        padding: 0;
    }

    .ai-msg-content code {
        background: rgba(0, 0, 0, 0.06);
        padding: 1px 4px;
        border-radius: 4px;
        font-size: 0.76rem;
        color: #be185d;
    }

    .user-bubble code {
        background: rgba(255, 255, 255, 0.2);
        color: #ffffff;
    }

    .ai-msg-content pre {
        background: #0f172a;
        color: #f8fafc;
        padding: 8px;
        border-radius: 6px;
        font-size: 0.74rem;
        overflow-x: auto;
        margin: 6px 0;
    }

    .ai-msg-meta {
        margin-top: 4px;
        font-size: 0.65rem;
        color: #64748b;
    }

    .user-bubble .ai-timestamp {
        color: rgba(255, 255, 255, 0.75);
    }

    .ai-bubble-tools {
        display: flex;
        gap: 6px;
    }

    .ai-tool-btn {
        background: transparent;
        border: none;
        color: #64748b;
        cursor: pointer;
        padding: 0;
        font-size: 0.75rem;
        transition: color 0.15s;
    }

    .ai-tool-btn:hover {
        color: #4f46e5;
    }

    /* Thinking Indicator */
    .thinking-bubble {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
    }

    .ai-typing-indicator {
        display: flex;
        gap: 4px;
    }

    .ai-typing-indicator span {
        width: 6px;
        height: 6px;
        background: #6366f1;
        border-radius: 50%;
        animation: typingDot 1.2s infinite ease-in-out;
    }

    .ai-typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
    .ai-typing-indicator span:nth-child(3) { animation-delay: 0.4s; }

    @@keyframes typingDot {
        0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
        40% { transform: scale(1); opacity: 1; }
    }

    .ai-thinking-label {
        font-size: 0.75rem;
        color: #64748b;
        font-style: italic;
    }

    /* Voice Bar */
    .ai-voice-active-bar {
        background: #fee2e2;
        border-top: 1px solid #fca5a5;
        padding: 6px 12px;
        font-size: 0.73rem;
        color: #991b1b;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ai-recording-dot {
        width: 8px;
        height: 8px;
        background-color: #ef4444;
        border-radius: 50%;
        animation: pulseRed 1s infinite;
    }

    @@keyframes pulseRed {
        0% { transform: scale(0.9); opacity: 1; }
        50% { transform: scale(1.3); opacity: 0.6; }
        100% { transform: scale(0.9); opacity: 1; }
    }

    /* Footer / Input */
    .ai-chat-footer {
        padding: 10px 12px;
        background: #ffffff;
        border-top: 1px solid #e2e8f0;
    }

    .ai-input-wrap {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        padding: 4px 8px;
        transition: border-color 0.15s;
    }

    .ai-input-wrap:focus-within {
        border-color: #6366f1;
        box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.15);
    }

    .ai-input-field {
        flex: 1;
        border: none;
        background: transparent;
        font-size: 0.81rem;
        outline: none;
        resize: none;
        padding: 4px 0;
        max-height: 80px;
        color: #1e293b;
    }

    .ai-action-btn {
        background: transparent;
        border: none;
        color: #64748b;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.88rem;
        cursor: pointer;
        transition: all 0.15s;
    }

    .ai-action-btn:hover {
        background: #e2e8f0;
        color: #1e293b;
    }

    .ai-send-btn {
        background: #4f46e5 !important;
        color: #ffffff !important;
    }

    .ai-send-btn:disabled {
        background: #cbd5e1 !important;
        color: #94a3b8 !important;
        cursor: not-allowed;
    }

    .ai-footer-note {
        text-align: center;
        margin-top: 4px;
        color: #94a3b8;
        font-size: 0.65rem;
    }

    /* Followup Action Pills */
    .ai-followup-wrap {
        border-color: rgba(0, 0, 0, 0.08) !important;
    }

    .ai-followup-btn {
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        padding: 3px 8px;
        font-size: 0.68rem;
        color: #334155;
        cursor: pointer;
        text-align: left;
        transition: all 0.15s ease;
        line-height: 1.2;
    }

    .ai-followup-btn:hover {
        background: #e0e7ff;
        border-color: #6366f1;
        color: #4338ca;
    }

    .ai-table {
        font-size: 0.72rem;
    }
</style>

@code {
    public static event Action? OnToggleAiChatbot;
    public static void TriggerToggle() => OnToggleAiChatbot?.Invoke();

    private bool isOpen = false;
    private bool isThinking = false;
    private bool isListeningVoice = false;
    private string userInput = "";
    private string currentUserId = "";
    private List<ChatMessageDto> messages = new();
    private DotNetObjectReference<AiChatbotWidget>? dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        OnToggleAiChatbot += HandleExternalToggle;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserId = user.Identity.Name ?? "";
        }

        // Initial welcome message
        messages.Add(new ChatMessageDto
        {
            Role = "assistant",
            Content = "Hello! I am **IntraBot Enterprise AI**. I'm connected in real-time to your tasks, pending minutes, company announcements, and CRM pipeline.\n\nYou can ask me about anything—from checking your workload and draft documents to general business or technical questions!",
            Timestamp = DateTime.Now
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
        }

        if (isOpen)
        {
            await JSRuntime.InvokeVoidAsync("scrollChatToBottom", "ai-chat-scroll-container");
            await JSRuntime.InvokeVoidAsync("initAiChatbotWindowPosition");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("initAiChatbotLauncherPosition");
        }
    }

    private void ToggleOpen()
    {
        isOpen = !isOpen;
    }

    private void GoToFullPage()
    {
        isOpen = false;
        Navigation.NavigateTo("/ai-assistant");
    }

    private void ClearChat()
    {
        messages.Clear();
        messages.Add(new ChatMessageDto
        {
            Role = "assistant",
            Content = "Conversation cleared. How can I help you next?",
            Timestamp = DateTime.Now
        });
    }

    private async Task SendQuickPrompt(string prompt)
    {
        userInput = prompt;
        await SendMessageAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessageAsync();
        }
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(userInput) || isThinking) return;

        var text = userInput.Trim();
        userInput = "";

        // Add user message
        messages.Add(new ChatMessageDto
        {
            Role = "user",
            Content = text,
            Timestamp = DateTime.Now
        });

        isThinking = true;
        StateHasChanged();
        await JSRuntime.InvokeVoidAsync("scrollChatToBottom", "ai-chat-scroll-container");

        try
        {
            var reply = await AiAssistantService.GetEnterpriseChatResponseAsync(text, currentUserId, messages);
            messages.Add(new ChatMessageDto
            {
                Role = "assistant",
                Content = reply,
                Timestamp = DateTime.Now
            });
        }
        catch (Exception ex)
        {
            messages.Add(new ChatMessageDto
            {
                Role = "assistant",
                Content = $"Sorry, I encountered an unexpected error: {ex.Message}",
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            isThinking = false;
            StateHasChanged();
            await JSRuntime.InvokeVoidAsync("scrollChatToBottom", "ai-chat-scroll-container");
        }
    }

    private async Task ToggleVoiceInput()
    {
        if (isListeningVoice)
        {
            await JSRuntime.InvokeVoidAsync("stopVoiceDictation");
            isListeningVoice = false;
        }
        else
        {
            if (dotNetRef != null)
            {
                isListeningVoice = true;
                await JSRuntime.InvokeVoidAsync("startVoiceDictation", dotNetRef, "OnVoiceTranscript");
            }
        }
    }

    private async Task StopVoice()
    {
        await JSRuntime.InvokeVoidAsync("stopVoiceDictation");
        isListeningVoice = false;
    }

    [JSInvokable]
    public void OnVoiceTranscript(string transcript)
    {
        isListeningVoice = false;
        if (!string.IsNullOrWhiteSpace(transcript))
        {
            userInput = transcript;
            _ = SendMessageAsync();
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnVoiceError(string error)
    {
        isListeningVoice = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnVoiceEnd()
    {
        isListeningVoice = false;
        StateHasChanged();
    }

