@code {
    private class ActiveToast
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public AppNotification Notification { get; set; } = new();
        public DateTime Timestamp { get; set; } = DateTime.UtcNow;
    }

    private readonly List<ActiveToast> activeToasts = new();
    private readonly HashSet<string> seenNotificationIds = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, DateTime> recentNotificationFingerprints = new(StringComparer.OrdinalIgnoreCase);
    private string? currentUserId;
    private string? currentUserName;
    private readonly HashSet<string> currentUserRoles = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> currentUserAliases = new(StringComparer.OrdinalIgnoreCase);
    private IntraUserProfile? currentUserProfile;
    private System.Threading.Timer? pollTimer;
    private DateTime sessionStartTime = DateTime.UtcNow;
    private bool isDisposed;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        NotificationService.OnNotificationReceived += HandleNotificationReceived;

        await RefreshAuthStateAsync();

        // Seed initial notifications so we don't spam old notifications as toasts on startup
        if (!string.IsNullOrEmpty(currentUserName) || currentUserAliases.Count > 0)
        {
            try
            {
                var userKey = currentUserName ?? currentUserId ?? "";
                var recents = NotificationService.GetRecentNotifications(userKey, currentUserAliases);
                lock (seenNotificationIds)
                {
                    foreach (var n in recents)
                    {
                        // Any notification older than 1 minute or already read is marked as seen
                        if (n.CreatedAt < sessionStartTime.AddSeconds(-60) || n.IsRead)
                        {
                            seenNotificationIds.Add(n.Id);
                        }
                    }
                }
            }
            catch { }
        }

        StartPolling();
    }

    private void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshAuthStateAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshAuthStateAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                currentUserName = user.Identity.Name?.Trim();
                currentUserId = (user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                    ?? user.FindFirst("sub")?.Value
                    ?? currentUserName)?.Trim();

                currentUserRoles.Clear();
                foreach (var claim in user.FindAll(ClaimTypes.Role))
                {
                    if (!string.IsNullOrWhiteSpace(claim.Value))
                    {
                        currentUserRoles.Add(claim.Value.Trim());
                    }
                }

                if (!string.IsNullOrEmpty(currentUserName))
                {
                    try
                    {
                        currentUserProfile = await IntraOfficeService.GetUserProfileAsync(currentUserName);
                    }
                    catch { }
                }

                RebuildUserAliases();
            }
            else
            {
                currentUserName = null;
                currentUserId = null;
                currentUserProfile = null;
                currentUserRoles.Clear();
                currentUserAliases.Clear();
            }
        }
        catch { }
    }

    private void RebuildUserAliases()
    {
        currentUserAliases.Clear();
        if (!string.IsNullOrWhiteSpace(currentUserName)) currentUserAliases.Add(currentUserName.Trim());
        if (!string.IsNullOrWhiteSpace(currentUserId)) currentUserAliases.Add(currentUserId.Trim());
        if (currentUserProfile != null)
        {
            if (!string.IsNullOrWhiteSpace(currentUserProfile.UserName)) currentUserAliases.Add(currentUserProfile.UserName.Trim());
            if (!string.IsNullOrWhiteSpace(currentUserProfile.EmpID)) currentUserAliases.Add(currentUserProfile.EmpID.Trim());
            if (currentUserProfile.UserID > 0) currentUserAliases.Add(currentUserProfile.UserID.ToString());
            if (!string.IsNullOrWhiteSpace(currentUserProfile.FullName)) currentUserAliases.Add(currentUserProfile.FullName.Trim());
        }
        foreach (var r in currentUserRoles)
        {
            if (!string.IsNullOrWhiteSpace(r)) currentUserAliases.Add(r.Trim());
        }
    }

    private void StartPolling()
    {
        pollTimer?.Dispose();
        // Poll every 5 seconds to guarantee cross-computer / cross-instance toast delivery
        pollTimer = new System.Threading.Timer(async _ =>
        {
            if (isDisposed) return;
            await CheckForNewNotificationsAsync();
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task CheckForNewNotificationsAsync()
    {
        if (string.IsNullOrEmpty(currentUserName) && currentUserAliases.Count == 0)
        {
            return;
        }

        try
        {
            var userKey = currentUserName ?? currentUserId ?? "";
            var recents = NotificationService.GetRecentNotifications(userKey, currentUserAliases);
            if (recents == null || recents.Count == 0) return;

            var newUnreadNotifications = new List<AppNotification>();

            lock (seenNotificationIds)
            {
                foreach (var notif in recents)
                {
                    if (notif == null || notif.IsRead || notif.IsReadReceipt) continue;
                    if (seenNotificationIds.Contains(notif.Id)) continue;

                    // Show notifications created recently (within last 5 minutes or since session started)
                    if (notif.CreatedAt >= sessionStartTime.AddMinutes(-5))
                    {
                        if (MatchesCurrentUser(notif.TargetUserId) && !IsSentByMe(notif))
                        {
                            seenNotificationIds.Add(notif.Id);
                            if (!IsDuplicateBurst(notif))
                            {
                                newUnreadNotifications.Add(notif);
                            }
                        }
                    }
                    else
                    {
                        seenNotificationIds.Add(notif.Id);
                    }
                }
            }

            foreach (var notif in newUnreadNotifications)
            {
                await ShowToastAsync(notif);
            }
        }
        catch
        {
            // Ignore polling errors
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(currentUserName))
        {
            try
            {
                var pushState = await JSRuntime.InvokeAsync<string>("impulsePush.getPermissionState");
                if (pushState == "granted")
                {
                    await JSRuntime.InvokeVoidAsync("impulsePush.init", currentUserName, currentUserName);
                }
            }
            catch { }
        }
    }

    private bool MatchesCurrentUser(string? targetUserId)
    {
        if (string.IsNullOrWhiteSpace(targetUserId)) return true; // Broadcast
        var trimmed = targetUserId.Trim();
        if (currentUserAliases.Contains(trimmed)) return true;
        if (!string.IsNullOrEmpty(currentUserName) && string.Equals(trimmed, currentUserName, StringComparison.OrdinalIgnoreCase)) return true;
        if (!string.IsNullOrEmpty(currentUserId) && string.Equals(trimmed, currentUserId, StringComparison.OrdinalIgnoreCase)) return true;
        if (currentUserRoles.Contains(trimmed)) return true;
        if (currentUserProfile != null)
        {
            if (string.Equals(trimmed, currentUserProfile.UserName, StringComparison.OrdinalIgnoreCase)) return true;
            if (string.Equals(trimmed, currentUserProfile.EmpID, StringComparison.OrdinalIgnoreCase)) return true;
            if (currentUserProfile.UserID > 0 && string.Equals(trimmed, currentUserProfile.UserID.ToString(), StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }

    private bool IsSentByMe(AppNotification notification)
    {
        if (!string.IsNullOrWhiteSpace(notification.SenderName))
        {
            var sender = notification.SenderName.Trim();
            if (!string.IsNullOrEmpty(currentUserName) && string.Equals(sender, currentUserName, StringComparison.OrdinalIgnoreCase)) return true;
            if (!string.IsNullOrEmpty(currentUserId) && string.Equals(sender, currentUserId, StringComparison.OrdinalIgnoreCase)) return true;
            if (currentUserProfile != null && !string.IsNullOrEmpty(currentUserProfile.FullName) && string.Equals(sender, currentUserProfile.FullName, StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }

    private bool IsDuplicateBurst(AppNotification notif)
    {
        var fingerprint = $"{notif.Category}|{notif.Title?.Trim()}|{notif.Message?.Trim()}|{notif.TargetUserId?.Trim()}";
        var now = DateTime.UtcNow;

        lock (recentNotificationFingerprints)
        {
            // Prune entries older than 2 minutes
            var staleKeys = recentNotificationFingerprints.Where(kvp => (now - kvp.Value).TotalMinutes > 2).Select(kvp => kvp.Key).ToList();
            foreach (var key in staleKeys)
            {
                recentNotificationFingerprints.Remove(key);
            }

            // If an identical notification was received in the last 30 seconds, consider it a duplicate burst
            if (recentNotificationFingerprints.TryGetValue(fingerprint, out var lastSeen) && (now - lastSeen).TotalSeconds < 30)
            {
                return true;
            }

            recentNotificationFingerprints[fingerprint] = now;
            return false;
        }
    }

    private async Task HandleNotificationReceived(AppNotification notification)
    {
        if (notification == null || isDisposed) return;

        // Skip internal READ_SYNC signals and read receipts completely
        if (notification.Message == "READ_SYNC" || notification.IsReadReceipt) return;

        // Check if notification is meant for this user
        if (!string.IsNullOrWhiteSpace(notification.TargetUserId))
        {
            if (!MatchesCurrentUser(notification.TargetUserId))
            {
                return;
            }
        }
        else
        {
            // Broadcast notification: do not show toast to the sender themselves
            if (IsSentByMe(notification))
            {
                return;
            }
        }

        lock (seenNotificationIds)
        {
            if (seenNotificationIds.Contains(notification.Id)) return;
            seenNotificationIds.Add(notification.Id);
        }

        // Anti-spam debounce: suppress duplicate burst notifications with identical content within 30 seconds
        if (IsDuplicateBurst(notification)) return;

        await ShowToastAsync(notification);
    }

    private async Task ShowToastAsync(AppNotification notification)
    {
        var toast = new ActiveToast
        {
            Notification = notification
        };

        await InvokeAsync(() =>
        {
            // Do not show duplicate if a toast with the exact same ID, or same Title and Message is already actively visible
            if (activeToasts.Any(t => t.Notification.Id == notification.Id ||
                (string.Equals(t.Notification.Title, notification.Title, StringComparison.OrdinalIgnoreCase) &&
                 string.Equals(t.Notification.Message, notification.Message, StringComparison.OrdinalIgnoreCase))))
            {
                return;
            }

            activeToasts.Insert(0, toast);
            if (activeToasts.Count > 5)
            {
                activeToasts.RemoveAt(activeToasts.Count - 1);
            }
            StateHasChanged();
        });

        // Play audio chime and browser notification safely in background
        _ = Task.Run(async () =>
        {
            try
            {
                if (notification.Category == NotificationCategory.Meeting)
                {
                    await JSRuntime.InvokeVoidAsync("playMeetingAlertSound");
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("playNotificationSound");
                }
            }
            catch { }

            try
            {
                await JSRuntime.InvokeVoidAsync("showNotification", notification.Title, notification.Message);
            }
            catch { }
        });

        // Auto dismiss: 20 seconds for task/meeting alerts, 15 seconds for regular notifications
        var dismissMs = (notification.Category == NotificationCategory.Meeting || notification.Category == NotificationCategory.Task) ? 20000 : 15000;
        _ = Task.Run(async () =>
        {
            await Task.Delay(dismissMs);
            await InvokeAsync(() => DismissToast(toast.Id));
        });
    }

    private void DismissToast(string id)
    {
        var toast = activeToasts.FirstOrDefault(t => t.Id == id);
        if (toast != null)
        {
            activeToasts.Remove(toast);
            StateHasChanged();
        }
    }

    private void NavigateTo(AppNotification notification)
    {
        if (!string.IsNullOrEmpty(currentUserId))
        {
            NotificationService.MarkAsRead(notification.Id, currentUserId);
        }
        DismissToast(notification.Id);
        if (!string.IsNullOrEmpty(notification.ActionUrl))
        {
            Navigation.NavigateTo(notification.ActionUrl);
        }
    }

    private string GetToastClass(NotificationCategory category) => category switch
    {
        NotificationCategory.Message => "toast-message",
        NotificationCategory.Announcement => "toast-announcement",
        NotificationCategory.Minute => "toast-minute",
        NotificationCategory.Meeting => "toast-meeting",
        NotificationCategory.Task => "toast-task",
        NotificationCategory.Stock => "toast-task",
        _ => ""
    };

    private string GetCategoryIcon(NotificationCategory category) => category switch
    {
        NotificationCategory.Message => "bi-chat-dots-fill",
        NotificationCategory.Announcement => "bi-megaphone-fill",
        NotificationCategory.Minute => "bi-file-earmark-check-fill",
        NotificationCategory.Meeting => "bi-camera-video-fill",
        NotificationCategory.Task => "bi-check2-square",
        NotificationCategory.Stock => "bi-boxes",
        _ => "bi-bell-fill"
    };

    private string GetCategoryLabel(NotificationCategory category) => category switch
    {
        NotificationCategory.Message => "Message",
        NotificationCategory.Announcement => "Announcement",
        NotificationCategory.Minute => "Minute Approval",
        NotificationCategory.Meeting => "Meeting",
        NotificationCategory.Task => "Task",
        NotificationCategory.Stock => "Stock Alert",
        _ => "Notification"
    };

    public void Dispose()
    {
        isDisposed = true;
        pollTimer?.Dispose();
        NotificationService.OnNotificationReceived -= HandleNotificationReceived;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}
