@inherits LayoutComponentBase
@using Impulse.Services.IntraOffice
@using DataAccessLibrary.Models.IntraOffice
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IIntraOfficeService IntraOfficeService
@inject IAppNotificationService NotificationService
@inject IJSRuntime JSRuntime
@implements IDisposable

<link rel="stylesheet" href="css/intraoffice.css" />

<div class="app-layout">
    <aside class="sidebar @(sidebarOpen ? "open" : "")">
        <div class="sidebar-brand p-3 d-flex align-items-center gap-2 border-bottom border-dark">
            <i class="bi bi-diagram-3-fill text-primary fs-3"></i>
            <div>
                <div class="fw-bold text-white fs-6 lh-1">AWM Systems</div>
                <small class="text-muted fst-italic" style="font-size: 0.72rem;">Your Technology Partner</small>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">
                <!-- MAIN / DASHBOARDS -->
                <div class="nav-section-title">DASHBOARDS</div>
                <a href="/dashboards/executive" class="nav-item @(IsActive("/dashboards/executive"))">
                    <i class="bi bi-grid-1x2"></i> Executive Overview
                </a>
                <a href="/office" class="nav-item @(IsActive("/office"))">
                    <i class="bi bi-building"></i> Office Hub
                </a>
                <a href="/office/crm" class="nav-item @(IsActive("/office/crm"))">
                    <i class="bi bi-speedometer2"></i> CRM Pipeline
                </a>

                <!-- COLLABORATION & OFFICE -->
                <div class="nav-section-title mt-3">OFFICE & COLLABORATION</div>
                <a href="/office/chat" class="nav-item @(IsActive("/office/chat"))">
                    <i class="bi bi-chat-left-text"></i> Group Discussion
                </a>
                <a href="/office/messages" class="nav-item @(IsActive("/office/messages"))">
                    <i class="bi bi-envelope"></i> Direct Messages
                    @if (unreadCount > 0)
                    {
                        <span class="nav-badge" style="background: var(--danger, #ef4444); color: white;">@unreadCount</span>
                    }
                </a>
                <a href="/office/announcements" class="nav-item @(IsActive("/office/announcements"))">
                    <i class="bi bi-megaphone"></i> Announcements
                    @if (unreadAnnouncementsCount > 0)
                    {
                        <span class="nav-badge" style="background: var(--danger, #ef4444); color: white;">@unreadAnnouncementsCount</span>
                    }
                </a>
                <a href="/office/tasks" class="nav-item @(IsActive("/office/tasks"))">
                    <i class="bi bi-kanban"></i> Team Tasks
                    @if (unreadTasksCount > 0)
                    {
                        <span class="nav-badge" style="background: var(--danger, #ef4444); color: white;">@unreadTasksCount</span>
                    }
                </a>
                <a href="/office/minutes-approval" class="nav-item @(IsActive("/office/minutes-approval"))">
                    <i class="bi bi-file-earmark-text"></i> New Minutes
                </a>
                <a href="/office/minutes-list" class="nav-item @(IsActive("/office/minutes-list"))">
                    <i class="bi bi-list-columns-reverse"></i> Minutes List
                    @if (unreadMinutesCount > 0)
                    {
                        <span class="nav-badge" style="background: var(--warning, #f59e0b); color: var(--bg-primary, #1e293b);">@unreadMinutesCount</span>
                    }
                </a>
                <a href="/office/meetings" class="nav-item @(IsActive("/office/meetings"))">
                    <i class="bi bi-camera-video"></i> Meetings
                </a>
                <a href="/office/directory" class="nav-item @(IsActive("/office/directory"))">
                    <i class="bi bi-people"></i> Directory
                </a>
                <a href="/office/ai-assistant" class="nav-item @(IsActive("/office/ai-assistant"))">
                    <i class="bi bi-robot text-info"></i> AI Assistant
                    <span class="nav-badge" style="background: linear-gradient(135deg, #6366f1, #a855f7); color: white;">GPT-4o</span>
                </a>

                <!-- EXPORT CRM & SALES -->
                <div class="nav-section-title mt-3">EXPORT CRM & SALES</div>
                <a href="/office/leads" class="nav-item @(IsActive("/office/leads"))">
                    <i class="bi bi-funnel"></i> Leads & Pipeline
                </a>
                <a href="/customers" class="nav-item">
                    <i class="bi bi-buildings"></i> Customer 360° Hub
                </a>


                <!-- SYSTEM ADMIN -->
                @if (isAdmin)
                {
                    <div class="nav-section-title mt-3">ADMINISTRATION</div>
                    <a href="/setup/users" class="nav-item">
                        <i class="bi bi-person-gear"></i> User Management
                    </a>
                }
            </div>
        </nav>

        <div class="sidebar-user">
            <div class="user-avatar">
                <div class="avatar avatar-sm" style="position: relative;">
                    @if (!string.IsNullOrEmpty(currentUser?.Avatar))
                    {
                        <img src="@currentUser.Avatar" alt="@(currentUser.FullUserName ?? currentUser.UserName)" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                    }
                    else
                    {
                        var name = currentUser?.FullUserName ?? currentUser?.EmployeeName ?? currentUser?.UserName ?? "U";
                        @(name.Length > 0 ? name[0].ToString().ToUpper() : "U")
                    }
                </div>
                <span class="presence-dot online"></span>
            </div>
            <div class="user-info">
                <div class="user-name">@(currentUser?.FullUserName ?? currentUser?.EmployeeName ?? currentUser?.UserName ?? "User")</div>
                <div class="user-role">@(currentUser?.Designation ?? currentUser?.DepartmentName ?? (isAdmin ? "Administrator" : "Team Member"))</div>
            </div>
            <a href="/" class="btn btn-ghost btn-icon" title="Return to Impulse ERP">
                <i class="bi bi-box-arrow-left"></i>
            </a>
        </div>
    </aside>

    <div class="main-wrapper">
        <header class="top-bar">
            <div class="top-bar-left d-flex align-items-center gap-3">
                <button class="btn btn-ghost btn-icon me-1 d-md-none" @onclick="() => sidebarOpen = !sidebarOpen">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <div class="top-bar-brand">
                    <span class="top-bar-brand-title fw-bold">AWM Systems</span>
                    <span class="top-bar-brand-sub fst-italic">Your Technology Partner</span>
                </div>
                <button type="button" class="btn btn-sm btn-warning d-flex align-items-center gap-2 px-3 py-1 fw-semibold text-dark shadow-sm rounded-pill" @onclick="() => StickyNotesWidget.TriggerAddNote()" title="Add Sticky Note">
                    <i class="bi bi-sticky-fill"></i>
                    <span>New Sticky Note</span>
                </button>
                <button type="button" class="btn btn-sm d-flex align-items-center gap-2 px-3 py-1 fw-semibold text-white shadow-sm rounded-pill" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #db2777 100%);" @onclick="() => AiChatbotWidget.TriggerToggle()" title="Chat with Enterprise AI">
                    <i class="bi bi-stars"></i>
                    <span>Ask AI</span>
                </button>
            </div>
            <div class="top-bar-right d-flex align-items-center gap-2">
                <a href="/" class="btn btn-sm btn-outline-secondary d-none d-sm-flex align-items-center gap-1 rounded-pill px-3 py-1" style="font-size: 0.8rem;">
                    <i class="bi bi-arrow-left"></i> Return to ERP
                </a>

                <div class="top-indicator d-none d-lg-flex" style="background: white; border: 1px solid #eaeaea; padding: 4px 14px; border-radius: 24px; align-items: center; gap: 8px;">
                    <i class="bi bi-aspect-ratio text-muted" style="font-size: 0.9rem;"></i>
                    <span style="font-size: 0.75rem; color: #6a6a80; text-transform: uppercase; font-weight: bold;">Size</span>
                    <select id="display-scale-select" onchange="window.setDisplayScale(this.value)" style="border: none; background: transparent; font-size: 0.85rem; font-weight: bold; color: #1a1a2e; cursor: pointer; outline: none;">
                        <option value="normal">Normal (100%)</option>
                        <option value="large">Large (115%)</option>
                        <option value="xlarge">Extra Large (130%)</option>
                        <option value="compact">Compact (90%)</option>
                    </select>
                </div>

                <div class="top-indicator d-none d-lg-flex" style="background: white; border: 1px solid #eaeaea; padding: 4px 14px; border-radius: 24px; align-items: center; gap: 8px;">
                    <span style="font-size: 0.75rem; color: #6a6a80; text-transform: uppercase; font-weight: bold;">Font</span>
                    <select onchange="window.setFont(this.value)" style="border: none; background: transparent; font-size: 0.85rem; font-weight: bold; color: #1a1a2e; cursor: pointer; outline: none;">
                        <option value="inter">Inter</option>
                        <option value="roboto">Roboto</option>
                        <option value="poppins">Poppins</option>
                        <option value="outfit">Outfit</option>
                    </select>
                </div>

                <div class="top-indicator d-none d-lg-flex" style="background: white; border: 1px solid #eaeaea; padding: 6px 14px; border-radius: 24px; align-items: center; gap: 8px;">
                    <span style="font-size: 0.75rem; color: #6a6a80; text-transform: uppercase; font-weight: bold;">Theme</span>
                    <button onclick="window.setTheme('pastel')" style="width: 18px; height: 18px; border-radius: 50%; background: #e0f2f1; border: 2px solid #8fbc8f; padding: 0;" title="Pastel"></button>
                    <button onclick="window.setTheme('purple')" style="width: 18px; height: 18px; border-radius: 50%; background: #f3e8ff; border: 2px solid #9333ea; padding: 0;" title="Purple"></button>
                    <button onclick="window.setTheme('green')" style="width: 18px; height: 18px; border-radius: 50%; background: #dcfce7; border: 2px solid #16a34a; padding: 0;" title="Green"></button>
                    <button onclick="window.setTheme('orange')" style="width: 18px; height: 18px; border-radius: 50%; background: #ffedd5; border: 2px solid #ea580c; padding: 0;" title="Orange"></button>
                </div>

                <div class="top-indicator d-none d-md-flex" style="background: white; border: 1px solid #eaeaea; padding: 4px 14px 4px 6px; border-radius: 24px; align-items: center; gap: 6px;">
                    <div style="width: 26px; height: 26px; border-radius: 50%; background: #e0f2f1; color: #1f8a70; display: flex; justify-content: center; align-items: center;">
                        <i class="bi bi-clock" style="font-size: 0.85rem;"></i>
                    </div>
                    <span style="font-size: 0.82rem; font-weight: bold; color:#1a1a2e;" id="login-timer">00:00:00</span>
                </div>

                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1" style="font-size: 0.8rem; font-weight: 600;">
                    <i class="bi bi-database-check me-1"></i> SMBI_AWM Connected
                </span>

                <!-- Notification Bell & Flyout -->
                <div class="notification-bell-container position-relative">
                    <button type="button" class="btn btn-ghost btn-icon notification-bell-btn @(notificationOpen ? "active" : "")" @onclick="ToggleNotifications" title="Notifications">
                        <i class="bi bi-bell fs-5"></i>
                        @if (totalUnreadNotifications > 0)
                        {
                            <span class="notification-bell-badge">@(totalUnreadNotifications > 99 ? "99+" : totalUnreadNotifications.ToString())</span>
                        }
                    </button>

                    @if (notificationOpen)
                    {
                        <div class="notification-backdrop" @onclick="() => notificationOpen = false"></div>
                        <div class="notification-flyout shadow-lg">
                            <div class="notification-flyout-header">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-dark" style="font-size: 0.95rem;">Notifications</span>
                                    @if (totalUnreadNotifications > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill" style="font-size: 0.7rem;">@totalUnreadNotifications new</span>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    @if (totalUnreadNotifications > 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-primary fw-semibold" style="font-size: 0.75rem;" @onclick="MarkAllNotificationsRead">
                                            Mark all read
                                        </button>
                                    }
                                    <button type="button" class="btn-close" style="font-size: 0.7rem;" @onclick="() => notificationOpen = false"></button>
                                </div>
                            </div>

                            <div class="notification-flyout-body">
                                @if (recentNotifications == null || !recentNotifications.Any())
                                {
                                    <div class="p-4 text-center text-muted">
                                        <i class="bi bi-bell-slash fs-2 mb-2 d-block text-secondary opacity-50"></i>
                                        <div class="fw-semibold text-xs">No notifications yet</div>
                                        <small class="text-muted" style="font-size: 0.75rem;">You're completely up to date!</small>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var notif in recentNotifications)
                                    {
                                        <div class="notification-item @(notif.IsRead ? "read" : "unread")" @onclick="() => OnNotificationClick(notif)">
                                            <div class="notif-icon-box @GetCategoryClass(notif.Category)">
                                                <i class="bi @GetCategoryIcon(notif.Category)"></i>
                                            </div>
                                            <div class="notif-text-box">
                                                <div class="notif-title">@notif.Title</div>
                                                <div class="notif-msg">@notif.Message</div>
                                                <div class="notif-meta">
                                                    <span><i class="bi bi-clock me-1"></i>@GetRelativeTime(notif.CreatedAt)</span>
                                                    @if (!string.IsNullOrEmpty(notif.SenderName))
                                                    {
                                                        <span class="ms-2"><i class="bi bi-person me-1"></i>@notif.SenderName</span>
                                                    }
                                                </div>
                                            </div>
                                            @if (!notif.IsRead)
                                            {
                                                <div class="notif-dot-box">
                                                    <span class="unread-dot"></span>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                            
                            <div class="notification-flyout-footer">
                                <span class="text-muted" style="font-size: 0.72rem;"><i class="bi bi-broadcast text-success me-1"></i>Real-time alerts active</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </header>

        <main class="main-content">
            @Body
        </main>
        
        @if (!isLiveMeetingPage)
        {
            <StickyNotesWidget />
            <AiChatbotWidget />
        }
        <NotificationToaster />
    </div>
</div>

@code {
    private bool notificationOpen;
    private List<AppNotification> recentNotifications = new();
    private int totalUnreadNotifications;
    private IntraUserProfile? currentUser;
    private bool isAdmin;
    private bool sidebarOpen;
    private int unreadCount;
    private int unreadAnnouncementsCount;
    private int unreadMinutesCount;
    private int unreadTasksCount;
    private bool isLiveMeetingPage => Navigation.Uri.Contains("/meetings/live");

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var userName = user.Identity.Name ?? "";
            currentUser = await IntraOfficeService.GetUserProfileAsync(userName);
            if (currentUser == null)
            {
                currentUser = new IntraUserProfile
                {
                    UserName = userName,
                    FullUserName = userName,
                    IsActive = true
                };
            }

            isAdmin = user.IsInRole("Admin") || user.IsInRole("Administrator");

            if (currentUser != null)
            {
                recentNotifications = NotificationService.GetRecentNotifications(currentUser.UserName);
                totalUnreadNotifications = NotificationService.GetUnreadCount(currentUser.UserName);
            }
            
            NotificationService.OnNotificationReceived += HandleLiveNotification;
            Navigation.LocationChanged += OnLocationChanged;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleLiveNotification(AppNotification notif)
    {
        if (currentUser != null && (string.IsNullOrEmpty(notif.TargetUserId) || notif.TargetUserId == currentUser.UserName))
        {
            recentNotifications = NotificationService.GetRecentNotifications(currentUser.UserName);
            totalUnreadNotifications = NotificationService.GetUnreadCount(currentUser.UserName);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleNotifications()
    {
        notificationOpen = !notificationOpen;
        if (notificationOpen && currentUser != null)
        {
            recentNotifications = NotificationService.GetRecentNotifications(currentUser.UserName);
            totalUnreadNotifications = NotificationService.GetUnreadCount(currentUser.UserName);
        }
    }

    private void MarkAllNotificationsRead()
    {
        if (currentUser != null)
        {
            NotificationService.MarkAllAsRead(currentUser.UserName);
            recentNotifications = NotificationService.GetRecentNotifications(currentUser.UserName);
            totalUnreadNotifications = 0;
        }
    }

    private void OnNotificationClick(AppNotification notif)
    {
        if (currentUser != null)
        {
            NotificationService.MarkAsRead(notif.Id, currentUser.UserName);
            totalUnreadNotifications = NotificationService.GetUnreadCount(currentUser.UserName);
        }
        notificationOpen = false;
        if (!string.IsNullOrEmpty(notif.ActionUrl))
        {
            Navigation.NavigateTo(notif.ActionUrl);
        }
    }

    private string GetCategoryClass(NotificationCategory category) => category switch
    {
        NotificationCategory.Message => "cat-msg",
        NotificationCategory.Announcement => "cat-ann",
        NotificationCategory.Minute => "cat-min",
        NotificationCategory.Meeting => "cat-meet",
        NotificationCategory.Task => "cat-task",
        _ => "cat-sys"
    };

    private string GetCategoryIcon(NotificationCategory category) => category switch
    {
        NotificationCategory.Message => "bi-chat-dots-fill",
        NotificationCategory.Announcement => "bi-megaphone-fill",
        NotificationCategory.Minute => "bi-file-earmark-check-fill",
        NotificationCategory.Meeting => "bi-camera-video-fill",
        NotificationCategory.Task => "bi-check2-square",
        _ => "bi-bell-fill"
    };

    private string GetRelativeTime(DateTime time)
    {
        var span = DateTime.UtcNow - time;
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        return time.ToLocalTime().ToString("MMM dd");
    }

    public void Dispose()
    {
        NotificationService.OnNotificationReceived -= HandleLiveNotification;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private string IsActive(string href)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/');
        var target = href.Trim('/');
        if (target == "office")
            return (path == "office" || path == "intraoffice" || string.IsNullOrEmpty(path)) ? "active" : "";
        if (target == "office/crm" && (path == "crm" || path == "office/crm"))
            return "active";
        if (path.Equals(target, StringComparison.OrdinalIgnoreCase))
            return "active";
        if (target != "office" && path.StartsWith(target + "/", StringComparison.OrdinalIgnoreCase))
            return "active";
        return "";
    }
}

<style>
    .notification-bell-container {
        position: relative;
    }

    .notification-bell-btn {
        position: relative;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        color: #334155;
        border: 1px solid #e2e8f0;
        cursor: pointer;
        transition: all 0.2s;
    }

    .notification-bell-btn:hover, .notification-bell-btn.active {
        background: #e2e8f0;
        color: #0f172a;
    }

    .notification-bell-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        background: #ef4444;
        color: #ffffff;
        font-size: 0.65rem;
        font-weight: 700;
        min-width: 18px;
        height: 18px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 4px;
        border: 2px solid #ffffff;
        box-shadow: 0 2px 4px rgba(239, 68, 68, 0.3);
        animation: pulseBadge 2s infinite;
    }

    @@keyframes pulseBadge {
        0% { transform: scale(1); }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); }
    }

    .notification-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 1040;
        background: transparent;
    }

    .notification-flyout {
        position: absolute;
        top: 46px;
        right: 0;
        width: 380px;
        max-width: 90vw;
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.12), 0 8px 10px -6px rgba(15, 23, 42, 0.08);
        z-index: 1050;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        animation: flyoutSlide 0.2s ease-out;
    }

    @@keyframes flyoutSlide {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .notification-flyout-header {
        padding: 12px 16px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #ffffff;
    }

    .notification-flyout-body {
        max-height: 400px;
        overflow-y: auto;
    }

    .notification-item {
        padding: 12px 16px;
        border-bottom: 1px solid #f8fafc;
        display: flex;
        gap: 12px;
        align-items: flex-start;
        cursor: pointer;
        transition: background 0.15s;
    }

    .notification-item:hover {
        background: #f8fafc;
    }

    .notification-item.unread {
        background: #f0fdf4;
    }

    .notification-item.unread:hover {
        background: #e7faea;
    }

    .notif-icon-box {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
        flex-shrink: 0;
    }

    .notif-icon-box.cat-msg { background: #eff6ff; color: #2563eb; }
    .notif-icon-box.cat-ann { background: #fef2f2; color: #dc2626; }
    .notif-icon-box.cat-min { background: #fffbeb; color: #d97706; }
    .notif-icon-box.cat-meet { background: #f5f3ff; color: #7c3aed; }
    .notif-icon-box.cat-task { background: #ecfdf5; color: #059669; }
    .notif-icon-box.cat-sys { background: #f1f5f9; color: #64748b; }

    .notif-text-box {
        flex: 1;
        min-width: 0;
    }

    .notif-title {
        font-size: 0.84rem;
        font-weight: 600;
        color: #0f172a;
        line-height: 1.3;
        margin-bottom: 2px;
    }

    .notif-msg {
        font-size: 0.78rem;
        color: #64748b;
        line-height: 1.35;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .notif-meta {
        font-size: 0.7rem;
        color: #94a3b8;
        margin-top: 4px;
    }

    .notif-dot-box {
        display: flex;
        align-items: center;
        padding-top: 6px;
    }

    .unread-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #10b981;
    }

    .notification-flyout-footer {
        padding: 8px 16px;
        border-top: 1px solid #f1f5f9;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>
