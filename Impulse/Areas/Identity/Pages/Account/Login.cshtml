@page
@model LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Log In — Impulse ERP";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <!-- Google Fonts: Outfit & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #0d47a1 0%, #1976d2 100%);
            --hero-gradient: linear-gradient(135deg, #071a36 0%, #0d47a1 55%, #1565c0 100%);
        }

        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }

        .auth-container {
            min-height: 100vh;
            display: flex;
        }

        /* ── Left Hero Panel ────────────────────────────────── */
        .auth-hero {
            flex: 1.1;
            background: var(--hero-gradient);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 3.5rem 4rem;
            color: #ffffff;
        }

        /* Subtle geometric ambient circles */
        .auth-hero::before {
            content: '';
            position: absolute;
            top: -15%;
            right: -15%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(66, 165, 245, 0.22) 0%, rgba(13, 71, 161, 0) 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .auth-hero::after {
            content: '';
            position: absolute;
            bottom: -20%;
            left: -10%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(25, 118, 210, 0.25) 0%, rgba(7, 26, 54, 0) 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .hero-brand {
            display: flex;
            align-items: center;
            gap: 1rem;
            position: relative;
            z-index: 2;
        }

        .hero-logo-box {
            width: 48px;
            height: 48px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: #ffffff;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        }

        .hero-brand-name {
            font-family: 'Outfit', sans-serif;
            font-weight: 800;
            font-size: 1.75rem;
            letter-spacing: -0.5px;
            color: #ffffff;
            margin: 0;
            line-height: 1;
        }

        .hero-brand-tag {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(255, 255, 255, 0.75);
            font-weight: 600;
        }

        .hero-body {
            position: relative;
            z-index: 2;
            max-width: 520px;
            margin: 2rem 0;
        }

        .hero-headline {
            font-family: 'Outfit', sans-serif;
            font-size: 2.35rem;
            font-weight: 700;
            line-height: 1.2;
            letter-spacing: -0.5px;
            margin-bottom: 1.25rem;
            color: #ffffff;
        }

        .hero-subheadline {
            font-size: 1rem;
            line-height: 1.6;
            color: rgba(255, 255, 255, 0.82);
            margin-bottom: 2rem;
        }

        .feature-list {
            display: flex;
            flex-direction: column;
            gap: 1.1rem;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .feature-icon-wrap {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.18);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            color: #60a5fa;
            flex-shrink: 0;
        }

        .feature-text {
            font-size: 0.92rem;
            color: rgba(255, 255, 255, 0.9);
            font-weight: 500;
        }

        .hero-footer {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            padding-top: 1.5rem;
            font-size: 0.8rem;
            color: rgba(255, 255, 255, 0.65);
        }

        /* ── Right Form Panel ───────────────────────────────── */
        .auth-form-panel {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2.5rem;
            background: #ffffff;
        }

        .auth-card {
            width: 100%;
            max-width: 440px;
        }

        .auth-header {
            margin-bottom: 2rem;
        }

        .auth-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.85rem;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.5px;
            margin-bottom: 0.4rem;
        }

        .auth-subtitle {
            color: #64748b;
            font-size: 0.92rem;
            line-height: 1.4;
        }

        /* Input styling with icons */
        .input-icon-group {
            position: relative;
            margin-bottom: 1.25rem;
        }

        .input-icon-prefix {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1rem;
            transition: color 0.2s ease;
            pointer-events: none;
            z-index: 4;
        }

        .input-icon-group .form-control {
            padding-left: 2.75rem;
            padding-right: 2.75rem;
            height: 48px;
            font-size: 0.95rem;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            background-color: #f8fafc;
            transition: all 0.2s ease;
        }

        .input-icon-group .form-control:focus {
            background-color: #ffffff;
            border-color: #1976d2;
            box-shadow: 0 0 0 4px rgba(25, 118, 210, 0.12);
        }

        .input-icon-group:focus-within .input-icon-prefix {
            color: #1976d2;
        }

        .password-toggle-btn {
            position: absolute;
            right: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            background: transparent;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            padding: 0.4rem 0.6rem;
            border-radius: 6px;
            font-size: 0.95rem;
            z-index: 4;
            transition: color 0.15s ease;
        }

        .password-toggle-btn:hover {
            color: #1976d2;
        }

        .form-label-custom {
            font-size: 0.82rem;
            font-weight: 600;
            color: #334155;
            margin-bottom: 0.4rem;
            display: block;
        }

        .btn-auth-submit {
            background: var(--primary-gradient);
            color: #ffffff;
            border: none;
            height: 48px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.98rem;
            letter-spacing: 0.2px;
            box-shadow: 0 4px 14px rgba(13, 71, 161, 0.25);
            transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
        }

        .btn-auth-submit:hover {
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(13, 71, 161, 0.35);
        }

        .btn-auth-submit:active {
            transform: translateY(0);
        }

        .auth-footer-badge {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            color: #94a3b8;
            font-size: 0.78rem;
            margin-top: 2rem;
        }

        /* ── Responsive Behavior ────────────────────────────── */
        @@media (max-width: 991.98px) {
            .auth-hero {
                display: none;
            }
            .auth-form-panel {
                padding: 1.5rem;
                background: #f8fafc;
            }
            .auth-card {
                background: #ffffff;
                padding: 2.25rem 2rem;
                border-radius: 18px;
                border: 1px solid #e2e8f0;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
            }
            .mobile-brand-header {
                display: flex !important;
                align-items: center;
                gap: 0.75rem;
                margin-bottom: 1.75rem;
            }
        }

        @@media (min-width: 992px) {
            .mobile-brand-header {
                display: none !important;
            }
        }
    </style>
</head>
<body>

<div class="auth-container">

    <!-- ── LEFT HERO PANEL (BRAND SPOTLIGHT) ────────────────────────── -->
    <div class="auth-hero">
        <!-- Brand Header -->
        <div class="hero-brand">
            <div class="hero-logo-box">
                <i class="fas fa-layer-group"></i>
            </div>
            <div>
                <h1 class="hero-brand-name">Impulse</h1>
                <span class="hero-brand-tag">Enterprise System</span>
            </div>
        </div>

        <!-- Hero Central Headline & Features -->
        <div class="hero-body">
            <h2 class="hero-headline">
                Precision Manufacturing &amp; Enterprise Resource Planning
            </h2>
            <p class="hero-subheadline">
                Unified real-time tracking across multi-stage shop floor production, live inventory valuation, treasury management, and global export operations.
            </p>

            <div class="feature-list">
                <div class="feature-item">
                    <div class="feature-icon-wrap">
                        <i class="fas fa-industry"></i>
                    </div>
                    <span class="feature-text">Shop Floor WIP &amp; Subcontractor Maker Tracking</span>
                </div>
                <div class="feature-item">
                    <div class="feature-icon-wrap">
                        <i class="fas fa-boxes-stacked"></i>
                    </div>
                    <span class="feature-text">Multi-Tier Inventory Valuation &amp; Stock Intelligence</span>
                </div>
                <div class="feature-item">
                    <div class="feature-icon-wrap">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <span class="feature-text">Integrated Treasury, Payroll &amp; Global Export Demand</span>
                </div>
            </div>
        </div>

        <!-- Hero Footer -->
        <div class="hero-footer">
            <span>&copy; @DateTime.Now.Year Impulse ERP. All rights reserved.</span>
            <span><i class="fas fa-shield-halved me-1 text-info"></i> Enterprise Host Active</span>
        </div>
    </div>

    <!-- ── RIGHT AUTHENTICATION PANEL ───────────────────────────────── -->
    <div class="auth-form-panel">
        <div class="auth-card">

            <!-- Mobile Brand Header (Visible only on smaller screens) -->
            <div class="mobile-brand-header">
                <div style="width: 40px; height: 40px; background: var(--primary-gradient); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1.2rem;">
                    <i class="fas fa-layer-group"></i>
                </div>
                <div>
                    <h4 class="mb-0 fw-bold" style="font-family: 'Outfit', sans-serif; color: #0d47a1;">Impulse</h4>
                    <span class="text-muted small" style="font-size: 0.72rem; letter-spacing: 1px; text-transform: uppercase;">Enterprise Portal</span>
                </div>
            </div>

            <div class="auth-header">
                <h2 class="auth-title">Welcome back</h2>
                <p class="auth-subtitle">Please enter your authorized credentials to access your workspace.</p>
            </div>

            <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                @Html.AntiForgeryToken()
                <!-- Validation Summary Alert -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-3 border-0 small shadow-sm" role="alert"></div>

                <!-- Username Field -->
                <div class="mb-3">
                    <label asp-for="Input.UserName" class="form-label-custom">Username / User ID</label>
                    <div class="input-icon-group">
                        <i class="fas fa-user input-icon-prefix"></i>
                        <input asp-for="Input.UserName" class="form-control" autocomplete="username" aria-required="true" placeholder="Enter your username" autofocus />
                    </div>
                    <span asp-validation-for="Input.UserName" class="text-danger small"></span>
                </div>

                <!-- Password Field with Show/Hide Toggle -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Input.Password" class="form-label-custom mb-0">Password</label>
                        <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none small text-primary fw-semibold" tabindex="-1">Forgot?</a>
                    </div>
                    <div class="input-icon-group">
                        <i class="fas fa-lock input-icon-prefix"></i>
                        <input asp-for="Input.Password" id="passwordInput" type="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Enter your password" />
                        <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility()" aria-label="Toggle password visibility" tabindex="-1">
                            <i id="passwordToggleIcon" class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <!-- Remember Me Checkbox -->
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="Input.RememberMe" id="rememberMe" style="cursor: pointer;" />
                        <label class="form-check-label small text-secondary" for="rememberMe" style="cursor: pointer; user-select: none;">
                            Keep me signed in
                        </label>
                    </div>
                </div>

                <!-- Submit Button -->
                <button id="login-submit" type="submit" class="btn btn-auth-submit w-100 d-flex align-items-center justify-content-center gap-2">
                    <span>Sign In to Workspace</span>
                    <i class="fas fa-arrow-right-to-bracket"></i>
                </button>
            </form>

            <div class="auth-footer-badge">
                <i class="fas fa-lock"></i>
                <span>Secured with 256-bit SSL Session Encryption</span>
            </div>

        </div>
    </div>

</div>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function togglePasswordVisibility() {
        const passwordInput = document.getElementById('passwordInput');
        const toggleIcon = document.getElementById('passwordToggleIcon');
        
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            toggleIcon.classList.remove('fa-eye');
            toggleIcon.classList.add('fa-eye-slash');
        } else {
            passwordInput.type = 'password';
            toggleIcon.classList.remove('fa-eye-slash');
            toggleIcon.classList.add('fa-eye');
        }
    }
</script>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<partial name="_ValidationScriptsPartial" />

</body>
</html>
