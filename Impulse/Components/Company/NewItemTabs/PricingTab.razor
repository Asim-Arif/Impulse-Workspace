@using DataAccessLibrary.Models.ViewModels.Company

@using DataAccessLibrary.Models.ViewModels.Company

<div class="pricing-container">

    @* ── Pricing Header Group ── *@
    <fieldset class="border rounded p-3 mb-3" style="background: rgba(255, 255, 255, 0.5); border-color: #dee2e6 !important;">
        <legend class="float-none w-auto px-2 fw-bold text-secondary mb-0" style="font-size: 0.92rem;">Pricing :</legend>
        <div class="row g-3 align-items-center">
            <div class="col-auto">
                <label class="form-label fw-semibold text-secondary mb-1 small">Currency</label>
                <input type="text" class="form-control form-control-sm text-center fw-bold" 
                       style="width: 100px; height: 32px;" 
                       @bind="Item.ItemCurr" 
                       placeholder="US$" />
            </div>
            <div class="col-auto">
                <label class="form-label fw-semibold text-secondary mb-1 small">US$ to Euro</label>
                <input type="number" step="0.0001" class="form-control form-control-sm text-end" 
                       style="width: 120px; height: 32px;" 
                       @bind="Item.EuroRate" 
                       @bind:event="oninput" 
                       placeholder="0" />
            </div>
        </div>
    </fieldset>

    @* ── Regular Pricing Group ── *@
    <fieldset class="border rounded p-3 mb-3" style="background: rgba(255, 255, 255, 0.5); border-color: #dee2e6 !important;">
        <legend class="float-none w-auto px-2 fw-bold text-secondary mb-0" style="font-size: 0.92rem;">Regular :</legend>
        <div class="table-responsive">
            <table class="table table-borderless table-sm align-middle mb-0" style="min-width: 820px;">
                <thead>
                    <tr class="text-secondary" style="font-size: 0.8rem;">
                        <th style="width: 90px;"></th>
                        <th class="text-center">FOB Karachi</th>
                        <th class="text-center">FOB Sialkot</th>
                        <th class="text-center">C &amp; I (Sea)</th>
                        <th class="text-center">C &amp; I (Air)</th>
                        <th class="text-center">CIF (Sea)</th>
                        <th class="text-center">CIF (Air)</th>
                        <th class="text-center">C &amp; F (Sea)</th>
                        <th class="text-center">C &amp; F (Air)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th class="align-middle text-nowrap fw-bold fs-5 text-dark" style="font-family: inherit;">US $</th>
                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.FOB" @bind:event="oninput" /></td>
                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.ExWorks" @bind:event="oninput" /></td>
                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.CnISea" @bind:event="oninput" /></td>
                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.CnIAir" @bind:event="oninput" /></td>
                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.CIFSea" @bind:event="oninput" /></td>
                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.CIFAir" @bind:event="oninput" /></td>
                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.CnFSea" @bind:event="oninput" /></td>
                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.CnFAir" @bind:event="oninput" /></td>
                    </tr>
                    <tr>
                        <th class="align-middle text-nowrap fw-bold fs-5 text-dark" style="font-family: inherit;">Euro</th>
                        <td><input type="text" class="form-control form-control-sm text-end bg-light" readonly value="@CalcEuro(Item.FOB)" /></td>
                        <td><input type="text" class="form-control form-control-sm text-end bg-light" readonly value="@CalcEuro(Item.ExWorks)" /></td>
                        <td><input type="text" class="form-control form-control-sm text-end bg-light" readonly value="@CalcEuro(Item.CnISea)" /></td>
                        <td><input type="text" class="form-control form-control-sm text-end bg-light" readonly value="@CalcEuro(Item.CnIAir)" /></td>
                        <td><input type="text" class="form-control form-control-sm text-end bg-light" readonly value="@CalcEuro(Item.CIFSea)" /></td>
                        <td><input type="text" class="form-control form-control-sm text-end bg-light" readonly value="@CalcEuro(Item.CIFAir)" /></td>
                        <td><input type="text" class="form-control form-control-sm text-end bg-light" readonly value="@CalcEuro(Item.CnFSea)" /></td>
                        <td><input type="text" class="form-control form-control-sm text-end bg-light" readonly value="@CalcEuro(Item.CnFAir)" /></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </fieldset>

    @* ── Top Pricing Group ── *@
    <fieldset class="border rounded p-3 mb-3" style="background: rgba(255, 255, 255, 0.5); border-color: #dee2e6 !important;">
        <legend class="float-none w-auto px-2 fw-bold text-secondary mb-0" style="font-size: 0.92rem;">Top :</legend>
        <div class="table-responsive">
            <table class="table table-borderless table-sm align-middle mb-0" style="min-width: 820px;">
                <thead>
                    <tr class="text-secondary" style="font-size: 0.8rem;">
                        <th style="width: 90px;"></th>
                        <th class="text-center">FOB Karachi</th>
                        <th class="text-center">FOB Sialkot</th>
                        <th class="text-center">C &amp; I (Sea)</th>
                        <th class="text-center">C &amp; I (Air)</th>
                        <th class="text-center">CIF (Sea)</th>
                        <th class="text-center">CIF (Air)</th>
                        <th class="text-center">C &amp; F (Sea)</th>
                        <th class="text-center">C &amp; F (Air)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th class="align-middle text-nowrap fw-bold fs-5 text-dark" style="font-family: inherit;">US $</th>
                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.FOBTop" @bind:event="oninput" /></td>
                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.ExWorksTop" @bind:event="oninput" /></td>
                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.CnISeaTop" @bind:event="oninput" /></td>
                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.CnIAirTop" @bind:event="oninput" /></td>
                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.CIFSeaTop" @bind:event="oninput" /></td>
                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.CIFAirTop" @bind:event="oninput" /></td>
                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.CnFSeaTop" @bind:event="oninput" /></td>
                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.CnFAirTop" @bind:event="oninput" /></td>
                    </tr>
                    <tr>
                        <th class="align-middle text-nowrap fw-bold fs-5 text-dark" style="font-family: inherit;">Euro</th>
                        <td><input type="text" class="form-control form-control-sm text-end bg-light" readonly value="@CalcEuro(Item.FOBTop)" /></td>
                        <td><input type="text" class="form-control form-control-sm text-end bg-light" readonly value="@CalcEuro(Item.ExWorksTop)" /></td>
                        <td><input type="text" class="form-control form-control-sm text-end bg-light" readonly value="@CalcEuro(Item.CnISeaTop)" /></td>
                        <td><input type="text" class="form-control form-control-sm text-end bg-light" readonly value="@CalcEuro(Item.CnIAirTop)" /></td>
                        <td><input type="text" class="form-control form-control-sm text-end bg-light" readonly value="@CalcEuro(Item.CIFSeaTop)" /></td>
                        <td><input type="text" class="form-control form-control-sm text-end bg-light" readonly value="@CalcEuro(Item.CIFAirTop)" /></td>
                        <td><input type="text" class="form-control form-control-sm text-end bg-light" readonly value="@CalcEuro(Item.CnFSeaTop)" /></td>
                        <td><input type="text" class="form-control form-control-sm text-end bg-light" readonly value="@CalcEuro(Item.CnFAirTop)" /></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </fieldset>

    @* ── Cost Prices Group ── *@
    <fieldset class="border rounded p-3" style="background: rgba(255, 255, 255, 0.5); border-color: #dee2e6 !important;">
        <legend class="float-none w-auto px-2 fw-bold text-secondary mb-0" style="font-size: 0.92rem;">Cost Prices :</legend>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold text-secondary mb-1 small">Ready Finish Price</label>
                <input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.ReadyFinishPrice" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold text-secondary mb-1 small">Filing Price</label>
                <input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.FillingPrice" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold text-secondary mb-1 small">Price For Cost</label>
                <input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="Item.PriceForCost" />
            </div>
        </div>
    </fieldset>

</div>

@code {
    [Parameter, EditorRequired] public ItemDto Item { get; set; } = default!;

    private string CalcEuro(decimal? usd)
    {
        if (usd.HasValue && Item?.EuroRate.HasValue == true && Item.EuroRate.Value > 0)
        {
            var euro = usd.Value * Item.EuroRate.Value;
            return euro.ToString("0.00");
        }
        return "0";
    }
}
