@using DataAccessLibrary.Models.ViewModels.Payroll
@using Blazored.Typeahead

@if (IsOpen)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.55); backdrop-filter: blur(4px); z-index: 100050; display: flex; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box; font-family: 'Calibri', 'Segoe UI', sans-serif;">
        <div class="shadow-lg border-0" style="width: 1000px; max-width: 96vw; max-height: 92vh; background: #ffffff; border-radius: 12px; display: flex; flex-direction: column; overflow: hidden;">
            <!-- Modal Header -->
            <div class="bg-primary text-white py-2 px-3 d-flex align-items-center justify-content-between" style="flex-shrink: 0;">
                <h6 class="modal-title fw-bold mb-0" style="font-size: 1.05rem;">
                    <i class="fas fa-copy me-2"></i>
                    <span>Copy Targets From Another Employee</span>
                </h6>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
            </div>

            <!-- Modal Body (scrollable) -->
            <div class="p-3" style="overflow-y: auto; flex-grow: 1;">
                <!-- Info Alert -->
                <div class="alert alert-info py-2 px-3 mb-3 d-flex align-items-center gap-2" style="font-size: 0.85rem;">
                    <i class="fas fa-info-circle fa-lg text-info"></i>
                    <div>
                        Select an employee to copy their configured daily targets. You can preview their targets below and choose whether to replace or append to the current targets.
                    </div>
                </div>

                <!-- Search Controls -->
                <div class="card border p-3 mb-3" style="background-color: #fafbfc; border-radius: 8px; position: relative; z-index: 1050;">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Department Filter (Optional)</label>
                            <select class="form-select form-select-sm" value="@SelectedDeptId" @onchange="OnDepartmentFilterChanged">
                                <option value="0">All Departments</option>
                                @foreach (var dept in Departments)
                                {
                                    <option value="@dept.DeptID">@dept.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-7">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">
                                Source Employee <span class="text-danger">*</span>
                            </label>
                            <div class="copy-emp-typeahead-wrapper">
                                <BlazoredTypeahead SearchMethod="SearchEmployees"
                                                   EnableDropDown="true"
                                                   TValue="EmployeeListItemModel"
                                                   TItem="EmployeeListItemModel"
                                                   Value="SelectedEmployee"
                                                   ValueChanged="OnEmployeeSelected"
                                                   ValueExpression="@(() => SelectedEmployee)"
                                                   Placeholder="Search by ID, Name, or Designation..."
                                                   MaximumSuggestions="1000">
                                    <SelectedTemplate Context="emp">
                                        @if (!string.IsNullOrEmpty(emp?.EmpID) && emp.EmpID != "0")
                                        {
                                            <text>[@emp.EmpID] </text>
                                        }
                                        @emp?.Name
                                        @if (!string.IsNullOrEmpty(emp?.Designation))
                                        {
                                            <span class="text-muted ms-1">(@emp.Designation)</span>
                                        }
                                    </SelectedTemplate>
                                    <ResultTemplate Context="emp">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                @if (!string.IsNullOrEmpty(emp.EmpID) && emp.EmpID != "0")
                                                {
                                                    <strong>[@emp.EmpID]</strong>
                                                }
                                                <span>@emp.Name</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(emp.Designation))
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.72rem;">@emp.Designation</span>
                                            }
                                        </div>
                                    </ResultTemplate>
                                </BlazoredTypeahead>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Target Preview State -->
                @if (IsLoadingTargets)
                {
                    <div class="text-center py-4 text-muted">
                        <span class="spinner-border spinner-border-sm me-2 text-primary" role="status"></span>
                        Fetching targets for @SelectedEmployee?.Name...
                    </div>
                }
                else if (SelectedEmployee != null)
                {
                    @if (SourceTargets.Count == 0)
                    {
                        <div class="alert alert-warning py-3 px-3 d-flex align-items-center gap-2 mb-0" style="font-size: 0.88rem;">
                            <i class="fas fa-exclamation-triangle fa-lg text-warning"></i>
                            <div>
                                <strong>No targets found!</strong> Employee <strong>@SelectedEmployee.Name</strong> (@SelectedEmployee.EmpID) does not have any daily targets configured.
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card border mb-3" style="border-radius: 8px;">
                            <div class="card-header py-2 px-3 bg-light d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-secondary" style="font-size: 0.85rem;">
                                    <i class="fas fa-bullseye me-1 text-primary"></i>
                                    Configured Targets Preview (@SourceTargets.Count found)
                                </span>
                                <span class="badge bg-primary">Source: @SelectedEmployee.Name</span>
                            </div>
                            <div class="table-responsive" style="max-height: 260px; overflow-y: auto;">
                                <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                    <thead class="table-light text-secondary sticky-top" style="font-size: 0.75rem; text-transform: uppercase;">
                                        <tr>
                                            <th class="ps-3">Process</th>
                                            <th>Group Description</th>
                                            <th class="text-end" style="width: 100px;">Qty</th>
                                            <th class="text-center" style="width: 100px;">Over Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in SourceTargets)
                                        {
                                            <tr>
                                                <td class="ps-3 fw-semibold text-dark">
                                                    @(Processes.FirstOrDefault(p => p.ProcessID == t.ProcessID)?.Description ?? $"Process #{t.ProcessID}")
                                                </td>
                                                <td class="text-secondary">
                                                    @(Groups.FirstOrDefault(g => g.GroupID == t.GroupID)?.Description ?? $"Group #{t.GroupID}")
                                                </td>
                                                <td class="text-end fw-bold text-primary">
                                                    @(t.Qty.HasValue ? t.Qty.Value.ToString("N0") : "-")
                                                </td>
                                                <td class="text-center">
                                                    @if (t.OverTime == 1)
                                                    {
                                                        <span class="badge bg-success-subtle text-success">Yes</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-muted border">No</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Copy Mode Options -->
                        <div class="card border p-3 bg-light" style="border-radius: 8px;">
                            <label class="form-label fw-bold text-secondary mb-2" style="font-size: 0.83rem;">
                                <i class="fas fa-sliders-h me-1 text-primary"></i> Copy Mode
                            </label>
                            <div class="d-flex flex-column gap-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="copyModeRadio" id="modeReplace" checked="@ReplaceExisting" @onchange="() => ReplaceExisting = true" />
                                    <label class="form-check-label" for="modeReplace" style="font-size: 0.85rem;">
                                        <strong>Replace existing targets</strong>
                                        <span class="text-muted d-block small">Replaces all currently listed targets with the @SourceTargets.Count copied target(s).</span>
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="copyModeRadio" id="modeAppend" checked="@(!ReplaceExisting)" @onchange="() => ReplaceExisting = false" />
                                    <label class="form-check-label" for="modeAppend" style="font-size: 0.85rem;">
                                        <strong>Append to existing targets</strong>
                                        <span class="text-muted d-block small">Adds @SourceTargets.Count target(s) to the existing list (skipping duplicate Process + Group entries).</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted border rounded-3 bg-light" style="font-size: 0.88rem;">
                        <i class="fas fa-user-search fa-2x d-block mb-2 text-secondary opacity-50"></i>
                        Select an employee above to preview their daily targets.
                    </div>
                }

            </div>

            <!-- Modal Footer -->
            <div class="modal-footer border-top py-2 px-3 bg-light d-flex justify-content-between" style="flex-shrink: 0; border-radius: 0 0 12px 12px;">
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseModal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-sm btn-primary px-3 shadow-sm"
                        disabled="@(SelectedEmployee == null || SourceTargets.Count == 0 || IsLoadingTargets)"
                        @onclick="ConfirmCopy">
                    <i class="fas fa-check me-1"></i> Copy @(SourceTargets.Count > 0 ? $"{SourceTargets.Count} Target(s)" : "Targets")
                </button>
            </div>
        </div>
    </div>
}

<style>
    .copy-emp-typeahead-wrapper .blazored-typeahead {
        height: 31px !important;
        font-size: 0.82rem !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        border-radius: 4px !important;
    }

    .copy-emp-typeahead-wrapper .blazored-typeahead__input,
    .copy-emp-typeahead-wrapper .blazored-typeahead__controls {
        height: 29px !important;
        font-size: 0.82rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }

    .copy-emp-typeahead-wrapper .blazored-typeahead__input-mask,
    .copy-emp-typeahead-wrapper .blazored-typeahead__input-mask-wrapper {
        height: 29px !important;
        font-size: 0.82rem !important;
        display: flex !important;
        align-items: center !important;
        padding-left: 8px !important;
        box-sizing: border-box !important;
    }

    .copy-emp-typeahead-wrapper .blazored-typeahead__results {
        max-height: 220px !important;
        font-size: 0.82rem !important;
        width: 100% !important;
        position: absolute !important;
        z-index: 100060 !important;
        background: #ffffff !important;
        border: 1px solid #ced4da !important;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18) !important;
        border-radius: 6px !important;
    }
</style>
