@using DataAccessLibrary.Models.ViewModels.Payroll
@using Blazored.Typeahead

<!-- Header Action Toolbar -->
<div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
    <div class="d-flex align-items-center gap-2">
        <h6 class="mb-0 fw-bold text-secondary" style="font-size: 0.92rem;">
            <i class="fas fa-bullseye text-primary me-2"></i> Employee Daily Targets
        </h6>
        <span class="badge bg-primary-subtle text-primary border" style="font-size: 0.78rem;">
            @Employee.DailyTargets.Count @(Employee.DailyTargets.Count == 1 ? "Target" : "Targets")
        </span>
    </div>
    <button type="button" class="btn btn-sm btn-outline-primary shadow-sm" @onclick="OpenCopyModal">
        <i class="fas fa-copy me-1"></i> Copy Targets From...
    </button>
</div>

<!-- Add Target Input Bar -->
<div class="row g-3 mb-3 align-items-end" style="position: relative !important; z-index: 2000 !important;">
    <div class="col-md-3">
        <label class="form-label fw-bold text-secondary mb-1">Process</label>
        <BlazoredTypeahead SearchMethod="SearchProcesses"
                           EnableDropDown="true"
                           TValue="ProcessLookupModel"
                           TItem="ProcessLookupModel"
                           Value="SelectedNewProcess"
                           ValueChanged="OnNewProcessChanged"
                           ValueExpression="@(() => SelectedNewProcess)"
                           Placeholder="Select Process"
                           MaximumSuggestions="1000">
            <SelectedTemplate Context="selectedProc">
                @selectedProc?.Description
            </SelectedTemplate>
            <ResultTemplate Context="proc">
                @proc.Description
            </ResultTemplate>
        </BlazoredTypeahead>
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold text-secondary mb-1">Group Description</label>
        <BlazoredTypeahead SearchMethod="SearchGroups"
                           EnableDropDown="true"
                           TValue="GroupLookupModel"
                           TItem="GroupLookupModel"
                           Value="SelectedNewGroup"
                           ValueChanged="OnNewGroupChanged"
                           ValueExpression="@(() => SelectedNewGroup)"
                           Placeholder="Select Group"
                           MaximumSuggestions="1000">
            <SelectedTemplate Context="selectedGroup">
                @selectedGroup?.Description
            </SelectedTemplate>
            <ResultTemplate Context="grp">
                @grp.Description
            </ResultTemplate>
        </BlazoredTypeahead>
    </div>
    <div class="col-md-2">
        <label class="form-label fw-bold text-secondary mb-1">Qty</label>
        <input type="number" class="form-control form-control-sm" @bind="_newQty" />
    </div>
    <div class="col-md-2 d-flex align-items-center mt-4">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" @bind="_newOverTime" id="otCheck" />
            <label class="form-check-label" for="otCheck">Over Time</label>
        </div>
    </div>
    <div class="col-auto pb-0">
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddTarget">
            <i class="fas fa-plus me-1"></i> Add
        </button>
    </div>
</div>

<!-- Targets Data Table -->
<div class="table-responsive mb-3" style="overflow: visible !important; min-height: 220px; position: relative !important; z-index: 1 !important;">
    <table class="table table-bordered table-hover table-sm align-middle targets-table mb-0">
        <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase;">
            <tr>
                <th style="min-width: 200px;">Process</th>
                <th style="min-width: 200px;">Group Description</th>
                <th style="width: 110px;" class="text-end">Qty</th>
                <th style="width: 100px;" class="text-center">Over Time</th>
                <th style="width: 50px;" class="text-center"></th>
            </tr>
        </thead>
        <tbody>
            @if (Employee.DailyTargets.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4" style="font-size: 0.85rem;">
                        <i class="fas fa-bullseye me-1 text-primary"></i> No daily targets added yet. Use the form above to add targets, or click <strong>Copy Targets From...</strong> to copy from another employee.
                    </td>
                </tr>
            }
            @foreach (var target in Employee.DailyTargets)
            {
                <tr class="targets-table-row">
                    <td class="table-typeahead-cell p-1">
                        <BlazoredTypeahead SearchMethod="SearchProcesses"
                                           EnableDropDown="true"
                                           TValue="ProcessLookupModel"
                                           TItem="ProcessLookupModel"
                                           Value="@(Processes.FirstOrDefault(p => p.ProcessID == target.ProcessID))"
                                           ValueChanged="@(val => target.ProcessID = val?.ProcessID ?? 0)"
                                           ValueExpression="@(() => _dummyProcessForGrid)"
                                           Placeholder="Select Process"
                                           MaximumSuggestions="1000">
                            <SelectedTemplate Context="selectedProc">
                                @selectedProc?.Description
                            </SelectedTemplate>
                            <ResultTemplate Context="proc">
                                @proc.Description
                            </ResultTemplate>
                        </BlazoredTypeahead>
                    </td>
                    <td class="table-typeahead-cell p-1">
                        <BlazoredTypeahead SearchMethod="SearchGroups"
                                           EnableDropDown="true"
                                           TValue="GroupLookupModel"
                                           TItem="GroupLookupModel"
                                           Value="@(Groups.FirstOrDefault(g => g.GroupID == target.GroupID))"
                                           ValueChanged="@(val => target.GroupID = val?.GroupID ?? 0)"
                                           ValueExpression="@(() => _dummyGroupForGrid)"
                                           Placeholder="Select Group"
                                           MaximumSuggestions="1000">
                            <SelectedTemplate Context="selectedGroup">
                                @selectedGroup?.Description
                            </SelectedTemplate>
                            <ResultTemplate Context="grp">
                                @grp.Description
                            </ResultTemplate>
                        </BlazoredTypeahead>
                    </td>
                    <td class="text-end p-1" style="width: 110px;">
                        <input type="number" class="form-control form-control-sm text-end" @bind="target.Qty" />
                    </td>
                    <td class="text-center p-1" style="width: 100px;">
                        <div class="form-check d-flex justify-content-center m-0">
                            <input class="form-check-input" type="checkbox"
                                   checked="@(target.OverTime == 1)"
                                   @onchange="e => target.OverTime = ((bool?)e.Value == true) ? (byte)1 : (byte)0" />
                        </div>
                    </td>
                    <td class="text-center p-1" style="width: 50px;">
                        <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2" title="Delete Target" @onclick="() => Employee.DailyTargets.Remove(target)">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Copy Targets Modal Dialog (Fallback if not handled by parent) -->
@if (!OnOpenCopyModal.HasDelegate)
{
    <CopyTargetsModal @bind-IsOpen="_isCopyModalOpen"
                      CurrentEmpId="@Employee.EmpID"
                      Processes="Processes"
                      Groups="Groups"
                      OnTargetsCopied="HandleTargetsCopied" />
}

<style>
    .targets-table {
        border: 1px solid #dee2e6 !important;
        border-collapse: collapse !important;
        width: 100% !important;
    }

    .targets-table th,
    .targets-table td {
        border: 1px solid #dee2e6 !important;
        vertical-align: middle !important;
    }

    .targets-table tbody tr {
        position: relative;
    }

    .targets-table .table-typeahead-cell {
        position: relative;
    }

    .targets-table .table-typeahead-cell:focus-within {
        position: relative !important;
        z-index: 1050 !important;
    }

    .targets-table .table-typeahead-cell .blazored-typeahead {
        height: 31px !important;
        font-size: 0.82rem !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        border-radius: 4px !important;
    }

    .targets-table .table-typeahead-cell .blazored-typeahead__input,
    .targets-table .table-typeahead-cell .blazored-typeahead__controls {
        height: 29px !important;
        font-size: 0.82rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }

    .targets-table .table-typeahead-cell .blazored-typeahead__input-mask,
    .targets-table .table-typeahead-cell .blazored-typeahead__input-mask-wrapper {
        height: 29px !important;
        font-size: 0.82rem !important;
        display: flex !important;
        align-items: center !important;
        padding-left: 8px !important;
        box-sizing: border-box !important;
    }

    .targets-table .table-typeahead-cell .blazored-typeahead__results {
        max-height: 220px !important;
        font-size: 0.82rem !important;
        min-width: 260px !important;
        width: 100% !important;
        position: absolute !important;
        z-index: 99999 !important;
        background: #ffffff !important;
        border: 1px solid #ced4da !important;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18) !important;
        border-radius: 6px !important;
    }
</style>
