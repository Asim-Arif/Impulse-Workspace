@using DataAccessLibrary.Models.ViewModels.Production
@using Impulse.Services.Production
@using Blazored.Typeahead

@if (IsOpen && Group != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.55); backdrop-filter: blur(4px); z-index: 100050; display: flex; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box; font-family: 'Calibri', 'Segoe UI', sans-serif;">
        <div class="shadow-lg border-0" style="width: 1000px; max-width: 96vw; max-height: 92vh; background: #ffffff; border-radius: 12px; display: flex; flex-direction: column; overflow: hidden;">
            <div class="bg-primary text-white py-2 px-3 d-flex align-items-center justify-content-between" style="flex-shrink: 0;">
                <h6 class="modal-title fw-bold mb-0" style="font-size: 1.05rem;">
                    <i class="fas @(IsCopy ? "fa-copy" : (Group.EntryID == 0 ? "fa-plus-circle" : "fa-pencil-alt")) me-2"></i>
                    @(IsCopy ? $"Copy Process Group: {Group.GroupName}" : (Group.EntryID == 0 ? "Create New Process Group" : $"Edit Process Group: {Group.GroupName}"))
                </h6>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
            </div>
            <div class="p-3" style="overflow-y: auto; flex-grow: 1;">

                    <!-- Group Name / Header -->
                    <div class="row g-2 mb-3">
                        <div class="col-md-12">
                            <label class="form-label form-label-sm fw-bold text-secondary mb-1" style="font-size: 0.875rem;">
                                Group Name / Description <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   class="form-control form-control-sm fw-bold"
                                   style="font-size: 0.95rem; height: 35px;"
                                   placeholder="e.g. UPPER FABRICATION PIPELINE, PACKING & DISPATCH..."
                                   @bind="Group.GroupName" />
                        </div>
                    </div>

                    <!-- Step Insertion Toolbar -->
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="fw-bold text-secondary small text-uppercase mb-2" style="font-size: 0.78rem;">
                            <i class="fas fa-plus-circle text-primary me-1"></i> Add Step into Sequence
                        </div>

                        <div class="row g-2 align-items-end">
                            <!-- Process Lookup -->
                            <div class="col-md-5">
                                <label class="form-label form-label-sm mb-1 fw-bold text-secondary" style="font-size: 0.85rem;">
                                    Process <span class="text-danger">*</span>
                                </label>
                                <div class="custom-typeahead-container modal-typeahead">
                                    <BlazoredTypeahead SearchMethod="SearchProcesses"
                                                       TValue="LookupItemInt"
                                                       TItem="LookupItemInt"
                                                       Value="SelectedProcess"
                                                       ValueChanged="OnProcessSelected"
                                                       ValueExpression="@(() => SelectedProcess)"
                                                       Placeholder="Search manufacturing process..."
                                                       EnableDropDown="true"
                                                       MaximumSuggestions="1000">
                                        <SelectedTemplate Context="proc">
                                            @proc.Name
                                        </SelectedTemplate>
                                        <ResultTemplate Context="proc">
                                            @proc.Name
                                        </ResultTemplate>
                                        <NotFoundTemplate Context="searchText">
                                            <span class="text-muted small">No processes matching "@searchText"</span>
                                        </NotFoundTemplate>
                                    </BlazoredTypeahead>
                                </div>
                            </div>

                            <!-- Scanning Required -->
                            <div class="col-md-2">
                                <label class="form-label form-label-sm mb-1 fw-bold text-secondary" style="font-size: 0.85rem;">Scanning</label>
                                <select class="form-select form-select-sm" @bind="NewStepScanning">
                                    <option value="false">No</option>
                                    <option value="true">Yes</option>
                                </select>
                            </div>

                            <!-- Hub Name / Station -->
                            <div class="col-md-3">
                                <label class="form-label form-label-sm mb-1 fw-bold text-secondary" style="font-size: 0.85rem;">Hub / Station</label>
                                <select class="form-select form-select-sm" @bind="NewStepHubName">
                                    <option value="">Select Hub...</option>
                                    @foreach (var h in AvailableHubNames)
                                    {
                                        <option value="@h">@h</option>
                                    }
                                </select>
                            </div>

                            <!-- Add Button -->
                            <div class="col-md-2 d-grid">
                                <button type="button" class="btn btn-sm btn-primary fw-bold" style="height: 35px; font-size: 0.875rem;" @onclick="AddStep" disabled="@(SelectedProcess == null)">
                                    <i class="fas fa-plus me-1"></i> Add
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Process Sequence Ordered Grid -->
                    <div class="table-responsive border rounded-3" style="max-height: 45vh; overflow-y: auto;">
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                            <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                <tr>
                                    <th style="width: 60px;" class="text-center">Step #</th>
                                    <th>Process Description</th>
                                    <th style="width: 100px;" class="text-center">Scanning</th>
                                    <th style="width: 160px;">Hub / Station</th>
                                    <th style="width: 120px;" class="text-center">Order &amp; Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Group.Processes.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            <i class="fas fa-layer-group fa-2x d-block mb-2 text-secondary opacity-50"></i>
                                            No processes added to this sequence yet. Add at least one step above.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @for (int i = 0; i < Group.Processes.Count; i++)
                                    {
                                        int index = i;
                                        var step = Group.Processes[i];
                                        <tr>
                                            <td class="text-center fw-bold text-muted">@(index + 1)</td>
                                            <td class="fw-bold text-dark">
                                                @if (!string.IsNullOrWhiteSpace(step.ProcessCode))
                                                {
                                                    <span class="badge bg-secondary me-1">@step.ProcessCode</span>
                                                }
                                                @step.ProcessName
                                            </td>
                                            <td class="text-center">
                                                @if (step.Scanning)
                                                {
                                                    <span class="badge bg-success px-2">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-secondary border px-2">No</span>
                                                }
                                            </td>
                                            <td>
                                                <select class="form-select form-select-sm" style="max-width: 160px;" @bind="step.Hub_Name">
                                                    <option value="">-</option>
                                                    @foreach (var h in AvailableHubNames)
                                                    {
                                                        <option value="@h">@h</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="text-center">
                                                <div class="d-flex align-items-center justify-content-center gap-1">
                                                    <button type="button"
                                                            class="btn btn-link btn-sm p-1 text-secondary"
                                                            title="Move Up"
                                                            disabled="@(index == 0)"
                                                            @onclick="() => MoveStepUp(index)">
                                                        <i class="fas fa-arrow-up"></i>
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-link btn-sm p-1 text-secondary"
                                                            title="Move Down"
                                                            disabled="@(index == Group.Processes.Count - 1)"
                                                            @onclick="() => MoveStepDown(index)">
                                                        <i class="fas fa-arrow-down"></i>
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-link btn-sm p-1 text-danger"
                                                            title="Remove Step"
                                                            @onclick="() => RemoveStep(index)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

            </div>
            <div class="bg-light py-2 px-3 d-flex justify-content-between align-items-center border-top" style="flex-shrink: 0;">
                <div class="text-muted small">
                    Total Process Steps: <strong class="text-dark">@Group.Processes.Count</strong>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-secondary fw-bold" @onclick="CloseModal" disabled="@IsSaving">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary fw-bold px-4" @onclick="SaveGroupAsync" disabled="@(IsSaving || string.IsNullOrWhiteSpace(Group.GroupName) || !Group.Processes.Any())">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="fas fa-check-circle me-1"></i>
                            <span>@(IsCopy ? "Save Duplicated Group" : (Group.EntryID == 0 ? "Save Process Group" : "Update Process Group"))</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .modal-typeahead .blazored-typeahead {
        height: 35px !important;
        min-height: 35px !important;
        max-height: 35px !important;
        border: 1px solid #ced4da !important;
        border-radius: 4px !important;
        background-color: #ffffff !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        font-size: 0.875rem !important;
        position: relative !important;
    }
    .modal-typeahead .blazored-typeahead:focus-within {
        border-color: #86b7fe !important;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25) !important;
    }
    .modal-typeahead .blazored-typeahead__controls {
        height: 33px !important;
        min-height: 33px !important;
        max-height: 33px !important;
        border: none !important;
        background: transparent !important;
        padding: 0 !important;
        margin: 0 !important;
        box-sizing: border-box !important;
        display: flex !important;
        align-items: center !important;
    }
    .modal-typeahead .blazored-typeahead__input-mask,
    .modal-typeahead .blazored-typeahead__input {
        height: 33px !important;
        min-height: 33px !important;
        max-height: 33px !important;
        font-size: 0.875rem !important;
        padding: 0 0.6rem !important;
        line-height: 33px !important;
        border: none !important;
        background: transparent !important;
        box-sizing: border-box !important;
        box-shadow: none !important;
        outline: none !important;
    }
    .modal-typeahead .blazored-typeahead__input-icon {
        height: 33px !important;
        min-height: 33px !important;
        max-height: 33px !important;
        border: none !important;
        background: transparent !important;
        padding: 0 0.5rem !important;
        box-sizing: border-box !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }
    .modal-typeahead .blazored-typeahead__results {
        position: absolute !important;
        z-index: 99999 !important;
        background: #ffffff !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22) !important;
        border: 1px solid #ced4da !important;
        border-radius: 6px !important;
        max-height: 220px !important;
        overflow-y: auto !important;
    }
    .form-control-sm, .form-select-sm {
        height: 35px !important;
        font-size: 0.875rem !important;
    }
    .form-select-sm, select.form-select-sm {
        height: 35px !important;
        padding-top: 0.25rem !important;
        padding-bottom: 0.25rem !important;
        padding-left: 0.5rem !important;
        padding-right: 1.75rem !important;
        line-height: 1.5 !important;
        font-size: 0.85rem !important;
    }
</style>
