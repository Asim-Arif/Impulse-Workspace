@using DataAccessLibrary.Models.ViewModels.Production

<div class="card border-0 shadow-none">
    <!-- Action Bar -->
    <div class="d-flex align-items-center justify-content-between p-2 mb-2 bg-light rounded-3 border">
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-primary fw-bold" @onclick="SelectAll">
                <i class="fas fa-check-square me-1"></i> Select All
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary fw-bold" @onclick="UnselectAll">
                <i class="fas fa-square me-1"></i> Unselect All
            </button>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small fw-bold">Total Wastage Deduction:</span>
            <span class="badge bg-danger fs-6 px-3 py-1 fw-bold">@TotalSelectedRepairAmount.ToString("N2")</span>
        </div>
    </div>

    <!-- Repair & Wastage Grid -->
    <div class="table-responsive border rounded-3" style="max-height: 48vh; overflow-y: auto;">
        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
            <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                <tr>
                    <th style="width: 40px;" class="text-center">
                        <input class="form-check-input" type="checkbox" checked="@IsAllSelected" @onchange="ToggleSelectAll" />
                    </th>
                    <th style="width: 45px;">#</th>
                    <th style="width: 110px;">Receipt ID</th>
                    <th style="width: 110px;">Date</th>
                    <th style="width: 120px;">Item Code</th>
                    <th class="text-center" style="width: 90px;">Qty</th>
                    <th class="text-end" style="width: 100px;">Rate</th>
                    <th class="text-end" style="width: 120px;">Wastage Amt</th>
                    <th class="text-center" style="width: 100px;">Lot #</th>
                    <th>Process</th>
                </tr>
            </thead>
            <tbody>
                @if (IsLoading)
                {
                    <tr>
                        <td colspan="10" class="text-center py-4 text-muted">
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span> Loading repair wastage details...
                        </td>
                    </tr>
                }
                else if (!Items.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center py-4 text-muted">
                            <i class="fas fa-check-circle text-success me-1"></i> No unbilled repair or wastage deductions found for this maker.
                        </td>
                    </tr>
                }
                else
                {
                    int idx = 1;
                    @foreach (var item in Items)
                    {
                        <tr class="@(item.IsSelected ? "table-light" : "")">
                            <td class="text-center">
                                <input class="form-check-input" type="checkbox" @bind="item.IsSelected" @bind:after="OnSelectionChanged" />
                            </td>
                            <td>@(idx++)</td>
                            <td><span class="badge bg-secondary">@item.RecieptID</span></td>
                            <td>@item.DT.ToString("dd-MMM-yyyy")</td>
                            <td><span class="badge bg-secondary">@item.ItemCode</span></td>
                            <td class="text-center fw-bold">@item.Qty.ToString("N0")</td>
                            <td class="text-end">@item.Rate.ToString("N2")</td>
                            <td class="text-end fw-bold text-danger">@item.WastageAmt.ToString("N2")</td>
                            <td class="text-center">
                                <span class="badge px-2 py-1" style="background-color: #2196F3; color: #ffffff; font-weight: 700; border-radius: 4px;">
                                    @item.LotNo
                                </span>
                            </td>
                            <td><span class="badge bg-info text-dark">@item.Process</span></td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot class="table-light fw-bold text-dark border-top">
                <tr>
                    <td colspan="5" class="text-end">Total Repair Wastage Deductions:</td>
                    <td class="text-center text-dark">@Items.Where(x => x.IsSelected).Sum(x => x.Qty).ToString("N0")</td>
                    <td></td>
                    <td class="text-end text-danger fs-6">@TotalSelectedRepairAmount.ToString("N2")</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
