@using DataAccessLibrary.Models.ViewModels.Production
@using BlazorContextMenu

<div class="card border-0 shadow-none">
    <div class="table-responsive border rounded-3" style="max-height: 52vh; overflow-y: auto;">
        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
            <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                <tr>
                    <th style="width: 45px;">#</th>
                    <th style="width: 100px;">Iss #</th>
                    <th style="width: 110px;">Date</th>
                    <th>Raw Material</th>
                    <th style="width: 120px;">Item Code</th>
                    <th class="text-end" style="width: 110px;">Rate</th>
                    <th class="text-center" style="width: 90px;">Qty</th>
                    <th class="text-end" style="width: 130px;">Amount</th>
                    <th style="width: 110px;" class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (IsLoading)
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span> Loading hidden raw materials...
                        </td>
                    </tr>
                }
                else if (!Items.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="fas fa-check-circle text-success me-1"></i> No hidden raw materials found for this maker.
                        </td>
                    </tr>
                }
                else
                {
                    int idx = 1;
                    @foreach (var item in Items)
                    {
                        <ContextMenuTrigger MenuId="hiddenRMMenu" Data="@item" WrapperTag="tr">
                            <td>@(idx++)</td>
                            <td><span class="badge bg-secondary">@item.IssNo</span></td>
                            <td>@item.DT.ToString("dd-MMM-yyyy")</td>
                            <td class="fw-semibold text-dark">@item.RawMaterialDisplay</td>
                            <td><span class="badge bg-secondary">@item.ItemCode</span></td>
                            <td class="text-end">@item.Price.ToString("N2")</td>
                            <td class="text-center fw-bold">@item.Qty.ToString("N0")</td>
                            <td class="text-end fw-bold text-danger">@item.Amount.ToString("N2")</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-success py-0 px-2 fw-bold" @onclick="() => RestoreRM(item)" title="Restore to Material Deductions">
                                    <i class="fas fa-eye me-1"></i> Restore
                                </button>
                            </td>
                        </ContextMenuTrigger>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Context Menu for Hidden RM -->
<ContextMenu Id="hiddenRMMenu" Template="Win11Style">
    <div class="win11-section-header px-3 py-1 text-muted small fw-bold border-bottom">HIDDEN RM ACTIONS</div>
    <Item OnClick="@ContextRestoreRM"><i class="fas fa-eye text-success me-2"></i> Show in Billing</Item>
</ContextMenu>
