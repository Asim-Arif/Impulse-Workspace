@using DataAccessLibrary.Models.ViewModels.Production
@using BlazorContextMenu

<div class="card border-0 shadow-none">
    <!-- Grid Action Bar -->
    <div class="d-flex align-items-center justify-content-between p-2 mb-2 bg-light rounded-3 border">
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-primary fw-bold" @onclick="SelectAll">
                <i class="fas fa-check-square me-1"></i> Select All
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary fw-bold" @onclick="UnselectAll">
                <i class="fas fa-square me-1"></i> Clear All
            </button>
            <button type="button" class="btn btn-sm btn-outline-success fw-bold" @onclick="SelectAudited">
                <i class="fas fa-filter me-1"></i> Select Audited
            </button>
            <div class="vr mx-1"></div>
            <button type="button" class="btn btn-sm btn-primary fw-bold" @onclick="MarkAsAudited" disabled="@(!SelectedLots.Any())">
                <i class="fas fa-check-double me-1"></i> Mark Audited
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger fw-bold" @onclick="UnmarkAudited" disabled="@(!SelectedLots.Any())">
                <i class="fas fa-times-circle me-1"></i> Un-Mark Audited
            </button>
        </div>

        <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm" style="width: 220px;">
                <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                <input type="text" class="form-control" placeholder="Search Lot #..." @bind="SearchLotText" @bind:event="oninput" />
            </div>
        </div>
    </div>

    <!-- Main Grid Table with 14 Specific Columns -->
    <div class="table-responsive border rounded-3 mb-3" style="max-height: 48vh; overflow-y: auto;">
        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.85rem; white-space: nowrap;">
            <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                <tr>
                    <th style="width: 35px;" class="text-center">
                        <input class="form-check-input" type="checkbox" checked="@IsAllSelected" @onchange="ToggleSelectAll" />
                    </th>
                    <th style="width: 45px;">S. #</th>
                    <th style="width: 95px;">Date</th>
                    <th style="width: 100px;">Order #</th>
                    <th style="width: 100px;">Item ID</th>
                    <th style="min-width: 180px;">Description</th>
                    <th class="text-center" style="width: 85px;">Issd Qty</th>
                    <th class="text-end" style="width: 90px;">Price</th>
                    <th class="text-end" style="width: 100px;">Value</th>
                    <th class="text-end" style="width: 90px;">Repair</th>
                    <th class="text-end" style="width: 105px;">Rcvd. Value</th>
                    <th class="text-center" style="width: 85px;">Rcvd Qty</th>
                    <th class="text-center" style="width: 90px;">Lot #</th>
                    <th>Process</th>
                    <th style="width: 90px;">Customer</th>
                </tr>
            </thead>
            <tbody>
                @if (IsLoading)
                {
                    <tr>
                        <td colspan="15" class="text-center py-4 text-muted">
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span> Loading maker billing lots...
                        </td>
                    </tr>
                }
                else if (!FilteredLots.Any())
                {
                    <tr>
                        <td colspan="15" class="text-center py-4 text-muted">
                            <i class="fas fa-info-circle me-1"></i> No unbilled lots found for this maker in the selected date range.
                        </td>
                    </tr>
                }
                else
                {
                    int idx = 1;
                    @foreach (var lot in FilteredLots)
                    {
                        <ContextMenuTrigger MenuId="lotContextMenu" Data="@lot" WrapperTag="tr" class="@(lot.Audited ? "table-primary text-primary" : (lot.IsSelected ? "table-light" : ""))" @onclick="() => ShowImagePreview(lot.ItemCode)">
                            <td class="text-center" @onclick:stopPropagation="true">
                                <input class="form-check-input" type="checkbox" @bind="lot.IsSelected" @bind:after="OnSelectionChanged" />
                            </td>
                            <td>@(idx++)</td>
                            <td>@lot.DT.ToString("dd-MMM-yy")</td>
                            <td class="fw-semibold">@lot.OrderNo</td>
                            <td><span class="badge bg-secondary">@lot.ItemCode</span></td>
                            <td class="fw-semibold @(lot.Audited ? "text-primary" : "text-dark")" @onmouseenter="() => ShowImagePreview(lot.ItemCode)" title="@lot.ItemName">
                                @lot.ItemName
                            </td>
                            <td class="text-center fw-bold">@lot.IssQty.ToString("N0")</td>
                            <td class="text-end" @onclick:stopPropagation="true">
                                @if (EditingLotId == lot.EntryID)
                                {
                                    <div class="input-group input-group-sm" style="min-width: 110px;">
                                        <input type="number" class="form-control form-control-sm text-end fw-bold py-0" @bind="EditingRate" @onkeydown="@(e => OnRateKeyDown(e, lot))" autofocus />
                                        <button class="btn btn-sm btn-success py-0 px-1" @onclick="() => SaveRate(lot)"><i class="fas fa-check"></i></button>
                                        <button class="btn btn-sm btn-secondary py-0 px-1" @onclick="CancelRateEdit"><i class="fas fa-times"></i></button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-primary fw-bold text-decoration-underline" style="cursor: pointer;" @onclick="() => StartRateEdit(lot)" title="Click to edit rate">
                                        @lot.Rate.ToString("N2")
                                    </span>
                                }
                            </td>
                            <td class="text-end fw-bold">@lot.IssValue.ToString("N2")</td>
                            <td class="text-end text-danger">@lot.RepairAmt.ToString("N0")</td>
                            <td class="text-end fw-bold text-success">@lot.RcvdValue.ToString("N2")</td>
                            <td class="text-center fw-bold">@lot.RcvdQty.ToString("N0")</td>
                            <td class="text-center">
                                <span class="badge px-2 py-1" style="background-color: #2196F3; color: #ffffff; font-weight: 700; border-radius: 4px;">
                                    @lot.LotNo
                                </span>
                            </td>
                            <td><span class="badge bg-info text-dark">@lot.Process</span></td>
                            <td class="fw-semibold">@lot.CustCode</td>
                        </ContextMenuTrigger>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Live Image Preview Card when ShowPicture is checked -->
    @if (ShowPicture && !string.IsNullOrWhiteSpace(HoveredImage))
    {
        <div class="card shadow border position-fixed p-2 bg-white" style="bottom: 120px; right: 35px; z-index: 1050; border-radius: 12px; width: 220px; backdrop-filter: blur(8px);">
            <div class="d-flex align-items-center justify-content-between pb-1 mb-1 border-bottom">
                <span class="fw-bold text-secondary small"><i class="fas fa-image text-primary me-1"></i> Item Picture</span>
                <button type="button" class="btn-close btn-sm" style="font-size: 0.65rem;" @onclick="() => HoveredImage = string.Empty"></button>
            </div>
            <div class="d-flex align-items-center justify-content-center bg-light rounded p-1" style="min-height: 140px;">
                <img src="@HoveredImage" class="img-fluid rounded" alt="Item Preview" style="max-height: 160px; max-width: 100%; object-fit: contain;" />
            </div>
        </div>
    }

    <!-- Financial Summary & Deductions Strip -->
    <div class="p-3 bg-light rounded-3 border">
        <div class="row g-2 text-center align-items-center mb-3">
            <div class="col-md-2">
                <div class="text-muted small fw-bold text-uppercase">Total Lots</div>
                <div class="fs-5 fw-bold text-dark">@Lots.Count</div>
            </div>
            <div class="col-md-2">
                <div class="text-muted small fw-bold text-uppercase">Audited Lots</div>
                <div class="fs-5 fw-bold text-primary">@AuditedLotsCount</div>
            </div>
            <div class="col-md-2">
                <div class="text-muted small fw-bold text-uppercase">Selected Lots</div>
                <div class="fs-5 fw-bold text-success">@SelectedLots.Count</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small fw-bold text-uppercase">Selected Qty</div>
                <div class="fs-5 fw-bold text-dark">@TotalSelectedQty.ToString("N0") Pcs</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small fw-bold text-uppercase">Selected Value</div>
                <div class="fs-5 fw-bold text-success">@TotalSelectedValue.ToString("N2")</div>
            </div>
        </div>

        <hr class="my-2" />

        <!-- Deductions & Net Posting Row -->
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-1 text-muted small fw-bold">S.T Deduction</label>
                <input type="number" class="form-control form-control-sm text-end fw-bold text-danger" @bind="ShortTermDeduction" @bind:after="OnDeductionChanged" />
            </div>
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-1 text-muted small fw-bold">L.T Ded.</label>
                <input type="number" class="form-control form-control-sm text-end fw-bold text-danger" @bind="LongTermDeduction" @bind:after="OnDeductionChanged" />
            </div>
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-1 text-muted small fw-bold">Repair Amount</label>
                <input type="text" class="form-control form-control-sm text-end fw-bold text-danger bg-white" value="@EffectiveRepairDeduction.ToString("N2")" readonly />
            </div>
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-1 text-muted small fw-bold">Material Ded.</label>
                <input type="text" class="form-control form-control-sm text-end fw-bold text-danger bg-white" value="@MaterialDeductionAmount.ToString("N2")" readonly />
            </div>
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-1 text-muted small fw-bold">Manual Ded.</label>
                <input type="text" class="form-control form-control-sm text-end fw-bold text-danger bg-white" value="@ManualDeductionAmount.ToString("N2")" readonly />
            </div>
            <div class="col-md-2 text-end">
                <div class="text-muted small fw-bold text-uppercase">Net Payable (Value)</div>
                <div class="fs-4 fw-bold @(NetPayableAmount > 0 ? "text-success" : "text-danger")">
                    @NetPayableAmount.ToString("N2")
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Context Menu for Billing Grid with Standard Win11Style Classes -->
<ContextMenu Id="lotContextMenu" Template="Win11Style">
    <div class="win11-section-header">Lot Actions</div>
    <Item class="win11-menu-item" OnClick="@ContextEditRate">
        <i class="fas fa-pencil-alt fa-fw win11-icon text-primary"></i> Edit Rate
    </Item>
    <Item class="win11-menu-item" OnClick="@ContextHideLot">
        <i class="fas fa-eye-slash fa-fw win11-icon text-warning"></i> Hide from Billing
    </Item>
    <div class="win11-divider"></div>
    <Item class="win11-menu-item" OnClick="@ContextPrintPTC">
        <i class="fas fa-file-alt fa-fw win11-icon text-dark"></i> Print PTC (Receiving Slip)
    </Item>
</ContextMenu>

<style>
    .blazor-context-menu {
        z-index: 100000 !important;
        max-height: 40vh !important;
        overflow-y: auto !important;
    }
</style>
