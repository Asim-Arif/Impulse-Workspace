@using DataAccessLibrary.Models.ViewModels.Production
@using Impulse.Services.Production

@if (IsOpen && Model != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.5); z-index: 100050; font-family: 'Calibri', 'Segoe UI', sans-serif;">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
                <div class="modal-header bg-primary text-white py-2 px-3">
                    <h6 class="modal-title fw-bold mb-0" style="font-size: 1.05rem;">
                        <i class="fas @(Model.EntryID == 0 ? "fa-plus-circle" : "fa-pencil-alt") me-2"></i>
                        @(Model.EntryID == 0 ? "Create New Wastage Type" : $"Edit Wastage Type: {Model.WastageName}")
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-3">

                    <!-- Wastage Name -->
                    <div class="mb-3">
                        <label class="form-label form-label-sm fw-bold text-secondary mb-1" style="font-size: 0.85rem;">
                            Wastage Name / Description <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control form-control-sm fw-bold"
                               style="height: 33px; font-size: 0.95rem;"
                               placeholder="e.g. Cutting Scrap, Stitching Rejection, Fabric Defect..."
                               @bind="Model.WastageName" />
                    </div>

                    <!-- Cost Allocation Strategy -->
                    <div class="mb-3">
                        <label class="form-label form-label-sm fw-bold text-secondary mb-1" style="font-size: 0.85rem;">
                            Cost Allocation Strategy <span class="text-danger">*</span>
                        </label>

                        <div class="d-flex flex-column gap-2">
                            <!-- Store -->
                            <div class="form-check p-2 rounded border @(Model.WastageType == 0 ? "border-primary bg-primary bg-opacity-10" : "bg-light")" style="cursor: pointer;" @onclick="() => Model.WastageType = 0">
                                <input class="form-check-input ms-1 me-2" type="radio" name="radWastageType" id="wtStore" checked="@(Model.WastageType == 0)" @onchange="() => Model.WastageType = 0" />
                                <label class="form-check-label fw-bold text-dark mb-0" for="wtStore" style="cursor: pointer; font-size: 0.88rem;">
                                    <span class="badge bg-secondary me-1">0</span> Charge to Store
                                </label>
                                <div class="text-muted small ms-4">Company absorbed overhead / scrap expense</div>
                            </div>

                            <!-- Vendor -->
                            <div class="form-check p-2 rounded border @(Model.WastageType == 1 ? "border-danger bg-danger bg-opacity-10" : "bg-light")" style="cursor: pointer;" @onclick="() => Model.WastageType = 1">
                                <input class="form-check-input ms-1 me-2" type="radio" name="radWastageType" id="wtVendor" checked="@(Model.WastageType == 1)" @onchange="() => Model.WastageType = 1" />
                                <label class="form-check-label fw-bold text-dark mb-0" for="wtVendor" style="cursor: pointer; font-size: 0.88rem;">
                                    <span class="badge bg-danger me-1">1</span> Charge to Vendor / Maker
                                </label>
                                <div class="text-muted small ms-4">Deducted from vendor billing vouchers and contractor payments</div>
                            </div>

                            <!-- Originator -->
                            <div class="form-check p-2 rounded border @(Model.WastageType == 2 ? "border-warning bg-warning bg-opacity-10" : "bg-light")" style="cursor: pointer;" @onclick="() => Model.WastageType = 2">
                                <input class="form-check-input ms-1 me-2" type="radio" name="radWastageType" id="wtOriginator" checked="@(Model.WastageType == 2)" @onchange="() => Model.WastageType = 2" />
                                <label class="form-check-label fw-bold text-dark mb-0" for="wtOriginator" style="cursor: pointer; font-size: 0.88rem;">
                                    <span class="badge bg-warning text-dark me-1">2</span> Charge to Originator
                                </label>
                                <div class="text-muted small ms-4">Debited directly back to the responsible employee or operator</div>
                            </div>

                            <!-- Ask -->
                            <div class="form-check p-2 rounded border @(Model.WastageType == 3 ? "border-info bg-info bg-opacity-10" : "bg-light")" style="cursor: pointer;" @onclick="() => Model.WastageType = 3">
                                <input class="form-check-input ms-1 me-2" type="radio" name="radWastageType" id="wtAsk" checked="@(Model.WastageType == 3)" @onchange="() => Model.WastageType = 3" />
                                <label class="form-check-label fw-bold text-dark mb-0" for="wtAsk" style="cursor: pointer; font-size: 0.88rem;">
                                    <span class="badge bg-info text-dark me-1">3</span> Charge to Ask
                                </label>
                                <div class="text-muted small ms-4">Allocation is determined and finalized during lot receiving authorization</div>
                            </div>
                        </div>
                    </div>

                    <!-- Status Toggle -->
                    <div class="p-2 bg-light rounded border d-flex align-items-center justify-content-between">
                        <div>
                            <span class="fw-bold text-dark" style="font-size: 0.88rem;">Active Status</span>
                            <div class="text-muted small">Enable or disable this wastage type for new receiving entries</div>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="chkClosed"
                                   style="cursor: pointer; width: 2.2em; height: 1.2em;"
                                   checked="@(!Model.Closed)"
                                   @onchange="(e) => Model.Closed = !(bool)(e.Value ?? true)" />
                        </div>
                    </div>

                </div>
                <div class="modal-footer bg-light py-2 px-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-sm btn-secondary fw-bold" @onclick="CloseModal" disabled="@IsSaving">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary fw-bold px-4" @onclick="SaveWastageTypeAsync" disabled="@(IsSaving || string.IsNullOrWhiteSpace(Model.WastageName))">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="fas fa-check-circle me-1"></i>
                            <span>@(Model.EntryID == 0 ? "Save Wastage Type" : "Update Wastage Type")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}
