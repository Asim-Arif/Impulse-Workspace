@using DataAccessLibrary.Models.ViewModels.Production
@using Impulse.Services.Production

@if (IsOpen && Process != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.5); z-index: 100050;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 14px;">
                <div class="modal-header bg-primary text-white py-2 px-3">
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="fas fa-clipboard-check me-2"></i> Quality Inspection Points &mdash; @Process.Description (@Process.Code)
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-3">

                    <!-- New Checkpoint Entry Bar -->
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <label class="form-label form-label-sm fw-bold text-secondary mb-1">
                            <i class="fas fa-plus-circle text-primary me-1"></i> Add Inspection Checkpoint
                        </label>
                        <div class="input-group input-group-sm">
                            <input type="text"
                                   class="form-control"
                                   placeholder="e.g. Check stitch density, dimensions, color match, finishing quality..."
                                   @bind="NewPointDescription"
                                   @bind:event="oninput"
                                   @onkeyup="HandleKeyUp" />
                            <button type="button"
                                    class="btn btn-primary fw-bold px-3"
                                    @onclick="AddPointAsync"
                                    disabled="@(string.IsNullOrWhiteSpace(NewPointDescription) || IsSaving)">
                                @if (IsSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <i class="fas fa-plus me-1"></i>
                                    <span>Add Point</span>
                                }
                            </button>
                        </div>
                    </div>

                    <!-- Inspection Points List Grid -->
                    <div class="table-responsive border rounded-3" style="max-height: 45vh; overflow-y: auto;">
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                            <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                <tr>
                                    <th style="width: 50px;" class="text-center">S. #</th>
                                    <th>Inspection Checkpoint Description</th>
                                    <th style="width: 110px;" class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (IsLoading)
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted">
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span> Loading checkpoints...
                                        </td>
                                    </tr>
                                }
                                else if (!Points.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted">
                                            <i class="fas fa-check-double fa-2x d-block mb-2 text-secondary opacity-50"></i>
                                            No inspection points configured for this process yet.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    int idx = 1;
                                    @foreach (var pt in Points)
                                    {
                                        <tr>
                                            <td class="text-center fw-semibold text-muted">@(idx++)</td>
                                            <td>
                                                @if (EditingEntryId == pt.EntryID)
                                                {
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" class="form-control" @bind="EditingDescription" />
                                                        <button type="button" class="btn btn-success btn-sm" title="Save" @onclick="() => SaveEditAsync(pt)">
                                                            <i class="fas fa-check"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-secondary btn-sm" title="Cancel" @onclick="CancelEdit">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="fw-semibold text-dark">@pt.Point_Description</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (EditingEntryId != pt.EntryID)
                                                {
                                                    <div class="d-flex align-items-center justify-content-center gap-1">
                                                        <button type="button" class="btn btn-link btn-sm p-1 text-primary" title="Edit Point" @onclick="() => StartEdit(pt)">
                                                            <i class="fas fa-pencil-alt"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-link btn-sm p-1 text-danger" title="Delete Point" @onclick="() => DeletePointAsync(pt.EntryID)">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
                <div class="modal-footer bg-light py-2 px-3 d-flex justify-content-between">
                    <div class="text-muted small">
                        Total Checkpoints: <strong class="text-dark">@Points.Count</strong>
                    </div>
                    <button type="button" class="btn btn-sm btn-secondary fw-bold px-3" @onclick="CloseModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}
