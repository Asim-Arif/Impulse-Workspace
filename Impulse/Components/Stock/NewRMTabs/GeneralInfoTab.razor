@using DataAccessLibrary.Models.ViewModels.Stock

<div class="row g-3">
    <!-- Row 1 -->
    <div class="col-md-6">
        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">Raw Material Name</label>
        <input type="text" class="form-control form-control-sm" @bind="Model.RMName" placeholder="Enter Raw Material Name" />
    </div>
    <div class="col-md-6">
        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">Raw Material Description</label>
        <input type="text" class="form-control form-control-sm" @bind="Model.Description" placeholder="Enter Description" />
    </div>

    <!-- Row 2 -->
    <div class="col-md-6">
        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">Urdu Name</label>
        <input type="text" class="form-control form-control-sm text-end" @bind="Model.UrduName" placeholder="اردو نام" dir="rtl" />
    </div>
    <div class="col-md-6">
        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">RM Maker Description</label>
        <input type="text" class="form-control form-control-sm" @bind="Model.RM_Maker_Description" />
    </div>

    <!-- Row 3 -->
    <div class="col-md-4">
        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">Item Usage</label>
        <input type="text" class="form-control form-control-sm" @bind="Model.RMUsage" />
    </div>
    <div class="col-md-4">
        <div class="row g-2">
            <div class="col-6">
                <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">Size</label>
                <input type="number" step="any" class="form-control form-control-sm" @bind="Model.RMSize" />
            </div>
            <div class="col-6">
                <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">Unit (Size)</label>
                <select class="form-select form-select-sm" @bind="Model.SizeUnit">
                    <option value="">-- Select --</option>
                    @foreach (var u in Units)
                    {
                        <option value="@u">@u</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">Weight / Length</label>
        <input type="text" class="form-control form-control-sm" @bind="Model.Weight_Length" />
    </div>

    <!-- Row 4 -->
    <div class="col-md-3">
        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">Primary Unit</label>
        <select class="form-select form-select-sm" @bind="Model.Unit">
            <option value="">-- Select --</option>
            @foreach (var u in Units)
            {
                <option value="@u">@u</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">Rate</label>
        <input type="number" step="any" class="form-control form-control-sm text-end" @bind="Model.Rate" />
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">Maker Rate</label>
        <input type="number" step="any" class="form-control form-control-sm text-end" @bind="Model.MakerRate" />
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">Opening Stock</label>
        <input type="number" step="any" class="form-control form-control-sm text-end" @bind="Model.OpeningStock" />
    </div>

    <!-- Row 5 -->
    <div class="col-md-3">
        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">Min. Level</label>
        <input type="number" step="any" class="form-control form-control-sm text-end" @bind="Model.MinLevel" />
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">Max. Level</label>
        <input type="number" step="any" class="form-control form-control-sm text-end" @bind="Model.MaxLevel" />
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">Reorder Point</label>
        <input type="number" step="1" class="form-control form-control-sm text-end" @bind="Model.ReorderPoint" />
    </div>
</div>

<!-- Row 6 -->
<div class="row g-3 mt-1">
    <div class="col-12 d-flex gap-4">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="chkReturnable" @bind="Model.Returnable" />
            <label class="form-check-label fw-bold text-secondary" for="chkReturnable" style="font-size:0.82rem;">Returnable Material</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="chkMaleGrinding" @bind="Model.RequiresMaleGrinding" />
            <label class="form-check-label fw-bold text-secondary" for="chkMaleGrinding" style="font-size:0.82rem;">Requires Male Grinding</label>
        </div>
    </div>
</div>
