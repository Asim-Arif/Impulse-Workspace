@namespace Impulse.Components.Common

<div class="entity-attachment-manager">
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 px-3 mb-3" role="alert" style="font-size: 0.85rem;">
            <i class="fas fa-exclamation-triangle me-2"></i> @ErrorMessage
            <button type="button" class="btn-close py-2" @onclick="() => ErrorMessage = null"></button>
        </div>
    }

    @if (!IsReadOnly)
    {
        <div class="upload-zone card border border-dashed mb-3" style="border-style: dashed !important; border-width: 2px !important; border-color: #cbd5e1 !important; background: #f8fafc; border-radius: 10px;">
            <div class="card-body p-3">
                <div class="row g-2 align-items-center">
                    <div class="col-md-5">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                            <i class="fas fa-cloud-upload-alt me-1 text-primary"></i> Select File(s)
                        </label>
                        <InputFile OnChange="HandleFilesSelected" multiple class="form-control form-control-sm" style="font-size: 0.82rem;" disabled="@IsUploading" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                            <i class="fas fa-comment-alt me-1 text-secondary"></i> Optional Remarks / Description
                        </label>
                        <input type="text" class="form-control form-control-sm" placeholder="e.g., Tax certificate, Signed PO, Quality report..." @bind="UploadRemarks" @bind:event="oninput" disabled="@IsUploading" style="height: 31px; font-size: 0.82rem;" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="button" class="btn btn-primary btn-sm w-100" @onclick="TriggerUploadAsync" disabled="@(SelectedFiles.Count == 0 || IsUploading)" style="height: 31px; font-size: 0.82rem;">
                            @if (IsUploading)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Uploading...</span>
                            }
                            else
                            {
                                <i class="fas fa-upload me-1"></i>
                                <span>Upload @(SelectedFiles.Count > 0 ? $"({SelectedFiles.Count})" : "")</span>
                            }
                        </button>
                    </div>
                </div>

                @if (SelectedFiles.Count > 0)
                {
                    <div class="mt-2 pt-2 border-top d-flex flex-wrap gap-2">
                        @foreach (var file in SelectedFiles)
                        {
                            <span class="badge bg-white text-dark border px-2 py-1 d-inline-flex align-items-center" style="font-size: 0.78rem;">
                                <i class="fas fa-file me-1 text-primary"></i>
                                @file.Name <small class="text-muted ms-1">(@FormatBytes(file.Size))</small>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- Attachments Table / State -->
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.95); border-radius: 10px; overflow: hidden;">
        <div class="card-header bg-white border-bottom py-2 px-3 d-flex justify-content-between align-items-center">
            <span class="fw-bold text-secondary" style="font-size: 0.85rem;">
                <i class="fas fa-paperclip text-primary me-1"></i> Attached Documents
                <span class="badge rounded-pill bg-primary ms-1" style="font-size: 0.75rem;">@Attachments.Count</span>
            </span>
            <button type="button" class="btn btn-sm btn-link text-secondary text-decoration-none p-0" @onclick="LoadAttachmentsAsync" disabled="@IsLoading" title="Refresh">
                <i class="fas fa-sync-alt @(IsLoading ? "fa-spin" : "")"></i>
            </button>
        </div>

        <div class="card-body p-0">
            @if (IsLoading)
            {
                <div class="text-center py-4 text-muted">
                    <span class="spinner-border spinner-border-sm me-2 text-primary"></span>
                    <span style="font-size: 0.85rem;">Loading attachments...</span>
                </div>
            }
            else if (Attachments.Count == 0)
            {
                <div class="text-center py-4 text-muted">
                    <i class="fas fa-folder-open fa-2x mb-2 text-secondary opacity-50"></i>
                    <p class="mb-0 fw-medium" style="font-size: 0.85rem;">No attachments uploaded yet.</p>
                    <small class="text-muted" style="font-size: 0.78rem;">Upload files of any type (PDF, Excel, Images, Word, ZIP, etc.).</small>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.85rem;">
                        <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase;">
                            <tr>
                                <th style="width: 40px;" class="text-center">#</th>
                                <th>File Name</th>
                                <th>Remarks</th>
                                <th style="width: 90px;" class="text-end">Size</th>
                                <th style="width: 150px;">Uploaded By</th>
                                <th style="width: 140px;">Date</th>
                                <th style="width: 110px;" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Attachments.Count; i++)
                            {
                                var item = Attachments[i];
                                <tr>
                                    <td class="text-center text-muted" style="font-size: 0.78rem;">@(i + 1)</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="@item.FileIconClass me-2" style="font-size: 1.15rem;"></i>
                                            <a href="@($"/api/attachments/view/{item.Id}")" target="_blank" class="fw-semibold text-decoration-none text-dark text-truncate" style="max-width: 250px;" title="Click to view @item.OriginalFileName">
                                                @item.OriginalFileName
                                            </a>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Remarks))
                                        {
                                            <span class="text-secondary" style="font-size: 0.82rem;">@item.Remarks</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic" style="font-size: 0.78rem;">-</span>
                                        }
                                    </td>
                                    <td class="text-end text-muted font-monospace" style="font-size: 0.8rem;">
                                        @item.FormattedFileSize
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border fw-normal" style="font-size: 0.76rem;">
                                            <i class="fas fa-user-circle me-1 text-secondary"></i> @item.UploadedBy
                                        </span>
                                    </td>
                                    <td class="text-muted" style="font-size: 0.8rem;">
                                        @item.UploadedAt.ToString("dd-MMM-yyyy hh:mm tt")
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a href="@($"/api/attachments/view/{item.Id}")" target="_blank" class="btn btn-sm btn-outline-secondary py-0 px-2" title="View / Preview file">
                                                <i class="fas fa-eye text-primary"></i>
                                            </a>
                                            <a href="@($"/api/attachments/download/{item.Id}")" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Download file">
                                                <i class="fas fa-download text-success"></i>
                                            </a>
                                            @if (!IsReadOnly)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="() => RequestDeleteAsync(item)" title="Delete attachment">
                                                    <i class="fas fa-trash-alt text-danger"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
