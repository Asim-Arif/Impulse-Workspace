@namespace Impulse.Components.Common

@if (IsOpen)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.55); backdrop-filter: blur(4px); z-index: 100050; display: flex; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box; font-family: 'Calibri', 'Segoe UI', sans-serif;">
        <div class="shadow-lg border-0" style="width: 1000px; max-width: 96vw; max-height: 92vh; background: #ffffff; border-radius: 12px; display: flex; flex-direction: column; overflow: hidden;">
            <div class="bg-primary text-white py-2 px-3 d-flex align-items-center justify-content-between" style="flex-shrink: 0;">
                <h6 class="modal-title fw-bold mb-0" style="font-size: 1.05rem;">
                    <i class="fas fa-paperclip me-2"></i>
                    <span>Attachments</span>
                    @if (!string.IsNullOrWhiteSpace(EntityDisplayName))
                    {
                        <span class="fw-normal opacity-90 ms-2" style="font-size: 0.95rem;">— @EntityDisplayName</span>
                    }
                </h6>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
            </div>

            <div class="p-3" style="overflow-y: auto; flex-grow: 1;">
                <EntityAttachmentManager EntityType="@EntityType"
                                         EntityId="@EntityId"
                                         EntitySecondaryId="@EntitySecondaryId"
                                         EntityDisplayName="@EntityDisplayName"
                                         OnCountChanged="HandleCountChanged" />
            </div>

            <div class="modal-footer border-top py-2 px-3 bg-light d-flex justify-content-end" style="flex-shrink: 0;">
                <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseModal">
                    <i class="fas fa-times me-1"></i> Close
                </button>
            </div>
        </div>
    </div>
}
