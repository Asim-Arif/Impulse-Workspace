@namespace Impulse.Components.Common

<div class="entity-notes-manager card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.95); border-radius: 12px; overflow: hidden;">
    <div class="card-header bg-white border-bottom py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <span class="fw-bold text-secondary" style="font-size: 0.88rem;">
                <i class="fas fa-sticky-note text-warning me-1"></i> General Notes
            </span>

            @if (LastModifiedAt.HasValue)
            {
                <span class="badge bg-light text-secondary border px-2 py-1" style="font-size: 0.78rem;">
                    <i class="fas fa-clock me-1 text-primary"></i>
                    Last modified: @LastModifiedAt.Value.ToString("dd-MMM-yyyy hh:mm tt")
                    @if (!string.IsNullOrWhiteSpace(LastModifiedBy))
                    {
                        <span>by <strong>@LastModifiedBy</strong></span>
                    }
                </span>
            }

            @if (HasUnsavedChanges)
            {
                <span class="badge bg-warning text-dark px-2 py-1" style="font-size: 0.75rem;">
                    <i class="fas fa-circle me-1" style="font-size: 0.55rem;"></i> Unsaved Changes
                </span>
            }
            else if (!IsLoading && !string.IsNullOrEmpty(CurrentNoteText))
            {
                <span class="badge bg-light text-success border px-2 py-1" style="font-size: 0.75rem;">
                    <i class="fas fa-check-circle me-1"></i> All Changes Saved
                </span>
            }
        </div>

        <div class="d-flex align-items-center gap-2">
            @if (!IsReadOnly)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="InsertTimestampAndUser" disabled="@IsLoading" title="Insert your name, date, and time header">
                    <i class="fas fa-stamp me-1 text-primary"></i> Insert Date & Name
                </button>
                <button type="button" class="btn btn-primary btn-sm px-3" @onclick="SaveNoteAsync" disabled="@(IsSaving || IsLoading)" title="Save Note (Ctrl+S)">
                    @if (IsSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="fas fa-save me-1"></i>
                        <span>Save Note</span>
                    }
                </button>
            }
        </div>
    </div>

    <div class="card-body p-3">
        @if (IsLoading)
        {
            <div class="text-center py-5 text-muted">
                <span class="spinner-border spinner-border-sm me-2 text-primary"></span>
                <span style="font-size: 0.88rem;">Loading notes...</span>
            </div>
        }
        else
        {
            <div class="position-relative">
                <textarea class="form-control"
                          rows="16"
                          placeholder="Type customer notes, historical background, special instructions, contact records, or any comments here..."
                          value="@CurrentNoteText"
                          @oninput="OnTextChanged"
                          @onkeydown="HandleKeyDown"
                          disabled="@(IsReadOnly || IsSaving)"
                          style="font-family: 'Segoe UI', Calibri, sans-serif; font-size: 0.92rem; line-height: 1.6; border-radius: 8px; border: 1px solid #cbd5e1; padding: 14px; background: #fafafa; resize: vertical; min-height: 380px;">
                </textarea>
                <div class="d-flex justify-content-between align-items-center mt-2 px-1 text-muted" style="font-size: 0.75rem;">
                    <span><i class="fas fa-keyboard me-1 text-secondary"></i> Tip: Press <strong>Ctrl + S</strong> inside the notepad to save instantly.</span>
                    <span>@CharacterCount characters</span>
                </div>
            </div>
        }
    </div>
</div>
