@using DataAccessLibrary.Models.ViewModels.Export

<div class="row g-3">
    <div class="col-md-6">
        <div class="card border h-100" style="border-radius:8px;">
            <div class="card-header py-2 fw-bold text-secondary" style="background:#eef0f7; font-size:0.8rem; border-radius:8px 8px 0 0;">
                <i class="fas fa-sticky-note me-1 text-primary"></i> Notes I
            </div>
            <div class="card-body py-2">
                <textarea class="form-control form-control-sm" rows="20" @bind="Proforma.Notes1"
                          style="font-size:0.78rem; resize:none;"></textarea>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card border h-100" style="border-radius:8px;">
            <div class="card-header py-2 fw-bold text-secondary" style="background:#eef0f7; font-size:0.8rem; border-radius:8px 8px 0 0;">
                <i class="fas fa-sticky-note me-1 text-primary"></i> Notes II
            </div>
            <div class="card-body py-2">
                <textarea class="form-control form-control-sm" rows="20" @bind="Proforma.Notes2"
                          style="font-size:0.78rem; resize:none;"></textarea>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public ProformaInvoiceViewModel Proforma { get; set; } = default!;
}
