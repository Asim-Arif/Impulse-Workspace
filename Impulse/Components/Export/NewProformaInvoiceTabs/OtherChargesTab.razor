@using DataAccessLibrary.Models.ViewModels.Export

<div class="row g-2 mb-3 align-items-end">
    <div class="col-md-8">
        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.78rem;">Charges Description</label>
        <input type="text" class="form-control form-control-sm" @bind="NewCharge.ChargesDetail" placeholder="Enter charge description..." />
    </div>
    <div class="col-md-2">
        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.78rem;">Amount</label>
        <input type="number" class="form-control form-control-sm text-end" @bind="NewCharge.ChargesAmt" />
    </div>
    <div class="col-md-2">
        <button type="button" class="btn btn-sm btn-primary w-100" @onclick="AddCharge">
            <i class="fas fa-plus me-1"></i>Add Charge
        </button>
    </div>
</div>

<div class="table-responsive" style="max-height: 380px; overflow-y: auto;">
    <table class="table table-sm table-bordered table-hover mb-0" style="font-size: 0.8rem;">
        <thead class="table-header-sticky">
            <tr style="background: #eef0f7; font-size: 0.78rem; font-weight: 700; color: #44474f;">
                <th style="width:50px;" class="text-center">S/No.</th>
                <th>Charges Description</th>
                <th style="width:100px;" class="text-end">Amount</th>
                <th style="width:40px;" class="text-center"></th>
            </tr>
        </thead>
        <tbody>
            @if (OtherCharges != null && OtherCharges.Any())
            {
                @foreach (var charge in OtherCharges)
                {
                    <tr>
                        <td class="text-center text-muted">@charge.SNo</td>
                        <td>@charge.ChargesDetail</td>
                        <td class="text-end fw-bold">@charge.ChargesAmt.ToString("N2")</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-link btn-sm p-0 text-danger" title="Remove" @onclick="() => RemoveCharge(charge)">
                                <i class="fas fa-trash-alt" style="font-size:0.7rem;"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4" style="font-size:0.82rem;">
                        <i class="fas fa-info-circle me-2"></i>No other charges added.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .table-header-sticky th { position: sticky; top: 0; z-index: 2; background: #eef0f7 !important; }
</style>
