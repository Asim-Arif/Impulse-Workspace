@using DataAccessLibrary.Models.ViewModels.Export

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <!-- List View -->
        <div class="table-responsive mb-4" style="max-height: 350px; overflow-y: auto;">
            <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light text-secondary sticky-top" style="z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                    <tr>
                        <th class="text-center" style="width: 50px;">S#</th>
                        <th>Charge Detail</th>
                        <th class="text-end">Amount</th>
                        <th class="text-center" style="width: 80px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Quotation.OtherCharges == null || !Quotation.OtherCharges.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">No other charges added to this quotation yet.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var charge in Quotation.OtherCharges.OrderBy(c => c.SNo))
                        {
                            var currentCharge = charge;
                            <tr class="@(IsEditing && EditingCharge == currentCharge ? "table-warning" : "")">
                                <td class="text-center text-muted">@charge.SNo</td>
                                <td>@charge.ChargesDetail</td>
                                <td class="text-end">@charge.ChargesAmt.ToString("N2")</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary border-0 p-1 me-1" title="Edit Charge" @onclick="() => OnChargeEdit.InvokeAsync(currentCharge)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger border-0 p-1" title="Remove Charge" @onclick="() => OnChargeDeleted.InvokeAsync(currentCharge)">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Add New Charge Section -->
        <div class="card border mb-3" style="background: #f8f9fb; border-radius: 8px;">
            <div class="card-header py-2 fw-bold text-secondary" style="background: #eef0f7; border-radius: 8px 8px 0 0; font-size: 0.85rem;">
                <i class="fas fa-plus-circle me-1 text-primary"></i> Add/Edit Charge Row
            </div>
            <div class="card-body py-3">
                <div class="row g-3">
                    <!-- SNo -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">SNo</label>
                        <input type="number" class="form-control form-control-sm text-center" @bind="NewChargeInput.SNo" />
                    </div>

                    <!-- Charge Detail -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Charge Detail</label>
                        <input type="text" class="form-control form-control-sm" @bind="NewChargeInput.ChargesDetail" placeholder="Description of the charge" />
                    </div>

                    <!-- Amount -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Amount</label>
                        <input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="NewChargeInput.ChargesAmt" />
                    </div>

                    <div class="col-md-12 d-flex justify-content-end gap-2 mt-3">
                        @if (IsEditing)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OnCancelEdit.InvokeAsync()">Cancel Edit</button>
                            <button type="button" class="btn btn-sm btn-success" @onclick="() => OnChargeAdded.InvokeAsync()">
                                <i class="fas fa-check me-1"></i> Update Charge
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-primary" @onclick="() => OnChargeAdded.InvokeAsync()" disabled="@(string.IsNullOrWhiteSpace(NewChargeInput.ChargesDetail))">
                                <i class="fas fa-plus me-1"></i> Add to Charges
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public CustomerQuotationViewModel Quotation { get; set; } = default!;
    [Parameter] public CustomerQuotationOtherChargeViewModel NewChargeInput { get; set; } = new();
    
    [Parameter] public EventCallback OnChargeAdded { get; set; }
    [Parameter] public EventCallback<CustomerQuotationOtherChargeViewModel> OnChargeDeleted { get; set; }
    [Parameter] public EventCallback<CustomerQuotationOtherChargeViewModel> OnChargeEdit { get; set; }
    [Parameter] public EventCallback OnCancelEdit { get; set; }
    [Parameter] public bool IsEditing { get; set; }

    private CustomerQuotationOtherChargeViewModel? EditingCharge => IsEditing ? NewChargeInput : null;
}
