@using DataAccessLibrary.Models.ViewModels.Export
@using DataAccessLibrary.Models.ViewModels
@using Microsoft.AspNetCore.Components.Web

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <!-- List View -->
        <div class="table-responsive mb-4" style="max-height: 350px; overflow-y: auto;">
            <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light text-secondary sticky-top" style="z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                    <tr>
                        <th class="text-center" style="width: 50px;">S#</th>
                        <th>Item Code</th>
                        <th>Item Name</th>
                        <th class="text-center">Quality</th>
                        <th class="text-center">Delivery Date</th>
                        <th class="text-end">Price</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Total Amount</th>
                        <th class="text-center">Remarks</th>
                        <th class="text-center" style="width: 80px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Quotation.QuotationItems == null || !Quotation.QuotationItems.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">No items added to this quotation yet.</td>
                        </tr>
                    }
                    else
                    {
                        int sno = 1;
                        foreach (var item in Quotation.QuotationItems)
                        {
                            var currentItem = item;
                            <tr class="@(IsEditing && EditingItem == currentItem ? "table-warning" : "")">
                                <td class="text-center text-muted">@(sno++)</td>
                                <td>@item.ItemCode</td>
                                <td>@item.ItemName</td>
                                <td class="text-center">@item.QualityType</td>
                                <td class="text-center">@(item.DeliveryDT?.ToString("dd-MMM-yyyy"))</td>
                                <td class="text-end">@item.Price.ToString("F4")</td>
                                <td class="text-center">@item.Qty</td>
                                <td class="text-end">@((item.Price * item.Qty).ToString("N2"))</td>
                                <td class="text-truncate" style="max-width: 150px;" title="@item.ItemRemarks">@item.ItemRemarks</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary border-0 p-1 me-1" title="Edit Item" @onclick="() => OnItemEdit.InvokeAsync(currentItem)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger border-0 p-1" title="Remove Item" @onclick="() => OnItemDeleted.InvokeAsync(currentItem)">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Add New Item Section -->
        <div class="card border mb-3" style="background: #f8f9fb; border-radius: 8px;">
            <div class="card-header py-2 fw-bold text-secondary" style="background: #eef0f7; border-radius: 8px 8px 0 0; font-size: 0.85rem;">
                <i class="fas fa-plus-circle me-1 text-primary"></i> Add/Edit Item Row
            </div>
            <div class="card-body py-3">
                <div class="row g-3">
                    <!-- Item Code selector -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Item Code</label>
                        <BlazoredTypeahead SearchMethod="SearchItemCodes"
                                           EnableDropDown="true"
                                           Data="CatalogItems"
                                           TValue="CustomerOrderItemViewModel"
                                           TItem="CustomerOrderItemViewModel"
                                           Value="SelectedItem"
                                           ValueChanged="OnItemSelected"
                                           ValueExpression="@(() => SelectedItem)"
                                           Placeholder="Select Item Code">
                            <SelectedTemplate Context="cat">
                                @cat.ItemCode (@cat.Description)
                            </SelectedTemplate>
                            <ResultTemplate Context="cat">
                                @cat.ItemCode (@cat.Description)
                            </ResultTemplate>
                        </BlazoredTypeahead>
                    </div>
                    
                    <!-- Quality Type -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Quality Type</label>
                        <select class="form-select form-select-sm" @bind="NewItemInput.QualityType">
                            <option value="">Select Quality</option>
                            @foreach (var quality in Qualities)
                            {
                                <option value="@quality.DropDownValue_Description">@quality.DropDownValue_Description</option>
                            }
                        </select>
                    </div>

                    <!-- Delivery Date -->
                    <div class="col-md-1">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Del. Date</label>
                        <input type="date" class="form-control form-control-sm" @bind="NewItemInput.DeliveryDT" />
                    </div>

                    <!-- Price -->
                    <div class="col-md-1">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Price</label>
                        <input type="number" step="0.0001" class="form-control form-control-sm text-end" @bind="NewItemInput.Price" />
                    </div>

                    <!-- Qty -->
                    <div class="col-md-1">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Quantity</label>
                        <input type="number" class="form-control form-control-sm text-center" @bind="NewItemInput.Qty" />
                    </div>

                    <!-- Remarks -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Remarks</label>
                        <input type="text" class="form-control form-control-sm" @bind="NewItemInput.ItemRemarks" />
                    </div>

                    <div class="col-md-12 d-flex align-items-end justify-content-end gap-2 mt-2">
                        @if (IsEditing)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OnCancelEdit.InvokeAsync()">Cancel Edit</button>
                            <button type="button" class="btn btn-sm btn-success" @onclick="() => OnItemAdded.InvokeAsync()">
                                <i class="fas fa-check me-1"></i> Update Item
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-primary" @onclick="() => OnItemAdded.InvokeAsync()" disabled="@(string.IsNullOrWhiteSpace(NewItemInput.ItemCode))">
                                <i class="fas fa-plus me-1"></i> Add to Quotation
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public CustomerQuotationViewModel Quotation { get; set; } = default!;
    [Parameter] public List<CustomerOrderItemViewModel> CatalogItems { get; set; } = new();
    [Parameter] public List<GenericDropDownModel> Qualities { get; set; } = new();
    [Parameter] public CustomerQuotationItemViewModel NewItemInput { get; set; } = new();
    
    [Parameter] public EventCallback OnItemAdded { get; set; }
    [Parameter] public EventCallback<CustomerQuotationItemViewModel> OnItemDeleted { get; set; }
    [Parameter] public EventCallback<CustomerQuotationItemViewModel> OnItemEdit { get; set; }
    [Parameter] public EventCallback OnCancelEdit { get; set; }
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public EventCallback<CustomerOrderItemViewModel?> OnCatalogItemChanged { get; set; }
    [Parameter] public EventCallback<int> OnFinishingTypeChanged { get; set; }

    private CustomerOrderItemViewModel? SelectedItem { get; set; }
    private CustomerQuotationItemViewModel? EditingItem => IsEditing ? NewItemInput : null;

    protected override void OnParametersSet()
    {
        if (NewItemInput != null && !string.IsNullOrWhiteSpace(NewItemInput.ItemCode))
        {
            SelectedItem = CatalogItems.FirstOrDefault(c => c.ItemCode == NewItemInput.ItemCode);
        }
        else
        {
            SelectedItem = null;
        }
    }

    private async Task<IEnumerable<CustomerOrderItemViewModel>> SearchItemCodes(string searchText)
    {
        if (string.IsNullOrWhiteSpace(searchText)) return CatalogItems;
        return await Task.FromResult(CatalogItems.Where(c => 
            c.ItemCode.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            c.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList());
    }

    private async Task OnItemSelected(CustomerOrderItemViewModel? match)
    {
        SelectedItem = match;
        await OnCatalogItemChanged.InvokeAsync(match);
    }
}
