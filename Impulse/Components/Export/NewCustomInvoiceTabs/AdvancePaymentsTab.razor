@using DataAccessLibrary.Models.ViewModels.Export

<div class="row g-3">
    <div class="col-12">
        <div class="table-responsive border rounded" style="max-height: 400px; overflow-y: auto;">
            <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead style="position: sticky; top: 0; background: #f8f9fa; z-index: 1;">
                    <tr class="text-secondary">
                        <th style="width: 50px;" class="text-center">#</th>
                        <th>Advice No</th>
                        <th class="text-end" style="width: 120px;">Amount</th>
                        <th class="text-end" style="width: 120px;">Adjusted Amount</th>
                        <th class="text-end" style="width: 120px;">Balance</th>
                        <th class="text-center" style="width: 150px;">Adjust Now</th>
                    </tr>
                </thead>
                <tbody>
                    @if (AdvancePayments.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fas fa-money-bill-wave fs-4 mb-2 d-block text-black-50"></i>
                                No available advance payments found for this customer.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int index = 1;
                        foreach (var adv in AdvancePayments)
                        {
                            <tr @key="adv.EntryID">
                                <td class="text-center text-secondary">@(index++)</td>
                                <td>@adv.AdviceNo</td>
                                <td class="text-end fw-bold">@adv.Amount.ToString("N2")</td>
                                <td class="text-end">@adv.AdjustedAmount.ToString("N2")</td>
                                <td class="text-end text-success fw-bold">@((adv.Amount - adv.AdjustedAmount).ToString("N2"))</td>
                                <td class="text-center">
                                    <input type="number" class="form-control form-control-sm text-center fw-bold px-1" 
                                           @bind="adv.AdjustNow" max="@(adv.Amount - adv.AdjustedAmount)" min="0" step="0.01" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [Parameter] public List<AdvancePaymentModel> AdvancePayments { get; set; } = new();
}
