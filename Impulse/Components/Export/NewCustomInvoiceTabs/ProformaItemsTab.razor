@using DataAccessLibrary.Models.ViewModels.Export
@using DataAccessLibrary.Models.ViewModels
@using Impulse.Services.Export
@inject ICustomInvoiceService InvoiceService
@inject NotificationService NotificationService
@inject IJSRuntime JSRuntime

<div class="row g-3">
    <!-- Entry Form Panel -->
    <div class="col-md-12">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light fw-bold py-2" style="font-size: 0.85rem;">
                <i class="fas fa-edit me-1"></i> Proforma Item Entry
            </div>
            <div class="card-body" style="font-size: 0.85rem;">
                <!-- Row 1: Item, Proforma, Call from Dispatch -->
                <div class="row g-2 mb-3 align-items-end">
                    <!-- Item dropdown covers more than half (col-md-6) -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-secondary mb-1">Select Item</label>
                        <BlazoredTypeahead SearchMethod="SearchItems"
                                           EnableDropDown="true"
                                           Data="CustomerItems"
                                           TValue="GenericDropDownModel"
                                           TItem="GenericDropDownModel"
                                           Value="SelectedItem"
                                           ValueChanged="OnItemSelected"
                                           ValueExpression="@(() => SelectedItem)"
                                           Placeholder="Select Item Code">
                            <SelectedTemplate Context="cat">
                                @cat.DropDownValue_Description
                            </SelectedTemplate>
                            <ResultTemplate Context="cat">
                                @cat.DropDownValue_Description
                            </ResultTemplate>
                        </BlazoredTypeahead>
                    </div>
                    
                    <!-- Proforma dropdown gets the rest (col-md-4) -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-secondary mb-1">Select Proforma & Order</label>
                        <BlazoredTypeahead SearchMethod="SearchProformas"
                                           EnableDropDown="true"
                                           Data="ProformaOrders"
                                           TValue="GenericDropDownModel"
                                           TItem="GenericDropDownModel"
                                           Value="SelectedProforma"
                                           ValueChanged="OnProformaSelected"
                                           ValueExpression="@(() => SelectedProforma)"
                                           Placeholder="Select Proforma">
                            <SelectedTemplate Context="prof">
                                @prof.DropDownValue_Description
                            </SelectedTemplate>
                            <ResultTemplate Context="prof">
                                @prof.DropDownValue_Description
                            </ResultTemplate>
                        </BlazoredTypeahead>
                    </div>

                    <!-- Call from dispatch stays where it is (col-md-2) -->
                    <div class="col-md-2 text-end">
                        <button type="button" class="btn btn-sm btn-outline-info w-100" style="padding: 0.35rem 0.5rem;" @onclick="OpenDispatchModal">
                            <i class="fas fa-truck-loading me-1"></i> Call from Dispatch
                        </button>
                    </div>
                </div>

                <!-- Row 2: Quantities and Inputs for Packing -->
                <div class="row g-2 align-items-end">
                    <div class="col">
                        <label class="form-label text-secondary mb-1" style="font-size: 0.75rem;">Order Qty</label>
                        <input type="number" class="form-control form-control-sm text-end bg-light px-1" readonly value="@OrderQty" />
                    </div>
                    <div class="col">
                        <label class="form-label text-secondary mb-1" style="font-size: 0.75rem;">Balance</label>
                        <input type="number" class="form-control form-control-sm text-end bg-light px-1" readonly value="@Balance" />
                    </div>
                    <div class="col">
                        <label class="form-label text-secondary mb-1" style="font-size: 0.75rem;">Used</label>
                        <input type="number" class="form-control form-control-sm text-end bg-light text-danger fw-bold px-1" readonly value="@Used" />
                    </div>
                    <div class="col">
                        <label class="form-label text-secondary mb-1" style="font-size: 0.75rem;">Available</label>
                        <input type="number" class="form-control form-control-sm text-end bg-light text-success fw-bold px-1" readonly value="@Available" />
                    </div>
                    <div class="col">
                        <label class="form-label fw-bold text-secondary mb-1 text-truncate" style="font-size: 0.75rem;">Lot No</label>
                        <input type="text" class="form-control form-control-sm text-center px-1" @bind="InputLotNo" />
                    </div>
                    <div class="col">
                        <label class="form-label fw-bold text-secondary mb-1 text-truncate" style="font-size: 0.75rem;">Carton From</label>
                        <input type="number" class="form-control form-control-sm text-center px-1" @bind="InputCartonFrom" />
                    </div>
                    <div class="col">
                        <label class="form-label fw-bold text-secondary mb-1 text-truncate" style="font-size: 0.75rem;">Carton To</label>
                        <input type="number" class="form-control form-control-sm text-center px-1" @bind="InputCartonTo" />
                    </div>
                    <div class="col">
                        <label class="form-label fw-bold text-primary mb-1 text-truncate" style="font-size: 0.75rem;">Qty/Ctn</label>
                        <input type="number" class="form-control form-control-sm text-end fw-bold border-primary px-1" 
                               @bind="InputQtyPerCarton" @bind:event="oninput" @onkeyup="HandleQtyKeyPress" />
                    </div>
                    <div class="col">
                        <label class="form-label fw-bold text-secondary mb-1 text-truncate" style="font-size: 0.75rem;">Total Qty</label>
                        <input type="number" class="form-control form-control-sm text-end bg-light px-1" readonly value="@(((InputCartonTo - InputCartonFrom) + 1) * InputQtyPerCarton)" />
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-sm btn-primary fw-bold w-100" style="padding: 0.35rem 0.5rem;" @onclick="AddItem" disabled="@(InputQtyPerCarton <= 0 || Available <= 0)">
                            <i class="fas fa-plus me-1"></i> Add Item
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">

    <!-- LV2 Grid (Added Items) -->
    <div class="col-md-12">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light fw-bold py-2 d-flex justify-content-between align-items-center" style="font-size: 0.85rem;">
                <span><i class="fas fa-list-ol me-1"></i> Added Proforma Items</span>
            </div>
            <div class="table-responsive bg-white" style="max-height: 400px; overflow-y: auto;">
                <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead style="position: sticky; top: 0; background: #f8f9fa; z-index: 1;">
                        <tr class="text-secondary">
                            <th style="width: 40px;"></th>
                            <th>Order No</th>
                            <th>Item Code</th>
                            <th class="text-center">Lot No</th>
                            <th class="text-center">Cartons</th>
                            <th class="text-center">Carton Qty</th>
                            <th class="text-center">Inv Qty</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Invoice.PackingListItems.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-3">No items added yet.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Invoice.PackingListItems)
                            {
                                <tr>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-danger p-0 px-1" @onclick="() => RemoveItem(item)">
                                            <i class="fas fa-trash-alt" style="font-size: 0.75rem;"></i>
                                        </button>
                                    </td>
                                    <td>@item.OrderNo</td>
                                    <td>@item.ItemCode</td>
                                    <td class="text-center">@item.LotNo</td>
                                    <td class="text-center">@(item.CartonFrom > 0 ? $"{item.CartonFrom}-{item.CartonTo}" : "")</td>
                                    <td class="text-center">@item.Qty</td>
                                    <td class="text-center fw-bold text-success">@(((item.CartonTo - item.CartonFrom) + 1) * item.Qty)</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot style="position: sticky; bottom: 0; background: #f8f9fa;">
                        <tr>
                            <td colspan="6" class="text-end fw-bold text-secondary">Total Added:</td>
                            <td class="text-center fw-bold">@Invoice.PackingListItems.Sum(x => ((x.CartonTo - x.CartonFrom) + 1) * x.Qty)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@if (UnmatchedCartons.Any())
{
    <div class="row g-3 mb-3">
        <div class="col-md-12">
            <div class="card shadow-sm border-warning">
                <div class="card-header bg-warning text-dark fw-bold py-2" style="font-size: 0.85rem;">
                    <i class="fas fa-exclamation-triangle me-1"></i> Unmatched Dispatch Cartons
                    <span class="badge bg-danger ms-2">@UnmatchedCartons.Count</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 200px; overflow-y: auto;">
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.8rem;">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Carton No</th>
                                    <th>Order No</th>
                                    <th>Item Code</th>
                                    <th class="text-end">Carton Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var unmatched in UnmatchedCartons)
                                {
                                    <tr>
                                        <td>@unmatched.CartonNo</td>
                                        <td>@unmatched.OrderNo</td>
                                        <td>@unmatched.ItemCode</td>
                                        <td class="text-end fw-bold">@unmatched.CartonQty</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowDispatchModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-light py-2">
                    <h6 class="modal-title fw-bold"><i class="fas fa-truck-loading me-2 text-primary"></i> Select Dispatch List</h6>
                    <button type="button" class="btn-close" @onclick="CloseDispatchModal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label fw-bold text-secondary mb-1">Dispatch List</label>
                    <select class="form-select" @bind="SelectedDispatchListId">
                        <option value="0">-- Select a Dispatch List --</option>
                        @foreach (var dl in AvailableDispatchLists)
                        {
                            <option value="@dl.EntryID">@dl.Description</option>
                        }
                    </select>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseDispatchModal">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="ProcessDispatchList" disabled="@(SelectedDispatchListId == 0)">
                        <i class="fas fa-check me-1"></i> Add Items
                    </button>
                </div>
            </div>
        </div>
    </div>
}


