@page "/payroll/manual-attendance"
@using DataAccessLibrary.Models.ViewModels.Payroll
@using Impulse.Services.Payroll
@using Impulse.Services
@using Impulse.Components.Payroll
@attribute [Authorize]
@inject IManualAttendanceService AttendanceService
@inject INotificationService NotificationService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuditService AuditService

<PageTitle>Manual Attendance</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <!-- Main Shell Card -->
    <div class="card border-0 shadow-sm mb-4" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px; max-width: 1150px; margin: 0 auto; position: relative !important; z-index: 100 !important;">
        <div class="card-body p-4">
            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                <h4 class="mb-0 text-primary d-flex align-items-center">
                    <i class="fas fa-clock me-2"></i> Manual Attendance Entry
                </h4>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-warning btn-sm" @onclick="OpenReCalcModal">
                        <i class="fas fa-sync-alt me-1"></i> Re-Calculate Attendance
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="NavigateBack">
                        <i class="fas fa-arrow-left me-1"></i> Back
                    </button>
                </div>
            </div>

            <!-- Top Selection Bar -->
            <div class="row g-3 align-items-end mb-4" style="position: relative !important; z-index: 9999 !important;">
                <div class="col-md-7">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.85rem;">
                        Select Employee <span class="text-danger">*</span>
                    </label>
                    <BlazoredTypeahead SearchMethod="SearchEmployees" Value="SelectedEmployee" ValueChanged="OnEmployeeChanged" ValueExpression="@(() => SelectedEmployee)" TValue="EmployeeListItemModel" TItem="EmployeeListItemModel" Placeholder="Search Employee Name or ID..." EnableDropDown="true" MaximumSuggestions="1000">
                        <SelectedTemplate>
                            <text>[@context.EmpID] </text>@context.Name
                        </SelectedTemplate>
                        <ResultTemplate>
                            <text>[@context.EmpID] </text>@context.Name @(string.IsNullOrWhiteSpace(context.FName) ? "" : $"({context.FName})")
                        </ResultTemplate>
                    </BlazoredTypeahead>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.85rem;">
                        Attendance Date <span class="text-danger">*</span>
                    </label>
                    <input type="date" class="form-control form-control-sm" Value="@AttendanceDate.ToString("yyyy-MM-dd")" @onchange="OnAttendanceDateChanged" style="height: 35px; font-size: 0.875rem;" />
                </div>

                <div class="col-md-2 d-flex align-items-center justify-content-end pb-1">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="chkUseServer" @bind="UseServerTime">
                        <label class="form-check-label fw-bold text-secondary ms-1" for="chkUseServer" style="font-size: 0.825rem;">Use System Time</label>
                    </div>
                </div>
            </div>

            <!-- Split Body Layout -->
            <div class="row g-4">
                <!-- Left Column: Input Forms -->
                <div class="col-lg-8" style="position: relative !important; z-index: 1 !important;">
                    @if (!string.IsNullOrWhiteSpace(ValidationWarning))
                    {
                        <div class="alert alert-warning py-2 px-3 mb-3 d-flex align-items-center" role="alert" style="border-radius: 8px; font-size: 0.875rem;">
                            <i class="fas fa-exclamation-triangle me-2 fs-5"></i>
                            <div>@ValidationWarning</div>
                        </div>
                    }

                    <!-- Shift 1: Check In & Break Out -->
                    <div class="card border-0 shadow-xs mb-3 bg-light rounded-3">
                        <div class="card-header bg-transparent border-bottom py-2 px-3 fw-bold text-primary d-flex align-items-center" style="font-size: 0.875rem;">
                            <i class="fas fa-sun me-2 text-warning"></i> Morning Shift (Regular Check-In)
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="form-label fw-semibold text-secondary mb-1" style="font-size:0.8rem;">Check-In Time</label>
                                    <input type="time" class="form-control form-control-sm text-center fw-bold" @bind="InTime" style="height: 35px;" disabled="@UseServerTime" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-semibold text-secondary mb-1" style="font-size:0.8rem;">Break-Out Time (Lunch)</label>
                                    <input type="time" class="form-control form-control-sm text-center fw-bold" @bind="BrkOut" style="height: 35px;" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Shift 2: Break In & Check Out -->
                    <div class="card border-0 shadow-xs mb-3 bg-light rounded-3">
                        <div class="card-header bg-transparent border-bottom py-2 px-3 fw-bold text-primary d-flex align-items-center" style="font-size: 0.875rem;">
                            <i class="fas fa-coffee me-2 text-info"></i> Afternoon Shift (Break Return &amp; Out)
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="form-label fw-semibold text-secondary mb-1" style="font-size:0.8rem;">Break-In Time (Return)</label>
                                    <input type="time" class="form-control form-control-sm text-center fw-bold" @bind="BrkIn" style="height: 35px;" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-semibold text-secondary mb-1" style="font-size:0.8rem;">Check-Out Time</label>
                                    <input type="time" class="form-control form-control-sm text-center fw-bold" @bind="ChkOut" style="height: 35px;" disabled="@UseServerTime" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Shift 3: Overtime -->
                    <div class="card border-0 shadow-xs mb-3 bg-light rounded-3">
                        <div class="card-header bg-transparent border-bottom py-2 px-3 fw-bold text-primary d-flex align-items-center justify-content-between" style="font-size: 0.875rem;">
                            <div>
                                <i class="fas fa-moon me-2 text-primary"></i> Overtime Hours
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="chkOT" @bind="EnableOT">
                                <label class="form-check-label text-dark fw-semibold" for="chkOT" style="font-size: 0.8rem;">Enable OT</label>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="form-label fw-semibold text-secondary mb-1" style="font-size:0.8rem;">OT In Time</label>
                                    <input type="time" class="form-control form-control-sm text-center fw-bold" @bind="OTIn" style="height: 35px;" disabled="@(!EnableOT)" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-semibold text-secondary mb-1" style="font-size:0.8rem;">OT Out Time</label>
                                    <input type="time" class="form-control form-control-sm text-center fw-bold" @bind="OTOut" style="height: 35px;" disabled="@(!EnableOT)" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions Toolbar -->
                    <div class="d-flex align-items-center justify-content-between pt-2">
                        <button type="button" class="btn btn-outline-danger btn-sm shadow-sm px-3" style="height: 35px;" @onclick="DeleteAttendanceAsync" disabled="@(SelectedEmployee == null || IsSaving || !AttendanceDetails.Any())">
                            <i class="fas fa-trash-alt me-1"></i> Delete Attendance
                        </button>

                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-secondary btn-sm shadow-sm px-3" style="height: 35px;" @onclick="ClearForm" disabled="@IsSaving">
                                <i class="fas fa-undo me-1"></i> Clear
                            </button>
                            <button type="button" class="btn btn-primary btn-sm shadow-sm px-4" style="height: 35px;" @onclick="SaveAttendanceAsync" disabled="@(SelectedEmployee == null || IsSaving)">
                                @if (IsSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <i class="fas fa-check me-1"></i>
                                    <span>Save Attendance</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Employee Preview -->
                <div class="col-lg-4">
                    <div class="card border border-light-subtle rounded-3 p-3 shadow-xs text-center" style="background: rgba(255, 255, 255, 0.95); position: sticky; top: 15px;">
                        <h6 class="fw-bold text-secondary border-bottom pb-2 mb-3">Employee Details</h6>

                        <div class="bg-light rounded-3 p-2 mb-3 border d-flex align-items-center justify-content-center" style="height: 210px;">
                            @if (!string.IsNullOrEmpty(EmployeePicBase64))
                            {
                                <img src="data:image/jpeg;base64,@EmployeePicBase64" class="img-fluid rounded-3 shadow-sm" style="max-height: 100%; max-width: 100%; object-fit: contain;" alt="Photo" />
                            }
                            else
                            {
                                <div class="text-secondary opacity-50 text-center">
                                    <i class="fas fa-user-circle fa-4x mb-2"></i>
                                    <div class="small">No Employee Photo</div>
                                </div>
                            }
                        </div>

                        @if (SelectedEmployee != null)
                        {
                            <div class="text-start">
                                <h6 class="fw-bold text-dark mb-1">@SelectedEmployee.Name</h6>
                                <p class="text-muted mb-2" style="font-size: 0.85rem;">@SelectedEmployee.Designation</p>

                                <div class="border-top pt-2" style="font-size: 0.8rem;">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-secondary">Emp ID:</span>
                                        <span class="fw-bold text-primary">@SelectedEmployee.EmpID</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-secondary">Father's Name:</span>
                                        <span class="fw-bold">@SelectedEmployee.FName</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-secondary">Total Shift Hrs:</span>
                                        <span class="fw-bold text-success">@AttendanceDetails.Sum(x => x.Hrs).ToString("N2") Hrs</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance Details Grid Card -->
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px; max-width: 1150px; margin: 0 auto; position: relative !important; z-index: 1 !important;">
        <div class="card-body p-0">
            <div class="px-4 py-3 border-bottom d-flex align-items-center justify-content-between">
                <h6 class="mb-0 text-secondary fw-bold">
                    <i class="fas fa-list me-2 text-primary"></i> Attendance Log Entries (@AttendanceDate.ToString("dd-MMM-yyyy"))
                </h6>
                <span class="badge bg-primary fs-6">Logged Slots: @AttendanceDetails.Count</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                    <thead class="table-light text-secondary" style="font-size: 0.78rem; text-transform: uppercase;">
                        <tr>
                            <th style="width: 8%; padding-left: 1rem;" class="text-center">Slot #</th>
                            <th style="width: 20%; text-align: center;">In Time</th>
                            <th style="width: 20%; text-align: center;">Out Time</th>
                            <th style="width: 18%; text-align: center;">Hours</th>
                            <th style="width: 18%; text-align: center;">Type</th>
                            <th style="width: 16%;">Recorded By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoadingDetails)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <span class="spinner-border spinner-border-sm me-2 text-primary"></span> Loading attendance logs...
                                </td>
                            </tr>
                        }
                        else if (!AttendanceDetails.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    No attendance entries logged for this employee on @AttendanceDate.ToString("dd-MMM-yyyy").
                                </td>
                            </tr>
                        }
                        else
                        {
                            int idx = 1;
                            @foreach (var row in AttendanceDetails)
                            {
                                <tr>
                                    <td style="padding-left: 1rem;" class="text-center fw-bold text-secondary">#(idx++)</td>
                                    <td class="text-center fw-bold text-primary">@row.InTime</td>
                                    <td class="text-center fw-bold text-danger">@row.OutTime</td>
                                    <td class="text-center fw-bold text-success">@row.Hrs.ToString("N2") Hrs</td>
                                    <td class="text-center">
                                        @if (row.OverTime)
                                        {
                                            <span class="badge bg-warning text-dark border"><i class="fas fa-moon me-1"></i> Overtime</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border"><i class="fas fa-sun me-1"></i> Regular</span>
                                        }
                                    </td>
                                    <td><small class="text-muted">@row.UserName</small></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<EmpIdAndDateRangeModal @bind-IsOpen="ShowReCalcModal" OnSubmit="HandleReCalculateSubmit" Title="Re-Calculate Attendance" />

<style>
    .blazored-typeahead {
        height: 35px !important;
        font-size: 0.875rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input, .blazored-typeahead__controls {
        height: 33px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input-mask, .blazored-typeahead__input-mask-wrapper {
        height: 33px !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
    }
    .blazored-typeahead__input-icon {
        padding: 0 0.5rem !important;
        display: flex !important;
        align-items: center !important;
    }
</style>
