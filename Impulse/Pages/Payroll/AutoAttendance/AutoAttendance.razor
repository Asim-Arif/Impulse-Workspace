@page "/payroll/auto-attendance"
@using DataAccessLibrary.Models.ViewModels.Payroll
@inject NavigationManager Navigation
@inject Radzen.NotificationService NotificationService
@inject Impulse.Services.Payroll.ITakeAttendanceService TakeAttendanceService
@inject Impulse.Services.Payroll.IManualAttendanceService ManualAttendanceService
@inject Impulse.Services.Payroll.IOverTimeAuthService OverTimeAuthService

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <!-- Glassmorphism Container Card -->
    <div class="card border-0 shadow-sm mx-auto" style="max-width: 850px; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-4">
            
            <!-- Page Header -->
            <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-outline-secondary btn-sm rounded-circle p-2" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;" @onclick="GoBack" title="Go Back">
                        <i class="fas fa-arrow-left"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-dark font-weight-bold" style="font-size: 1.25rem;">
                            <i class="fas fa-magic text-primary me-2"></i>Auto Attendance
                        </h4>
                        <small class="text-muted">Batch generate shift punches or complete missing attendance entries</small>
                    </div>
                </div>
            </div>

            <!-- Form Inputs Section -->
            <div class="row g-3 mb-4" style="position: relative !important; z-index: 9999 !important;">
                
                <!-- Department Selector -->
                <div class="col-md-6">
                    <label class="form-label text-secondary font-weight-bold small mb-1">
                        <i class="fas fa-sitemap me-1 text-primary"></i>Department
                    </label>
                    <BlazoredTypeahead SearchMethod="SearchDepartments"
                                       TItem="DepartmentListItemModel"
                                       TValue="DepartmentListItemModel"
                                       Value="SelectedDepartment"
                                       ValueChanged="OnDepartmentChanged"
                                       ValueExpression="@(() => SelectedDepartment)"
                                       Placeholder="Search Department..."
                                       MinimumLength="0"
                                       MaximumSuggestions="1000"
                                       EnableDropDown="true"
                                       Disabled="IsProcessing">
                        <SelectedTemplate Context="dept">
                            @dept.Name
                        </SelectedTemplate>
                        <ResultTemplate Context="dept">
                            @dept.Name
                        </ResultTemplate>
                        <NotFoundTemplate Context="searchText">
                            <span class="text-muted p-2">No departments found</span>
                        </NotFoundTemplate>
                    </BlazoredTypeahead>
                </div>

                <!-- Employee Selector -->
                <div class="col-md-6">
                    <label class="form-label text-secondary font-weight-bold small mb-1">
                        <i class="fas fa-user-check me-1 text-primary"></i>Employee
                    </label>
                    <BlazoredTypeahead SearchMethod="SearchEmployees"
                                       TItem="EmployeeListItemModel"
                                       TValue="EmployeeListItemModel"
                                       Value="SelectedEmployee"
                                       ValueChanged="OnEmployeeChanged"
                                       ValueExpression="@(() => SelectedEmployee)"
                                       Placeholder="Search Employee by ID or Name..."
                                       MinimumLength="0"
                                       MaximumSuggestions="1000"
                                       EnableDropDown="true"
                                       Disabled="IsProcessing">
                        <SelectedTemplate Context="emp">
                            @if (emp.EmpID != "0")
                            {
                                <text>[@emp.EmpID] </text>
                            }
                            @emp.Name
                        </SelectedTemplate>
                        <ResultTemplate Context="emp">
                            <div class="d-flex justify-content-between align-items-center">
                                <span>
                                    @if (emp.EmpID != "0")
                                    {
                                        <strong>[@emp.EmpID]</strong>
                                    }
                                    @emp.Name
                                </span>
                                @if (!string.IsNullOrWhiteSpace(emp.Designation))
                                {
                                    <span class="badge bg-light text-secondary ms-2 font-weight-normal">@emp.Designation</span>
                                }
                            </div>
                        </ResultTemplate>
                        <NotFoundTemplate Context="searchText">
                            <span class="text-muted p-2">No employees found</span>
                        </NotFoundTemplate>
                    </BlazoredTypeahead>
                </div>

                <!-- Date From -->
                <div class="col-md-6">
                    <label class="form-label text-secondary font-weight-bold small mb-1">
                        <i class="fas fa-calendar-alt me-1 text-primary"></i>Date From
                    </label>
                    <input type="date" class="form-control form-control-sm" @bind="DateFrom" disabled="@IsProcessing" />
                </div>

                <!-- Date To -->
                <div class="col-md-6">
                    <label class="form-label text-secondary font-weight-bold small mb-1">
                        <i class="fas fa-calendar-alt me-1 text-primary"></i>Date To
                    </label>
                    <input type="date" class="form-control form-control-sm" @bind="DateTo" disabled="@IsProcessing" />
                </div>

            </div>

            <!-- Operational Warning Alerts -->
            <div class="alert alert-info border-0 shadow-sm rounded-3 mb-4 p-3" style="background: rgba(13, 202, 240, 0.08);">
                <div class="d-flex align-items-start gap-2">
                    <i class="fas fa-info-circle text-info mt-1 fs-5"></i>
                    <div>
                        <strong class="text-dark small d-block mb-1">Auto Attendance Logic Guidelines:</strong>
                        <ul class="mb-0 ps-3 text-secondary small" style="font-size: 0.85rem;">
                            <li><strong>Make Present All Days:</strong> Generates automated attendance punches for unrecorded working days, automatically skipping Sundays and official Holidays. Existing attendance records are untouched.</li>
                            <li><strong>Complete Missing Attendance:</strong> Fills in missing check-out or break punches for incomplete records in the date range while preserving actual check-in times.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Action Buttons Row -->
            <div class="d-flex align-items-center justify-content-end gap-2 pt-2 border-top">
                <button class="btn btn-primary btn-sm px-3" @onclick="HandleMakePresentAllDays" disabled="@IsProcessing">
                    @if (IsProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Processing...</span>
                    }
                    else
                    {
                        <i class="fas fa-user-plus me-1"></i>
                        <span>Make Present All Days</span>
                    }
                </button>
                
                <button class="btn btn-info btn-sm text-white px-3" @onclick="HandleCompleteMissingAttendance" disabled="@IsProcessing">
                    @if (IsProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Processing...</span>
                    }
                    else
                    {
                        <i class="fas fa-check-double me-1"></i>
                        <span>Complete Missing Attendance</span>
                    }
                </button>

                <button class="btn btn-outline-secondary btn-sm px-3" @onclick="GoBack" disabled="@IsProcessing">
                    <i class="fas fa-times me-1"></i>Close
                </button>
            </div>

        </div>
    </div>
</div>
