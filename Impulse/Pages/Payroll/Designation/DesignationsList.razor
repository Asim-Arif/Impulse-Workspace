@page "/payroll/designations"
@using DataAccessLibrary.Models.ViewModels.Payroll
@using BlazorContextMenu

<style>
    /* Win11 Context Menu styling */
    .blazor-context-menu { max-height: 40vh !important; overflow-y: auto; z-index: 100000 !important; }
    .win11-section-header { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: #6c757d; padding: 6px 12px 2px 12px; }
    .win11-menu-item { font-size: 0.84rem; padding: 6px 12px; cursor: pointer; color: #212529; }
    .win11-menu-item:hover { background-color: #f1f3f5; color: #0d6efd; }
    .win11-icon { margin-right: 8px; width: 16px; text-align: center; }
    .win11-divider { height: 1px; background-color: #e9ecef; margin: 4px 0; }
</style>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    @* ── Header & Toolbar Card ─────────────────── *@
    <div class="card border-0 shadow-sm mb-3" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px; position: relative !important; z-index: 9999 !important;">
        <div class="card-body py-2 px-3">
            <div class="d-flex align-items-end pb-2 mb-3 border-bottom">
                <div>
                    <div class="d-flex align-items-center">
                        <h5 class="mb-0 fw-bold text-dark">
                            <i class="fas fa-tags me-2 text-primary"></i>Employee Designations
                        </h5>
                        <span class="badge bg-primary ms-3" style="font-size: 0.75rem;">
                            @FilteredList.Count() Designations
                        </span>
                    </div>
                    <small class="text-secondary">Define job titles, responsibilities, required skills, and training requirements</small>
                </div>
                <div class="ms-auto d-flex gap-2">
                    <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm fw-bold"
                            @onclick="OpenAddModal" style="height: 35px !important;">
                        <i class="fas fa-plus-circle me-1"></i>Add Designation
                    </button>

                    <button type="button" class="btn btn-outline-info btn-sm px-3 shadow-sm"
                            @onclick="ShowOptionsMenu" style="height: 35px !important;">
                        <i class="fas fa-cog me-1"></i>Options <i class="fas fa-chevron-down ms-1 small"></i>
                    </button>

                    <button type="button" class="btn btn-outline-primary btn-sm px-3 shadow-sm"
                            @onclick="LoadDesignationsAsync" disabled="@IsLoading" style="height: 35px !important;">
                        <i class="fas fa-sync-alt me-1 @(IsLoading ? "fa-spin" : "")"></i>Refresh
                    </button>

                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 shadow-sm"
                            @onclick="GoBack" style="height: 35px !important;">
                        <i class="fas fa-arrow-left me-1"></i>Back
                    </button>
                </div>
            </div>

            @* ── Search Row ─────────────────── *@
            <div class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" class="form-control form-control-sm shadow-sm"
                               placeholder="Search designation title, duties, skills, trainings..."
                               @bind="SearchText" @bind:event="oninput" style="height: 35px !important;" />
                        @if (!string.IsNullOrEmpty(SearchText))
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => SearchText = string.Empty">
                                <i class="fas fa-times"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Designations Grid Card ─────────────────── *@
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px; position: relative !important; z-index: 1 !important;">
        <div class="card-body py-2 px-3">
            <div class="table-responsive" style="max-height: 68vh; overflow-y: auto;">
                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                    <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                        <tr>
                            <th style="width: 50px;" class="text-center">#</th>
                            <th style="width: 220px;">Designation</th>
                            <th>Duties & Responsibilities</th>
                            <th>Required Skills</th>
                            <th>Required Trainings</th>
                            <th style="width: 110px;" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    Loading Designations...
                                </td>
                            </tr>
                        }
                        else if (!FilteredList.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-tags fa-2x mb-2 text-secondary opacity-50"></i>
                                    <p class="mb-0">No designations found.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int index = 1;
                            @foreach (var item in FilteredList)
                            {
                                int currentIndex = index++;
                                <ContextMenuTrigger MenuId="rowContextMenu" Data="@item" WrapperTag="tr">
                                    <td class="text-center text-muted fw-semibold">@currentIndex</td>
                                    <td class="fw-bold text-primary">@item.Designation</td>
                                    <td class="text-secondary small">@(string.IsNullOrWhiteSpace(item.Duties) ? "-" : item.Duties)</td>
                                    <td class="text-secondary small">@(string.IsNullOrWhiteSpace(item.RequiredSkills) ? "-" : item.RequiredSkills)</td>
                                    <td class="text-secondary small">@(string.IsNullOrWhiteSpace(item.RequiredTrainings) ? "-" : item.RequiredTrainings)</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-link btn-sm p-1 text-primary me-1" title="Edit Designation"
                                                @onclick="() => OpenEditModal(item)">
                                            <i class="fas fa-pencil-alt"></i>
                                        </button>
                                        <button type="button" class="btn btn-link btn-sm p-1 text-info me-1" title="Print Designation"
                                                @onclick="() => PrintDesignationDetail(item)">
                                            <i class="fas fa-print"></i>
                                        </button>
                                        <button type="button" class="btn btn-link btn-sm p-1 text-danger" title="Delete Designation"
                                                @onclick="() => DeleteDesignationAsync(item)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </ContextMenuTrigger>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* ── Add / Edit Designation Modal Dialog ─────────────────── *@
@if (ShowModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.5); backdrop-filter: blur(4px); z-index: 100050;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 14px;">
                <div class="modal-header bg-light border-bottom py-2 px-3">
                    <h6 class="modal-title fw-bold text-dark mb-0">
                        <i class="fas @(EditModel.EntryID == 0 ? "fa-plus-circle text-primary" : "fa-pencil-alt text-warning") me-2"></i>
                        @(EditModel.EntryID == 0 ? "Add New Designation" : "Edit Designation")
                    </h6>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-3">
                        <label class="form-label form-label-sm fw-bold text-secondary">Designation Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm shadow-sm"
                               placeholder="e.g. Senior Accountant, Software Engineer"
                               @bind="EditModel.Designation" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label form-label-sm fw-bold text-secondary">Duties & Responsibilities</label>
                        <textarea class="form-control form-control-sm shadow-sm" rows="3"
                                  placeholder="Describe key duties and job responsibilities..."
                                  @bind="EditModel.Duties"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label form-label-sm fw-bold text-secondary">Required Skills</label>
                        <textarea class="form-control form-control-sm shadow-sm" rows="3"
                                  placeholder="List required technical skills or qualifications..."
                                  @bind="EditModel.RequiredSkills"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label form-label-sm fw-bold text-secondary">Required Trainings</label>
                        <textarea class="form-control form-control-sm shadow-sm" rows="3"
                                  placeholder="List mandatory trainings, certifications, or courses..."
                                  @bind="EditModel.RequiredTrainings"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2 px-3">
                    <button type="button" class="btn btn-secondary btn-sm px-3 shadow-sm" @onclick="CloseModal" disabled="@IsSaving">
                        <i class="fas fa-times me-1"></i>Cancel
                    </button>
                    <button type="button" class="btn btn-primary btn-sm px-4 fw-bold shadow-sm" @onclick="SaveDesignationAsync" disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span><span>Saving...</span>
                        }
                        else
                        {
                            <i class="fas fa-check me-1"></i><span>Save Designation</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── BlazorContextMenu: Top Options Menu ── -->
<ContextMenu Id="optionsBarMenu" Template="Win11Style">
    <div class="win11-section-header">Designation Actions</div>
    <Item class="win11-menu-item" OnClick="OpenAddModal">
        <i class="fas fa-plus-circle fa-fw win11-icon text-primary"></i> Add New Designation
    </Item>
    <Item class="win11-menu-item" OnClick="PrintDesignationsList">
        <i class="fas fa-file-invoice fa-fw win11-icon text-info"></i> Print Designations Report
    </Item>
    <div class="win11-divider"></div>
    <Item class="win11-menu-item" OnClick="LoadDesignationsAsync">
        <i class="fas fa-sync-alt fa-fw win11-icon text-secondary"></i> Refresh List
    </Item>
</ContextMenu>

<!-- ── BlazorContextMenu: Row Context Menu ── -->
<ContextMenu Id="rowContextMenu" Template="Win11Style">
    <div class="win11-section-header">Row Actions</div>
    <Item class="win11-menu-item" OnClick="() => OpenEditModal((DesignationModel)SelectedRow!)">
        <i class="fas fa-pencil-alt fa-fw win11-icon text-primary"></i> Edit Designation
    </Item>
    <Item class="win11-menu-item" OnClick="() => PrintDesignationDetail((DesignationModel)SelectedRow!)">
        <i class="fas fa-print fa-fw win11-icon text-info"></i> Print Designation Detail
    </Item>
    <div class="win11-divider"></div>
    <Item class="win11-menu-item" OnClick="() => DeleteDesignationAsync((DesignationModel)SelectedRow!)">
        <i class="fas fa-trash fa-fw win11-icon text-danger"></i> Delete Designation
    </Item>
</ContextMenu>
