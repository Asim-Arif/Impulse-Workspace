@page "/payroll/gate-pass"
@using DataAccessLibrary.Models.ViewModels.Payroll
@using Impulse.Services.Payroll
@using Impulse.Services
@attribute [Authorize]

<PageTitle>Gate Pass Entry</PageTitle>

<style>
    .toolbar-row { position: relative !important; z-index: 9999 !important; }
    .table-container { position: relative !important; z-index: 1 !important; max-height: 70vh; overflow-y: auto; }
    .blazored-typeahead { height: 35px !important; min-height: 35px !important; padding: 0 !important; box-sizing: border-box !important; }
    .blazored-typeahead__controls { min-height: 35px !important; height: 35px !important; }
    .blazored-typeahead__input { height: 33px !important; }
</style>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <!-- Main Shell Card -->
    <div class="card border-0 shadow-sm mb-4" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px; max-width: 1200px; margin: 0 auto;">
        <div class="card-body p-4">
            
            <!-- Header Row -->
            <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                <h4 class="mb-0 text-primary d-flex align-items-center">
                    <i class="fas fa-id-badge me-2"></i> Gate Pass Entry
                </h4>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-success btn-sm" @onclick="SelectAll">
                        <i class="fas fa-check-square me-1"></i> Select All
                    </button>
                    <button type="button" class="btn btn-outline-warning btn-sm" @onclick="DeselectAll">
                        <i class="fas fa-square me-1"></i> Deselect All
                    </button>
                    <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm" @onclick="SaveAsync" disabled="@(IsLoading || IsSaving)">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span><span>Saving...</span>
                        }
                        else
                        {
                            <i class="fas fa-save me-1"></i><span>Save Gate Passes</span>
                        }
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" @onclick="NavigateBack">
                        <i class="fas fa-arrow-left me-1"></i> Back
                    </button>
                </div>
            </div>

            <!-- Toolbar: Department & Date Selector -->
            <div class="row g-3 align-items-end mb-4 toolbar-row">
                <div class="col-md-5">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.85rem;">Department</label>
                    <BlazoredTypeahead SearchMethod="SearchDepartments"
                                       Value="SelectedDepartment"
                                       ValueChanged="OnDepartmentChanged"
                                       ValueExpression="@(() => SelectedDepartment)"
                                       TValue="DepartmentListItemModel"
                                       TItem="DepartmentListItemModel"
                                       Placeholder="All Departments..."
                                       EnableDropDown="true"
                                       MaximumSuggestions="1000">
                        <SelectedTemplate>@context.Name</SelectedTemplate>
                        <ResultTemplate>@context.Name</ResultTemplate>
                    </BlazoredTypeahead>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.85rem;">Attendance Date</label>
                    <input type="date" class="form-control form-control-sm"
                           value="@SelectedDate.ToString("yyyy-MM-dd")"
                           @onchange="OnDateChanged" style="height:35px;" />
                </div>

                <div class="col-md-3 text-end">
                    <span class="badge bg-light text-dark border px-3 py-2" style="font-size:0.85rem;">
                        <i class="fas fa-users me-1 text-primary"></i> Present Staff: <strong>@Rows.Count</strong>
                    </span>
                </div>
            </div>

            <!-- Gate Pass Grid Container -->
            <div class="table-container border rounded">
                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                    <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                        <tr>
                            <th class="text-center" style="width:45px;">
                                <input class="form-check-input" type="checkbox" checked="@IsAllSelected" @onchange="ToggleSelectAll" />
                            </th>
                            <th style="width:120px;">Emp ID</th>
                            <th>Employee Name</th>
                            <th class="text-center" style="width:110px;">Out Time</th>
                            <th class="text-center" style="width:110px;">In Time</th>
                            <th class="text-center" style="width:100px;">Duration</th>
                            <th class="text-center" style="width:110px;">Type</th>
                            <th>Remarks</th>
                            <th class="text-center" style="width:80px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <span class="spinner-border spinner-border-sm me-2 text-primary"></span>
                                    Loading present employees...
                                </td>
                            </tr>
                        }
                        else if (!Rows.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="fas fa-info-circle me-2"></i>
                                    No present employees found for the selected department & date.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in Rows)
                            {
                                <tr class="@(row.IsSelected ? "table-active" : "")">
                                    <td class="text-center">
                                        <input class="form-check-input" type="checkbox" @bind="row.IsSelected" />
                                    </td>
                                    <td class="fw-bold text-secondary">@row.EmpID</td>
                                    <td>@row.EmpName</td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(row.OutTime))
                                        {
                                            <span class="badge bg-light text-dark border" style="font-size:0.8rem;">@row.OutTime</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(row.InTime))
                                        {
                                            <span class="badge bg-light text-dark border" style="font-size:0.8rem;">@row.InTime</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center fw-bold" style="color:#0d6efd;">
                                        @row.DurationDisplay
                                    </td>
                                    <td class="text-center">
                                        @if (row.IsSelected && (!string.IsNullOrEmpty(row.OutTime) || !string.IsNullOrEmpty(row.InTime)))
                                        {
                                            @if (row.IsOfficial)
                                            {
                                                <span class="badge bg-primary" style="font-size:0.75rem;">Official</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary" style="font-size:0.75rem;">Personal</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-truncate" style="max-width: 200px;">
                                        @row.Remarks
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2"
                                                style="font-size:0.75rem; height:28px;"
                                                title="Edit Gate Pass Details"
                                                @onclick="() => EditGatePass(row)">
                                            <i class="fas fa-pencil-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<!-- Gate Pass Edit Modal Dialog -->
@if (ShowEditModal && EditingRow != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 10050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0" style="border-radius: 12px;">
                <div class="modal-header bg-light">
                    <h5 class="modal-title text-primary d-flex align-items-center" style="font-size:1.05rem;">
                        <i class="fas fa-id-badge me-2"></i> Gate Pass Details — @EditingRow.EmpName
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.85rem;">Out Time (Exit)</label>
                            <input type="time" class="form-control form-control-sm"
                                   value="@EditingRow.OutTime"
                                   @onchange="e => OnModalOutTimeChanged(e?.Value?.ToString())" style="height:35px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.85rem;">In Time (Return)</label>
                            <input type="time" class="form-control form-control-sm"
                                   value="@EditingRow.InTime"
                                   @onchange="e => OnModalInTimeChanged(e?.Value?.ToString())" style="height:35px;" />
                        </div>
                        <div class="col-md-12">
                            <div class="form-check form-switch pt-2">
                                <input class="form-check-input" type="checkbox" id="swOfficial" @bind="EditingRow.IsOfficial" />
                                <label class="form-check-label fw-bold text-secondary" for="swOfficial">
                                    Official Business Visit
                                </label>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.85rem;">Remarks / Reason</label>
                            <textarea class="form-control form-control-sm" rows="3" @bind="EditingRow.Remarks" placeholder="Enter reason for gate pass..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-3">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm px-4" @onclick="ConfirmModalEdit">
                        <i class="fas fa-check me-1"></i> Apply Changes
                    </button>
                </div>
            </div>
        </div>
    </div>
}
