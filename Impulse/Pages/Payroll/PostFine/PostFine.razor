@page "/payroll/post-fine"
@using DataAccessLibrary.Models.ViewModels.Payroll
@using Impulse.Services.Payroll
@using Impulse.Services
@attribute [Authorize]

<PageTitle>Post Fine</PageTitle>

<style>
    .toolbar-row     { position: relative !important; z-index: 9999 !important; }
    .table-container { position: relative !important; z-index: 1 !important; }

    /* BlazoredTypeahead sizing fixes */
    .blazored-typeahead          { height: 35px !important; min-height: 35px !important; padding: 0 !important; box-sizing: border-box !important; }
    .blazored-typeahead__controls{ min-height: 35px !important; height: 35px !important; }
    .blazored-typeahead__input   { height: 33px !important; }
</style>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm mb-4"
         style="background: rgba(255,255,255,0.85); backdrop-filter: blur(10px); border-radius: 12px; max-width: 800px; margin: 0 auto;">
        <div class="card-body p-4">

            @* ── Header ──────────────────────────────────────────── *@
            <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                <h4 class="mb-0 text-primary d-flex align-items-center">
                    <i class="fas fa-gavel me-2"></i>
                    Post Fine
                    @if (IsContractor)
                    {
                        <span class="badge bg-warning text-dark ms-2" style="font-size:0.7rem;">CONTRACTOR</span>
                    }
                </h4>
                <div class="d-flex gap-2 align-items-center">
                    <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm"
                            @onclick="SaveAsync" disabled="@(IsLoading || IsSaving)">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span><span>Posting...</span>
                        }
                        else
                        {
                            <i class="fas fa-save me-1"></i><span>Save Fine</span>
                        }
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3"
                            @onclick="NavigateBack">
                        <i class="fas fa-arrow-left me-1"></i> Back
                    </button>
                </div>
            </div>

            @* ── SECTION 1: Department & Employee Selection ──────── *@
            <div class="row g-3 align-items-end mb-3 toolbar-row">
                <div class="col-md-5">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.85rem;">Department</label>
                    <BlazoredTypeahead SearchMethod="SearchDepartments"
                                       Value="SelectedDepartment"
                                       ValueChanged="OnDepartmentChanged"
                                       ValueExpression="@(() => SelectedDepartment)"
                                       TValue="DepartmentListItemModel"
                                       TItem="DepartmentListItemModel"
                                       Placeholder="All Departments..."
                                       EnableDropDown="true"
                                       MaximumSuggestions="1000">
                        <SelectedTemplate>@context.Name</SelectedTemplate>
                        <ResultTemplate>@context.Name</ResultTemplate>
                    </BlazoredTypeahead>
                </div>
                <div class="col-md-7">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.85rem;">
                        Employee <span class="text-danger">*</span>
                    </label>
                    <BlazoredTypeahead SearchMethod="SearchEmployees"
                                       Value="SelectedEmployee"
                                       ValueChanged="OnEmployeeChanged"
                                       ValueExpression="@(() => SelectedEmployee)"
                                       TValue="EmployeeListItemModel"
                                       TItem="EmployeeListItemModel"
                                       Placeholder="Search Employee by ID, Name or Designation..."
                                       EnableDropDown="true"
                                       MaximumSuggestions="1000">
                        <SelectedTemplate>
                            @if (context.EmpID != "0") { <text>[@context.EmpID] </text> }@context.Name
                        </SelectedTemplate>
                        <ResultTemplate>
                            @if (context.EmpID != "0") { <text>[@context.EmpID] </text> }@context.Name
                            @if (!string.IsNullOrEmpty(context.Designation))
                            {
                                <small class="text-muted ms-1">— @context.Designation</small>
                            }
                        </ResultTemplate>
                    </BlazoredTypeahead>
                </div>
            </div>

            @* ── Selected Employee Summary Banner ────────────────── *@
            @if (SelectedEmployee != null)
            {
                <div class="p-2 px-3 border border-primary rounded bg-primary bg-opacity-10 mb-3 d-flex align-items-center justify-content-between">
                    <div>
                        <strong class="text-primary">Selected: [@SelectedEmployee.EmpID] @SelectedEmployee.Name</strong>
                        <small class="text-muted ms-2">@SelectedEmployee.DeptName — @SelectedEmployee.Designation</small>
                    </div>
                    <span class="badge bg-primary">ACTIVE</span>
                </div>
            }

            @* ── SECTION 2: Fine Input Fields ───────────────────── *@
            <div class="card border shadow-sm p-3 mb-3 bg-light">
                <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2">
                    <i class="fas fa-file-signature me-1"></i> Fine Details
                </h6>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.85rem;">
                            Fine Date <span class="text-danger">*</span>
                        </label>
                        <input type="date" class="form-control form-control-sm"
                               value="@FineDate.ToString("yyyy-MM-dd")"
                               @onchange="OnFineDateChanged" style="height:35px;" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.85rem;">
                            Fine Amount <span class="text-danger">*</span>
                        </label>
                        <input type="number" class="form-control form-control-sm" step="0.01" min="0"
                               @bind="Amount" style="height:35px; background:#fffde7; font-weight:bold; color:#d9534f;" />
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.85rem;">Reason / Remarks</label>
                        <textarea class="form-control form-control-sm" rows="3"
                                  @bind="Description"
                                  placeholder="Enter the reason or description for the fine..."></textarea>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
