@page "/production/maker-rate-approval"
@page "/production/maker-rate-approval/{pTaskId:int}"
@using DataAccessLibrary.Models.ViewModels.Production
@using DataAccessLibrary.Models.IntraOffice
@using Impulse.Services.WorkflowTasks
@attribute [Authorize]

<PageTitle>Impulse - Maker Rate Change Approvals</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <!-- Main Glassmorphism Card -->
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-4">

            <!-- Page Header -->
            <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary" style="width: 44px; height: 44px;">
                        <i class="fas fa-hand-holding-usd fs-4"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold text-dark">Maker Rate Modification Approvals</h4>
                        <div class="text-muted small">Director Review &amp; Production Governance Queue</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (SelectedRequest != null || SelectedTaskId > 0)
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ClearSelection">
                            <i class="fas fa-arrow-left me-1"></i> Back to Queue
                        </button>
                    }
                    <a href="/production/maker-item-assignment" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-link me-1"></i> Maker Item Assignment
                    </a>
                    <button class="btn btn-primary btn-sm" @onclick="LoadPendingRequestsAsync">
                        <i class="fas fa-sync-alt me-1 @(IsLoading ? "fa-spin" : "")"></i> Refresh
                    </button>
                </div>
            </div>

            <!-- Error Alerts -->
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-3 py-2 px-3 small rounded-3" role="alert">
                    <i class="fas fa-exclamation-circle me-2 fs-5"></i>
                    <div>@ErrorMessage</div>
                    <button type="button" class="btn-close ms-auto" @onclick="() => ErrorMessage = null"></button>
                </div>
            }

            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="text-muted mt-2 small">Loading pending maker rate requests...</div>
                </div>
            }
            else if (SelectedRequest != null)
            {
                <!-- ================= RATE DETAIL REVIEW VIEW ================= -->

                <!-- Status & Info Hero Banner -->
                <div class="p-3 mb-3 rounded-3 border" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-3">
                            <span class="text-muted small d-block">Maker / Contractor</span>
                            <span class="fw-bold fs-6 text-primary">@SelectedRequest.MakerName</span>
                            <div class="text-secondary small">Process: <strong>@SelectedRequest.ProcessName</strong></div>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted small d-block">Item Details</span>
                            <span class="fw-semibold text-dark">
                                [@SelectedRequest.ItemID] @SelectedRequest.ItemName
                            </span>
                            <span class="badge bg-light text-dark border ms-1">@SelectedRequest.AssignedUnit</span>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted small d-block">Requested By (Originator)</span>
                            <span class="fw-semibold text-dark">
                                <i class="fas fa-user-circle text-secondary me-1"></i>@SelectedRequest.OriginatorUserName
                            </span>
                            <div class="text-muted" style="font-size: 0.75rem;">@SelectedRequest.CreatedAt.ToLocalTime().ToString("dd-MMM-yyyy hh:mm tt")</div>
                        </div>
                        <div class="col-md-3 text-md-end">
                            <span class="text-muted small d-block">Status</span>
                            @if (ActiveTask == null || ActiveTask.Status == TaskItemStatus.Pending || ActiveTask.Status == TaskItemStatus.InProgress)
                            {
                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                    <i class="fas fa-clock me-1"></i> Pending Director Review
                                </span>
                            }
                            else if (ActiveTask.Status == TaskItemStatus.Completed)
                            {
                                <span class="badge bg-success px-3 py-2 rounded-pill">
                                    <i class="fas fa-check-circle me-1"></i> Approved &amp; Applied
                                </span>
                            }
                            else if (ActiveTask.Status == TaskItemStatus.Cancelled)
                            {
                                <span class="badge bg-danger px-3 py-2 rounded-pill">
                                    <i class="fas fa-times-circle me-1"></i> Rejected / Cancelled
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Operator Reason Box -->
                <div class="card border mb-3 shadow-none bg-light">
                    <div class="card-body p-3">
                        <div class="fw-bold text-secondary small mb-1">
                            <i class="fas fa-comment-alt me-1"></i> Reason for Rate Change:
                        </div>
                        <div class="text-dark bg-white p-2 rounded border" style="font-size: 0.95rem;">
                            @SelectedRequest.Reason
                        </div>
                        @if (!string.IsNullOrWhiteSpace(SelectedRequest.Remarks))
                        {
                            <div class="fw-bold text-secondary small mt-2 mb-1">
                                <i class="fas fa-sticky-note me-1"></i> Item Remarks:
                            </div>
                            <div class="text-muted bg-white p-2 rounded border" style="font-size: 0.85rem;">
                                @SelectedRequest.Remarks
                            </div>
                        }
                    </div>
                </div>

                <!-- Comparison Diff Table (Old in Red, New in Green) -->
                <div class="card border mb-4 shadow-none">
                    <div class="card-header bg-white py-2 px-3 fw-bold text-dark border-bottom d-flex align-items-center justify-content-between">
                        <div>
                            <i class="fas fa-exchange-alt text-primary me-2"></i>
                            Rate Comparison (Before vs. Proposed)
                        </div>
                        <span class="badge bg-light text-dark border">Item [@SelectedRequest.ItemID]</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                                <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                    <tr>
                                        <th>Item Name</th>
                                        <th class="table-danger text-danger text-end" style="width: 140px;">Current Rate (Pcs)</th>
                                        <th class="table-danger text-danger text-end" style="width: 140px;">Current Rate (Dzn)</th>
                                        <th class="table-success text-success text-end" style="width: 140px;">Proposed Rate (Pcs)</th>
                                        <th class="table-success text-success text-end" style="width: 140px;">Proposed Rate (Dzn)</th>
                                        <th class="text-center" style="width: 130px;">Difference</th>
                                        <th style="width: 80px;">Unit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-primary">[@SelectedRequest.ItemID]</div>
                                            <div class="text-dark">@SelectedRequest.ItemName</div>
                                        </td>

                                        <!-- Current DB state (Red) -->
                                        <td class="text-end text-danger bg-danger bg-opacity-10 fw-bold fs-6">
                                            @SelectedRequest.OldRate.ToString("N2")
                                        </td>
                                        <td class="text-end text-danger bg-danger bg-opacity-10">
                                            @SelectedRequest.OldRateDozen.ToString("N2")
                                        </td>

                                        <!-- Proposed New state (Green) -->
                                        <td class="text-end text-success bg-success bg-opacity-10 fw-bold fs-6">
                                            @SelectedRequest.NewRate.ToString("N2")
                                        </td>
                                        <td class="text-end text-success bg-success bg-opacity-10 fw-bold">
                                            @SelectedRequest.NewRateDozen.ToString("N2")
                                        </td>

                                        <!-- Difference -->
                                        <td class="text-center">
                                            @if (SelectedRequest.RateDifference > 0)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                    +@SelectedRequest.RateDifference.ToString("N2")
                                                </span>
                                            }
                                            else if (SelectedRequest.RateDifference < 0)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                    @SelectedRequest.RateDifference.ToString("N2")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">0.00</span>
                                            }
                                        </td>

                                        <td>
                                            <span class="badge bg-light text-dark border">@SelectedRequest.AssignedUnit</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Decision Action Bar -->
                <div class="card border-0 shadow-sm p-3 bg-white rounded-3">
                    <div class="row align-items-center g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary mb-1">Director Remarks / Instructions (Optional):</label>
                            <input type="text" class="form-control form-control-sm" placeholder="Add any specific approval or rejection notes..." @bind="DirectorRemarks" />
                        </div>
                        <div class="col-md-6 text-md-end d-flex justify-content-md-end gap-2 align-items-end">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="ClearSelection">
                                <i class="fas fa-times me-1"></i> Close
                            </button>

                            @if (ActiveTask == null || ActiveTask.Status == TaskItemStatus.Pending || ActiveTask.Status == TaskItemStatus.InProgress)
                            {
                                <button class="btn btn-outline-danger btn-sm px-3" @onclick="OpenRejectModal" disabled="@IsProcessing">
                                    <i class="fas fa-times-circle me-1"></i> Reject Request
                                </button>
                                <button class="btn btn-success btn-sm px-4 fw-bold" @onclick="ApproveRequestAsync" disabled="@IsProcessing">
                                    @if (IsProcessing)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                        <span>Applying...</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-check-circle me-1"></i>
                                        <span>Approve &amp; Apply Rate</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- ================= PENDING REQUESTS QUEUE ================= -->
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="text-secondary fw-semibold small">
                        <i class="fas fa-tasks text-primary me-1"></i>
                        Pending Rate Change Requests (@PendingTasks.Count)
                    </div>
                </div>

                @if (!PendingTasks.Any())
                {
                    <div class="text-center py-5 bg-light rounded-3 border">
                        <i class="fas fa-clipboard-check text-success fa-3x mb-3"></i>
                        <h5 class="fw-bold text-dark">All Caught Up!</h5>
                        <p class="text-muted small mb-0">There are no pending maker rate change requests requiring Director approval.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive rounded-3 border">
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                            <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                <tr>
                                    <th style="width: 70px;">Task #</th>
                                    <th style="width: 140px;">Requested Date</th>
                                    <th>Maker / Contractor</th>
                                    <th>Title</th>
                                    <th>Requested By</th>
                                    <th style="width: 110px;">Status</th>
                                    <th class="text-end" style="width: 150px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var task in PendingTasks)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">#@task.Id</td>
                                        <td class="text-muted">
                                            @task.CreatedAt.ToLocalTime().ToString("dd-MMM-yyyy hh:mm tt")
                                        </td>
                                        <td class="fw-semibold">
                                            @task.AssignedToNames
                                        </td>
                                        <td>
                                            <span class="fw-semibold text-dark">@task.Title</span>
                                            <div class="text-muted small text-truncate" style="max-width: 420px;">
                                                @task.Description
                                            </div>
                                        </td>
                                        <td>
                                            <i class="fas fa-user-circle text-secondary me-1"></i>@task.AssignedBy
                                        </td>
                                        <td>
                                            <span class="badge bg-warning text-dark">
                                                <i class="fas fa-clock me-1"></i>Pending
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-primary py-1 px-3 shadow-sm" @onclick="() => SelectTaskAsync(task.Id)">
                                                <i class="fas fa-search me-1"></i> Review &amp; Decide
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

        </div>
    </div>
</div>

<!-- Reject Reason Modal -->
@if (ShowRejectModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); z-index: 1055;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
                <div class="modal-header py-2" style="background:#fee2e2; border-radius: 12px 12px 0 0;">
                    <h6 class="modal-title fw-bold text-danger mb-0">
                        <i class="fas fa-times-circle me-1"></i> Reject Rate Change Request
                    </h6>
                    <button type="button" class="btn-close" @onclick="CloseRejectModal"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="small text-muted mb-2">
                        Please enter a clear explanation for rejecting this rate change. This message will be sent directly to the originator.
                    </p>
                    <textarea class="form-control form-control-sm" rows="3" placeholder="Enter reason for rejection..." @bind="RejectReasonText"></textarea>
                </div>
                <div class="modal-footer py-2" style="background:#f8f9fb; border-radius: 0 0 12px 12px;">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" @onclick="CloseRejectModal">Cancel</button>
                    <button type="button" class="btn btn-sm btn-danger px-3" @onclick="ConfirmRejectAsync" disabled="@(string.IsNullOrWhiteSpace(RejectReasonText) || IsProcessing)">
                        @if (IsProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Rejecting...</span>
                        }
                        else
                        {
                            <i class="fas fa-ban me-1"></i>
                            <span>Confirm Rejection</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}
