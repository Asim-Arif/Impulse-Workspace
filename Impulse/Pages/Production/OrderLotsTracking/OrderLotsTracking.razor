@page "/production/order-lots-tracking"
@using DataAccessLibrary.Models.ViewModels.Production
@using Blazored.Typeahead

<style>
    .order-mgmt-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 12px;
        border: 1px solid rgba(226, 232, 240, 0.9);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
    }
    .kpi-stat-box {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 12px 14px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .kpi-stat-box:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
    }
    .kpi-icon-square {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }
    .hub-tile {
        background: #ffffff;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        padding: 10px 14px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .hub-tile:hover {
        transform: translateY(-2px);
        border-color: #2563eb;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.1);
    }
    .hub-tile.active-hub {
        background: #eff6ff;
        border-color: #2563eb;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);
    }
    .pill-badge {
        padding: 4px 10px;
        border-radius: 9999px;
        font-size: 0.74rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .blazored-typeahead {
        height: 35px !important;
        padding: 0 !important;
        box-sizing: border-box !important;
    }
    .filter-dropdown-row {
        position: relative !important;
        z-index: 9999 !important;
    }
    .table-container-row {
        position: relative !important;
        z-index: 1 !important;
    }
</style>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">

    <!-- TOP TITLE & ACTION BAR -->
    <div class="card border-0 shadow-sm mb-3" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body py-2 px-3">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="kpi-icon-square bg-primary text-white shadow-sm">
                        <i class="fas fa-boxes-stacked"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">Order Lots & Hub Tracking</h4>
                        <div class="text-muted small">Live Lot Tracking by Customer, Order, Hub & Supervisor with Scheduled Target Dates</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 shadow-sm" @onclick="LoadDataAsync" disabled="@IsLoading">
                        <i class="fas fa-sync-alt @(IsLoading ? "fa-spin" : "")"></i>
                        <span>Refresh</span>
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Filter.OrderNo))
                    {
                        <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1 shadow-sm" @onclick="() => NavigateToOrderManagement(Filter.OrderNo)">
                            <i class="fas fa-stream"></i>
                            <span>View in Order Mgmt</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- KPI STATS CARDS -->
    <div class="row g-2 mb-3">
        <div class="col-xl col-md-4 col-sm-6">
            <div class="kpi-stat-box h-100 shadow-sm d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Lots</span>
                    <h3 class="fw-bold mb-0 text-dark">@DashboardData.TotalLots.ToString("N0")</h3>
                    <small class="text-secondary fw-semibold">@DashboardData.TotalQty.ToString("N0") Units</small>
                </div>
                <div class="kpi-icon-square bg-light text-primary border">
                    <i class="fas fa-layer-group"></i>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="kpi-stat-box h-100 shadow-sm d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Active WIP Lots</span>
                    <h3 class="fw-bold mb-0 text-primary">@DashboardData.ActiveWipLots.ToString("N0")</h3>
                    <small class="text-primary fw-semibold">@DashboardData.ActiveWipQty.ToString("N0") In Process</small>
                </div>
                <div class="kpi-icon-square bg-primary-subtle text-primary border border-primary-subtle">
                    <i class="fas fa-cogs"></i>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="kpi-stat-box h-100 shadow-sm d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">On Track</span>
                    <h3 class="fw-bold mb-0 text-success">@DashboardData.OnTrackLots.ToString("N0")</h3>
                    <small class="text-success fw-semibold">Ahead of Target Date</small>
                </div>
                <div class="kpi-icon-square bg-success-subtle text-success border border-success-subtle">
                    <i class="fas fa-check-circle"></i>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="kpi-stat-box h-100 shadow-sm d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Due Soon</span>
                    <h3 class="fw-bold mb-0 text-warning">@DashboardData.DueSoonLots.ToString("N0")</h3>
                    <small class="text-warning fw-semibold">Within 3 Days</small>
                </div>
                <div class="kpi-icon-square bg-warning-subtle text-warning border border-warning-subtle">
                    <i class="fas fa-clock"></i>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="kpi-stat-box h-100 shadow-sm d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Overdue</span>
                    <h3 class="fw-bold mb-0 text-danger">@DashboardData.OverdueLots.ToString("N0")</h3>
                    <small class="text-danger fw-semibold">Past Target Date</small>
                </div>
                <div class="kpi-icon-square bg-danger-subtle text-danger border border-danger-subtle">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
            </div>
        </div>
        @if (Filter.IncludeCompleted)
        {
            <div class="col-xl col-md-4 col-sm-6">
                <div class="kpi-stat-box h-100 shadow-sm d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Completed Lots</span>
                        <h3 class="fw-bold mb-0 text-secondary">@DashboardData.CompletedLots.ToString("N0")</h3>
                        <small class="text-muted fw-semibold">Finished / Closed</small>
                    </div>
                    <div class="kpi-icon-square bg-light text-secondary border">
                        <i class="fas fa-flag-checkered"></i>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- VISUAL HUB DISTRIBUTION CARDS (Clickable for 1-Click Filtering) -->
    @if (DashboardData.HubSummaries != null && DashboardData.HubSummaries.Any())
    {
        <div class="card border-0 shadow-sm mb-3" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-bold small text-secondary text-uppercase">
                        <i class="fas fa-network-wired me-1 text-primary"></i> Hub Pipeline Distribution (Click card to filter table)
                    </span>
                    @if (!string.IsNullOrWhiteSpace(Filter.HubName))
                    {
                        <button class="btn btn-sm btn-link text-decoration-none p-0 text-primary small" @onclick="() => ToggleHubCardFilter(Filter.HubName)">
                            <i class="fas fa-times me-1"></i> Clear Hub Filter [@Filter.HubName]
                        </button>
                    }
                </div>
                <div class="row g-2">
                    @foreach (var hub in DashboardData.HubSummaries)
                    {
                        bool isCurrentHub = string.Equals(Filter.HubName, hub.Hub_Name, StringComparison.OrdinalIgnoreCase);
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <div class="hub-tile @(isCurrentHub ? "active-hub" : "")" @onclick="() => ToggleHubCardFilter(hub.Hub_Name)">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="fw-bold text-dark">
                                        <i class="fas fa-industry me-1 text-primary"></i>@hub.Hub_Name
                                    </span>
                                    <span class="badge @(isCurrentHub ? "bg-primary" : "bg-light text-dark border")">
                                        @hub.LotCount @(hub.LotCount == 1 ? "Lot" : "Lots")
                                    </span>
                                </div>
                                <div class="d-flex align-items-center justify-content-between small text-muted">
                                    <span>Quantity: <strong class="text-dark">@hub.TotalQty.ToString("N0")</strong></span>
                                    @if (hub.OverdueCount > 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="fas fa-exclamation-circle me-1"></i>@hub.OverdueCount Overdue
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="fas fa-check me-1"></i>On Track
                                        </span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(hub.Supervisors))
                                {
                                    <div class="mt-1 pt-1 border-top small text-muted text-truncate" title="Supervisors: @hub.Supervisors" style="font-size: 0.76rem;">
                                        <i class="fas fa-user-tie me-1 text-secondary opacity-75"></i>@hub.Supervisors
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- FILTERS TOOLBAR -->
    <div class="order-mgmt-card p-3 mb-3 filter-dropdown-row">
        <div class="row g-2 align-items-end">
            <!-- Customer Filter -->
            <div class="col-lg-3 col-md-6">
                <label class="form-label form-label-sm fw-bold text-secondary mb-1">
                    <i class="fas fa-building me-1"></i> Customer
                </label>
                <select class="form-select form-select-sm" 
                        value="@(Filter.CustCode ?? "")" 
                        @onchange="@(async e => {
                            string val = e.Value?.ToString() ?? "";
                            var cust = Customers.FirstOrDefault(c => c.CustCode == val);
                            await OnCustomerSelected(cust);
                        })">
                    <option value="">-- All Customers --</option>
                    @foreach (var c in Customers)
                    {
                        <option value="@c.CustCode">@c.CustCode</option>
                    }
                </select>
            </div>

            <!-- Order / Internal Ref Filter -->
            <div class="col-lg-3 col-md-6">
                <label class="form-label form-label-sm fw-bold text-secondary mb-1">
                    <i class="fas fa-file-invoice me-1"></i> Internal Ref No
                </label>
                <select class="form-select form-select-sm" 
                        value="@(Filter.OrderNo ?? "")" 
                        @onchange="@(async e => {
                            string val = e.Value?.ToString() ?? "";
                            var ord = Orders.FirstOrDefault(o => o.OrderNo == val);
                            await OnOrderSelected(ord);
                        })">
                    <option value="">-- All Internal Ref Nos --</option>
                    @foreach (var o in Orders)
                    {
                        <option value="@o.OrderNo">@o.DisplayText</option>
                    }
                </select>
            </div>

            <!-- Hub Filter -->
            <div class="col-lg-2 col-md-4">
                <label class="form-label form-label-sm fw-bold text-secondary mb-1">
                    <i class="fas fa-network-wired me-1"></i> Hub
                </label>
                <select class="form-select form-select-sm" 
                        value="@(Filter.HubName ?? "")" 
                        @onchange="@(async e => await OnHubFilterChanged(e.Value?.ToString()))">
                    <option value="">-- All Hubs --</option>
                    @foreach (var h in HubNames)
                    {
                        <option value="@h">@h</option>
                    }
                </select>
            </div>

            <!-- Date Range Preset -->
            <div class="col-lg-2 col-md-4">
                <label class="form-label form-label-sm fw-bold text-secondary mb-1">
                    <i class="fas fa-calendar-alt me-1"></i> Date Range
                </label>
                <select class="form-select form-select-sm" @bind="Filter.DateRangeType" @bind:after="OnDateRangeChanged">
                    <option value="0">All Time</option>
                    <option value="1">Today</option>
                    <option value="2">Last 15 Days</option>
                    <option value="3">Last 30 Days</option>
                    <option value="4">Last 60 Days</option>
                    <option value="5">Last 90 Days</option>
                    <option value="6">Custom Range</option>
                </select>
            </div>

            <!-- Date Mode (Order Date vs Target Date) -->
            <div class="col-lg-2 col-md-4">
                <label class="form-label form-label-sm fw-bold text-secondary mb-1">
                    <i class="fas fa-filter me-1"></i> Date Field
                </label>
                <select class="form-select form-select-sm" @bind="Filter.DateFilterMode" @bind:after="OnDateFilterModeChanged">
                    <option value="0">Order Date</option>
                    <option value="1">Target Date</option>
                </select>
            </div>
        </div>

        <!-- Custom Date Range Row (Shown only if Custom selected) & Checkbox options -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-2 mt-2 border-top">
            @if (Filter.DateRangeType == 6)
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="small fw-semibold text-secondary">From:</span>
                    <input type="date" class="form-control form-control-sm" style="max-width: 140px;" @bind="Filter.DtFrom" @bind:after="OnDateRangeChanged" />
                    <span class="small fw-semibold text-secondary">To:</span>
                    <input type="date" class="form-control form-control-sm" style="max-width: 140px;" @bind="Filter.DtTo" @bind:after="OnDateRangeChanged" />
                </div>
            }

            <div class="form-check form-check-inline mb-0">
                <input class="form-check-input" type="checkbox" id="chkIncludeCompleted" @bind="Filter.IncludeCompleted" @bind:after="OnIncludeCompletedChanged" />
                <label class="form-check-label fw-semibold text-secondary small" for="chkIncludeCompleted">
                    Include Completed / Closed Lots
                </label>
            </div>

            <div class="ms-auto d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFiltersAsync">
                    <i class="fas fa-undo me-1"></i> Reset Filters
                </button>
            </div>
        </div>
    </div>

    <!-- LOTS DATA TABLE SECTION -->
    <div class="table-container-row">
        <!-- Quick Search & Count -->
        <div class="d-flex align-items-center justify-content-between mb-2">
            <div class="d-flex align-items-center gap-2">
                <span class="text-secondary small fw-bold"><i class="fas fa-search me-1"></i> Search Lots:</span>
                <input type="text" class="form-control form-control-sm shadow-sm" style="min-width: 280px;" 
                       @bind="ClientSearchTerm" @bind:event="oninput" 
                       placeholder="Filter by Lot, Order, Article, Hub, Supervisor..." />
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-secondary">Showing: @FilteredLots.Count of @DashboardData.TotalLots Lots</span>
            </div>
        </div>

        <!-- Table Container -->
        <div class="table-responsive rounded-3 shadow-sm border bg-white" style="max-height: 60vh; overflow-y: auto;">
            <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                    <tr>
                        <th style="width: 40px;">#</th>
                        <th>Lot No</th>
                        <th>Internal Ref No</th>
                        <th>Customer</th>
                        <th>Article / Item</th>
                        <th>Current Process</th>
                        <th>Hub / Supervisor</th>
                        <th class="text-end">Qty</th>
                        <th class="text-center">Target Date</th>
                        <th style="min-width: 110px;">Pipeline Progress</th>
                        <th>Current Station / State</th>
                        <th class="text-center" style="width: 70px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="12" class="text-center py-5 text-muted">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div> Loading Order Lots & Hub Data...
                            </td>
                        </tr>
                    }
                    else if (!FilteredLots.Any())
                    {
                        <tr>
                            <td colspan="12" class="text-center py-5 text-muted">
                                <i class="fas fa-info-circle me-1 fa-lg"></i> No lots found matching the selected filters.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int index = 1;
                        @foreach (var item in FilteredLots)
                        {
                            var currentItem = item;
                            <tr class="@GetRowClass(currentItem)">
                                <td class="text-secondary small">@(index++)</td>
                                <td>
                                    <span class="badge" style="background-color: #0891b2; color: #ffffff; font-size: 0.82rem; font-weight: 600;">
                                        @currentItem.LotNo
                                    </span>
                                    @if (currentItem.IsReWork)
                                    {
                                        <span class="badge bg-danger ms-1" title="Repair / Re-Work Lot">R</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-primary text-white" style="font-size: 0.82rem;">
                                        @(string.IsNullOrWhiteSpace(currentItem.InternalRefNo) ? currentItem.OrderNo : currentItem.InternalRefNo)
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@currentItem.CustCode</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark text-truncate" style="max-width: 220px;" title="@currentItem.FullArticle">
                                        @currentItem.ItemCode
                                    </div>
                                    <div class="small text-muted text-truncate" style="max-width: 220px;" title="@currentItem.ItemName">
                                        @currentItem.ItemName @currentItem.ItemSize
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@currentItem.ProcessName</div>
                                    <div class="small text-muted" style="font-size: 0.76rem;">
                                        Step @currentItem.CurrentSeqNo of @currentItem.TotalSeqNo
                                    </div>
                                </td>
                                <td>
                                    <!-- HUB NAME ON TOP, SUPERVISOR BELOW THAT -->
                                    <div class="fw-bold text-dark">
                                        <i class="fas fa-industry text-primary me-1"></i>@currentItem.Hub_Name
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(currentItem.Supervisors))
                                    {
                                        <div class="small text-muted" style="font-size: 0.78rem;">
                                            <i class="fas fa-user-tie me-1 text-secondary opacity-75"></i>@currentItem.Supervisors
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted fst-italic" style="font-size: 0.76rem;">No supervisor assigned</div>
                                    }
                                </td>
                                <td class="text-end fw-bold text-dark">
                                    @currentItem.Qty.ToString("N0")
                                </td>
                                <td class="text-center">
                                    <!-- TARGET DATE ON TOP, STATUS BADGE BELOW -->
                                    @if (currentItem.TargetDate.HasValue)
                                    {
                                        <div class="fw-semibold text-dark" style="font-size: 0.84rem;">
                                            @currentItem.TargetDate.Value.ToString("dd-MMM-yyyy")
                                        </div>
                                        <div>
                                            @if (currentItem.IsCompleted)
                                            {
                                                <span class="pill-badge bg-success-subtle text-success border border-success-subtle">
                                                    <i class="fas fa-check"></i> Completed
                                                </span>
                                            }
                                            else if (currentItem.TargetStatus == "Overdue")
                                            {
                                                <span class="pill-badge bg-danger-subtle text-danger border border-danger-subtle">
                                                    <i class="fas fa-exclamation-triangle"></i> Overdue @(Math.Abs(currentItem.DaysRemaining ?? 0))d
                                                </span>
                                            }
                                            else if (currentItem.TargetStatus == "Due Today")
                                            {
                                                <span class="pill-badge bg-warning-subtle text-warning border border-warning-subtle">
                                                    <i class="fas fa-clock"></i> Due Today
                                                </span>
                                            }
                                            else if (currentItem.TargetStatus == "Due Soon")
                                            {
                                                <span class="pill-badge bg-warning-subtle text-warning border border-warning-subtle">
                                                    <i class="fas fa-hourglass-half"></i> In @(currentItem.DaysRemaining)d
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="pill-badge bg-info-subtle text-info border border-info-subtle">
                                                    <i class="fas fa-calendar-check"></i> In @(currentItem.DaysRemaining)d
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar @(currentItem.IsCompleted ? "bg-success" : "bg-primary")" 
                                                 role="progressbar" 
                                                 style="width: @currentItem.ProgressPct%;" 
                                                 aria-valuenow="@currentItem.ProgressPct" 
                                                 aria-valuemin="0" 
                                                 aria-valuemax="100">
                                            </div>
                                        </div>
                                        <span class="small fw-semibold text-secondary" style="font-size: 0.74rem;">@currentItem.ProgressPct%</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 180px;">
                                        <span class="badge @(currentItem.IsCompleted ? "bg-light text-secondary border" : "bg-light text-dark border")">
                                            @currentItem.LotState
                                        </span>
                                    </div>
                                    <div class="small text-muted text-truncate" style="max-width: 180px;" title="@currentItem.MakerName">
                                        @currentItem.MakerName
                                    </div>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-outline-primary btn-sm px-2 py-1" 
                                            title="View in Order Management"
                                            @onclick="() => NavigateToOrderManagement(currentItem.OrderNo)">
                                        <i class="fas fa-stream"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
