@using DataAccessLibrary.Models.ViewModels.Production

<div class="table-responsive rounded-3 shadow-sm border" style="position: relative !important; z-index: 1 !important; max-height: 60vh;">
    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
        <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
            <tr>
                <th style="width: 45px;">S. #</th>
                <th>PO #</th>
                <th>Date</th>
                <th>Item ID</th>
                <th>Item Name</th>
                <th>Process</th>
                <th class="text-center">Qty</th>
                <th class="text-center">Rate</th>
                <th class="text-end">Wastage Amt</th>
                <th>Lot No.</th>
                <th>Maker</th>
                <th class="text-center">Status</th>
            </tr>
        </thead>
        <tbody>
            @if (IsLoading)
            {
                <tr>
                    <td colspan="12" class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                        Loading history...
                    </td>
                </tr>
            }
            else if (!Items.Any())
            {
                <tr>
                    <td colspan="12" class="text-center py-4 text-muted">
                        <i class="fas fa-info-circle me-1"></i> No history entries found for the selected filters.
                    </td>
                </tr>
            }
            else
            {
                int rowNo = 1;
                @foreach (var item in Items)
                {
                    string rowColorClass = item.FromVendID == FactoryMakerId ? "text-danger" : "text-primary";
                    <tr class="@rowColorClass">
                        <td class="text-muted">@(rowNo++)</td>
                        <td class="fw-semibold">@item.RecieptID</td>
                        <td>@(item.DT?.ToString("dd-MMM-yyyy") ?? "-")</td>
                        <td class="font-monospace">@item.ItemCode</td>
                        <td>@item.ItemName</td>
                        <td>@item.Description</td>
                        <td class="text-center fw-semibold">@item.Qty.ToString("N0")</td>
                        <td class="text-center">@item.Rate.ToString("N0")</td>
                        <td class="text-end fw-bold">@item.WastageAmt.ToString("N0")</td>
                        <td class="font-monospace">@item.LotNo</td>
                        <td>@item.VenderName</td>
                        <td class="text-center">
                            @if (item.DeductFromBilling == true)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Deduct</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Ignored</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public List<RejectionAuthItemModel> Items { get; set; } = new();
    [Parameter] public int FactoryMakerId { get; set; }
    [Parameter] public bool IsLoading { get; set; }
}
