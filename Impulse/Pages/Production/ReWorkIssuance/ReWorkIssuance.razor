@page "/production/rework-issuance"
@using DataAccessLibrary.Models.ViewModels.Production
@using Impulse.Services.Production
@using Blazored.Typeahead

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">
            
            <!-- Page Header -->
            <div class="d-flex align-items-end justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3">
                        <i class="fas fa-tools fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark" style="font-size: 1.35rem;">Re-Work Issuance</h4>
                        <div class="text-muted small">Issue rework lots to makers and generate new sequential rework lot numbers</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="PrintPendingReport">
                        <i class="fas fa-print me-1"></i> Print Pending
                    </button>
                    <button type="button" class="btn btn-sm btn-primary fw-bold" @onclick="LoadAvailableLotsAsync" disabled="@IsLoadingAvailable">
                        @if (IsLoadingAvailable)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        else
                        {
                            <i class="fas fa-sync-alt me-1"></i>
                        }
                        Refresh
                    </button>
                </div>
            </div>

            <!-- Success Alert Banner (when lot is generated) -->
            @if (!string.IsNullOrEmpty(LastGeneratedLotNo))
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center justify-content-between p-3 mb-3 shadow-sm rounded-3" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fas fa-check-circle fs-4 text-success"></i>
                        <div>
                            <strong class="d-block">Lot #@LastGeneratedLotNo Generated Successfully!</strong>
                            <span class="small text-muted">Issuance Receipt: @LastMakerIssNo</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-success fw-bold" @onclick="@(() => PrintPTCForLot(LastGeneratedLotNo))">
                            <i class="fas fa-print me-1"></i> Print PTC
                        </button>
                        <button type="button" class="btn-close" @onclick="@(() => LastGeneratedLotNo = string.Empty)"></button>
                    </div>
                </div>
            }

            <!-- Filter Controls Panel -->
            <div class="row g-2 align-items-end mb-3 p-3 bg-light rounded-3 border">
                <!-- Article / Item Selector -->
                <div class="col-md-4">
                    <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                        <i class="fas fa-box-open text-primary me-1"></i> Article / Item <span class="text-danger">*</span>
                    </label>
                    <div class="custom-typeahead-container">
                        <BlazoredTypeahead SearchMethod="SearchArticles"
                                           TValue="LookupItemString"
                                           TItem="LookupItemString"
                                           Value="SelectedArticle"
                                           ValueChanged="OnArticleChanged"
                                           ValueExpression="@(() => SelectedArticle)"
                                           Placeholder="Type Item ID or Name..."
                                           EnableDropDown="true"
                                           MaximumSuggestions="1000">
                            <SelectedTemplate Context="art">
                                @art.Name
                            </SelectedTemplate>
                            <ResultTemplate Context="art">
                                @art.Name
                            </ResultTemplate>
                            <NotFoundTemplate Context="searchText">
                                <span class="text-muted small">No items matching "@searchText"</span>
                            </NotFoundTemplate>
                        </BlazoredTypeahead>
                    </div>
                </div>


                <!-- Date Range Selector -->
                <div class="col-md-2">
                    <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Date Range</label>
                    <select class="form-select form-select-sm" @bind="Filter.DateRangeIndex" @bind:after="OnDateRangeChanged">
                        <option value="0">Today</option>
                        <option value="1">Last 7 Days</option>
                        <option value="2">Last 15 Days</option>
                        <option value="3">Last 30 Days</option>
                        <option value="4">Custom Range</option>
                    </select>
                </div>

                <!-- Date Pickers (visible if custom range) -->
                @if (Filter.DateRangeIndex == 4)
                {
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">From Date</label>
                        <input type="date" class="form-control form-control-sm" @bind="Filter.DtFrom" @bind:after="LoadAvailableLotsAsync" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">To Date</label>
                        <input type="date" class="form-control form-control-sm" @bind="Filter.DtTo" @bind:after="LoadAvailableLotsAsync" />
                    </div>
                }

                <!-- Repair Type Selector -->
                <div class="col-md-2">
                    <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Repair Type</label>
                    <select class="form-select form-select-sm" @bind="Filter.RepairTypeId" @bind:after="LoadAvailableLotsAsync">
                        <option value="0">&lt;All Repair Types&gt;</option>
                        @foreach (var rt in RepairTypes)
                        {
                            <option value="@rt.Id">@rt.Name</option>
                        }
                    </select>
                </div>

                <!-- Quick Lot No Search -->
                <div class="col-md-2">
                    <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Lot #</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control form-control-sm text-center" @bind="Filter.LotNo" @onkeydown="OnLotNoKeyDown" placeholder="Enter Lot #..." />
                        <button class="btn btn-outline-secondary" type="button" @onclick="LoadAvailableLotsAsync">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- GRID 1: AVAILABLE REWORK LOTS -->
            <div class="card border mb-3 rounded-3 shadow-none">
                <div class="card-header py-2 px-3 bg-light border-bottom d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-secondary small">
                            <i class="fas fa-inbox text-primary me-1"></i> AVAILABLE REWORK LOTS (RECEIVED)
                        </span>
                        <span class="badge bg-secondary">@AvailableLots.Count Lots</span>
                    </div>
                    <div class="small text-muted">
                        Total Available: <strong class="text-dark">@TotalAvailableQty.ToString("N0")</strong> pcs
                    </div>
                </div>
                <div class="table-responsive" style="max-height: 38vh; overflow-y: auto;">
                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                            <tr>
                                <th style="width: 45px;">#</th>
                                <th style="width: 110px;">Lot #</th>
                                <th style="width: 140px;">Customer Order</th>
                                <th>Maker</th>
                                <th>Repair Type</th>
                                <th class="text-center" style="width: 120px;">Available Qty</th>
                                <th class="text-end" style="width: 100px;">Rate</th>
                                <th class="text-center" style="width: 100px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (IsLoadingAvailable)
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span> Loading available rework lots...
                                    </td>
                                </tr>
                            }
                            else if (!AvailableLots.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        <i class="fas fa-info-circle me-1"></i> No available rework lots found for the selected criteria.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int idx = 1;
                                @foreach (var item in AvailableLots)
                                {
                                    <tr @ondblclick="@(() => StageLot(item))" style="cursor: pointer;">
                                        <td>@(idx++)</td>
                                        <td>
                                            <span class="badge px-2 py-1" style="background-color: #2196F3; color: #ffffff; font-weight: 700; border-radius: 4px;">
                                                @item.LotNo
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@item.OrderNo</span>
                                        </td>
                                        <td class="fw-semibold text-dark">@item.DisplayMaker</td>
                                        <td>
                                            <span class="badge bg-info text-dark">@item.RepairType</span>
                                        </td>
                                        <td class="text-center fw-bold text-success">@item.BalanceQty.ToString("N0")</td>
                                        <td class="text-end">@item.Rate.ToString("N2")</td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" @onclick="@(() => StageLot(item))" title="Add to Issuance Batch">
                                                <i class="fas fa-plus-circle me-1"></i> Stage
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- GRID 2: STAGED ISSUANCE BATCH -->
            <div class="card border mb-3 rounded-3 shadow-none">
                <div class="card-header py-2 px-3 bg-light border-bottom d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-secondary small">
                            <i class="fas fa-dolly text-success me-1"></i> STAGED FOR RE-WORK ISSUANCE
                        </span>
                        <span class="badge bg-primary">@StagedLots.Count Lots Staged</span>
                    </div>
                    <div class="small text-muted">
                        Total Staged: <strong class="text-primary fs-6">@TotalStagedQty.ToString("N0")</strong> pcs
                    </div>
                </div>
                <div class="table-responsive" style="max-height: 32vh; overflow-y: auto;">
                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                            <tr>
                                <th style="width: 45px;">#</th>
                                <th style="width: 110px;">Lot #</th>
                                <th style="width: 140px;">Customer Order</th>
                                <th>Origin Maker</th>
                                <th>Repair Type</th>
                                <th class="text-center" style="width: 120px;">Qty</th>
                                <th class="text-center" style="width: 120px;">Rate</th>
                                <th class="text-center" style="width: 100px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!StagedLots.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted fst-italic">
                                        <i class="fas fa-arrow-up me-1"></i> Double-click or click "+ Stage" on any lot above to add it to this issuance batch.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int sIdx = 1;
                                @foreach (var staged in StagedLots)
                                {
                                    <tr>
                                        <td>@(sIdx++)</td>
                                        <td>
                                            <span class="badge px-2 py-1" style="background-color: #2196F3; color: #ffffff; font-weight: 700; border-radius: 4px;">
                                                @staged.LotNo
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@staged.OrderNo</span>
                                        </td>
                                        <td class="fw-semibold text-dark">@staged.DisplayMaker</td>
                                        <td>
                                            <span class="badge bg-info text-dark">@staged.RepairType</span>
                                        </td>
                                        <td class="text-center fw-bold text-primary">@staged.Qty.ToString("N0")</td>
                                        <td class="text-center">
                                            <input type="number" step="0.01" class="form-control form-control-sm text-center py-0" @bind="staged.Rate" style="max-width: 100px; margin: 0 auto;" />
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="@(() => UnstageLot(staged))" title="Remove from batch">
                                                <i class="fas fa-times me-1"></i> Remove
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ISSUANCE ACTION FOOTER PANEL -->
            <div class="card border rounded-3 p-3 bg-light">
                <div class="row g-3 align-items-center">
                    <!-- Maker Selector -->
                    <div class="col-md-5">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                            <i class="fas fa-user-cog text-primary me-1"></i> Assign Maker for Repair <span class="text-danger">*</span>
                        </label>
                        <div class="custom-typeahead-container @(!StagedLots.Any() ? "disabled-typeahead-wrapper" : "")">
                            <BlazoredTypeahead SearchMethod="SearchMakers"
                                               TValue="LookupItemInt"
                                               TItem="LookupItemInt"
                                               Value="SelectedMaker"
                                               ValueChanged="OnMakerChanged"
                                               ValueExpression="@(() => SelectedMaker)"
                                               Placeholder="@(StagedLots.Any() ? "Select Maker..." : "Stage lots first to load eligible makers")"
                                               Disabled="@(!StagedLots.Any())"
                                               EnableDropDown="true"
                                               MaximumSuggestions="1000">
                                <SelectedTemplate Context="mkr">
                                    @mkr.Name
                                </SelectedTemplate>
                                <ResultTemplate Context="mkr">
                                    @mkr.Name
                                </ResultTemplate>
                                <NotFoundTemplate Context="searchText">
                                    <span class="text-muted small">No makers found matching "@searchText"</span>
                                </NotFoundTemplate>
                            </BlazoredTypeahead>
                        </div>
                    </div>

                    <!-- Print PTC Option -->
                    <div class="col-md-3">
                        <div class="form-check mt-3">
                            <input class="form-check-input" type="checkbox" id="chkPrintPTC" @bind="PrintPTCAfterSave" />
                            <label class="form-check-label fw-bold text-dark small" for="chkPrintPTC">
                                <i class="fas fa-print text-secondary me-1"></i> Print PTC Card after Issuing
                            </label>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="col-md-4 text-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary me-2" @onclick="ClearStaging" disabled="@(!StagedLots.Any() || IsSaving)">
                            <i class="fas fa-eraser me-1"></i> Clear Batch
                        </button>
                        <button type="button" class="btn btn-sm btn-primary fw-bold px-4" @onclick="PostReWorkIssuance" disabled="@(!StagedLots.Any() || SelectedMaker == null || IsSaving)">
                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>Posting...</span>
                            }
                            else
                            {
                                <i class="fas fa-check-circle me-1"></i>
                                <span>Post / Issue Rework</span>
                            }
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .blazored-typeahead {
        height: 35px !important;
        font-size: 0.875rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .disabled-typeahead-wrapper .blazored-typeahead {
        background-color: #e9ecef !important;
        overflow: hidden !important;
        border-radius: 4px;
    }
    .blazored-typeahead__input, .blazored-typeahead__controls {
        height: 33px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input-mask, .blazored-typeahead__input-mask-wrapper {
        height: 33px !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
    }
    .blazored-typeahead__results {
        z-index: 10000 !important;
    }
</style>

