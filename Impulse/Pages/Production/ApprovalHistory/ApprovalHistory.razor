@page "/production/approval-history"
@page "/approvals/history"
@using DataAccessLibrary.Models.ViewModels.Production
@using DataAccessLibrary.Models.Setup
@attribute [Authorize]

<PageTitle>Impulse - Workflow Approval History</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <!-- Main Glassmorphism Card -->
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-4">

            <!-- Page Header -->
            <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary" style="width: 44px; height: 44px;">
                        <i class="fas fa-history fs-4"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold text-dark">Workflow Approval History</h4>
                        <div class="text-muted small">Historical audit logs of approved, rejected, and pending workflow requests</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-1 me-2">
                        <span class="badge bg-light text-dark border px-2 py-1" title="Total Requests Found">
                            Total: <strong>@FilteredItems.Count()</strong>
                        </span>
                        <span class="badge bg-success bg-opacity-25 text-success border border-success px-2 py-1" title="Approved">
                            <i class="fas fa-check-circle me-1"></i>@AllHistoryItems.Count(x => string.Equals(x.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                        </span>
                        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger px-2 py-1" title="Rejected">
                            <i class="fas fa-times-circle me-1"></i>@AllHistoryItems.Count(x => string.Equals(x.Status, "Rejected", StringComparison.OrdinalIgnoreCase))
                        </span>
                        <span class="badge bg-warning bg-opacity-25 text-dark border border-warning px-2 py-1" title="Pending">
                            <i class="fas fa-clock me-1"></i>@AllHistoryItems.Count(x => string.Equals(x.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                        </span>
                    </div>

                    <a href="/production" class="btn btn-outline-secondary btn-sm" title="Back to Production Dashboard">
                        <i class="fas fa-arrow-left me-1"></i> Dashboard
                    </a>
                    <button class="btn btn-primary btn-sm" @onclick="LoadHistoryAsync" disabled="@IsLoading" title="Refresh Approval Records">
                        <i class="fas fa-sync-alt me-1 @(IsLoading ? "fa-spin" : "")"></i> Refresh
                    </button>
                </div>
            </div>

            <!-- Error Alerts -->
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-3 py-2 px-3 small rounded-3" role="alert">
                    <i class="fas fa-exclamation-circle me-2 fs-5"></i>
                    <div>@ErrorMessage</div>
                    <button type="button" class="btn-close ms-auto" @onclick="() => ErrorMessage = null"></button>
                </div>
            }

            <!-- Filters Bar (High Z-Index for dropdown stack isolation) -->
            <div class="p-3 mb-3 rounded-3 border bg-light bg-opacity-50" style="position: relative !important; z-index: 9999 !important;">
                <div class="row g-2 align-items-end">
                    <!-- Workflow Name Dropdown -->
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label text-secondary small fw-bold mb-1">
                            <i class="fas fa-diagram-project me-1 text-primary"></i> Workflow Name
                        </label>
                        <select class="form-select form-select-sm" @bind="SelectedWorkflowCode">
                            <option value="">-- All Workflows --</option>
                            @foreach (var wf in WorkflowConfigs)
                            {
                                <option value="@wf.WorkflowCode">@wf.WorkflowName</option>
                            }
                        </select>
                    </div>

                    <!-- Status Filter Dropdown -->
                    <div class="col-md-2 col-sm-6">
                        <label class="form-label text-secondary small fw-bold mb-1">
                            <i class="fas fa-filter me-1 text-primary"></i> Status
                        </label>
                        <select class="form-select form-select-sm" @bind="SelectedStatus">
                            <option value="">-- All Statuses --</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                            <option value="Pending">Pending (Read-Only)</option>
                        </select>
                    </div>

                    <!-- Date Range: From -->
                    <div class="col-md-2 col-sm-6">
                        <label class="form-label text-secondary small fw-bold mb-1">
                            <i class="fas fa-calendar-day me-1 text-primary"></i> From Date
                        </label>
                        <input type="date" class="form-control form-control-sm" @bind="DateFrom" />
                    </div>

                    <!-- Date Range: To -->
                    <div class="col-md-2 col-sm-6">
                        <label class="form-label text-secondary small fw-bold mb-1">
                            <i class="fas fa-calendar-day me-1 text-primary"></i> To Date
                        </label>
                        <input type="date" class="form-control form-control-sm" @bind="DateTo" />
                    </div>

                    <!-- Filter & Reset Action Buttons -->
                    <div class="col-md-3 col-sm-12 d-flex gap-2">
                        <button class="btn btn-sm btn-primary flex-fill" @onclick="LoadHistoryAsync" disabled="@IsLoading">
                            <i class="fas fa-filter me-1"></i> Apply Filter
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFiltersAsync" disabled="@IsLoading" title="Reset Filters">
                            <i class="fas fa-undo"></i>
                        </button>
                    </div>
                </div>

                <!-- Text Search Filter -->
                <div class="row mt-2 g-2">
                    <div class="col-12">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0" 
                                   placeholder="Filter results by Lot #, Order No, Item, Maker, Process, Reason, Approver..." 
                                   @bind="SearchText" @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(SearchText))
                            {
                                <button class="btn btn-outline-secondary" type="button" @onclick="() => SearchText = string.Empty">
                                    <i class="fas fa-times"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table Container (Lower Z-Index for stacking isolation) -->
            <div class="table-responsive rounded-3 border bg-white" style="position: relative !important; z-index: 1 !important; min-height: 250px; max-height: 65vh; overflow-y: auto;">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="text-muted mt-2 small">Loading approval history records...</div>
                    </div>
                }
                else if (!FilteredItems.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <div class="mb-2">
                            <i class="fas fa-folder-open fs-1 text-secondary opacity-50"></i>
                        </div>
                        <div class="fw-semibold">No historical approvals match the selected filters</div>
                        <div class="small">Try adjusting the workflow filter, status, or date range above.</div>
                    </div>
                }
                else
                {
                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                            <tr>
                                <th style="width: 50px;" class="text-center">#</th>
                                <th style="min-width: 170px;">Workflow</th>
                                <th style="min-width: 130px;">Entity / Lot #</th>
                                <th style="min-width: 170px;">Item Details</th>
                                <th style="min-width: 140px;">Process / Maker</th>
                                <th style="width: 75px;" class="text-end">Qty</th>
                                <th style="min-width: 150px;">Requested By</th>
                                <th style="min-width: 100px;" class="text-center">Status</th>
                                <th style="min-width: 150px;">Action By &amp; Date</th>
                                <th style="min-width: 160px;">Remarks</th>
                                <th style="width: 60px;" class="text-center">View</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in FilteredItems)
                            {
                                <tr>
                                    <!-- ID / Ref -->
                                    <td class="text-center text-muted small fw-bold">
                                        @item.RecordId
                                    </td>

                                    <!-- Workflow Name -->
                                    <td>
                                        <span class="fw-semibold text-dark d-block">
                                            @item.WorkflowName
                                        </span>
                                        <span class="badge bg-light text-secondary border" style="font-size: 0.72rem;">
                                            @item.WorkflowCode
                                        </span>
                                    </td>

                                    <!-- Entity / Lot # -->
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.LotNo) && item.LotNo != "0")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger fw-bold">
                                                Lot #@item.LotNo
                                            </span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.OrderNo))
                                        {
                                            <div class="text-secondary small mt-1">
                                                <i class="fas fa-file-invoice me-1"></i>@item.OrderNo
                                            </div>
                                        }
                                    </td>

                                    <!-- Item Code & Name -->
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.ItemCode))
                                        {
                                            <span class="fw-bold text-dark font-monospace" style="font-size: 0.82rem;">[@item.ItemCode]</span>
                                        }
                                        <div class="text-truncate text-secondary small" style="max-width: 220px;" title="@item.ItemName">
                                            @(item.ItemName ?? "-")
                                        </div>
                                    </td>

                                    <!-- Process / Maker -->
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.ProcessName))
                                        {
                                            <div class="text-dark small fw-semibold">
                                                <i class="fas fa-gear me-1 text-secondary"></i>@item.ProcessName
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.TargetProcessName))
                                        {
                                            <div class="text-primary small">
                                                <i class="fas fa-arrow-right me-1"></i>Skip To: <strong>@item.TargetProcessName</strong>
                                            </div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(item.MakerName))
                                        {
                                            <div class="text-muted small">
                                                <i class="fas fa-user-cog me-1"></i>@item.MakerName
                                            </div>
                                        }
                                    </td>

                                    <!-- Qty -->
                                    <td class="text-end fw-semibold">
                                        @(item.Qty.HasValue && item.Qty.Value > 0 ? item.Qty.Value.ToString("N0") : "-")
                                    </td>

                                    <!-- Requested By & Date -->
                                    <td>
                                        <div class="fw-semibold text-dark small">
                                            <i class="fas fa-user-circle me-1 text-secondary"></i>@(item.RequestedBy ?? "-")
                                        </div>
                                        <div class="text-muted" style="font-size: 0.75rem;">
                                            @(item.RequestedDT.HasValue ? item.RequestedDT.Value.ToString("dd-MMM-yyyy hh:mm tt") : "-")
                                        </div>
                                    </td>

                                    <!-- Status Badge -->
                                    <td class="text-center">
                                        <span class="badge @GetStatusBadgeClass(item.Status) px-2 py-1 rounded-pill" style="font-size: 0.75rem;">
                                            <i class="@GetStatusIcon(item.Status) me-1"></i>@item.Status
                                        </span>
                                    </td>

                                    <!-- Action By & Date -->
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.ActionBy))
                                        {
                                            <div class="fw-semibold text-dark small">
                                                <i class="fas fa-user-shield me-1 text-success"></i>@item.ActionBy
                                            </div>
                                            <div class="text-muted" style="font-size: 0.75rem;">
                                                @(item.ActionDT.HasValue ? item.ActionDT.Value.ToString("dd-MMM-yyyy hh:mm tt") : "-")
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic small">Pending Decision</span>
                                        }
                                    </td>

                                    <!-- Approver Remarks / Reason -->
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.ActionRemarks))
                                        {
                                            <div class="text-dark small text-truncate" style="max-width: 200px;" title="@item.ActionRemarks">
                                                <strong>Remarks:</strong> @item.ActionRemarks
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.RequestReason))
                                        {
                                            <div class="text-muted small text-truncate" style="max-width: 200px;" title="@item.RequestReason">
                                                <strong>Reason:</strong> @item.RequestReason
                                            </div>
                                        }
                                    </td>

                                    <!-- View Details Button -->
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary p-1 px-2 rounded-2" 
                                                @onclick="() => ViewDetails(item)" title="View Full Historical Details">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

        </div>
    </div>
</div>

<!-- ================= READ-ONLY HISTORICAL DETAILS MODAL ================= -->
@if (ShowDetailsModal && SelectedItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px); z-index: 10500;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow border-0" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header bg-light py-2 px-3 border-bottom d-flex align-items-center">
                    <h5 class="modal-title fs-6 fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="fas fa-info-circle text-primary me-2"></i>
                        <span>Approval Audit Details &bull; Record #@SelectedItem.RecordId</span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseDetails"></button>
                </div>

                <div class="modal-body p-4">
                    <!-- Status Banner -->
                    <div class="p-3 mb-3 rounded-3 border d-flex align-items-center justify-content-between flex-wrap gap-2" 
                         style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                        <div>
                            <div class="text-muted small">Workflow</div>
                            <h6 class="mb-0 fw-bold text-dark">@SelectedItem.WorkflowName</h6>
                            <div class="text-secondary small">Code: @SelectedItem.WorkflowCode &bull; Module: @SelectedItem.Module</div>
                        </div>
                        <div class="text-end">
                            <span class="badge @GetStatusBadgeClass(SelectedItem.Status) px-3 py-2 rounded-pill fs-6">
                                <i class="@GetStatusIcon(SelectedItem.Status) me-1"></i>@SelectedItem.Status
                            </span>
                        </div>
                    </div>

                    <!-- Entity & Item Details Grid -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 border bg-white h-100">
                                <div class="text-secondary small fw-bold mb-2 pb-1 border-bottom">
                                    <i class="fas fa-box me-1 text-primary"></i> Entity & Production Info
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted small d-block">Lot Number</span>
                                    <span class="fw-bold fs-6 text-danger">@(string.IsNullOrWhiteSpace(SelectedItem.LotNo) || SelectedItem.LotNo == "0" ? "-" : $"#{SelectedItem.LotNo}")</span>
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted small d-block">Order / PO Number</span>
                                    <span class="fw-semibold text-dark">@(SelectedItem.OrderNo ?? "-")</span>
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted small d-block">Item Details</span>
                                    <span class="text-dark">
                                        @if (!string.IsNullOrWhiteSpace(SelectedItem.ItemCode))
                                        {
                                            <strong>[@SelectedItem.ItemCode]</strong>
                                        }
                                        @(SelectedItem.ItemName ?? "-")
                                    </span>
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted small d-block">Process / Department</span>
                                    <span class="text-dark fw-semibold">@(SelectedItem.ProcessName ?? "-")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(SelectedItem.TargetProcessName))
                                {
                                    <div class="mb-2">
                                        <span class="text-muted small d-block">Target Skip Process</span>
                                        <span class="text-primary fw-bold">@SelectedItem.TargetProcessName</span>
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(SelectedItem.MakerName))
                                {
                                    <div class="mb-2">
                                        <span class="text-muted small d-block">Maker / Vendor</span>
                                        <span class="text-dark">@SelectedItem.MakerName</span>
                                    </div>
                                }
                                <div>
                                    <span class="text-muted small d-block">Quantity</span>
                                    <span class="fw-bold text-dark">@(SelectedItem.Qty.HasValue ? SelectedItem.Qty.Value.ToString("N0") : "-")</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 rounded-3 border bg-white h-100">
                                <div class="text-secondary small fw-bold mb-2 pb-1 border-bottom">
                                    <i class="fas fa-shield-halved me-1 text-primary"></i> Request & Audit Trail
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted small d-block">Requested By (Originator)</span>
                                    <span class="fw-semibold text-dark">
                                        <i class="fas fa-user-circle text-secondary me-1"></i>@(SelectedItem.RequestedBy ?? "-")
                                    </span>
                                    <div class="text-muted" style="font-size: 0.78rem;">
                                        @(SelectedItem.RequestedDT.HasValue ? SelectedItem.RequestedDT.Value.ToString("dd-MMM-yyyy hh:mm:ss tt") : "-")
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(SelectedItem.MachineName))
                                {
                                    <div class="mb-2">
                                        <span class="text-muted small d-block">Workstation / Machine</span>
                                        <span class="text-secondary font-monospace small">@SelectedItem.MachineName</span>
                                    </div>
                                }
                                <div class="mb-2">
                                    <span class="text-muted small d-block">Action By (Reviewer / Director)</span>
                                    <span class="fw-semibold text-dark">
                                        <i class="fas fa-user-shield text-success me-1"></i>@(SelectedItem.ActionBy ?? "Pending")
                                    </span>
                                    @if (SelectedItem.ActionDT.HasValue)
                                    {
                                        <div class="text-muted" style="font-size: 0.78rem;">
                                            @SelectedItem.ActionDT.Value.ToString("dd-MMM-yyyy hh:mm:ss tt")
                                        </div>
                                    }
                                </div>
                                @if (SelectedItem.TaskId.HasValue && SelectedItem.TaskId.Value > 0)
                                {
                                    <div>
                                        <span class="text-muted small d-block">Linked Workflow Task ID</span>
                                        <span class="badge bg-light text-secondary border font-monospace">Task #@SelectedItem.TaskId.Value</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Reasons & Remarks -->
                    <div class="p-3 rounded-3 border bg-light bg-opacity-25 mb-2">
                        <div class="mb-3">
                            <span class="text-secondary small fw-bold d-block mb-1">
                                <i class="fas fa-comment-dots text-primary me-1"></i> Request Reason / Justification:
                            </span>
                            <div class="p-2 rounded bg-white border text-dark" style="font-size: 0.9rem; white-space: pre-wrap;">
                                @(string.IsNullOrWhiteSpace(SelectedItem.RequestReason) ? "No reason specified." : SelectedItem.RequestReason)
                            </div>
                        </div>
                        <div>
                            <span class="text-secondary small fw-bold d-block mb-1">
                                <i class="fas fa-clipboard-check text-success me-1"></i> Reviewer / Director Remarks:
                            </span>
                            <div class="p-2 rounded bg-white border text-dark" style="font-size: 0.9rem; white-space: pre-wrap;">
                                @(string.IsNullOrWhiteSpace(SelectedItem.ActionRemarks) ? "No remarks entered." : SelectedItem.ActionRemarks)
                            </div>
                        </div>
                    </div>

                    <div class="text-muted small fst-italic">
                        <i class="fas fa-info-circle me-1"></i> This is a read-only historical audit screen. Requests cannot be modified or approved from this view.
                    </div>
                </div>

                <div class="modal-footer bg-light py-2 px-3 border-top">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseDetails">
                        <i class="fas fa-times me-1"></i> Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}
