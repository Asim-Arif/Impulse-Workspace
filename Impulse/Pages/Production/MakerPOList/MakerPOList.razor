@page "/production/maker-po-list"
@using BlazorContextMenu
@using Blazored.Typeahead
@using DataAccessLibrary.Models.ViewModels.Production
@using Impulse.Services.Production
@using Impulse.Services
@using Radzen.Blazor

<PageTitle>Maker PO List | Impulse ERP</PageTitle>
<meta name="description" content="Production issuance orders, authorization status, and tracking." />

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.87); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">
            <!-- ── Page Header & Top Actions ──────────────────────────── -->
            <div class="d-flex align-items-end pb-2 mb-3 border-bottom flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:38px;height:38px;background:linear-gradient(135deg,#1565C0,#42A5F5);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-list-alt text-white" style="font-size:1.05rem;"></i>
                    </div>
                    <div>
                        <h1 class="mb-0 fw-bold" style="font-size:1.25rem;color:#1565C0;">Maker PO List</h1>
                        <small class="text-muted" style="font-size:0.75rem;">Production issuance orders, authorization status, and tracking</small>
                    </div>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2 flex-wrap">
                    @if (IsLoading)
                    {
                        <span class="text-muted" style="font-size:0.8rem;"><i class="fas fa-spinner fa-spin me-1"></i>Loading...</span>
                    }
                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="AuthorizeSelected" disabled="@IsLoading">
                        <i class="fas fa-check-circle me-1"></i> Authorize Selected
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CheckAllRows" disabled="@IsLoading">
                        <i class="fas fa-check-double me-1"></i> Check All
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="UncheckAllRows" disabled="@IsLoading">
                        <i class="fas fa-times me-1"></i> Uncheck All
                    </button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="OnRefreshClicked" disabled="@IsLoading">
                        <i class="fas fa-sync-alt me-1"></i> Refresh
                    </button>
                    <button type="button" class="btn btn-sm btn-dark text-white fw-bold shadow-sm px-3" @onclick="ShowOptionsMenu" disabled="@IsLoading">
                        <i class="fas fa-ellipsis-v me-1"></i> Options
                    </button>
                </div>
            </div>

            <!-- Filters Section -->
            <div class="card border-0 bg-light p-2 mb-3 rounded-3" style="position: relative !important; z-index: 9999 !important;">
                <!-- Row 1: Multi-Select Typeahead Controls -->
                <div class="row g-2 mb-2">
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Maker</label>
                        <BlazoredTypeahead SearchMethod="SearchMakers" @bind-Values="SelectedMakers" EnableDropDown="true" MaximumSuggestions="1000" Placeholder="<All Makers>">
                            <SelectedTemplate>@context.Name</SelectedTemplate>
                            <ResultTemplate>@context.Name</ResultTemplate>
                        </BlazoredTypeahead>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Category</label>
                        <BlazoredTypeahead SearchMethod="SearchCategories" @bind-Values="SelectedCategories" EnableDropDown="true" MaximumSuggestions="1000" Placeholder="<All Categories>">
                            <SelectedTemplate>@context.Name</SelectedTemplate>
                            <ResultTemplate>@context.Name</ResultTemplate>
                        </BlazoredTypeahead>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Group</label>
                        <BlazoredTypeahead SearchMethod="SearchGroups" @bind-Values="SelectedGroups" EnableDropDown="true" MaximumSuggestions="1000" Placeholder="<All Groups>">
                            <SelectedTemplate>@context.Name</SelectedTemplate>
                            <ResultTemplate>@context.Name</ResultTemplate>
                        </BlazoredTypeahead>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Process</label>
                        <BlazoredTypeahead SearchMethod="SearchProcesses" @bind-Values="SelectedProcesses" EnableDropDown="true" MaximumSuggestions="1000" Placeholder="<All Processes>">
                            <SelectedTemplate>@context.Name</SelectedTemplate>
                            <ResultTemplate>@context.Name</ResultTemplate>
                        </BlazoredTypeahead>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Customer</label>
                        <BlazoredTypeahead SearchMethod="SearchCustomers" @bind-Values="SelectedCustomers" EnableDropDown="true" MaximumSuggestions="1000" Placeholder="<All Customers>">
                            <SelectedTemplate>@context.Name</SelectedTemplate>
                            <ResultTemplate>@context.Name</ResultTemplate>
                        </BlazoredTypeahead>
                    </div>
                </div>

                <!-- Row 2: Lookups & Date Filters -->
                <div class="row g-2 mb-2">
                    <div class="col-md-3">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Article / Item</label>
                        <BlazoredTypeahead SearchMethod="SearchItems" @bind-Value="SelectedArticle" EnableDropDown="true" MaximumSuggestions="1000" Placeholder="<All Articles>">
                            <SelectedTemplate>@context.Name</SelectedTemplate>
                            <ResultTemplate>@context.Name</ResultTemplate>
                        </BlazoredTypeahead>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Purchaser</label>
                        <BlazoredTypeahead SearchMethod="SearchPurchasers" @bind-Value="SelectedPurchaser" EnableDropDown="true" MaximumSuggestions="1000" Placeholder="<All Purchasers>">
                            <SelectedTemplate>@context.Name</SelectedTemplate>
                            <ResultTemplate>@context.Name</ResultTemplate>
                        </BlazoredTypeahead>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Date Range</label>
                        <select class="form-select form-select-sm" @bind="Filter.DateRangeIndex" @bind:after="OnFilterChanged">
                            <option value="0">Today</option>
                            <option value="1">Last 15 Days</option>
                            <option value="2">Last 30 Days</option>
                            <option value="3">Last 60 Days</option>
                            <option value="4">Last 90 Days</option>
                            <option value="5">Custom</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">From Date</label>
                        <input type="date" class="form-control form-control-sm" @bind="Filter.DtFrom" @bind:after="OnFilterChanged" disabled="@(Filter.DateRangeIndex != 5)" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">To Date</label>
                        <input type="date" class="form-control form-control-sm" @bind="Filter.DtTo" @bind:after="OnFilterChanged" disabled="@(Filter.DateRangeIndex != 5)" />
                    </div>
                </div>

                <!-- Row 3: Text Search & Due Days Mode -->
                <div class="row g-2 mb-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Lot No.</label>
                        <input type="text" class="form-control form-control-sm" @bind="Filter.LotNo" @bind:event="oninput" @bind:after="OnFilterChanged" placeholder="Search Lot..." />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Order No.</label>
                        <input type="text" class="form-control form-control-sm" @bind="Filter.OrderNo" @bind:event="oninput" @bind:after="OnFilterChanged" placeholder="Order No..." />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Master PO No.</label>
                        <input type="text" class="form-control form-control-sm" @bind="Filter.MasterPONo" @bind:event="oninput" @bind:after="OnFilterChanged" placeholder="Master PO..." />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Due Days Mode</label>
                        <select class="form-select form-select-sm" @bind="Filter.DueDaysMode" @bind:after="OnFilterChanged">
                            <option value="0">None</option>
                            <option value="1">Within 3 Days</option>
                            <option value="2">Within 7 Days</option>
                            <option value="3">Custom Days</option>
                        </select>
                    </div>
                    @if (Filter.DueDaysMode == 3)
                    {
                        <div class="col-md-2">
                            <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Custom Days</label>
                            <input type="number" class="form-control form-control-sm" @bind="Filter.DueDaysCustom" @bind:after="OnFilterChanged" />
                        </div>
                    }
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">In-Active Days (Report Only)</label>
                        <input type="text" class="form-control form-control-sm" @bind="Filter.InActiveDays" placeholder="Days..." />
                    </div>
                </div>

                <!-- Row 4: Checkboxes -->
                <div class="d-flex flex-wrap gap-3 pt-1 border-top align-items-center" style="font-size: 0.83rem;">
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" id="chkShowMasterPOOnly" @bind="Filter.ShowMasterPOOnly" @bind:after="OnShowMasterPOOnlyChanged" />
                        <label class="form-check-label fw-semibold text-secondary" for="chkShowMasterPOOnly">Show Master POs Only</label>
                    </div>
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" id="chkMasterPOOpen" @bind="Filter.MasterPOOpen" @bind:after="OnMasterPOOpenChanged" />
                        <label class="form-check-label fw-semibold text-secondary" for="chkMasterPOOpen">Open Master POs Only</label>
                    </div>
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" id="chkRepairLots" @bind="Filter.RepairLots" @bind:after="OnRepairLotsChanged" />
                        <label class="form-check-label fw-semibold text-danger" for="chkRepairLots">Repair Lots Only</label>
                    </div>
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" id="chkRegularLotsOnly" @bind="Filter.RegularLotsOnly" @bind:after="OnRegularLotsOnlyChanged" />
                        <label class="form-check-label fw-semibold text-secondary" for="chkRegularLotsOnly">Regular Lots Only</label>
                    </div>
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" id="chkBookmarks" @bind="Filter.Bookmarks" @bind:after="OnFilterChanged" />
                        <label class="form-check-label fw-semibold text-primary" for="chkBookmarks">Bookmarks Only</label>
                    </div>
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" id="chkOpenLotsOnly" @bind="Filter.OpenLotsOnly" @bind:after="OnFilterChanged" />
                        <label class="form-check-label fw-semibold text-secondary" for="chkOpenLotsOnly">Open Lots Only</label>
                    </div>
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" id="chkRepairIssuance" @bind="Filter.RepairIssuance" @bind:after="OnFilterChanged" />
                        <label class="form-check-label fw-semibold text-secondary" for="chkRepairIssuance">Repair Issuances Only</label>
                    </div>
                </div>
            </div>

            <!-- Quick Search, Page Size & Summary Badges -->
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-secondary small fw-bold"><i class="fas fa-search me-1"></i> Quick Search:</span>
                    <input type="text" class="form-control form-control-sm" style="max-width: 230px;" @bind="ClientSearchTerm" @bind:event="oninput" placeholder="Type to filter list..." />
                    
                    <span class="text-secondary small fw-bold ms-2"><i class="fas fa-list-ol me-1"></i> Per Page:</span>
                    <select class="form-select form-select-sm" style="width: 85px;" value="@PageSize" @onchange="@((ChangeEventArgs e) => SetPageSize(int.Parse(e.Value?.ToString() ?? "50")))">
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="250">250</option>
                        <option value="500">500</option>
                        <option value="1000">1000</option>
                    </select>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1" style="font-size: 0.78rem;">
                        <i class="fas fa-coins me-1"></i> Total Value: <strong>@TotalPOValue.ToString("N2")</strong>
                    </span>
                    @if (TotalAuthorizedCount > 0)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.78rem;">
                            <i class="fas fa-check-circle me-1"></i> Auth: <strong>@TotalAuthorizedCount.ToString("N0")</strong>
                        </span>
                    }
                    @if (TotalUnAuthorizedCount > 0)
                    {
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1" style="font-size: 0.78rem;">
                            <i class="fas fa-clock me-1"></i> Un-Auth: <strong>@TotalUnAuthorizedCount.ToString("N0")</strong>
                        </span>
                    }
                    <span class="badge bg-secondary ms-1">Records: @TotalCount.ToString("N0")</span>
                </div>
            </div>

            <!-- Data Table Container -->
            <div class="table-responsive rounded-3 shadow-sm border" style="position: relative !important; z-index: 1 !important; max-height: 60vh;">
                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                    <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                        <tr>
                            <th class="text-center" style="width: 40px;">
                                <input class="form-check-input" type="checkbox" checked="@(CheckedIds.Count > 0 && CheckedIds.Count == FilteredItems.Count)" @onchange="ToggleSelectAll" />
                            </th>
                            <th style="width: 40px;">#</th>
                            <th>Maker</th>
                            <th>Receipt ID</th>
                            <th>Date</th>
                            <th>Process</th>
                            <th>Hub / Supervisor</th>
                            <th>Article</th>
                            <th class="text-end">Value</th>
                            <th class="text-center">Auth</th>
                            <th>Return Dates</th>
                            <th>Lot No.</th>
                            <th>Master PO</th>
                            <th>Int. Ref</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="14" class="text-center py-4 text-muted">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div> Loading Maker POs...
                                </td>
                            </tr>
                        }
                        else if (!FilteredItems.Any())
                        {
                            <tr>
                                <td colspan="14" class="text-center py-4 text-muted">
                                    <i class="fas fa-info-circle me-1"></i> No issuance records found matching filters.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int index = ((CurrentPage - 1) * PageSize) + 1;
                            @foreach (var item in PagedItems)
                            {
                                var currentItem = item;
                                bool isChecked = CheckedIds.Contains(currentItem.EntryID);
                                bool isSelected = SelectedItem?.EntryID == currentItem.EntryID;

                                <ContextMenuTrigger WrapperTag="tr" MenuId="rowContextMenu" Data="@currentItem"
                                                    @onclick="@(() => SelectRow(currentItem))"
                                                    @oncontextmenu="@(() => SelectRow(currentItem))"
                                                    class="@($"{GetRowClass(currentItem)} {(isSelected ? "table-primary" : "")}")" style="cursor: pointer;">
                                    <td class="text-center" @onclick:stopPropagation="true">
                                        <input class="form-check-input" type="checkbox" checked="@isChecked" @onchange="@((e) => ToggleRowCheck(currentItem.EntryID, e.Value))" />
                                    </td>
                                    <td>@(index++)</td>
                                    <td class="fw-semibold">@currentItem.DisplayMaker</td>
                                    <td><span class="badge bg-light text-dark border">@currentItem.RecieptID</span></td>
                                    <td>@(currentItem.DT?.ToString("dd-MMM-yyyy"))</td>
                                    <td>@currentItem.Description</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(currentItem.Hub_Name))
                                        {
                                            <div class="fw-semibold text-dark">@currentItem.Hub_Name</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(currentItem.Supervisors))
                                        {
                                            <div class="small text-muted" style="font-size: 0.78rem;">@currentItem.Supervisors</div>
                                        }
                                        @if (string.IsNullOrWhiteSpace(currentItem.Hub_Name) && string.IsNullOrWhiteSpace(currentItem.Supervisors))
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>@currentItem.FullArticle</td>
                                    <td class="text-end fw-bold">@currentItem.TotalValue.ToString("N2")</td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrWhiteSpace(currentItem.LotNo) && PendingSkipProcessLotNos.Contains(currentItem.LotNo))
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-forward me-1"></i>Pending Skip</span>
                                        }
                                        else if (PendingDeletionIssuanceEntryIds.Contains(currentItem.EntryID) || (!string.IsNullOrWhiteSpace(currentItem.LotNo) && PendingDeletionLotNos.Contains(currentItem.LotNo)))
                                        {
                                            <span class="badge bg-danger text-white"><i class="fas fa-trash-alt me-1"></i>Pending Deletion</span>
                                        }
                                        else if (currentItem.Authorized)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>Authorized</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>Un-Auth</span>
                                        }
                                    </td>
                                    <td class="text-danger fw-bold small">@currentItem.MakerPOReturnDTs</td>
                                    <td><span class="badge bg-info text-dark">@currentItem.LotNo</span></td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(currentItem.MasterPONo))
                                        {
                                            <span class="badge bg-primary text-white">@currentItem.MasterPONo</span>
                                        }
                                    </td>
                                    <td>@currentItem.InternalRefNo</td>
                                </ContextMenuTrigger>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paging Info & Controls -->
            @if (TotalCount > 0)
            {
                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                    <div class="text-muted" style="font-size: 0.85rem;">
                        Showing <strong>@(((CurrentPage - 1) * PageSize) + 1)</strong> to <strong>@Math.Min(CurrentPage * PageSize, TotalCount)</strong> of <strong>@TotalCount.ToString("N0")</strong> records
                    </div>
                    @if (TotalPages > 1)
                    {
                        <nav aria-label="Maker PO List Page Navigation">
                            <ul class="pagination pagination-sm mb-0">
                                <!-- First Page -->
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(1)" title="First Page">
                                        <i class="fas fa-angle-double-left"></i>
                                    </button>
                                </li>
                                <!-- Previous Page -->
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)" title="Previous Page">
                                        <i class="fas fa-angle-left"></i>
                                    </button>
                                </li>

                                @{
                                    int window = 2;
                                    int startPage = Math.Max(1, CurrentPage - window);
                                    int endPage = Math.Min(TotalPages, CurrentPage + window);

                                    if (CurrentPage <= window + 1)
                                    {
                                        endPage = Math.Min(TotalPages, 1 + (window * 2));
                                    }
                                    else if (CurrentPage >= TotalPages - window)
                                    {
                                        startPage = Math.Max(1, TotalPages - (window * 2));
                                    }

                                    if (startPage > 1)
                                    {
                                        <li class="page-item">
                                            <button class="page-link" @onclick="() => GoToPage(1)">1</button>
                                        </li>
                                        if (startPage > 2)
                                        {
                                            <li class="page-item disabled"><span class="page-link">…</span></li>
                                        }
                                    }

                                    for (int idx = startPage; idx <= endPage; idx++)
                                    {
                                        var pageNumber = idx;
                                        <li class="page-item @(CurrentPage == pageNumber ? "active" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                                        </li>
                                    }

                                    if (endPage < TotalPages)
                                    {
                                        if (endPage < TotalPages - 1)
                                        {
                                            <li class="page-item disabled"><span class="page-link">…</span></li>
                                        }
                                        <li class="page-item">
                                            <button class="page-link" @onclick="() => GoToPage(TotalPages)">@TotalPages</button>
                                        </li>
                                    }
                                }

                                <!-- Next Page -->
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)" title="Next Page">
                                        <i class="fas fa-angle-right"></i>
                                    </button>
                                </li>
                                <!-- Last Page -->
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(TotalPages)" title="Last Page">
                                        <i class="fas fa-angle-double-right"></i>
                                    </button>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Row Context Menu (Right Click) -->
<ContextMenu Id="rowContextMenu" Template="Win11Style">
    <div class="win11-section-header px-3 py-1 text-muted small fw-bold border-bottom">ROUTINE ACTIONS</div>
    <Item OnClick="@DeleteSelected"><i class="fas fa-trash text-danger me-2"></i> Delete Selected</Item>
    <Item OnClick="@CloseMakerPO"><i class="fas fa-lock text-warning me-2"></i> Close Maker PO</Item>
    <Item OnClick="@EditPromises"><i class="fas fa-calendar-alt text-info me-2"></i> Edit Promises</Item>
    <Item OnClick="@AddBookmark"><i class="fas fa-bookmark text-primary me-2"></i> Add Bookmark</Item>
    <Item OnClick="@AddFollowup"><i class="fas fa-plus-circle text-success me-2"></i> Add Followup Entries</Item>

    <div class="win11-section-header px-3 py-1 text-muted small fw-bold border-bottom border-top mt-1">ISSUANCE SLIPS & PO PRINTS</div>
    <Item OnClick="@PrintIssSlip"><i class="fas fa-print text-dark me-2"></i> Print Purchase Order (Issuance Slip)</Item>
    <Item OnClick="@PrintIssSlipNoRate"><i class="fas fa-print text-dark me-2"></i> Print PO (Without Rate)</Item>
    <Item OnClick="@PrintIssSlipMini"><i class="fas fa-print text-dark me-2"></i> Print PO (Mini / CTC)</Item>
    <Item OnClick="@PrintTag"><i class="fas fa-tag text-dark me-2"></i> Print Tag</Item>
    <Item OnClick="@PrintInternal"><i class="fas fa-file-alt text-dark me-2"></i> Print Internal Master PO</Item>

    <div class="win11-section-header px-3 py-1 text-muted small fw-bold border-bottom border-top mt-1">MASTER PO COPIES</div>
    <Item OnClick="@PrintMasterPOOffice"><i class="fas fa-copy text-primary me-2"></i> Master PO (Office Copy)</Item>
    <Item OnClick="@PrintMasterPOMaker"><i class="fas fa-copy text-primary me-2"></i> Master PO (Maker Copy)</Item>
    <Item OnClick="@PrintMasterPOAccounts"><i class="fas fa-copy text-primary me-2"></i> Master PO (Accounts Copy)</Item>
    <Item OnClick="@PrintMasterPOHideRate"><i class="fas fa-eye-slash text-secondary me-2"></i> Master PO (Hide Rate)</Item>
