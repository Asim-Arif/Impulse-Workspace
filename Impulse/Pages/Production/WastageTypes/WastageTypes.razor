@page "/production/wastage-types"
@using DataAccessLibrary.Models.ViewModels.Production
@using Impulse.Components.Production.WastageTypes
@using BlazorContextMenu

<PageTitle>Wastage Types Setup | Impulse ERP</PageTitle>
<meta name="description" content="Define production scrap, material wastage, and reject categories." />

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.87); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">

            <!-- ── Page Header & Top Actions ──────────────────────────── -->
            <div class="d-flex align-items-end pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:38px;height:38px;background:linear-gradient(135deg,#1565C0,#42A5F5);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-recycle text-white" style="font-size:1.05rem;"></i>
                    </div>
                    <div>
                        <h1 class="mb-0 fw-bold" style="font-size:1.25rem;color:#1565C0;">Wastage Types Setup</h1>
                        <small class="text-muted" style="font-size:0.75rem;">Define production scrap, material wastage, and reject categories</small>
                    </div>
                </div>

                <div class="ms-auto d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-success fw-bold px-3" @onclick="OpenCreateModal">
                        <i class="fas fa-plus-circle me-1"></i> New Wastage Type
                    </button>
                </div>
            </div>

            <!-- Search Filter Bar -->
            <div class="row g-2 align-items-center mb-3">
                <div class="col-md-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                        <input type="text"
                               class="form-control"
                               placeholder="Search by wastage name or allocation strategy..."
                               @bind="SearchText"
                               @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-6 text-end text-muted small">
                    Showing <strong class="text-dark">@FilteredWastageTypes.Count</strong> of <strong class="text-dark">@WastageTypesList.Count</strong> wastage types
                </div>
            </div>

            <!-- Wastage Types Master Grid -->
            <div class="table-responsive border rounded-3 mb-2" style="max-height: 58vh; overflow-y: auto;">
                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem; white-space: nowrap;">
                    <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                        <tr>
                            <th style="width: 70px;" class="text-center">ID</th>
                            <th style="min-width: 250px;">Wastage Name / Description</th>
                            <th style="min-width: 220px;">Cost Allocation Strategy</th>
                            <th style="width: 120px;" class="text-center">Status</th>
                            <th style="width: 100px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span> Loading wastage types...
                                </td>
                            </tr>
                        }
                        else if (!FilteredWastageTypes.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fas fa-trash-alt fa-2x d-block mb-2 text-secondary opacity-50"></i>
                                    No wastage types found matching your search.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var wt in FilteredWastageTypes)
                            {
                                <ContextMenuTrigger MenuId="wtContextMenu" Data="@wt" WrapperTag="tr" class="@(SelectedWastageType?.EntryID == wt.EntryID ? "table-primary" : "")" @onclick="() => SelectedWastageType = wt" @ondblclick="() => OpenEditModal(wt)">
                                    <td class="text-center">
                                        <span class="badge bg-secondary">ID: @wt.EntryID</span>
                                    </td>
                                    <td class="fw-bold text-dark">
                                        @wt.WastageName
                                    </td>
                                    <td>
                                        <span class="badge @wt.BadgeClass px-2 py-1">
                                            @wt.WastageTypeTitle
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (wt.Closed)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2">Closed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-2">Active</span>
                                        }
                                    </td>
                                    <td class="text-center" @onclick:stopPropagation="true">
                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                            <button type="button" class="btn btn-link btn-sm p-1 text-primary" title="Edit Wastage Type" @onclick="() => OpenEditModal(wt)">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>
                                            <button type="button" class="btn btn-link btn-sm p-1 text-danger" title="Delete Wastage Type" @onclick="() => PromptDeleteWastageType(wt)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </ContextMenuTrigger>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<!-- Context Menu with Win11Style -->
<ContextMenu Id="wtContextMenu" Template="Win11Style">
    <div class="win11-section-header">Wastage Actions</div>
    <Item class="win11-menu-item" OnClick="@ContextNew">
        <i class="fas fa-plus-circle fa-fw win11-icon text-success"></i> New Wastage Type
    </Item>
    <Item class="win11-menu-item" OnClick="@ContextEdit">
        <i class="fas fa-pencil-alt fa-fw win11-icon text-primary"></i> Edit Wastage Type
    </Item>
    <div class="win11-divider"></div>
    <Item class="win11-menu-item" OnClick="@ContextDelete">
        <i class="fas fa-trash fa-fw win11-icon text-danger"></i> Delete Wastage Type
    </Item>
</ContextMenu>

<!-- Wastage Type Modal Component -->
<WastageTypeModal IsOpen="ShowModal"
                  Model="ModelForEdit"
                  OnSaved="OnModalSaved"
                  OnClosed="OnModalClosed" />

<!-- Delete Confirmation Modal -->
@if (ShowDeleteModal && ItemToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.5); z-index: 100050; font-family: 'Calibri', 'Segoe UI', sans-serif;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
                <div class="modal-header bg-danger text-white py-2 px-3">
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i> Confirm Wastage Type Deletion
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ShowDeleteModal = false"></button>
                </div>
                <div class="modal-body p-3">
                    <p class="mb-2">Are you sure you want to delete wastage type <strong>@ItemToDelete.WastageName</strong> (ID: <strong>@ItemToDelete.EntryID</strong>)?</p>
                    <div class="p-2 bg-light rounded border text-muted small">
                        <div><strong>Allocation Strategy:</strong> @ItemToDelete.WastageTypeTitle</div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-3">
                    <button type="button" class="btn btn-sm btn-secondary fw-bold" @onclick="() => ShowDeleteModal = false" disabled="@IsDeleting">Cancel</button>
                    <button type="button" class="btn btn-sm btn-danger fw-bold px-3" @onclick="ConfirmDeleteWastageType" disabled="@IsDeleting">
                        @if (IsDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <i class="fas fa-trash me-1"></i>
                            <span>Delete Wastage Type</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .blazor-context-menu {
        z-index: 100000 !important;
        max-height: 40vh !important;
        overflow-y: auto !important;
    }
</style>
