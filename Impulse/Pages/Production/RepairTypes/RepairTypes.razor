@page "/production/repair-types"
@using DataAccessLibrary.Models.ViewModels.Production
@using Impulse.Components.Production.RepairTypes
@using BlazorContextMenu

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: #ffffff; border-radius: 12px;">
        <div class="card-body p-3">

            <!-- Page Header & Top Actions -->
            <div class="d-flex align-items-end justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3">
                        <i class="fas fa-tools fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark" style="font-size: 1.35rem;">Repair Types Setup</h4>
                        <div class="text-muted small">Rework classifications, defect mapping, and manufacturing repair processes</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-success fw-bold px-3" @onclick="OpenCreateModal">
                        <i class="fas fa-plus-circle me-1"></i> New Repair Type
                    </button>
                </div>
            </div>

            <!-- Search Filter Bar -->
            <div class="row g-2 align-items-center mb-3">
                <div class="col-md-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                        <input type="text"
                               class="form-control"
                               placeholder="Search by repair code, type, defect, or process..."
                               @bind="SearchText"
                               @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-6 text-end text-muted small">
                    Showing <strong class="text-dark">@FilteredRepairTypes.Count</strong> of <strong class="text-dark">@RepairTypesList.Count</strong> repair types
                </div>
            </div>

            <!-- Repair Types Master Grid -->
            <div class="table-responsive border rounded-3 mb-2" style="max-height: 58vh; overflow-y: auto;">
                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem; white-space: nowrap;">
                    <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                        <tr>
                            <th style="width: 100px;">Code</th>
                            <th style="min-width: 200px;">Repair Type</th>
                            <th style="min-width: 160px;">Defect Classification</th>
                            <th style="width: 140px;" class="text-center">Return To Originator</th>
                            <th style="width: 110px;" class="text-center">Total Steps</th>
                            <th style="min-width: 320px;">Applicable Process Flow</th>
                            <th style="width: 100px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span> Loading repair types...
                                </td>
                            </tr>
                        }
                        else if (!FilteredRepairTypes.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fas fa-tools fa-2x d-block mb-2 text-secondary opacity-50"></i>
                                    No repair types found matching your search.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var rt in FilteredRepairTypes)
                            {
                                <ContextMenuTrigger MenuId="rtContextMenu" Data="@rt" WrapperTag="tr" class="@(SelectedRepairType?.EntryID == rt.EntryID ? "table-primary" : "")" @onclick="() => SelectedRepairType = rt" @ondblclick="() => OpenEditModal(rt)">
                                    <td>
                                        <span class="badge bg-secondary font-monospace">@rt.RepairCode</span>
                                    </td>
                                    <td class="fw-bold text-dark">
                                        @rt.RepairType
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@rt.DefectType</span>
                                    </td>
                                    <td class="text-center">
                                        @if (rt.ReturnToOriginator)
                                        {
                                            <span class="badge bg-warning text-dark px-2">
                                                <i class="fas fa-undo-alt me-1"></i> Yes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border px-2">No</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary rounded-pill px-2">
                                            @rt.ProcessCount @(rt.ProcessCount == 1 ? "Process" : "Processes")
                                        </span>
                                    </td>
                                    <td class="text-muted" style="max-width: 400px; overflow: hidden; text-overflow: ellipsis;">
                                        @if (!string.IsNullOrWhiteSpace(rt.ProcessSummary))
                                        {
                                            <span class="small fw-semibold text-secondary">
                                                @rt.ProcessSummary
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small italic">No processes assigned</span>
                                        }
                                    </td>
                                    <td class="text-center" @onclick:stopPropagation="true">
                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                            <button type="button" class="btn btn-link btn-sm p-1 text-primary" title="Edit Repair Type" @onclick="() => OpenEditModal(rt)">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>
                                            <button type="button" class="btn btn-link btn-sm p-1 text-danger" title="Delete Repair Type" @onclick="() => PromptDeleteRepairType(rt)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </ContextMenuTrigger>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<!-- Context Menu with Win11Style -->
<ContextMenu Id="rtContextMenu" Template="Win11Style">
    <div class="win11-section-header">Repair Type Actions</div>
    <Item class="win11-menu-item" OnClick="@ContextNew">
        <i class="fas fa-plus-circle fa-fw win11-icon text-success"></i> New Repair Type
    </Item>
    <Item class="win11-menu-item" OnClick="@ContextEdit">
        <i class="fas fa-pencil-alt fa-fw win11-icon text-primary"></i> Edit Repair Type
    </Item>
    <div class="win11-divider"></div>
    <Item class="win11-menu-item" OnClick="@ContextPrint">
        <i class="fas fa-print fa-fw win11-icon text-dark"></i> Print Repair Types List
    </Item>
    <div class="win11-divider"></div>
    <Item class="win11-menu-item" OnClick="@ContextDelete">
        <i class="fas fa-trash fa-fw win11-icon text-danger"></i> Delete Repair Type
    </Item>
</ContextMenu>

<!-- Repair Type Modal Component -->
<RepairTypeModal IsOpen="ShowModal"
                 Model="ModelForEdit"
                 OnSaved="OnModalSaved"
                 OnClosed="OnModalClosed" />

<!-- Delete Confirmation Modal -->
@if (ShowDeleteModal && ItemToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.5); z-index: 100050; font-family: 'Calibri', 'Segoe UI', sans-serif;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
                <div class="modal-header bg-danger text-white py-2 px-3">
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i> Confirm Repair Type Deletion
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ShowDeleteModal = false"></button>
                </div>
                <div class="modal-body p-3">
                    <p class="mb-2">Are you sure you want to delete repair type <strong>@ItemToDelete.RepairType</strong> (Code: <strong>@ItemToDelete.RepairCode</strong>)?</p>
                    <div class="p-2 bg-light rounded border text-muted small">
                        <div><strong>Defect Type:</strong> @ItemToDelete.DefectType</div>
                        <div><strong>Configured Processes:</strong> @ItemToDelete.ProcessSummary</div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-3">
                    <button type="button" class="btn btn-sm btn-secondary fw-bold" @onclick="() => ShowDeleteModal = false" disabled="@IsDeleting">Cancel</button>
                    <button type="button" class="btn btn-sm btn-danger fw-bold px-3" @onclick="ConfirmDeleteRepairType" disabled="@IsDeleting">
                        @if (IsDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <i class="fas fa-trash me-1"></i>
                            <span>Delete Repair Type</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .blazor-context-menu {
        z-index: 100000 !important;
        max-height: 40vh !important;
        overflow-y: auto !important;
    }
</style>
