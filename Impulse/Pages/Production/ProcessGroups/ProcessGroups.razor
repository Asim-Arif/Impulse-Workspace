@page "/production/process-groups"
@using DataAccessLibrary.Models.ViewModels.Production
@using Impulse.Components.Production.ProcessGroups
@using BlazorContextMenu

<PageTitle>Process Hub Groups | Impulse ERP</PageTitle>
<meta name="description" content="Manufacturing hub grouping, sequential routings, and stages." />

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.87); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">

            <!-- ── Page Header & Top Actions ──────────────────────────── -->
            <div class="d-flex align-items-end pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:38px;height:38px;background:linear-gradient(135deg,#1565C0,#42A5F5);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-sitemap text-white" style="font-size:1.05rem;"></i>
                    </div>
                    <div>
                        <h1 class="mb-0 fw-bold" style="font-size:1.25rem;color:#1565C0;">Process Hub Groups</h1>
                        <small class="text-muted" style="font-size:0.75rem;">Manufacturing hub grouping, sequential routings, and stages</small>
                    </div>
                </div>

                <div class="ms-auto d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-success fw-bold px-3" @onclick="OpenCreateModal">
                        <i class="fas fa-plus-circle me-1"></i> New Process Group
                    </button>
                </div>
            </div>

            <!-- Instant Search Filter Bar -->
            <div class="row g-2 align-items-center mb-3">
                <div class="col-md-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                        <input type="text"
                               class="form-control"
                               placeholder="Search by group name or process step..."
                               @bind="SearchText"
                               @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-6 text-end text-muted small">
                    Showing <strong class="text-dark">@FilteredGroups.Count</strong> of <strong class="text-dark">@GroupsList.Count</strong> process groups
                </div>
            </div>

            <!-- Process Groups Master Grid -->
            <div class="table-responsive border rounded-3 mb-2" style="max-height: 58vh; overflow-y: auto;">
                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem; white-space: nowrap;">
                    <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                        <tr>
                            <th style="width: 70px;" class="text-center">Group No.</th>
                            <th style="min-width: 250px;">Group Description</th>
                            <th style="width: 110px;" class="text-center">Total Steps</th>
                            <th style="min-width: 350px;">Sequential Flow Preview</th>
                            <th style="width: 150px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span> Loading process groups...
                                </td>
                            </tr>
                        }
                        else if (!FilteredGroups.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fas fa-inbox fa-2x d-block mb-2 text-secondary opacity-50"></i>
                                    No process groups found matching your search.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int idx = 1;
                            @foreach (var g in FilteredGroups)
                            {
                                <ContextMenuTrigger MenuId="pgContextMenu" Data="@g" WrapperTag="tr" class="@(SelectedGroup?.EntryID == g.EntryID ? "table-primary" : "")" @onclick="() => SelectedGroup = g" @ondblclick="() => OpenEditModal(g)">
                                    <td class="text-center fw-bold text-muted">@(idx++)</td>
                                    <td class="fw-bold text-dark">
                                        <span class="badge bg-secondary me-2">ID: @g.EntryID</span>
                                        @g.GroupName
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary rounded-pill px-2">
                                            @g.ProcessCount @(g.ProcessCount == 1 ? "Step" : "Steps")
                                        </span>
                                    </td>
                                    <td class="text-muted" style="max-width: 450px; overflow: hidden; text-overflow: ellipsis;">
                                        @if (!string.IsNullOrWhiteSpace(g.FlowSummary))
                                        {
                                            <span class="small fw-semibold text-secondary">
                                                @g.FlowSummary
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small italic">No steps configured</span>
                                        }
                                    </td>
                                    <td class="text-center" @onclick:stopPropagation="true">
                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                            <button type="button" class="btn btn-link btn-sm p-1 text-primary" title="Edit Group" @onclick="() => OpenEditModal(g)">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>
                                            <button type="button" class="btn btn-link btn-sm p-1 text-info" title="Copy Group" @onclick="() => OpenCopyModal(g)">
                                                <i class="fas fa-copy"></i>
                                            </button>
                                            <button type="button" class="btn btn-link btn-sm p-1 text-success" title="Update All Linked Items" @onclick="() => PromptCascadeUpdate(g)">
                                                <i class="fas fa-sync-alt"></i>
                                            </button>
                                            <button type="button" class="btn btn-link btn-sm p-1 text-danger" title="Delete Group" @onclick="() => PromptDeleteGroup(g)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </ContextMenuTrigger>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<!-- Context Menu for Process Groups with Standard Win11Style Classes -->
<ContextMenu Id="pgContextMenu" Template="Win11Style">
    <div class="win11-section-header">Group Actions</div>
    <Item class="win11-menu-item" OnClick="@ContextNew">
        <i class="fas fa-plus-circle fa-fw win11-icon text-success"></i> New Group
    </Item>
    <Item class="win11-menu-item" OnClick="@ContextEdit">
        <i class="fas fa-pencil-alt fa-fw win11-icon text-primary"></i> Edit Group
    </Item>
    <Item class="win11-menu-item" OnClick="@ContextCopy">
        <i class="fas fa-copy fa-fw win11-icon text-info"></i> Copy Group
    </Item>
    <div class="win11-divider"></div>
    <Item class="win11-menu-item" OnClick="@ContextPrint">
        <i class="fas fa-print fa-fw win11-icon text-dark"></i> Print Assigned Items
    </Item>
    <Item class="win11-menu-item" OnClick="@ContextCascadeUpdate">
        <i class="fas fa-sync-alt fa-fw win11-icon text-warning"></i> Update All Linked Items
    </Item>
    <div class="win11-divider"></div>
    <Item class="win11-menu-item" OnClick="@ContextDelete">
        <i class="fas fa-trash fa-fw win11-icon text-danger"></i> Delete Group
    </Item>
</ContextMenu>

<!-- Process Group Modal Component -->
<ProcessGroupModal IsOpen="ShowGroupModal"
                   Group="GroupForEdit"
                   IsCopy="IsCopyMode"
                   OnSaved="OnGroupModalSaved"
                   OnClosed="OnGroupModalClosed" />

<!-- Cascade Update Confirmation Modal -->
@if (ShowCascadeModal && GroupForCascade != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.5); z-index: 100050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 14px;">
                <div class="modal-header bg-warning text-dark py-2 px-3">
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="fas fa-sync-alt me-2"></i> Update All Linked Items
                    </h6>
                    <button type="button" class="btn-close" @onclick="() => ShowCascadeModal = false"></button>
                </div>
                <div class="modal-body p-3">
                    <p class="mb-2">Are you sure you want to update all linked items with the latest process sequence from <strong>@GroupForCascade.GroupName</strong>?</p>
                    <div class="p-2 bg-light rounded border text-muted small">
                        <i class="fas fa-info-circle text-primary me-1"></i> This will sync the process rates, sequences, and scanning steps to all catalog items currently mapped to this process group.
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-3">
                    <button type="button" class="btn btn-sm btn-secondary fw-bold" @onclick="() => ShowCascadeModal = false" disabled="@IsCascading">Cancel</button>
                    <button type="button" class="btn btn-sm btn-warning fw-bold px-3 text-dark" @onclick="ConfirmCascadeUpdate" disabled="@IsCascading">
                        @if (IsCascading)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Updating...</span>
                        }
                        else
                        {
                            <i class="fas fa-check me-1"></i>
                            <span>Confirm &amp; Update</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (ShowDeleteModal && GroupToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.5); z-index: 100050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 14px;">
                <div class="modal-header bg-danger text-white py-2 px-3">
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i> Confirm Group Deletion
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ShowDeleteModal = false"></button>
                </div>
                <div class="modal-body p-3">
                    <p class="mb-2">Are you sure you want to delete process group <strong>@GroupToDelete.GroupName</strong> (ID: <strong>@GroupToDelete.EntryID</strong>)?</p>
                    <div class="p-2 bg-light rounded border text-muted small">
                        <div><strong>Configured Steps:</strong> @GroupToDelete.ProcessCount</div>
                        <div><strong>Sequence:</strong> @GroupToDelete.FlowSummary</div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-3">
                    <button type="button" class="btn btn-sm btn-secondary fw-bold" @onclick="() => ShowDeleteModal = false" disabled="@IsDeleting">Cancel</button>
                    <button type="button" class="btn btn-sm btn-danger fw-bold px-3" @onclick="ConfirmDeleteGroup" disabled="@IsDeleting">
                        @if (IsDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <i class="fas fa-trash me-1"></i>
                            <span>Delete Group</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .blazor-context-menu {
        z-index: 100000 !important;
        max-height: 40vh !important;
        overflow-y: auto !important;
    }
</style>
