@page "/production/issuance-deletion-approval"
@page "/production/issuance-deletion-approval/{pTaskId:int}"
@using DataAccessLibrary.Models.ViewModels.Production
@using Impulse.Services.WorkflowTasks
@attribute [Authorize]

<PageTitle>Impulse - Production Issuance Deletion Approvals</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <!-- Main Glassmorphism Card -->
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-4">

            <!-- Page Header -->
            <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger" style="width: 44px; height: 44px;">
                        <i class="fas fa-boxes-packing fs-4"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold text-dark">Production Issuance Deletion Approvals</h4>
                        <div class="text-muted small">Director Review &amp; Issuance / Master PO Deletion Queue</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (SelectedRequest != null)
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ClearSelection">
                            <i class="fas fa-arrow-left me-1"></i> Back to Queue
                        </button>
                    }
                    <a href="/production/maker-po-list" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-list-check me-1"></i> Maker PO List
                    </a>
                    <button class="btn btn-primary btn-sm" @onclick="LoadPendingRequestsAsync">
                        <i class="fas fa-sync-alt me-1 @(IsLoading ? "fa-spin" : "")"></i> Refresh
                    </button>
                </div>
            </div>

            <!-- Error Alerts -->
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-3 py-2 px-3 small rounded-3" role="alert">
                    <i class="fas fa-exclamation-circle me-2 fs-5"></i>
                    <div>@ErrorMessage</div>
                    <button type="button" class="btn-close ms-auto" @onclick="() => ErrorMessage = null"></button>
                </div>
            }

            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-danger" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="text-muted mt-2 small">Loading pending issuance deletion requests...</div>
                </div>
            }
            else if (SelectedRequest != null)
            {
                <!-- ================= DELETION DETAIL REVIEW VIEW ================= -->

                <!-- Status & Info Hero Banner -->
                <div class="p-3 mb-3 rounded-3 border" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-3">
                            <span class="text-muted small d-block">Order / Lot Number</span>
                            <span class="fw-bold fs-5 text-danger">#@(SelectedRequest.OrderNo ?? SelectedRequest.LotNo)</span>
                            <div class="text-secondary small">Lot No: <strong>@(string.IsNullOrWhiteSpace(SelectedRequest.LotNo) ? "-" : SelectedRequest.LotNo)</strong></div>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted small d-block">Item Details</span>
                            <span class="fw-semibold text-dark">
                                [@SelectedRequest.ItemCode] @SelectedRequest.ItemName
                            </span>
                            <div class="text-muted small">Process: <strong>@SelectedRequest.ProcessName</strong></div>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted small d-block">Requested By (Originator)</span>
                            <span class="fw-semibold text-dark">
                                <i class="fas fa-user-circle text-secondary me-1"></i>@SelectedRequest.RequestedBy
                            </span>
                            <div class="text-muted" style="font-size: 0.75rem;">@SelectedRequest.RequestedDT.ToString("dd-MMM-yyyy hh:mm tt")</div>
                        </div>
                        <div class="col-md-3 text-md-end">
                            <span class="text-muted small d-block">Status</span>
                            @if (SelectedRequest.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                    <i class="fas fa-clock me-1"></i> Pending Director Review
                                </span>
                            }
                            else if (SelectedRequest.Status == "Approved")
                            {
                                <span class="badge bg-success px-3 py-2 rounded-pill">
                                    <i class="fas fa-check-circle me-1"></i> Approved &amp; Deleted
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger px-3 py-2 rounded-pill">
                                    <i class="fas fa-times-circle me-1"></i> Rejected
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Comparison & Request Details -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="card border h-100 shadow-sm">
                            <div class="card-body p-3">
                                <h6 class="fw-bold text-secondary border-bottom pb-2 mb-3">
                                    <i class="fas fa-boxes-packing text-primary me-2"></i>Issuance Record Details
                                </h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-borderless mb-0 small">
                                        <tbody>
                                            <tr>
                                                <td class="text-muted" style="width: 40%;">Maker / Contractor:</td>
                                                <td class="fw-bold text-dark">@SelectedRequest.MakerName</td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Process:</td>
                                                <td class="fw-semibold">@SelectedRequest.ProcessName</td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Issued Quantity:</td>
                                                <td class="fw-bold text-success">@SelectedRequest.Qty.ToString("N0")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Issuance Entry ID:</td>
                                                <td class="font-monospace">@SelectedRequest.EntityRefID</td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Workstation:</td>
                                                <td>@(SelectedRequest.MachineName ?? "-")</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card border border-warning h-100 shadow-sm bg-warning bg-opacity-10">
                            <div class="card-body p-3">
                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                    <i class="fas fa-comment-alt text-warning me-2"></i>Originator's Deletion Reason
                                </h6>
                                <div class="p-3 bg-white rounded border text-dark" style="min-height: 80px; font-size: 0.95rem;">
                                    @SelectedRequest.Reason
                                </div>
                                <div class="text-muted small mt-2">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Approving this request will revert stock / S/F balances and delete the issuance record from <code>VendIssued</code>.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Director Actions & Remarks Panel -->
                @if (SelectedRequest.Status == "Pending")
                {
                    <div class="card border shadow-sm p-3 mb-3 bg-light">
                        <h6 class="fw-bold text-dark mb-2">
                            <i class="fas fa-shield-alt text-danger me-2"></i>Director Decision &amp; Remarks
                        </h6>
                        <div class="row g-2 align-items-center">
                            <div class="col-md-7">
                                <input type="text" class="form-control form-control-sm" placeholder="Add any approval notes or rejection reason..." @bind="DirectorRemarks" />
                            </div>
                            <div class="col-md-5 d-flex gap-2 justify-content-md-end">
                                <button class="btn btn-success btn-sm px-3 fw-bold" @onclick="ApproveRequestAsync" disabled="@IsProcessingAction">
                                    @if (IsProcessingAction)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-check-circle me-1"></i>
                                    }
                                    Approve &amp; Delete Issuance
                                </button>
                                <button class="btn btn-outline-danger btn-sm px-3" @onclick="RejectRequestAsync" disabled="@IsProcessingAction">
                                    <i class="fas fa-times-circle me-1"></i> Reject Request
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- ================= PENDING REQUESTS QUEUE TABLE ================= -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small">
                        Pending Issuance Deletion Requests: <span class="badge bg-danger rounded-pill">@PendingRequests.Count</span>
                    </span>
                </div>

                @if (!PendingRequests.Any())
                {
                    <div class="text-center py-5 border rounded-3 bg-light">
                        <i class="fas fa-check-double fs-1 text-success mb-3"></i>
                        <h5 class="fw-bold text-dark">Queue is Clean</h5>
                        <p class="text-muted small mb-0">There are no pending issuance deletion requests requiring Director review.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                            <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                <tr>
                                    <th>#</th>
                                    <th>Order / Lot No</th>
                                    <th>Item Details</th>
                                    <th>Process</th>
                                    <th>Maker / Contractor</th>
                                    <th class="text-end">Issued Qty</th>
                                    <th>Requested By</th>
                                    <th>Reason</th>
                                    <th>Requested DT</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int index = 1; }
                                @foreach (var req in PendingRequests)
                                {
                                    <tr>
                                        <td class="text-muted small">@(index++)</td>
                                        <td>
                                            <span class="badge bg-danger text-white">#@(req.OrderNo ?? req.LotNo)</span>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark">@req.ItemName</div>
                                            <div class="text-muted" style="font-size: 0.78rem;">Code: @req.ItemCode</div>
                                        </td>
                                        <td>@req.ProcessName</td>
                                        <td class="fw-semibold">@req.MakerName</td>
                                        <td class="text-end fw-bold text-success">@req.Qty.ToString("N0")</td>
                                        <td>
                                            <i class="fas fa-user-circle text-secondary me-1"></i>@req.RequestedBy
                                        </td>
                                        <td>
                                            <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@req.Reason">
                                                @req.Reason
                                            </span>
                                        </td>
                                        <td class="text-muted small">
                                            @req.RequestedDT.ToString("dd-MMM-yyyy hh:mm tt")
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-outline-danger btn-sm py-1 px-2" @onclick="() => SelectRequest(req)">
                                                <i class="fas fa-search me-1"></i> Review
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

        </div>
    </div>
</div>
