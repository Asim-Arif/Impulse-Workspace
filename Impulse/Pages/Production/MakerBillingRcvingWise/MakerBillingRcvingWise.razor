@page "/production/maker-billing"
@page "/production/maker-billing-rcving-wise"
@using DataAccessLibrary.Models.ViewModels.Production
@using Impulse.Components.Production.MakerBilling
@using Blazored.Typeahead

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: #ffffff; border-radius: 12px;">
        <div class="card-body p-3">

            <!-- Page Header & Global Actions -->
            <div class="d-flex align-items-end justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3">
                        <i class="fas fa-file-invoice-dollar fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark" style="font-size: 1.35rem;">Maker Billing</h4>
                        <div class="text-muted small">Receiving-wise vendor billing, repair & material deductions, loan clearances, and voucher posting</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-dark fw-bold" @onclick="PrintAllMakersSummary">
                        <i class="fas fa-print me-1"></i> Print All Makers
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-info fw-bold" @onclick="PrintUnPostedBills">
                        <i class="fas fa-file-invoice me-1"></i> Print Un-Posted
                    </button>
                    <button type="button" class="btn btn-sm btn-success fw-bold px-4" @onclick="PostMakerBill" disabled="@(!Lots.Any(x => x.IsSelected) || IsPosting)">
                        @if (IsPosting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Posting Bill...</span>
                        }
                        else
                        {
                            <i class="fas fa-check-circle me-1"></i>
                            <span>Post Maker Bill</span>
                        }
                    </button>
                </div>
            </div>

            <!-- Filter Controls Panel -->
            <div class="p-3 bg-light rounded-3 border mb-3">
                <!-- Row 1: Core Lookups -->
                <div class="row g-2 align-items-end mb-2">
                    <!-- Maker Selector -->
                    <div class="col-md-4">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                            <i class="fas fa-industry text-primary me-1"></i> Maker / Vendor <span class="text-danger">*</span>
                        </label>
                        <div class="custom-typeahead-container">
                            <BlazoredTypeahead SearchMethod="SearchMakers"
                                               TValue="LookupItemInt"
                                               TItem="LookupItemInt"
                                               Value="SelectedMaker"
                                               ValueChanged="OnMakerChanged"
                                               ValueExpression="@(() => SelectedMaker)"
                                               Placeholder="Select Maker..."
                                               EnableDropDown="true"
                                               MaximumSuggestions="1000">
                                <SelectedTemplate Context="maker">
                                    @maker.Name
                                </SelectedTemplate>
                                <ResultTemplate Context="maker">
                                    @maker.Name
                                </ResultTemplate>
                                <NotFoundTemplate Context="searchText">
                                    <span class="text-muted small">No makers matching "@searchText"</span>
                                </NotFoundTemplate>
                            </BlazoredTypeahead>
                        </div>
                    </div>

                    <!-- Debit Head Selector -->
                    <div class="col-md-4">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                            <i class="fas fa-book text-primary me-1"></i> Debit Head (Account) <span class="text-danger">*</span>
                        </label>
                        <div class="custom-typeahead-container">
                            <BlazoredTypeahead SearchMethod="SearchDebitHeads"
                                               TValue="LookupItemString"
                                               TItem="LookupItemString"
                                               Value="SelectedDebitHead"
                                               ValueChanged="OnDebitHeadChanged"
                                               ValueExpression="@(() => SelectedDebitHead)"
                                               Placeholder="Select Debit Head..."
                                               EnableDropDown="true"
                                               MaximumSuggestions="1000">
                                <SelectedTemplate Context="head">
                                    @head.Name
                                </SelectedTemplate>
                                <ResultTemplate Context="head">
                                    @head.Name
                                </ResultTemplate>
                                <NotFoundTemplate Context="searchText">
                                    <span class="text-muted small">No debit accounts matching "@searchText"</span>
                                </NotFoundTemplate>
                            </BlazoredTypeahead>
                        </div>
                    </div>

                    <!-- Category Filter -->
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Category</label>
                        <select class="form-select form-select-sm" @bind="Filter.CatIDs" @bind:after="LoadAllDataAsync">
                            @foreach (var cat in Lookups.Categories)
                            {
                                <option value="@cat.Id.ToString()">@cat.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Master PO # Search -->
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Master PO #</label>
                        <input type="text" class="form-control form-control-sm text-center fw-bold" placeholder="PO #..." @bind="Filter.MasterPONo" @bind:after="LoadAllDataAsync" />
                    </div>
                </div>

                <!-- Row 2: Date & Posting Settings -->
                <div class="row g-2 align-items-end">
                    <!-- Date Range Preset -->
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                            <i class="fas fa-calendar-alt text-primary me-1"></i> Range
                        </label>
                        <select class="form-select form-select-sm" @bind="Filter.DateRangeIndex" @bind:after="OnDateRangeChanged">
                            <option value="0">Today</option>
                            <option value="1">Last 7 Days</option>
                            <option value="2">Last 15 Days</option>
                            <option value="3">Last 30 Days</option>
                            <option value="4">Last 60 Days</option>
                            <option value="5">Last 90 Days</option>
                            <option value="6">Last 1 Year</option>
                            <option value="7">Last 5 Years</option>
                            <option value="8">Custom Range</option>
                        </select>
                    </div>

                    <!-- From Date -->
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">From Date</label>
                        <input type="date" class="form-control form-control-sm" @bind="Filter.DtFrom" @bind:after="LoadAllDataAsync" disabled="@(Filter.DateRangeIndex != 8)" />
                    </div>

                    <!-- To Date -->
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">To Date</label>
                        <input type="date" class="form-control form-control-sm" @bind="Filter.DtTo" @bind:after="LoadAllDataAsync" disabled="@(Filter.DateRangeIndex != 8)" />
                    </div>

                    <!-- Posting Date -->
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-primary">Posting Date</label>
                        <input type="date" class="form-control form-control-sm border-primary fw-bold" @bind="Filter.PostingDate" />
                    </div>

                    <!-- Show Picture & Refresh -->
                    <div class="col-md-4 d-flex align-items-center gap-3">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="chkPic" @bind="Filter.ShowPicture" />
                            <label class="form-check-label fw-bold text-secondary small" for="chkPic">
                                Show Pictures
                            </label>
                        </div>

                        <button type="button" class="btn btn-sm btn-primary flex-grow-1 fw-bold" @onclick="LoadAllDataAsync" disabled="@IsLoading">
                            @if (IsLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>Loading...</span>
                            }
                            else
                            {
                                <i class="fas fa-sync-alt me-1"></i>
                                <span>Refresh</span>
                            }
                        </button>
                    </div>
                </div>
            </div>

            <!-- Material Design 3 Tabs Navigation -->
            <ul class="nav nav-tabs nav-fill mb-3" style="font-size: 0.9rem; font-weight: 600;">
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == 0 ? "active text-primary fw-bold border-bottom-0" : "text-secondary")" @onclick="() => SetTab(0)">
                        <i class="fas fa-file-invoice-dollar me-1"></i> Maker Billing
                        <span class="badge @(ActiveTab == 0 ? "bg-primary" : "bg-secondary") ms-1">@Lots.Count</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == 1 ? "active text-primary fw-bold border-bottom-0" : "text-secondary")" @onclick="() => SetTab(1)">
                        <i class="fas fa-tools me-1"></i> Repair Wastage Details
                        <span class="badge @(ActiveTab == 1 ? "bg-primary" : "bg-secondary") ms-1">@RepairItems.Count</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == 2 ? "active text-primary fw-bold border-bottom-0" : "text-secondary")" @onclick="() => SetTab(2)">
                        <i class="fas fa-cubes me-1"></i> Material Deductions
                        <span class="badge @(ActiveTab == 2 ? "bg-primary" : "bg-secondary") ms-1">@MaterialDedItems.Count</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == 3 ? "active text-primary fw-bold border-bottom-0" : "text-secondary")" @onclick="() => SetTab(3)">
                        <i class="fas fa-calculator me-1"></i> Manual Deductions
                        <span class="badge @(ActiveTab == 3 ? "bg-primary" : "bg-secondary") ms-1">@ManualDedItems.Count</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == 4 ? "active text-primary fw-bold border-bottom-0" : "text-secondary")" @onclick="() => SetTab(4)">
                        <i class="fas fa-eye-slash me-1"></i> Hidden Lots
                        <span class="badge @(ActiveTab == 4 ? "bg-primary" : "bg-secondary") ms-1">@HiddenLots.Count</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == 5 ? "active text-primary fw-bold border-bottom-0" : "text-secondary")" @onclick="() => SetTab(5)">
                        <i class="fas fa-box-open me-1"></i> RM Hidden
                        <span class="badge @(ActiveTab == 5 ? "bg-primary" : "bg-secondary") ms-1">@HiddenRMItems.Count</span>
                    </button>
                </li>
            </ul>

            <!-- Active Tab Content Area -->
            <div class="tab-content">
                @if (ActiveTab == 0)
                {
                    <MakerBillingTab Lots="@Lots"
                                     IsLoading="@IsLoading"
                                     ShowPicture="@Filter.ShowPicture"
                                     RejectionRelaxation="@Filter.RejectionRelaxation"
                                     ShortTermDeduction="@ShortTermDeduction"
                                     ShortTermDeductionChanged="val => ShortTermDeduction = val"
                                     LongTermDeduction="@LongTermDeduction"
                                     LongTermDeductionChanged="val => LongTermDeduction = val"
                                     RepairAmount="@CalculatedRepairAmount"
                                     MaterialDeductionAmount="@CalculatedMaterialDeductionAmount"
                                     ManualDeductionAmount="@CalculatedManualDeductionAmount"
                                     OnStateUpdated="@StateHasChanged"
                                     OnHideLot="@HandleHideLot"
                                     OnPrintPTC="@HandlePrintPTC" />
                }
                else if (ActiveTab == 1)
                {
                    <RepairWastageTab Items="@RepairItems"
                                      IsLoading="@IsLoading"
                                      OnRepairAmountChanged="amt => { StateHasChanged(); }" />
                }
                else if (ActiveTab == 2)
                {
                    <MaterialDeductionsTab Items="@MaterialDedItems"
                                           IsLoading="@IsLoading"
                                           OnMaterialAmountChanged="amt => { StateHasChanged(); }"
                                           OnHideRM="@HandleHideRM"
                                           OnPrintReport="@PrintMaterialDeductionsReport" />
                }
                else if (ActiveTab == 3)
                {
                    <ManualDeductionsTab Items="@ManualDedItems"
                                         OnManualAmountChanged="amt => { StateHasChanged(); }" />
                }
                else if (ActiveTab == 4)
                {
                    <HiddenLotsTab Items="@HiddenLots"
                                   IsLoading="@IsLoading"
                                   OnLotRestored="@LoadAllDataAsync"
                                   OnPrintPTC="@HandlePrintPTCFromHidden" />
                }
                else if (ActiveTab == 5)
                {
                    <HiddenRMTab Items="@HiddenRMItems"
                                 IsLoading="@IsLoading"
                                 OnRMRestored="@LoadAllDataAsync" />
                }
            </div>

        </div>
    </div>
</div>

<style>
    .blazored-typeahead {
        height: 35px !important;
        font-size: 0.875rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
        border-radius: 6px !important;
    }
    .blazored-typeahead__input, .blazored-typeahead__controls {
        height: 33px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input-mask, .blazored-typeahead__input-mask-wrapper {
        height: 33px !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
    }
    .blazored-typeahead__results {
        z-index: 10000 !important;
    }
</style>
