@page "/production/processes"
@using DataAccessLibrary.Models.ViewModels.Production
@using Impulse.Components.Production.Processes
@using Blazored.Typeahead
@using BlazorContextMenu

<PageTitle>Production Processes | Impulse ERP</PageTitle>
<meta name="description" content="Setup manufacturing sequences, stages, and quality inspection points." />

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.87); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">

            <!-- ── Page Header & Top Actions ──────────────────────────── -->
            <div class="d-flex align-items-end pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:38px;height:38px;background:linear-gradient(135deg,#1565C0,#42A5F5);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-cogs text-white" style="font-size:1.05rem;"></i>
                    </div>
                    <div>
                        <h1 class="mb-0 fw-bold" style="font-size:1.25rem;color:#1565C0;">Production Processes</h1>
                        <small class="text-muted" style="font-size:0.75rem;">Configuration of manufacturing operations, contractors, authorization, and quality inspection criteria</small>
                    </div>
                </div>

                <div class="ms-auto d-flex align-items-center gap-2">
                    <span class="badge bg-light text-secondary border" style="font-size:0.75rem;">@ProcessesList.Count records</span>
                    <button type="button" class="btn btn-sm btn-outline-dark fw-bold" @onclick="PrintProcessReport" disabled="@(!ProcessesList.Any())">
                        <i class="fas fa-print me-1"></i> Print Processes List
                    </button>
                    @if (IsEditing)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary fw-bold" @onclick="ResetForm">
                            <i class="fas fa-times me-1"></i> Cancel Edit
                        </button>
                    }
                </div>
            </div>

            <!-- Master Entry / Edit Form Card -->
            <div class="p-3 bg-light rounded-3 border mb-3">
                <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                    <span class="fw-bold text-secondary small text-uppercase">
                        <i class="fas @(IsEditing ? "fa-pencil-alt text-warning" : "fa-plus-circle text-primary") me-1"></i>
                        @(IsEditing ? $"Edit Process: {CurrentProcess.Description} [{CurrentProcess.Code}]" : "Create New Manufacturing Process")
                    </span>
                    @if (IsEditing)
                    {
                        <span class="badge bg-warning text-dark fw-semibold">
                            <i class="fas fa-info-circle me-1"></i> Editing Mode (ID: @CurrentProcess.ProcessID)
                        </span>
                    }
                </div>

                <div class="row g-2">
                    <!-- Process Code -->
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                            Process Code <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control form-control-sm text-uppercase fw-bold"
                               placeholder="e.g. CUT, STITCH"
                               @bind="CurrentProcess.Code" />
                    </div>

                    <!-- Process Name (English) -->
                    <div class="col-md-5">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                            Process Name (English) <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control form-control-sm fw-bold"
                               placeholder="Primary process description..."
                               @bind="CurrentProcess.Description" />
                    </div>

                    <!-- Process Detailed Description / Supervisor -->
                    <div class="col-md-5">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                            Detailed Description / Supervisor
                        </label>
                        <input type="text"
                               class="form-control form-control-sm"
                               placeholder="Detailed notes or supervisor assignment..."
                               @bind="CurrentProcess.Supervisor" />
                    </div>

                    <!-- Operation Scope -->
                    <div class="col-md-3">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                            Operation Scope <span class="text-danger">*</span>
                        </label>
                        <select class="form-select form-select-sm" @bind="CurrentProcess.Operation" @bind:after="OnOperationChanged">
                            <option value="0">Employee (Internal)</option>
                            <option value="1">Contractor (Outsourced)</option>
                            <option value="2">Both (Internal &amp; Outsourced)</option>
                        </select>
                    </div>

                    <!-- Authorization Required -->
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                            Auth. Required <span class="text-danger">*</span>
                        </label>
                        <select class="form-select form-select-sm" @bind="CurrentProcess.AuthRequired" @bind:after="OnAuthRequiredChanged">
                            <option value="0">No</option>
                            <option value="1">Yes</option>
                        </select>
                    </div>

                    <!-- Fix Contractor (Maker) -->
                    <div class="col-md-4">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                            <i class="fas fa-industry text-primary me-1"></i> Fixed Contractor / Maker
                        </label>
                        <div class="custom-typeahead-container @(CurrentProcess.Operation == 0 ? "disabled-typeahead-wrapper" : "")">
                            <BlazoredTypeahead SearchMethod="SearchMakers"
                                               TValue="LookupItemInt"
                                               TItem="LookupItemInt"
                                               Value="SelectedMaker"
                                               ValueChanged="OnMakerSelected"
                                               ValueExpression="@(() => SelectedMaker)"
                                               Placeholder="@(CurrentProcess.Operation == 0 ? "Not applicable for internal process" : "Select fixed contractor...")"
                                               Disabled="@(CurrentProcess.Operation == 0)"
                                               EnableDropDown="true"
                                               MaximumSuggestions="1000">
                                <SelectedTemplate Context="maker">
                                    @maker.Name
                                </SelectedTemplate>
                                <ResultTemplate Context="maker">
                                    @maker.Name
                                </ResultTemplate>
                                <NotFoundTemplate Context="searchText">
                                    <span class="text-muted small">No makers matching "@searchText"</span>
                                </NotFoundTemplate>
                            </BlazoredTypeahead>
                        </div>
                    </div>

                    <!-- Inspection Process -->
                    <div class="col-md-3">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                            <i class="fas fa-clipboard-check text-info me-1"></i> Inspection Process
                        </label>
                        <div class="custom-typeahead-container @(CurrentProcess.AuthRequired == 0 ? "disabled-typeahead-wrapper" : "")">
                            <BlazoredTypeahead SearchMethod="SearchInspectionProcesses"
                                               TValue="LookupItemInt"
                                               TItem="LookupItemInt"
                                               Value="SelectedInspectionProcess"
                                               ValueChanged="OnInspectionProcessSelected"
                                               ValueExpression="@(() => SelectedInspectionProcess)"
                                               Placeholder="@(CurrentProcess.AuthRequired == 0 ? "Disabled (Auth not required)" : "Select inspection...")"
                                               Disabled="@(CurrentProcess.AuthRequired == 0)"
                                               EnableDropDown="true"
                                               MaximumSuggestions="1000">
                                <SelectedTemplate Context="insp">
                                    @insp.Name
                                </SelectedTemplate>
                                <ResultTemplate Context="insp">
                                    @insp.Name
                                </ResultTemplate>
                                <NotFoundTemplate Context="searchText">
                                    <span class="text-muted small">No inspections matching "@searchText"</span>
                                </NotFoundTemplate>
                            </BlazoredTypeahead>
                        </div>
                    </div>

                    <!-- Billing Process -->
                    <div class="col-md-4">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                            <i class="fas fa-file-invoice text-success me-1"></i> Billing Process
                        </label>
                        <div class="custom-typeahead-container">
                            <BlazoredTypeahead SearchMethod="SearchBillingProcesses"
                                               TValue="LookupItemInt"
                                               TItem="LookupItemInt"
                                               Value="SelectedBillingProcess"
                                               ValueChanged="OnBillingProcessSelected"
                                               ValueExpression="@(() => SelectedBillingProcess)"
                                               Placeholder="Select billing process..."
                                               EnableDropDown="true"
                                               MaximumSuggestions="1000">
                                <SelectedTemplate Context="bp">
                                    @bp.Name
                                </SelectedTemplate>
                                <ResultTemplate Context="bp">
                                    @bp.Name
                                </ResultTemplate>
                                <NotFoundTemplate Context="searchText">
                                    <span class="text-muted small">No processes matching "@searchText"</span>
                                </NotFoundTemplate>
                            </BlazoredTypeahead>
                        </div>
                    </div>

                    <!-- Urdu Process Title -->
                    <div class="col-md-4">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary d-flex justify-content-between">
                            <span>Urdu Process Title</span>
                            <span dir="rtl" class="text-muted small">پروسیس کا نام</span>
                        </label>
                        <input type="text"
                               dir="rtl"
                               class="form-control form-control-sm text-end fw-bold"
                               style="font-family: 'Jameel Noori Nastaleeq', 'Urdu Typesetting', Tahoma, sans-serif;"
                               placeholder="اردو نام..."
                               @bind="CurrentProcess.ProcessNameUrdu" />
                    </div>

                    <!-- Urdu Process Description -->
                    <div class="col-md-4">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary d-flex justify-content-between">
                            <span>Urdu Description</span>
                            <span dir="rtl" class="text-muted small">تفصیل</span>
                        </label>
                        <input type="text"
                               dir="rtl"
                               class="form-control form-control-sm text-end"
                               style="font-family: 'Jameel Noori Nastaleeq', 'Urdu Typesetting', Tahoma, sans-serif;"
                               placeholder="اردو تفصیل..."
                               @bind="CurrentProcess.ProcessNameUrduOther" />
                    </div>
                </div>

                <!-- Form Action Buttons -->
                <div class="d-flex align-items-center justify-content-end gap-2 mt-3 pt-2 border-top">
                    <button type="button" class="btn btn-sm btn-secondary fw-bold" @onclick="ResetForm" disabled="@IsSaving">
                        <i class="fas fa-undo me-1"></i> Clear
                    </button>
                    <button type="button" class="btn btn-sm btn-primary fw-bold px-4" @onclick="SaveProcessAsync" disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="fas @(IsEditing ? "fa-check" : "fa-save") me-1"></i>
                            <span>@(IsEditing ? "Update Process" : "Save Process")</span>
                        }
                    </button>
                </div>
            </div>

            <!-- Instant Search Filter & Urdu Toggle -->
            <div class="row g-2 align-items-center mb-3">
                <div class="col-md-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                        <input type="text"
                               class="form-control"
                               placeholder="Search processes by code, English name, or Urdu title..."
                               @bind="SearchText"
                               @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-center justify-content-end gap-3">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="chkUrdu" @bind="ShowUrduDescription" />
                        <label class="form-check-label fw-bold text-secondary small" for="chkUrdu">
                            Show Urdu Description (اردو نام)
                        </label>
                    </div>
                    <span class="text-muted small">
                        Showing <strong class="text-dark">@FilteredProcesses.Count</strong> of <strong class="text-dark">@ProcessesList.Count</strong> processes
                    </span>
                </div>
            </div>

            <!-- Master Processes Grid -->
            <div class="table-responsive border rounded-3 mb-2" style="max-height: 55vh; overflow-y: auto;">
                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem; white-space: nowrap;">
                    <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                        <tr>
                            <th style="width: 100px;">Code</th>
                            <th style="min-width: 220px;">@(ShowUrduDescription ? "پروسیس کا نام (Urdu Name)" : "Process Name")</th>
                            <th style="min-width: 200px;">Detailed Description</th>
                            <th style="width: 130px;" class="text-center">Operation</th>
                            <th style="min-width: 180px;">Fix Contractor</th>
                            <th style="width: 100px;" class="text-center">Auth. Req.</th>
                            <th style="min-width: 180px;">Insp. Process</th>
                            <th style="width: 120px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span> Loading processes...
                                </td>
                            </tr>
                        }
                        else if (!FilteredProcesses.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="fas fa-inbox fa-2x d-block mb-2 text-secondary opacity-50"></i>
                                    No processes found matching the search criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var proc in FilteredProcesses)
                            {
                                <ContextMenuTrigger MenuId="processContextMenu" Data="@proc" WrapperTag="tr" class="@(CurrentProcess.ProcessID == proc.ProcessID ? "table-primary" : "")" @ondblclick="() => EditProcess(proc)">
                                    <td>
                                        <span class="badge px-2 py-1" style="background-color: #2196F3; color: #ffffff; font-weight: 700; border-radius: 4px;">
                                            @proc.Code
                                        </span>
                                    </td>
                                    <td class="fw-bold text-dark">
                                        @if (ShowUrduDescription && !string.IsNullOrWhiteSpace(proc.ProcessNameUrdu))
                                        {
                                            <span dir="rtl" class="fs-6" style="font-family: 'Jameel Noori Nastaleeq', 'Urdu Typesetting', Tahoma, sans-serif;">
                                                @proc.ProcessNameUrdu
                                            </span>
                                        }
                                        else
                                        {
                                            <span>@proc.Description</span>
                                        }
                                    </td>
                                    <td class="text-muted">@proc.Supervisor</td>
                                    <td class="text-center">
                                        @if (proc.Operation == 0)
                                        {
                                            <span class="badge bg-primary px-2">Employee</span>
                                        }
                                        else if (proc.Operation == 1)
                                        {
                                            <span class="badge bg-warning text-dark px-2">Contractor</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark px-2">Both</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(proc.VenderName))
                                        {
                                            <span class="fw-semibold text-secondary">
                                                <i class="fas fa-user-tag text-muted me-1"></i>@proc.VenderName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">&mdash;</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (proc.IsAuthRequired)
                                        {
                                            <span class="badge bg-success px-2">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border px-2">No</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(proc.Insp_ProcessName))
                                        {
                                            <span class="text-dark small">
                                                <span class="badge bg-secondary me-1">@proc.Insp_Code</span>
                                                @proc.Insp_ProcessName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">&mdash;</span>
                                        }
                                    </td>
                                    <td class="text-center" @onclick:stopPropagation="true">
                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                            <button type="button" class="btn btn-link btn-sm p-1 text-primary" title="Edit Process" @onclick="() => EditProcess(proc)">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>
                                            <button type="button" class="btn btn-link btn-sm p-1 text-info" title="Inspection Points" @onclick="() => OpenInspectionPoints(proc)">
                                                <i class="fas fa-clipboard-check"></i>
                                            </button>
                                            <button type="button" class="btn btn-link btn-sm p-1 text-danger" title="Delete Process" @onclick="() => PromptDeleteProcess(proc)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </ContextMenuTrigger>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<!-- Context Menu for Processes with Standard Win11Style Classes -->
<ContextMenu Id="processContextMenu" Template="Win11Style">
    <div class="win11-section-header">Process Actions</div>
    <Item class="win11-menu-item" OnClick="@ContextEdit">
        <i class="fas fa-pencil-alt fa-fw win11-icon text-primary"></i> Edit Process
    </Item>
    <Item class="win11-menu-item" OnClick="@ContextInspectionPoints">
        <i class="fas fa-clipboard-check fa-fw win11-icon text-info"></i> Inspection Points
    </Item>
    <div class="win11-divider"></div>
    <Item class="win11-menu-item" OnClick="@ContextDelete">
        <i class="fas fa-trash fa-fw win11-icon text-danger"></i> Delete Process
    </Item>
</ContextMenu>

<!-- Inspection Points Modal Component -->
<InspectionPointsModal IsOpen="ShowInspectionModal" Process="SelectedProcessForInspection" OnClosed="OnInspectionModalClosed" />

<!-- Delete Confirmation Modal -->
@if (ShowDeleteModal && ProcessToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.5); z-index: 100050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 14px;">
                <div class="modal-header bg-danger text-white py-2 px-3">
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i> Confirm Process Deletion
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ShowDeleteModal = false"></button>
                </div>
                <div class="modal-body p-3">
                    <p class="mb-2">Are you sure you want to delete process <strong>@ProcessToDelete.Description</strong> (Code: <strong>@ProcessToDelete.Code</strong>)?</p>
                    <div class="p-2 bg-light rounded border text-muted small">
                        <div><strong>Process ID:</strong> @ProcessToDelete.ProcessID</div>
                        <div><strong>Operation:</strong> @ProcessToDelete.OperationName</div>
                        <div><strong>Supervisor:</strong> @ProcessToDelete.Supervisor</div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-3">
                    <button type="button" class="btn btn-sm btn-secondary fw-bold" @onclick="() => ShowDeleteModal = false" disabled="@IsDeleting">Cancel</button>
                    <button type="button" class="btn btn-sm btn-danger fw-bold px-3" @onclick="ConfirmDeleteProcess" disabled="@IsDeleting">
                        @if (IsDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <i class="fas fa-trash me-1"></i>
                            <span>Delete Process</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .blazor-context-menu {
        z-index: 100000 !important;
        max-height: 40vh !important;
        overflow-y: auto !important;
    }
</style>
