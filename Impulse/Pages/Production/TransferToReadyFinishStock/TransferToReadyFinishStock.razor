@page "/production/transfer-to-ready-finish-stock"
@using DataAccessLibrary.Models.ViewModels.Production
@using Impulse.Services.Production
@using Blazored.Typeahead
@using BlazorContextMenu

<PageTitle>Transfer to Ready Finish Stock | Impulse ERP</PageTitle>
<meta name="description" content="Move completed manufacturing lots to warehouse finished goods." />

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.87); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">

            <!-- ── Page Header & Top Actions ──────────────────────────── -->
            <div class="d-flex align-items-end pb-2 mb-3 border-bottom flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:38px;height:38px;background:linear-gradient(135deg,#1565C0,#42A5F5);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-dolly text-white" style="font-size:1.05rem;"></i>
                    </div>
                    <div>
                        <h1 class="mb-0 fw-bold" style="font-size:1.25rem;color:#1565C0;">Transfer to Ready Finish Stock</h1>
                        <small class="text-muted" style="font-size:0.75rem;">Move completed manufacturing lots to warehouse finished goods</small>
                    </div>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-primary fw-bold" @onclick="LoadDataAsync" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        else
                        {
                            <i class="fas fa-sync-alt me-1"></i>
                        }
                        Refresh
                    </button>
                </div>
            </div>

            <!-- Filter Controls Panel -->
            <div class="row g-2 align-items-end mb-3 p-3 bg-light rounded-3 border">
                <!-- Maker Selector -->
                <div class="col-md-3">
                    <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                        <i class="fas fa-user-tag text-primary me-1"></i> Maker / Vendor
                    </label>
                    <div class="custom-typeahead-container">
                        <BlazoredTypeahead SearchMethod="SearchMakers"
                                           TValue="LookupItemInt"
                                           TItem="LookupItemInt"
                                           Value="SelectedMaker"
                                           ValueChanged="OnMakerChanged"
                                           ValueExpression="@(() => SelectedMaker)"
                                           Placeholder="Select Maker..."
                                           EnableDropDown="true"
                                           MaximumSuggestions="1000">
                            <SelectedTemplate Context="mkr">
                                @mkr.Name
                            </SelectedTemplate>
                            <ResultTemplate Context="mkr">
                                @mkr.Name
                            </ResultTemplate>
                            <NotFoundTemplate Context="searchText">
                                <span class="text-muted small">No makers found matching "@searchText"</span>
                            </NotFoundTemplate>
                        </BlazoredTypeahead>
                    </div>
                </div>

                <!-- Date Range Selector -->
                <div class="col-md-2">
                    <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Date Range</label>
                    <select class="form-select form-select-sm" @bind="Filter.DateRangeIndex" @bind:after="OnDateRangeChanged">
                        <option value="0">Today</option>
                        <option value="1">Last 15 Days</option>
                        <option value="2">Last 30 Days</option>
                        <option value="3">Last 60 Days</option>
                        <option value="4">Last 90 Days</option>
                        <option value="5">Custom Range</option>
                    </select>
                </div>

                <!-- Date Pickers (visible if custom range) -->
                @if (Filter.DateRangeIndex == 5)
                {
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">From Date</label>
                        <input type="date" class="form-control form-control-sm" @bind="Filter.DtFrom" @bind:after="LoadDataAsync" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm mb-1 fw-bold text-secondary">To Date</label>
                        <input type="date" class="form-control form-control-sm" @bind="Filter.DtTo" @bind:after="LoadDataAsync" />
                    </div>
                }

                <!-- Article / Item Selector -->
                <div class="col-md-3">
                    <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                        <i class="fas fa-box-open text-primary me-1"></i> Article / Item
                    </label>
                    <div class="custom-typeahead-container">
                        <BlazoredTypeahead SearchMethod="SearchArticles"
                                           TValue="LookupItemString"
                                           TItem="LookupItemString"
                                           Value="SelectedArticle"
                                           ValueChanged="OnArticleChanged"
                                           ValueExpression="@(() => SelectedArticle)"
                                           Placeholder="Select Article..."
                                           EnableDropDown="true"
                                           MaximumSuggestions="1000">
                            <SelectedTemplate Context="art">
                                @art.Name
                            </SelectedTemplate>
                            <ResultTemplate Context="art">
                                @art.Name
                            </ResultTemplate>
                            <NotFoundTemplate Context="searchText">
                                <span class="text-muted small">No items matching "@searchText"</span>
                            </NotFoundTemplate>
                        </BlazoredTypeahead>
                    </div>
                </div>

                <!-- Lot No Search -->
                <div class="col-md-2">
                    <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Lot #</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control form-control-sm text-center" @bind="Filter.LotNo" @onkeydown="OnLotNoKeyDown" placeholder="Search Lot #..." />
                        <button class="btn btn-outline-secondary" type="button" @onclick="LoadDataAsync">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- MAIN DATA GRID -->
            <div class="card border mb-3 rounded-3 shadow-none">
                <div class="table-responsive" style="max-height: 52vh; overflow-y: auto;">
                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                            <tr>
                                <th style="width: 40px;" class="text-center">
                                    <input class="form-check-input" type="checkbox" checked="@IsAllSelected" @onchange="ToggleSelectAll" />
                                </th>
                                <th style="width: 45px;">#</th>
                                <th>Maker</th>
                                <th style="width: 130px;">Receiving #</th>
                                <th style="width: 110px;">Date</th>
                                <th>Process</th>
                                <th>Article</th>
                                <th class="text-center" style="width: 100px;">Avail Qty</th>
                                <th class="text-center" style="width: 120px;">Transfer Qty</th>
                                <th class="text-center" style="width: 100px;">Lot #</th>
                                <th style="width: 100px;">Batch #</th>
                                <th style="width: 110px;">Mill Cert #</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (IsLoading)
                            {
                                <tr>
                                    <td colspan="12" class="text-center py-4 text-muted">
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span> Loading ready finish lots...
                                    </td>
                                </tr>
                            }
                            else if (!AvailableLots.Any())
                            {
                                <tr>
                                    <td colspan="12" class="text-center py-4 text-muted">
                                        <i class="fas fa-info-circle me-1"></i> No completed receiving lots found matching your filter criteria.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int idx = 1;
                                @foreach (var item in AvailableLots)
                                {
                                    <ContextMenuTrigger MenuId="rowContextMenu" Data="@item" WrapperTag="tr" class="@(item.IsSelected ? "table-primary table-active" : "")">
                                        <td class="text-center" @onclick:stopPropagation="true">
                                            <input class="form-check-input" type="checkbox" @bind="item.IsSelected" @bind:after="OnSelectionChanged" />
                                        </td>
                                        <td>@(idx++)</td>
                                        <td class="fw-semibold text-dark">@item.DisplayMaker</td>
                                        <td><span class="badge bg-secondary">@item.RecieptID</span></td>
                                        <td>@item.DT.ToString("dd-MMM-yyyy")</td>
                                        <td><span class="badge bg-info text-dark">@item.Description</span></td>
                                        <td>@item.FullArticle</td>
                                        <td class="text-center fw-bold text-success">@item.AvailQty.ToString("N0")</td>
                                        <td class="text-center" @onclick:stopPropagation="true">
                                            <input type="number" class="form-control form-control-sm text-center py-0"
                                                   @bind="item.TransferQty"
                                                   @bind:after="OnSelectionChanged"
                                                   max="@item.AvailQty"
                                                   min="1"
                                                   style="max-width: 95px; margin: 0 auto;" />
                                        </td>
                                        <td class="text-center">
                                            <span class="badge px-2 py-1" style="background-color: #2196F3; color: #ffffff; font-weight: 700; border-radius: 4px;">
                                                @item.LotNo
                                            </span>
                                        </td>
                                        <td>@item.Batch_No</td>
                                        <td>@item.Mill_Certificate_No</td>
                                    </ContextMenuTrigger>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold text-dark border-top">
                            <tr>
                                <td colspan="7" class="text-end">Summary Totals:</td>
                                <td class="text-center text-success">@TotalAvailableQty.ToString("N0")</td>
                                <td class="text-center text-primary">@TotalSelectedQty.ToString("N0")</td>
                                <td colspan="3" class="text-muted small">(@SelectedLots.Count lots selected)</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- BOTTOM ACTION STRIP -->
            <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 border">
                <div class="d-flex align-items-center gap-3">
                    <span class="fw-bold text-secondary">
                        <i class="fas fa-check-square text-primary me-1"></i> Selected Lots: <span class="badge bg-primary fs-6">@SelectedLots.Count</span>
                    </span>
                    <span class="fw-bold text-secondary">
                        Total Qty to Transfer: <span class="badge bg-success fs-6">@TotalSelectedQty.ToString("N0")</span>
                    </span>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-primary fw-bold px-4" @onclick="OpenTransferModal" disabled="@(!SelectedLots.Any())">
                        <i class="fas fa-dolly-flatbed me-1"></i> Transfer to Ready Finish
                    </button>
                </div>
            </div>

            <!-- LOCATION ASSIGNMENT MODAL DIALOG -->
            @if (ShowTransferModal)
            {
                <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 10550;">
                    <div class="modal-dialog modal-md modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg" style="background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(12px); border-radius: 12px;">
                            <div class="modal-header border-bottom py-2 px-3 bg-light rounded-top">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fas fa-warehouse text-primary fs-5"></i>
                                    <h5 class="modal-title fw-bold text-dark mb-0" style="font-size: 1.05rem;">
                                        Assign Warehouse Location
                                    </h5>
                                </div>
                                <button type="button" class="btn-close btn-sm" @onclick="CloseTransferModal" disabled="@IsPosting"></button>
                            </div>
                            <div class="modal-body p-3">
                                <!-- Transfer Summary Card -->
                                <div class="p-2 mb-3 bg-light rounded-3 border d-flex justify-content-between align-items-center" style="font-size: 0.84rem;">
                                    <div><span class="text-muted fw-bold">Selected Lots:</span> <span class="badge bg-primary">@SelectedLots.Count Lots</span></div>
                                    <div><span class="text-muted fw-bold">Total Transfer Qty:</span> <span class="badge bg-success fs-6">@TotalSelectedQty.ToString("N0")</span></div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                                        Store <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select form-select-sm" @bind="SelectedStoreId" @bind:after="OnStoreChanged">
                                        <option value="0">-- Select Store --</option>
                                        @foreach (var st in Stores)
                                        {
                                            <option value="@st.EntryID">@st.StoreName</option>
                                        }
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label form-label-sm mb-1 fw-bold text-secondary">
                                        Shelf / Rack Location <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select form-select-sm" @bind="SelectedShelfId" @bind:after="OnShelfChanged" disabled="@(!Shelves.Any())">
                                        <option value="0">@(Shelves.Any() ? "-- Select Shelf / Rack --" : "-- Select Store first --")</option>
                                        @foreach (var sh in Shelves)
                                        {
                                            <option value="@sh.EntryID">@sh.DisplayName</option>
                                        }
                                    </select>
                                </div>

                                <div class="mb-2">
                                    <label class="form-label form-label-sm mb-1 fw-bold text-secondary">Remarks / Placement Notes</label>
                                    <input type="text" class="form-control form-control-sm" @bind="TransferRemarks" placeholder="Enter location remarks..." />
                                </div>
                            </div>
                            <div class="modal-footer border-top py-2 px-3 bg-light rounded-bottom d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseTransferModal" disabled="@IsPosting">
                                    <i class="fas fa-times me-1"></i> Cancel
                                </button>
                                <button type="button" class="btn btn-sm btn-primary fw-bold px-4" @onclick="PostTransfer" disabled="@(SelectedShelfId == 0 || IsPosting)">
                                    @if (IsPosting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        <span>Posting...</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-check-circle me-1"></i>
                                        <span>Post Transfer</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<!-- Row-Specific Context Menu (right-click) -->
<ContextMenu Id="rowContextMenu" Template="Win11Style">
    <div class="win11-section-header px-3 py-1 text-muted small fw-bold border-bottom">REPORTS & SLIPS</div>
    <Item OnClick="@PrintSlip"><i class="fas fa-print text-dark me-2"></i> Print Slip</Item>
    <Item OnClick="@PrintPTC"><i class="fas fa-file-alt text-primary me-2"></i> Print PTC</Item>
</ContextMenu>

<style>
    .blazored-typeahead {
        height: 35px !important;
        font-size: 0.875rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
        border-radius: 6px !important;
    }
    .blazored-typeahead__input, .blazored-typeahead__controls {
        height: 33px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input-mask, .blazored-typeahead__input-mask-wrapper {
        height: 33px !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
    }
    .blazored-typeahead__results {
        z-index: 10000 !important;
    }
</style>
