@page "/export/custominvoices/new-custominvoice/{CustomInvoiceNo?}"
@using Impulse.Components.Export.NewCustomInvoiceTabs
@using DataAccessLibrary.Models.ViewModels.Export
@using Blazored.Typeahead
@inject NavigationManager NavManager

<PageTitle>@(IsEditMode ? $"Edit Custom Invoice: {Invoice.CustomInvoiceNo}" : "New Custom Invoice")</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body pt-3">
            
            <!-- Title Header and Actions -->
            <div class="row g-2 mb-3 align-items-end border-bottom pb-2">
                <div class="col-auto d-flex align-items-end pb-1">
                    <h5 class="mb-0 fw-bold text-dark-emphasis">
                        <i class="fas fa-file-invoice text-primary me-2"></i>
                        @(IsEditMode ? $"Edit Custom Invoice: {Invoice.CustomInvoiceNo}" : "New Custom Invoice")
                    </h5>
                    @if (IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm text-primary ms-3 mb-1" role="status" aria-hidden="true"></span>
                    }
                </div>
                <div class="col text-end d-flex justify-content-end align-items-center gap-2">
                    @if (IsEditMode)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="DeleteInvoice" disabled="@IsLoading">
                            <i class="fas fa-trash-alt me-1"></i>Delete
                        </button>
                    }
                    <button class="btn btn-sm btn-outline-secondary" @onclick="GoBack">
                        <i class="fas fa-arrow-left me-1"></i>Back
                    </button>
                    <div class="btn-group">
                        <button type="button" class="btn btn-sm btn-primary fw-bold px-3" @onclick="SaveAndStay" disabled="@IsLoading">
                            <i class="fas fa-save me-1"></i>Save
                        </button>
                        <button type="button" class="btn btn-sm btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false" disabled="@IsLoading">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" style="font-size: 0.85rem;">
                            <li><a class="dropdown-item" href="javascript:void(0)" @onclick="SaveAndNew"><i class="fas fa-plus me-2 text-success"></i>Save & New</a></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" @onclick="SaveAndClose"><i class="fas fa-check-double me-2 text-primary"></i>Save & Close</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Master Header Panel -->
            <div class="card mb-4 border" style="background: #f8f9fb; border-radius: 8px;">
                <div class="card-header py-2 fw-bold text-secondary" style="background: #eef0f7; border-radius: 8px 8px 0 0; font-size: 0.85rem; letter-spacing: 0.03em;">
                    <i class="fas fa-file-invoice me-1 text-primary"></i> Custom Invoice Header
                </div>
                <div class="card-body py-3">
                    <div class="row g-3">
                        <div class="col-md-2">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Company <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" @bind="Invoice.CompanyRefID" @bind:after="OnCompanyChanged" disabled="@(IsEditMode)">
                                @foreach (var c in Companies)
                                {
                                    <option value="@c.DropDownValue_ID">@c.DropDownValue_Description</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Customer <span class="text-danger">*</span></label>
                                <BlazoredTypeahead SearchMethod="SearchCustomers"
                                                   EnableDropDown="true"
                                                   TValue="CustomerLookupModel"
                                                   TItem="CustomerLookupModel"
                                                   Value="SelectedCustomer"
                                                   ValueChanged="OnCustomerChanged"
                                                   ValueExpression="@(() => SelectedCustomer)"
                                                   Placeholder="Select Customer"
                                                   disabled="@(IsEditMode)">
                                    <SelectedTemplate Context="selectedCust">
                                        @selectedCust?.Name
                                    </SelectedTemplate>
                                    <ResultTemplate Context="cust">
                                        @cust.Name
                                    </ResultTemplate>
                                </BlazoredTypeahead>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Country <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" @bind="Invoice.Country" @bind:after="OnCountryChanged" disabled="@(IsEditMode)">
                                <option value="">— Select —</option>
                                @foreach (var country in Countries)
                                {
                                    <option value="@country">@country</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Invoice No.</label>
                            <input type="text" class="form-control form-control-sm text-center fw-bold text-danger" @bind="Invoice.CustomInvoiceNo" disabled="@IsEditMode" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Date</label>
                            <input type="date" class="form-control form-control-sm" @bind="Invoice.DT" />
                        </div>
                        @if (!string.IsNullOrEmpty(Invoice.Currency))
                        {
                            <div class="col-md-1 d-flex align-items-end pb-1">
                                <span class="badge bg-success fs-6 fw-bold">@Invoice.Currency</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- TABS AREA -->
            <ul class="nav nav-tabs md3-tabs mb-3" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(ActiveTab == 0 ? "active" : "")" id="invoice-items-tab" type="button" @onclick="() => ActiveTab = 0">
                        <i class="fas fa-list-ol me-1"></i> Invoice Items
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(ActiveTab == 2 ? "active" : "")" id="proforma-items-tab" type="button" @onclick="() => ActiveTab = 2">
                        <i class="fas fa-boxes me-1"></i> Proforma Items
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(ActiveTab == 1 ? "active" : "")" id="other-info-tab" type="button" @onclick="() => ActiveTab = 1">
                        <i class="fas fa-info-circle me-1"></i> Other Info
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(ActiveTab == 3 ? "active" : "")" id="commercial-tab" type="button" @onclick="() => ActiveTab = 3">
                        <i class="fas fa-file-alt me-1"></i> Commercial Invoice
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(ActiveTab == 4 ? "active" : "")" id="charges-tab" type="button" @onclick="() => ActiveTab = 4">
                        <i class="fas fa-coins me-1"></i> Other Charges
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(ActiveTab == 5 ? "active" : "")" id="advance-tab" type="button" @onclick="() => ActiveTab = 5">
                        <i class="fas fa-money-check-dollar me-1"></i> Advance Payments
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(ActiveTab == 6 ? "active" : "")" id="addresses-tab" type="button" @onclick="() => ActiveTab = 6">
                        <i class="fas fa-map-marker-alt me-1"></i> Addresses
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" style="min-height: 400px;">
                <div style="display: @(ActiveTab == 0 ? "block" : "none")">
                    <InvoiceItemsTab Invoice="Invoice" OnTotalsChanged="OnTotalsChanged" />
                </div>
                <div style="display: @(ActiveTab == 1 ? "block" : "none")">
                    <OtherInfoTab @ref="OtherInfoTabRef"
                                  Invoice="Invoice" 
                                  TradeTermsList="TradeTermsList"
                                  PaymentTermsList="PaymentTermsList"
                                  ShippingMethods="ShippingMethods"
                                  ShippingAgents="ShippingAgents"
                                  InsuranceAgents="InsuranceAgents"
                                  CompanyBankAccounts="CompanyBankAccounts"
                                  CustomerBanks="CustomerBanks"
                                  Countries="Countries" />
                </div>
                <div style="display: @(ActiveTab == 2 ? "block" : "none")">
                    <ProformaItemsTab Invoice="Invoice"
                                      CustCode="@Invoice.CustCode"
                                      Country="@Invoice.Country"
                                      OnAddItems="HandleAddItems" />
                </div>
                <div style="display: @(ActiveTab == 3 ? "block" : "none")">
                    <CommercialInvoiceTab Invoice="Invoice" />
                </div>
                <div style="display: @(ActiveTab == 4 ? "block" : "none")">
                    <OtherChargesTab OtherCharges="Invoice.OtherCharges"
                                     OnChargesUpdated="OnTotalsChanged" />
                </div>
                <div style="display: @(ActiveTab == 5 ? "block" : "none")">
                    <AdvancePaymentsTab AdvancePayments="Invoice.AdvancePayments" />
                </div>
                <div style="display: @(ActiveTab == 6 ? "block" : "none")">
                    <AddressesTab Invoice="Invoice"
                                  ShippingAddressPresets="ShippingAddressPresets"
                                  InvoiceToPresets="InvoiceToPresets" />
                </div>
            </div>
            
            <!-- Bottom Total Display -->
            <div class="mt-3 text-end" style="font-size:0.8rem; color:#44474f;">
                <span class="fw-bold me-1">Amount in Words:</span>
                <span class="fst-italic text-primary fw-bold">@Invoice.AmountInWords</span>
            </div>
        </div>
    </div>
</div>

<style>
    /* Material Design 3 style tabs */
    .md3-tabs {
        border-bottom: 1px solid #e0e2ec;
        gap: 4px;
        flex-wrap: wrap;
    }
    .md3-tabs .nav-link {
        color: #44474f;
        border: none;
        border-bottom: 3px solid transparent;
        padding: 0.5rem 0.75rem;
        font-weight: 500;
        font-size: 0.85rem;
        border-radius: 0;
        transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
    }
    .md3-tabs .nav-link:hover {
        background-color: rgba(192, 88, 0, 0.05); /* Match Export orange tint */
        color: #7a3000;
    }
    .md3-tabs .nav-link.active {
        color: #c05800; /* Export Theme Color */
        border-bottom-color: #c05800;
        background: transparent;
    }
    .blazored-typeahead {
        height: 31px !important;
        font-size: 0.875rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }
    .blazored-typeahead__input, .blazored-typeahead__controls {
        height: 29px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }
    .blazored-typeahead__input-icon {
        padding: 0 0.5rem !important;
        display: flex !important;
        align-items: center !important;
    }

    .form-control-sm, .form-select-sm {
        height: 31px !important;
        font-size: 0.875rem !important;
    }
</style>
