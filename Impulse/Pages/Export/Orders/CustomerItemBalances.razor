@page "/export/orders/customer-item-balances"
@using DataAccessLibrary.Models.ViewModels.Export
@using Blazored.Typeahead
@using BlazorContextMenu

<PageTitle>Customer Item Balances</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body pt-3">
            
            <!-- Title -->
            <div class="d-flex align-items-end pb-2 mb-3 border-bottom">
                <h5 class="mb-0 fw-bold text-dark-emphasis">
                    <i class="fas fa-balance-scale text-primary me-2"></i>
                    Customer Item Balances
                </h5>
            </div>
            <!-- Filter Row -->
            <div class="row g-2 mb-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Customer</label>
                    <BlazoredTypeahead SearchMethod="SearchCustomers"
                                       EnableDropDown="true"
                                       Data="customers"
                                       TValue="CustomerLookupModel"
                                       TItem="CustomerLookupModel"
                                       Value="selectedCustomer"
                                       ValueChanged="OnCustomerChanged"
                                       ValueExpression="@(() => selectedCustomer)"
                                       Placeholder="<Select Customer>"
                                       MaximumSuggestions="1000">
                        <SelectedTemplate Context="selectedCust">
                            @selectedCust?.CustCode
                        </SelectedTemplate>
                        <ResultTemplate Context="cust">
                            @cust.CustCode
                        </ResultTemplate>
                    </BlazoredTypeahead>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;"><i class="fas fa-search me-1"></i>Search List</label>
                    <input type="text" class="form-control form-control-sm" placeholder="Order No, Item Code, Item Name..." @bind="searchText" @bind:event="oninput" style="height: 31px;" />
                </div>
                <div class="col d-flex align-items-end justify-content-end gap-2 pb-1" style="height: 31px;">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LoadData" title="Refresh">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" id="optionsBarMenuButton" @onclick="OpenOptionsBarMenu" title="Reports Options">
                        <i class="fas fa-print me-1"></i> Reports
                    </button>
                </div>
            </div>

            <!-- Grid -->
            @if (isLoading)
            {
                <div class="d-flex align-items-center justify-content-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="card border border-light-subtle rounded-3 overflow-hidden shadow-xs">
                    <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                            <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                <tr>
                                <th>S. #</th>
                                <th>Order #</th>
                                <th>Int. Ord</th>
                                <th>Item Code</th>
                                <th>Item Name</th>
                                <th>Delivery DT</th>
                                <th class="text-end">Bal. Qty</th>
                                <th>Delivery</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (FilteredItems.Any())
                            {
                                int sno = 1;
                                foreach (var item in FilteredItems)
                                {
                                    var rowItem = item;
                                    var deliveryStatusText = GetDeliveryStatusText(rowItem.DeliveryStatus);
                                    var deliveryStatusClass = GetDeliveryStatusCssClass(rowItem.DeliveryStatus);
                                    
                                    <tr @key="rowItem.ID" class="clickable-row">
                                        <td>@(sno++)</td>
                                        <td>@rowItem.OrderNo</td>
                                        <td>@rowItem.InternalRefNo</td>
                                        <td>@rowItem.CompItemCode</td>
                                        <td>@rowItem.ItemName</td>
                                        <td>@(rowItem.DeliveryStatus == 0 ? "-" : rowItem.DeliveryDT.ToString("dd-MMM-yyyy"))</td>
                                        <td class="text-end" @ondblclick="() => BeginEditBalQty(rowItem)" style="cursor: pointer;" title="Double-click to edit Bal. Qty">
                                            @if (rowItem.IsEditing)
                                            {
                                                <input type="number" class="form-control form-control-sm text-end" style="width: 80px; display: inline-block;"
                                                       @bind="rowItem.EditBalQty"
                                                       @onkeyup="@(async (e) => await HandleBalQtyKeyUp(e, rowItem))"
                                                       @onblur="() => CancelEdit(rowItem)"
                                                       id="editQty_@rowItem.ID" />
                                            }
                                            else
                                            {
                                                <span class="text-primary text-decoration-underline">@rowItem.BalQty.ToString("N0")</span>
                                            }
                                        </td>
                                        <td @ondblclick="() => ToggleDeliveryStatus(rowItem)" style="cursor: pointer;" title="Double-click to toggle Urgent/Regular">
                                            <span class="badge @deliveryStatusClass">@deliveryStatusText</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        <i class="fas fa-info-circle me-2"></i>No item balances found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            }
        </div>
    </div>
</div>

<!-- ── Password Prompt Modal ── -->
@if (showPasswordModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.45); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
                <div class="modal-header bg-warning text-dark border-0 py-2" style="border-top-left-radius: 12px; border-top-right-radius: 12px;">
                    <h6 class="modal-title fw-bold"><i class="fas fa-lock me-2"></i>Authorization Required</h6>
                    <button type="button" class="btn-close" @onclick="() => showPasswordModal = false"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="text-secondary" style="font-size: 0.85rem;">Enter password to perform action:</p>
                    <input type="password" class="form-control form-control-sm" @bind="enteredPassword" placeholder="Password..." @onkeyup="@(async (e) => { if (e.Key == "Enter") await VerifyPasswordAndExecute(); })" />
                    @if (!string.IsNullOrEmpty(passwordError))
                    {
                        <div class="text-danger mt-1" style="font-size: 0.75rem;">@passwordError</div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0 pb-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => showPasswordModal = false">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="VerifyPasswordAndExecute">Submit</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Context Menu: Reports ── -->
<ContextMenu Id="optionsBarMenu" UseDefaultEventHandlers="true" Template="Win11Style">
    <div class="win11-section-header">Reports</div>
    <Item class="win11-menu-item" OnClick="@(() => PrintList())">
        <i class="fas fa-list fa-fw win11-icon"></i> Print List
    </Item>
    <Item class="win11-menu-item" OnClick="@(() => PrintUrgent())">
        <i class="fas fa-exclamation-circle fa-fw win11-icon text-danger"></i> Print Urgent
    </Item>
</ContextMenu>

<style>
    .clickable-row:hover {
        background-color: rgba(192, 88, 0, 0.05) !important;
    }
    /* BlazoredTypeahead styling overrides to match Bootstrap form-control-sm */
    .blazored-typeahead {
        height: 31px !important;
        font-size: 0.875rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }
    .blazored-typeahead__input, .blazored-typeahead__controls {
        height: 29px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }
    .blazored-typeahead__clear {
        margin-top: 5px !important;
    }
</style>
