@page "/export/newcustomerquotation"
@page "/export/new-customer-quotation/{QuotationNo:int?}"
@attribute [Authorize]
@using DataAccessLibrary.Models.ViewModels.Export
@using Impulse.Components.Export.NewCustomerQuotationTabs

<PageTitle>New Customer Quotation</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body pt-3">

            <!-- Title Header -->
            <div class="row g-2 mb-3 align-items-end border-bottom pb-2">
                <div class="col-auto d-flex align-items-end pb-1">
                    <h5 class="mb-0 fw-bold text-dark-emphasis">
                        <i class="fas fa-file-invoice-dollar text-primary me-2"></i>
                        New Customer Quotation
                    </h5>
                </div>
            </div>

            <EditForm Model="Quotation" OnValidSubmit="SaveQuotationAndClose">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger mb-3" />

                <!-- Master Quotation Header Panel -->
                <div class="card mb-4 border" style="background: #f8f9fb; border-radius: 8px;">
                    <div class="card-header py-2 fw-bold text-secondary" style="background: #eef0f7; border-radius: 8px 8px 0 0; font-size: 0.85rem; letter-spacing: 0.03em;">
                        <i class="fas fa-file-alt me-1 text-primary"></i> Quotation Header Information
                    </div>
                    <div class="card-body py-3">
                        <div class="row g-3">
                            <!-- Company -->
                            <div class="col-md-3">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Company <span class="text-danger">*</span></label>
                                <BlazoredTypeahead SearchMethod="SearchCompanies"
                                                   EnableDropDown="true"
                                                   Data="Companies"
                                                   TValue="DataAccessLibrary.Models.ViewModels.Export.CompanyLookupModel"
                                                   TItem="DataAccessLibrary.Models.ViewModels.Export.CompanyLookupModel"
                                                   Value="SelectedCompany"
                                                   ValueChanged="OnCompanySelected"
                                                   ValueExpression="@(() => SelectedCompany)"
                                                   Placeholder="Select Company">
                                    <SelectedTemplate Context="selectedComp">
                                        @selectedComp?.CompanyName
                                    </SelectedTemplate>
                                    <ResultTemplate Context="comp">
                                        @comp.CompanyName
                                    </ResultTemplate>
                                </BlazoredTypeahead>
                            </div>

                            <!-- Customer -->
                            <div class="col-md-3">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Customer <span class="text-danger">*</span></label>
                                <BlazoredTypeahead SearchMethod="SearchCustomers"
                                                   EnableDropDown="true"
                                                   Data="Customers"
                                                   TValue="DataAccessLibrary.Models.ViewModels.Export.CustomerLookupModel"
                                                   TItem="DataAccessLibrary.Models.ViewModels.Export.CustomerLookupModel"
                                                   Value="SelectedCustomer"
                                                   ValueChanged="OnCustomerSelected"
                                                   ValueExpression="@(() => SelectedCustomer)"
                                                   Placeholder="Select Customer">
                                    <SelectedTemplate Context="selectedCust">
                                        @selectedCust?.Name
                                    </SelectedTemplate>
                                    <ResultTemplate Context="cust">
                                        @cust.Name
                                    </ResultTemplate>
                                </BlazoredTypeahead>
                            </div>

                            <!-- Country -->
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Country</label>
                                <select class="form-select form-select-sm" value="@Quotation.Country" @onchange="OnCountryChangedArgs">
                                    <option value="">Select Country</option>
                                    @foreach (var country in Countries)
                                    {
                                        <option value="@country">@country</option>
                                    }
                                </select>
                            </div>

                            <!-- Currency -->
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Currency</label>
                                <input type="text" class="form-control form-control-sm" @bind="Quotation.Currency" readonly style="background: #f0f2f5;" placeholder="Auto-filled" />
                            </div>

                            <!-- Quotation No -->
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Quotation No <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm text-center fw-bold text-danger" value="@Quotation.QuotationNo" readonly style="background: #f0f2f5;" />
                            </div>

                            <!-- Quotation Date -->
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Quotation Date</label>
                                <input type="date" class="form-control form-control-sm" @bind="Quotation.DT" />
                            </div>

                            <!-- Trade Terms -->
                            <div class="col-md-3">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Trade Terms</label>
                                <select class="form-select form-select-sm" @bind="Quotation.TradeTerms">
                                    <option value="">Select Trade Terms</option>
                                    @foreach (var term in TradeTermsList)
                                    {
                                        <option value="@term.DropDownValue_Description">@term.DropDownValue_Description</option>
                                    }
                                </select>
                            </div>

                            <!-- Payment Terms -->
                            <div class="col-md-3">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Payment Terms</label>
                                <select class="form-select form-select-sm" @bind="Quotation.PaymentTerms">
                                    <option value="">Select Payment Terms</option>
                                    @foreach (var pt in PaymentTermsList)
                                    {
                                        <option value="@pt.DropDownValue_Description">@pt.DropDownValue_Description</option>
                                    }
                                </select>
                            </div>

                            <!-- Validity -->
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Validity</label>
                                <input type="text" class="form-control form-control-sm" @bind="Quotation.Validity" />
                            </div>

                            <!-- Delivery Date -->
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Delivery Date</label>
                                <input type="date" class="form-control form-control-sm" @bind="Quotation.DeliveryDT" />
                            </div>
                            
                            <!-- Delivery Time -->
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Delivery Time</label>
                                <input type="text" class="form-control form-control-sm" @bind="Quotation.DeliveryTime" />
                            </div>

                            <!-- Ship Via -->
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Ship Via</label>
                                <select class="form-select form-select-sm" @bind="Quotation.ShipVia">
                                    <option value="">Select Mode</option>
                                    @foreach (var mode in ShippingMethods)
                                    {
                                        <option value="@mode.DropDownValue_Description">@mode.DropDownValue_Description</option>
                                    }
                                </select>
                            </div>
                            
                            <!-- Destination -->
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Destination</label>
                                <input type="text" class="form-control form-control-sm" @bind="Quotation.Destination" />
                            </div>

                            <!-- Packing -->
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Packing</label>
                                <input type="text" class="form-control form-control-sm" @bind="Quotation.Packing" />
                            </div>
                            
                            <!-- Department -->
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Department</label>
                                <input type="text" class="form-control form-control-sm" @bind="Quotation.Department" />
                            </div>

                            <!-- Attention Person -->
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Attention To</label>
                                <input type="text" class="form-control form-control-sm" @bind="Quotation.AttentionPerson" />
                            </div>

                            <!-- Bank -->
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Bank</label>
                                <select class="form-select form-select-sm" @bind="Quotation.BankID">
                                    <option value="">Select Bank</option>
                                    @foreach (var bank in Banks)
                                    {
                                        <option value="@bank.BankID">@bank.Bank - @bank.BankAccNo</option>
                                    }
                                </select>
                            </div>

                            <!-- Swift Code -->
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Swift Code</label>
                                <input type="text" class="form-control form-control-sm" @bind="Quotation.SwiftCode" />
                            </div>
                            
                            <!-- Gross Weight -->
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Gross Weight</label>
                                <input type="text" class="form-control form-control-sm" @bind="Quotation.GrossWeight" />
                            </div>

                            <!-- Net Weight -->
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Net Weight</label>
                                <input type="text" class="form-control form-control-sm" @bind="Quotation.NetWeight" />
                            </div>

                            <!-- No. of Packages -->
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">No. Packages</label>
                                <input type="text" class="form-control form-control-sm" @bind="Quotation.NoOfPackages" />
                            </div>

                            <!-- Remarks -->
                            <div class="col-md-12">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.82rem;">Remarks</label>
                                <input type="text" class="form-control form-control-sm" @bind="Quotation.Remarks" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabs Navigation -->
                <ul class="nav nav-tabs md3-tabs" id="quotationTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(ActiveTab == "ArticleDetail" ? "active" : "")"
                                @onclick='() => ChangeTab("ArticleDetail")'
                                type="button" role="tab">Items Detail</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(ActiveTab == "OtherCharges" ? "active" : "")"
                                @onclick='() => ChangeTab("OtherCharges")'
                                type="button" role="tab">Other Charges</button>
                    </li>
                </ul>

                <!-- Tab Content panes -->
                <div class="tab-content pt-4" id="quotationTabsContent">
                    <div class="tab-pane fade @(ActiveTab == "ArticleDetail" ? "show active" : "")" role="tabpanel">
                        <QuotationArticleDetailTab Quotation="Quotation"
                                          CatalogItems="CatalogItems"
                                          Qualities="FinishingQualities"
                                          OnItemAdded="AddLineItem"
                                          OnItemDeleted="RemoveLineItem"
                                          OnItemEdit="SelectForEdit"
                                          IsEditing="@(EditingItem != null)"
                                          OnCancelEdit="CancelEdit"
                                          OnCatalogItemChanged="OnCatalogItemChanged"
                                          OnFinishingTypeChanged="OnFinishingTypeChanged"
                                          NewItemInput="NewItemInput" />
                    </div>
                    <div class="tab-pane fade @(ActiveTab == "OtherCharges" ? "show active" : "")" role="tabpanel">
                        <QuotationOtherChargesTab Quotation="Quotation"
                                          OnChargeAdded="AddCharge"
                                          OnChargeDeleted="RemoveCharge"
                                          OnChargeEdit="SelectChargeForEdit"
                                          IsEditing="@(EditingCharge != null)"
                                          OnCancelEdit="CancelEditCharge"
                                          NewChargeInput="NewChargeInput" />
                    </div>
                </div>

                <!-- Bottom Sticky Footer Actions -->
                <div class="row align-items-center border-top pt-3 mt-4">
                    <div class="col-md-6 d-flex align-items-center gap-3">
                        <!-- Print check -->
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="printOnSaveCheck" />
                            <label class="form-check-label fw-bold text-secondary" for="printOnSaveCheck" style="font-size: 0.85rem;">
                                Print On Save
                            </label>
                        </div>
                    </div>

                    <div class="col-md-6 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
                        <button type="button" class="btn btn-outline-success" @onclick="SaveQuotationAndStay" disabled="@IsSaving">
                            <i class="fas fa-save me-1"></i> Save &amp; Stay
                        </button>
                        <button type="button" class="btn btn-outline-primary" @onclick="SaveQuotationAndNew" disabled="@IsSaving">
                            <i class="fas fa-plus me-1"></i> Save &amp; New
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@IsSaving">
                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="fas fa-check me-1"></i> <span>Save &amp; Close</span>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<style>
    /* Material Design 3 style tabs */
    .md3-tabs {
        border-bottom: 1px solid #e0e2ec;
        gap: 4px;
        flex-wrap: wrap;
    }
    .md3-tabs .nav-link {
        color: #44474f;
        border: none;
        border-bottom: 3px solid transparent;
        padding: 0.5rem 0.75rem;
        font-weight: 500;
        font-size: 0.85rem;
        border-radius: 0;
        transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
    }
    .md3-tabs .nav-link:hover {
        background-color: rgba(192, 88, 0, 0.05); /* Match Export orange tint */
        color: #7a3000;
    }
    .md3-tabs .nav-link.active {
        color: #c05800; /* Export Theme Color */
        border-bottom-color: #c05800;
        background: transparent;
    }
    .blazored-typeahead {
        height: 31px !important;
        font-size: 0.875rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }
    .blazored-typeahead__input, .blazored-typeahead__controls {
        height: 29px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }
    .blazored-typeahead__input-icon {
        padding: 0 0.5rem !important;
        display: flex !important;
        align-items: center !important;
    }
    .form-control-sm, .form-select-sm {
        height: 31px !important;
        font-size: 0.875rem !important;
    }
</style>
