@page "/stock/vendor-rm-assignment"
@using DataAccessLibrary.Models.ViewModels.Stock
@using Impulse.Services.Stock
@using Blazored.Typeahead
@inject IVendorRMAssignmentService VendorRMAssignmentService
@inject Impulse.Services.INotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Vendor RM Assignment</PageTitle>

<style>
    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 0.75rem;
        border-radius: 4px;
    }
    /* Fix Blazored Typeahead height to match .btn-sm */
    .blazored-typeahead {
        height: 35px !important;
        font-size: 0.875rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }
    .disabled-typeahead-wrapper .blazored-typeahead {
        background-color: #e9ecef !important;
        overflow: hidden !important; /* Safe to clip because dropdown cannot open when disabled */
        border-radius: 4px;
    }
    .blazored-typeahead__input, .blazored-typeahead__controls {
        height: 33px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input-mask, .blazored-typeahead__input-mask-wrapper {
        height: 33px !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
    }
    .blazored-typeahead__results {
        z-index: 1050 !important;
    }
    .blazored-typeahead__input-icon {
        padding: 0 0.5rem !important;
        display: flex !important;
        align-items: center !important;
    }

    /* Prevent Context Menu from getting cut off */
    .win11-context-menu-container, .blazor-context-menu {
        max-height: 40vh !important;
        overflow-y: auto !important;
    }

    /* Fix stacking context for dropdowns over sticky headers */
    .dropdown-row {
        position: relative !important;
        z-index: 9999 !important;
    }
    .table-wrapper {
        position: relative !important;
        z-index: 1 !important;
    }
</style>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body pt-3">
            <!-- Title -->
            <div class="d-flex align-items-end pb-2 mb-3 border-bottom">
                <h5 class="mb-0 fw-bold text-dark-emphasis">
                    <i class="fas fa-link text-primary me-2"></i>
                    Vendor RM Assignment
                </h5>
            </div>
            
            <div class="row g-2 align-items-end mb-3 dropdown-row">
                <div class="col-md-4">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Select Vendor</label>
                    <BlazoredTypeahead SearchMethod="SearchVendors"
                                       @bind-Value="SelectedVendor"
                                       Placeholder="Search Vendor..."
                                       EnableDropDown="true"
                                       MaximumSuggestions="1000">
                        <SelectedTemplate>
                            @context.VendorName
                        </SelectedTemplate>
                        <ResultTemplate>
                            @context.VendorName
                        </ResultTemplate>
                    </BlazoredTypeahead>
                </div>
                
                <div class="col-md-5">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Unassigned Raw Materials</label>
                    <div class="@(SelectedVendor == null ? "disabled-typeahead-wrapper" : "")">
                        <BlazoredTypeahead SearchMethod="SearchUnassignedRMs"
                                           @bind-Value="SelectedUnassignedRM"
                                           Placeholder="Select Raw Material..."
                                           EnableDropDown="true"
                                           Disabled="SelectedVendor == null"
                                           MaximumSuggestions="1000">
                            <SelectedTemplate>
                                @context.RMName
                            </SelectedTemplate>
                            <ResultTemplate>
                                @context.RMName
                            </ResultTemplate>
                        </BlazoredTypeahead>
                    </div>
                </div>

                <div class="col-md-2">
                    <button type="button" class="btn btn-sm btn-primary w-100" @onclick="AssignRM" disabled="@(SelectedUnassignedRM == null || isAssigning)">
                        <i class="fas fa-plus-circle me-1"></i> Assign
                    </button>
                </div>

                <div class="col-md-1">
                    <button type="button" class="btn btn-sm btn-outline-secondary w-100" @onclick="GoBack">
                        Back
                    </button>
                </div>
            </div>

            <!-- Grid -->
            <div class="card border border-light-subtle rounded-3 overflow-hidden shadow-xs table-wrapper">
                <div class="table-responsive" style="max-height: 60vh; overflow-y: auto;">
                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                            <tr>
                                <th style="width: 50px;">S No.</th>
                                <th>RM ID</th>
                                <th>Description</th>
                                <th>Group</th>
                                <th style="width: 150px;">Rate</th>
                                <th>Remarks</th>
                                <th style="width: 120px;" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else if (AssignedRMs == null || !AssignedRMs.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        <i class="fas fa-inbox fa-2x mb-2 text-light"></i>
                                        <p class="mb-0">@(SelectedVendor == null ? "Select a vendor to view assigned materials." : "No assigned materials found.")</p>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int index = 1;
                                foreach (var item in AssignedRMs)
                                {
                                    int currentIndex = index;
                                    var isEditing = editingRowId == item.EntryID;

                                    <ContextMenuTrigger MenuId="rowContextMenu" Data="item" WrapperTag="tr" class="@(isEditing ? "table-warning" : "cursor-pointer")">
                                        <td>@currentIndex</td>
                                        <td>@item.RMID1</td>
                                        <td>@item.RMName</td>
                                        <td>@item.GroupName</td>
                                        <td>
                                            @if (isEditing)
                                            {
                                                <input type="number" class="form-control form-control-sm" @bind="item.Rate" style="height: 28px;" />
                                            }
                                            else
                                            {
                                                @item.Rate
                                            }
                                        </td>
                                        <td>
                                            @if (isEditing)
                                            {
                                                <input type="text" class="form-control form-control-sm" @bind="item.Remarks" style="height: 28px;" />
                                            }
                                            else
                                            {
                                                @item.Remarks
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (isEditing)
                                            {
                                                <button class="btn btn-xs btn-success me-1" @onclick="() => SaveRow(item)" title="Save">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                                <button class="btn btn-xs btn-danger" @onclick="CancelEdit" title="Cancel">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-xs btn-light border" @onclick="() => EditRow(item)" title="Edit">
                                                    <i class="fas fa-pencil-alt text-primary"></i>
                                                </button>
                                            }
                                        </td>
                                    </ContextMenuTrigger>
                                    index++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<BlazorContextMenu.ContextMenu Id="rowContextMenu" Template="Win11Style">
    <BlazorContextMenu.Item OnClick="OnEditRowClick" CssClass="win11-menu-item">
        <i class="fas fa-pencil-alt win11-icon text-primary"></i> Edit Rate/Remarks
    </BlazorContextMenu.Item>
    <BlazorContextMenu.Item OnClick="OnUnassignClick" CssClass="win11-menu-item">
        <i class="fas fa-trash win11-icon text-danger"></i> Unassign
    </BlazorContextMenu.Item>
    <BlazorContextMenu.Item OnClick="OnViewHistoryClick" CssClass="win11-menu-item">
        <i class="fas fa-history win11-icon text-info"></i> View History
    </BlazorContextMenu.Item>
</BlazorContextMenu.ContextMenu>

@if (showHistoryModal && currentHistoryItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); font-family: 'Calibri', 'Segoe UI', sans-serif;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
                <div class="modal-header bg-light text-dark py-3" style="border-top-left-radius: 12px; border-top-right-radius: 12px;">
                    <h6 class="modal-title fw-bold"><i class="fas fa-history text-info me-2"></i>Assignment History - @currentHistoryItem.RMName</h6>
                    <button type="button" class="btn-close" @onclick="CloseHistoryModal"></button>
                </div>
                <div class="modal-body py-4 bg-white">
                    <div class="table-responsive" style="max-height: 50vh; border: 1px solid #dee2e6; border-radius: 8px;">
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                            <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase;">
                                <tr>
                                    <th style="width: 50px;">S. #</th>
                                    <th>Date</th>
                                    <th>User</th>
                                    <th>Rate</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (historyItems == null || !historyItems.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            <i class="fas fa-info-circle fa-2x mb-2 text-light"></i>
                                            <p class="mb-0">No history found.</p>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    int histIndex = 1;
                                    foreach (var hist in historyItems)
                                    {
                                        <tr>
                                            <td>@histIndex</td>
                                            <td>@hist.DTEntry.ToString("dd-MMM-yyyy HH:mm")</td>
                                            <td>@hist.UserName</td>
                                            <td>@hist.Rate</td>
                                            <td>@hist.Remarks</td>
                                        </tr>
                                        histIndex++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-3 bg-white" style="border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseHistoryModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}
