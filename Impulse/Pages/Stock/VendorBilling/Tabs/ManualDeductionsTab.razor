@using DataAccessLibrary.Models.ViewModels.Stock

<div class="mb-3 p-2 rounded" style="background: rgba(248,249,250,0.8); border: 1px dashed #dee2e6;">
    <div class="row g-2 align-items-end">
        <div class="col">
            <label class="form-label fw-semibold text-secondary mb-1" style="font-size:0.78rem;">DESCRIPTION</label>
            <input type="text" class="form-control form-control-sm" placeholder="Enter deduction description..."
                   @bind="NewDescription" @bind:event="oninput" @onkeydown="OnInputKeyDown" />
        </div>
        <div class="col-auto" style="min-width: 130px;">
            <label class="form-label fw-semibold text-secondary mb-1" style="font-size:0.78rem;">AMOUNT</label>
            <input type="number" class="form-control form-control-sm text-end" placeholder="0"
                   @bind="NewAmount" @bind:event="oninput" @onkeydown="OnInputKeyDown" />
        </div>
        <div class="col-auto d-flex align-items-end">
            <button type="button" class="btn btn-sm btn-success" @onclick="AddRow"
                    disabled="@(string.IsNullOrWhiteSpace(NewDescription))">
                <i class="fas fa-plus me-1"></i> Add
            </button>
        </div>
    </div>
    <div class="text-muted mt-1" style="font-size: 0.75rem;">
        <i class="fas fa-info-circle me-1"></i> Press <kbd>Enter</kbd> in Amount field to add. Press <kbd>Del</kbd> on row to remove.
    </div>
</div>

<div class="table-wrapper" style="position: relative; z-index: 1; overflow-x: auto; max-height: 340px; overflow-y: auto;">
    @if (!Rows.Any())
    {
        <div class="text-center py-4 text-muted" style="font-size: 0.85rem;">
            <i class="fas fa-plus-circle me-2 text-success"></i>No manual deductions added yet. Use the form above to add entries.
        </div>
    }
    else
    {
        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
            <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                <tr>
                    <th style="width: 40px;">S.#</th>
                    <th>Description</th>
                    <th class="text-end" style="width: 120px;">Amount</th>
                    <th style="width: 60px;"></th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 0; }
                @foreach (var row in Rows)
                {
                    idx++;
                    var capturedRow = row;
                    <tr>
                        <td class="text-muted">@idx</td>
                        <td>@row.Description</td>
                        <td class="text-end fw-semibold text-danger">@row.Amount.ToString("N0")</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-xs btn-outline-danger py-0 px-1"
                                    @onclick="() => RemoveRow(capturedRow)"
                                    title="Remove">
                                <i class="fas fa-times" style="font-size:0.7rem;"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light" style="font-size: 0.8rem; position: sticky; bottom: 0; z-index: 2;">
                <tr>
                    <td colspan="2" class="text-end fw-semibold text-danger pe-2">Total Manual Deduction :</td>
                    <td class="text-end fw-bold text-danger">@Rows.Sum(r => r.Amount).ToString("N0")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    }
</div>
