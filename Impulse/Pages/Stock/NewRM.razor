@page "/newrm"
@page "/newrm/{Id:int}"
@page "/newrm/copy/{CopyFromId:int}"
@using Impulse.Components.Stock.NewRMTabs

<div class="container-fluid px-4 py-3 newrm-page">
    <!-- Header Area -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 text-primary fw-bold" style="letter-spacing: -0.5px;">
                <i class="fas fa-boxes me-2"></i> Raw Material Profile
            </h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0" style="font-size: 0.85rem;">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item"><a href="/stock" class="text-decoration-none text-muted">Stock</a></li>
                    <li class="breadcrumb-item active fw-medium" aria-current="page">New Raw Material</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm shadow-sm d-flex align-items-center" @onclick="GoBack">
                <i class="fas fa-arrow-left me-2"></i> Back
            </button>
            <button class="btn btn-primary btn-sm shadow-sm d-flex align-items-center px-3 fw-medium" @onclick="SaveData" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="fas fa-save me-2"></i>
                    <span>Save</span>
                }
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-body p-4 pb-2">
                <!-- Global Fields Section -->
                <div class="row g-3 mb-3">
                    <div class="col-md-5">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">Category (Group)</label>
                        <select class="form-select form-select-sm shadow-none" @bind="Model.GroupID">
                            <option value="0">-- Select Category --</option>
                            @if (Categories != null)
                            {
                                foreach (var cat in Categories)
                                {
                                    <option value="@cat.ID">@cat.Description</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.82rem;">Device Code (RMID1)</label>
                        <input type="text" class="form-control form-control-sm shadow-none" @bind="Model.RMID1" placeholder="Enter Device Code" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end pb-1">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="chkInactive" @bind="Model.InActive" />
                            <label class="form-check-label fw-bold text-secondary" for="chkInactive" style="font-size:0.82rem;">Inactive Material</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Material Design 3 Styled Tabs -->
            <div class="px-4">
                <ul class="nav nav-tabs nav-tabs-md3 border-bottom border-light-subtle" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == "general" ? "active" : "")" @onclick='() => SetActiveTab("general")' type="button" role="tab">
                            <i class="fas fa-info-circle me-1"></i> General Info
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == "account" ? "active" : "")" @onclick='() => SetActiveTab("account")' type="button" role="tab">
                            <i class="fas fa-file-invoice-dollar me-1"></i> Account Info
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == "picture" ? "active" : "")" @onclick='() => SetActiveTab("picture")' type="button" role="tab">
                            <i class="fas fa-image me-1"></i> Picture / Drawing
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == "usedin" ? "active" : "")" @onclick='() => SetActiveTab("usedin")' type="button" role="tab">
                            <i class="fas fa-link me-1"></i> Used In
                        </button>
                    </li>
                </ul>
            </div>
            
            <div class="card-body p-4 bg-light rounded-bottom-3" style="min-height: 400px;">
                <div class="tab-content">
                    <div class="tab-pane fade @(activeTab == "general" ? "show active" : "")" role="tabpanel">
                        <GeneralInfoTab Model="Model" Units="Units" />
                    </div>
                    <div class="tab-pane fade @(activeTab == "account" ? "show active" : "")" role="tabpanel">
                        <AccountInfoTab Model="Model" 
                                        SaleAccounts="SaleAccounts" 
                                        SaleRAccounts="SaleRAccounts" 
                                        AssetAccounts="AssetAccounts" />
                    </div>
                    <div class="tab-pane fade @(activeTab == "picture" ? "show active" : "")" role="tabpanel">
                        <PictureDrawingTab Model="Model" />
                    </div>
                    <div class="tab-pane fade @(activeTab == "usedin" ? "show active" : "")" role="tabpanel">
                        <UsedInTab Model="Model" AvailableItems="AvailableItems" />
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .newrm-page .form-select-sm,
    .newrm-page .form-control-sm {
        height: 31px;
    }
    .nav-tabs-md3 {
        border-bottom: none;
        gap: 0.5rem;
    }
    .nav-tabs-md3 .nav-link {
        border: none;
        color: #6c757d;
        font-weight: 500;
        font-size: 0.85rem;
        padding: 0.75rem 1.25rem;
        border-radius: 0;
        border-bottom: 2px solid transparent;
        transition: all 0.2s ease-in-out;
    }
    .nav-tabs-md3 .nav-link:hover {
        color: #495057;
        background-color: rgba(0, 0, 0, 0.02);
        border-color: transparent;
    }
    .nav-tabs-md3 .nav-link.active {
        color: var(--bs-primary);
        background-color: transparent;
        border-bottom: 2px solid var(--bs-primary);
    }
</style>
