@page "/stock/change-batch-no"
@using Blazored.Typeahead
@using DataAccessLibrary.Models.ViewModels.Stock
@using Impulse.Services.Stock
@inject IChangeBatchNoService BatchService
@inject Radzen.NotificationService NotificationService
@inject Impulse.Services.IReportNavigationService ReportNavigation

<PageTitle>Change Batch No.</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                <h4 class="mb-0 text-primary d-flex align-items-center">
                    <i class="fas fa-edit me-2"></i> Change Batch No.
                </h4>
            </div>

            <!-- Header / Filters -->
            <div class="row gx-2 mb-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Select Material</label>
                    <BlazoredTypeahead SearchMethod="SearchMaterials" @bind-Value="SelectedMaterial" Placeholder="Search Materials..." EnableDropDown="true" class="blazored-typeahead" MaximumSuggestions="1000">
                        <SelectedTemplate>@(((dynamic)context).DisplayName)</SelectedTemplate>
                        <ResultTemplate>@(((dynamic)context).DisplayName)</ResultTemplate>
                    </BlazoredTypeahead>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-sm btn-primary w-100 shadow-sm" @onclick="LoadDataAsync" style="height: 35px;" disabled="@(SelectedMaterial == null)">
                        <i class="fas fa-search"></i> Load
                    </button>
                </div>
                <div class="col text-end">
                    <button class="btn btn-sm btn-outline-secondary me-2 shadow-sm" @onclick="OnPrint" style="height: 35px;" disabled="@(SelectedMaterial == null || IsLoading || !GridData.Any())">
                        <i class="fas fa-print me-1"></i> Print
                    </button>
                    <button class="btn btn-sm btn-success shadow-sm" @onclick="OnSaveAsync" style="height: 35px;" disabled="@(IsLoading || !GridData.Any(x => x.IsModified))">
                        <i class="fas fa-save me-1"></i> Save Changes
                    </button>
                </div>
            </div>

            <!-- Grid -->
            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else if (GridData != null)
            {
                <div class="table-responsive border rounded bg-white shadow-sm" style="max-height: 60vh; overflow-y: auto;">
                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 1; box-shadow: 0 1px 0 #dee2e6;">
                            <tr>
                                <th style="width: 50px;">S. #</th>
                                <th>Vendor</th>
                                <th>Rcv ID</th>
                                <th class="text-end">Qty</th>
                                <th>Store</th>
                                <th>Rack</th>
                                <th>Shelf</th>
                                <th style="width: 150px;">Batch #</th>
                                <th style="width: 150px;">Lot #</th>
                                <th style="width: 180px;">Mill Cert.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!GridData.Any())
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-4 text-muted">No material batches found.</td>
                                </tr>
                            }
                            else
                            {
                                int index = 1;
                                @foreach (var item in GridData)
                                {
                                    <tr class="table-row-hover">
                                        <td>@(index++)</td>
                                        <td>@item.VendorName</td>
                                        <td>@item.RcvID</td>
                                        <td class="text-end">@item.QtyPlaced.ToString("N2")</td>
                                        <td>@item.StoreName</td>
                                        <td>@item.RackNo</td>
                                        <td>@item.ShelfNo</td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="item.BatchNo" @bind:event="oninput" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="item.LotNo" @bind:event="oninput" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="item.MillCertificateNo" @bind:event="oninput" />
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .blazored-typeahead {
        height: 35px !important;
        font-size: 0.875rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input, .blazored-typeahead__controls {
        height: 33px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input-mask, .blazored-typeahead__input-mask-wrapper {
        height: 33px !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
    }
    .blazored-typeahead__input-icon {
        padding: 0 0.5rem !important;
        display: flex !important;
        align-items: center !important;
    }
    .form-control-sm, .form-select-sm, .input-group-text, .btn-sm {
        height: 35px !important;
    }
    .table-row-hover:hover {
        background-color: rgba(0, 0, 0, 0.04);
    }
</style>
