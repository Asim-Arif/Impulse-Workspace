@page "/stock/material-placement"
@using DataAccessLibrary.Models.ViewModels.Stock
@using Impulse.Services.Stock
@attribute [Authorize]
@inject IMaterialPlacementService MaterialPlacementService
@inject Impulse.Services.INotificationService NotificationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Material Placement</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                <h4 class="mb-0 text-primary d-flex align-items-center">
                    <i class="fas fa-boxes me-2"></i> Material Placement
                </h4>
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="chkShowPicture" @bind="ShowPicture">
                    <label class="form-check-label fw-bold text-secondary" for="chkShowPicture" style="font-size: 0.8rem;">Show Picture</label>
                </div>
            </div>

            <!-- Filters -->
            <div class="row gx-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Vendor</label>
                    <BlazoredTypeahead SearchMethod="SearchVendors" @bind-Value="SelectedVendor" Placeholder="All Vendors..." EnableDropDown="true">
                        <SelectedTemplate>@context.VendorName</SelectedTemplate>
                        <ResultTemplate>@context.VendorName</ResultTemplate>
                    </BlazoredTypeahead>
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Material</label>
                    <BlazoredTypeahead SearchMethod="SearchMaterials" @bind-Value="SelectedMaterial" Placeholder="All Materials..." EnableDropDown="true">
                        <SelectedTemplate>@context.MaterialName</SelectedTemplate>
                        <ResultTemplate>@context.MaterialName</ResultTemplate>
                    </BlazoredTypeahead>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-sm btn-primary w-100 shadow-sm" @onclick="LoadGridDataAsync">
                        <i class="fas fa-search me-1"></i> Search
                    </button>
                </div>
            </div>

            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else if (PendingPlacements != null)
            {
                <div class="table-responsive border rounded bg-white shadow-sm" style="max-height: 60vh; overflow-y: auto;">
                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 1; box-shadow: 0 1px 0 #dee2e6;">
                            <tr>
                                <th>Rcv Date</th>
                                <th>Vendor</th>
                                <th>Material</th>
                                <th class="text-end">Qty Passed</th>
                                <th class="text-end">Qty Placed</th>
                                <th class="text-end">Balance</th>
                                <th style="width: 100px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in PendingPlacements)
                            {
                                <tr @onclick="() => SelectRowMaterial(item.MaterialID)" style="cursor:pointer;">
                                    <td>@item.RcvDate.ToString("dd-MMM-yyyy")</td>
                                    <td>@item.VendorName</td>
                                    <td>@item.MaterialName</td>
                                    <td class="text-end">@item.QtyPassed @item.Unit</td>
                                    <td class="text-end">@item.QtyPlaced @item.Unit</td>
                                    <td class="text-end fw-bold text-danger">@item.Balance @item.Unit</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-success rounded-pill px-3" @onclick="() => OpenPlacementModal(item)">
                                            Place
                                        </button>
                                    </td>
                                </tr>
                            }
                            @if (!PendingPlacements.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">No pending materials to place.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@if (IsModalOpen && SelectedPlacementItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 12px;">
                <div class="modal-header bg-light border-bottom-0" style="border-radius: 12px 12px 0 0;">
                    <h5 class="modal-title text-primary fw-bold">
                        <i class="fas fa-map-marker-alt me-2"></i> Place Material
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body py-4">
                    
                    <div class="mb-3">
                        <p class="mb-1 text-secondary fw-bold" style="font-size: 0.85rem;">@SelectedPlacementItem.MaterialName</p>
                        <p class="mb-0 text-muted" style="font-size: 0.8rem;">
                            Balance to Place: <span class="fw-bold text-danger">@SelectedPlacementItem.Balance @SelectedPlacementItem.Unit</span>
                        </p>
                    </div>

                    <div class="row gx-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Store</label>
                            <BlazoredTypeahead SearchMethod="SearchStores" @bind-Value="SelectedStore" Placeholder="Select Store" EnableDropDown="true">
                                <SelectedTemplate>@context.StoreName</SelectedTemplate>
                                <ResultTemplate>@context.StoreName</ResultTemplate>
                            </BlazoredTypeahead>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Rack</label>
                            <div class="@(SelectedStore == null ? "disabled-typeahead-wrapper" : "")">
                                <BlazoredTypeahead SearchMethod="SearchRacks" @bind-Value="SelectedRack" Placeholder="Select Rack" EnableDropDown="true" Disabled="@(SelectedStore == null)">
                                    <SelectedTemplate>@context.RackNo</SelectedTemplate>
                                    <ResultTemplate>@context.RackNo</ResultTemplate>
                                </BlazoredTypeahead>
                            </div>
                        </div>
                    </div>

                    <div class="row gx-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Shelf</label>
                            <div class="@(SelectedRack == null ? "disabled-typeahead-wrapper" : "")">
                                <BlazoredTypeahead SearchMethod="SearchShelves" @bind-Value="SelectedShelf" Placeholder="Select Shelf" EnableDropDown="true" Disabled="@(SelectedRack == null)">
                                    <SelectedTemplate>@context.ShelfNo</SelectedTemplate>
                                    <ResultTemplate>@context.ShelfNo</ResultTemplate>
                                </BlazoredTypeahead>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Quantity to Place</label>
                            <input type="number" class="form-control form-control-sm custom-input-sm" @bind="PlacementQty" min="0" step="0.01" max="@SelectedPlacementItem.Balance" />
                        </div>
                    </div>

                    <div class="row gx-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Batch No (Optional)</label>
                            <input type="text" class="form-control form-control-sm custom-input-sm" @bind="BatchNo" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Lot No (Optional)</label>
                            <input type="text" class="form-control form-control-sm custom-input-sm" @bind="LotNo" />
                        </div>
                    </div>

                </div>
                <div class="modal-footer border-top-0 bg-light" style="border-radius: 0 0 12px 12px;">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary px-4" @onclick="SavePlacementAsync">
                        <i class="fas fa-check me-1"></i> Save Placement
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .disabled-typeahead-wrapper .blazored-typeahead {
        overflow: hidden !important;
        border-radius: 4px;
        background-color: #e9ecef !important;
    }
    .custom-input-sm {
        height: 35px !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead {
        height: 35px !important;
        font-size: 0.875rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input, .blazored-typeahead__controls {
        height: 33px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input-mask, .blazored-typeahead__input-mask-wrapper {
        height: 33px !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
    }
    .blazored-typeahead__input-icon {
        padding: 0 0.5rem !important;
        display: flex !important;
        align-items: center !important;
    }
</style>

<Impulse.Components.Stock.MaterialPictureViewer MaterialId="@SelectedMaterialId" ShowPicture="@ShowPicture" />
