@page "/stock/material-placement-list"
@using Blazored.Typeahead
@using DataAccessLibrary.Models.ViewModels.Stock
@using Impulse.Services.Stock
@inject IMaterialPlacementListService PlacementListService
@inject Radzen.NotificationService NotificationService
@inject BlazorContextMenu.IBlazorContextMenuService BlazorContextMenuService
@inject Impulse.Services.IReportNavigationService ReportNavigation

<PageTitle>Material Placement List</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                <h4 class="mb-0 text-primary d-flex align-items-center">
                    <i class="fas fa-list me-2"></i> Material Placement List
                </h4>
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="chkShowPicture" @bind="ShowPicture">
                    <label class="form-check-label fw-bold text-secondary" for="chkShowPicture" style="font-size: 0.8rem;">Show Picture</label>
                </div>
            </div>

            <!-- Filters -->
            <div class="row gx-2 mb-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Date Range</label>
                    <select class="form-select form-select-sm" @bind="Filter.DateRangeIndex" @bind:after="OnDateRangeChanged">
                        <option value="0">Today</option>
                        <option value="1">Last 15 Days</option>
                        <option value="2">Last 30 Days</option>
                        <option value="3">Last 60 Days</option>
                        <option value="4">Last 90 Days</option>
                        <option value="5">Custom</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">From Date</label>
                    <input type="date" class="form-control form-control-sm" @bind="Filter.DateFrom" disabled="@(Filter.DateRangeIndex != 5)" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">To Date</label>
                    <input type="date" class="form-control form-control-sm" @bind="Filter.DateTo" disabled="@(Filter.DateRangeIndex != 5)" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Vendor</label>
                    <BlazoredTypeahead SearchMethod="SearchVendors" @bind-Value="SelectedVendor" Placeholder="All Vendors..." EnableDropDown="true" class="blazored-typeahead">
                        <SelectedTemplate>@(((dynamic)context).AccTitle)</SelectedTemplate>
                        <ResultTemplate>@(((dynamic)context).AccTitle)</ResultTemplate>
                    </BlazoredTypeahead>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Material</label>
                    <BlazoredTypeahead SearchMethod="SearchMaterials" @bind-Value="SelectedMaterial" Placeholder="All Materials..." EnableDropDown="true" class="blazored-typeahead">
                        <SelectedTemplate>@(((dynamic)context).MaterialName)</SelectedTemplate>
                        <ResultTemplate>@(((dynamic)context).MaterialName)</ResultTemplate>
                    </BlazoredTypeahead>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-sm btn-primary w-100 shadow-sm" @onclick="LoadDataAsync" style="height: 35px;">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
            </div>

            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else if (PlacedMaterials != null)
            {
                <div class="table-responsive border rounded bg-white shadow-sm" style="max-height: 60vh; overflow-y: auto;">
                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 1; box-shadow: 0 1px 0 #dee2e6;">
                            <tr>
                                <th style="width: 50px;">S. #</th>
                                <th>Vendor</th>
                                <th>PO No.</th>
                                <th>Material</th>
                                <th>Location</th>
                                <th class="text-end">Qty</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!PlacedMaterials.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No placed materials found for the selected criteria.</td>
                                </tr>
                            }
                            else
                            {
                                int index = 1;
                                @foreach (var item in PlacedMaterials)
                                {
                                    <tr class="table-row-hover cursor-pointer" @onclick="() => SelectRowMaterial(item.RMID1)" @oncontextmenu="@(e => OpenRowContextMenu(e, item))" @oncontextmenu:preventDefault="true">
                                        <td>@(index++)</td>
                                        <td>@item.VendorName</td>
                                        <td>@item.PORefNo</td>
                                        <td>@item.MaterialName</td>
                                        <td>@item.Location</td>
                                        <td class="text-end fw-bold">@item.QtyPlaced.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<ContextMenu Id="rowContextMenu" Template="Win11Style" UseDefaultEventHandlers="true">
    <Item class="win11-menu-item" OnClick="OnPrintSlip">
        <i class="fas fa-print win11-icon text-secondary"></i> Print Slip
    </Item>
</ContextMenu>

<Impulse.Components.Stock.MaterialPictureViewer MaterialId="@SelectedMaterialId" ShowPicture="@ShowPicture" />

<style>
    .blazored-typeahead {
        height: 35px !important;
        font-size: 0.875rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input, .blazored-typeahead__controls {
        height: 33px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input-mask, .blazored-typeahead__input-mask-wrapper {
        height: 33px !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
    }
    .blazored-typeahead__input-icon {
        padding: 0 0.5rem !important;
        display: flex !important;
        align-items: center !important;
    }
    .form-control-sm, .form-select-sm, .input-group-text, .btn-sm {
        height: 35px !important;
    }
    .table-row-hover:hover {
        background-color: rgba(0, 0, 0, 0.04);
    }
    .cursor-pointer {
        cursor: pointer;
    }
    
    /* Prevent Context Menu from getting cut off */
    .win11-context-menu-container, .blazor-context-menu {
        max-height: 40vh !important;
        overflow-y: auto !important;
    }
</style>
