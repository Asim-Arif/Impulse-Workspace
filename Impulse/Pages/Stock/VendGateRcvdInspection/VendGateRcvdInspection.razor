@page "/stock/vend-rcv-list/inspection/{RcvID}"
@using DataAccessLibrary.Models.ViewModels.Stock
@using Impulse.Services.Stock
@attribute [Authorize]
@inject IVendGateRcvdInspectionService VendGateRcvdInspectionService
@inject Impulse.Services.INotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Receiving Lots Inspection</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">
            <div class="d-flex align-items-end pb-2 mb-3 border-bottom">
                <button type="button" class="btn btn-sm btn-outline-secondary me-3" @onclick="GoBack">
                    <i class="fas fa-arrow-left me-1"></i> Back to List
                </button>
                <h4 class="mb-0 text-primary d-flex align-items-center">
                    <i class="fas fa-microscope me-2"></i> Receiving Lots Inspection
                </h4>
            </div>

            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2 fw-bold">Loading Inspection Data...</p>
                </div>
            }
            else
            {
                <!-- Selected Material & Header Info -->
                <div class="row gx-2 mb-3">
                    <div class="col-md-5">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Select Material</label>
                        <BlazoredTypeahead SearchMethod="SearchMaterials" @bind-Value="SelectedMaterial" Placeholder="Select Material..." EnableDropDown="true">
                            <SelectedTemplate>@context.MaterialName</SelectedTemplate>
                            <ResultTemplate>@context.MaterialName</ResultTemplate>
                        </BlazoredTypeahead>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Order No</label>
                        <input type="text" class="form-control form-control-sm custom-input-sm" disabled value="@SelectedMaterial?.OrderNo" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Vendor</label>
                        <input type="text" class="form-control form-control-sm custom-input-sm" disabled value="@SelectedMaterial?.VendorName" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Date</label>
                        <input type="text" class="form-control form-control-sm custom-input-sm" disabled value="@(SelectedMaterial?.RcvDate.ToString("dd-MMM-yyyy"))" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Qty</label>
                        <input type="text" class="form-control form-control-sm custom-input-sm" disabled value="@SelectedMaterial?.QtyRcvd" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Size</label>
                        <input type="text" class="form-control form-control-sm custom-input-sm" disabled value="@SelectedMaterial?.RMSize" />
                    </div>
                </div>

                @if (SelectedMaterial != null && InspectionModel != null)
                {
                    <div class="table-responsive border rounded bg-white shadow-sm mb-3">
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                            <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                <tr>
                                    <th>Attributes Description</th>
                                    <th>AQL</th>
                                    <th>Sample Size</th>
                                    <th>Reject On</th>
                                    <th>Test Spec. No.</th>
                                    <th style="width: 150px;">Act. Rej.</th>
                                    <th style="width: 150px;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in InspectionModel.Details)
                                {
                                    <tr>
                                        <td>@item.ParameterName</td>
                                        <td>@item.AQL</td>
                                        <td>@item.SampleSize</td>
                                        <td>@item.RejectOn</td>
                                        <td>@item.TestSpecificationNo</td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="item.ActualRejection" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="item.Status" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="row gx-2 mb-3">
                        <div class="col-md-3">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Material Disposition</label>
                            <input type="text" class="form-control form-control-sm" @bind="InspectionModel.Disposation" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">General Remarks</label>
                            <input type="text" class="form-control form-control-sm" @bind="InspectionModel.Comments" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Date Insp.</label>
                            <input type="date" class="form-control form-control-sm" @bind="InspectionModel.DT" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end pb-1">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="inspStatus" id="radPass" value="true" checked="@InspectionModel.IsPassed" @onchange="@(() => InspectionModel.IsPassed = true)">
                                <label class="form-check-label text-success fw-bold" style="font-size: 0.9rem;" for="radPass">Pass</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="inspStatus" id="radFail" value="false" checked="@(!InspectionModel.IsPassed)" @onchange="@(() => InspectionModel.IsPassed = false)">
                                <label class="form-check-label text-danger fw-bold" style="font-size: 0.9rem;" for="radFail">Fail</label>
                            </div>
                        </div>
                        <div class="col-md-1 d-flex align-items-end justify-content-end">
                            <button class="btn btn-sm btn-primary w-100 shadow-sm" @onclick="SaveInspection">
                                <i class="fas fa-save me-1"></i> Save
                            </button>
                        </div>
                    </div>
                }
                else if (SelectedMaterial != null)
                {
                    <div class="alert alert-info py-2" style="font-size: 0.9rem;">
                        <i class="fas fa-info-circle me-1"></i> No inspection parameters found for this material group.
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .custom-input-sm {
        height: 35px !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead {
        height: 35px !important;
        font-size: 0.875rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input, .blazored-typeahead__controls {
        height: 33px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input-mask, .blazored-typeahead__input-mask-wrapper {
        height: 33px !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
    }
    .blazored-typeahead__input-icon {
        padding: 0 0.5rem !important;
        display: flex !important;
        align-items: center !important;
    }
</style>
