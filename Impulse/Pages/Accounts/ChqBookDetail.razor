@page "/accounts/chqbookdetail"
@attribute [Authorize]

@using BlazorContextMenu
@using DataAccessLibrary.Models.ViewModels.Accounts

<PageTitle>Cheque Book Details | Impulse ERP</PageTitle>

<style>
    .tree-node-bank {
        cursor: pointer;
        font-weight: 700;
        color: #1e3a8a;
        background-color: #f1f5f9;
        border-radius: 6px;
        padding: 6px 10px;
        transition: background-color 0.15s ease-in-out;
        user-select: none;
    }
    .tree-node-bank:hover {
        background-color: #e2e8f0;
    }
    .tree-node-bank.active-bank {
        background-color: #e0f2fe;
        color: #0369a1;
        border: 1px solid #7dd3fc;
    }
    .tree-node-branch {
        cursor: pointer;
        font-weight: 600;
        color: #475569;
        padding: 5px 8px;
        border-radius: 4px;
        transition: background-color 0.15s ease-in-out;
        user-select: none;
    }
    .tree-node-branch:hover {
        background-color: #f1f5f9;
    }
    .tree-node-account {
        cursor: pointer;
        padding: 6px 8px;
        border-radius: 6px;
        border-left: 3px solid transparent;
        transition: all 0.15s ease-in-out;
        user-select: none;
    }
    .tree-node-account:hover {
        background-color: #f8fafc;
        border-left-color: #0d6efd;
    }
    .tree-node-account.active {
        background-color: #e0f2fe;
        border-left-color: #0284c7;
        font-weight: 600;
        color: #0369a1;
    }
    .cursor-pointer {
        cursor: pointer;
    }
    .win11-context-menu-container .win11-menu-item {
        font-size: 0.85rem;
        padding: 6px 12px;
    }
    .win11-icon {
        margin-right: 8px;
        width: 16px;
        text-align: center;
    }
    .context-menu-list {
        max-height: 40vh;
        overflow-y: auto;
    }
</style>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">

            <!-- ── Page Header & Top Action Controls ──────────────────── -->
            <div class="d-flex align-items-end pb-2 mb-3 border-bottom flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:38px;height:38px;background:linear-gradient(135deg,#1565C0,#42A5F5);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-money-check text-white" style="font-size:1.05rem;"></i>
                    </div>
                    <div>
                        <h1 class="mb-0 fw-bold" style="font-size:1.25rem;color:#1565C0;">Cheque Book Details</h1>
                        <small class="text-muted" style="font-size:0.75rem;">Bank accounts explorer, cheque book register, clearance tracking and status management</small>
                    </div>
                </div>

                <div class="ms-auto d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary px-3" @onclick="GoBack">
                        <i class="fas fa-xmark me-1"></i> Close
                    </button>
                </div>
            </div>

            <!-- ── Main Top Section: Bank Explorer (Left) & Cheque Books (Right) ── -->
            <div class="row g-3">

                <!-- LEFT COLUMN: BANK ACCOUNTS EXPLORER (TreeView) -->
                <div class="col-lg-4 col-md-5">
                    <div class="card border h-100 shadow-sm" style="background: #ffffff; border-radius: 8px;">
                        <div class="card-header py-2 bg-light d-flex align-items-center justify-content-between" style="border-radius: 8px 8px 0 0;">
                            <span class="fw-bold text-secondary" style="font-size: 0.85rem;">
                                <i class="fas fa-building-columns text-primary me-1"></i> Bank Accounts Explorer
                            </span>
                            <span class="badge bg-primary fs-7">@Accounts.Count Accounts</span>
                        </div>

                        <!-- Instant Filter Input -->
                        <div class="p-2 border-bottom bg-light">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="fas fa-search"></i>
                                </span>
                                <input type="text"
                                       class="form-control border-start-0"
                                       placeholder="Filter bank, branch, account..."
                                       @bind="BankSearchText"
                                       @bind:event="oninput" />
                                @if (!string.IsNullOrWhiteSpace(BankSearchText))
                                {
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => BankSearchText = string.Empty">
                                        <i class="fas fa-times"></i>
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Tree Content -->
                        <div class="card-body p-2" style="max-height: 380px; overflow-y: auto;">
                            @if (IsLoading)
                            {
                                <div class="text-center py-4 text-muted">
                                    <span class="spinner-border spinner-border-sm text-primary me-1" role="status" aria-hidden="true"></span>
                                    <span style="font-size: 0.85rem;">Loading Bank Accounts...</span>
                                </div>
                            }
                            else
                            {
                                var treeGroups = GetTreeGroups();
                                @if (treeGroups.Any())
                                {
                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var bankGroup in treeGroups)
                                        {
                                            bool isBankExpanded = ExpandedBanks.Contains(bankGroup.BankName);
                                            bool isCurrentBank = SelectedAccount != null && SelectedAccount.Bank == bankGroup.BankName;
                                            <div class="border rounded p-1 bg-white">
                                                <!-- Level 1: Bank (Click to expand & select first account) -->
                                                <div class="tree-node-bank d-flex align-items-center justify-content-between @(isCurrentBank ? "active-bank" : "")"
                                                     @onclick="() => OnBankHeaderClick(bankGroup)"
                                                     title="Click to view bank accounts">
                                                    <span class="d-flex align-items-center gap-2">
                                                        <i class="fas @(isBankExpanded ? "fa-folder-open text-warning" : "fa-folder text-warning")"></i>
                                                        <span>@bankGroup.BankName</span>
                                                    </span>
                                                    <span class="badge bg-secondary-subtle text-secondary small">@bankGroup.Branches.Sum(b => b.Accounts.Count)</span>
                                                </div>

                                                @if (isBankExpanded)
                                                {
                                                    <div class="ms-3 mt-1 d-flex flex-column gap-1 border-start ps-2">
                                                        @foreach (var branchGroup in bankGroup.Branches)
                                                        {
                                                            bool isBranchExpanded = ExpandedBranches.Contains(branchGroup.BranchKey);
                                                            <div>
                                                                <!-- Level 2: Branch -->
                                                                <div class="tree-node-branch d-flex align-items-center justify-content-between"
                                                                     @onclick="() => OnBranchHeaderClick(branchGroup)"
                                                                     title="Click to toggle branch">
                                                                    <span class="d-flex align-items-center gap-1">
                                                                        <i class="fas @(isBranchExpanded ? "fa-chevron-down text-secondary" : "fa-chevron-right text-secondary")" style="font-size: 0.75rem;"></i>
                                                                        <i class="fas fa-code-branch text-primary me-1" style="font-size: 0.8rem;"></i>
                                                                        <span style="font-size: 0.82rem;">@branchGroup.BranchName</span>
                                                                    </span>
                                                                    <span class="badge bg-light text-secondary border small" style="font-size: 0.7rem;">@branchGroup.Accounts.Count</span>
                                                                </div>

                                                                @if (isBranchExpanded)
                                                                {
                                                                    <div class="ms-3 d-flex flex-column gap-1 border-start ps-2 mt-1">
                                                                        @foreach (var acc in branchGroup.Accounts)
                                                                        {
                                                                            bool isSelected = SelectedAccount?.AccNo == acc.AccNo;
                                                                            <ContextMenuTrigger WrapperTag="div"
                                                                                                MenuId="bankAccountContextMenu"
                                                                                                Data="acc"
                                                                                                MouseButtonTrigger="MouseButtonTrigger.Right">
                                                                                <div class="tree-node-account d-flex align-items-center justify-content-between @(isSelected ? "active" : "")"
                                                                                     @onclick="() => SelectBankAccount(acc)">
                                                                                    <div class="d-flex align-items-start gap-1 flex-grow-1" style="font-size: 0.82rem;">
                                                                                        <i class="fas fa-credit-card mt-1 @(isSelected ? "text-primary" : "text-muted")" style="font-size: 0.8rem;"></i>
                                                                                        <div class="d-flex flex-column">
                                                                                            <span class="fw-semibold text-truncate" style="max-width: 190px;" title="@acc.AccTitle">@acc.AccTitle</span>
                                                                                            <span class="text-muted small" style="font-size: 0.73rem;">[@acc.AccNo] @(string.IsNullOrEmpty(acc.BankAccNo) ? "" : $"• A/c {acc.BankAccNo}")</span>
                                                                                        </div>
                                                                                    </div>
                                                                                    <div class="d-flex align-items-center gap-1 ms-1">
                                                                                        @if (acc.DefaultBank)
                                                                                        {
                                                                                            <span class="badge bg-primary" style="font-size: 0.65rem;" title="Default Bank Account">Default</span>
                                                                                        }
                                                                                        @if (acc.AllowOD)
                                                                                        {
                                                                                            <span class="badge bg-warning text-dark" style="font-size: 0.65rem;" title="Overdraft Allowed">OD</span>
                                                                                        }
                                                                                        <ContextMenuTrigger MenuId="bankAccountContextMenu" Data="acc" MouseButtonTrigger="MouseButtonTrigger.Left">
                                                                                            <button class="btn btn-sm btn-link text-secondary p-0 ms-1" title="Account Options" @onclick:stopPropagation="true">
                                                                                                <i class="fas fa-ellipsis-vertical" style="font-size: 0.75rem;"></i>
                                                                                            </button>
                                                                                        </ContextMenuTrigger>
                                                                                    </div>
                                                                                </div>
                                                                            </ContextMenuTrigger>
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4 text-muted small">
                                        <i class="fas fa-search me-1"></i> No matching bank accounts found.
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- RIGHT COLUMN: CHEQUE BOOKS FOR SELECTED ACCOUNT -->
                <div class="col-lg-8 col-md-7">
                    <div class="card border h-100 shadow-sm" style="background: #ffffff; border-radius: 8px;">
                        <div class="card-header py-2 bg-light d-flex align-items-center justify-content-between flex-wrap gap-2" style="border-radius: 8px 8px 0 0;">
                            <div>
                                <span class="fw-bold text-secondary" style="font-size: 0.85rem;">
                                    <i class="fas fa-book-bookmark text-primary me-1"></i> Cheque Books
                                    @if (SelectedAccount != null)
                                    {
                                        <span class="text-dark fw-semibold ms-1">— [@SelectedAccount.AccNo] @SelectedAccount.AccTitle</span>
                                    }
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button class="btn btn-sm btn-primary fw-semibold" @onclick="ShowAddModal" disabled="@(SelectedAccount == null)">
                                    <i class="fas fa-plus-circle me-1"></i> New Cheque Book
                                </button>
                            </div>
                        </div>

                        <div class="card-body p-0">
                            <div class="table-responsive" style="max-height: 380px;">
                                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                                    <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                        <tr>
                                            <th style="width: 22%;">Starting From</th>
                                            <th style="width: 14%;" class="text-center">Total Chqs</th>
                                            <th style="width: 24%;">Manual Book #</th>
                                            <th style="width: 20%;">Bank Book #</th>
                                            <th style="width: 15%;" class="text-end">Status</th>
                                            <th style="width: 5%;" class="text-center"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (getDatafromdb.Any())
                                        {
                                            @foreach (var chqbook in getDatafromdb)
                                            {
                                                bool isBookSelected = SelectedChqBook?.ChqBookNo == chqbook.ChqBookNo;
                                                <ContextMenuTrigger WrapperTag="tr"
                                                                    MenuId="accountContextMenu"
                                                                    Data="chqbook"
                                                                    MouseButtonTrigger="MouseButtonTrigger.Right"
                                                                    CssClass="@($"cursor-pointer {(isBookSelected ? "table-primary fw-semibold" : "")}")"
                                                                    @onclick="@(() => OnChequeBookSelected(chqbook))">
                                                    <td>
                                                        <i class="fas fa-receipt text-primary me-1"></i> @chqbook.StartingFrom
                                                    </td>
                                                    <td class="text-center fw-semibold">@chqbook.Chqs</td>
                                                    <td>@(string.IsNullOrEmpty(chqbook.ManualNo) ? "-" : chqbook.ManualNo)</td>
                                                    <td>@(string.IsNullOrEmpty(chqbook.ChqBookDetail) ? "-" : chqbook.ChqBookDetail)</td>
                                                    <td class="text-end">
                                                        @if (chqbook.ChqsLeft == 0)
                                                        {
                                                            <span class="badge bg-danger">Used Completely</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success">@chqbook.ChqsLeft Chqs Left</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        <ContextMenuTrigger MenuId="accountContextMenu" Data="chqbook" MouseButtonTrigger="MouseButtonTrigger.Left">
                                                            <button class="btn btn-sm btn-link text-secondary p-0" title="Options" @onclick:stopPropagation="true">
                                                                <i class="fas fa-ellipsis-vertical"></i>
                                                            </button>
                                                        </ContextMenuTrigger>
                                                    </td>
                                                </ContextMenuTrigger>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center py-4 text-muted">
                                                    <i class="fas fa-info-circle me-1"></i>
                                                    @(SelectedAccount == null ? "Select a bank account from the explorer on the left." : "No cheque books found for this bank account.")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ── Bottom Full-Width Section: Individual Cheques Register ── -->
            @if (SelectedChqBook != null)
            {
                <div class="card border shadow-sm mt-3" style="background: #ffffff; border-radius: 8px;">
                    <div class="card-header py-2 bg-light d-flex align-items-center justify-content-between flex-wrap gap-2" style="border-radius: 8px 8px 0 0;">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="fw-bold text-secondary" style="font-size: 0.88rem;">
                                <i class="fas fa-list-check text-primary me-1"></i> Cheques Register — Book #@(string.IsNullOrEmpty(SelectedChqBook.ManualNo) ? SelectedChqBook.ChqBookDetail : SelectedChqBook.ManualNo) (Starting: @SelectedChqBook.StartingFrom)
                            </span>
                            <span class="badge bg-primary fs-7">Total: @SelectedChqBook.Chqs</span>
                            <span class="badge bg-success fs-7">Remaining: @SelectedChqBook.ChqsLeft</span>
                            <span class="badge bg-secondary fs-7">Issued: @(SelectedChqBook.Chqs - SelectedChqBook.ChqsLeft)</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-outline-primary fw-semibold" @onclick="PrintSelectedChqBookDetail" disabled="@(!getDatafromdb_chqsdata.Any())">
                                <i class="fas fa-print me-1"></i> Print Cheque Book Detail
                            </button>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive" style="min-height: 240px; max-height: 420px;">
                            <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                                <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                    <tr>
                                        <th style="width: 8%;" class="text-center">Chq No</th>
                                        <th style="width: 9%;">Type</th>
                                        <th style="width: 9%;">Issue Date</th>
                                        <th style="width: 9%;">Chq Date</th>
                                        <th style="width: 14%;">Account Title</th>
                                        <th style="width: 21%;">Description / Status</th>
                                        <th style="width: 9%;" class="text-end">Amount</th>
                                        <th style="width: 11%;">Payee</th>
                                        <th style="width: 10%;" class="text-center">Clearance</th>
                                        <th style="width: 4%;" class="text-center"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (getDatafromdb_chqsdata.Any())
                                    {
                                        @foreach (var chqs in getDatafromdb_chqsdata)
                                        {
                                            <ContextMenuTrigger WrapperTag="tr"
                                                                MenuId="ChqContextMenu"
                                                                Data="chqs"
                                                                MouseButtonTrigger="MouseButtonTrigger.Right"
                                                                CssClass="@($"key-{chqs.ChqNo}")">
                                                <td class="text-center fw-bold text-primary">@chqs.ChqNo</td>
                                                <td>
                                                    <span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(chqs.Chqtype) ? "Cheque" : chqs.Chqtype)</span>
                                                </td>
                                                <td>
                                                    @(chqs.CDate != DateTime.MinValue ? chqs.CDate.ToString("dd-MMM-yyyy") : "-")
                                                </td>
                                                <td>
                                                    @(chqs.ChequeDate != DateTime.MinValue ? chqs.ChequeDate.ToString("dd-MMM-yyyy") : "-")
                                                </td>
                                                <td>@(string.IsNullOrEmpty(chqs.AccTitle) ? "-" : chqs.AccTitle)</td>
                                                <td>
                                                    @if (chqs.Bounced)
                                                    {
                                                        <span class="badge bg-danger me-1"><i class="fas fa-triangle-exclamation me-1"></i>Bounced</span>
                                                        chqs.ChqStatus = "Bounced";
                                                    }
                                                    else if (chqs.Chqtype == "Canceled")
                                                    {
                                                        <span class="badge bg-danger me-1"><i class="fas fa-ban me-1"></i>Canceled</span>
                                                        <span class="text-danger small">@chqs.Description @chqs.DeleteDescription</span>
                                                        chqs.ChqStatus = "Canceled";
                                                    }
                                                    else if (chqs.Issued)
                                                    {
                                                        <span>@chqs.Description</span>
                                                        chqs.ChqStatus = "Issued";
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary border"><i class="fas fa-clock me-1"></i>Not Issued</span>
                                                        chqs.ChqStatus = "Not Issued";
                                                    }
                                                </td>
                                                <td class="text-end fw-semibold">
                                                    @(chqs.Amount > 0 ? chqs.Amount.ToString("#,##0.00") : "-")
                                                </td>
                                                <td>@(string.IsNullOrEmpty(chqs.Payee) ? "-" : chqs.Payee)</td>
                                                <td class="text-center">
                                                    <input type="date"
                                                           class="form-control form-control-sm text-center mx-auto"
                                                           style="width: 130px; font-size: 0.82rem;"
                                                           value="@GetDateInputValue(chqs.ClearanceDT)"
                                                           @onchange="@(e => OnClearanceDateChanged(chqs, e))"
                                                           title="Update clearance date" />
                                                </td>
                                                <td class="text-center">
                                                    <ContextMenuTrigger MenuId="ChqContextMenu" Data="chqs" MouseButtonTrigger="MouseButtonTrigger.Left">
                                                        <button class="btn btn-sm btn-link text-secondary p-0" title="Options" @onclick:stopPropagation="true">
                                                            <i class="fas fa-ellipsis-vertical"></i>
                                                        </button>
                                                    </ContextMenuTrigger>
                                                </td>
                                            </ContextMenuTrigger>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="10" class="text-center py-4 text-muted">
                                                <i class="fas fa-info-circle me-1"></i> No cheques found for this cheque book.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- ── Bottom Action Bar ──────────────────────────────────── -->
            <div class="d-flex justify-content-end align-items-center gap-2 mt-3 pt-2 border-top">
                <button class="btn btn-sm btn-outline-primary px-3 fw-semibold" @onclick="PrintSelectedChqBookDetail" disabled="@(SelectedChqBook == null || !getDatafromdb_chqsdata.Any())">
                    <i class="fas fa-print me-1"></i> Print Cheque Book
                </button>
                <button class="btn btn-sm btn-outline-secondary px-3 fw-semibold" @onclick="GoBack">
                    <i class="fas fa-xmark me-1"></i> Close
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- CONTEXT MENUS (Win11Style)                                             -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->

<!-- 1. BANK ACCOUNT CONTEXT MENU -->
<ContextMenu Id="bankAccountContextMenu" Template="Win11Style" class="win11-context-menu-container">
    <Item OnClick="MakeBankAccountDefault">
        <i class="fas fa-star fa-fw win11-icon text-warning"></i> Set As Default Bank Account
    </Item>
    <Item OnClick="ShowOverDraftModel">
        <i class="fas fa-shield-halved fa-fw win11-icon text-info"></i> Allow / Disallow Overdraft
    </Item>
    <Item OnClick="PrintChqBooks">
        <i class="fas fa-print fa-fw win11-icon text-primary"></i> Print Chq Books Summary
    </Item>
    <div class="menu-divider"></div>
    <Seperator />
    <Item OnClick="OpenLedger">
        <i class="fas fa-book fa-fw win11-icon text-secondary"></i> View Ledger For Last 30 Days
    </Item>
</ContextMenu>

<!-- 2. CHEQUE BOOK CONTEXT MENU -->
<ContextMenu Id="accountContextMenu" Template="Win11Style" class="win11-context-menu-container">
    <Item OnClick="@(() => RefreshChqBooks(SelectedAccount?.AccNo))">
        <i class="fas fa-sync-alt fa-fw win11-icon text-primary"></i> Refresh
    </Item>
    <div class="menu-divider"></div>
    <Seperator />
    <Item OnClick="ShowAddModal">
        <i class="fas fa-plus-circle fa-fw win11-icon text-success"></i> New Cheque Book
    </Item>
    <Item OnClick="DeleteChqBook">
        <i class="fas fa-trash fa-fw win11-icon text-danger"></i> Delete This Cheque Book
    </Item>
    <div class="menu-divider"></div>
    <Seperator />
    <Item OnClick="PrintChqBookDetail">
        <i class="fas fa-print fa-fw win11-icon text-primary"></i> Print This Cheque Book's Detail
    </Item>
</ContextMenu>

<!-- 3. INDIVIDUAL CHEQUE CONTEXT MENU -->
<ContextMenu Id="ChqContextMenu" Template="Win11Style" class="win11-context-menu-container" Context="itemContext">
    @{
        var selectedChq = itemContext.Data as ChqListModel;
        SelectedCheque = selectedChq;
    }
    @if (selectedChq != null && selectedChq.Amount == 0 && selectedChq.ChqStatus != "Canceled")
    {
        <Item OnClick="ShowCancelChqModel">
            <i class="fas fa-ban fa-fw win11-icon text-danger"></i> Cancel This Cheque
        </Item>
    }
    @if (selectedChq != null && selectedChq.ChqStatus == "Canceled")
    {
        <Item OnClick="@((e) => ChangeChequeStatus(0, e))">
            <i class="fas fa-rotate-left fa-fw win11-icon text-success"></i> Make This Cheque Uncanceled
        </Item>
    }
    @if (selectedChq != null && selectedChq.Amount > 0)
    {
        <Item OnClick="ShowPrintCheque">
            <i class="fas fa-print fa-fw win11-icon text-primary"></i> Print This Cheque
        </Item>
    }
</ContextMenu>

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- MODAL DIALOGS (MD3 Styled)                                             -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->

<!-- MODAL 1: ADD NEW CHEQUE BOOK -->
@if (ShowModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header py-2 bg-light border-bottom">
                    <h6 class="modal-title fw-bold text-primary mb-0">
                        <i class="fas fa-money-check me-2"></i> Add New Cheque Book
                    </h6>
                    <button type="button" class="btn-close" @onclick="HideModal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-2">
                        <label class="form-label small fw-bold text-secondary mb-1">Bank Account</label>
                        <input class="form-control form-control-sm bg-light" value="@($"[{SelectedAccount?.AccNo}] {SelectedAccount?.AccTitle}")" readonly />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary mb-1">Starting From <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" @bind="ChqBookModel.StartingFrom" placeholder="e.g. 18117501" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary mb-1">No. of Cheques <span class="text-danger">*</span></label>
                            <input type="number" class="form-control form-control-sm" @bind="ChqBookModel.Chqs" placeholder="25, 50, 100" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary mb-1">Manual Chq Book # <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" @bind="ChqBookModel.ManualNo" placeholder="Manual Book No" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary mb-1">Bank Chq Book #</label>
                            <input class="form-control form-control-sm" @bind="ChqBookModel.ChqBookDetail" placeholder="Bank Book No" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-light border-top">
                    <button class="btn btn-sm btn-outline-secondary px-3" @onclick="HideModal" disabled="@isSaving">Cancel</button>
                    <button class="btn btn-sm btn-primary px-3 fw-bold" @onclick="SaveChqBook" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="fas fa-check me-1"></i>
                        }
                        Save Cheque Book
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL 2: OVERDRAFT SETTINGS -->
@if (ShowODModel && SelectedBankAccount != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header py-2 bg-light border-bottom">
                    <h6 class="modal-title fw-bold text-primary mb-0">
                        <i class="fas fa-shield-halved me-2"></i>
                        Bank Overdraft Settings — @SelectedBankAccount.AccNo
                    </h6>
                    <button type="button" class="btn-close" @onclick="HideODModel"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="allowod" @bind="SelectedBankAccount.AllowOD" />
                        <label class="form-check-label fw-bold text-secondary" for="allowod">Allow Overdraft For This Account</label>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary mb-1">Overdraft Amount</label>
                            <input type="number" class="form-control form-control-sm" @bind="SelectedBankAccount.ODAmt" placeholder="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary mb-1">Overdraft Rate (%)</label>
                            <input type="number" step="0.01" class="form-control form-control-sm" @bind="SelectedBankAccount.ODRate" placeholder="0.00" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-light border-top">
                    <button class="btn btn-sm btn-outline-secondary px-3" @onclick="HideODModel" disabled="@isSaving">Cancel</button>
                    <button class="btn btn-sm btn-primary px-3 fw-bold" @onclick="SaveOverDraftData" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="fas fa-check me-1"></i>
                        }
                        Save Settings
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL 3: CANCEL CHEQUE -->
@if (bShowCancelChqModel && SelectedCheque != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.5); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header py-2 bg-light border-bottom">
                    <h6 class="modal-title fw-bold text-danger mb-0">
                        <i class="fas fa-ban me-2"></i> Cancel Cheque #@SelectedCheque.ChqNo
                    </h6>
                    <button type="button" class="btn-close" @onclick="HideCancelChqModel"></button>
                </div>
                <div class="modal-body p-3">
                    <p class="text-secondary small mb-2">Are you sure you want to cancel this cheque? Please enter a cancellation description / reason:</p>
                    <textarea class="form-control form-control-sm" rows="3" @bind="SelectedCheque.CancelReason" placeholder="Reason for cancellation (e.g. Void, Spoiled, Printed in error)..."></textarea>
                </div>
                <div class="modal-footer py-2 bg-light border-top">
                    <button class="btn btn-sm btn-outline-secondary px-3" @onclick="HideCancelChqModel">Cancel</button>
                    <button class="btn btn-sm btn-danger px-3 fw-bold" @onclick="MakeChequeCancel">
                        <i class="fas fa-check me-1"></i> Confirm Cancellation
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL 4: CHEQUE PRINTING -->
@if (bPrintCheque && SelectedCheque != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header py-2 bg-light border-bottom">
                    <h6 class="modal-title fw-bold text-primary mb-0">
                        <i class="fas fa-print me-2"></i> Cheque Printing — #@SelectedCheque.ChqNo
                    </h6>
                    <button type="button" class="btn-close" @onclick="HidePrintCheque"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-2">
                        <label class="form-label small fw-bold text-secondary mb-1">Payee</label>
                        <input class="form-control form-control-sm" @bind="SelectedCheque.chqpayee" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-secondary mb-1">Designation</label>
                            <input class="form-control form-control-sm" @bind="SelectedCheque.chqdesignation" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-secondary mb-1">Company</label>
                            <input class="form-control form-control-sm" @bind="SelectedCheque.chqcompany" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-secondary mb-1">Cheque Date</label>
                            <input type="date" class="form-control form-control-sm" @bind="SelectedCheque.chqprintdate" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-light border-top">
                    <button class="btn btn-sm btn-outline-secondary px-3" @onclick="HidePrintCheque">Cancel</button>
                    <button class="btn btn-sm btn-primary px-3 fw-bold" @onclick="PrintCheque">
                        <i class="fas fa-print me-1"></i> Print Cheque
                    </button>
                </div>
            </div>
        </div>
    </div>
}