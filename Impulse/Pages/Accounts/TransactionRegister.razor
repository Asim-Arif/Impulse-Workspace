@page "/accounts/transactionregister"
@page "/accounts/transactionregister/{p_VchrNo?}"

@attribute [Authorize]
<PageTitle>Transaction Register</PageTitle>

@using System.Collections.ObjectModel
@using Microsoft.AspNetCore.Components.Web
@using BlazorContextMenu
@using Microsoft.Extensions.Options
@using DataAccessLibrary
@using DataAccessLibrary.Models.ViewModels.Accounts
@using Impulse.Configurations
@using DataAccessLibrary.Interface.Accounts
@using Microsoft.AspNetCore.Components.Web.Virtualization

@using Microsoft.AspNetCore.Identity
@inject HttpClient Http
@inject IHttpClientFactory ClientFactory
@inject UserManager<IdentityUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IHttpContextAccessor HttpContextAccessor

@inject IJSRuntime JS
@inject NavigationManager Navigation


<style>
    .clickable-row:hover {
        background-color: rgba(192, 88, 0, 0.05) !important;
        cursor: pointer;
    }
    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 0.75rem;
        border-radius: 4px;
    }
    .win11-context-menu-container, .blazor-context-menu {
        max-height: 40vh !important;
        overflow-y: auto !important;
    }

    /* Keep the modal beautiful with glassmorphism */
    .glass-modal .modal-content {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: none;
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    }
    .glass-modal .modal-header {
        border-bottom: 1px solid rgba(0,0,0,0.05);
        background: rgba(248, 249, 250, 0.8);
        border-radius: 12px 12px 0 0;
    }
    .glass-modal .modal-footer {
        border-top: 1px solid rgba(0,0,0,0.05);
        background: rgba(248, 249, 250, 0.8);
        border-radius: 0 0 12px 12px;
    }
    .filter-check-group .form-check {
        margin-right: 15px;
    }
</style>

<style>
    .voucher-start td {
        border-top: 2px solid #badbcc !important;
    }
</style>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body pt-3">
            <!-- Title -->
            <div class="d-flex justify-content-between align-items-end pb-2 mb-3 border-bottom">
                <h5 class="mb-0 fw-bold text-dark-emphasis">
                    <i class="fas fa-book text-primary me-2"></i>
                    Transaction Register
                </h5>
                <button class="btn btn-outline-secondary btn-sm fw-semibold" @onclick="GoToIndexPage">
                    <i class="fas fa-xmark me-1"></i> Close
                </button>
            </div>

            <!-- Filter Row -->
            <div class="d-flex flex-wrap gap-3 mb-3 align-items-end">
                <div class="filter-check-group">
                    <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                        <span class="badge bg-secondary">Voucher Type</span>
                        <div class="form-check form-check-inline form-switch m-0">
                            <input class="form-check-input" type="checkbox" id="chkJournal" @bind="IsJournal" />
                            <label class="form-check-label fw-semibold" for="chkJournal">JV</label>
                        </div>
                        <div class="form-check form-check-inline form-switch m-0">
                            <input class="form-check-input" type="checkbox" id="chkBPV" @bind="IsBPV" />
                            <label class="form-check-label fw-semibold" for="chkBPV">BPV</label>
                        </div>
                        <div class="form-check form-check-inline form-switch m-0">
                            <input class="form-check-input" type="checkbox" id="chkCPV" @bind="IsCPV" />
                            <label class="form-check-label fw-semibold" for="chkCPV">CPV</label>
                        </div>
                        <div class="form-check form-check-inline form-switch m-0">
                            <input class="form-check-input" type="checkbox" id="chkCRV" @bind="IsCRV" />
                            <label class="form-check-label fw-semibold" for="chkCRV">CRV</label>
                        </div>
                        <div class="form-check form-check-inline form-switch m-0">
                            <input class="form-check-input" type="checkbox" id="chkBRV" @bind="IsBRV" />
                            <label class="form-check-label fw-semibold" for="chkBRV">BRV</label>
                        </div>
                    </div>
                </div>

                <div style="width: 140px;">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">From Date</label>
                    <input type="date" class="form-control form-control-sm" @bind="CurrentAccount.DTFrom" />
                </div>
                <div style="width: 140px;">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">To Date</label>
                    <input type="date" class="form-control form-control-sm" @bind="CurrentAccount.DTTo" />
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm px-3" @onclick="RefreshLedger" disabled="@IsLoading">
                        <i class="fas fa-sync-alt @(IsLoading ? "fa-spin" : "") me-1"></i> Refresh
                    </button>
                    <button class="btn btn-outline-primary btn-sm px-3" @onclick="PrintTransactionRegisterReport" disabled="@IsLoading" title="Print Transaction Register">
                        <i class="fas fa-print me-1"></i> Print Register
                    </button>
                </div>
            </div>
            
            @if (IsLoading)
            {
                <div class="progress" style="width: 100%">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                         role="progressbar" style="width: 100%">
                        Loading Transaction Data...
                    </div>
                </div>
            }
            else if (LedgerDatafromDB?.Any() ?? false)
            {
                <div class="card border border-light-subtle rounded-3 overflow-hidden shadow-xs">
                    <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                    <ContextMenuProvider Id="accountsContextMenu">
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">

                            <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                <tr>
                                    <th style="width: 7%;" class="text-center">Dated</th>
                                    <th style="width: 11%;">Voucher</th>
                                    <th style="width: 15%;">Account</th>
                                    <th style="width: 25%;">Description</th>
                                    <th style="width: 8%;" class="text-end">Debit</th>
                                    <th style="width: 8%;" class="text-end">Credit</th>
                                    <th style="width: 9%;" class="text-center">Chq #</th>
                                    <th style="width: 7%;" class="text-center">Chq Date</th>
                                    <th style="width: 8%;">Handed Over To</th>
                                    <th style="width: 2%;"> </th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var group in LedgerGroups)
                                {
                                    <!-- ******* GROUP HEADER ROW ******* -->
                                    <tr class="table-success">
                                        <td colspan="11" class="text-start fw-bold" style="color: #007d00;">
                                            @(group.Key == "BPV"
                                                    ? "Bank Payment Transactions"
                                                    : group.Key == "CPV"
                                                    ? "Cash Payment Transactions"
                                                    : group.Key == "BRV"
                                                    ? "Bank Receipt Transactions"
                                                    : group.Key == "CRV"
                                                    ? "Cash Receipt Transactions"
                                                    : group.Key == "JV"
                                                    ? "Journal Transactions"
                                                    : "Other")
                                        </td>
                                    </tr>

                                    <Virtualize Items="@LedgerDatafromDB.Where(x => x.VoucherType == group.Key).GroupBy(x => x.VchrNo).ToList()"
                                                Context="voucherGroup">
                                        @foreach(var ledger in voucherGroup)
                                        {
                                            var isFirst = ledger == voucherGroup.First();
                                            <ContextMenuTrigger WrapperTag="tr"
                                                    MenuId="accountContextMenu"
                                                    Data="ledger"
                                                    tabindex="0"
                                                    MouseButtonTrigger="MouseButtonTrigger.Right"
                                                    CssClass="@($"clickable-row key-{ledger.VchrNo} {(ledger.VchrNo == pVoucherNo ? "table-primary" : "")} {(isFirst ? "voucher-start" : "")}")"
                                                    Id="@($"row-{ledger.VchrNo}")"        
                                            >
                                                <td class="text-center">@(isFirst ? ledger.VDate.ToString("dd-MMM-yyyy") : "")</td>
                                                <td class="fw-bold text-nowrap">@(isFirst ? ledger.VchrNo : "")</td>
                                                <td class="text-truncate" style="max-width: 180px;" title="@ledger.AccTitle">@ledger.AccTitle</td>
                                                <td>@ledger.Description</td>
                                                <td class="text-end text-success fw-semibold">@(ledger.Debit == 0 ? "" : ledger.Debit.ToString("N2"))</td>
                                                <td class="text-end text-danger fw-semibold">@(ledger.Credit == 0 ? "" : ledger.Credit.ToString("N2"))</td>

                                                <td class="text-center">
                                                    @if (!string.IsNullOrEmpty(ledger.ChqNo))
                                                    {
                                                        <span class="badge bg-info text-dark">
                                                            <i class="fas fa-money-check me-1"></i> @ledger.ChqNo
                                                        </span>
                                                    }
                                                </td>
                                                <td class="text-center">@(ledger.ChqDate == DateTime.MinValue ? "" : ledger.ChqDate.ToString("dd-MMM-yyyy"))</td>
                                                <td>@ledger.Handed_Over_To</td>

                                                <td class="text-center">
                                                    <ContextMenuTrigger MenuId="accountContextMenu"
                                                             Data="ledger"
                                                             MouseButtonTrigger="MouseButtonTrigger.Left">
                                                        <button class="btn btn-sm text-secondary p-0" style="border:none; background:none;">
                                                            <i class="fas fa-ellipsis-v"></i>
                                                        </button>
                                                    </ContextMenuTrigger>
                                                </td>
                                            </ContextMenuTrigger>
                                        }
                                 </Virtualize>
                                }
                            </tbody>

                        </table>
                    </ContextMenuProvider>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-file-invoice fa-3x mb-3 text-light"></i><br/>
                    No Transaction Entries Found.
                </div>
            }
        </div>
    </div>
</div>

<!-- CONTEXT MENU -->
<ContextMenu Id="accountContextMenu"
        UseDefaultEventHandlers="true"
             Template="Win11Style">

        <Item class="menu-item" OnClick="@RefreshLedger">
        <i class="fas fa-sync-alt fa-fw win11-icon text-primary"></i> Refresh
        </Item>

        <div class="menu-divider"></div>

        <Item class="menu-item" OnClick="@(async e => await DeleteSelectedVoucher(e))">
        <i class="fas fa-trash-alt fa-fw win11-icon text-danger"></i> Delete Voucher
        </Item>

        <Item class="menu-item" OnClick="@(async e => await EditSelectedVoucher(e))">
        <i class="fas fa-pen-to-square fa-fw win11-icon text-warning"></i> Edit Voucher
        </Item>

        <div class="menu-divider"></div>

        <Item class="menu-item" OnClick="@(async e => await PrintVoucher(e))">
            <i class="fas fa-ticket fa-fw win11-icon text-primary"></i> Print This Voucher
        </Item>
        <Item class="menu-item" OnClick="@(async e => await PrintVoucher(e))">
            <i class="fas fa-file-pdf fa-fw win11-icon text-info"></i> Preview This Voucher
        </Item>
        <Item class="menu-item" OnClick="@(async e => await ShowPrintChequeModal(e))">
            <i class="fas fa-money-check fa-fw win11-icon text-success"></i> Print Cheque
        </Item>

</ContextMenu>

<!-- Modal for New/Edit Bank -->
@if (ShowModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered modal-xl glass-modal" role="document">
            <div class="modal-content">
                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title fw-bold d-flex align-items-center text-dark-emphasis">
                        <i class="bi bi-bank me-2 text-danger"></i>
                        Delete Voucher
                    </h5>
                    <button type="button" class="btn-close" @onclick="HideModal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="row" style="font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">

                        <div class="col-md-4 mb-2">
                            <label class="fw-semibold">Acc No :</label>
                            <input class="form-control" @bind="SelectedVoucher.AccNo" readonly />
                        </div>

                        <div class="col-md-4 mb-2">
                            <label class="fw-semibold">Acc Title :</label>
                            <input class="form-control" @bind="SelectedVoucher.AccTitle" readonly />
                        </div>

                        <div class="col-md-4 mb-2">
                            <label class="fw-semibold">Voucher # :</label>
                            <input class="form-control" @bind="SelectedVoucher.VchrNo" readonly />
                        </div>

                        <div class="col-md-4 mb-2">
                            <label class="fw-semibold">Date :</label>
                            <input class="form-control" @bind="SelectedVoucher.VDate"
                                   @bind:format="yyyy-MM-dd" / readonly>
                        </div>

                        <div class="col-md-8 mb-2">
                            <label class="fw-semibold">Description</label>
                            <input class="form-control" @bind="SelectedVoucher.Description" readonly />
                        </div>

@* --------------------------------- *@
                <div style="width: 100%">
                    <table class="table table-bordered table-hover align-middle mb-2 mt-2"
                           style="font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 8pt;">

                        <thead class="theme-color">
                            <tr>
                                <th style="width: 20%;">Acc #</th>
                                <th style="width: 50%;">AccTitle</th>
                                <th style="width: 15%;" class="text-end">Debit</th>
                                <th style="width: 15%;" class="text-end">Credit</th>
                            </tr>
                        </thead>

                                <tbody style="font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size:8pt;">
                        @foreach (var ledger in LedgerDatafromDB_temp)
                         { 
                             <tr>
                                <td>@ledger.AccNo</td>
                                <td>@ledger.AccTitle</td>
                                <td class="text-end">@ledger.Debit</td>
                                <td class="text-end">@ledger.Credit</td>
                            </tr>
                         }
                        </tbody>
                    </table>
                </div>
@* END FOR TABLE *@

                    <div class="row ">
                            <div class="col-md-4 mb-2">

                            </div>

                            <div class="col-md-4 mb-2">
                                <label class="fw-semibold">User Name</label>
                                <input class="form-control" @bind="SelectedVoucher.GeneratedBy" readonly />
                            </div>

                            <div class="col-md-4 mb-2">
                                <label class="fw-semibold">Computer</label>
                                <input class="form-control" @bind="SelectedVoucher.MachineName" readonly />
                            </div>
                        </div>
                    </div>
                    </div>
                    
                    <div class="modal-footer">
                        <div class="w-100 mb-2">
                            <label class="fw-semibold text-secondary mb-1">Reason of Deletion :</label>
                            <textarea class="form-control" rows="2" @bind="SelectedVoucher.DeleteReason" placeholder="Enter reason for deletion..."></textarea>
                        </div>
                        <div class="d-flex justify-content-end w-100 gap-2">
                            <button class="btn btn-secondary px-4" @onclick="HideModal">Cancel</button>
                            <button class="btn btn-danger px-4 fw-bold" @onclick="DeleteVoucher">
                                <i class="fas fa-trash-alt me-1"></i> Delete Voucher
                            </button>
                        </div>
                    </div>

                </div>
        </div>
    </div>
}

@if (bPrintCheque)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="z-index: 1050; font-family: Calibri, sans-serif; display: flex; align-items: center; justify-content: center; background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg border-0" style="border-radius: 12px; overflow: hidden;">
                <!-- Header -->
                <div class="modal-header text-white" style="background-color: rgb(7, 44, 96);">
                    <h5 class="modal-title fw-bold d-flex align-items-center mb-0">
                        <i class="fas fa-money-check me-2"></i>
                        Cheque Printing
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="HidePrintCheque"></button>
                </div>

                <div class="modal-body p-3">
                    <div class="row g-2">
                        <div class="col-md-12">
                            <label class="fw-semibold form-label small mb-1">Payee</label>
                            <input class="form-control form-control-sm" @bind="SelectedCheque.chqpayee" />
                        </div>
                        <div class="col-md-4">
                            <label class="fw-semibold form-label small mb-1">Designation</label>
                            <input class="form-control form-control-sm" @bind="SelectedCheque.chqdesignation" />
                        </div>
                        <div class="col-md-4">
                            <label class="fw-semibold form-label small mb-1">Company</label>
                            <input class="form-control form-control-sm" @bind="SelectedCheque.chqcompany" />
                        </div>
                        <div class="col-md-4">
                            <label class="fw-semibold form-label small mb-1">Cheque Date</label>
                            <input class="form-control form-control-sm" type="date" @bind="SelectedCheque.chqprintdate" />
                        </div>
                    </div>

                    <div class="mt-3 text-end d-flex justify-content-end gap-2">
                        <button class="btn btn-sm btn-secondary px-3" @onclick="HidePrintCheque">Cancel</button>
                        <button class="btn btn-sm text-white px-3" style="background-color: rgb(7, 44, 96);" @onclick="PrintChequeConfirm">
                            <i class="fas fa-print me-1"></i> Print Cheque
                        </button>
                    </div>
                </div>  
            </div>
        </div>
    </div>
}