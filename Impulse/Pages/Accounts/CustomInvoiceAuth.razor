@page "/accounts/custominvoiceauth"
@using Blazored.Typeahead
@using DataAccessLibrary.Models.ViewModels.Accounts
@using DataAccessLibrary.Models.ViewModels.Export
@attribute [Authorize]

<PageTitle>Custom Invoice Authorization</PageTitle>

<style>
    .clickable-row:hover {
        background-color: rgba(192, 88, 0, 0.05) !important;
    }
    /* Fix Blazored Typeahead height to match .form-control-sm */
    .blazored-typeahead {
        height: 31px !important;
        font-size: 0.875rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }
    .blazored-typeahead__input, .blazored-typeahead__controls {
        height: 29px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }
    .blazored-typeahead__input-icon {
        padding: 0 0.5rem !important;
        display: flex !important;
        align-items: center !important;
    }
    .exch-rate-input {
        max-width: 110px;
        margin-left: auto;
    }
    .sortable {
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
    }
    .sortable:hover {
        color: #0d6efd;
    }
</style>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body pt-3">
            <!-- Title -->
            <div class="d-flex align-items-end pb-2 mb-3 border-bottom">
                <h5 class="mb-0 fw-bold text-dark-emphasis">
                    <i class="fas fa-file-signature text-primary me-2"></i>
                    Custom Invoice Authorization
                </h5>
            </div>

            @* Legacy Form_Load: Exch. Diff. Account not found in general data -> vbCritical + cmdUpdate.Enabled = False *@
            @if (!authorizeEnabled)
            {
                <div class="alert alert-danger py-2" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>Exch. Diff. Account not found in general data. Authorization is disabled.
                </div>
            }

            <!-- Filter Row (legacy: cmbCust / cmbCountry / cmbRange / DtFrom / DtTo / cmdRefresh) -->
            <div class="row g-2 mb-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Customer</label>
                    <BlazoredTypeahead SearchMethod="SearchCustomers"
                                       EnableDropDown="true"
                                       Data="customers"
                                       TValue="CustomerLookupModel"
                                       TItem="CustomerLookupModel"
                                       Value="selectedCustomer"
                                       ValueChanged="OnCustomerChanged"
                                       ValueExpression="@(() => selectedCustomer)"
                                       Placeholder="<All Customers>"
                                       MaximumSuggestions="1000">
                        <SelectedTemplate Context="selectedCust">
                            @selectedCust?.CustCode
                        </SelectedTemplate>
                        <ResultTemplate Context="cust">
                            @cust.CustCode
                        </ResultTemplate>
                    </BlazoredTypeahead>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Country</label>
                    <select class="form-select" value="@selectedCountry" @onchange="OnCountryChanged" style="height: 31px;">
                        <option value="">&lt;All Countries&gt;</option>
                        @foreach (var c in countries)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Range</label>
                    <select class="form-select" @bind="selectedDateRange" style="height: 31px;" @bind:after="OnDateRangeChanged">
                        <option value="0">Todays</option>
                        <option value="15">Last 15 Days</option>
                        <option value="30">Last 30 Days</option>
                        <option value="60">Last 60 Days</option>
                        <option value="90">Last 90 Days</option>
                        <option value="180">Last 180 Days</option>
                        <option value="custom">Date Range</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">From</label>
                    <input type="date" class="form-control form-control-sm" style="height: 31px;" @bind="fromDate" disabled="@(selectedDateRange != "custom")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">To</label>
                    <input type="date" class="form-control form-control-sm" style="height: 31px;" @bind="toDate" disabled="@(selectedDateRange != "custom")" />
                </div>
                <div class="col-md-2 d-flex justify-content-end">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LoadData" title="Refresh">
                        <i class="fas fa-sync-alt"></i> Refresh
                    </button>
                </div>
            </div>

            <!-- Grid (legacy: LV ListView with checkboxes) -->
            @if (isLoading)
            {
                <div class="d-flex align-items-center justify-content-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="card border border-light-subtle rounded-3 overflow-hidden shadow-xs">
                    <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                            <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                <tr>
                                    <th style="width: 40px;"></th>
                                    <th class="sortable" @onclick='() => SortBy("SNo")'>S. # <i class="fas @GetSortIcon("SNo")"></i></th>
                                    <th class="sortable" @onclick='() => SortBy("Customer")'>Customer <i class="fas @GetSortIcon("Customer")"></i></th>
                                    <th class="sortable" @onclick='() => SortBy("Country")'>Country <i class="fas @GetSortIcon("Country")"></i></th>
                                    <th class="sortable" @onclick='() => SortBy("Invoice")'>Invoice # <i class="fas @GetSortIcon("Invoice")"></i></th>
                                    <th class="sortable" @onclick='() => SortBy("DT")'>Invoice DT <i class="fas @GetSortIcon("DT")"></i></th>
                                    <th class="sortable text-end" @onclick='() => SortBy("Amt")'>Invoice Amt <i class="fas @GetSortIcon("Amt")"></i></th>
                                    <th class="sortable text-end" @onclick='() => SortBy("Rate")'>Exch. Rate <i class="fas @GetSortIcon("Rate")"></i></th>
                                    <th class="sortable text-end" @onclick='() => SortBy("AmtPK")'>Amt PK <i class="fas @GetSortIcon("AmtPK")"></i></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (SortedItems.Any())
                                {
                                    int index = 1;
                                    @foreach (var item in SortedItems)
                                    {
                                        var rowItem = item;
                                        <tr @key="rowItem.CustomInvoice" class="clickable-row" @ondblclick="() => BeginRateEdit(rowItem)" title="Check the row or double-click to enter the exchange rate">
                                            <td class="text-center">
                                                <input class="form-check-input" type="checkbox" checked="@rowItem.IsChecked" @onchange="(e) => OnRowChecked(rowItem, e)" />
                                            </td>
                                            <td>@(index++)</td>
                                            <td>@rowItem.CustCode</td>
                                            <td>@rowItem.Country</td>
                                            <td>@rowItem.CustomInvoice</td>
                                            <td>@rowItem.DT?.ToString("dd-MMM-yyyy")</td>
                                            <td class="text-end">@($"{rowItem.Curr} {rowItem.TotalCustomAmt:N2}")</td>
                                            <td class="text-end">
                                                @if (rowItem.IsEditingRate)
                                                {
                                                    <input type="number" step="any" class="form-control form-control-sm text-end exch-rate-input"
                                                           @bind="rowItem.EditingExchRate" @bind:event="oninput"
                                                           @onchange="() => CommitRateEdit(rowItem)"
                                                           @onkeydown="(e) => OnRateKeyDown(e, rowItem)" />
                                                }
                                                else if (rowItem.ExchRate > 0)
                                                {
                                                    @rowItem.ExchRate.ToString("0.####")
                                                }
                                            </td>
                                            <td class="text-end">@(rowItem.AmtInPakRs > 0 ? rowItem.AmtInPakRs.ToString("N0") : "")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center py-4 text-muted">
                                            <i class="fas fa-inbox fa-2x mb-2 text-light"></i>
                                            <p class="mb-0">No invoices pending authorization found matching your filters.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer bg-white border-0 py-2 text-muted" style="font-size: 0.8rem;">
                        Total Records: @allItems.Count &nbsp;|&nbsp; Selected: @allItems.Count(x => x.IsChecked)
                    </div>
                </div>
            }

            <!-- Authorization Bar (legacy: CmbAccTitle / DTVchr / cmdUpdate / cmdClose) -->
            <div class="row g-2 mt-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Sales Account :</label>
                    <BlazoredTypeahead SearchMethod="SearchSalesAccounts"
                                       EnableDropDown="true"
                                       Data="salesAccounts"
                                       TValue="ChartOfAccountsModel"
                                       TItem="ChartOfAccountsModel"
                                       Value="selectedSalesAccount"
                                       ValueChanged="OnSalesAccountChanged"
                                       ValueExpression="@(() => selectedSalesAccount)"
                                       Placeholder="Select Account No."
                                       MaximumSuggestions="1000">
                        <SelectedTemplate Context="selectedAcc">
                            @selectedAcc?.AccTitle
                        </SelectedTemplate>
                        <ResultTemplate Context="acc">
                            @acc.AccTitle
                        </ResultTemplate>
                    </BlazoredTypeahead>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;">Voucher Date :</label>
                    <input type="date" class="form-control form-control-sm" style="height: 31px;" @bind="voucherDate" />
                </div>
                <div class="col-md-6 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-primary btn-sm" disabled="@(!authorizeEnabled || isAuthorizing)" @onclick="AuthorizeSelectedInvoices">
                        <i class="fas fa-check-double me-1"></i> @(isAuthorizing ? "Authorizing..." : "Authorize Selected Invoices")
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Close">
                        <i class="fas fa-times me-1"></i> Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
