@page "/accounts/accountgroups"
@attribute [Authorize]
<PageTitle>Account Groups</PageTitle>

@using DataAccessLibrary.Models.ViewModels.Accounts
@using Impulse.Configurations
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using BlazorContextMenu

<div class="container-fluid mt-0 m-0 p-0" style="font-family: Calibri, sans-serif; ">

    <div class="card shadow-sm border-0 rounded-1 bg-transparent">
        <div class="card-header text-white d-flex justify-content-between align-items-center rounded-top-4 px-3 py-2 theme-color" style="position: sticky; top: 0; z-index: 1000;">
            <h5 class="mb-0"><i class="fas fa-layer-group"></i> Account Groups</h5>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-light btn-sm fw-semibold" @onclick="ShowAddModal">
                    <i class="fas fa-plus me-2"></i> Add Group
                </button>
                <button class="btn btn-light btn-sm fw-semibold" @onclick="GoToIndexPage">
                    <i class="fas fa-xmark me-2"></i> Close
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            @if (IsLoading)
            {
                <div class="progress" style="width: 100%">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                         role="progressbar" style="width: 100%">
                        Loading Data...
                    </div>
                </div>
            }
            else if (GroupsList?.Any() ?? false)
            {
                <div style="width: 100%">
                    <ContextMenuProvider Id="groupContextMenuProvider">
                        <table class="table table-bordered table-hover align-middle mb-0"
                               style="font-family: Calibri, 'Segoe UI', Tahoma, sans-serif; font-size: 10pt;">
                            <thead class="theme-color"
                                   style="font-family: Calibri, 'Segoe UI', Tahoma, sans-serif; font-size: 10pt;">                                   
                                <tr>
                                    <th scope="col" style="width: 45%;">Group Name</th>
                                    <th scope="col" style="width: 30%;">Type</th>
                                    <th scope="col" style="width: 20%;" class="text-center">Sort No</th>
                                    <th scope="col" style="width: 5%;"> </th>
                                </tr>
                            </thead>

                            <tbody style="font-family: Calibri, 'Segoe UI'; font-size: 9pt;">
                                <Virtualize Items="@GroupsList" Context="group">
                                    <ContextMenuTrigger WrapperTag="tr"
                                            MenuId="groupContextMenu"
                                            Data="group"
                                            MouseButtonTrigger="MouseButtonTrigger.Right"
                                            @key="group.EntryID"> 

                                        <td style="width: 45%;">@group.GroupName</td>
                                        <td style="width: 30%;">@(group.Type == 0 ? "Expense" : "Income")</td>
                                        <td class="text-center" style="width: 20%;">@group.SortNo</td>
                                        
                                        <td style="width: 5%;">
                                            <ContextMenuTrigger 
                                                MenuId="groupContextMenu"
                                                Data="group"
                                                MouseButtonTrigger="MouseButtonTrigger.Both">

                                                <button class="btn btn-sm btn-primary" style="border:none; background:none;">
                                                    <i class="fa-solid fa-ellipsis-vertical" style="color:black "></i>
                                                </button>
                                            </ContextMenuTrigger>
                                        </td>
                                    </ContextMenuTrigger>
                                </Virtualize>
                            </tbody>
                        </table>
                    </ContextMenuProvider>
                </div>
            }
            else
            {
                <div class="text-center py-3 text-muted">No groups found.</div>
            }
        </div>
    </div>
</div>

<ContextMenu Id="groupContextMenu" 
             UseDefaultEventHandlers="true"
             Template="Win11Style">

    <Item OnClick="ShowEditModal" class="menu-item">
        <i class="fas fa-pen fa-fw win11-icon"></i> Edit
    </Item>
    <Item OnClick="@(async (e) => await DeleteSelectedGroup(e))" class="menu-item">
        <i class="fas fa-trash-alt fa-fw win11-icon"></i> Delete
    </Item>

</ContextMenu>

@if (ShowModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); font-family: Calibri, sans-serif;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-2 shadow-lg border-0 rounded-3">
                <div class="modal-header theme-color text-white rounded-top-4">
                    <h5 class="modal-title fw-bold d-flex align-items-center">
                        <i class="fas fa-layer-group me-2"></i>
                        @(IsEdit ? "Edit Account Group" : "Add Account Group")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="HideModal" aria-label="Close"></button>
                </div>
                <div class="modal-body bg-light">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Group Name</label>
                        <input type="text" class="form-control" @bind="CurrentGroup.GroupName" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Type</label>
                        <select class="form-select" @bind="CurrentGroup.Type">
                            <option value="0">Expense</option>
                            <option value="1">Income</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Sort No</label>
                        <input type="number" class="form-control" @bind="CurrentGroup.SortNo" />
                    </div>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="HideModal">Close</button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="SaveGroup">Save changes</button>
                </div>
            </div>
        </div>
    </div>
}
