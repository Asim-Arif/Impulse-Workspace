@page "/accounts/transactionregister_adjustment"
@page "/accounts/transactionregister_adjustment/{p_VchrNo?}"

@attribute [Authorize]
<PageTitle>Transaction Register</PageTitle>

@using System.Collections.ObjectModel
@using Microsoft.AspNetCore.Components.Web
@using BlazorContextMenu
@using Microsoft.Extensions.Options
@using DataAccessLibrary
@using DataAccessLibrary.Models.ViewModels.Accounts
@using Impulse.Configurations
@using DataAccessLibrary.Interface.Accounts
@using Impulse.Components.Common
@using Microsoft.AspNetCore.Components.Web.Virtualization

@using Microsoft.AspNetCore.Identity
@inject HttpClient Http
@inject IHttpClientFactory ClientFactory
@inject UserManager<IdentityUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IHttpContextAccessor HttpContextAccessor

@inject IJSRuntime JS
@inject NavigationManager Navigation


<div class="container-fluid mt-0" style="font-family: Calibri, sans-serif;">
        <div class="card-header text-white d-flex justify-content-between align-items-center rounded-top-4 px-3 py-2 theme-color"
             style="position: sticky; top: 0; z-index: 1000;">

            <h5 class="mb-0"><i class="fas fa-book"></i> Transaction Register (Adjusted) </h5>
            
            <div class="d-flex align-items-center gap-2">
            <button class="btn btn-light btn-sm fw-semibold" @onclick="PrintTransaction">
                    <i class="fas fa-file-pdf fa-fw me-2"></i> Print
                </button>
                <button class="btn btn-light btn-sm fw-semibold" @onclick="GoToIndexPage">
                    <i class="fas fa-times"></i> Close
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="row mb-1 align-items-end">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input shadow-sm" type="checkbox" id="chkJournal" @bind="IsJournal" />
                            <label class="form-check-label fw-bold" for="chkJournal">Journal</label>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <label for="fromDate" class="form-label fw-bold">From:</label>
                        <input type="date" id="fromDate" class="form-control form-control-sm shadow-sm" @bind="CurrentAccount.DTFrom" />
                    </div>

                    <div class="col-md-2">
                        <label for="toDate" class="form-label fw-bold">To:</label>
                    <input type="date" id="toDate" class="form-control form-control-sm shadow-sm" @bind="CurrentAccount.DTTo" />
                    </div>

                    <div class="col-md-2 mt-4">
                        <label for="toDate" class="form-label fw-bold"> </label>
                        <label for="toDate" class="form-label fw-bold"> </label>
                        <button class="btn btn-sm text-white" style="background-color:rgb(7, 44, 96)" @onclick="RefreshLedger">Refresh</button>
                    </div>

                </div>
            </div>
            
            @if (IsLoading)
            {
                <div class="progress" style="width: 100%">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                         role="progressbar" style="width: 100%">
                        Loading Transaction Data...
                    </div>
                </div>
            }
            else if (LedgerDatafromDB?.Any() ?? false)
            {
                <div style="width: 100%">
                    <ContextMenuProvider Id="accountsContextMenu">
                        <table class="table table-bordered table-hover align-middle mb-0 shadow-sm"
                               style="font-family: Calibri, 'Segoe UI', Tahoma, sans-serif; font-size: 10pt;">

                            <thead class="theme-color"
                                   style="font-family: Calibri, 'Segoe UI', Tahoma, sans-serif; font-size: 10pt;">
                                <tr >
                                    <th style="width: 10%;" class="text-center">Dated</th>
                                    <th style="width: 10%;">Voucher</th>
                                    <th style="width: 10%;">Account</th>
                                    <th style="width: 20%;">Description</th>
                                    <th style="width: 10%;" class="text-end">Debit</th>
                                    <th style="width: 10%;" class="text-end">Credit</th>
                                    <th style="width: 10%;" class="text-end">Gen. By</th>
                                    <th style="width: 10%;" class="text-end">Machine</th>
                                    <th style="width: 8%;" class="text-end">Entry Date</th>
                                    <th style="width: 2%;"> </th>
                                </tr>
                            </thead>

                            <tbody style="font-family: Calibri, 'Segoe UI'; font-size: 7pt;">

                                 <Virtualize Items="@LedgerDatafromDB" Context="ledger">
                                        @if (lastVoucher != ledger.VchrNo)
                                        {
                                            <tr>
                                                <td colspan="14" class="text-center fw-bold py-2">
                                                    - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
                                                </td>
                                            </tr>
                                            lastVoucher = ledger.VchrNo;
                                        }
                                       
                                        <ContextMenuTrigger WrapperTag="tr"
                                                MenuId="accountContextMenu"
                                                Data="ledger"
                                                tabindex="0"
                                                MouseButtonTrigger="MouseButtonTrigger.Right"
                                                CssClass="@($"key-{ledger.VchrNo} {(ledger.VchrNo == pVoucherNo ? "table-primary" : "")}")"
                                                Id="@($"row-{ledger.VchrNo}")"        
                                        >

                                            <td>@ledger.DT.ToString("dd-MMM-yyyy")</td>
                                            <td>@ledger.VchrNo</td>
                                            <td>@ledger.AccTitle</td>
                                            <td>@ledger.Description</td>
                                            <td class="text-end">@ledger.Debit</td>
                                            <td class="text-end">@ledger.Credit</td>

                                            <td class="text-end">@ledger.UserName</td>
                                            <td class="text-end">@ledger.MachineName</td>
                                            <td class="text-end">@ledger.DTEntry.ToString("dd-MMM-yyyy")</td>
                                            <td>
                                            <ContextMenuTrigger MenuId="accountContextMenu"
                                                     Data="ledger"
                                                     MouseButtonTrigger="MouseButtonTrigger.Both">
                                                    <button class="btn btn-sm btn-primary" style="border:none; background:none;">
                                                        <i class="fa-solid fa-ellipsis-vertical" style="color:black"></i>
                                                    </button>
                                                </ContextMenuTrigger>
                                            </td>

                                        </ContextMenuTrigger>
                                 </Virtualize>
                            </tbody>

                        </table>
                    </ContextMenuProvider>
                </div>
            }
            else
            {
                <div class="text-center py-3 text-muted">No Transaction Entries Found.</div>
            }

            <ContextMenu Id="accountContextMenu"
                UseDefaultEventHandlers="true"
                     Template="Win11Style">

                <Item class="menu-item" OnClick="@RefreshLedger">
                <i class="fas fa-sync-alt fa-fw win11-icon"></i> Refresh
                </Item>

                <div class="menu-divider"></div>
                <Seperator />

                <Item class="menu-item" OnClick="@(async e => await DeleteSelectedVoucher(e))">
                <i class="fas fa-delete-left fa-fw win11-icon"></i> Delete This Voucher
                </Item>

                <Item class="menu-item" OnClick="@(e => OpenVoucherAttachments(e))">
                <i class="fas fa-paperclip fa-fw win11-icon text-primary"></i> Attachments
                </Item>

                <div class="menu-divider"></div>
                <Seperator />

                 <Item class="menu-item" OnClick="@(async e => await PrintVoucher(e))">
                    <i class="fas fa-file-pdf fa-fw win11-icon"></i> Preview This Voucher
                </Item>

            </ContextMenu>
      
        </div>
    </div>

@if (ShowModal)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.55); backdrop-filter: blur(4px); z-index: 1050; display: flex; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box; font-family: 'Calibri', 'Segoe UI', sans-serif;">
        <div class="shadow-lg border-0" style="width: 1000px; max-width: 96vw; max-height: 92vh; background: #ffffff; border-radius: 12px; display: flex; flex-direction: column; overflow: hidden;">
            <!-- Header -->
            <div class="bg-danger text-white py-2 px-3 d-flex align-items-center justify-content-between" style="flex-shrink: 0;">
                <h6 class="modal-title fw-bold mb-0" style="font-size: 1.05rem;">
                    <i class="fas fa-trash-alt me-2"></i>
                    <span>Delete Voucher</span>
                    @if (!string.IsNullOrWhiteSpace(SelectedVoucher?.VchrNo))
                    {
                        <span class="fw-normal opacity-90 ms-2" style="font-size: 0.95rem;">— #@SelectedVoucher.VchrNo</span>
                    }
                </h6>
                <button type="button" class="btn-close btn-close-white" @onclick="HideModal" aria-label="Close"></button>
            </div>

            <!-- Body -->
            <div class="p-3" style="overflow-y: auto; flex-grow: 1;">
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small mb-1">Acc No :</label>
                        <input class="form-control form-control-sm" @bind="SelectedVoucher.AccNo" readonly />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small mb-1">Acc Title :</label>
                        <input class="form-control form-control-sm" @bind="SelectedVoucher.AccTitle" readonly />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small mb-1">Voucher # :</label>
                        <input class="form-control form-control-sm" @bind="SelectedVoucher.VchrNo" readonly />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small mb-1">Date :</label>
                        <input class="form-control form-control-sm" @bind="SelectedVoucher.VDate" @bind:format="yyyy-MM-dd" readonly />
                    </div>

                    <div class="col-md-8">
                        <label class="form-label fw-semibold small mb-1">Description</label>
                        <input class="form-control form-control-sm" @bind="SelectedVoucher.Description" readonly />
                    </div>
                </div>

                <div class="table-responsive mt-3">
                    <table class="table table-bordered table-hover table-sm align-middle mb-2" style="font-size: 0.85rem;">
                        <thead class="table-light text-secondary" style="font-size: 0.78rem; text-transform: uppercase;">
                            <tr>
                                <th style="width: 20%;">Acc #</th>
                                <th style="width: 50%;">AccTitle</th>
                                <th style="width: 15%;" class="text-end">Debit</th>
                                <th style="width: 15%;" class="text-end">Credit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ledger in LedgerDatafromDB_temp)
                            {
                                <tr>
                                    <td>@ledger.AccNo</td>
                                    <td>@ledger.AccTitle</td>
                                    <td class="text-end">@ledger.Debit</td>
                                    <td class="text-end">@ledger.Credit</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row g-2 mt-1">
                    <div class="col-md-4"></div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small mb-1">User Name</label>
                        <input class="form-control form-control-sm" @bind="SelectedVoucher.GeneratedBy" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small mb-1">Computer</label>
                        <input class="form-control form-control-sm" @bind="SelectedVoucher.MachineName" readonly />
                    </div>
                </div>

                <div class="mt-3">
                    @if (IsApprovalRequiredForDelete)
                    {
                        <div class="alert alert-warning py-2 px-3 mb-2 small d-flex align-items-center">
                            <i class="fas fa-info-circle me-2 fs-5 text-warning"></i>
                            <span>Submitting this request will generate a task for the <strong>@VoucherDeleteApproverRole</strong> role. The voucher will only be deleted once approved.</span>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger py-2 px-3 mb-2 small d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle me-2 fs-5 text-danger"></i>
                            <span>You are authorized to delete this voucher directly. Confirming will permanently remove Voucher <strong>#@SelectedVoucher?.VchrNo</strong>.</span>
                        </div>
                    }
                    <label class="form-label fw-semibold text-secondary small mb-1">Reason for Deletion <span class="text-danger">*</span> :</label>
                    <textarea class="form-control form-control-sm" rows="2" @bind="SelectedVoucher.DeleteReason" placeholder="@(IsApprovalRequiredForDelete ? $"Enter detailed reason for deletion for {VoucherDeleteApproverRole} review..." : "Enter reason for deletion...")"></textarea>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-top py-2 px-3 bg-light d-flex justify-content-end gap-2" style="flex-shrink: 0;">
                <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="HideModal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-danger btn-sm px-3 fw-bold" @onclick="DeleteVoucher">
                    @if (IsApprovalRequiredForDelete)
                    {
                        <i class="fas fa-paper-plane me-1"></i> <span>Submit Deletion Request</span>
                    }
                    else
                    {
                        <i class="fas fa-trash-alt me-1"></i> <span>Delete Voucher</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<AttachmentModal @ref="attachmentModalRef" />