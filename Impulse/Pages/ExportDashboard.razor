@page "/export"
@attribute [Authorize]

@using Impulse.Shared.Components

<PageTitle>Export Dashboard</PageTitle>

<div class="dashboard-shell">
    <div class="dashboard-hero">
        <div class="dashboard-icon-wrap" style="background:#fce8d0; color:#7a3000;">
            <i class="fas fa-ship"></i>
        </div>
        <div>
            <h1 class="dashboard-title">Export</h1>
            <p class="dashboard-subtitle">Foreign customers &amp; export operations</p>
        </div>
    </div>

    <div class="dashboard-modules">
        <SecureDashCard Href="/export/customers">
            <i class="fas fa-users"></i>
            <span>Foreign Customers</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/customer">
            <i class="fas fa-user-plus"></i>
            <span>New Customer</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/new-customer-order">
            <i class="fas fa-file-invoice"></i>
            <span>New Customer Order</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/customer-order-list">
            <i class="fas fa-list-alt"></i>
            <span>Customer Order List</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/customer-quotation-list">
            <i class="fas fa-file-invoice"></i>
            <span>Customer Quotation List</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/advance-payment-list">
            <i class="fas fa-money-check-dollar"></i>
            <span>Advance Payment List</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/order-item-list">
            <i class="fas fa-clipboard-list"></i>
            <span>Order Item List</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/orders/customer-item-balances">
            <i class="fas fa-balance-scale"></i>
            <span>Customer Item Balances</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/orders/articlewise-shipped-status">
            <i class="fas fa-boxes"></i>
            <span>Articlewise Shipped Status</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/proformas/proforma-list">
            <i class="fas fa-file-invoice"></i>
            <span>Proforma List</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/invoices/custom">
            <i class="fas fa-file-invoice-dollar"></i>
            <span>Custom Invoice List</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/custom-payment-status">
            <i class="fas fa-money-check-alt"></i>
            <span>Custom Payment Status</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/receive-custom-payment">
            <i class="fas fa-hand-holding-usd"></i>
            <span>Receive Custom Payment</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/custominvoices/new-custominvoice">
            <i class="fas fa-file-invoice"></i>
            <span>New Custom Invoice</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/invoices/commercial">
            <i class="fas fa-file-invoice-dollar"></i>
            <span>Commercial Invoice List</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/invoices/bank">
            <i class="fas fa-university"></i>
            <span>Bank Invoice List</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/invoices/packing-labels">
            <i class="fas fa-boxes"></i>
            <span>Packing Outer Labels</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/invoices/print-inner-labels">
            <i class="fas fa-print"></i>
            <span>Print Inner Labels</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/invoices/shipping-instructions">
            <i class="fas fa-ship"></i>
            <span>Shipping Instructions</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/invoices/print-valuation-form">
            <i class="fas fa-file-invoice"></i>
            <span>Print Valuation Form</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/invoices/commercial-covering">
            <i class="fas fa-file-alt"></i>
            <span>Commercial Covering Letter</span>
        </SecureDashCard>
        <SecureDashCard Href="/export/statistics">
            <i class="fas fa-chart-line"></i>
            <span>Statistics</span>
        </SecureDashCard>
    </div>
</div>

<style>
    .dashboard-shell { padding: 2rem; max-width: 1100px; }
    .dashboard-hero { display: flex; align-items: center; gap: 1.25rem; margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 2px solid #e0e2ec; }
    .dashboard-icon-wrap { width: 64px; height: 64px; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; flex-shrink: 0; }
    .dashboard-title { font-size: 2rem; font-weight: 700; color: #1b1b1f; margin: 0; line-height: 1.2; }
    .dashboard-subtitle { color: #44474f; margin: 0.25rem 0 0; font-size: 0.95rem; }
    .dashboard-modules { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1rem; }
    .dash-card { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem; padding: 1.5rem 1rem; background: #ffffff; border: 1px solid #e0e2ec; border-radius: 16px; text-decoration: none; color: #1b1b1f; font-weight: 500; font-size: 0.875rem; text-align: center; transition: background-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease; cursor: pointer; }
    .dash-card i { font-size: 1.75rem; color: #c05800; }
    .dash-card:hover { background: #fff4ed; box-shadow: 0 4px 16px rgba(192, 88, 0, 0.12); transform: translateY(-2px); color: #7a3000; }
    .dash-card:hover i { color: #7a3000; }
</style>
