@using DataAccessLibrary.Models.Setup

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5); backdrop-filter: blur(4px); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered" style="font-family: 'Calibri', 'Segoe UI', sans-serif; max-width: 520px;">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 14px;">
                <div class="modal-header border-bottom py-3 px-4 bg-light rounded-top-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 bg-primary-subtle text-primary rounded-3">
                            <i class="fas fa-tags"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark mb-0" style="font-size: 1.15rem;">Manage User Roles</h5>
                            <small class="text-secondary">Define and organize operational roles for ERP users</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAsync"></button>
                </div>

                <div class="modal-body p-4">
                    <!-- Add Role Input Form -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <label class="form-label small fw-bold text-secondary mb-1">Create New Role</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class="fas fa-tag"></i>
                            </span>
                            <input type="text"
                                   class="form-control border-start-0"
                                   placeholder="e.g. Inspector, Accountant, Storekeeper..."
                                   @bind="NewRoleName"
                                   @bind:event="oninput"
                                   @onkeyup="HandleKeyUp"
                                   disabled="@IsProcessing" />
                            <button class="btn btn-primary px-3 fw-semibold shadow-sm"
                                    type="button"
                                    @onclick="AddRoleAsync"
                                    disabled="@(IsProcessing || string.IsNullOrWhiteSpace(NewRoleName))">
                                @if (IsProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                else
                                {
                                    <i class="fas fa-plus me-1"></i>
                                }
                                <span>Add Role</span>
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="text-danger small mt-1">@ErrorMessage</div>
                        }
                    </div>

                    <!-- Roles List -->
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-bold small text-secondary text-uppercase">Defined System Roles (@Roles.Count)</span>
                        <small class="text-muted">Users Assigned</small>
                    </div>

                    @if (IsLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <div class="text-muted small mt-1">Loading roles...</div>
                        </div>
                    }
                    else if (Roles.Count == 0)
                    {
                        <div class="text-center py-4 text-muted small bg-light rounded-3 border">
                            <i class="fas fa-tag fa-2x mb-2 text-secondary opacity-50"></i>
                            <div>No user roles found. Add your first role above.</div>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush border rounded-3 overflow-hidden" style="max-height: 280px; overflow-y: auto;">
                            @foreach (var role in Roles)
                            {
                                <div class="list-group-item d-flex align-items-center justify-content-between py-2 px-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge @GetRoleBadgeClass(role.User_Role) px-2 py-1" style="font-size: 0.82rem;">
                                            <i class="fas fa-tag me-1 opacity-75"></i>@role.User_Role
                                        </span>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="badge rounded-pill bg-light text-secondary border px-2 py-1" style="font-size: 0.75rem;" title="Total users holding this role">
                                            <i class="fas fa-users me-1 text-muted"></i>@role.AssignedUsersCount
                                        </span>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger p-1 lh-1"
                                                title="Delete this role"
                                                @onclick="() => ConfirmDeleteRoleAsync(role)">
                                            <i class="fas fa-trash-alt" style="font-size: 0.78rem;"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="modal-footer border-top py-2 px-4 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-sm btn-secondary px-4" @onclick="CloseAsync">Close</button>
                </div>
            </div>
        </div>
    </div>
}
