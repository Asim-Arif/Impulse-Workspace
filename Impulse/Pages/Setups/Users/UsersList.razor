@page "/setup/users"
@attribute [Authorize]

<PageTitle>User Management - Impulse ERP</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">
            
            <!-- Page Header -->
            <div class="d-flex align-items-end justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-3 p-2" style="width: 42px; height: 42px;">
                        <i class="fas fa-users-cog fa-lg text-primary"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold text-dark" style="font-size: 1.25rem;">User Management &amp; Security Roles</h4>
                        <small class="text-secondary">Manage system user credentials, employee profile bindings &amp; module authorizations</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm px-3" @onclick="OpenCreateModal">
                        <i class="fas fa-user-plus"></i>
                        <span>New User</span>
                    </button>
                    <a href="/setup" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                        <i class="fas fa-arrow-left"></i>
                        <span>Setup Hub</span>
                    </a>
                </div>
            </div>

            <!-- Filter Panel -->
            <div class="p-2 mb-3 bg-light rounded-3 border">
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small text-secondary fw-semibold mb-1">Search Account or Employee</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                            <input type="text" class="form-control" placeholder="Search by username, full name, employee or department..." @bind="SearchQuery" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-secondary fw-semibold mb-1">Account Status</label>
                        <select class="form-select form-select-sm" @bind="StatusFilter">
                            <option value="all">All Accounts</option>
                            <option value="active">Active Only</option>
                            <option value="inactive">Inactive / Suspended</option>
                        </select>
                    </div>
                    <div class="col-md-4 d-flex gap-2">
                        <button class="btn btn-sm btn-primary flex-grow-1" @onclick="ApplyFilterAsync">
                            <i class="fas fa-filter me-1"></i>Apply Filter
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFilterAsync" title="Reset Filters">
                            <i class="fas fa-undo"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Users Data Table -->
            @if (IsLoading)
            {
                <div class="d-flex justify-content-center align-items-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <span class="ms-2 text-secondary">Loading system user accounts...</span>
                </div>
            }
            else if (!FilteredUsers.Any())
            {
                <div class="text-center py-5 border rounded-3 bg-light">
                    <i class="fas fa-user-slash fa-3x text-muted mb-2"></i>
                    <h6 class="text-secondary fw-semibold">No user accounts found</h6>
                    <p class="text-muted small mb-0">No records match your search and filter criteria.</p>
                </div>
            }
            else
            {
                <div class="table-responsive" style="max-height: 60vh; overflow-y: auto;">
                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                            <tr>
                                <th style="width: 70px;">ID</th>
                                <th style="width: 140px;">Username</th>
                                <th style="width: 180px;">Full Name</th>
                                <th>Linked Employee</th>
                                <th style="width: 160px;">Department</th>
                                <th style="width: 220px;">Module Access</th>
                                <th style="width: 100px;">Status</th>
                                <th class="text-end" style="width: 150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in FilteredUsers)
                            {
                                <tr>
                                    <td class="text-muted small">@user.UserID</td>
                                    <td>
                                        <div class="fw-bold text-dark d-flex align-items-center gap-1">
                                            <i class="fas fa-user text-primary" style="font-size: 0.8rem;"></i>
                                            <span>@user.UserName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-dark">@(string.IsNullOrWhiteSpace(user.FullUserName) ? "-" : user.FullUserName)</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(user.EmpID))
                                        {
                                            <div class="d-flex flex-column">
                                                <span class="fw-semibold text-primary small">
                                                    <i class="fas fa-id-badge me-1"></i>[@user.EmpID] @(user.EmployeeName ?? "Employee")
                                                </span>
                                                <small class="text-muted" style="font-size: 0.75rem;">@(user.Designation ?? "")</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">Unlinked</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="small text-secondary">@(user.DepartmentName ?? "-")</span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1" style="font-size: 0.7rem;">
                                            @if (user.FinancialMainLink) { <span class="badge bg-primary-subtle text-primary border border-primary-subtle">FIN</span> }
                                            @if (user.PayrollMainLink) { <span class="badge bg-success-subtle text-success border border-success-subtle">PAY</span> }
                                            @if (user.StockMainLink) { <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">STK</span> }
                                            @if (user.ProductionMainLink) { <span class="badge bg-danger-subtle text-danger border border-danger-subtle">PRD</span> }
                                            @if (user.ExportMainLink) { <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">EXP</span> }
                                            @if (user.QMSMainLink) { <span class="badge bg-purple-subtle text-purple border" style="color: #7c3aed; background: #ede9fe;">QMS</span> }
                                            @if (user.UserManagement) { <span class="badge bg-danger text-white">ADMIN</span> }
                                        </div>
                                    </td>
                                    <td>
                                        @if (!user.InActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-xs btn-outline-primary" @onclick="() => OpenEditModal(user)" title="Edit Permissions">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>
                                            <button class="btn btn-xs btn-outline-secondary" @onclick="() => OpenResetPasswordModal(user)" title="Reset Password">
                                                <i class="fas fa-key"></i>
                                            </button>
                                            <button class="btn btn-xs @(user.InActive ? "btn-outline-success" : "btn-outline-danger")" @onclick="() => ToggleStatusAsync(user)" title="@(user.InActive ? "Activate Account" : "Suspend Account")">
                                                <i class="fas @(user.InActive ? "fa-user-check" : "fa-user-slash")"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- Bottom Summary Bar -->
            <div class="d-flex align-items-center justify-content-between pt-3 mt-2 border-top text-secondary small">
                <div>
                    Showing <strong>@FilteredUsers.Count</strong> of <strong>@AllUsers.Count</strong> total user accounts
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span><i class="fas fa-circle text-success me-1" style="font-size: 0.6rem;"></i>Active: <strong>@AllUsers.Count(u => !u.InActive)</strong></span>
                    <span><i class="fas fa-circle text-danger me-1" style="font-size: 0.6rem;"></i>Inactive: <strong>@AllUsers.Count(u => u.InActive)</strong></span>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Edit / Create User Modal Component -->
<UserEditModal IsOpen="@IsModalOpen"
               User="@EditingUser"
               IsNewUser="@IsCreatingNew"
               OnClose="CloseModal"
               OnSaved="HandleUserSaved" />

<!-- Quick Reset Password Modal -->
@if (IsResetPasswordOpen && ResettingUser != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); z-index: 1060;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
                <div class="modal-header bg-light border-bottom py-2">
                    <h6 class="modal-title fw-bold text-dark mb-0">
                        <i class="fas fa-key text-warning me-1"></i>Reset Password
                    </h6>
                    <button type="button" class="btn-close" @onclick="() => IsResetPasswordOpen = false"></button>
                </div>
                <div class="modal-body p-3">
                    <p class="small text-secondary mb-2">
                        Set a new password for account <strong>@ResettingUser.UserName</strong>:
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary mb-1">New Password</label>
                        <input type="password" class="form-control form-control-sm" @bind="NewPasswordInput" placeholder="Enter new password" />
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => IsResetPasswordOpen = false">Cancel</button>
                    <button type="button" class="btn btn-sm btn-warning fw-semibold shadow-sm" @onclick="ConfirmResetPasswordAsync">
                        <i class="fas fa-check me-1"></i>Update Password
                    </button>
                </div>
            </div>
        </div>
    </div>
}
