@page "/setup/remote-access"
@page "/setup/remote-access-requests"
@using DataAccessLibrary.Models.Setup
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">

            <!-- Page Title Header -->
            <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div class="p-2 bg-primary-subtle text-primary rounded-3">
                        <i class="fas fa-globe-americas fs-4"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">Remote Access Authorizations</h5>
                        <small class="text-secondary">Approve Just-In-Time temporary remote working access for users outside factory premises</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (PendingCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill px-3 py-2 shadow-sm animate__animated animate__pulse animate__infinite">
                            <i class="fas fa-bell me-1"></i> @PendingCount Pending Approval@(PendingCount > 1 ? "s" : "")
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                            <i class="fas fa-check-circle me-1"></i> No Pending Requests
                        </span>
                    }

                    <button class="btn btn-sm btn-outline-primary shadow-sm" @onclick="LoadDataAsync" disabled="@IsLoading">
                        <i class="fas fa-sync-alt @(IsLoading ? "fa-spin" : "") me-1"></i> Refresh
                    </button>
                </div>
            </div>

            <!-- Filter Tabs -->
            <div class="d-flex align-items-center gap-2 mb-3">
                <button class="btn btn-sm @(ActiveTab == 0 ? "btn-primary shadow-sm" : "btn-outline-secondary") rounded-pill px-3" @onclick="() => SetTab(0)">
                    <i class="fas fa-clock me-1"></i> Pending Requests
                    @if (PendingCount > 0)
                    {
                        <span class="badge @(ActiveTab == 0 ? "bg-white text-primary" : "bg-danger text-white") rounded-pill ms-1">@PendingCount</span>
                    }
                </button>
                <button class="btn btn-sm @(ActiveTab == 1 ? "btn-primary shadow-sm" : "btn-outline-secondary") rounded-pill px-3" @onclick="() => SetTab(1)">
                    <i class="fas fa-history me-1"></i> Request History &amp; Audit
                </button>
            </div>

            <!-- Table Container -->
            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                    <span class="text-secondary small">Loading access requests...</span>
                </div>
            }
            else
            {
                var displayList = ActiveTab == 0 ? PendingRequests : HistoryRequests;

                @if (!displayList.Any())
                {
                    <div class="text-center py-5 border rounded-3 bg-light-subtle">
                        <i class="fas @(ActiveTab == 0 ? "fa-shield-check text-success" : "fa-inbox text-secondary") fs-1 mb-2 d-block opacity-50"></i>
                        <h6 class="text-secondary fw-semibold">
                            @(ActiveTab == 0 ? "No users currently requesting remote access." : "No request history found.")
                        </h6>
                        <small class="text-muted">Requests submitted by users outside factory IP will appear here in real time.</small>
                    </div>
                }
                else
                {
                    <div class="table-responsive rounded-3 border">
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                            <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                <tr>
                                    <th style="width: 50px;" class="text-center">#</th>
                                    <th>User / Staff</th>
                                    <th>Department</th>
                                    <th>Requested IP</th>
                                    <th>Request Time</th>
                                    <th>Reason</th>
                                    <th class="text-center" style="width: 120px;">Status</th>
                                    @if (ActiveTab == 0)
                                    {
                                        <th style="min-width: 280px;" class="text-end">Approve / Grant Access</th>
                                    }
                                    else
                                    {
                                        <th>Duration / Expiry</th>
                                        <th>Action Taken By</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var req in displayList)
                                {
                                    <tr>
                                        <td class="text-center text-secondary small">@req.EntryID</td>
                                        <td>
                                            <div class="fw-bold text-dark">@req.UserName</div>
                                            <div class="text-secondary" style="font-size: 0.78rem;">@(string.IsNullOrWhiteSpace(req.EmployeeName) ? req.Designation : $"{req.EmployeeName} ({req.Designation})")</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@(string.IsNullOrWhiteSpace(req.DepartmentName) ? "General" : req.DepartmentName)</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary font-monospace" style="font-size: 0.8rem;">
                                                <i class="fas fa-network-wired me-1"></i>@req.ClientIP
                                            </span>
                                        </td>
                                        <td class="small text-secondary">
                                            @req.RequestDT.ToString("dd-MMM-yyyy hh:mm tt")
                                        </td>
                                        <td>
                                            <span class="text-dark small" title="@req.Reason">
                                                @(string.IsNullOrWhiteSpace(req.Reason) ? "No reason specified" : req.Reason)
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            @if (req.Status == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark border border-warning-subtle rounded-pill px-2">
                                                    <i class="fas fa-clock me-1"></i> Pending
                                                </span>
                                            }
                                            else if (req.Status == "Approved")
                                            {
                                                bool isExpired = req.ExpiresAt.HasValue && req.ExpiresAt.Value <= DateTime.Now;
                                                if (isExpired)
                                                {
                                                    <span class="badge bg-secondary rounded-pill px-2" title="Expired at @req.ExpiresAt?.ToString("hh:mm tt")">
                                                        <i class="fas fa-hourglass-end me-1"></i> Expired
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success rounded-pill px-2" title="Active until @req.ExpiresAt?.ToString("hh:mm tt")">
                                                        <i class="fas fa-check me-1"></i> Active
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger rounded-pill px-2">
                                                    <i class="fas fa-times me-1"></i> Rejected
                                                </span>
                                            }
                                        </td>

                                        @if (ActiveTab == 0)
                                        {
                                            <td class="text-end">
                                                <div class="d-inline-flex align-items-center gap-1">
                                                    <!-- Duration Selector -->
                                                    <select class="form-select form-select-sm" style="width: 130px; font-size: 0.82rem;" @bind="SelectedDurations[req.EntryID]">
                                                        <option value="30">30 Minutes</option>
                                                        <option value="60">1 Hour (Std)</option>
                                                        <option value="120">2 Hours</option>
                                                        <option value="240">4 Hours</option>
                                                        <option value="480">8 Hours</option>
                                                        <option value="720">End of Day</option>
                                                    </select>

                                                    <button class="btn btn-sm btn-success px-2 shadow-sm" title="Approve Remote Access" @onclick="() => ApproveAsync(req.EntryID)">
                                                        <i class="fas fa-check me-1"></i> Approve
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger px-2" title="Reject Request" @onclick="() => RejectAsync(req.EntryID)">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="small">
                                                @if (req.DurationMinutes.HasValue && req.DurationMinutes > 0)
                                                {
                                                    <div><strong>@req.DurationMinutes mins</strong></div>
                                                    <small class="text-muted">Expires: @req.ExpiresAt?.ToString("dd-MMM hh:mm tt")</small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td class="small">
                                                @if (!string.IsNullOrWhiteSpace(req.ActionByUserName))
                                                {
                                                    <div><strong>@req.ActionByUserName</strong></div>
                                                    <small class="text-muted">@req.ActionDT?.ToString("dd-MMM hh:mm tt")</small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

        </div>
    </div>
</div>

