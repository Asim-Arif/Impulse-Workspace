@page "/gate/material-inward/entry"
@page "/gate/material-inward/entry/{EntryId:int}"
@attribute [Authorize]

<PageTitle>@(IsEditMode ? "Edit Material Inward" : "New Material Inward") - Impulse</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body">
            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4 text-primary"><i class="fas fa-truck-ramp-box"></i></span>
                    <div>
                        <h4 class="mb-0 fw-bold" style="color: #1a237e;">@(IsEditMode ? $"Edit Inward Entry #{Model.EntryID}" : "New Material Inward Consignment")</h4>
                        <small class="text-muted">Record inward supplier goods, challan numbers &amp; weight measurements</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Cancel">
                        <i class="fas fa-arrow-left me-1"></i> Back
                    </button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@IsSaving">
                        <i class="fas fa-check me-1"></i> @(IsSaving ? "Saving..." : "Save Inward")
                    </button>
                </div>
            </div>

            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Loading entry details...</p>
                </div>
            }
            else
            {
                <EditForm Model="Model">
                    <DataAnnotationsValidator />

                    <!-- Header Details -->
                    <div class="card border-0 bg-light p-3 mb-3" style="border-radius: 8px;">
                        <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2">
                            <i class="fas fa-file-invoice me-1 text-primary"></i> Consignment &amp; Transport
                        </h6>
                        <div class="row g-2">
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Supplier Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm" @bind="Model.SupplierName" placeholder="Supplier or vendor name" />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">PO Number</label>
                                <input type="text" class="form-control form-control-sm" @bind="Model.PoNumber" placeholder="Purchase order ref" />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Vehicle Number</label>
                                <input type="text" class="form-control form-control-sm" @bind="Model.VehicleNumber" placeholder="Truck/vehicle number" />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Driver Name</label>
                                <input type="text" class="form-control form-control-sm" @bind="Model.DriverName" placeholder="Driver full name" />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Delivery Challan #</label>
                                <input type="text" class="form-control form-control-sm" @bind="Model.DeliveryChallanNo" placeholder="Challan / Bilty #" />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Invoice #</label>
                                <input type="text" class="form-control form-control-sm" @bind="Model.InvoiceNo" placeholder="Invoice reference" />
                            </div>
                            <div class="col-md-2 col-sm-4">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Weighment (KG)</label>
                                <input type="number" step="any" class="form-control form-control-sm" @bind="Model.Weighment" placeholder="Gross/net weighment" />
                            </div>
                            <div class="col-md-2 col-sm-4">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Status</label>
                                <select class="form-select form-select-sm" @bind="Model.Status">
                                    <option value="Open">Open</option>
                                    <option value="Received">Received</option>
                                    <option value="Closed">Closed</option>
                                </select>
                            </div>
                            <div class="col-md-2 col-sm-4">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Entry Date &amp; Time</label>
                                <input type="datetime-local" class="form-control form-control-sm" value="@DateTimeInputValue" @onchange="OnDateTimeChanged" />
                            </div>
                            <div class="col-12">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Remarks</label>
                                <input type="text" class="form-control form-control-sm" @bind="Model.Remarks" placeholder="Remarks or inspection observations" />
                            </div>
                        </div>
                    </div>

                    <!-- Material Lines -->
                    <div class="card border-0 bg-light p-3 mb-3" style="border-radius: 8px;">
                        <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2 d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-boxes me-1 text-primary"></i> Material Consignment Lines</span>
                            <span class="badge bg-secondary">@Model.Lines.Count Line(s)</span>
                        </h6>

                        <!-- Line Composer -->
                        <div class="row g-2 align-items-end mb-3 p-2 bg-white rounded border">
                            <div class="col-md-6 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Material / Item Description</label>
                                <input type="text" class="form-control form-control-sm" @bind="NewLine.MaterialName" placeholder="Item name or description" />
                            </div>
                            <div class="col-md-2 col-sm-3">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Quantity</label>
                                <input type="number" step="any" class="form-control form-control-sm" @bind="NewLine.Quantity" />
                            </div>
                            <div class="col-md-2 col-sm-3">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">UOM</label>
                                <input type="text" class="form-control form-control-sm" @bind="NewLine.Uom" placeholder="KG/MTR/BAG" />
                            </div>
                            <div class="col-md-2 col-sm-12 text-end">
                                <button type="button" class="btn btn-sm btn-outline-success w-100" @onclick="AddLine">
                                    <i class="fas fa-plus me-1"></i> Add Line
                                </button>
                            </div>
                        </div>

                        <!-- Lines Table -->
                        <div class="table-responsive bg-white border rounded">
                            <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                                <thead class="table-light text-secondary" style="font-size: 0.78rem; text-transform: uppercase;">
                                    <tr>
                                        <th style="width: 40px;" class="text-center">#</th>
                                        <th>Material / Goods Description</th>
                                        <th class="text-end">Quantity</th>
                                        <th>Unit (UOM)</th>
                                        <th class="text-center" style="width: 50px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Lines.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center py-3 text-muted">
                                                No consignment lines added yet. Use the composer above to add lines.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        var idx = 0;
                                        @foreach (var l in Model.Lines)
                                        {
                                            idx++;
                                            var cur = l;
                                            <tr>
                                                <td class="text-center text-muted">@idx</td>
                                                <td class="fw-semibold">@cur.MaterialName</td>
                                                <td class="text-end fw-bold">@cur.Quantity.ToString("0.##")</td>
                                                <td>@cur.Uom</td>
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-sm btn-link text-danger p-0" title="Remove" @onclick="() => RemoveLine(cur)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

