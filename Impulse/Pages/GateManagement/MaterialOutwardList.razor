@page "/gate/material-outward"
@attribute [Authorize]

@using BlazorContextMenu
@using Impulse.Shared.Components

<PageTitle>Material Outward Register - Impulse</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body">
            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4 text-warning"><i class="fas fa-truck-arrow-right"></i></span>
                    <div>
                        <h4 class="mb-0 fw-bold" style="color: #1a237e;">Material Outward Register</h4>
                        <small class="text-muted">Track outward sales dispatches, delivery orders &amp; exit weighments</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync" disabled="@IsLoading">
                        <i class="fas fa-sync-alt @(IsLoading ? "fa-spin" : "") me-1"></i> Refresh
                    </button>
                    <a href="/gate/material-outward/entry" class="btn btn-sm btn-warning text-dark fw-semibold">
                        <i class="fas fa-plus-circle me-1"></i> New Outward
                    </a>
                    <a href="/gate" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-arrow-left me-1"></i> Gate Hub
                    </a>
                </div>
            </div>

            <!-- Filters -->
            <div class="card border-0 bg-light p-2 mb-3" style="border-radius: 8px;">
                <div class="row g-2 align-items-center">
                    <div class="col-md-5 col-sm-8">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                            <input type="text" class="form-control" placeholder="Search SO #, DO #, customer or vehicle..." @bind="Filter.SearchText" @bind:event="oninput" @bind:after="RefreshAsync" />
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-4">
                        <div class="form-check form-check-inline mt-1" style="font-size: 0.85rem;">
                            <input class="form-check-input" type="checkbox" id="showClosedOutCheck" @bind="Filter.ShowClosed" @bind:after="RefreshAsync">
                            <label class="form-check-label" for="showClosedOutCheck">Show Closed Entries</label>
                        </div>
                    </div>
                    <div class="col-md-4 text-end">
                        <span class="badge bg-light text-secondary border">Total: @Entries.Count outward dispatches</span>
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="table-responsive border rounded" style="max-height: 60vh; overflow-y: auto;">
                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                    <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                        <tr>
                            <th style="width: 40px;" class="text-center">#</th>
                            <th>SO #</th>
                            <th>DO #</th>
                            <th>Customer</th>
                            <th>Vehicle #</th>
                            <th>Driver</th>
                            <th class="text-end">Weighment</th>
                            <th>Dispatch Time</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Lines</th>
                            <th class="text-center" style="width: 100px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="11" class="text-center py-4 text-muted">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                    Loading material outward dispatches...
                                </td>
                            </tr>
                        }
                        else if (Entries.Count == 0)
                        {
                            <tr>
                                <td colspan="11" class="text-center py-4 text-muted">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block opacity-25"></i>
                                    No material outward dispatches found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            var s = 0;
                            @foreach (var row in Entries)
                            {
                                s++;
                                var isSel = SelectedEntryId == row.EntryID;
                                <ContextMenuTrigger MenuId="outwardContextMenu"
                                                    WrapperTag="tr"
                                                    Data="row"
                                                    class="@(isSel ? "table-primary" : "")"
                                                    @onclick="() => SelectRow(row.EntryID)"
                                                    @ondblclick="() => EditEntry(row.EntryID)">
                                    <td class="text-center text-muted">@s</td>
                                    <td class="fw-bold text-primary">@row.SalesOrderNo</td>
                                    <td>@row.DeliveryOrderNo</td>
                                    <td>@row.CustomerName</td>
                                    <td><span class="badge bg-light text-dark border">@row.VehicleNumber</span></td>
                                    <td>@row.DriverName</td>
                                    <td class="text-end fw-semibold">@row.Weighment.ToString("N0")</td>
                                    <td>@row.EntryTime.ToString("dd-MMM-yyyy hh:mm tt")</td>
                                    <td class="text-center">
                                        <span class="badge @(row.Status == "Dispatched" ? "bg-warning-subtle text-warning" : row.Status == "Closed" ? "bg-dark-subtle text-dark" : "bg-success-subtle text-success")">
                                            @row.Status
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary-subtle text-secondary">@row.LineCount item(s)</span>
                                    </td>
                                    <td class="text-center" @onclick:stopPropagation>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-secondary btn-sm" title="Edit" @onclick="() => EditEntry(row.EntryID)">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" title="Delete" @onclick="() => DeleteAsync(row.EntryID)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </ContextMenuTrigger>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Context Menu -->
<ContextMenu Id="outwardContextMenu" Template="Win11Style">
    <Item OnClick="OnContextEdit"><i class="fas fa-pencil-alt win11-icon text-primary me-2"></i> Edit Outward Entry</Item>
    <Item OnClick="OnContextDelete"><i class="fas fa-trash win11-icon text-danger me-2"></i> Delete Entry</Item>
</ContextMenu>

