@page "/gate/visitors/entry"
@page "/gate/visitors/entry/{EntryId:int}"
@attribute [Authorize]

<PageTitle>@(IsEditMode ? "Edit Visitor" : "Register Visitor") - Impulse</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body">
            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4 text-primary"><i class="fas fa-user-plus"></i></span>
                    <div>
                        <h4 class="mb-0 fw-bold" style="color: #1a237e;">@(IsEditMode ? $"Edit Visitor Entry #{Model.EntryId}" : "Register New Visitor")</h4>
                        <small class="text-muted">Issue visitor badge, record identity details &amp; notify host</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Cancel">
                        <i class="fas fa-arrow-left me-1"></i> Back
                    </button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@IsSaving">
                        <i class="fas fa-check me-1"></i> @(IsSaving ? "Saving..." : "Save Visitor")
                    </button>
                </div>
            </div>

            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Loading visitor information...</p>
                </div>
            }
            else
            {
                <EditForm Model="Model">
                    <DataAnnotationsValidator />

                    <div class="card border-0 bg-light p-3 mb-3" style="border-radius: 8px;">
                        <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2">
                            <i class="fas fa-id-card me-1 text-primary"></i> Visitor Identity &amp; Contact
                        </h6>
                        <div class="row g-2">
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Visitor Full Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm" @bind="Model.VisitorName" placeholder="Full name of visitor" />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">CNIC / Identification #</label>
                                <input type="text" class="form-control form-control-sm" @bind="Model.CnicNo" placeholder="CNIC or Passport" />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Company / Organization</label>
                                <input type="text" class="form-control form-control-sm" @bind="Model.CompanyName" placeholder="Visitor company name" />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Mobile Number</label>
                                <input type="text" class="form-control form-control-sm" @bind="Model.MobileNo" placeholder="0300-1234567" />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Badge / Card #</label>
                                <input type="text" class="form-control form-control-sm fw-bold text-primary" @bind="Model.CardNo" placeholder="Assigned badge #" />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Entry Date &amp; Time</label>
                                <input type="datetime-local" class="form-control form-control-sm" value="@DateTimeInputValue" @onchange="OnDateTimeChanged" />
                            </div>
                            <div class="col-md-6 col-sm-12">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Purpose of Visit</label>
                                <input type="text" class="form-control form-control-sm" @bind="Model.Purpose" placeholder="e.g. Meeting, delivery, interview" />
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 bg-light p-3 mb-3" style="border-radius: 8px;">
                        <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2">
                            <i class="fas fa-building-user me-1 text-primary"></i> Host &amp; Department Affiliation
                        </h6>
                        <div class="row g-2">
                            <div class="col-md-4 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Concerned Host (Employee)</label>
                                <select class="form-select form-select-sm" value="@Model.EmployeeId" @onchange="OnEmployeeChangedAsync">
                                    <option value="">Select internal host</option>
                                    @foreach (var emp in EmployeeOptions)
                                    {
                                        <option value="@emp.Id">@emp.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Host Email</label>
                                <input type="email" class="form-control form-control-sm" @bind="Model.ConcernedPersonEmail" placeholder="host@company.com" />
                            </div>
                            <div class="col-md-4 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Host WhatsApp / Mobile</label>
                                <input type="text" class="form-control form-control-sm" @bind="Model.ConcernedPersonWhatsApp" placeholder="WhatsApp for alert" />
                            </div>
                            <div class="col-md-4 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Vendor Affiliation</label>
                                <select class="form-select form-select-sm" value="@Model.VendorId" @onchange="OnVendorChanged">
                                    <option value="0">&lt;None / General Guest&gt;</option>
                                    @foreach (var v in VendorOptions)
                                    {
                                        <option value="@v.Id">@v.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-8 col-sm-6">
                                <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Remarks / Security Notes</label>
                                <input type="text" class="form-control form-control-sm" @bind="Model.Remarks" placeholder="Luggage, belongings, or gate notes" />
                            </div>
                        </div>
                    </div>

                    <!-- Checkout Section -->
                    <div class="card border-0 bg-light p-3" style="border-radius: 8px;">
                        <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2">
                            <i class="fas fa-door-open me-1 text-primary"></i> Checkout Status
                        </h6>
                        <div class="row g-2 align-items-center">
                            <div class="col-md-3">
                                <div class="form-check mt-1" style="font-size: 0.88rem;">
                                    <input class="form-check-input" type="checkbox" id="hasTimeOutCheck" @bind="Model.HasTimeOut" />
                                    <label class="form-check-label fw-semibold" for="hasTimeOutCheck">Visitor Checked Out (Time Out)</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <input type="datetime-local" class="form-control form-control-sm" value="@TimeOutInputValue" @onchange="OnTimeOutChanged" disabled="@(!Model.HasTimeOut)" />
                            </div>
                        </div>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

