@page "/gate/dashboard"
@attribute [Authorize]

<PageTitle>Gate Dashboard - Impulse</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body">
            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4 text-primary"><i class="fas fa-chart-line"></i></span>
                    <div>
                        <h4 class="mb-0 fw-bold" style="color: #1a237e;">Gate Operations Dashboard</h4>
                        <small class="text-muted">Real-time overview of gate passes, visitors &amp; vehicle traffic</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@IsLoading">
                        <i class="fas fa-sync-alt @(IsLoading ? "fa-spin" : "") me-1"></i> Refresh
                    </button>
                    <a href="/gate" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-arrow-left me-1"></i> Gate Hub
                    </a>
                </div>
            </div>

            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Loading gate statistics...</p>
                </div>
            }
            else
            {
                <!-- Today's Stats Cards Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3 col-sm-6">
                        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%); border-radius: 10px;">
                            <div class="card-body d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="text-secondary fw-semibold text-uppercase" style="font-size: 0.75rem;">Visitors Today</span>
                                    <h3 class="mb-0 fw-bold text-primary mt-1">@Model.Today.Visitors.ToString("N0")</h3>
                                    <small class="text-muted" style="font-size: 0.75rem;">Guest &amp; vendor check-ins</small>
                                </div>
                                <div class="bg-white rounded-circle p-3 shadow-sm text-primary">
                                    <i class="fas fa-id-badge fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%); border-radius: 10px;">
                            <div class="card-body d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="text-secondary fw-semibold text-uppercase" style="font-size: 0.75rem;">Gate In Today</span>
                                    <h3 class="mb-0 fw-bold text-success mt-1">@Model.Today.GateIn.ToString("N0")</h3>
                                    <small class="text-muted" style="font-size: 0.75rem;">Inward material passes</small>
                                </div>
                                <div class="bg-white rounded-circle p-3 shadow-sm text-success">
                                    <i class="fas fa-arrow-right-to-bracket fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%); border-radius: 10px;">
                            <div class="card-body d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="text-secondary fw-semibold text-uppercase" style="font-size: 0.75rem;">Gate Out Today</span>
                                    <h3 class="mb-0 fw-bold text-warning mt-1">@Model.Today.GateOut.ToString("N0")</h3>
                                    <small class="text-muted" style="font-size: 0.75rem;">Outward dispatches</small>
                                </div>
                                <div class="bg-white rounded-circle p-3 shadow-sm text-warning">
                                    <i class="fas fa-arrow-right-from-bracket fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%); border-radius: 10px;">
                            <div class="card-body d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="text-secondary fw-semibold text-uppercase" style="font-size: 0.75rem;">Total Movements</span>
                                    <h3 class="mb-0 fw-bold text-dark mt-1">@Model.Today.Total.ToString("N0")</h3>
                                    <small class="text-muted" style="font-size: 0.75rem;">Combined daily traffic</small>
                                </div>
                                <div class="bg-white rounded-circle p-3 shadow-sm text-purple" style="color: #6a1b9a;">
                                    <i class="fas fa-arrows-spin fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 7-Day Trend and Movement Summary -->
                <div class="row g-3">
                    <div class="col-lg-8">
                        <div class="card border-0 shadow-sm h-100" style="border-radius: 10px; background: #fafafa;">
                            <div class="card-header bg-transparent border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                                <h6 class="mb-0 fw-bold text-secondary">
                                    <i class="fas fa-calendar-week me-1 text-primary"></i> Last 7 Days Activity Trend
                                </h6>
                                <span class="badge bg-light text-secondary border">Total 7D: @Model.LastSevenDays.Total</span>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                                        <thead class="table-light text-secondary" style="font-size: 0.78rem; text-transform: uppercase;">
                                            <tr>
                                                <th>Date</th>
                                                <th class="text-center">Visitors</th>
                                                <th class="text-center">Gate In</th>
                                                <th class="text-center">Gate Out</th>
                                                <th class="text-end">Total Traffic</th>
                                                <th>Activity Share</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var day in Model.LastSevenDayTrend)
                                            {
                                                var pct = Model.LastSevenDays.Total > 0 ? (day.Total * 100.0 / Model.LastSevenDays.Total) : 0;
                                                <tr>
                                                    <td class="fw-semibold">@day.Date.ToString("ddd, dd MMM yyyy")</td>
                                                    <td class="text-center"><span class="badge bg-primary-subtle text-primary">@day.Visitors</span></td>
                                                    <td class="text-center"><span class="badge bg-success-subtle text-success">@day.GateIn</span></td>
                                                    <td class="text-center"><span class="badge bg-warning-subtle text-warning">@day.GateOut</span></td>
                                                    <td class="text-end fw-bold">@day.Total</td>
                                                    <td style="width: 25%;">
                                                        <div class="progress" style="height: 6px;">
                                                            <div class="progress-bar bg-primary" style="width: @pct.ToString("F0")%"></div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card border-0 shadow-sm h-100" style="border-radius: 10px; background: #fafafa;">
                            <div class="card-header bg-transparent border-0 pt-3 pb-2">
                                <h6 class="mb-0 fw-bold text-secondary">
                                    <i class="fas fa-compass me-1 text-primary"></i> Quick Operations
                                </h6>
                            </div>
                            <div class="card-body d-flex flex-column gap-2">
                                <a href="/gate/in/entry" class="btn btn-outline-primary text-start d-flex align-items-center gap-2 p-2">
                                    <i class="fas fa-plus-circle fs-5"></i>
                                    <div>
                                        <div class="fw-bold" style="font-size: 0.88rem;">New Gate In Pass</div>
                                        <small class="text-muted" style="font-size: 0.75rem;">Record arriving goods or returns</small>
                                    </div>
                                </a>
                                <a href="/gate/visitors/entry" class="btn btn-outline-success text-start d-flex align-items-center gap-2 p-2">
                                    <i class="fas fa-user-plus fs-5"></i>
                                    <div>
                                        <div class="fw-bold" style="font-size: 0.88rem;">Register Visitor</div>
                                        <small class="text-muted" style="font-size: 0.75rem;">Issue visitor badge and notify host</small>
                                    </div>
                                </a>
                                <a href="/gate/material-inward" class="btn btn-outline-info text-start d-flex align-items-center gap-2 p-2">
                                    <i class="fas fa-truck-ramp-box fs-5"></i>
                                    <div>
                                        <div class="fw-bold" style="font-size: 0.88rem;">Material Inward</div>
                                        <small class="text-muted" style="font-size: 0.75rem;">PO receiving &amp; weighment</small>
                                    </div>
                                </a>
                                <a href="/gate/material-outward" class="btn btn-outline-warning text-start d-flex align-items-center gap-2 p-2">
                                    <i class="fas fa-truck-arrow-right fs-5"></i>
                                    <div>
                                        <div class="fw-bold" style="font-size: 0.88rem;">Material Outward</div>
                                        <small class="text-muted" style="font-size: 0.75rem;">Dispatches &amp; delivery orders</small>
                                    </div>
                                </a>
                                <a href="/gate/vehicles" class="btn btn-outline-secondary text-start d-flex align-items-center gap-2 p-2">
                                    <i class="fas fa-truck-moving fs-5"></i>
                                    <div>
                                        <div class="fw-bold" style="font-size: 0.88rem;">Vehicle Check-in</div>
                                        <small class="text-muted" style="font-size: 0.75rem;">Monitor vehicles inside premises</small>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

