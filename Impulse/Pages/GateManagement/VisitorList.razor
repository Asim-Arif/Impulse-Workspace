@page "/gate/visitors"
@attribute [Authorize]

@using BlazorContextMenu
@using Impulse.Shared.Components

<PageTitle>Visitor Management - Impulse</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body">
            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4 text-primary"><i class="fas fa-id-badge"></i></span>
                    <div>
                        <h4 class="mb-0 fw-bold" style="color: #1a237e;">Visitor Management</h4>
                        <small class="text-muted">Track guests, contractor badges, concerned hosts &amp; checkout status</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync" disabled="@IsLoading">
                        <i class="fas fa-sync-alt @(IsLoading ? "fa-spin" : "") me-1"></i> Refresh
                    </button>
                    <a href="/gate/visitors/entry" class="btn btn-sm btn-primary">
                        <i class="fas fa-user-plus me-1"></i> New Visitor
                    </a>
                    <a href="/gate/visitors/gate-out" class="btn btn-sm btn-outline-danger">
                        <i class="fas fa-arrow-right-from-bracket me-1"></i> Checkout Scanner
                    </a>
                    <a href="/gate" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-arrow-left me-1"></i> Gate Hub
                    </a>
                </div>
            </div>

            <!-- Stats Bar -->
            <div class="row g-2 mb-3">
                <div class="col-md-4 col-sm-6">
                    <div class="p-2 border rounded bg-white shadow-sm d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted" style="font-size: 0.75rem;">Total Visitors</span>
                            <div class="fw-bold fs-5 text-dark">@Visitors.Count</div>
                        </div>
                        <i class="fas fa-users text-primary fs-4 opacity-50"></i>
                    </div>
                </div>
                <div class="col-md-4 col-sm-6">
                    <div class="p-2 border rounded bg-white shadow-sm d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted" style="font-size: 0.75rem;">Currently Inside</span>
                            <div class="fw-bold fs-5 text-warning">@Visitors.Count(x => x.TimeOut is null)</div>
                        </div>
                        <i class="fas fa-door-open text-warning fs-4 opacity-50"></i>
                    </div>
                </div>
                <div class="col-md-4 col-sm-6">
                    <div class="p-2 border rounded bg-white shadow-sm d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted" style="font-size: 0.75rem;">Checked Out</span>
                            <div class="fw-bold fs-5 text-success">@Visitors.Count(x => x.TimeOut is not null)</div>
                        </div>
                        <i class="fas fa-door-closed text-success fs-4 opacity-50"></i>
                    </div>
                </div>
            </div>

            <!-- Filters -->
            <div class="card border-0 bg-light p-2 mb-3" style="border-radius: 8px;">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Time Range</label>
                        <select class="form-select form-select-sm" value="@Filter.RangeKey" @onchange="RangeChangedAsync">
                            <option value="@MiscGateInRangeKeys.Today">Today</option>
                            <option value="@MiscGateInRangeKeys.Last15Days">Last 15 Days</option>
                            <option value="@MiscGateInRangeKeys.Last30Days">Last 30 Days</option>
                            <option value="@MiscGateInRangeKeys.Last60Days">Last 60 Days</option>
                            <option value="@MiscGateInRangeKeys.Last90Days">Last 90 Days</option>
                            <option value="@MiscGateInRangeKeys.Last180Days">Last 180 Days</option>
                            <option value="@MiscGateInRangeKeys.Custom">Custom</option>
                        </select>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">From - To</label>
                        <div class="d-flex gap-1">
                            <input type="date" class="form-control form-control-sm" @bind="Filter.FromDate" disabled="@(!IsCustomRange)" @bind:after="RefreshAsync" />
                            <input type="date" class="form-control form-control-sm" @bind="Filter.ToDate" disabled="@(!IsCustomRange)" @bind:after="RefreshAsync" />
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Concerned Employee / Host</label>
                        <select class="form-select form-select-sm" value="@Filter.EmployeeName" @onchange="EmployeeChangedAsync">
                            <option value="">&lt;All Employees&gt;</option>
                            @foreach (var emp in EmployeeFilterOptions)
                            {
                                <option value="@emp.Text">@emp.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label mb-1" style="font-size: 0.78rem; font-weight: 600;">Affiliated Vendor</label>
                        <select class="form-select form-select-sm" value="@Filter.VendorName" @onchange="VendorChangedAsync">
                            <option value="">&lt;All Vendors&gt;</option>
                            @foreach (var v in VendorFilterOptions)
                            {
                                <option value="@v.Text">@v.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="table-responsive border rounded" style="max-height: 60vh; overflow-y: auto;">
                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                    <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                        <tr>
                            <th style="width: 40px;" class="text-center">#</th>
                            <th>Entry Time</th>
                            <th>Visitor Name</th>
                            <th>Company</th>
                            <th>Concerned Host</th>
                            <th>Purpose</th>
                            <th>Vendor Affiliation</th>
                            <th class="text-center">Time Out</th>
                            <th class="text-center" style="width: 120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                    Loading visitor log...
                                </td>
                            </tr>
                        }
                        else if (Visitors.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block opacity-25"></i>
                                    No visitor records found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            var s = 0;
                            @foreach (var row in Visitors)
                            {
                                s++;
                                var isSel = SelectedEntryId == row.EntryId;
                                <ContextMenuTrigger MenuId="visitorContextMenu"
                                                    WrapperTag="tr"
                                                    Data="row"
                                                    class="@(isSel ? "table-primary" : "")"
                                                    @onclick="() => SelectRow(row.EntryId)"
                                                    @ondblclick="() => EditEntry(row.EntryId)">
                                    <td class="text-center text-muted">@s</td>
                                    <td>@(row.DateTime?.ToString("dd-MMM-yyyy hh:mm tt") ?? "")</td>
                                    <td class="fw-bold text-primary">@row.VisitorName</td>
                                    <td>@row.CompanyName</td>
                                    <td><span class="badge bg-light text-dark border">@row.ConcernedPerson</span></td>
                                    <td class="text-truncate" style="max-width: 180px;" title="@row.Purpose">@row.Purpose</td>
                                    <td>@row.VendorName</td>
                                    <td class="text-center">
                                        @if (row.TimeOut.HasValue)
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                @row.TimeOut.Value.ToString("hh:mm tt")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning">
                                                Inside
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center" @onclick:stopPropagation>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-secondary btn-sm" title="Edit" @onclick="() => EditEntry(row.EntryId)">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>
                                            <a class="btn btn-outline-primary btn-sm" title="Visitor Badge" href="/gate/visitors/pass/@row.EntryId">
                                                <i class="fas fa-id-card"></i>
                                            </a>
                                            <button class="btn btn-outline-secondary btn-sm" title="Print Slip" @onclick="() => PrintSlipAsync(row.EntryId)">
                                                <i class="fas fa-print"></i>
                                            </button>
                                        </div>
                                    </td>
                                </ContextMenuTrigger>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Context Menu -->
<ContextMenu Id="visitorContextMenu" Template="Win11Style">
    <Item OnClick="OnContextEdit"><i class="fas fa-pencil-alt win11-icon text-primary me-2"></i> Edit Visitor</Item>
    <Item OnClick="OnContextPass"><i class="fas fa-id-card win11-icon text-info me-2"></i> View / Print Badge</Item>
    <Item OnClick="OnContextPrintSlip"><i class="fas fa-file-invoice win11-icon text-secondary me-2"></i> Print Slip</Item>
    <Item OnClick="OnContextGateOut"><i class="fas fa-door-open win11-icon text-danger me-2"></i> Checkout (Gate Out)</Item>
</ContextMenu>

