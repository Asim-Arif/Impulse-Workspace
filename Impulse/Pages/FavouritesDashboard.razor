@page "/favourites"
@attribute [Authorize]
@using Impulse.Shared.Components

<PageTitle>Favourites | Impulse ERP</PageTitle>

<div class="dashboard-shell">
    <div class="dashboard-hero">
        <div class="dashboard-icon-wrap" style="background:#fff3cd; color:#b78103;">
            <i class="fas fa-star"></i>
        </div>
        <div class="flex-grow-1">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="dashboard-title">Favourites</h1>
                    <p class="dashboard-subtitle">Your pinned workflows and quick-access shortcuts across all ERP modules</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis px-3 py-2 fw-semibold" style="font-size: 0.85rem;">
                        <i class="fas fa-star me-1 text-warning"></i> @Favourites.Count Pinned
                    </span>
                    <a href="/" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 shadow-sm px-3 py-1">
                        <i class="fas fa-home"></i>
                        <span>Home</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status">
                <span class="visually-hidden">Loading favourites...</span>
            </div>
            <p class="text-secondary small mt-2">Loading your pinned shortcuts...</p>
        </div>
    }
    else if (!Favourites.Any())
    {
        <div class="card border-0 shadow-sm mx-auto p-5 text-center my-4" style="max-width: 600px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border-radius: 16px;">
            <div class="mb-3">
                <span class="d-inline-flex p-3 rounded-circle bg-warning-subtle text-warning">
                    <i class="fas fa-star fa-3x"></i>
                </span>
            </div>
            <h4 class="fw-bold text-dark mb-1">No Favourites Pinned Yet</h4>
            <p class="text-secondary small mb-4">
                You haven't pinned any shortcuts yet. Right-click on any menu item in the left navigation sidebar and select 
                <strong>"Add to Favourites"</strong> to organize your frequent workflows in one place.
            </p>
            <div class="d-flex justify-content-center flex-wrap gap-2">
                <a href="/stock" class="btn btn-sm btn-outline-primary px-3">
                    <i class="fas fa-boxes-stacked me-1"></i> Stock Hub
                </a>
                <a href="/production" class="btn btn-sm btn-outline-danger px-3">
                    <i class="fas fa-industry me-1"></i> Production Hub
                </a>
                <a href="/financial" class="btn btn-sm btn-outline-info px-3">
                    <i class="fas fa-chart-line me-1"></i> Financial Hub
                </a>
                <a href="/payroll" class="btn btn-sm btn-outline-success px-3">
                    <i class="fas fa-users-gear me-1"></i> Payroll Hub
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="dashboard-modules">
            @foreach (var item in Favourites)
            {
                <div class="favourite-card-container position-relative">
                    <BlazorContextMenu.ContextMenuTrigger MenuId="favCardContextMenu" Data="item" WrapperTag="div" class="w-100 h-100">
                        <SecureDashCard Href="@item.Href" OptionId="@item.OptionId" Module="@item.Module" Class="fav-dash-card">
                            <div class="d-flex align-items-center justify-content-between w-100 px-1">
                                @if (!string.IsNullOrWhiteSpace(item.Module))
                                {
                                    <span class="badge @GetModuleBadgeClass(item.Module)" style="font-size: 0.68rem; font-weight: 600;">
                                        @item.Module
                                    </span>
                                }
                                else
                                {
                                    <span></span>
                                }
                                @if (!item.IsAuthorized)
                                {
                                    <span class="badge bg-danger-subtle text-danger" style="font-size: 0.65rem;" title="Access revoked by Administrator">
                                        <i class="fas fa-lock me-1"></i> Restricted
                                    </span>
                                }
                            </div>
                            <i class="@item.IconClass @GetModuleIconColor(item.Module)"></i>
                            <span class="card-title-text">@item.Title</span>
                        </SecureDashCard>
                    </BlazorContextMenu.ContextMenuTrigger>

                    <button type="button"
                            class="btn-unpin"
                            title="Remove from Favourites"
                            @onclick="() => RemoveFavouriteAsync(item.OptionId, item.Title)">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            }
        </div>
    }
</div>

<BlazorContextMenu.ContextMenu Id="favCardContextMenu" Template="Win11Style">
    <BlazorContextMenu.Item OnClick="HandleRemoveFromMenu" CssClass="win11-menu-item text-danger">
        <i class="fas fa-trash-alt win11-icon text-danger"></i> Remove from Favourites
    </BlazorContextMenu.Item>
</BlazorContextMenu.ContextMenu>

<style>
    .dashboard-shell { padding: 2rem; max-width: 1150px; margin: 0 auto; font-family: 'Calibri', 'Segoe UI', sans-serif; }
    .dashboard-hero { display: flex; align-items: center; gap: 1.25rem; margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 2px solid #e0e2ec; }
    .dashboard-icon-wrap { width: 64px; height: 64px; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 1.85rem; flex-shrink: 0; box-shadow: 0 4px 14px rgba(183, 129, 3, 0.2); }
    .dashboard-title { font-size: 2rem; font-weight: 700; color: #1b1b1f; margin: 0; line-height: 1.2; }
    .dashboard-subtitle { color: #44474f; margin: 0.25rem 0 0; font-size: 0.95rem; }
    .dashboard-modules { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 1.25rem; }

    .favourite-card-container {
        position: relative;
        transition: transform 0.15s ease;
    }

    .fav-dash-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 1.25rem 1rem 1.25rem;
        background: #ffffff;
        border: 1px solid #e0e2ec;
        border-radius: 16px;
        text-decoration: none;
        color: #1b1b1f;
        font-weight: 500;
        font-size: 0.875rem;
        text-align: center;
        transition: background-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
        cursor: pointer;
        min-height: 135px;
    }

    .fav-dash-card i {
        font-size: 1.85rem;
    }

    .card-title-text {
        font-size: 0.88rem;
        font-weight: 600;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .fav-dash-card:hover {
        background: #fdfaf3;
        box-shadow: 0 6px 20px rgba(183, 129, 3, 0.15);
        transform: translateY(-2px);
        text-decoration: none;
        border-color: #f59e0b;
    }

    .btn-unpin {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        border: none;
        background: rgba(0, 0, 0, 0.05);
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        opacity: 0;
        transition: opacity 0.15s ease, background 0.15s ease, color 0.15s ease;
        cursor: pointer;
        z-index: 5;
    }

    .favourite-card-container:hover .btn-unpin {
        opacity: 1;
    }

    .btn-unpin:hover {
        background: #fee2e2;
        color: #dc2626;
    }

    .bg-purple-subtle {
        background-color: #f3e8ff !important;
        color: #7a3abf !important;
    }

    .text-purple {
        color: #7a3abf !important;
    }
</style>
