@page "/payroll"
@attribute [Authorize]

@using Impulse.Shared.Components

<PageTitle>Payroll Dashboard</PageTitle>

<div class="dashboard-shell">
    <div class="dashboard-hero">
        <div class="dashboard-icon-wrap" style="background:#dce8d4; color:#1a4731;">
            <i class="fas fa-users-gear"></i>
        </div>
        <div>
            <h1 class="dashboard-title">Payroll</h1>
            <p class="dashboard-subtitle">Employees, departments &amp; payroll processing</p>
        </div>
    </div>

    <div class="dashboard-modules">
        <SecureDashCard Href="/payroll/newemployee">
            <i class="fas fa-user-plus"></i>
            <span>New Employee</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/employeelist">
            <i class="fas fa-user-tie"></i>
            <span>Employee List</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/employeelist?contractorsOnly=true">
            <i class="fas fa-user-clock"></i>
            <span>Temp. Employee List</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/deptlist">
            <i class="fas fa-building"></i>
            <span>Departments List</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/salary-history?returnUrl=/payroll">
            <i class="fas fa-file-invoice-dollar"></i>
            <span>Salary History</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/attendance-ledger?returnUrl=/payroll">
            <i class="fas fa-calendar-check"></i>
            <span>Attendance Ledger</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/employee-transfer?returnUrl=/payroll">
            <i class="fas fa-exchange-alt"></i>
            <span>Employee Transfer</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/manual-attendance?returnUrl=/payroll">
            <i class="fas fa-clock"></i>
            <span>Manual Attendance</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/overtime-authorization?returnUrl=/payroll">
            <i class="fas fa-user-clock"></i>
            <span>Overtime Authorization</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/manual-attendance?returnUrl=/payroll">
            <i class="fas fa-sync-alt"></i>
            <span>Re-Calculate Attendance</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/auto-attendance?returnUrl=/payroll">
            <i class="fas fa-magic"></i>
            <span>Auto Attendance</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/daily-activity?returnUrl=/payroll">
            <i class="fas fa-fingerprint"></i>
            <span>Daily Activity</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/leaves?returnUrl=/payroll">
            <i class="fas fa-calendar-minus"></i>
            <span>Employee Leaves</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/monthly-attendance?returnUrl=/payroll">
            <i class="fas fa-calendar-alt"></i>
            <span>Monthly Attendance Editor</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/gate-pass?returnUrl=/payroll">
            <i class="fas fa-id-badge"></i>
            <span>Gate Pass Entry</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/advance-long?returnUrl=/payroll">
            <i class="fas fa-hand-holding-usd"></i>
            <span>Long Term Advance</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/advance-short?returnUrl=/payroll">
            <i class="fas fa-hand-holding-usd"></i>
            <span>Short Term Advance</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/short-term-sheet?returnUrl=/payroll">
            <i class="fas fa-file-invoice-dollar"></i>
            <span>Short Term Sheet</span>
        </SecureDashCard>

        <SecureDashCard Href="/payroll/emp-to-emp-transfer?returnUrl=/payroll">
            <i class="fas fa-exchange-alt"></i>
            <span>Emp. to Emp. Transfer</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/adjust-deduction-amount?returnUrl=/payroll">
            <i class="fas fa-edit"></i>
            <span>Adjust Deduction Amount</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/advance-ledger?returnUrl=/payroll">
            <i class="fas fa-book"></i>
            <span>Loan & Advance Register</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/post-fine?returnUrl=/payroll">
            <i class="fas fa-gavel"></i>
            <span>Post Fine</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/emp-fine-ledger?returnUrl=/payroll">
            <i class="fas fa-file-invoice"></i>
            <span>Employee Fine Register</span>
        </SecureDashCard>
        <SecureDashCard Class="dash-card primary-card" Href="/payroll/salary-sheet?returnUrl=/payroll">
            <i class="fas fa-file-invoice-dollar"></i>
            <span>Salary Sheet</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/hold-salary?returnUrl=/payroll">
            <i class="fas fa-hand-holding-dollar"></i>
            <span>Hold Salary</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/gratuity-calculation?returnUrl=/payroll">
            <i class="fas fa-gift"></i>
            <span>Gratuity Calculation</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/designations?returnUrl=/payroll">
            <i class="fas fa-tags"></i>
            <span>Designations</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/settings?returnUrl=/payroll">
            <i class="fas fa-sliders-h"></i>
            <span>Payroll Settings</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/policies?returnUrl=/payroll">
            <i class="fas fa-file-contract"></i>
            <span>Payroll Policies</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/holidays?returnUrl=/payroll">
            <i class="fas fa-calendar-alt"></i>
            <span>Holidays Setup</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/reports?returnUrl=/payroll">
            <i class="fas fa-chart-bar"></i>
            <span>Reports</span>
        </SecureDashCard>

        <SecureDashCard Href="/payroll/clear-long-term-loan?returnUrl=/payroll">
            <i class="fas fa-money-check-alt"></i>
            <span>Clear Long Term Loan</span>
        </SecureDashCard>
        <SecureDashCard Href="/payroll/clear-short-term-loan?returnUrl=/payroll">
            <i class="fas fa-money-bill-wave"></i>
            <span>Clear Short Term Loan</span>
        </SecureDashCard>
    </div>
</div>

<style>
    .dashboard-shell { padding: 2rem; max-width: 1100px; }
    .dashboard-hero { display: flex; align-items: center; gap: 1.25rem; margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 2px solid #e0e2ec; }
    .dashboard-icon-wrap { width: 64px; height: 64px; border-radius: 18px; background: #dce8d4; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; color: #1a4731; flex-shrink: 0; }
    .dashboard-title { font-size: 2rem; font-weight: 700; color: #1b1b1f; margin: 0; line-height: 1.2; }
    .dashboard-subtitle { color: #44474f; margin: 0.25rem 0 0; font-size: 0.95rem; }
    .dashboard-modules { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1rem; }
    .dash-card { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem; padding: 1.5rem 1rem; background: #ffffff; border: 1px solid #e0e2ec; border-radius: 16px; text-decoration: none; color: #1b1b1f; font-weight: 500; font-size: 0.875rem; text-align: center; transition: background-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease; cursor: pointer; }
    .dash-card i { font-size: 1.75rem; color: #3a7a52; }
    .dash-card:hover { background: #edf7f0; box-shadow: 0 4px 16px rgba(58, 122, 82, 0.12); transform: translateY(-2px); color: #1a4731; }
    .dash-card:hover i { color: #1a4731; }
</style>
