@page "/stock"
@attribute [Authorize]
@inject NavigationManager NavigationManager

<PageTitle>Stock Dashboard</PageTitle>

<div class="dashboard-shell">
    <div class="dashboard-hero">
        <div class="dashboard-icon-wrap" style="background:#ede0f7; color:#3c1a6e;">
            <i class="fas fa-boxes-stacked"></i>
        </div>
        <div>
            <h1 class="dashboard-title">Stock</h1>
            <p class="dashboard-subtitle">Inventory management &amp; stock operations</p>
        </div>
    </div>

    <div class="dashboard-modules">
        <SecureDashCard Href="/stock/rmgroups" OptionId="StkRMGroups" Module="Stock">
            <i class="fas fa-layer-group"></i>
            <span>Raw Material Groups</span>
        </SecureDashCard>
        <SecureDashCard Href="/newrm" OptionId="StkNewRM" Module="Stock">
            <i class="fas fa-boxes"></i>
            <span>New Raw Material</span>
        </SecureDashCard>
        <SecureDashCard Href="/newvendor" OptionId="StkNewVendor" Module="Stock">
            <i class="fas fa-truck"></i>
            <span>New Vendor</span>
        </SecureDashCard>
        <SecureDashCard Href="/vendorlist" OptionId="StkVendorList" Module="Stock">
            <i class="fas fa-users"></i>
            <span>Vendor List</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/vendor-rm-assignment" OptionId="StkVendorRMAssign" Module="Stock">
            <i class="fas fa-link"></i>
            <span>Vendor RM Assignment</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/rm-movement" OptionId="StkMaterialMovement" Module="Stock">
            <i class="fas fa-exchange-alt"></i>
            <span>Material Movement</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/change-batch-lot" OptionId="StkChangeBatchLot" Module="Stock">
            <i class="fas fa-edit"></i>
            <span>Change Batch / Lot</span>
        </SecureDashCard>
        <SecureDashCard Href="/rmlist" OptionId="StkRMList" Module="Stock">
            <i class="fas fa-list"></i>
            <span>Raw Materials List</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/stock-ledger" OptionId="StkRMLedger" Module="Stock">
            <i class="fas fa-book-open"></i>
            <span>RM Stock Ledger</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/new-rm-po" OptionId="StkNewRMPO" Module="Stock">
            <i class="fas fa-file-invoice"></i>
            <span>New RM PO</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/rmpolist" OptionId="StkRMPOList" Module="Stock">
            <i class="fas fa-list-alt"></i>
            <span>RM PO List</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/vend-gate-rcvd" OptionId="StkVendorGateRcv" Module="Stock">
            <i class="fas fa-truck-loading"></i>
            <span>Vendor Gate Receiving</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/vend-rcv-list" OptionId="StkVendorRcvList" Module="Stock">
            <i class="fas fa-list-check"></i>
            <span>Vendor Receiving List</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/rm-issuance" OptionId="StkRMIssuance" Module="Stock">
            <i class="fas fa-boxes"></i>
            <span>RM Issuance</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/rm-issuance-list" OptionId="StkRMIssuanceList" Module="Stock">
            <i class="fas fa-list-alt"></i>
            <span>RM Issuance List</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/semi-finish-open-receiving?returnUrl=/stock" OptionId="StkSFOpenRcv" Module="Stock">
            <i class="fas fa-boxes-packing"></i>
            <span>Semi Finish Open Receiving</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/sf-movement?returnUrl=/stock" OptionId="StkSFMovement" Module="Stock">
            <i class="fas fa-exchange-alt"></i>
            <span>Semi Finish Movement</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/sf-transactions?returnUrl=/stock" OptionId="StkSFTransactions" Module="Stock">
            <i class="fas fa-history"></i>
            <span>Semi Finish Transactions</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/finish-stock-issuance?returnUrl=/stock" OptionId="StkFinishIssuance" Module="Stock">
            <i class="fas fa-boxes-stacked"></i>
            <span>Finish Stock Issuance</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/stock-order-adjustment?returnUrl=/stock" OptionId="StkFinishIssuance" Module="Stock">
            <i class="fas fa-boxes-packing"></i>
            <span>Stock Order Adjustment (PPC)</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/finish-stock-receiving?returnUrl=/stock" OptionId="StkFinishReceiving" Module="Stock">
            <i class="fas fa-boxes-packing"></i>
            <span>Finish Stock Receiving</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/finish-transactions?returnUrl=/stock" OptionId="StkFinishTransactions" Module="Stock">
            <i class="fas fa-history"></i>
            <span>Finish Stock Transactions</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/finish-item-ledger?returnUrl=/stock" OptionId="StkFinishItemLedger" Module="Stock">
            <i class="fas fa-book-open"></i>
            <span>Finish Item Ledger</span>
        </SecureDashCard>
        <SecureDashCard Href="/stock/finish-stock-movement?returnUrl=/stock" OptionId="StkFinishMovement" Module="Stock">
            <i class="fas fa-right-left"></i>
            <span>Finish Stock Movement</span>
        </SecureDashCard>
    </div>
</div>

<style>
    .dashboard-shell { padding: 2rem; max-width: 1100px; }
    .dashboard-hero { display: flex; align-items: center; gap: 1.25rem; margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 2px solid #e0e2ec; }
    .dashboard-icon-wrap { width: 64px; height: 64px; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; flex-shrink: 0; }
    .dashboard-title { font-size: 2rem; font-weight: 700; color: #1b1b1f; margin: 0; line-height: 1.2; }
    .dashboard-subtitle { color: #44474f; margin: 0.25rem 0 0; font-size: 0.95rem; }
    .dashboard-modules { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1rem; }
    .dash-card { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem; padding: 1.5rem 1rem; background: #ffffff; border: 1px solid #e0e2ec; border-radius: 16px; text-decoration: none; color: #1b1b1f; font-weight: 500; font-size: 0.875rem; text-align: center; transition: background-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease; cursor: pointer; }
    .dash-card i { font-size: 1.75rem; color: #7a3abf; }
    .dash-card:hover { background: #f7f0fc; box-shadow: 0 4px 16px rgba(122, 58, 191, 0.15); transform: translateY(-2px); color: #3c1a6e; text-decoration: none; }
    .dash-card:hover i { color: #3c1a6e; }
    .dash-card.coming-soon { opacity: 0.55; cursor: default; }
</style>
