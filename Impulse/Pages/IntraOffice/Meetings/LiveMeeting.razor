@page "/intraoffice/meetings/live/{MeetingId:int}"
@attribute [Authorize]

<PageTitle>Live Meeting Room - IntraOffice</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border-radius: 12px; height: 86vh;">
        <div class="card-body p-0 d-flex flex-column h-100">
            @if (MeetingModel == null)
            {
                <div class="d-flex flex-column justify-content-center align-items-center h-100">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
                    <h5 class="fw-bold text-dark">Connecting to Live Meeting...</h5>
                    <p class="small text-muted">Please wait while the video conference room is initialized.</p>
                </div>
            }
            else
            {
                <!-- Header -->
                <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-light">
                    <div class="d-flex align-items-center gap-2">
                        <div class="d-flex align-items-center justify-content-center rounded-3 bg-danger text-white p-2" style="width: 38px; height: 38px;">
                            <i class="fas fa-video"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0 text-dark">@MeetingModel.Title</h6>
                            <small class="text-secondary">Organizer: @(MeetingModel.OrganizerName ?? MeetingModel.OrganizerId) · Room: @MeetingModel.Id</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a href="/intraoffice/meetings" class="btn btn-sm btn-outline-danger">
                            <i class="fas fa-phone-slash me-1"></i>Leave Call
                        </a>
                    </div>
                </div>

                <!-- Meeting Split: Left Jitsi IFrame, Right Meeting Minutes -->
                <div class="row g-0 flex-grow-1 overflow-hidden">
                    <!-- Left Video Frame -->
                    <div class="col-lg-8 h-100 bg-dark position-relative">
                        <iframe src="@MeetingModel.MeetingUrl"
                                allow="camera; microphone; fullscreen; display-capture; autoplay"
                                style="width: 100%; height: 100%; border: none;">
                        </iframe>
                    </div>

                    <!-- Right Notepad -->
                    <div class="col-lg-4 h-100 border-start d-flex flex-column bg-white">
                        <div class="p-3 border-bottom bg-light">
                            <h6 class="fw-bold mb-1 text-dark"><i class="fas fa-pen-to-square text-primary me-2"></i>Meeting Minutes &amp; Notes</h6>
                            <small class="text-muted">Take real-time notes during the conference.</small>
                        </div>
                        <div class="flex-grow-1 p-3 d-flex flex-column">
                            <textarea class="form-control flex-grow-1 mb-3" placeholder="Type meeting discussion notes, action items, and decisions here..." @bind="MeetingNotes" style="resize: none; font-size: 0.9rem;"></textarea>
                            <button class="btn btn-primary btn-sm shadow-sm" @onclick="SaveMeetingNotesAsync" disabled="@IsSavingNotes">
                                @if (IsSavingNotes)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <i class="fas fa-floppy-disk me-1"></i>
                                    <span>Save Meeting Minutes</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
