@page "/office/meetings/live/{MeetingId:int}"
@page "/meetings/live/{MeetingId:int}"
@attribute [Authorize]
@using DataAccessLibrary.Models.IntraOffice
@using Impulse.Services.IntraOffice
@inject AuthenticationStateProvider AuthStateProvider
@inject IIntraOfficeService IntraOfficeService
@inject IMeetingService MeetingService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IAiService AiService
@inject IFileService FileService
@implements IDisposable

<div class="d-flex" style="height: calc(100vh - 120px); gap: 20px;">
    @if (meeting == null)
    {
        <div class="w-100 h-100 d-flex justify-content-center align-items-center flex-column">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
            <h3 class="mt-4">Joining Meeting...</h3>
        </div>
    }
    else
    {
        <!-- Left Side: Jitsi Meet IFrame -->
        <div class="meeting-video-container" style="flex: 2; background: #1a1a1a; border-radius: 8px; overflow: hidden; position: relative;">
            <div style="position: absolute; top: 10px; left: 10px; z-index: 10; background: rgba(0,0,0,0.6); padding: 4px 12px; border-radius: 4px; color: white;">
                @meeting.Title
            </div>
            
            <iframe src="@meeting.MeetingUrl" 
                    allow="camera; microphone; fullscreen; display-capture; autoplay"
                    style="width: 100%; height: 100%; border: none;">
            </iframe>
        </div>

        <!-- Right Side: Meeting Minutes Notepad (Organizer & Attendees with permissions) -->
        <div class="meeting-notes-container" style="flex: 1; display: flex; flex-direction: column; background: var(--bg-secondary); border-radius: 8px; border: 1px solid var(--border-color); overflow: hidden;">
            <div class="p-3" style="border-bottom: 1px solid var(--border-color); background: var(--bg-primary);">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-journal-text text-primary me-1"></i> Meeting Minutes</h5>
                    @if (isDictating)
                    {
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1 animate-pulse" style="font-size: 0.72rem;">
                            <i class="bi bi-record-circle me-1"></i> Live Dictating...
                        </span>
                    }
                    else if (isRecordingAudio)
                    {
                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1 animate-pulse" style="font-size: 0.72rem;">
                            <i class="bi bi-mic-fill me-1"></i> Recording Audio (@recordingSeconds s)
                        </span>
                    }
                </div>
                
                <p class="text-muted mb-2" style="font-size: 0.8rem;">
                    Capture meeting minutes in <strong>both text & voice</strong>. A formatted Word document (.docx) and voice recording are distributed upon ending.
                </p>

                <!-- Action Toolbar for Voice & AI -->
                <div class="d-flex flex-wrap gap-2 pt-1 border-top">
                    <!-- Speech to Text Dictation Button -->
                    <button type="button" class="btn btn-sm @(isDictating ? "btn-danger" : "btn-outline-primary")" 
                            @onclick="ToggleDictation" title="Speak into microphone to type text automatically">
                        <i class="bi @(isDictating ? "bi-mic-mute-fill" : "bi-mic-fill") me-1"></i>
                        @(isDictating ? "Stop Dictation" : "Voice Dictate")
                    </button>

                    <!-- Record Audio Voice Note Button -->
                    <button type="button" class="btn btn-sm @(isRecordingAudio ? "btn-danger" : "btn-outline-success")" 
                            @onclick="ToggleAudioRecording" title="Record an audio clip attached to the meeting minutes">
                        <i class="bi @(isRecordingAudio ? "bi-stop-circle-fill" : "bi-record-circle") me-1"></i>
                        @(isRecordingAudio ? $"Stop Audio ({recordingSeconds}s)" : "Record Audio Note")
                    </button>

                    <!-- AI Fix / Clean Notes Button -->
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="FixNotesSpelling" disabled="@(isAiLoading || string.IsNullOrWhiteSpace(meetingMinutes))" title="Refine and format notes with AI">
                        @if (isAiLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Refining...</span>
                        }
                        else
                        {
                            <i class="bi bi-magic me-1"></i>
                            <span>AI Polish</span>
                        }
                    </button>
                </div>
            </div>
            
            <div class="p-3" style="flex: 1; display: flex; flex-direction: column; overflow-y: auto;">
                <!-- Audio Player Preview if a voice note is recorded -->
                @if (!string.IsNullOrEmpty(voiceNotePath))
                {
                    <div class="mb-3 p-2 bg-light border rounded-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-file-earmark-music-fill text-success fs-5"></i>
                            <div>
                                <div class="fw-bold small text-dark">Recorded Meeting Voice Note</div>
                                <audio controls style="height: 32px; max-width: 220px;" src="@voiceNotePath" class="mt-1"></audio>
                            </div>
                        </div>
                        <button type="button" class="btn btn-xs btn-outline-danger" @onclick="RemoveVoiceNote" title="Delete Audio Note">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                }

                <div style="flex: 1; display: flex; flex-direction: column; position: relative;">
                    <textarea class="form-control" @bind="meetingMinutes" @bind:event="oninput" 
                              placeholder="Type minutes or click 'Voice Dictate' to speak. Everything will be saved and exported to a Word document..." 
                              style="flex: 1; min-height: 200px; resize: none; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 0.95rem; line-height: 1.5;" 
                              disabled="@isAiLoading"></textarea>
                    
                    @if (isDictating && !string.IsNullOrEmpty(liveInterimText))
                    {
                        <div class="p-2 bg-info bg-opacity-10 border border-info border-opacity-25 rounded-2 mt-2 text-info small">
                            <i class="bi bi-soundwave me-1"></i> <em>Hearing: "@liveInterimText"</em>
                        </div>
                    }
                </div>
                
                <div class="mt-3 pt-3" style="border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; position: relative; z-index: 10;">
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-danger shadow-sm" @onclick="LeaveMeeting">
                            <i class="bi bi-box-arrow-left me-1"></i> Leave Call
                        </button>
                    </div>
                    <div>
                        <button type="button" class="btn btn-primary shadow-sm" @onclick="EndMeetingAndDistribute" disabled="@isEnding">
                            @if (isEnding)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Distributing Minutes...</span>
                            }
                            else
                            {
                                <span><i class="bi bi-file-word-fill me-1"></i> End & Distribute Minutes</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (showSuccessModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0" style="border-radius: 16px; overflow: hidden;">
                <div class="modal-body text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem;"></i>
                    </div>
                    <h3 class="fw-bold mb-2 text-dark">Meeting Concluded!</h3>
                    <p class="text-muted mb-3" style="font-size: 0.95rem;">
                        The meeting minutes have been formatted into an official Word document (.docx) and distributed to all participants via WhatsApp and Email.
                    </p>
                    @if (!string.IsNullOrEmpty(voiceNotePath))
                    {
                        <div class="alert alert-success d-inline-flex align-items-center gap-2 py-2 px-3 mb-3 text-start">
                            <i class="bi bi-mic-fill fs-5"></i>
                            <div>
                                <strong class="d-block">Voice Note Attached</strong>
                                <span class="small">Audio recording was also delivered to all participants.</span>
                            </div>
                        </div>
                    }
                    <div>
                        <button class="btn btn-primary px-4 py-2 rounded-pill shadow-sm" @onclick="ReturnToDashboard">
                            <i class="bi bi-arrow-left me-1"></i> Return to Meetings Hub
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int MeetingId { get; set; }

    private IntraUserProfile? currentUser;
    private Meeting? meeting;
    private bool isOrganizer => currentUser != null && meeting != null && currentUser.Id == meeting.OrganizerId;
    
    private string meetingMinutes = "";
    private string? voiceNotePath = null;
    private bool isEnding = false;
    private bool showSuccessModal = false;
    private bool isAiLoading = false;

    // Voice dictation state
    private bool isDictating = false;
    private string liveInterimText = "";
    private DotNetObjectReference<LiveMeeting>? objRef;

    // Audio recording state
    private bool isRecordingAudio = false;
    private int recordingSeconds = 0;
    private System.Threading.Timer? recordingTimer;

    public class AudioRecordingResult
    {
        public string Base64 { get; set; } = "";
        public string MimeType { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var userId = user.Identity?.Name
                ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                ?? user.FindFirst("sub")?.Value;

            if (!string.IsNullOrEmpty(userId))
            {
                currentUser = await IntraOfficeService.GetUserProfileAsync(userId);
                currentUser ??= new IntraUserProfile { UserName = userId, FullUserName = userId };
            }

            if (currentUser != null)
            {
                meeting = await MeetingService.GetMeetingAsync(MeetingId);
                
                if (meeting != null)
                {
                    meetingMinutes = meeting.MeetingMinutes ?? string.Empty;
                    voiceNotePath = meeting.VoiceNotePath;
                }
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
        }
    }

    private async Task ToggleDictation()
    {
        try
        {
            if (!isDictating)
            {
                objRef ??= DotNetObjectReference.Create(this);
                // Verify window.meetingSpeech exists
                var isAvailable = await JS.InvokeAsync<bool>("eval", "typeof window.meetingSpeech !== 'undefined' && typeof window.meetingSpeech.startListening === 'function'");
                if (!isAvailable)
                {
                    await JS.InvokeVoidAsync("alert", "Voice dictation script is not yet available or not supported by this browser. Please use Google Chrome or Microsoft Edge, or refresh the page.");
                    return;
                }

                var started = await JS.InvokeAsync<bool>("window.meetingSpeech.startListening", objRef);
                if (started)
                {
                    isDictating = true;
                    liveInterimText = "";
                }
            }
            else
            {
                try
                {
                    await JS.InvokeVoidAsync("window.meetingSpeech.stopListening");
                }
                catch { }
                isDictating = false;
                liveInterimText = "";
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Voice dictation error: " + ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnSpeechRecognized(string finalText, string interimText)
    {
        if (!string.IsNullOrEmpty(finalText))
        {
            if (!string.IsNullOrWhiteSpace(meetingMinutes) && !meetingMinutes.EndsWith(" ") && !meetingMinutes.EndsWith("\n"))
            {
                meetingMinutes += " ";
            }
            meetingMinutes += finalText.Trim() + " ";
        }

        liveInterimText = interimText;
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleAudioRecording()
    {
        try
        {
            if (!isRecordingAudio)
            {
                var isAvailable = await JS.InvokeAsync<bool>("eval", "typeof window.audioRecorder !== 'undefined' && typeof window.audioRecorder.startRecording === 'function'");
                if (!isAvailable)
                {
                    await JS.InvokeVoidAsync("alert", "Audio recording script is not yet available. Please refresh the page.");
                    return;
                }

                var started = await JS.InvokeAsync<bool>("window.audioRecorder.startRecording");
                if (started)
                {
                    isRecordingAudio = true;
                    recordingSeconds = 0;
                    recordingTimer = new System.Threading.Timer(_ =>
                    {
                        recordingSeconds++;
                        InvokeAsync(StateHasChanged);
                    }, null, 1000, 1000);
                    StateHasChanged();
                }
            }
            else
            {
                isRecordingAudio = false;
                recordingTimer?.Dispose();
                recordingTimer = null;
                StateHasChanged();

                AudioRecordingResult? result = null;
                try
                {
                    result = await JS.InvokeAsync<AudioRecordingResult>("window.audioRecorder.stopRecording");
                }
                catch (Exception ex)
                {
                    await JS.InvokeVoidAsync("alert", "Could not finalize recording: " + ex.Message);
                }

                if (result != null && !string.IsNullOrEmpty(result.Base64))
                {
                    var fileName = $"MeetingVoice_{MeetingId}_{DateTime.Now:yyyyMMdd_HHmmss}.webm";
                    voiceNotePath = await FileService.SaveBase64FileToDiskAsync(result.Base64, fileName);
                    
                    // Auto-save to meeting record
                    await MeetingService.UpdateMeetingMinutesAsync(MeetingId, meetingMinutes, voiceNotePath);
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Audio recording error: " + ex.Message);
        }
    }

    private async Task RemoveVoiceNote()
    {
        try
        {
            voiceNotePath = null;
            if (meeting != null)
            {
                await MeetingService.UpdateMeetingMinutesAsync(meeting.Id, meetingMinutes, "");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Could not remove voice note: " + ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task LeaveMeeting()
    {
        try
        {
            await StopAnyActiveAudioAsync();
        }
        catch { }
        Navigation.NavigateTo("/meetings");
    }

    private async Task FixNotesSpelling()
    {
        if (string.IsNullOrWhiteSpace(meetingMinutes)) return;
        isAiLoading = true;
        StateHasChanged();
        try
        {
            meetingMinutes = await AiService.CheckSpellingAndGrammarAsync(meetingMinutes);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "AI Error: " + ex.Message);
        }
        finally
        {
            isAiLoading = false;
            StateHasChanged();
        }
    }

    private async Task EndMeetingAndDistribute()
    {
        if (meeting == null || isEnding) return;
        
        // Stop any active recordings/dictations
        await StopAnyActiveAudioAsync();

        isEnding = true;
        StateHasChanged();
        
        try
        {
            // 1. Save minutes & voice note
            await MeetingService.UpdateMeetingMinutesAsync(meeting.Id, meetingMinutes, voiceNotePath);
            
            // 2. Generate Docx and Send
            var success = await MeetingService.GenerateAndDistributeMinutesAsync(meeting.Id);
            
            if (success)
            {
                showSuccessModal = true;
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Meeting ended, but some distribution notifications could not be sent.");
                Navigation.NavigateTo("/meetings");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Error concluding meeting: " + ex.Message);
            Navigation.NavigateTo("/meetings");
        }
        finally
        {
            isEnding = false;
            StateHasChanged();
        }
    }
    
    private async Task StopAnyActiveAudioAsync()
    {
        if (isDictating)
        {
            try
            {
                await JS.InvokeVoidAsync("window.meetingSpeech.stopListening");
            }
            catch { }
            isDictating = false;
        }
        if (isRecordingAudio)
        {
            try
            {
                recordingTimer?.Dispose();
                recordingTimer = null;
                await JS.InvokeVoidAsync("window.audioRecorder.stopRecording");
            }
            catch { }
            isRecordingAudio = false;
        }
    }

    private void ReturnToDashboard()
    {
        Navigation.NavigateTo("/meetings");
    }

    public void Dispose()
    {
        recordingTimer?.Dispose();
        objRef?.Dispose();
    }
}
