@code {
    private IntraUserProfile? currentUser;
    private List<Meeting>? allMeetings;
    private List<Meeting>? upcomingMeetings;
    private List<Meeting>? pastMeetings;

    // Calendar State
    private DateTime currentMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private int daysInMonth => DateTime.DaysInMonth(currentMonth.Year, currentMonth.Month);
    private int emptyDaysAtStart => (int)new DateTime(currentMonth.Year, currentMonth.Month, 1).DayOfWeek;
    private DateTime? selectedDate = DateTime.Today;

    // Past Meetings Filter & Search
    private string pastSearchQuery = "";
    private string pastFilterTab = "all";
    private int pastDisplayLimit = 8;

    // Instant Room Modal State
    private bool showInstantModal = false;
    private string instantMeetingTitle = "Quick Ad-hoc Briefing";
    private string instantMeetingUrl = "";

    // Minutes Viewer Modal State
    private bool showMinutesModal = false;
    private Meeting? selectedMinutesMeeting;
    private string? selectedMinutesDocxUrl;
    private bool isMinutesDocxLoading = false;

    // AI Summary Modal State
    private bool showSummaryModal = false;
    private bool isAiLoading = false;
    private string meetingSummary = "";
    private string selectedMeetingTitle = "";
    private Meeting? selectedSummaryMeeting;
    private string? selectedSummaryDocxUrl;

    private IEnumerable<Meeting> FilteredPastMeetings
    {
        get
        {
            if (pastMeetings == null) return Enumerable.Empty<Meeting>();
            var query = pastMeetings.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(pastSearchQuery))
            {
                query = query.Where(m =>
                    m.Title.Contains(pastSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (m.Organizer != null && m.Organizer.FullName.Contains(pastSearchQuery, StringComparison.OrdinalIgnoreCase))
                );
            }

            if (pastFilterTab == "minutes")
            {
                query = query.Where(m => !string.IsNullOrEmpty(m.MeetingMinutes));
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var userId = user.Identity?.Name
                ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                ?? user.FindFirst("sub")?.Value;

            if (!string.IsNullOrEmpty(userId))
            {
                currentUser = await IntraOfficeService.GetUserProfileAsync(userId);
                currentUser ??= new IntraUserProfile { UserName = userId, FullUserName = userId };
            }

            if (currentUser != null)
            {
                await LoadMeetingsData();
            }
        }
    }

    private async Task LoadMeetingsData()
    {
        if (currentUser == null) return;
        allMeetings = await MeetingService.GetAllMeetingsForUserAsync(currentUser.Id);
        upcomingMeetings = await MeetingService.GetUpcomingMeetingsAsync(currentUser.Id);

        var now = DateTime.UtcNow;
        pastMeetings = allMeetings?
            .Where(m => m.ScheduledStartTime < now.AddHours(-1) || m.Status == MeetingStatus.Completed)
            .OrderByDescending(m => m.ScheduledStartTime)
            .ToList();
    }

    private void SelectDate(DateTime date)
    {
        selectedDate = date;
    }

    private void PrevMonth()
    {
        currentMonth = currentMonth.AddMonths(-1);
    }

    private void NextMonth()
    {
        currentMonth = currentMonth.AddMonths(1);
    }

    private void GoToToday()
    {
        currentMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        selectedDate = DateTime.Today;
    }

    private void OpenInstantMeetingModal()
    {
        var roomId = $"IntraOffice_Sync_{Guid.NewGuid().ToString("N").Substring(0, 10)}";
        instantMeetingUrl = $"https://meet.jit.si/{roomId}";
        instantMeetingTitle = $"Instant Sync • {DateTime.Now:hh:mm tt}";
        showInstantModal = true;
    }

    private async Task CopyToClipboard(string text)
    {
        if (string.IsNullOrEmpty(text)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await JS.InvokeVoidAsync("alert", "Copied meeting link to clipboard:\n" + text);
        }
        catch
        {
            // fallback
        }
    }

    private string? selectedMeetingVoiceNote;

    private async Task OpenMinutesModal(Meeting meeting)
    {
        selectedMinutesMeeting = meeting;
        showMinutesModal = true;
        isMinutesDocxLoading = true;
        selectedMinutesDocxUrl = null;
        StateHasChanged();

        try
        {
            selectedMinutesDocxUrl = await MeetingService.GetOrCreateMinutesDocxPathAsync(meeting.Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Meetings] Error retrieving docx path: {ex.Message}");
        }
        finally
        {
            isMinutesDocxLoading = false;
            StateHasChanged();
        }
    }

    private void CloseMinutesModal()
    {
        showMinutesModal = false;
    }

    private async Task OpenSummaryModal(Meeting meeting)
    {
        selectedSummaryMeeting = meeting;
        selectedMeetingTitle = meeting.Title;
        selectedMeetingVoiceNote = meeting.VoiceNotePath;
        selectedSummaryDocxUrl = null;
        showSummaryModal = true;
        isAiLoading = true;
        meetingSummary = "";
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            try
            {
                selectedSummaryDocxUrl = await MeetingService.GetOrCreateMinutesDocxPathAsync(meeting.Id);
                await InvokeAsync(StateHasChanged);
            }
            catch { }
        });

        try
        {
            if (!string.IsNullOrEmpty(meeting.MeetingMinutes))
            {
                meetingSummary = await AiService.SummarizeTextAsync(meeting.MeetingMinutes);
            }
            else
            {
                meetingSummary = "No minutes were recorded for this session.";
            }
        }
        catch (Exception ex)
        {
            meetingSummary = "AI Summary generation error: " + ex.Message;
        }

        isAiLoading = false;
        StateHasChanged();
    }

    private void CloseSummaryModal()
    {
        showSummaryModal = false;
    }

    private string FormatSummaryMarkdown(string text)
    {
        if (string.IsNullOrEmpty(text)) return "<em>No summary available.</em>";
        var html = System.Net.WebUtility.HtmlEncode(text);
        html = html.Replace("\n", "<br/>");
        return html;
    }
}
