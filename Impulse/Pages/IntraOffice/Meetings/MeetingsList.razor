@page "/intraoffice/meetings"
@page "/intraoffice/meetings/new"
@attribute [Authorize]

<PageTitle>Enterprise Meetings - IntraOffice</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">
            <!-- Header -->
            <div class="d-flex align-items-end justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-3 p-2" style="width: 42px; height: 42px;">
                        <i class="fas fa-video fa-lg"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold text-dark" style="font-size: 1.25rem;">Enterprise Meetings</h4>
                        <small class="text-secondary">Enterprise virtual conferences, room links &amp; scheduled agendas</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm" @onclick="OpenCreateModal">
                        <i class="fas fa-calendar-plus"></i>
                        <span>Schedule Meeting</span>
                    </button>
                    <a href="/intraoffice" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                        <i class="fas fa-arrow-left"></i>
                        <span>Back</span>
                    </a>
                </div>
            </div>

            <!-- Content -->
            @if (IsLoading)
            {
                <div class="d-flex justify-content-center align-items-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <span class="ms-2 text-secondary">Loading meetings...</span>
                </div>
            }
            else if (!AllMeetings.Any())
            {
                <div class="text-center py-5 border rounded-3 bg-light">
                    <i class="fas fa-video-slash fa-3x text-muted mb-2"></i>
                    <h6 class="text-secondary fw-semibold">No scheduled meetings</h6>
                    <p class="text-muted small mb-0">You have no upcoming or past enterprise conferences.</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var m in AllMeetings)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card border border-light-subtle shadow-sm p-3 h-100 bg-white" style="border-radius: 10px;">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge @GetStatusBadgeClass(m.Status)">@m.Status</span>
                                    <small class="text-muted"><i class="fas fa-clock me-1"></i>@m.ScheduledStartTime.ToString("MMM dd, hh:mm tt")</small>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">@m.Title</h6>
                                <p class="small text-secondary mb-2">
                                    <i class="fas fa-user-tie text-primary me-1"></i>Organized by: @(m.OrganizerName ?? m.OrganizerId)
                                </p>
                                <div class="small text-muted mb-3">
                                    <i class="fas fa-users me-1"></i>@m.Participants.Count Participants
                                </div>
                                <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                                    @if (!string.IsNullOrEmpty(m.MeetingUrl))
                                    {
                                        <a href="/intraoffice/meetings/live/@m.Id" class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm text-decoration-none">
                                            <i class="fas fa-video"></i>
                                            <span>Join Call &amp; Notes</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No link</span>
                                    }

                                    @if (m.OrganizerId == CurrentUserId && m.Status == MeetingStatus.Scheduled)
                                    {
                                        <button class="btn btn-xs btn-outline-danger" @onclick="() => CancelMeetingAsync(m.Id)">
                                            Cancel
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Schedule Modal -->
@if (ShowCreateModalState)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow" style="border-radius: 12px;">
                <div class="modal-header bg-light border-bottom py-2">
                    <h5 class="modal-title fw-bold text-dark" style="font-size: 1.1rem;"><i class="fas fa-calendar-plus text-primary me-2"></i>Schedule Meeting</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label small fw-semibold text-secondary">Meeting Title *</label>
                            <input type="text" class="form-control form-control-sm" placeholder="Meeting topic or agenda title..." @bind="NewMeetingTitle" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Start Time *</label>
                            <input type="datetime-local" class="form-control form-control-sm" @bind="NewMeetingStartTime" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Meeting URL / Room</label>
                            <input type="text" class="form-control form-control-sm" placeholder="https://meet.jit.si/impulse-..." @bind="NewMeetingUrl" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-semibold text-secondary">Invite Participants</label>
                            <div class="border rounded-2 p-2" style="max-height: 160px; overflow-y: auto;">
                                @foreach (var u in UsersList.Where(x => x.UserName != CurrentUserId))
                                {
                                    <div class="form-check form-check-inline me-3 mb-1">
                                        <input class="form-check-input" type="checkbox" id="user_@u.UserName" checked="@SelectedParticipantIds.Contains(u.UserName)" @onchange="(e) => ToggleParticipant(u.UserName, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label small" for="user_@u.UserName">@(u.FullUserName ?? u.UserName)</label>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-semibold text-secondary">Agenda / Minutes</label>
                            <textarea class="form-control form-control-sm" rows="3" placeholder="Summary of agenda items..." @bind="NewMeetingMinutes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseCreateModal">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary shadow-sm" @onclick="SaveMeetingAsync">Schedule</button>
                </div>
            </div>
        </div>
    </div>
}
