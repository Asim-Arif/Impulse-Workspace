@page "/intraoffice/stickynotes"
@attribute [Authorize]

<PageTitle>Sticky Notes - IntraOffice</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">
            <!-- Header -->
            <div class="d-flex align-items-end justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center justify-content-center bg-warning-subtle text-warning rounded-3 p-2" style="width: 42px; height: 42px;">
                        <i class="fas fa-note-sticky fa-lg text-warning"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold text-dark" style="font-size: 1.25rem;">Personal Sticky Notes</h4>
                        <small class="text-secondary">Quick memos, desktop reminders &amp; personal scratchpad</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-warning d-flex align-items-center gap-1 shadow-sm text-dark fw-semibold" @onclick="CreateNewNote">
                        <i class="fas fa-plus"></i>
                        <span>New Note</span>
                    </button>
                    <a href="/intraoffice" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                        <i class="fas fa-arrow-left"></i>
                        <span>Back</span>
                    </a>
                </div>
            </div>

            <!-- Notes Grid -->
            @if (IsLoading)
            {
                <div class="d-flex justify-content-center align-items-center py-5">
                    <div class="spinner-border text-warning" role="status"></div>
                    <span class="ms-2 text-secondary">Loading notes...</span>
                </div>
            }
            else if (!NotesList.Any())
            {
                <div class="text-center py-5 border rounded-3 bg-light">
                    <i class="fas fa-note-sticky fa-3x text-muted mb-2"></i>
                    <h6 class="text-secondary fw-semibold">No sticky notes yet</h6>
                    <p class="text-muted small mb-0">Click "New Note" above to write down quick reminders.</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var note in NotesList)
                    {
                        <div class="col-md-6 col-lg-3">
                            <div class="card border-0 shadow-sm p-3 h-100 position-relative" style="background-color: @note.Color; border-radius: 12px; min-height: 200px;">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <small class="text-muted" style="font-size: 0.72rem;"><i class="fas fa-clock me-1"></i>@note.CreatedAt.ToString("MMM dd")</small>
                                    <button class="btn btn-xs btn-link text-danger p-0" @onclick="() => DeleteNoteAsync(note.Id)">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                                <textarea class="form-control border-0 bg-transparent p-0 flex-grow-1" rows="5" style="resize: none; font-size: 0.92rem; color: #2d3436; font-weight: 500;" @bind="note.Content" @bind:after="() => SaveNoteAsync(note)" placeholder="Write something..."></textarea>

                                <div class="d-flex justify-content-between align-items-center pt-2 mt-auto border-top border-black-50">
                                    <div class="d-flex gap-1">
                                        @foreach (var color in AvailableColors)
                                        {
                                            <span class="rounded-circle border cursor-pointer" style="width: 16px; height: 16px; background-color: @color; cursor: pointer;" @onclick="() => ChangeNoteColor(note, color)"></span>
                                        }
                                    </div>
                                    <small class="text-muted" style="font-size: 0.7rem;">Autosaved</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
