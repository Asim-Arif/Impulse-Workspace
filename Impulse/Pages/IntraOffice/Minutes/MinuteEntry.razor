@page "/intraoffice/minutes/new"
@page "/intraoffice/minutes/{Id:int}"
@attribute [Authorize]

<PageTitle>@(Id.HasValue ? $"Minute Memo #{MinuteModel.No}" : "Create New Minute") - IntraOffice</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border-radius: 12px; max-width: 1050px; margin: 0 auto;">
        <div class="card-body p-4">
            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-3 p-2" style="width: 42px; height: 42px;">
                        <i class="fas fa-file-signature fa-lg"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold text-dark" style="font-size: 1.25rem;">@(Id.HasValue ? $"Minute Approval: #{MinuteModel.No}" : "Create New Minute")</h4>
                        <small class="text-secondary">Official executive authorization &amp; approval memo</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (Id.HasValue)
                    {
                        <span class="badge @GetStatusBadgeClass(MinuteModel.Status) p-2">@MinuteModel.Status</span>
                    }
                    <a href="/intraoffice/minutes" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                        <i class="fas fa-arrow-left"></i>
                        <span>Back to List</span>
                    </a>
                </div>
            </div>

            @if (IsLoading)
            {
                <div class="d-flex justify-content-center align-items-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <span class="ms-2 text-secondary">Loading minute details...</span>
                </div>
            }
            else if (Id.HasValue && !IsEditMode)
            {
                <!-- ================= VIEW / WORKFLOW APPROVAL MODE ================= -->
                @if (MinuteModel.Status == "Pending" || MinuteModel.Status == "Referred")
                {
                    <div class="card mb-3 p-3 border border-primary-subtle bg-light" style="border-radius: 10px;">
                        <div class="d-flex flex-wrap gap-2 align-items-end mb-2">
                            <div style="min-width: 250px;">
                                <label class="form-label small fw-bold text-primary mb-1">Next Level / Forward To</label>
                                <select class="form-select form-select-sm" @bind="NextForwardToUserId">
                                    <option value="">-- Select Authority --</option>
                                    @foreach (var u in UsersList)
                                    {
                                        <option value="@u.UserName">@(u.FullUserName ?? u.UserName) @(!string.IsNullOrEmpty(u.Designation) ? $"({u.Designation})" : "")</option>
                                    }
                                </select>
                            </div>
                            <div class="d-flex gap-2 ms-auto flex-wrap">
                                <button class="btn btn-sm btn-success shadow-sm" @onclick='() => ProcessAction("Approve")' disabled="@IsSaving">
                                    <i class="fas fa-check-circle me-1"></i>Approve
                                </button>
                                <button class="btn btn-sm btn-warning text-dark shadow-sm" @onclick='() => ProcessAction("Refer")' disabled="@IsSaving">
                                    <i class="fas fa-reply me-1"></i>Refer
                                </button>
                                <button class="btn btn-sm btn-danger shadow-sm" @onclick='() => ProcessAction("Reject")' disabled="@IsSaving">
                                    <i class="fas fa-times-circle me-1"></i>Reject
                                </button>
                                <button class="btn btn-sm btn-secondary shadow-sm" @onclick='() => ProcessAction("Case Close")' disabled="@IsSaving">
                                    <i class="fas fa-folder-closed me-1"></i>Case Close
                                </button>
                            </div>
                        </div>
                        <div>
                            <label class="form-label small fw-bold text-secondary mb-1">Remarks / Feedback</label>
                            <textarea class="form-control form-control-sm" rows="2" placeholder="Type remarks for this action..." @bind="DecisionRemarks"></textarea>
                        </div>
                    </div>
                }

                <!-- Document Presentation Sheet -->
                <div class="card p-4 border border-light-subtle shadow-sm bg-white mb-3" style="border-radius: 10px;">
                    <div class="d-flex justify-content-between pb-3 mb-3 border-bottom text-secondary small">
                        <div><strong>Minutes Type:</strong> @MinuteModel.Type</div>
                        <div><strong>Minutes No.:</strong> @MinuteModel.No</div>
                        <div><strong>Date:</strong> @MinuteModel.Date.ToString("MMM dd, yyyy")</div>
                        <div><strong>Initiator:</strong> @(MinuteModel.CreatedByUserName ?? MinuteModel.CreatedByUserId)</div>
                    </div>

                    <div class="text-center mb-3">
                        <h5 class="fw-bold text-dark text-decoration-underline mb-0">SUBJECT : @MinuteModel.Subject</h5>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold text-secondary mb-2">Discussion Points:</h6>
                        @if (PointsList.Any())
                        {
                            <ol class="ps-3 mb-0" style="line-height: 1.6;">
                                @foreach (var pt in PointsList)
                                {
                                    <li class="mb-2 text-dark">@pt</li>
                                }
                            </ol>
                        }
                        else
                        {
                            <p class="text-muted small fst-italic">No points listed.</p>
                        }
                    </div>

                    <!-- Attachments List in Document View -->
                    @if (MinuteModel.Attachments.Any())
                    {
                        <div class="pt-3 border-top mb-3">
                            <h6 class="fw-bold text-secondary mb-2"><i class="fas fa-paperclip text-primary me-1"></i>Supporting Documents</h6>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var att in MinuteModel.Attachments)
                                {
                                    <a href="@att.FilePath" target="_blank" class="btn btn-xs btn-outline-primary d-inline-flex align-items-center gap-1 text-decoration-none py-1 px-2" style="font-size: 0.82rem;">
                                        <i class="fas fa-file-lines"></i>
                                        <span>@att.FileName</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    <!-- Workflow History Timeline -->
                    @if (MinuteModel.WorkflowHistory.Any())
                    {
                        <div class="pt-3 border-top">
                            <h6 class="fw-bold text-secondary mb-2"><i class="fas fa-history me-1"></i>Decision History</h6>
                            <div class="d-flex flex-column gap-2">
                                @foreach (var h in MinuteModel.WorkflowHistory)
                                {
                                    <div class="p-2 rounded-2 bg-light border small">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <strong>@(h.FullName ?? h.UserName ?? h.UserId)</strong>
                                            <span class="badge @GetStatusBadgeClass(h.ActionTaken)">@h.ActionTaken</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(h.Remarks))
                                        {
                                            <div class="text-dark mb-1" style="white-space: pre-wrap;">@h.Remarks</div>
                                        }
                                        <small class="text-muted">@h.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</small>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- ================= CREATE / EDIT MINUTE FORM ================= -->
                <!-- Row 1: Date, No, Type -->
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary mb-1">Date</label>
                        <input type="date" class="form-control form-control-sm" @bind="MinuteModel.Date" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary mb-1">No.</label>
                        <input type="text" class="form-control form-control-sm" placeholder="e.g. 8/0123" @bind="MinuteModel.No" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary mb-1">Type</label>
                        <select class="form-select form-select-sm" @bind="MinuteModel.Type">
                            <option value="">-- Select Type --</option>
                            <option value="General">General</option>
                            <option value="Financial">Financial</option>
                            <option value="Mail">Mail</option>
                        </select>
                    </div>
                </div>

                <!-- Row 2: Subject -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">Subject</label>
                    <input type="text" class="form-control form-control-sm" placeholder="Enter minute subject..." @bind="MinuteModel.Subject" />
                </div>

                <!-- Row 3: Points with [P] add button -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">Points</label>
                    <div class="d-flex gap-2 mb-2">
                        <input type="text" class="form-control form-control-sm" placeholder="Enter a point..." @bind="NewPointText" @onkeyup="HandlePointKeyPress" />
                        <button type="button" class="btn btn-sm btn-secondary fw-bold px-3" style="min-width: 45px;" @onclick="AddPoint" title="Add Point">
                            P
                        </button>
                    </div>

                    <div class="p-2 border rounded-2 bg-light" style="min-height: 90px;">
                        @if (PointsList.Any())
                        {
                            <ul class="list-unstyled mb-0 d-flex flex-column gap-1">
                                @foreach (var pt in PointsList)
                                {
                                    <li class="p-2 bg-white border rounded-2 d-flex justify-content-between align-items-center small">
                                        <span class="text-dark">@pt</span>
                                        <button type="button" class="btn btn-xs btn-link text-danger p-0" @onclick="() => PointsList.Remove(pt)">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-muted small text-center py-3">No points added yet.</div>
                        }
                    </div>
                </div>

                <!-- Row 4: Forward To -->
                <div class="mb-3" style="max-width: 400px;">
                    <label class="form-label small fw-semibold text-secondary mb-1">Forward To</label>
                    <select class="form-select form-select-sm" @bind="MinuteModel.ForwardToUserId">
                        <option value="">-- Select Assignee --</option>
                        @foreach (var u in UsersList)
                        {
                            <option value="@u.UserName">@(u.FullUserName ?? u.UserName) @(!string.IsNullOrEmpty(u.Designation) ? $"({u.Designation})" : "")</option>
                        }
                    </select>
                </div>

                <!-- Row 5: 8 Attachment Slots (I to VIII) with typed Attachment Name -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary mb-2">
                        <i class="fas fa-paperclip text-primary me-1"></i>Attachments (Slots I to VIII)
                    </label>
                    <div class="row g-2">
                        @for (int i = 0; i < 8; i++)
                        {
                            var index = i;
                            var roman = GetRomanNumeral(index + 1);
                            var hasFile = AttachmentFiles.ContainsKey(index);

                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2 p-1 border rounded-2 bg-light">
                                    <label for="@($"file-{index}")" class="btn btn-xs btn-link text-primary text-decoration-underline mb-0 text-start text-truncate" style="min-width: 175px; font-size: 0.85rem;" title="Click to upload file">
                                        Click to Add Attachment - @roman
                                    </label>
                                    <InputFile id="@($"file-{index}")" OnChange="@((e) => HandleFileSelected(e, index))" style="display: none;" />
                                    <input type="text" class="form-control form-control-sm" placeholder="Attachment Name" @bind="AttachmentNames[index]" style="font-size: 0.83rem;" />
                                    @if (hasFile)
                                    {
                                        <button type="button" class="btn btn-xs btn-link text-danger p-0" @onclick="() => RemoveAttachmentSlot(index)" title="Clear">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Row 6: Urgent & Close Checkboxes -->
                <div class="d-flex align-items-center gap-4 my-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="urgentCheck" @bind="MinuteModel.IsUrgent" />
                        <label class="form-check-label small fw-bold text-danger" for="urgentCheck">Urgent</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="closeCheck" @bind="MinuteModel.CloseByInitiator" />
                        <label class="form-check-label small fw-bold text-dark" for="closeCheck">Close by Initiator</label>
                    </div>
                </div>

                <!-- Row 7: Action Buttons (Save & Stay, Save & New, Save & Close, Cancel) -->
                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick='() => SaveMinuteWithAction("stay")' disabled="@IsSaving">
                        Save &amp; Stay
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" @onclick='() => SaveMinuteWithAction("new")' disabled="@IsSaving">
                        Save &amp; New
                    </button>
                    <button type="button" class="btn btn-sm btn-primary shadow-sm" @onclick='() => SaveMinuteWithAction("close")' disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save &amp; Close</span>
                        }
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Cancel">
                        Cancel
                    </button>
                </div>
            }
        </div>
    </div>
</div>
