@page "/intraoffice/minutes"
@attribute [Authorize]

<PageTitle>Minutes Approval - IntraOffice</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">
            <!-- Header -->
            <div class="d-flex align-items-end justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center justify-content-center bg-info-subtle text-info rounded-3 p-2" style="width: 42px; height: 42px;">
                        <i class="fas fa-file-signature fa-lg text-info"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold text-dark" style="font-size: 1.25rem;">Minutes &amp; Approval Requests</h4>
                        <small class="text-secondary">Official executive minutes, authorizations &amp; signing workflow</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="/intraoffice/minutes/new" class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm">
                        <i class="fas fa-plus-circle"></i>
                        <span>New Minute</span>
                    </a>
                    <a href="/intraoffice" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                        <i class="fas fa-arrow-left"></i>
                        <span>Back</span>
                    </a>
                </div>
            </div>

            <!-- Filter Panel -->
            <div class="p-2 mb-3 bg-light rounded-3 border">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small text-secondary fw-semibold mb-1">From Date</label>
                        <input type="date" class="form-control form-control-sm" @bind="Filter.FromDate" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-secondary fw-semibold mb-1">To Date</label>
                        <input type="date" class="form-control form-control-sm" @bind="Filter.ToDate" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-secondary fw-semibold mb-1">Minute No.</label>
                        <input type="text" class="form-control form-control-sm" placeholder="e.g. MIN-001" @bind="Filter.No" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-secondary fw-semibold mb-1">Status</label>
                        <select class="form-select form-select-sm" @bind="Filter.Status">
                            <option value="">All Statuses</option>
                            <option value="Pending">Pending</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                            <option value="Closed">Closed</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-secondary fw-semibold mb-1">Type</label>
                        <select class="form-select form-select-sm" @bind="Filter.Type">
                            <option value="">All Types</option>
                            @foreach (var t in MinuteTypes)
                            {
                                <option value="@t.Name">@t.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex gap-1">
                        <button class="btn btn-sm btn-primary w-100" @onclick="ApplyFilterAsync">
                            <i class="fas fa-filter me-1"></i>Filter
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFilterAsync" title="Reset Filters">
                            <i class="fas fa-undo"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Minutes Table -->
            @if (IsLoading)
            {
                <div class="d-flex justify-content-center align-items-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <span class="ms-2 text-secondary">Loading minutes records...</span>
                </div>
            }
            else if (!AllMinutes.Any())
            {
                <div class="text-center py-5 border rounded-3 bg-light">
                    <i class="fas fa-folder-open fa-3x text-muted mb-2"></i>
                    <h6 class="text-secondary fw-semibold">No minutes found</h6>
                    <p class="text-muted small mb-0">No approval minutes match the selected filter criteria.</p>
                </div>
            }
            else
            {
                <div class="table-responsive" style="max-height: 62vh; overflow-y: auto;">
                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                            <tr>
                                <th style="width: 100px;">Date</th>
                                <th style="width: 120px;">Minute No</th>
                                <th>Subject</th>
                                <th style="width: 120px;">Type</th>
                                <th style="width: 130px;">Amount</th>
                                <th style="width: 140px;">Initiator</th>
                                <th style="width: 140px;">Forward To</th>
                                <th style="width: 110px;">Status</th>
                                <th class="text-end" style="width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var minute in AllMinutes)
                            {
                                <tr>
                                    <td class="text-secondary">@minute.Date.ToString("dd-MMM-yyyy")</td>
                                    <td>
                                        <a href="/intraoffice/minutes/@minute.Id" class="fw-bold text-primary text-decoration-none">
                                            @minute.No
                                        </a>
                                        @if (minute.IsUrgent)
                                        {
                                            <span class="badge bg-danger ms-1" style="font-size: 0.65rem;">Urgent</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark text-truncate" style="max-width: 320px;" title="@minute.Subject">
                                            @minute.Subject
                                        </div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@minute.Type</span></td>
                                    <td class="fw-semibold text-dark">
                                        @if (minute.TotalAmount.HasValue && minute.TotalAmount.Value > 0)
                                        {
                                            <span>@minute.Currency @minute.TotalAmount.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td><small class="text-secondary"><i class="fas fa-user text-muted me-1"></i>@(minute.CreatedByUserName ?? minute.CreatedByUserId)</small></td>
                                    <td><small class="text-secondary"><i class="fas fa-user-check text-info me-1"></i>@(minute.ForwardToUserName ?? minute.ForwardToUserId ?? "-")</small></td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(minute.Status)">@minute.Status</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a href="/intraoffice/minutes/@minute.Id" class="btn btn-xs btn-outline-primary" title="View / Sign">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <button class="btn btn-xs btn-outline-success" @onclick="() => QuickApproveAsync(minute.Id)" disabled="@(minute.Status == "Approved")" title="Quick Approve">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
