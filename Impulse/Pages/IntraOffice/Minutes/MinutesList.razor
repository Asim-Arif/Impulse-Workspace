@page "/office/minutes-list"
@page "/minutes-list"
@using DataAccessLibrary.Models.IntraOffice
@using Impulse.Services.IntraOffice
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject IIntraOfficeService IntraOfficeService
@inject IMinuteApprovalService MinuteApprovalService
@inject NavigationManager Navigation

<div class="topbar">
    <h1 class="topbar-title"><i class="bi bi-list-columns-reverse"></i> Minutes List</h1>
    <div class="topbar-actions">
        <a href="/minutes-approval" class="btn btn-primary btn-sm" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
            <i class="bi bi-plus-lg"></i> New Minute
        </a>
        <button class="btn btn-secondary btn-sm" @onclick="Close">
            <i class="bi bi-x-lg"></i> Close
        </button>
    </div>
</div>

<div class="content-area">
    <div class="card mb-20" style="padding: 24px; border: 1px solid var(--border-color);">
        <EditForm Model="filter" OnSubmit="ApplyFilter">
            
            <table style="width: 100%; border-collapse: separate; border-spacing: 12px; margin: -12px;">
                <tr>
                    <td style="width: 15%; vertical-align: bottom;">
                        <div class="form-group mb-0">
                            <label class="form-label" style="font-size: 0.85rem; margin-bottom: 4px;">Range</label>
                            <InputSelect class="form-control" @bind-Value="filter.DateRange">
                                <option value="Last 90 Days">Last 90 Days</option>
                                <option value="Last 30 Days">Last 30 Days</option>
                                <option value="This Year">This Year</option>
                                <option value="Custom">Custom</option>
                            </InputSelect>
                        </div>
                    </td>
                    <td style="width: 15%; vertical-align: bottom;">
                        <div class="form-group mb-0">
                            <label class="form-label" style="font-size: 0.85rem; margin-bottom: 4px;">From</label>
                            <InputDate class="form-control" @bind-Value="filter.FromDate" />
                        </div>
                    </td>
                    <td style="width: 15%; vertical-align: bottom;">
                        <div class="form-group mb-0">
                            <label class="form-label" style="font-size: 0.85rem; margin-bottom: 4px;">To</label>
                            <InputDate class="form-control" @bind-Value="filter.ToDate" />
                        </div>
                    </td>
                    <td style="width: 15%; vertical-align: bottom;">
                        <div class="form-group mb-0">
                            <label class="form-label" style="font-size: 0.85rem; margin-bottom: 4px;">No.</label>
                            <InputText class="form-control" @bind-Value="filter.No" />
                        </div>
                    </td>
                    <td style="width: 30%; vertical-align: bottom;">
                        <div class="form-group mb-0">
                            <label class="form-label" style="font-size: 0.85rem; margin-bottom: 4px;">User</label>
                            <InputSelect class="form-control" @bind-Value="filter.UserId">
                                <option value="">&lt;All&gt;</option>
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id">@u.FullName</option>
                                }
                            </InputSelect>
                        </div>
                    </td>
                    <td style="width: 10%; vertical-align: bottom;">
                        <button type="button" class="btn btn-secondary w-100" @onclick="ResetFilter" style="height: 38px;">Reset</button>
                    </td>
                </tr>
                <tr>
                    <td style="vertical-align: bottom;">
                        <div class="form-group mb-0 d-flex align-items-center gap-2" style="height: 38px;">
                            <input type="checkbox" id="approvedCheck" checked="@(filter.Approved == true)" @onchange="@((ChangeEventArgs e) => filter.Approved = (bool)(e.Value ?? false))" style="width: 18px; height: 18px; cursor: pointer; accent-color: var(--accent-primary, #4f46e5);" />
                            <label class="form-label mb-0" for="approvedCheck" style="cursor: pointer; user-select: none;">Approved</label>
                        </div>
                    </td>
                    <td colspan="2" style="vertical-align: bottom;">
                        <div class="form-group mb-0">
                            <label class="form-label" style="font-size: 0.85rem; margin-bottom: 4px;">Signing Authority</label>
                            <InputSelect class="form-control" @bind-Value="filter.SigningAuthority">
                                <option value="">&lt;All Authorities&gt;</option>
                            </InputSelect>
                        </div>
                    </td>
                    <td style="vertical-align: bottom;">
                        <div class="form-group mb-0">
                            <label class="form-label" style="font-size: 0.85rem; margin-bottom: 4px;">Status</label>
                            <InputSelect class="form-control" @bind-Value="filter.Status">
                                <option value="">&lt;All&gt;</option>
                                <option value="Under Process">Under Process</option>
                                <option value="Approved">Approved</option>
                                <option value="Rejected">Rejected</option>
                                <option value="Closed">Closed</option>
                            </InputSelect>
                        </div>
                    </td>
                    <td style="vertical-align: bottom;">
                        <div class="form-group mb-0">
                            <label class="form-label" style="font-size: 0.85rem; margin-bottom: 4px;">Department</label>
                            <InputSelect class="form-control" @bind-Value="filter.DepartmentId">
                                <option value="">&lt;All Departments&gt;</option>
                                @foreach (var d in departments)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </td>
                    <td style="vertical-align: bottom;">
                        <button type="submit" class="btn btn-secondary w-100" style="height: 38px;">Refresh</button>
                    </td>
                </tr>
                <tr>
                    <td style="vertical-align: bottom;">
                        <div class="form-group mb-0">
                            <label class="form-label" style="font-size: 0.85rem; margin-bottom: 4px;">Type</label>
                            <InputSelect class="form-control" @bind-Value="filter.Type">
                                <option value="">&lt;All&gt;</option>
                                <option value="General">General</option>
                                <option value="Financial">Financial</option>
                                <option value="Mail">Mail</option>
                            </InputSelect>
                        </div>
                    </td>
                    <td colspan="2" style="vertical-align: bottom;">
                        <div style="display: flex; gap: 12px;">
                            <div style="flex: 1;" class="form-group mb-0">
                                <label class="form-label" style="font-size: 0.85rem; margin-bottom: 4px;">Subject</label>
                                <InputText class="form-control" @bind-Value="filter.Subject" />
                            </div>
                            <div style="flex: 1;" class="form-group mb-0">
                                <label class="form-label" style="font-size: 0.85rem; margin-bottom: 4px;">Sender</label>
                                <InputText class="form-control" @bind-Value="filter.Sender" />
                            </div>
                        </div>
                    </td>
                    <td colspan="3" style="vertical-align: bottom;"></td>
                </tr>
                <tr>
                    <td colspan="5" style="vertical-align: bottom;">
                        <div class="form-group mb-0">
                            <label class="form-label" style="font-size: 0.85rem; margin-bottom: 4px;">Marked To</label>
                            <InputSelect class="form-control" @bind-Value="filter.ForwardedTo">
                                <option value="">&lt;All&gt;</option>
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id">@u.FullName</option>
                                }
                            </InputSelect>
                        </div>
                    </td>
                    <td style="vertical-align: bottom;"></td>
                </tr>
            </table>
            
        </EditForm>
    </div>

    <!-- Color Legend -->
    <div class="d-flex align-items-center gap-3 mb-2 flex-wrap px-1" style="font-size: 0.82rem;">
        <span class="text-muted fw-bold"><i class="bi bi-palette me-1"></i>Minutes Status & Color Scheme:</span>
        <span class="badge d-inline-flex align-items-center gap-1" style="background: rgba(34, 197, 94, 0.2); color: #15803d; border: 1px solid #86efac; padding: 4px 8px;">
            <i class="bi bi-check-circle-fill"></i> Approved (Green)
        </span>
        <span class="badge d-inline-flex align-items-center gap-1" style="background: rgba(239, 68, 68, 0.2); color: #b91c1c; border: 1px solid #fca5a5; padding: 4px 8px;">
            <i class="bi bi-x-circle-fill"></i> Rejected (Red)
        </span>
        <span class="badge d-inline-flex align-items-center gap-1" style="background: #e2e8f0; color: #334155; border: 1px solid #94a3b8; padding: 4px 8px;">
            <i class="bi bi-envelope-open-fill"></i> Read (Dark Gray)
        </span>
        <span class="badge d-inline-flex align-items-center gap-1" style="background: #f8fafc; color: #64748b; border: 1px solid #cbd5e1; padding: 4px 8px;">
            <i class="bi bi-envelope-fill"></i> Unread (Gray)
        </span>
    </div>

    <div class="card p-0" style="overflow: hidden; min-height: 400px;">
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; color: var(--text-primary); font-size: 0.9rem;">
                <thead>
                    <tr style="background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color); text-align: left;">
                        <th style="padding: 12px; text-align: center; border-right: 1px solid var(--border-color); width: 60px;">S. #</th>
                        <th style="padding: 12px; border-right: 1px solid var(--border-color);">M No.</th>
                        <th style="padding: 12px; border-right: 1px solid var(--border-color);">M Type</th>
                        <th style="padding: 12px; border-right: 1px solid var(--border-color);">Subject</th>
                        <th style="padding: 12px; border-right: 1px solid var(--border-color);">Date</th>
                        <th style="padding: 12px; border-right: 1px solid var(--border-color);">Name</th>
                        <th style="padding: 12px; border-right: 1px solid var(--border-color);">Department</th>
                        <th style="padding: 12px; border-right: 1px solid var(--border-color);">Status</th>
                        <th style="padding: 12px; border-right: 1px solid var(--border-color);">Stage</th>
                        <th style="padding: 12px; border-right: 1px solid var(--border-color);">Time Taken</th>
                        <th style="padding: 12px; text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="11" class="text-center" style="padding: 40px; color: var(--text-muted);">
                                <div class="spinner-border" role="status" style="width: 1.5rem; height: 1.5rem; margin-bottom: 8px;"></div>
                                <div>Loading...</div>
                            </td>
                        </tr>
                    }
                    else if (!minutes.Any())
                    {
                        <tr>
                            <td colspan="11" class="text-center" style="padding: 40px; color: var(--text-muted);">
                                No records found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int index = 1;
                        foreach (var m in minutes)
                        {
                            string bgNormal, bgHover, borderLeft;
                            if (m.Status == "Approved")
                            {
                                bgNormal = "rgba(34, 197, 94, 0.15)";
                                bgHover = "rgba(34, 197, 94, 0.25)";
                                borderLeft = "4px solid #16a34a";
                            }
                            else if (m.Status == "Rejected")
                            {
                                bgNormal = "rgba(239, 68, 68, 0.15)";
                                bgHover = "rgba(239, 68, 68, 0.25)";
                                borderLeft = "4px solid #dc2626";
                            }
                            else if (m.IsRead)
                            {
                                bgNormal = "#e2e8f0"; // Dark gray for read
                                bgHover = "#cbd5e1";
                                borderLeft = "4px solid #64748b";
                            }
                            else
                            {
                                bgNormal = "#f8fafc"; // Gray for unread
                                bgHover = "#f1f5f9";
                                borderLeft = "4px solid #94a3b8";
                            }

                            string statusIcon = "bi-arrow-repeat";
                            string statusColor = "var(--warning)";
                            if (m.Status == "Approved") { statusIcon = "bi-check-circle"; statusColor = "var(--success)"; }
                            else if (m.Status == "Rejected") { statusIcon = "bi-x-circle"; statusColor = "var(--danger)"; }
                            else if (m.Status == "Closed") { statusIcon = "bi-lock"; statusColor = "var(--text-muted)"; }

                            var (timeText, timeDesc, timeStyle, timeIcon) = GetMinuteDuration(m);

                            <tr @onclick="() => NavigateToMinute(m.Id)" style="border-bottom: 1px solid var(--border-color); border-left: @borderLeft; background: @bgNormal; transition: background 0.2s; cursor: pointer;" onmouseover="this.style.background='@bgHover';" onmouseout="this.style.background='@bgNormal';">
                                <td style="padding: 12px; text-align: center; border-right: 1px solid var(--border-color); color: var(--text-muted);">@index</td>
                                <td style="padding: 12px; border-right: 1px solid var(--border-color); font-weight: 500;">
                                    <div class="d-flex align-items-center gap-1">
                                        <i class="bi bi-file-earmark-text text-primary me-1"></i>
                                        <span style="color: var(--info);">@m.No</span>
                                        @if (m.Status != "Approved" && m.Status != "Rejected")
                                        {
                                            @if (m.IsRead)
                                            {
                                                <span class="badge" style="background: #94a3b8; color: white; font-size: 0.68rem; padding: 2px 5px;" title="Read">Read</span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background: #475569; color: white; font-size: 0.68rem; padding: 2px 5px;" title="Unread">
                                                    <i class="bi bi-circle-fill text-info me-1" style="font-size: 5px; vertical-align: middle;"></i>Unread
                                                </span>
                                            }
                                        }
                                    </div>
                                </td>
                                <td style="padding: 12px; border-right: 1px solid var(--border-color);">@m.Type</td>
                                <td style="padding: 12px; border-right: 1px solid var(--border-color); max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@m.Subject">
                                    @m.Subject
                                </td>
                                <td style="padding: 12px; border-right: 1px solid var(--border-color);">@m.Date.ToString("dd-MMM-yyyy")</td>
                                <td style="padding: 12px; border-right: 1px solid var(--border-color);">@m.CreatedByUser?.FullName</td>
                                <td style="padding: 12px; border-right: 1px solid var(--border-color); max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @(m.ForwardToUser?.Department?.Name?.ToUpper() ?? "")
                                </td>
                                <td style="padding: 12px; border-right: 1px solid var(--border-color);">
                                    <span style="color: @statusColor; font-weight: bold;"><i class="bi @statusIcon me-1"></i> @m.Status</span>
                                </td>
                                <td style="padding: 12px; border-right: 1px solid var(--border-color);">
                                    @(m.ForwardToUser?.FullName ?? "")
                                </td>
                                <td style="padding: 12px; border-right: 1px solid var(--border-color); white-space: nowrap;">
                                    <span class="badge" style="@timeStyle font-size: 0.8rem; font-weight: 600; padding: 4px 8px; border-radius: 6px;">
                                        <i class="bi @timeIcon me-1"></i>@timeText
                                    </span>
                                    <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 2px;">
                                        @timeDesc
                                    </div>
                                </td>
                                <td style="padding: 12px; text-align: center; white-space: nowrap;">
                                    <button class="btn btn-ghost btn-sm" style="padding: 4px 8px;" title="View Workflow" @onclick="() => NavigateToMinute(m.Id)" @onclick:stopPropagation="true">
                                        <i class="bi bi-file-earmark-plus"></i>
                                    </button>
                                    @if (!m.IsRead && m.Status != "Approved" && m.Status != "Rejected")
                                    {
                                        <button class="btn btn-ghost btn-sm" style="padding: 4px 8px; color: var(--text-muted);" title="Mark as Read" @onclick="() => MarkAsReadQuick(m)" @onclick:stopPropagation="true">
                                            <i class="bi bi-check2"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                            index++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private MinuteFilter filter = new MinuteFilter();
    private List<MinuteApproval> minutes = new();
    private List<IntraUserProfile> users = new();
    private List<IntraDepartment> departments = new();
    private bool isLoading = true;

    private string? currentUserId;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            currentUserId = user.Identity.Name
                ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                ?? user.FindFirst("sub")?.Value;
            isAdmin = user.IsInRole("Admin") || user.IsInRole("Administrator") || string.Equals(user.Identity?.Name, "admin", StringComparison.OrdinalIgnoreCase);
        }

        filter.FromDate = DateTime.Today.AddDays(-90);
        filter.ToDate = DateTime.Today;
        if (!isAdmin)
        {
            filter.RelatedUserId = currentUserId; // Non-admin sees related minutes only
        }

        var rawUsers = await IntraOfficeService.GetActiveUsersAsync();
        users = rawUsers.OrderBy(u => u.FullName).ToList();
        var rawDepts = await IntraOfficeService.GetDepartmentsAsync();
        departments = rawDepts.Select(d => new IntraDepartment { Id = d.DeptId, Name = d.DeptName }).ToList();
        
        await ApplyFilter();
    }

    private async Task ApplyFilter()
    {
        isLoading = true;
        StateHasChanged();
        
        try
        {
            minutes = await MinuteApprovalService.GetMinutesListAsync(filter);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ResetFilter()
    {
        filter = new MinuteFilter
        {
            FromDate = DateTime.Today.AddDays(-90),
            ToDate = DateTime.Today,
            RelatedUserId = isAdmin ? null : currentUserId
        };
        await ApplyFilter();
    }

    private void Close()
    {
        Navigation.NavigateTo("/");
    }

    private async Task NavigateToMinute(int minuteId)
    {
        await MinuteApprovalService.MarkAsReadAsync(minuteId);
        Navigation.NavigateTo($"/minutes-workflow/{minuteId}");
    }

    private async Task MarkAsReadQuick(MinuteApproval m)
    {
        await MinuteApprovalService.MarkAsReadAsync(m.Id);
        m.IsRead = true;
        m.ReadAt = DateTime.UtcNow;
        StateHasChanged();
    }

    private (string TimeText, string Description, string Style, string Icon) GetMinuteDuration(MinuteApproval m)
    {
        var history = m.WorkflowHistory?.OrderBy(h => h.CreatedAt).ToList() ?? new List<MinuteWorkflowHistory>();

        if (m.Status == "Approved")
        {
            var approveAction = history.LastOrDefault(h => h.ActionTaken == "Approve") ?? history.LastOrDefault();
            var duration = approveAction != null && approveAction.CreatedAt >= m.CreatedAt
                ? approveAction.CreatedAt - m.CreatedAt
                : (history.Any() ? history.Last().CreatedAt - m.CreatedAt : TimeSpan.FromMinutes(1));
            
            if (duration < TimeSpan.FromSeconds(5)) duration = TimeSpan.FromSeconds(30);
            string userWho = approveAction?.User?.FullName != null ? $"by {approveAction.User.FullName}" : "Approved";
            return (FormatDuration(duration), userWho, "background: #dcfce7; color: #15803d; border: 1px solid #86efac;", "bi-check2-circle");
        }
        else if (m.Status == "Rejected")
        {
            var rejectAction = history.LastOrDefault(h => h.ActionTaken == "Reject") ?? history.LastOrDefault();
            var duration = rejectAction != null && rejectAction.CreatedAt >= m.CreatedAt
                ? rejectAction.CreatedAt - m.CreatedAt
                : (history.Any() ? history.Last().CreatedAt - m.CreatedAt : TimeSpan.FromMinutes(1));
            
            if (duration < TimeSpan.FromSeconds(5)) duration = TimeSpan.FromSeconds(30);
            string userWho = rejectAction?.User?.FullName != null ? $"by {rejectAction.User.FullName}" : "Rejected";
            return (FormatDuration(duration), userWho, "background: #fee2e2; color: #b91c1c; border: 1px solid #fca5a5;", "bi-x-circle");
        }
        else if (m.Status == "Referred")
        {
            var lastRefer = history.LastOrDefault(h => h.ActionTaken == "Refer") ?? history.LastOrDefault();
            if (lastRefer != null)
            {
                var duration = lastRefer.CreatedAt >= m.CreatedAt ? lastRefer.CreatedAt - m.CreatedAt : TimeSpan.FromMinutes(1);
                string userWho = lastRefer.User?.FullName != null ? $"Referred by {lastRefer.User.FullName}" : "Referred";
                return (FormatDuration(duration), userWho, "background: #fef3c7; color: #b45309; border: 1px solid #fde68a;", "bi-arrow-left-right");
            }
            var elapsed = DateTime.UtcNow - m.CreatedAt;
            return (FormatDuration(elapsed), "In Review", "background: #fef3c7; color: #b45309; border: 1px solid #fde68a;", "bi-clock-history");
        }
        else
        {
            // Pending
            var elapsed = DateTime.UtcNow - m.CreatedAt;
            return (FormatDuration(elapsed), "Pending Review", "background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1;", "bi-hourglass-split");
        }
    }

    private string FormatDuration(TimeSpan ts)
    {
        if (ts.TotalSeconds < 60)
            return $"{(int)Math.Max(1, ts.TotalSeconds)}s";
        if (ts.TotalMinutes < 60)
            return $"{(int)ts.TotalMinutes}m {ts.Seconds}s";
        if (ts.TotalHours < 24)
            return $"{(int)ts.TotalHours}h {ts.Minutes}m";
        return $"{(int)ts.TotalDays}d {ts.Hours}h";
    }
}
