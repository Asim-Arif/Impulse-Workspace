@page "/intraoffice/tasks"
@attribute [Authorize]

<PageTitle>Task Board - IntraOffice</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">
            <!-- Header -->
            <div class="d-flex align-items-end justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center justify-content-center bg-warning-subtle text-warning-emphasis rounded-3 p-2" style="width: 42px; height: 42px;">
                        <i class="fas fa-list-check fa-lg"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold text-dark" style="font-size: 1.25rem;">Enterprise Task Board</h4>
                        <small class="text-secondary">Kanban workflow, assignments, voice notes, attachments &amp; WhatsApp alerts</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm" @onclick="OpenCreateModal">
                        <i class="fas fa-plus-circle"></i>
                        <span>New Task</span>
                    </button>
                    <a href="/intraoffice" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                        <i class="fas fa-arrow-left"></i>
                        <span>Back</span>
                    </a>
                </div>
            </div>

            <!-- Filters & Views Row -->
            <div class="row g-2 mb-3 align-items-center">
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-secondary border-end-0"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control form-control-sm border-start-0" placeholder="Search tasks..." @bind="SearchTerm" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" @bind="SelectedAssigneeFilter">
                        <option value="">All Assignees</option>
                        @foreach (var u in UsersList)
                        {
                            <option value="@u.UserName">@(u.FullUserName ?? u.UserName)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" @bind="SelectedPriorityFilter">
                        <option value="-1">All Priorities</option>
                        <option value="0">Low</option>
                        <option value="1">Normal</option>
                        <option value="2">High</option>
                        <option value="3">Urgent</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" @bind="SelectedDepartmentFilter">
                        <option value="">All Departments</option>
                        @foreach (var d in Departments)
                        {
                            <option value="@d.DeptId">@d.DeptName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn @(ViewMode == "kanban" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => ViewMode = "kanban"'>
                            <i class="fas fa-table-columns me-1"></i>Board
                        </button>
                        <button type="button" class="btn @(ViewMode == "list" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => ViewMode = "list"'>
                            <i class="fas fa-list me-1"></i>List
                        </button>
                    </div>
                </div>
            </div>

            <!-- Content Area -->
            @if (IsLoading)
            {
                <div class="d-flex justify-content-center align-items-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <span class="ms-2 text-secondary">Loading tasks...</span>
                </div>
            }
            else if (ViewMode == "kanban")
            {
                <!-- Kanban 4 Columns -->
                <div class="row g-3">
                    <!-- Column 1: Pending -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card border-0 bg-light shadow-sm h-100" style="border-radius: 10px;">
                            <div class="card-header bg-secondary-subtle text-dark border-0 py-2 d-flex align-items-center justify-content-between">
                                <span class="fw-bold small"><i class="fas fa-hourglass-start text-secondary me-1"></i>Pending</span>
                                <span class="badge bg-secondary">@GetTasksByStatus(TaskItemStatus.Pending).Count</span>
                            </div>
                            <div class="card-body p-2 d-flex flex-column gap-2" style="min-height: 400px; max-height: 65vh; overflow-y: auto;">
                                @foreach (var task in GetTasksByStatus(TaskItemStatus.Pending))
                                {
                                    @RenderTaskCard(task)
                                }
                                @if (!GetTasksByStatus(TaskItemStatus.Pending).Any())
                                {
                                    <div class="text-center text-muted small py-4">No pending tasks</div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Column 2: In Progress -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card border-0 bg-light shadow-sm h-100" style="border-radius: 10px;">
                            <div class="card-header bg-primary-subtle text-dark border-0 py-2 d-flex align-items-center justify-content-between">
                                <span class="fw-bold small"><i class="fas fa-spinner fa-spin text-primary me-1"></i>In Progress</span>
                                <span class="badge bg-primary">@GetTasksByStatus(TaskItemStatus.InProgress).Count</span>
                            </div>
                            <div class="card-body p-2 d-flex flex-column gap-2" style="min-height: 400px; max-height: 65vh; overflow-y: auto;">
                                @foreach (var task in GetTasksByStatus(TaskItemStatus.InProgress))
                                {
                                    @RenderTaskCard(task)
                                }
                                @if (!GetTasksByStatus(TaskItemStatus.InProgress).Any())
                                {
                                    <div class="text-center text-muted small py-4">No tasks in progress</div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Column 3: Completed -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card border-0 bg-light shadow-sm h-100" style="border-radius: 10px;">
                            <div class="card-header bg-success-subtle text-dark border-0 py-2 d-flex align-items-center justify-content-between">
                                <span class="fw-bold small"><i class="fas fa-check-circle text-success me-1"></i>Completed</span>
                                <span class="badge bg-success">@GetTasksByStatus(TaskItemStatus.Completed).Count</span>
                            </div>
                            <div class="card-body p-2 d-flex flex-column gap-2" style="min-height: 400px; max-height: 65vh; overflow-y: auto;">
                                @foreach (var task in GetTasksByStatus(TaskItemStatus.Completed))
                                {
                                    @RenderTaskCard(task)
                                }
                                @if (!GetTasksByStatus(TaskItemStatus.Completed).Any())
                                {
                                    <div class="text-center text-muted small py-4">No completed tasks</div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Column 4: Cancelled -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card border-0 bg-light shadow-sm h-100" style="border-radius: 10px;">
                            <div class="card-header bg-danger-subtle text-dark border-0 py-2 d-flex align-items-center justify-content-between">
                                <span class="fw-bold small"><i class="fas fa-ban text-danger me-1"></i>Cancelled</span>
                                <span class="badge bg-danger">@GetTasksByStatus(TaskItemStatus.Cancelled).Count</span>
                            </div>
                            <div class="card-body p-2 d-flex flex-column gap-2" style="min-height: 400px; max-height: 65vh; overflow-y: auto;">
                                @foreach (var task in GetTasksByStatus(TaskItemStatus.Cancelled))
                                {
                                    @RenderTaskCard(task)
                                }
                                @if (!GetTasksByStatus(TaskItemStatus.Cancelled).Any())
                                {
                                    <div class="text-center text-muted small py-4">No cancelled tasks</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- List View -->
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Task Title</th>
                                <th>Assigned To</th>
                                <th>Assigned By</th>
                                <th>Department</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Due Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in FilteredTasks)
                            {
                                <tr @onclick="() => OpenTaskDetail(task)" style="cursor: pointer;">
                                    <td class="text-muted small">@task.Id</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@task.Title</div>
                                        @if (task.WhatsAppMessageSent)
                                        {
                                            <small class="text-success"><i class="fab fa-whatsapp me-1"></i>WhatsApp Sent</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="small text-dark"><i class="fas fa-user-tie text-primary me-1"></i>@(task.AssigneeName ?? task.AssignedTo ?? "Unassigned")</span>
                                    </td>
                                    <td>
                                        <span class="small text-secondary">@(task.AssignerName ?? task.AssignedBy)</span>
                                    </td>
                                    <td>
                                        <span class="small text-secondary">@(task.DepartmentName ?? "All")</span>
                                    </td>
                                    <td>
                                        <span class="badge @GetPriorityBadgeClass(task.Priority)">@task.Priority</span>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(task.Status)">@task.Status</span>
                                    </td>
                                    <td class="small">
                                        @(task.DueDate.HasValue ? task.DueDate.Value.ToString("MMM dd, yyyy") : "No date")
                                    </td>
                                    <td class="text-end" @onclick:stopPropagation>
                                        <button class="btn btn-xs btn-outline-primary" @onclick="() => OpenTaskDetail(task)">
                                            <i class="fas fa-eye me-1"></i>Details
                                        </button>
                                    </td>
                                </tr>
                            }
                            @if (!FilteredTasks.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4 text-muted">No tasks found matching criteria.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Task Details Modal -->
@if (SelectedTask != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow" style="border-radius: 12px;">
                <div class="modal-header bg-light border-bottom py-2">
                    <h5 class="modal-title fw-bold text-dark" style="font-size: 1.1rem;">
                        <i class="fas fa-tasks text-primary me-2"></i>@SelectedTask.Title
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseTaskDetail"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-secondary mb-1">Description</label>
                                <div class="p-2 border rounded-2 bg-light small" style="white-space: pre-wrap; min-height: 60px;">
                                    @(string.IsNullOrWhiteSpace(SelectedTask.Description) ? "No detailed instructions provided." : SelectedTask.Description)
                                </div>
                            </div>

                            <!-- Attachments in Details Modal -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-secondary mb-1">
                                    <i class="fas fa-paperclip text-primary me-1"></i>Task Attachments &amp; Voice Notes
                                </label>
                                @if (SelectedTask.Attachments.Any())
                                {
                                    <div class="d-flex flex-column gap-2 mb-2">
                                        @foreach (var att in SelectedTask.Attachments)
                                        {
                                            @if (att.ContentType?.StartsWith("audio/") == true || att.FileName.EndsWith(".webm") || att.FileName.EndsWith(".mp3"))
                                            {
                                                <div class="p-2 rounded-2 bg-light border d-flex align-items-center gap-3">
                                                    <div class="d-flex align-items-center text-danger">
                                                        <i class="fas fa-microphone-lines fa-lg me-2"></i>
                                                        <span class="small fw-semibold">Voice Note</span>
                                                    </div>
                                                    <audio controls src="@att.FilePath" style="height: 32px; flex-grow: 1;"></audio>
                                                </div>
                                            }
                                            else
                                            {
                                                <a href="@att.FilePath" target="_blank" class="btn btn-xs btn-outline-secondary d-inline-flex align-items-center gap-1 text-decoration-none py-1 px-2" style="font-size: 0.8rem; width: fit-content;">
                                                    <i class="fas fa-paperclip text-primary"></i>
                                                    <span>@att.FileName</span>
                                                </a>
                                            }
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small fst-italic mb-2">No attachments on this task.</div>
                                }

                                <!-- Upload new file to existing task -->
                                <div class="d-flex align-items-center gap-2">
                                    <label for="task-detail-file-upload" class="btn btn-xs btn-outline-primary mb-0 cursor-pointer d-flex align-items-center gap-1">
                                        <i class="fas fa-upload"></i>
                                        <span>Attach Document</span>
                                    </label>
                                    <InputFile id="task-detail-file-upload" OnChange="HandleDetailFileUpload" style="display: none;" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                                </div>
                            </div>

                            <!-- Comments Thread -->
                            <h6 class="fw-bold text-dark mb-2"><i class="fas fa-comments text-primary me-2"></i>Discussion &amp; Updates</h6>
                            <div class="p-2 border rounded-2 bg-light d-flex flex-column gap-2 mb-3" style="max-height: 200px; overflow-y: auto;">
                                @foreach (var comment in SelectedTask.Comments)
                                {
                                    <div class="p-2 border rounded-2 bg-white">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <strong class="text-primary small">@(comment.UserFullName ?? comment.UserName ?? comment.UserId)</strong>
                                            <small class="text-muted">@comment.CreatedAt.ToString("MMM dd, hh:mm tt")</small>
                                        </div>
                                        <div class="text-dark small" style="white-space: pre-wrap;">@comment.Content</div>
                                    </div>
                                }
                                @if (!SelectedTask.Comments.Any())
                                {
                                    <div class="text-muted small text-center py-2">No comments yet.</div>
                                }
                            </div>

                            <!-- Add Comment Input -->
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control" placeholder="Write a comment..." @bind="NewCommentText" @onkeyup="HandleCommentKeyUp" />
                                <button class="btn btn-primary" @onclick="AddCommentAsync" disabled="@string.IsNullOrWhiteSpace(NewCommentText)">
                                    <i class="fas fa-paper-plane me-1"></i>Send
                                </button>
                            </div>
                        </div>

                        <div class="col-md-4 border-start">
                            <div class="d-flex flex-column gap-2">
                                <div>
                                    <small class="text-muted d-block">Assigned To</small>
                                    <span class="fw-bold text-dark small"><i class="fas fa-user-tie text-primary me-1"></i>@(SelectedTask.AssigneeName ?? SelectedTask.AssignedTo ?? "Unassigned")</span>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Assigned By</small>
                                    <span class="text-secondary small">@(SelectedTask.AssignerName ?? SelectedTask.AssignedBy)</span>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Department</small>
                                    <span class="text-secondary small">@(SelectedTask.DepartmentName ?? "All")</span>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Priority</small>
                                    <span class="badge @GetPriorityBadgeClass(SelectedTask.Priority)">@SelectedTask.Priority</span>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Due Date</small>
                                    <span class="small @(SelectedTask.DueDate < DateTime.UtcNow && SelectedTask.Status != TaskItemStatus.Completed ? "text-danger fw-bold" : "text-dark")">
                                        @(SelectedTask.DueDate.HasValue ? SelectedTask.DueDate.Value.ToString("MMM dd, yyyy") : "No due date")
                                    </span>
                                </div>

                                <hr class="my-2" />

                                <label class="form-label small fw-semibold text-secondary mb-1">Update Status</label>
                                <div class="d-grid gap-1">
                                    @if (SelectedTask.Status != TaskItemStatus.InProgress)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ChangeStatusAsync(SelectedTask.Id, TaskItemStatus.InProgress)">
                                            <i class="fas fa-spinner me-1"></i>Set In Progress
                                        </button>
                                    }
                                    @if (SelectedTask.Status != TaskItemStatus.Completed)
                                    {
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => ChangeStatusAsync(SelectedTask.Id, TaskItemStatus.Completed)">
                                            <i class="fas fa-check-circle me-1"></i>Mark Completed
                                        </button>
                                    }
                                    @if (SelectedTask.Status != TaskItemStatus.Pending)
                                    {
                                        <button class="btn btn-sm btn-outline-warning" @onclick="() => ChangeStatusAsync(SelectedTask.Id, TaskItemStatus.Pending)">
                                            <i class="fas fa-hourglass-start me-1"></i>Re-open (Pending)
                                        </button>
                                    }
                                    @if (SelectedTask.Status != TaskItemStatus.Cancelled)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ChangeStatusAsync(SelectedTask.Id, TaskItemStatus.Cancelled)">
                                            <i class="fas fa-ban me-1"></i>Cancel Task
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseTaskDetail">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Create Task Modal -->
@if (ShowCreateModalState)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow" style="border-radius: 12px;">
                <div class="modal-header bg-light border-bottom py-2">
                    <h5 class="modal-title fw-bold text-dark" style="font-size: 1.1rem;"><i class="fas fa-plus-circle text-primary me-2"></i>Create New Task</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label fw-semibold small text-secondary">Task Title *</label>
                            <input type="text" class="form-control form-control-sm" placeholder="What needs to be done?" @bind="NewTaskTitle" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Assign To *</label>
                            <select class="form-select form-select-sm" @bind="NewTaskAssignee">
                                <option value="">Select Employee / User...</option>
                                @foreach (var u in UsersList)
                                {
                                    <option value="@u.UserName">@(u.FullUserName ?? u.UserName) @(!string.IsNullOrEmpty(u.Designation) ? $"({u.Designation})" : "")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Department</label>
                            <select class="form-select form-select-sm" @bind="NewTaskDepartment">
                                <option value="">Select Department...</option>
                                @foreach (var dept in Departments)
                                {
                                    <option value="@dept.DeptId">@dept.DeptName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Priority</label>
                            <select class="form-select form-select-sm" @bind="NewTaskPriority">
                                <option value="0">Low</option>
                                <option value="1">Normal</option>
                                <option value="2">High</option>
                                <option value="3">Urgent</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Due Date</label>
                            <input type="date" class="form-control form-control-sm" @bind="NewTaskDueDate" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold small text-secondary">Description</label>
                            <textarea class="form-control form-control-sm" rows="3" placeholder="Detailed instructions for the task..." @bind="NewTaskDescription"></textarea>
                        </div>

                        <!-- Voice Note & Attachments in Create Task Modal -->
                        <div class="col-md-12">
                            <div class="p-3 border rounded-2 bg-light">
                                <label class="form-label small fw-semibold text-dark mb-2">
                                    <i class="fas fa-microphone text-danger me-1"></i>Voice Note &amp; Document Attachments
                                </label>
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                                    <!-- Mic recording button -->
                                    <button type="button" class="btn btn-sm @(IsRecordingVoice ? "btn-danger recording-pulse" : "btn-outline-danger") d-flex align-items-center gap-1 shadow-sm" @onclick="ToggleVoiceRecordingAsync">
                                        <i class="fas @(IsRecordingVoice ? "fa-stop" : "fa-microphone")"></i>
                                        <span>@(IsRecordingVoice ? "Stop Recording Voice" : "Record Voice Note")</span>
                                    </button>

                                    <!-- Add regular files -->
                                    <label for="task-file-upload" class="btn btn-sm btn-outline-secondary mb-0 cursor-pointer d-flex align-items-center gap-1">
                                        <i class="fas fa-paperclip"></i>
                                        <span>Add Files</span>
                                    </label>
                                    <InputFile id="task-file-upload" OnChange="HandleNewAttachments" multiple style="display: none;" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.webm,.mp3" />
                                </div>

                                <!-- Attachments Preview List -->
                                @if (PendingVoiceNotes.Any() || PendingFiles.Any())
                                {
                                    <div class="d-flex flex-wrap gap-2 mt-2 pt-2 border-top">
                                        @foreach (var vn in PendingVoiceNotes)
                                        {
                                            <div class="p-1 px-2 rounded-2 bg-danger-subtle text-danger border border-danger-subtle d-flex align-items-center gap-2 small">
                                                <i class="fas fa-microphone"></i>
                                                <span>@vn.FileName</span>
                                                <button type="button" class="btn btn-xs btn-link text-danger p-0" @onclick="() => PendingVoiceNotes.Remove(vn)">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                        }
                                        @foreach (var f in PendingFiles)
                                        {
                                            <div class="p-1 px-2 rounded-2 bg-white border d-flex align-items-center gap-2 small">
                                                <i class="fas fa-file text-primary"></i>
                                                <span>@f.Name</span>
                                                <button type="button" class="btn btn-xs btn-link text-danger p-0" @onclick="() => PendingFiles.Remove(f)">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="whatsappCheck" @bind="NewTaskSendWhatsApp" />
                                <label class="form-check-label small text-dark fw-semibold" for="whatsappCheck">
                                    <i class="fab fa-whatsapp text-success me-1"></i>Send WhatsApp notification to assignee
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseCreateModal">
                        <i class="fas fa-times me-1"></i>Cancel
                    </button>
                    <button type="button" class="btn btn-sm btn-primary shadow-sm" @onclick="SaveTaskAsync" disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="fas fa-check me-1"></i>
                            <span>Create Task</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .recording-pulse {
        animation: pulseAnimation 1.2s infinite;
    }
    @@keyframes pulseAnimation {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); }
        70% { transform: scale(1.05); box-shadow: 0 0 0 10px rgba(220, 53, 69, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
    }
</style>

@code {
    private RenderFragment RenderTaskCard(TaskItem task) => __builder =>
    {
        <div class="card border border-light-subtle shadow-sm p-2 cursor-pointer bg-white" style="border-radius: 8px; cursor: pointer; transition: transform 0.1s ease, box-shadow 0.1s ease;" @onclick="() => OpenTaskDetail(task)">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <span class="badge @GetPriorityBadgeClass(task.Priority)" style="font-size: 0.72rem;">@task.Priority</span>
                @if (task.DueDate.HasValue)
                {
                    <span class="small @(task.DueDate < DateTime.UtcNow && task.Status != TaskItemStatus.Completed ? "text-danger fw-bold" : "text-muted")" style="font-size: 0.75rem;">
                        <i class="fas fa-calendar-day me-1"></i>@task.DueDate.Value.ToString("MMM dd")
                    </span>
                }
            </div>
            <div class="fw-bold text-dark mb-2" style="font-size: 0.88rem; line-height: 1.3;">
                @task.Title
            </div>
            <div class="d-flex align-items-center justify-content-between pt-1 border-top" style="font-size: 0.75rem;">
                <div class="text-secondary d-flex align-items-center gap-1">
                    <i class="fas fa-user-circle text-primary"></i>
                    <span>@(task.AssigneeName ?? task.AssignedTo ?? "Unassigned")</span>
                </div>
                @if (task.WhatsAppMessageSent)
                {
                    <i class="fab fa-whatsapp text-success" title="WhatsApp sent"></i>
                }
            </div>
        </div>
    };
}
