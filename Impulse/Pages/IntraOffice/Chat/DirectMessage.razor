    private void OpenWhatsAppDirect()
    {
        if (otherUser != null && !string.IsNullOrEmpty(otherUser.PhoneNumber))
        {
            var cleanPhone = new string(otherUser.PhoneNumber.Where(char.IsDigit).ToArray());
            var url = $"https://wa.me/{cleanPhone}";
            _ = JS.InvokeVoidAsync("window.open", url, "_blank");
        }
    }

    private async Task SendMessage()
    {
        try
        {
            if ((string.IsNullOrWhiteSpace(newMessage) && !pendingAttachments.Any()) || currentUser == null || otherUser == null)
            {
                return;
            }

            var message = new Message
            {
                SenderId = currentUser.Id,
                ReceiverId = otherUser.Id,
                Content = newMessage.Trim(),
                MessageType = MessageType.Text,
                Attachments = pendingAttachments.ToList()
            };

            var sent = await MessageService.SendMessageAsync(message);

            messages ??= new();
            messages.Add(sent);
            newMessage = "";
            pendingAttachments.Clear();
            StateHasChanged();
            await ScrollToBottom();

            // AI Bot direct chat check
            if (otherUser.Id == AiAssistantService.GetAiUserId())
            {
                isAiTyping = true;
                StateHasChanged();
                await ScrollToBottom();

                _ = Task.Run(async () =>
                {
                    try
                    {
                        var responseContent = await AiAssistantService.GenerateResponseAsync(sent.Content, currentUser.Id);
                        var aiMsg = new Message
                        {
                            SenderId = otherUser.Id,
                            ReceiverId = currentUser.Id,
                            Content = responseContent,
                            MessageType = MessageType.Text
                        };

                        var savedAiMsg = await MessageService.SendMessageAsync(aiMsg);

                        await InvokeAsync(() =>
                        {
                            messages.Add(savedAiMsg);
                            isAiTyping = false;
                            StateHasChanged();
                            _ = ScrollToBottom();
                        });
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[ERROR] AI DirectMessage response failed: {ex.Message}");
                        await InvokeAsync(() =>
                        {
                            isAiTyping = false;
                            StateHasChanged();
                        });
                    }
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] SendMessage exception: {ex.Message}");
        }
    }

    private async Task StartVideoCall()
    {
        if (currentUser == null || otherUser == null) return;
        var roomId = $"IntraOffice_Call_{Guid.NewGuid().ToString("N").Substring(0, 10)}";
        var meetLink = $"https://meet.jit.si/{roomId}";

        var message = new Message
        {
            SenderId = currentUser.Id,
            ReceiverId = otherUser.Id,
            Content = $"📞 [VIDEO CALL STARTED] | {meetLink}",
            MessageType = MessageType.Text
        };

        var sent = await MessageService.SendMessageAsync(message);
        messages ??= new();
        messages.Add(sent);
        StateHasChanged();
        await ScrollToBottom();

        // Send multi-channel invite notifications
        var inviteMsg = $"*Video Call Invitation*\n\nHello {otherUser.FullName},\n\n{currentUser.FullName} is calling you on Intra Office!\n\nJoin the video call here: {meetLink}";
        if (!string.IsNullOrEmpty(otherUser.PhoneNumber))
        {
            _ = WhatsAppService.SendDirectMessageAsync(otherUser.PhoneNumber, inviteMsg);
        }
        if (!string.IsNullOrEmpty(otherUser.Email))
        {
            var emailBody = $"<p>Hello {otherUser.FullName},</p><p><strong>{currentUser.FullName}</strong> is calling you on Intra Office!</p><p><a href=\"{meetLink}\">Click here to join the video call</a></p>";
            _ = EmailService.SendEmailAsync(otherUser.Email, "Video Call Invitation", emailBody);
        }

        await JS.InvokeVoidAsync("window.open", meetLink, "_blank");
    }

    private async Task ToggleRecording()
    {
        try
        {
            if (!isRecording)
            {
                var success = await JS.InvokeAsync<bool>("window.audioRecorder.startRecording");
                if (success)
                {
                    isRecording = true;
                    StateHasChanged();
                }
                else
                {
                    Console.WriteLine("Failed to start audio recording. Check microphone permissions.");
                    isRecording = false;
                    StateHasChanged();
                }
            }
            else
            {
                isRecording = false;
                StateHasChanged();

                var result = await JS.InvokeAsync<AudioRecordingResult>("window.audioRecorder.stopRecording");
                if (result != null && !string.IsNullOrEmpty(result.Base64))
                {
                    var fileName = $"VoiceMessage_{DateTime.Now:yyyyMMdd_HHmmss}.webm";
                    var relativePath = await FileService.SaveBase64FileToDiskAsync(result.Base64, fileName);

                    pendingAttachments.Add(new MessageAttachment
                    {
                        FileName = fileName,
                        FilePath = relativePath,
                        FileSize = (long)(result.Base64.Length * 0.75),
                        ContentType = result.MimeType,
                        UploadedAt = DateTime.UtcNow
                    });

                    await SendMessage();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling recording: {ex.Message}");
            isRecording = false;
            StateHasChanged();
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        uploadError = null;
        var files = e.GetMultipleFiles(10);
        if (!files.Any()) return;

        isUploadingAttachment = true;
        StateHasChanged();

        try
        {
            foreach (var file in files)
            {
                uploadProgressStatus = $"Attaching {file.Name} ({FormatFileSize(file.Size)})...";
                StateHasChanged();

                var relativePath = await FileService.SaveFileToDiskAsync(file);
                pendingAttachments.Add(new MessageAttachment
                {
                    FileName = file.Name,
                    FilePath = relativePath,
                    FileSize = file.Size,
                    ContentType = string.IsNullOrEmpty(file.ContentType) ? "application/octet-stream" : file.ContentType,
                    UploadedAt = DateTime.UtcNow
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] Upload failed: {ex.Message}");
            uploadError = $"File upload failed: {ex.Message}";
        }
        finally
        {
            isUploadingAttachment = false;
            uploadProgressStatus = null;
            StateHasChanged();
        }
    }

    private void RemoveAttachment(MessageAttachment attachment)
    {
        pendingAttachments.Remove(attachment);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task ScrollToBottom()
    {
        await Task.Delay(50);
        await JS.InvokeVoidAsync("scrollToBottom", "dm-messages-list");
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024L * 1024 * 1024) return $"{bytes / (1024.0 * 1024.0):F1} MB";
        return $"{bytes / (1024.0 * 1024.0 * 1024.0):F2} GB";
    }

    private MarkupString ParseMessageContent(string content)
    {
        if (string.IsNullOrEmpty(content)) return new MarkupString("");

        var safeContent = System.Net.WebUtility.HtmlEncode(content);
        var linkRegex = new System.Text.RegularExpressions.Regex(@"\[([^\]]+)\]\(([^)]+)\)");
        safeContent = linkRegex.Replace(safeContent, m =>
            $"<a href=\"{m.Groups[2].Value}\" style=\"color: #6366f1; font-weight: 600; text-decoration: underline;\" target=\"_blank\">{m.Groups[1].Value}</a>"
        );
        safeContent = safeContent.Replace("\n", "<br/>");
        return new MarkupString(safeContent);
    }

    public ValueTask DisposeAsync()
    {
        NotificationService.OnNotificationReceived -= HandleLiveNotification;
        return ValueTask.CompletedTask;
    }
}

