@page "/office/messages"
@page "/office/messages/{OtherUserId}"
@page "/messages"
@page "/messages/{OtherUserId}"
@attribute [Authorize]
@using System.Security.Claims
@using DataAccessLibrary.Models.IntraOffice
@using Impulse.Services.IntraOffice
@inject AuthenticationStateProvider AuthStateProvider
@inject IIntraOfficeService IntraOfficeService
@inject IMessageService MessageService
@inject IAppNotificationService NotificationService
@inject IFileService FileService
@inject IWhatsAppService WhatsAppService
@inject IEmailService EmailService
@inject IAiAssistantService AiAssistantService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>IntraCom-CRM | Direct Messages @(otherUser != null ? $"— {otherUser.FullName}" : "")</PageTitle>

<div class="dm-page-wrapper">

    <!-- 1. GLASSMORPHIC TOPBAR / RECIPIENT HERO BANNER -->
    <div class="dm-header-banner">
        <div class="dm-hero-glow-1"></div>
        <div class="dm-hero-glow-2"></div>

        <div class="dm-header-content position-relative d-flex flex-wrap align-items-center justify-content-between gap-3">
            @if (otherUser != null)
            {
                <div class="d-flex align-items-center gap-3">
                    <div class="dm-avatar-ring">
                        @if (!string.IsNullOrEmpty(otherUser.Avatar))
                        {
                            <img src="@otherUser.Avatar" alt="@otherUser.FullName" class="dm-avatar-img" />
                        }
                        else
                        {
                            <div class="dm-avatar-fallback">
                                @(otherUser.FullName.Length > 0 ? otherUser.FullName[0].ToString().ToUpper() : "?")
                            </div>
                        }
                        <span class="dm-beacon-indicator" title="Live status active"></span>
                    </div>

                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h4 class="dm-recipient-name mb-0">@otherUser.FullName</h4>
                            @if (otherUser.Id == AiAssistantService.GetAiUserId())
                            {
                                <span class="dm-chip-ai">
                                    <i class="bi bi-robot me-1"></i> IntraBot AI
                                </span>
                            }
                            else if (otherUser.Department != null)
                            {
                                <span class="dm-chip-dept">
                                    <i class="bi bi-building me-1"></i> @otherUser.Department.Name
                                </span>
                            }
                            <span class="dm-chip-role">@(otherUser.JobTitle ?? "Colleague")</span>
                        </div>

                        <div class="d-flex align-items-center gap-3 mt-1 text-xs">
                            <span class="dm-live-badge">
                                <span class="dm-live-dot"></span>
                                DIRECT COMMS ENCRYPTED • ACTIVE SYNC
                            </span>
                            @if (!string.IsNullOrEmpty(otherUser.Email))
                            {
                                <span class="text-white-50 d-none d-md-inline-flex align-items-center gap-1">
                                    <i class="bi bi-envelope"></i> @otherUser.Email
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button class="btn btn-dm-action btn-dm-video" @onclick="StartVideoCall" title="Start WebRTC Video Conference">
                        <i class="bi bi-camera-video-fill"></i>
                        <span>Start Video Call</span>
                    </button>

                    @if (!string.IsNullOrEmpty(otherUser.PhoneNumber))
                    {
                        <button class="btn btn-dm-action btn-dm-whatsapp" @onclick="OpenWhatsAppDirect" title="Direct WhatsApp Ping">
                            <i class="bi bi-whatsapp"></i>
                            <span class="d-none d-sm-inline">WhatsApp</span>
                        </button>
                    }

                    @if (!string.IsNullOrEmpty(otherUser.Email))
                    {
                        <a href="mailto:@otherUser.Email" class="btn btn-dm-action btn-dm-mail" title="Send Direct Email">
                            <i class="bi bi-envelope-at-fill"></i>
                            <span class="d-none d-sm-inline">Email</span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="d-flex align-items-center gap-3">
                    <div class="dm-brand-icon">
                        <i class="bi bi-chat-heart-fill"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="dm-recipient-name mb-0">Executive Direct Messenger</h4>
                            <span class="dm-chip-secure">
                                <i class="bi bi-shield-check me-1"></i> P2P Encrypted
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <span class="dm-live-badge">
                                <span class="dm-live-dot"></span>
                                LIVE COLLABORATION NETWORK • @(allUsers?.Count ?? 0) ACTIVE CONTACTS
                            </span>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-dm-action btn-dm-ai" @onclick="() => LaunchAiWithPrompt(null)" title="Consult IntraBot AI">
                        <i class="bi bi-robot"></i>
                        <span>Ask IntraBot AI</span>
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- 2. MAIN MESSENGER CARD (SIDEBAR + CONVERSATION AREA) -->
    <div class="dm-messenger-card">

        <!-- Left Sidebar: Directory & Contacts -->
        <div class="dm-sidebar">
            <div class="dm-sidebar-header">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="dm-sidebar-title">
                        <i class="bi bi-person-lines-fill me-1 text-primary"></i> Direct Channels
                    </span>
                    <span class="dm-count-pill">@(FilteredUsers.Count()) contacts</span>
                </div>

                <!-- Search Input -->
                <div class="dm-search-wrapper">
                    <i class="bi bi-search dm-search-icon"></i>
                    <input type="text" class="dm-search-input" placeholder="Search colleagues or role..."
                           @bind="searchQuery" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button class="dm-search-clear" @onclick="() => searchQuery = string.Empty" title="Clear">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                </div>

                <!-- Filter Pills -->
                <div class="dm-filter-tabs">
                    <button class="dm-filter-tab @(activeFilterTab == "all" ? "active" : "")" @onclick='@(() => activeFilterTab = "all")'>
                        All
                    </button>
                    <button class="dm-filter-tab @(activeFilterTab == "unread" ? "active" : "")" @onclick='@(() => activeFilterTab = "unread")'>
                        Unread @(TotalUnreadCount > 0 ? $"({TotalUnreadCount})" : "")
                    </button>
                    <button class="dm-filter-tab @(activeFilterTab == "ai" ? "active" : "")" @onclick='@(() => activeFilterTab = "ai")'>
                        <i class="bi bi-robot"></i> IntraBot
                    </button>
                </div>
            </div>

            <!-- Colleague Items List -->
            <div class="dm-contacts-list">
                @if (FilteredUsers.Any())
                {
                    @foreach (var user in FilteredUsers)
                    {
                        var isSelected = OtherUserId == user.Id;
                        var hasUnread = unreadCounts.TryGetValue(user.Id, out int count) && count > 0;
                        var isAi = user.Id == AiAssistantService.GetAiUserId();

                        <a href="/messages/@user.Id" class="dm-contact-item @(isSelected ? "active" : "") @(hasUnread ? "has-unread" : "")">
                            <div class="dm-contact-avatar-box">
                                @if (!string.IsNullOrEmpty(user.Avatar))
                                {
                                    <img src="@user.Avatar" alt="@user.FullName" class="dm-contact-avatar" />
                                }
                                else
                                {
                                    <div class="dm-contact-avatar-fallback @(isAi ? "ai-bg" : "")">
                                        @if (isAi)
                                        {
                                            <i class="bi bi-robot"></i>
                                        }
                                        else
                                        {
                                            @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "?")
                                        }
                                    </div>
                                }
                                @if (hasUnread)
                                {
                                    <span class="avatar-unread-dot" title="@count unread message(s)"></span>
                                }
                                else
                                {
                                    <span class="avatar-status-dot"></span>
                                }
                            </div>

                            <div class="dm-contact-meta">
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="dm-contact-name @(isSelected ? "fw-bold text-primary" : "")">
                                        @user.FullName
                                    </span>
                                    @if (hasUnread)
                                    {
                                        <span class="user-unread-badge">@(count > 99 ? "99+" : count.ToString())</span>
                                    }
                                </div>
                                <div class="dm-contact-sub">
                                    @if (isAi)
                                    {
                                        <span class="text-purple fw-semibold"><i class="bi bi-stars"></i> Intelligent Assistant</span>
                                    }
                                    else if (hasUnread)
                                    {
                                        <span class="text-danger fw-semibold">@count new message@(count > 1 ? "s" : "")</span>
                                    }
                                    else
                                    {
                                        <span>@(user.JobTitle ?? user.Department?.Name ?? user.Email)</span>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div class="dm-no-contacts text-center p-4">
                        <i class="bi bi-people text-muted" style="font-size: 2rem;"></i>
                        <p class="text-muted small mt-2 mb-0">No contacts match your query.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Right Pane: Active Chat OR Welcome Deck -->
        <div class="dm-chat-pane">
            @if (string.IsNullOrEmpty(OtherUserId))
            {
                <!-- WELCOME DECK (WHEN NO CONVERSATION SELECTED) -->
                <div class="dm-welcome-deck">
                    <div class="dm-welcome-hero-card">
                        <div class="dm-welcome-icon-halo">
                            <i class="bi bi-chat-square-dots-fill"></i>
                        </div>
                        <h2 class="dm-welcome-title">Executive 1-on-1 Workspace</h2>
                        <p class="dm-welcome-subtitle">
                            Connect directly with colleagues across engineering, sales, and management.
                            Launch instant encrypted video meetings, send crystal-clear voice notes, or get real-time CRM intelligence from IntraBot AI.
                        </p>

                        <!-- Fast-Connect Colleagues Grid -->
                        <div class="dm-fast-connect-section mt-4">
                            <div class="dm-section-heading">
                                <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Fast Connect
                            </div>
                            <div class="dm-fast-colleagues-grid">
                                @if (allUsers != null)
                                {
                                    @foreach (var colleague in allUsers.Take(4))
                                    {
                                        var isAiColleague = colleague.Id == AiAssistantService.GetAiUserId();
                                        <div class="dm-fast-colleague-card">
                                            <div class="dm-fast-avatar-wrap">
                                                @if (!string.IsNullOrEmpty(colleague.Avatar))
                                                {
                                                    <img src="@colleague.Avatar" alt="@colleague.FullName" class="dm-fast-avatar" />
                                                }
                                                else
                                                {
                                                    <div class="dm-fast-avatar-fallback @(isAiColleague ? "ai-bg" : "")">
                                                        @if (isAiColleague)
                                                        {
                                                            <i class="bi bi-robot"></i>
                                                        }
                                                        else
                                                        {
                                                            @(colleague.FullName.Length > 0 ? colleague.FullName[0].ToString().ToUpper() : "?")
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            <div class="dm-fast-name text-truncate">@colleague.FullName</div>
                                            <div class="dm-fast-role text-truncate">@(colleague.JobTitle ?? colleague.Department?.Name ?? "Colleague")</div>
                                            <a href="/messages/@colleague.Id" class="btn btn-sm btn-dm-connect">
                                                <i class="bi bi-chat-fill me-1"></i> Message
                                            </a>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <!-- IntraBot AI Quick Assistant Deck -->
                        <div class="dm-ai-quick-deck mt-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="dm-ai-deck-icon">
                                    <i class="bi bi-robot"></i>
                                </div>
                                <div class="text-start flex-grow-1">
                                    <h5 class="mb-1 text-white fw-bold">IntraBot Neural Assistant Ready</h5>
                                    <p class="mb-0 text-white-50 small">Ask anything about CRM deals, inventory status, active tasks, or executive overview KPIs.</p>
                                </div>
                            </div>
                            <div class="dm-ai-prompt-chips mt-3">
                                <button class="dm-ai-prompt-chip" @onclick='() => LaunchAiWithPrompt("Summarize our current CRM Pipeline status and key leads.")'>
                                    📊 Summarize CRM Pipeline
                                </button>
                                <button class="dm-ai-prompt-chip" @onclick='() => LaunchAiWithPrompt("What high-priority tasks are currently assigned to me?")'>
                                    🚀 My Priority Tasks
                                </button>
                                <button class="dm-ai-prompt-chip" @onclick='() => LaunchAiWithPrompt("Give me a brief executive overview of active office operations.")'>
                                    🏢 Executive Briefing
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- ACTIVE CONVERSATION STREAM -->
                <div class="dm-conversation-stream" id="dm-messages-list">
                    <div class="dm-stream-notice">
                        <i class="bi bi-lock-fill text-success me-1"></i>
                        <span>Messages in this thread are private and securely synchronized in real time.</span>
                    </div>

                    @if (messages != null && messages.Any())
                    {
                        @foreach (var msg in messages)
                        {
                            var isMine = currentUser != null && msg.SenderId == currentUser.Id;

                            <div class="dm-message-row @(isMine ? "dm-row-mine" : "dm-row-theirs")">
                                @if (!isMine)
                                {
                                    <div class="dm-bubble-avatar">
                                        @if (!string.IsNullOrEmpty(msg.Sender?.Avatar))
                                        {
                                            <img src="@msg.Sender.Avatar" alt="@msg.Sender.FullName" class="dm-bubble-avatar-img" />
                                        }
                                        else
                                        {
                                            <div class="dm-bubble-avatar-fallback">
                                                @(msg.Sender?.FullName?.Length > 0 ? msg.Sender.FullName[0].ToString().ToUpper() : "?")
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="dm-bubble-container">
                                    <div class="dm-bubble-meta @(isMine ? "text-end" : "text-start")">
                                        <span class="dm-bubble-sender">@(isMine ? "You" : (msg.Sender?.FullName ?? "Colleague"))</span>
                                        <span class="dm-bubble-time">@msg.SentAt.ToLocalTime().ToString("hh:mm tt")</span>
                                    </div>

                                    @if (msg.Content.StartsWith("📞 [VIDEO CALL STARTED]"))
                                    {
                                        var parts = msg.Content.Split('|');
                                        var link = parts.Length > 1 ? parts[1].Trim() : "";
                                        <div class="dm-call-card">
                                            <div class="dm-call-glow"></div>
                                            <div class="dm-call-header">
                                                <div class="dm-call-pulse-icon">
                                                    <i class="bi bi-camera-video-fill"></i>
                                                </div>
                                                <div>
                                                    <div class="dm-call-title">Secure Video Meeting Started</div>
                                                    <div class="dm-call-sub">WebRTC P2P Conference Room</div>
                                                </div>
                                            </div>
                                            <p class="dm-call-text">Click below to connect camera & microphone in high-definition video conference.</p>
                                            <a href="@link" target="_blank" class="btn btn-dm-join-call">
                                                <i class="bi bi-telephone-inbound-fill me-1"></i> Join Video Call
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="dm-bubble @(isMine ? (msg.IsRead ? "dm-bubble-mine dm-bubble-mine-read" : "dm-bubble-mine") : "dm-bubble-theirs")">
                                            @ParseMessageContent(msg.Content)
                                        </div>
                                        @if (isMine)
                                        {
                                            <div class="dm-read-tick @(msg.IsRead ? "dm-tick-read" : "dm-tick-sent")">
                                                @if (msg.IsRead)
                                                {
                                                    <i class="bi bi-check2-all"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check2"></i>
                                                }
                                            </div>
                                        }
                                    }

                                    @if (msg.Attachments?.Any() == true)
                                    {
                                        <div class="dm-attachments-cluster @(isMine ? "justify-content-end" : "justify-content-start")">
                                            @foreach (var att in msg.Attachments)
                                            {
                                                @if (att.ContentType?.StartsWith("audio/") == true || att.FileName.EndsWith(".webm") || att.FileName.EndsWith(".mp3"))
                                                {
                                                    <div class="dm-audio-card">
                                                        <div class="dm-audio-icon">
                                                            <i class="bi bi-mic-fill"></i>
                                                        </div>
                                                        <div class="dm-audio-player-wrap">
                                                            <audio controls src="@att.FilePath" class="dm-audio-player"></audio>
                                                        </div>
                                                        <span class="dm-audio-size">@FormatFileSize(att.FileSize)</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <a href="@att.FilePath" class="dm-file-chip" target="_blank" download>
                                                        <i class="bi bi-paperclip dm-file-icon"></i>
                                                        <div class="dm-file-info">
                                                            <span class="dm-file-name">@att.FileName</span>
                                                            <span class="dm-file-meta">@FormatFileSize(att.FileSize)</span>
                                                        </div>
                                                        <i class="bi bi-download dm-file-download"></i>
                                                    </a>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="dm-empty-chat text-center p-5">
                            <div class="dm-empty-chat-icon">
                                <i class="bi bi-chat-text"></i>
                            </div>
                            <h5 class="fw-bold mt-3 mb-1">Start a Conversation</h5>
                            <p class="text-muted small">No previous messages in this direct channel. Say hello to @(otherUser?.FullName ?? "your colleague")!</p>
                        </div>
                    }

                    @if (isAiTyping && otherUser?.Id == AiAssistantService.GetAiUserId())
                    {
                        <div class="dm-message-row dm-row-theirs">
                            <div class="dm-bubble-avatar">
                                <div class="dm-bubble-avatar-fallback ai-bg">
                                    <i class="bi bi-robot"></i>
                                </div>
                            </div>
                            <div class="dm-bubble-container">
                                <div class="dm-ai-typing-card">
                                    <span class="dm-ai-typing-text"><i class="bi bi-stars me-1"></i> IntraBot is thinking</span>
                                    <span class="dm-typing-dots">
                                        <span></span><span></span><span></span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- ATTACHMENT UPLOAD STATUS / ERROR -->
                @if (isUploadingAttachment)
                {
                    <div class="alert alert-info py-2 px-3 d-flex align-items-center gap-2 mb-2 mx-3 shadow-sm rounded-3">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <span class="small fw-semibold">@(uploadProgressStatus ?? "Processing attachment...")</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(uploadError))
                {
                    <div class="alert alert-danger py-2 px-3 d-flex align-items-center justify-content-between mb-2 mx-3 shadow-sm rounded-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                            <span class="small">@uploadError</span>
                        </div>
                        <button type="button" class="btn-close btn-close-sm" @onclick="() => uploadError = null"></button>
                    </div>
                }

                <!-- PENDING ATTACHMENTS TRAY -->
                @if (pendingAttachments.Any())
                {
                    <div class="dm-pending-attachments">
                        <span class="dm-pending-label"><i class="bi bi-paperclip me-1"></i> Ready to send:</span>
                        @foreach (var att in pendingAttachments)
                        {
                            <div class="dm-pending-chip">
                                <i class="bi bi-file-earmark-text text-primary me-1"></i>
                                <span class="dm-pending-name">@att.FileName (@FormatFileSize(att.FileSize))</span>
                                <button type="button" class="dm-pending-remove" @onclick="() => RemoveAttachment(att)" title="Remove">
                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            </div>
                        }
                    </div>
                }

                <!-- QUICK STARTERS BAR -->
                <div class="dm-quick-starters">
                    <span class="dm-starters-label"><i class="bi bi-magic me-1"></i> Starters:</span>
                    @if (otherUser?.Id == AiAssistantService.GetAiUserId())
                    {
                        <button class="dm-starter-pill" @onclick='() => SetQuickStarter("Summarize our current active CRM deals and sales performance.")'>
                            📊 Summarize Deals
                        </button>
                        <button class="dm-starter-pill" @onclick='() => SetQuickStarter("What are my open and high-priority tasks?")'>
                            🚀 My Tasks
                        </button>
                        <button class="dm-starter-pill" @onclick='() => SetQuickStarter("Provide an executive briefing on company operations.")'>
                            🏢 Executive Brief
                        </button>
                        <button class="dm-starter-pill" @onclick='() => SetQuickStarter("What tools and features can you assist me with?")'>
                            💡 Capabilities
                        </button>
                    }
                    else
                    {
                        <button class="dm-starter-pill" @onclick='() => SetQuickStarter("Hi! Do you have 5 minutes for a quick status sync?")'>
                            🤝 Quick Sync?
                        </button>
                        <button class="dm-starter-pill" @onclick='() => SetQuickStarter("Sharing a quick status update on our current project milestones.")'>
                            📋 Status Update
                        </button>
                        <button class="dm-starter-pill" @onclick='() => SetQuickStarter("Can we hop on a quick video call to review the details?")'>
                            📞 Quick Call?
                        </button>
                        <button class="dm-starter-pill" @onclick='() => SetQuickStarter("Sounds great! Approved and moving forward.")'>
                            👍 Approved!
                        </button>
                    }
                </div>

                <!-- FLOATING COMPOSER DOCK -->
                <div class="dm-composer-dock">
                    <div class="dm-composer-inner">
                        <button class="btn btn-dm-icon" title="Attach Files" onclick="document.getElementById('dm-file-input').click()">
                            <i class="bi bi-paperclip"></i>
                        </button>
                        <InputFile id="dm-file-input" @ref="fileInput" OnChange="HandleFileSelected" style="display: none;" multiple />

                        <button class="btn btn-dm-icon @(isRecording ? "dm-icon-recording" : "")" title="@(isRecording ? "Stop Recording & Send" : "Record Voice Note")" @onclick="ToggleRecording">
                            <i class="bi @(isRecording ? "bi-stop-fill" : "bi-mic-fill")"></i>
                        </button>

                        @if (isRecording)
                        {
                            <div class="dm-recording-live-bar">
                                <div class="dm-recording-ripple"></div>
                                <span class="dm-recording-text">Recording audio note... Click mic or stop to finish.</span>
                            </div>
                        }
                        else
                        {
                            <textarea class="dm-input-textarea"
                                      @bind="newMessage"
                                      @bind:event="oninput"
                                      @onkeydown="HandleKeyDown"
                                      placeholder="Type a message to @(otherUser?.FullName ?? "colleague")... (Enter to send, Shift+Enter for new line)"
                                      rows="1"
                                      id="chat-input"></textarea>
                        }

                        <button id="send-message-button" type="button" class="btn btn-dm-send" @onclick="SendMessage" title="Send Message">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

</div>

@code {
    [Parameter] public string? OtherUserId { get; set; }
    [SupplyParameterFromQuery] public string? Prefill { get; set; }

    private IntraUserProfile? currentUser;
    private IntraUserProfile? otherUser;
    private List<IntraUserProfile>? allUsers;
    private List<Message>? messages;
    private string newMessage = "";
    private string searchQuery = "";
    private string activeFilterTab = "all";
    private Dictionary<string, int> unreadCounts = new();
    private bool isAiTyping = false;
    private bool isRecording = false;
    private InputFile? fileInput;
    private List<MessageAttachment> pendingAttachments = new();
    private bool isUploadingAttachment = false;
    private string? uploadProgressStatus;
    private string? uploadError;

    private int TotalUnreadCount => unreadCounts.Values.Sum();

    private IEnumerable<IntraUserProfile> FilteredUsers
    {
        get
        {
            if (allUsers == null) return Enumerable.Empty<IntraUserProfile>();
            var aiId = AiAssistantService.GetAiUserId();
            var query = allUsers.AsEnumerable();

            if (activeFilterTab == "unread")
            {
                query = query.Where(u => unreadCounts.TryGetValue(u.Id, out int c) && c > 0);
            }
            else if (activeFilterTab == "ai")
            {
                query = query.Where(u => u.Id == aiId);
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                query = query.Where(u =>
                    u.FullName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (u.Email?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (u.JobTitle?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (u.Department?.Name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return query
                .OrderByDescending(u => u.Id == aiId)
                .ThenByDescending(u => unreadCounts.TryGetValue(u.Id, out int c) && c > 0)
                .ThenBy(u => u.FullName);
        }
    }

    public class AudioRecordingResult
    {
        public string Base64 { get; set; } = "";
        public string MimeType { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userClaims = authState.User;
        var userId = userClaims.Identity?.Name
            ?? userClaims.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? userClaims.FindFirst("sub")?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            currentUser = await IntraOfficeService.GetUserProfileAsync(userId);
            currentUser ??= new IntraUserProfile { UserName = userId, FullUserName = userId };
        }

        if (currentUser != null)
        {
            unreadCounts = await MessageService.GetUnreadDirectMessageCountsAsync(currentUser.Id);
            var users = await IntraOfficeService.GetActiveUsersAsync();
            allUsers = users.Where(u => u.IsActive && u.Id != currentUser.Id).OrderBy(u => u.FullName).ToList();

            var aiId = AiAssistantService.GetAiUserId();
            if (!allUsers.Any(u => u.Id == aiId))
            {
                allUsers.Insert(0, new IntraUserProfile {
                    UserName = aiId,
                    FullUserName = "IntraBot AI",
                    Designation = "AI Assistant",
                    DepartmentName = "Intra AI"
                });
            }
        }

        NotificationService.OnNotificationReceived += HandleLiveNotification;
    }

    private async Task HandleLiveNotification(AppNotification notif)
    {
        if (currentUser == null) return;

        if (notif.Category == NotificationCategory.Message)
        {
            if (string.IsNullOrEmpty(notif.TargetUserId) || notif.TargetUserId == currentUser.Id)
            {
                unreadCounts = await MessageService.GetUnreadDirectMessageCountsAsync(currentUser.Id);

                if (!string.IsNullOrEmpty(OtherUserId) && notif.ActionUrl != null && notif.ActionUrl.Contains(OtherUserId))
                {
                    messages = await MessageService.GetDirectMessagesAsync(currentUser.Id, OtherUserId);
                    if (!notif.IsReadReceipt)
                    {
                        await MessageService.MarkAllAsReadAsync(currentUser.Id, senderId: OtherUserId);
                    }
                    unreadCounts.Remove(OtherUserId);
                    await ScrollToBottom();
                }
                else if (notif.IsReadReceipt && !string.IsNullOrEmpty(OtherUserId))
                {
                    // Recipient read our messages — refresh so bubbles turn green
                    messages = await MessageService.GetDirectMessagesAsync(currentUser.Id, OtherUserId);
                }

                await InvokeAsync(StateHasChanged);
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(OtherUserId) && currentUser != null)
        {
            if (OtherUserId == AiAssistantService.GetAiUserId())
            {
                otherUser = new IntraUserProfile {
                    UserName = OtherUserId,
                    FullUserName = "IntraBot AI",
                    Designation = "AI Assistant",
                    DepartmentName = "Intra AI"
                };
            }
            else
            {
                otherUser = await IntraOfficeService.GetUserProfileAsync(OtherUserId);
            }

            messages = await MessageService.GetDirectMessagesAsync(currentUser.Id, OtherUserId);
            await MessageService.MarkAllAsReadAsync(currentUser.Id, senderId: OtherUserId);

            if (unreadCounts.ContainsKey(OtherUserId))
            {
                unreadCounts.Remove(OtherUserId);
            }

            if (!string.IsNullOrEmpty(Prefill))
            {
                newMessage = Prefill;
                Prefill = null;
            }
        }
    }

