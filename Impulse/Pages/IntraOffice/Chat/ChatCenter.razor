@page "/intraoffice/chat"
@page "/intraoffice/chat/{OtherUserId}"
@page "/intraoffice/channels"
@page "/intraoffice/channels/{ChannelId:int}"
@attribute [Authorize]
@implements IAsyncDisposable

<PageTitle>IntraOffice Chat &amp; Channels</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border-radius: 12px; height: 86vh;">
        <div class="card-body p-0 d-flex flex-column h-100">
            <!-- Main Grid Layout -->
            <div class="row g-0 flex-grow-1 overflow-hidden">
                <!-- Left Sidebar -->
                <div class="col-lg-3 col-md-4 border-end d-flex flex-column bg-light h-100">
                    <!-- Top Sidebar Tabs -->
                    <div class="p-2 border-bottom bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0 text-dark" style="font-size: 1.05rem;">
                                <i class="fas fa-comments text-primary me-2"></i>Messages
                            </h6>
                            <a href="/intraoffice" class="btn btn-xs btn-outline-secondary" title="Return to IntraOffice Dashboard">
                                <i class="fas fa-arrow-left"></i>
                            </a>
                        </div>
                        <div class="btn-group btn-group-sm w-100" role="group">
                            <button type="button" class="btn @(ActiveTab == "direct" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetActiveTab("direct")'>
                                <i class="fas fa-user me-1"></i>Direct (@FilteredUsers.Count)
                            </button>
                            <button type="button" class="btn @(ActiveTab == "channels" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetActiveTab("channels")'>
                                <i class="fas fa-hashtag me-1"></i>Channels (@FilteredChannels.Count)
                            </button>
                            <button type="button" class="btn @(ActiveTab == "bot" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetActiveTab("bot")'>
                                <i class="fas fa-robot me-1"></i>AI Bot
                            </button>
                        </div>
                    </div>

                    <!-- Search Box -->
                    <div class="p-2 border-bottom">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-secondary"></i></span>
                            <input type="text" class="form-control border-start-0" placeholder="Search chats..." @bind="SearchQuery" @bind:event="oninput" />
                        </div>
                    </div>

                    <!-- Conversation List -->
                    <div class="flex-grow-1 overflow-y-auto p-2">
                        @if (ActiveTab == "direct")
                        {
                            @if (IsLoadingSidebar)
                            {
                                <div class="text-center py-4">
                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                    <div class="small text-muted mt-1">Loading users...</div>
                                </div>
                            }
                            else if (!FilteredUsers.Any())
                            {
                                <div class="text-center py-4 text-muted small">
                                    <i class="fas fa-user-slash fa-2x mb-2 text-secondary-subtle"></i>
                                    <div>No users found</div>
                                </div>
                            }
                            else
                            {
                                @foreach (var user in FilteredUsers)
                                {
                                    var isSelected = !IsBotActive && !ChannelId.HasValue && string.Equals(OtherUserId, user.UserName, StringComparison.OrdinalIgnoreCase);
                                    <div class="p-2 rounded-3 mb-1 cursor-pointer transition-all d-flex align-items-center gap-2 @(isSelected ? "bg-primary text-white shadow-sm" : "hover-bg-white bg-white border border-light-subtle")" style="cursor: pointer; text-decoration: none;" @onclick="() => SelectUser(user.UserName)">
                                        <div class="position-relative flex-shrink-0">
                                            <div class="d-flex align-items-center justify-content-center rounded-circle @(isSelected ? "bg-white text-primary" : "bg-primary-subtle text-primary") fw-bold" style="width: 38px; height: 38px; font-size: 0.9rem;">
                                                @(user.FullUserName?.Length > 0 ? user.FullUserName[0].ToString().ToUpper() : user.UserName[0].ToString().ToUpper())
                                            </div>
                                            <span class="position-absolute bottom-0 end-0 p-1 rounded-circle border border-white @(user.Status == UserStatus.Online ? "bg-success" : user.Status == UserStatus.Away ? "bg-warning" : "bg-secondary")" style="width: 10px; height: 10px;"></span>
                                        </div>
                                        <div class="flex-grow-1 overflow-hidden text-start">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <strong class="small text-truncate @(isSelected ? "text-white" : "text-dark")">@(user.FullUserName ?? user.UserName)</strong>
                                                @if (UnreadCounts.TryGetValue(user.UserName, out int count) && count > 0)
                                                {
                                                    <span class="badge bg-danger rounded-pill">@count</span>
                                                }
                                            </div>
                                            <div class="small @(isSelected ? "text-white-50" : "text-muted") text-truncate" style="font-size: 0.78rem;">
                                                @(!string.IsNullOrEmpty(user.Designation) ? user.Designation : user.DepartmentName ?? "User")
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                        else if (ActiveTab == "channels")
                        {
                            <div class="d-flex justify-content-between align-items-center p-1 mb-2">
                                <span class="small fw-semibold text-secondary">Channels</span>
                                <button class="btn btn-xs btn-outline-primary" @onclick="OpenCreateChannelModal" title="New Channel">
                                    <i class="fas fa-plus me-1"></i>New
                                </button>
                            </div>
                            @if (!FilteredChannels.Any())
                            {
                                <div class="text-center py-4 text-muted small">
                                    <i class="fas fa-hashtag fa-2x mb-2 text-secondary-subtle"></i>
                                    <div>No channels found</div>
                                    <button class="btn btn-xs btn-primary mt-2" @onclick="OpenCreateChannelModal">Create Channel</button>
                                </div>
                            }
                            else
                            {
                                @foreach (var ch in FilteredChannels)
                                {
                                    var isSelected = !IsBotActive && ChannelId.HasValue && ChannelId.Value == ch.Id;
                                    <div class="p-2 rounded-3 mb-1 cursor-pointer transition-all d-flex align-items-center gap-2 @(isSelected ? "bg-primary text-white shadow-sm" : "hover-bg-white bg-white border border-light-subtle")" style="cursor: pointer;" @onclick="() => SelectChannel(ch.Id)">
                                        <div class="d-flex align-items-center justify-content-center rounded-2 @(isSelected ? "bg-white text-primary" : "bg-info-subtle text-info")" style="width: 36px; height: 36px;">
                                            <i class="fas fa-hashtag"></i>
                                        </div>
                                        <div class="flex-grow-1 overflow-hidden text-start">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <strong class="small text-truncate @(isSelected ? "text-white" : "text-dark")">@ch.Name</strong>
                                                @if (ch.UnreadCount > 0)
                                                {
                                                    <span class="badge bg-danger rounded-pill">@ch.UnreadCount</span>
                                                }
                                            </div>
                                            <div class="small @(isSelected ? "text-white-50" : "text-muted") text-truncate" style="font-size: 0.78rem;">
                                                @(ch.DepartmentName ?? "Public Group") · @ch.MemberCount members
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                        else if (ActiveTab == "bot")
                        {
                            <div class="p-3 text-center">
                                <div class="d-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mx-auto mb-2" style="width: 54px; height: 54px;">
                                    <i class="fas fa-robot fa-2x"></i>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">IntraBot AI Assistant</h6>
                                <p class="small text-muted mb-3">Enterprise AI assistant ready to help with ERP tasks, formulas, and inquiries.</p>
                                <button class="btn btn-sm btn-primary w-100 shadow-sm" @onclick="SelectBot">
                                    <i class="fas fa-comment-dots me-1"></i>Chat with IntraBot
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Right Chat Conversation Stream -->
                <div class="col-lg-9 col-md-8 d-flex flex-column h-100 bg-white">
                    @if (ActiveConversationSelected)
                    {
                        <!-- Chat Conversation Header -->
                        <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-light">
                            <div class="d-flex align-items-center gap-2">
                                <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold" style="width: 40px; height: 40px;">
                                    @if (IsBotActive)
                                    {
                                        <i class="fas fa-robot"></i>
                                    }
                                    else if (ChannelId.HasValue)
                                    {
                                        <i class="fas fa-hashtag"></i>
                                    }
                                    else
                                    {
                                        @(ActiveTargetTitle.Length > 0 ? ActiveTargetTitle[0].ToString().ToUpper() : "U")
                                    }
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark">@ActiveTargetTitle</h6>
                                    <small class="text-secondary">@ActiveTargetSubtitle</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                @if (!IsBotActive && !ChannelId.HasValue)
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="StartMeetingWithUser" title="Start Meeting / Call">
                                        <i class="fas fa-video me-1"></i>Video Call
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Messages Stream -->
                        <div class="flex-grow-1 p-3 overflow-y-auto d-flex flex-column gap-2" id="chatStreamBox" style="background: #f8fafc;">
                            @if (IsMessagesLoading)
                            {
                                <div class="d-flex justify-content-center align-items-center h-100">
                                    <div class="spinner-border text-primary" role="status"></div>
                                </div>
                            }
                            else if (!CurrentMessages.Any())
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                                    <i class="fas fa-comments fa-3x mb-2 text-secondary-subtle"></i>
                                    <h6>No messages yet</h6>
                                    <p class="small">Send a message to begin the conversation.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var msg in CurrentMessages)
                                {
                                    var isMine = string.Equals(msg.SenderId, CurrentUserId, StringComparison.OrdinalIgnoreCase);
                                    <div class="d-flex flex-column @(isMine ? "align-items-end" : "align-items-start") mb-1">
                                        <div class="d-flex align-items-center gap-1 mb-1">
                                            <span class="small fw-semibold @(isMine ? "text-primary" : "text-dark")" style="font-size: 0.78rem;">@(isMine ? "You" : msg.SenderName ?? msg.SenderId)</span>
                                            <small class="text-muted" style="font-size: 0.72rem;">@msg.SentAt.ToLocalTime().ToString("hh:mm tt")</small>
                                        </div>
                                        <div class="p-2 px-3 rounded-3 shadow-sm @(isMine ? "bg-primary text-white" : "bg-white text-dark border")" style="max-width: 75%; word-break: break-word; font-size: 0.9rem; line-height: 1.4; border-radius: 12px;">
                                            @msg.Content
                                            @if (msg.Attachments.Any())
                                            {
                                                <div class="mt-2 pt-2 border-top @(isMine ? "border-white-50" : "border-light-subtle")">
                                                    @foreach (var att in msg.Attachments)
                                                    {
                                                        <a href="@att.FilePath" target="_blank" class="btn btn-xs @(isMine ? "btn-light text-primary" : "btn-outline-primary") d-inline-flex align-items-center gap-1 text-decoration-none py-1 px-2" style="font-size: 0.75rem;">
                                                            <i class="fas fa-paperclip"></i>
                                                            <span>@att.FileName</span>
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }

                            @if (!string.IsNullOrEmpty(TypingIndicatorText))
                            {
                                <div class="text-muted small fst-italic py-1">
                                    <i class="fas fa-ellipsis fa-fade me-1 text-primary"></i>@TypingIndicatorText
                                </div>
                            }
                        </div>

                        <!-- Chat Bottom Input Bar -->
                        <div class="p-2 border-top bg-light">
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Type your message here..." @bind="InputMessageText" @onkeyup="HandleInputKeyUp" />
                                <button class="btn btn-primary px-3 shadow-sm" @onclick="SendMessageAsync" disabled="@(string.IsNullOrWhiteSpace(InputMessageText) || IsSending)">
                                    @if (IsSending)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-paper-plane me-1"></i>
                                        <span>Send</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Empty State when no conversation is selected -->
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                            <div class="d-flex align-items-center justify-content-center bg-light rounded-circle mb-3" style="width: 80px; height: 80px;">
                                <i class="fas fa-comments fa-3x text-secondary"></i>
                            </div>
                            <h5 class="fw-bold text-dark">Select a conversation</h5>
                            <p class="small text-secondary">Choose a colleague, a channel, or IntraBot from the sidebar to chat.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- New Channel Modal -->
@if (ShowCreateChannelModalState)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 12px;">
                <div class="modal-header bg-light border-bottom py-2">
                    <h5 class="modal-title fw-bold text-dark" style="font-size: 1.1rem;"><i class="fas fa-hashtag text-primary me-2"></i>Create New Channel</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateChannelModal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Channel Name *</label>
                        <input type="text" class="form-control form-control-sm" placeholder="e.g. accounts-team or logistics-coordination" @bind="NewChannelName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Department</label>
                        <select class="form-select form-select-sm" @bind="NewChannelDepartmentId">
                            <option value="">Public / Cross-Departmental</option>
                            @foreach (var d in Departments)
                            {
                                <option value="@d.DeptId">@d.DeptName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Description</label>
                        <textarea class="form-control form-control-sm" rows="3" placeholder="What is this channel about?" @bind="NewChannelDescription"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseCreateChannelModal">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary shadow-sm" @onclick="SaveChannelAsync">Create Channel</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .hover-bg-white:hover { background-color: #f1f5f9 !important; }
    .transition-all { transition: all 0.15s ease; }
</style>
