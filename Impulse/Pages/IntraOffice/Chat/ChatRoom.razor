@code {
    [Parameter] public int ChannelId { get; set; }

    public class AudioRecordingResult
    {
        public string Base64 { get; set; } = "";
        public string MimeType { get; set; } = "";
    }

    private IntraUserProfile? currentUser;
    private Channel? currentChannel;
    private List<Channel>? allChannels;
    private List<Message>? messages;
    private string newMessage = "";
    private string searchQuery = "";
    private string channelFilter = "all";
    private string? typingUser;
    private int memberCount;
    private bool isRecording = false;
    private InputFile? fileInput;
    private List<MessageAttachment> pendingAttachments = new();

    private IEnumerable<Channel> FilteredChannels =>
        allChannels?.Where(c => 
            (string.IsNullOrEmpty(searchQuery) || c.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || (c.Description != null && c.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))) &&
            (channelFilter == "all" || (channelFilter == "public" && !c.IsPrivate) || (channelFilter == "private" && c.IsPrivate))
        ) ?? Enumerable.Empty<Channel>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userPrincipal = authState.User;
            string? userId = userPrincipal.Identity?.Name;

            if (!string.IsNullOrEmpty(userId))
            {
                currentUser = await IntraOfficeService.GetUserProfileAsync(userId);
                if (currentUser == null)
                {
                    currentUser = new IntraUserProfile { UserName = userId, FullUserName = userId };
                }
            }

            allChannels = await ChannelService.GetAllChannelsAsync();
            NotificationService.OnNotificationReceived += HandleLiveNotification;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing Group Discussion");
        }
    }

    private async Task HandleLiveNotification(AppNotification notif)
    {
        if (currentChannel != null && notif.Category == NotificationCategory.Message)
        {
            if (notif.ActionUrl == $"/chat/{currentChannel.Id}" || notif.ActionUrl?.StartsWith($"/chat/{currentChannel.Id}") == true)
            {
                await InvokeAsync(async () =>
                {
                    messages = await MessageService.GetChannelMessagesAsync(currentChannel.Id);
                    StateHasChanged();
                    await ScrollToBottom();
                });
            }
        }
    }

    private void SelectChannel(int channelId)
    {
        Navigation.NavigateTo($"/chat/{channelId}");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ChannelId > 0)
        {
            currentChannel = await ChannelService.GetChannelByIdAsync(ChannelId);
            if (currentChannel != null)
            {
                messages = await MessageService.GetChannelMessagesAsync(ChannelId);
                memberCount = currentChannel.Members?.Count ?? 0;
            }
        }
        else
        {
            currentChannel = null;
            messages = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (messages?.Count > 0)
        {
            await ScrollToBottom();
        }
    }

    private async Task SendMessage()
    {
        try
        {
            if ((string.IsNullOrWhiteSpace(newMessage) && !pendingAttachments.Any()) || currentUser == null || currentChannel == null)
            {
                return;
            }

            var message = new Message
            {
                ChannelId = currentChannel.Id,
                SenderId = currentUser.Id,
                Content = newMessage.Trim(),
                MessageType = MessageType.Text,
                Attachments = pendingAttachments.ToList()
            };

            var sent = await MessageService.SendMessageAsync(message);

            messages ??= new();
            messages.Add(sent);
            newMessage = "";
            pendingAttachments.Clear();
            StateHasChanged();
            await ScrollToBottom();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sending channel message");
        }
    }

    private void InsertStarter(string prefix)
    {
        newMessage = prefix + newMessage;
    }

    private void TriggerAiDiscussionAssist()
    {
        var channelName = currentChannel?.Name ?? "team";
        Navigation.NavigateTo($"/ai-assistant?prompt={Uri.EscapeDataString($"Draft a concise, professional team announcement or discussion update for our #{channelName} channel summarizing active project milestones and next steps.")}");
    }

    private async Task StartVideoCall()
    {
        if (currentChannel == null || currentUser == null) return;
        var roomId = $"IntraOffice_Call_{Guid.NewGuid().ToString("N").Substring(0, 10)}";
        var meetLink = $"https://meet.jit.si/{roomId}";
        
        var message = new Message
        {
            ChannelId = currentChannel.Id,
            SenderId = currentUser.Id,
            Content = $"📞 [VIDEO CALL STARTED] | {meetLink}",
            MessageType = MessageType.Text
        };
        
        var sent = await MessageService.SendMessageAsync(message);
        
        messages ??= new();
        messages.Add(sent);
        StateHasChanged();
        await ScrollToBottom();

        // Send invitation to members if private
        if (currentChannel.IsPrivate && currentChannel.Members != null)
        {
            var otherMember = currentChannel.Members.FirstOrDefault(m => m.UserId != currentUser.Id);
            if (otherMember?.User != null)
            {
                var otherUser = otherMember.User;
                var inviteMsg = $"*Video Call Invitation*\n\nHello {otherUser.FullName},\n\n{currentUser.FullName} is calling you on Intra Office!\n\nJoin the video call here: {meetLink}";
                
                if (!string.IsNullOrEmpty(otherUser.PhoneNumber))
                {
                    _ = WhatsAppService.SendDirectMessageAsync(otherUser.PhoneNumber, inviteMsg);
                }
                if (!string.IsNullOrEmpty(otherUser.Email))
                {
                    var emailBody = $"<p>Hello {otherUser.FullName},</p><p><strong>{currentUser.FullName}</strong> is calling you on Intra Office!</p><p><a href=\"{meetLink}\">Click here to join the video call</a></p>";
                    _ = EmailService.SendEmailAsync(otherUser.Email, "Video Call Invitation", emailBody);
                }
            }
        }

        await JS.InvokeVoidAsync("window.open", meetLink, "_blank");
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(5))
        {
            try
            {
                var relativePath = await FileService.SaveFileToDiskAsync(file);
                pendingAttachments.Add(new MessageAttachment
                {
                    FileName = file.Name,
                    FilePath = relativePath,
                    FileSize = file.Size,
                    ContentType = file.ContentType,
                    UploadedAt = DateTime.UtcNow
                });
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error uploading file");
            }
        }
    }

    private void RemoveAttachment(MessageAttachment attachment)
    {
        pendingAttachments.Remove(attachment);
    }

    private async Task ToggleRecording()
    {
        try
        {
            if (!isRecording)
            {
                var success = await JS.InvokeAsync<bool>("window.audioRecorder.startRecording");
                if (success)
                {
                    isRecording = true;
                    StateHasChanged();
                }
                else
                {
                    Logger.LogWarning("Failed to start audio recording. Check microphone permissions.");
                    isRecording = false;
                    StateHasChanged();
                }
            }
            else
            {
                isRecording = false;
                StateHasChanged();

                var result = await JS.InvokeAsync<AudioRecordingResult>("window.audioRecorder.stopRecording");
                if (result != null && !string.IsNullOrEmpty(result.Base64))
                {
                    var fileName = $"VoiceNote_{DateTime.Now:yyyyMMdd_HHmmss}.webm";
                    var relativePath = await FileService.SaveBase64FileToDiskAsync(result.Base64, fileName);

                    pendingAttachments.Add(new MessageAttachment
                    {
                        FileName = fileName,
                        FilePath = relativePath,
                        FileSize = (long)(result.Base64.Length * 0.75),
                        ContentType = result.MimeType,
                        UploadedAt = DateTime.UtcNow
                    });

                    // Automatically send the voice note to the channel
                    await SendMessage();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling audio recording in Group Discussion");
            isRecording = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(50);
            await JS.InvokeVoidAsync("scrollToBottom", "chat-messages-list");
        }
        catch
        {
            // Ignore during prerender
        }
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024L * 1024 * 1024) return $"{bytes / (1024.0 * 1024.0):F1} MB";
        return $"{bytes / (1024.0 * 1024.0 * 1024.0):F2} GB";
    }

    private MarkupString ParseMessageContent(string content)
    {
        if (string.IsNullOrEmpty(content)) return new MarkupString("");
        
        var safeContent = System.Net.WebUtility.HtmlEncode(content);
        var linkRegex = new System.Text.RegularExpressions.Regex(@"\[([^\]]+)\]\(([^)]+)\)");
        safeContent = linkRegex.Replace(safeContent, m => 
            $"<a href=\"{m.Groups[2].Value}\" style=\"color: #6366f1; font-weight: 600; text-decoration: underline;\">{m.Groups[1].Value}</a>"
        );
        safeContent = safeContent.Replace("\n", "<br/>");
        return new MarkupString(safeContent);
    }

    public ValueTask DisposeAsync()
    {
        NotificationService.OnNotificationReceived -= HandleLiveNotification;
        return ValueTask.CompletedTask;
    }
}
