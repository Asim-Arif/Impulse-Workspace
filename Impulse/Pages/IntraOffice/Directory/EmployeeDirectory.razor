@page "/intraoffice/directory"
@attribute [Authorize]

<PageTitle>Employee Directory - IntraOffice</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">
            <!-- Header -->
            <div class="d-flex align-items-end justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-3 p-2" style="width: 42px; height: 42px;">
                        <i class="fas fa-address-book fa-lg"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold text-dark" style="font-size: 1.25rem;">Enterprise Directory</h4>
                        <small class="text-secondary">Staff roster, departmental hierarchy &amp; instant communication</small>
                    </div>
                </div>
                <div>
                    <a href="/intraoffice" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                        <i class="fas fa-arrow-left"></i>
                        <span>Back</span>
                    </a>
                </div>
            </div>

            <!-- Filters -->
            <div class="row g-2 mb-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-secondary border-end-0"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control form-control-sm border-start-0" placeholder="Search by name, designation, email..." @bind="SearchTerm" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select class="form-select form-select-sm" @bind="SelectedDepartmentId">
                        <option value="">All Departments</option>
                        @foreach (var d in Departments)
                        {
                            <option value="@d.DeptId">@d.DeptName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 text-end">
                    <span class="badge bg-light text-dark border p-2">Total Staff: @FilteredUsers.Count</span>
                </div>
            </div>

            <!-- Directory Grid -->
            @if (IsLoading)
            {
                <div class="d-flex justify-content-center align-items-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <span class="ms-2 text-secondary">Loading directory...</span>
                </div>
            }
            else if (!FilteredUsers.Any())
            {
                <div class="text-center py-5 border rounded-3 bg-light">
                    <i class="fas fa-users-slash fa-3x text-muted mb-2"></i>
                    <h6 class="text-secondary fw-semibold">No employees found</h6>
                    <p class="text-muted small mb-0">No colleagues matched your search query.</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var user in FilteredUsers)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card border border-light-subtle shadow-sm p-3 h-100 bg-white" style="border-radius: 10px;">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="position-relative">
                                        <div class="d-flex align-items-center justify-content-center bg-primary text-white rounded-circle fw-bold" style="width: 46px; height: 46px; font-size: 1.1rem;">
                                            @(user.EmployeeName?.Length > 0 ? user.EmployeeName[0].ToString().ToUpper() : user.UserName[0].ToString().ToUpper())
                                        </div>
                                        <span class="position-absolute bottom-0 end-0 p-1 rounded-circle border border-white @(user.Status == UserStatus.Online ? "bg-success" : user.Status == UserStatus.Away ? "bg-warning" : "bg-secondary")" style="width: 12px; height: 12px;"></span>
                                    </div>
                                    <div class="overflow-hidden">
                                        <h6 class="fw-bold text-dark mb-0 text-truncate">@(user.EmployeeName ?? user.FullUserName ?? user.UserName)</h6>
                                        <small class="text-primary fw-semibold d-block text-truncate">@(!string.IsNullOrEmpty(user.Designation) ? user.Designation : "Employee")</small>
                                        <small class="text-muted text-truncate d-block">@(user.DepartmentName ?? "Department")</small>
                                    </div>
                                </div>

                                <div class="small text-secondary mb-3">
                                    @if (!string.IsNullOrEmpty(user.Email))
                                    {
                                        <div class="text-truncate mb-1"><i class="fas fa-envelope text-muted me-2"></i>@user.Email</div>
                                    }
                                    @if (!string.IsNullOrEmpty(user.CellNo))
                                    {
                                        <div class="text-truncate mb-1"><i class="fas fa-phone text-muted me-2"></i>@user.CellNo</div>
                                    }
                                    <div class="text-truncate"><i class="fas fa-id-badge text-muted me-2"></i>Emp ID: @(user.EmpID ?? "N/A")</div>
                                </div>

                                <div class="mt-auto pt-2 border-top d-flex gap-2">
                                    <a href="/intraoffice/chat/@user.UserName" class="btn btn-sm btn-outline-primary flex-grow-1 d-flex align-items-center justify-content-center gap-1">
                                        <i class="fas fa-comment-dots"></i>
                                        <span>Message</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
