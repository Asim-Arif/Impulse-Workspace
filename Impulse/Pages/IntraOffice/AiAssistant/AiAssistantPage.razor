@page "/office/ai-assistant"
@page "/ai-assistant"
@using DataAccessLibrary.Models.IntraOffice
@using Impulse.Services.IntraOffice
@using Microsoft.AspNetCore.Components.Authorization
@inject IAiAssistantService AiAssistantService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>IntraBot Enterprise AI Assistant</PageTitle>

<div class="ai-page-container">
    <!-- Left Sidebar: Capabilities & Quick Starters -->
    <aside class="ai-page-sidebar">
        <div class="ai-sidebar-card">
            <div class="d-flex align-items-center gap-2 mb-3">
                <div class="ai-badge-icon">
                    <i class="bi bi-robot"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold">IntraBot Copilot</h6>
                    <small class="text-success"><i class="bi bi-circle-fill" style="font-size: 0.55rem;"></i> Online (GPT-4o)</small>
                </div>
            </div>
            <p class="text-muted small mb-3">
                IntraBot is your intelligent enterprise partner. It answers any general inquiry, analyzes business data, and accesses live company records.
            </p>

            <button class="btn btn-primary btn-sm w-100 mb-3 d-flex align-items-center justify-content-center gap-2" @onclick="ClearChat">
                <i class="bi bi-plus-lg"></i> New Conversation
            </button>
        </div>

        <div class="ai-sidebar-section">
            <div class="ai-section-label">RECOMMENDED PROMPTS</div>
            
            <div class="prompt-group">
                <div class="prompt-group-title"><i class="bi bi-kanban text-primary me-1"></i> Tasks & Workload</div>
                <button class="prompt-btn" @onclick='() => SendPrompt("What are my pending tasks and what is highest priority?")'>
                    "What are my pending tasks and priorities?"
                </button>
                <button class="prompt-btn" @onclick='() => SendPrompt("Do I have any overdue tasks or items due this week?")'>
                    "Any overdue tasks or items due this week?"
                </button>
            </div>

            <div class="prompt-group">
                <div class="prompt-group-title"><i class="bi bi-file-earmark-check text-warning me-1"></i> Minutes & Approvals</div>
                <button class="prompt-btn" @onclick='() => SendPrompt("List all pending minutes waiting for my approval.")'>
                    "List pending minutes waiting for my approval."
                </button>
                <button class="prompt-btn" @onclick='() => SendPrompt("Are there any urgent minutes that require immediate sign-off?")'>
                    "Are there any urgent minutes needing sign-off?"
                </button>
            </div>

            <div class="prompt-group">
                <div class="prompt-group-title"><i class="bi bi-megaphone text-info me-1"></i> Company News</div>
                <button class="prompt-btn" @onclick='() => SendPrompt("Summarize recent company announcements.")'>
                    "Summarize recent company announcements."
                </button>
            </div>

            <div class="prompt-group">
                <div class="prompt-group-title"><i class="bi bi-briefcase text-success me-1"></i> Business & CRM</div>
                <button class="prompt-btn" @onclick='() => SendPrompt("What is our current CRM pipeline and customer count?")'>
                    "What is our current CRM customer count?"
                </button>
                <button class="prompt-btn" @onclick='() => SendPrompt("Draft a professional follow-up email to a prospective international client for manufacturing export.")'>
                    "Draft client follow-up email for export."
                </button>
                <button class="prompt-btn" @onclick='() => SendPrompt("Explain the difference between FOB and CIF Incoterms in international trade.")'>
                    "Explain FOB vs CIF Incoterms."
                </button>
            </div>
        </div>
    </aside>

    <!-- Main Chat Workstation -->
    <main class="ai-page-main">
        <!-- Top Toolbar -->
        <header class="ai-main-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-stars text-primary fs-5"></i>
                <span class="fw-bold fs-6">Enterprise AI Assistant</span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2">Real-Time Database Connected</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="ExportChat" title="Export Conversation">
                    <i class="bi bi-download me-1"></i> Export
                </button>
                <button class="btn btn-outline-danger btn-sm" @onclick="ClearChat" title="Clear Chat">
                    <i class="bi bi-trash3 me-1"></i> Clear
                </button>
            </div>
        </header>

        <!-- Message Thread -->
        <div class="ai-page-messages" id="ai-fullpage-scroll">
            @foreach (var msg in messages)
            {
                <div class="ai-full-msg @(msg.Role == "user" ? "user-side" : "bot-side")">
                    <div class="ai-msg-avatar">
                        @if (msg.Role == "user")
                        {
                            <i class="bi bi-person-circle"></i>
                        }
                        else
                        {
                            <i class="bi bi-stars"></i>
                        }
                    </div>
                    <div class="ai-full-bubble">
                        <div class="ai-bubble-header d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold font-monospace" style="font-size: 0.75rem;">@(msg.Role == "user" ? "You" : "IntraBot Enterprise")</span>
                            <div class="d-flex align-items-center gap-2">
                                <small class="text-muted" style="font-size: 0.7rem;">@msg.Timestamp.ToString("hh:mm tt")</small>
                                @if (msg.Role != "user")
                                {
                                    <button class="btn btn-link btn-sm text-secondary p-0 ms-1" @onclick="() => SpeakMessage(msg.Content)" title="Read Aloud">
                                        <i class="bi bi-volume-up"></i>
                                    </button>
                                    <button class="btn btn-link btn-sm text-secondary p-0 ms-1" @onclick="() => CopyMessage(msg.Content)" title="Copy text">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="ai-full-content">
                            @((MarkupString)FormatMarkdown(msg.Content))
                        </div>
                        @if (msg.Role != "user")
                        {
                            var followUps = ExtractSuggestions(msg.Content);
                            if (followUps.Any())
                            {
                                <div class="ai-followup-wrap mt-2 pt-2 border-top">
                                    <small class="text-muted d-block mb-1" style="font-size: 0.72rem;"><i class="bi bi-lightning-charge text-warning me-1"></i>Suggested Next Steps:</small>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var f in followUps)
                                        {
                                            <button type="button" class="ai-followup-btn" @onclick="() => SendPrompt(f)">
                                                @f
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }

            @if (isThinking)
            {
                <div class="ai-full-msg bot-side">
                    <div class="ai-msg-avatar">
                        <i class="bi bi-stars"></i>
                    </div>
                    <div class="ai-full-bubble thinking">
                        <div class="d-flex align-items-center gap-2">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span class="text-muted small">IntraBot is analyzing context and formulating response...</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Voice Active Warning -->
        @if (isListeningVoice)
        {
            <div class="alert alert-danger mb-0 py-2 px-3 d-flex align-items-center justify-content-between rounded-0">
                <div class="d-flex align-items-center gap-2">
                    <span class="spinner-grow spinner-grow-sm text-danger" role="status"></span>
                    <strong>Voice Dictation Active:</strong> Speak clearly into your microphone...
                </div>
                <button class="btn btn-outline-danger btn-sm py-0" @onclick="StopVoice">Stop</button>
            </div>
        }

        <!-- Input Bar -->
        <footer class="ai-main-footer">
            <div class="ai-page-input-wrap">
                <textarea class="ai-page-input" 
                          rows="2"
                          placeholder="Type your question or instruction here... (e.g. 'What are my tasks?', 'Draft an email', 'Write a function'). Press Enter to send, Shift+Enter for new line."
                          @bind="userInput"
                          @bind:event="oninput"
                          @onkeydown="HandleKeyDown"
                          disabled="@isThinking"></textarea>

                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-outline-secondary btn-sm @(isListeningVoice ? "btn-danger text-white" : "")" 
                                @onclick="ToggleVoiceInput" 
                                type="button">
                            <i class="bi @(isListeningVoice ? "bi-mic-fill" : "bi-mic") me-1"></i>
                            @(isListeningVoice ? "Listening..." : "Voice Input")
                        </button>
                        <small class="text-muted" style="font-size: 0.72rem;">Press Enter ↵ to Send</small>
                    </div>

                    <button class="btn btn-primary px-4 d-flex align-items-center gap-2" 
                            @onclick="SendMessageAsync" 
                            disabled="@(string.IsNullOrWhiteSpace(userInput) || isThinking)">
                        <span>Send</span>
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </div>
        </footer>
    </main>
</div>

