@code {
    private bool isThinking = false;
    private bool isListeningVoice = false;
    private string userInput = "";
    private string currentUserId = "";
    private List<ChatMessageDto> messages = new();
    private DotNetObjectReference<AiAssistantPage>? dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserId = user.Identity?.Name
                         ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                         ?? user.FindFirst("sub")?.Value
                         ?? "";
        }

        messages.Add(new ChatMessageDto
        {
            Role = "assistant",
            Content = "Welcome to **IntraBot Enterprise Copilot**!\n\nI am equipped with high-level intelligence and full integration into your live IntraCom-CRM database. You can ask me:\n- Real-time status of your **Tasks**, **Pending Minutes**, and **Announcements**\n- **CRM Analytics**, sales performance, and pipeline summaries\n- Drafting client communications, business proposals, and minutes summaries\n- General queries, coding help, mathematical analysis, and translations.\n\nHow can I help you excel today?",
            Timestamp = DateTime.Now
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
        }

        await JSRuntime.InvokeVoidAsync("scrollChatToBottom", "ai-fullpage-scroll");
    }

    private void ClearChat()
    {
        messages.Clear();
        messages.Add(new ChatMessageDto
        {
            Role = "assistant",
            Content = "Conversation cleared. Ready for your next inquiry!",
            Timestamp = DateTime.Now
        });
    }

    private async Task SendPrompt(string prompt)
    {
        userInput = prompt;
        await SendMessageAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessageAsync();
        }
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(userInput) || isThinking) return;

        var text = userInput.Trim();
        userInput = "";

        messages.Add(new ChatMessageDto
        {
            Role = "user",
            Content = text,
            Timestamp = DateTime.Now
        });

        isThinking = true;
        StateHasChanged();
        await JSRuntime.InvokeVoidAsync("scrollChatToBottom", "ai-fullpage-scroll");

        try
        {
            var reply = await AiAssistantService.GetEnterpriseChatResponseAsync(text, currentUserId, messages);
            messages.Add(new ChatMessageDto
            {
                Role = "assistant",
                Content = reply,
                Timestamp = DateTime.Now
            });
        }
        catch (Exception ex)
        {
            messages.Add(new ChatMessageDto
            {
                Role = "assistant",
                Content = $"Error: {ex.Message}",
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            isThinking = false;
            StateHasChanged();
            await JSRuntime.InvokeVoidAsync("scrollChatToBottom", "ai-fullpage-scroll");
        }
    }

    private async Task ToggleVoiceInput()
    {
        if (isListeningVoice)
        {
            await JSRuntime.InvokeVoidAsync("stopVoiceDictation");
            isListeningVoice = false;
        }
        else
        {
            if (dotNetRef != null)
            {
                isListeningVoice = true;
                await JSRuntime.InvokeVoidAsync("startVoiceDictation", dotNetRef, "OnVoiceTranscript");
            }
        }
    }

    private async Task StopVoice()
    {
        await JSRuntime.InvokeVoidAsync("stopVoiceDictation");
        isListeningVoice = false;
    }

    [JSInvokable]
    public void OnVoiceTranscript(string transcript)
    {
        isListeningVoice = false;
        if (!string.IsNullOrWhiteSpace(transcript))
        {
            userInput = transcript;
            _ = SendMessageAsync();
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnVoiceError(string error)
    {
        isListeningVoice = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnVoiceEnd()
    {
        isListeningVoice = false;
        StateHasChanged();
    }

    private async Task SpeakMessage(string content)
    {
        await JSRuntime.InvokeVoidAsync("speakText", content);
    }

    private async Task CopyMessage(string content)
    {
        await JSRuntime.InvokeVoidAsync("copyToClipboard", content);
    }

    private async Task ExportChat()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"# IntraBot AI Chat Log - {DateTime.Now:yyyy-MM-dd HH:mm}");
        sb.AppendLine();
        foreach (var m in messages)
        {
            sb.AppendLine($"### [{m.Timestamp:HH:mm}] {(m.Role == "user" ? "User" : "IntraBot")}:");
            sb.AppendLine(m.Content);
            sb.AppendLine();
        }

        var fileName = $"ai-chat-{DateTime.Now:yyyyMMdd-HHmmss}.md";
        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var url = $"data:text/markdown;base64,{base64}";
        await JSRuntime.InvokeVoidAsync("downloadFile", url, fileName);
    }

    private List<string> ExtractSuggestions(string content)
    {
        var result = new List<string>();
        if (string.IsNullOrWhiteSpace(content)) return result;

        var markerIndex = content.IndexOf("Suggested Next Steps:", StringComparison.OrdinalIgnoreCase);
        if (markerIndex >= 0)
        {
            var textAfter = content.Substring(markerIndex);
            var lines = textAfter.Split('\n');
            foreach (var line in lines)
            {
                var trimmed = line.Trim();
                if (trimmed.StartsWith("- ") || trimmed.StartsWith("* "))
                {
                    var suggestion = trimmed.Substring(2).Trim();
                    suggestion = suggestion.Trim('*', '`', '"', ' ');
                    if (!string.IsNullOrWhiteSpace(suggestion) && suggestion.Length < 100)
                    {
                        result.Add(suggestion);
                    }
                }
            }
        }
        return result.Take(4).ToList();
    }

    private string FormatMarkdown(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";

        var html = System.Net.WebUtility.HtmlEncode(text);

        // Pre-formatted code blocks
        html = System.Text.RegularExpressions.Regex.Replace(html, @"```(.*?)```", "<pre><code>$1</code></pre>", System.Text.RegularExpressions.RegexOptions.Singleline);

        // Inline code
        html = System.Text.RegularExpressions.Regex.Replace(html, @"`([^`]+)`", "<code>$1</code>");

        // Bold
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.*?)\*\*", "<strong>$1</strong>");

        // Italics
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*(.*?)\*", "<em>$1</em>");

        // Markdown Links: [text](url) -> Clickable Links
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\[([^\]]+)\]\(([^)]+)\)", "<a href='$2' class='text-primary fw-bold text-decoration-underline'>$1</a>");

        // Markdown Tables
        if (html.Contains("|"))
        {
            html = System.Text.RegularExpressions.Regex.Replace(
                html,
                @"(?:\|[^\n\r]+\|\r?\n?)+",
                match =>
                {
                    var tableLines = match.Value.Trim().Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries);
                    if (tableLines.Length < 2) return match.Value;

                    var sb = new System.Text.StringBuilder();
                    sb.Append("<div class='table-responsive my-2'><table class='table table-sm table-bordered table-striped ai-table mb-0'>");

                    bool isHeader = true;
                    for (int i = 0; i < tableLines.Length; i++)
                    {
                        var line = tableLines[i].Trim();
                        if (line.Contains("---")) continue; // separator row

                        var cells = line.Trim('|').Split('|');
                        sb.Append("<tr>");
                        foreach (var cell in cells)
                        {
                            if (isHeader)
                                sb.Append($"<th class='bg-light text-dark px-2 py-1 small fw-bold'>{cell.Trim()}</th>");
                            else
                                sb.Append($"<td class='px-2 py-1 small'>{cell.Trim()}</td>");
                        }
                        sb.Append("</tr>");
                        if (isHeader) isHeader = false;
                    }
                    sb.Append("</table></div>");
                    return sb.ToString();
                });
        }

        // Headers
        html = System.Text.RegularExpressions.Regex.Replace(html, @"(?m)^### (.*?)$", "<h6 class='fw-bold mt-2 mb-1'>$1</h6>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"(?m)^## (.*?)$", "<h5 class='fw-bold mt-2 mb-1'>$1</h5>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"(?m)^# (.*?)$", "<h5 class='fw-bold mt-2 mb-1'>$1</h5>");

        // Bullet lists
        html = System.Text.RegularExpressions.Regex.Replace(html, @"(?m)^- (.*?)$", "<li>$1</li>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"(<li>.*<\/li>)", "<ul class='mb-1 ps-3'>$1</ul>", System.Text.RegularExpressions.RegexOptions.Singleline);

        // Line breaks
        html = html.Replace("\n", "<br/>");

        return html;
    }

    public async ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();
        try
        {
            await JSRuntime.InvokeVoidAsync("stopSpeaking");
        }
        catch
        {
            // Ignore JS errors during prerendering teardown or disconnection
        }
    }
}
