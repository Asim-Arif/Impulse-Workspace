@page "/office/health"
@page "/intraoffice/health"
@attribute [Authorize]

<PageTitle>System Health Monitor - IntraOffice</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">
            <!-- Header -->
            <div class="d-flex align-items-end justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center justify-content-center bg-success-subtle text-success rounded-3 p-2" style="width: 42px; height: 42px;">
                        <i class="fas fa-heart-pulse fa-lg"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold text-dark" style="font-size: 1.25rem;">System Health &amp; Diagnostics</h4>
                        <small class="text-secondary">Real-time database connectivity, server memory, uptime &amp; WhatsApp service diagnostics</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm" @onclick="RefreshHealthStatusAsync" disabled="@IsRefreshing">
                        @if (IsRefreshing)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Checking...</span>
                        }
                        else
                        {
                            <i class="fas fa-arrows-rotate"></i>
                            <span>Refresh Diagnostics</span>
                        }
                    </button>
                    <a href="/intraoffice" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                        <i class="fas fa-arrow-left"></i>
                        <span>Back</span>
                    </a>
                </div>
            </div>

            <!-- Health Overview Banner -->
            <div class="p-3 mb-3 rounded-3 border d-flex justify-content-between align-items-center @(IsDbHealthy ? "bg-success-subtle border-success text-success-emphasis" : "bg-danger-subtle border-danger text-danger-emphasis")">
                <div class="d-flex align-items-center gap-3">
                    <i class="fas @(IsDbHealthy ? "fa-circle-check" : "fa-triangle-exclamation") fa-2x"></i>
                    <div>
                        <h5 class="mb-0 fw-bold">@(IsDbHealthy ? "ALL SYSTEMS OPERATIONAL" : "DATABASE CONNECTION ISSUE")</h5>
                        <small>Last diagnostic probe at @LastChecked.ToLocalTime().ToString("hh:mm:ss tt")</small>
                    </div>
                </div>
                <span class="badge @(IsDbHealthy ? "bg-success" : "bg-danger") p-2 fs-6">@(IsDbHealthy ? "HEALTHY" : "DEGRADED")</span>
            </div>

            <!-- Metrics Grid -->
            <div class="row g-3">
                <!-- Card 1: SQL Server Database -->
                <div class="col-md-6 col-lg-3">
                    <div class="card border border-light-subtle shadow-sm p-3 bg-white h-100" style="border-radius: 10px;">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-3" style="width: 40px; height: 40px;">
                                <i class="fas fa-database"></i>
                            </div>
                            <span class="badge @(IsDbHealthy ? "bg-success" : "bg-danger")">@(IsDbHealthy ? "Connected" : "Error")</span>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">SQL Server (SMBI_AWM)</h6>
                        <p class="small text-muted mb-2">@DbLatencyMs ms query roundtrip latency</p>
                        <div class="small text-secondary mt-auto pt-2 border-top">
                            <strong>Status:</strong> @(IsDbHealthy ? "Live & responding" : "Failed to connect")
                        </div>
                    </div>
                </div>

                <!-- Card 2: WhatsApp Microservice -->
                <div class="col-md-6 col-lg-3">
                    <div class="card border border-light-subtle shadow-sm p-3 bg-white h-100" style="border-radius: 10px;">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center justify-content-center bg-success-subtle text-success rounded-3" style="width: 40px; height: 40px;">
                                <i class="fab fa-whatsapp"></i>
                            </div>
                            <span class="badge @(IsWhatsAppRunning ? "bg-success" : "bg-secondary")">@(IsWhatsAppRunning ? "Available" : "Offline")</span>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">WhatsApp Service</h6>
                        <p class="small text-muted mb-2">Local bridge (127.0.0.1:3001)</p>
                        <div class="small text-secondary mt-auto pt-2 border-top">
                            <strong>Status:</strong> @WhatsAppStatusText
                        </div>
                    </div>
                </div>

                <!-- Card 3: Memory Usage -->
                <div class="col-md-6 col-lg-3">
                    <div class="card border border-light-subtle shadow-sm p-3 bg-white h-100" style="border-radius: 10px;">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center justify-content-center bg-info-subtle text-info rounded-3" style="width: 40px; height: 40px;">
                                <i class="fas fa-memory"></i>
                            </div>
                            <span class="badge bg-info">Allocated</span>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Server Memory</h6>
                        <p class="small text-muted mb-2">@ProcessMemoryMb MB private working set</p>
                        <div class="small text-secondary mt-auto pt-2 border-top">
                            <strong>GC Mode:</strong> Server Garbage Collection
                        </div>
                    </div>
                </div>

                <!-- Card 4: Process Uptime -->
                <div class="col-md-6 col-lg-3">
                    <div class="card border border-light-subtle shadow-sm p-3 bg-white h-100" style="border-radius: 10px;">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center justify-content-center bg-warning-subtle text-warning rounded-3" style="width: 40px; height: 40px;">
                                <i class="fas fa-clock"></i>
                            </div>
                            <span class="badge bg-warning text-dark">Active</span>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Application Uptime</h6>
                        <p class="small text-muted mb-2">@UptimeString</p>
                        <div class="small text-secondary mt-auto pt-2 border-top">
                            <strong>Runtime:</strong> .NET 8 (CoreCLR)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
