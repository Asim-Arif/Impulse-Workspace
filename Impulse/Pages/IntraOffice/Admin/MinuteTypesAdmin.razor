@page "/admin/minute-types"
@page "/office/admin/minute-types"
@layout IntraOfficeLayout
@using DataAccessLibrary.Models.IntraOffice
@using Impulse.Services.IntraOffice
@inject IMinuteTypeService MinuteTypeService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Minute Types - Administration</PageTitle>

<div class="topbar d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="topbar-icon" style="width: 44px; height: 44px; border-radius: 12px; background: rgba(79, 70, 229, 0.1); color: #4f46e5; display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
            <i class="bi bi-tags-fill"></i>
        </div>
        <div>
            <h4 class="fw-bold mb-0">Minute Classification Types</h4>
            <span class="text-muted small" style="font-size: 0.82rem;">Manage official classification categories for internal workflows and executive approvals</span>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Add New Minute Type Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm" style="border-radius: 14px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-plus-circle text-primary"></i> Add Minute Type
                </h5>
                <p class="text-muted text-xs mb-3" style="font-size: 0.85rem;">
                    Define new categories for tagging executive minutes (e.g. <em>Financial, Operational, Board Approval, HR Policy</em>).
                </p>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Type Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-sm" placeholder="Enter type name..." @bind="newTypeName" @bind:event="oninput" @onkeyup="HandleKeyUp" />
                </div>

                <button class="btn btn-primary btn-sm rounded-pill w-100 py-2 fw-semibold shadow-sm" @onclick="CreateType" disabled="@string.IsNullOrWhiteSpace(newTypeName)">
                    <i class="bi bi-plus-lg me-1"></i> Save Minute Type
                </button>
            </div>
        </div>
    </div>

    <!-- Minute Types List Table -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm" style="border-radius: 14px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
            <div class="card-body p-0">
                <div class="d-flex align-items-center justify-content-between p-3 border-bottom">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-list-check text-primary me-2"></i>Configured Minute Types
                    </h6>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1">
                        @(types?.Count ?? 0) Total
                    </span>
                </div>

                @if (isLoading)
                {
                    <div class="p-5 text-center">
                        <div class="spinner-border text-primary" role="status"></div>
                        <div class="mt-2 text-muted small">Loading minute types...</div>
                    </div>
                }
                else if (types == null || !types.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-tags fs-1 text-secondary opacity-50 mb-2"></i>
                        <h6 class="fw-bold">No minute types found</h6>
                        <p class="small text-muted mb-0">Use the form on the left to add your first classification type.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                            <thead class="table-light text-secondary" style="font-size: 0.78rem; text-transform: uppercase;">
                                <tr>
                                    <th style="width: 70px;">ID</th>
                                    <th>Type Name</th>
                                    <th style="width: 130px;">Status</th>
                                    <th style="width: 140px;">Created Date</th>
                                    <th class="text-end" style="width: 120px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var type in types)
                                {
                                    <tr>
                                        <td class="text-muted font-monospace">#@type.Id</td>
                                        <td>
                                            @if (editingId == type.Id)
                                            {
                                                <input type="text" class="form-control form-control-sm" @bind="editName" />
                                            }
                                            else
                                            {
                                                <span class="fw-semibold text-dark">@type.Name</span>
                                            }
                                        </td>
                                        <td>
                                            @if (editingId == type.Id)
                                            {
                                                <div class="form-check form-switch mb-0">
                                                    <input class="form-check-input" type="checkbox" @bind="editIsActive" id="activeSwitch_@type.Id" />
                                                    <label class="form-check-label text-xs" for="activeSwitch_@type.Id">@(editIsActive ? "Active" : "Inactive")</label>
                                                </div>
                                            }
                                            else
                                            {
                                                @if (type.IsActive)
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1" style="font-size: 0.72rem;">
                                                        <i class="bi bi-check-circle-fill me-1"></i> Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-2 py-1" style="font-size: 0.72rem;">
                                                        <i class="bi bi-dash-circle me-1"></i> Inactive
                                                    </span>
                                                }
                                            }
                                        </td>
                                        <td class="text-muted small">@type.CreatedAt.ToString("MMM dd, yyyy")</td>
                                        <td class="text-end">
                                            @if (editingId == type.Id)
                                            {
                                                <button class="btn btn-sm btn-success rounded-circle me-1" title="Save" @onclick="SaveEdit">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary rounded-circle" title="Cancel" @onclick="CancelEdit">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-primary rounded-circle me-1" title="Edit" @onclick="() => StartEdit(type)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger rounded-circle" title="Delete" @onclick="() => DeleteType(type.Id)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<MinuteType>? types;
    private bool isLoading = true;
    private string newTypeName = "";

    // Edit State
    private int? editingId;
    private string editName = "";
    private bool editIsActive = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadTypes();
    }

    private async Task LoadTypes()
    {
        isLoading = true;
        types = await MinuteTypeService.GetAllAsync();
        isLoading = false;
    }

    private async Task CreateType()
    {
        if (!string.IsNullOrWhiteSpace(newTypeName))
        {
            await MinuteTypeService.CreateAsync(newTypeName.Trim());
            newTypeName = "";
            await LoadTypes();
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newTypeName))
        {
            await CreateType();
        }
    }

    private void StartEdit(MinuteType type)
    {
        editingId = type.Id;
        editName = type.Name;
        editIsActive = type.IsActive;
    }

    private async Task SaveEdit()
    {
        if (editingId.HasValue && !string.IsNullOrWhiteSpace(editName))
        {
            await MinuteTypeService.UpdateAsync(editingId.Value, editName.Trim(), editIsActive);
            editingId = null;
            await LoadTypes();
        }
    }

    private void CancelEdit()
    {
        editingId = null;
    }

    private async Task DeleteType(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this minute type?");
        if (confirmed)
        {
            await MinuteTypeService.DeleteAsync(id);
            await LoadTypes();
        }
    }
}
