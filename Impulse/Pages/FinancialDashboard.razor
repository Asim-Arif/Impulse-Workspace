@page "/financial"
@attribute [Authorize]

@using Impulse.Shared.Components
@using Impulse.Services
@using DataAccessLibrary.Models.ViewModels
@using DataAccessLibrary.Models.ReportModels
@inject IReportNavigationService ReportNavigation
@inject IAccountReportingAccessService AccountReportingService

<PageTitle>Financial Dashboard</PageTitle>

<div class="dashboard-shell">
    <div class="dashboard-hero">
        <div class="dashboard-icon-wrap">
            <i class="fas fa-chart-line"></i>
        </div>
        <div>
            <h1 class="dashboard-title">Financial</h1>
            <p class="dashboard-subtitle">Vouchers, ledgers, reports &amp; financial statements</p>
        </div>
    </div>

    <div class="dashboard-modules">
        <SecureDashCard Href="/accounts/chartofaccounts">
            <i class="fas fa-file-invoice"></i>
            <span>Chart of Accounts</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/payable">
            <i class="fas fa-money-bill-wave"></i>
            <span>Accounts Payable</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/receivable">
            <i class="fas fa-hand-holding-usd"></i>
            <span>Accounts Receivable</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/accountgroups">
            <i class="fas fa-layer-group"></i>
            <span>Account Groups</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/changecategory">
            <i class="fas fa-exchange-alt"></i>
            <span>Change Category</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/reindex">
            <i class="fas fa-sync-alt"></i>
            <span>Financial Re-Indexing</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/cashpaymentvoucher">
            <i class="fas fa-money-check-dollar"></i>
            <span>Cash Payment Voucher</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/bankpaymentvoucher">
            <i class="fas fa-money-check"></i>
            <span>Bank Payment Voucher</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/cashreceiptvoucher">
            <i class="fas fa-file-invoice-dollar"></i>
            <span>Cash Receipt Voucher</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/bankreceiptvoucher">
            <i class="fas fa-receipt"></i>
            <span>Bank Receipt Voucher</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/journalvoucher">
            <i class="fas fa-book"></i>
            <span>Journal Voucher</span>
        </SecureDashCard>

        <SecureDashCard Href="/accounts/accountsledger">
            <i class="fas fa-book-open"></i>
            <span>Accounts Ledger</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/trialbalance">
            <i class="fas fa-scale-balanced"></i>
            <span>Trial Balance</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/banklist">
            <i class="fa fa-university"></i>
            <span>Bank List</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/bankbalancestatement">
            <i class="fas fa-piggy-bank"></i>
            <span>Cash & Bank Status</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/cashbookreport">
            <i class="fas fa-Rupee-sign"></i>
            <span>Cash Book Report</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/maker-short-term-loan">
            <i class="fas fa-hand-holding-usd"></i>
            <span>Maker Short Term Loan</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/maker-long-term-loan">
            <i class="fas fa-hand-holding-usd"></i>
            <span>Maker Long Term Loan</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/maker-short-term-loan-ledger">
            <i class="fas fa-book-open"></i>
            <span>Maker S.T Loan Ledger</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/maker-long-term-loan-ledger">
            <i class="fas fa-book-open"></i>
            <span>Maker L.T Loan Ledger</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/maker-loan-clearance">
            <i class="fas fa-check-double"></i>
            <span>Maker Loan Clearance</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/maker-loan-transfer">
            <i class="fas fa-exchange-alt"></i>
            <span>Maker Loan Transfer</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/transactionregister">
            <i class="fas fa-list-check"></i>
            <span>Transaction Register</span>
        </SecureDashCard>
        <SecureDashCard Href="/accounts/chqbookdetail">
            <i class="fas fa-money-check"></i>
            <span>Cheque Book Detail</span>
        </SecureDashCard>

        <SecureDashCard OptionId="AccIncomeStatement" Module="Accounts" @onclick='() => ShowIncomeStatement(true)'>
            <i class="fas fa-file-invoice-dollar"></i>
            <span>Income Statement</span>
        </SecureDashCard>
        <SecureDashCard OptionId="AccIncomeStatement" Module="Accounts" @onclick='() => ShowIncomeStatement(false)'>
            <i class="fas fa-chart-pie"></i>
            <span>Income Statement Summary</span>
        </SecureDashCard>
        <SecureDashCard OptionId="AccBalanceSheet" Module="Accounts" @onclick='() => ShowBalanceSheet(true)'>
            <i class="fas fa-balance-scale"></i>
            <span>Balance Sheet</span>
        </SecureDashCard>
        <SecureDashCard OptionId="AccBalanceSheet" Module="Accounts" @onclick='() => ShowBalanceSheet(false)'>
            <i class="fas fa-balance-scale-left"></i>
            <span>Balance Sheet Summary</span>
        </SecureDashCard>
        <SecureDashCard OptionId="AccExpenseReport" Module="Accounts" @onclick='ShowExpenseReport'>
            <i class="fas fa-file-invoice"></i>
            <span>Expense Report</span>
        </SecureDashCard>
    </div>
</div>

<DateRangeModal @ref="rangeModal" />
<DateSingleModal @ref="singleModal" />

<style>
    .dashboard-shell {
        padding: 2rem;
        max-width: 1100px;
    }

    .dashboard-hero {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-bottom: 2.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 2px solid #e0e2ec;
    }

    .dashboard-icon-wrap {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: #d3e3fd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        color: #041e49;
        flex-shrink: 0;
    }

    .dashboard-title {
        font-size: 2rem;
        font-weight: 700;
        color: #1b1b1f;
        margin: 0;
        line-height: 1.2;
    }

    .dashboard-subtitle {
        color: #44474f;
        margin: 0.25rem 0 0;
        font-size: 0.95rem;
    }

    .dashboard-modules {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 1rem;
    }

    .dash-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 1.5rem 1rem;
        background: #ffffff;
        border: 1px solid #e0e2ec;
        border-radius: 16px;
        text-decoration: none;
        color: #1b1b1f;
        font-weight: 500;
        font-size: 0.875rem;
        text-align: center;
        transition: background-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
        cursor: pointer;
    }

    .dash-card i {
        font-size: 1.75rem;
        color: #4a90e2;
    }

    .dash-card:hover {
        background: #f0f4ff;
        box-shadow: 0 4px 16px rgba(74, 144, 226, 0.12);
        transform: translateY(-2px);
        color: #041e49;
    }

    .dash-card:hover i {
        color: #041e49;
    }
</style>

@code {
    private DateRangeModal rangeModal = null!;
    private DateSingleModal singleModal = null!;

    private async Task ShowIncomeStatement(bool bShowDetail)
    {
        var res = await rangeModal.Show();
        
        if (res.Success)
        {
            var req = new ReportRequest
            {
                ReportName = "IncomeStatement.rpt",
                Parameters = new Dictionary<string, object>
                {
                    { "@DTFrom", res.DateFrom },
                    { "@DTTo", res.DateTo }
                },
                FormulaValues = new Dictionary<string, object>
                {
                    { "DateRange", $"'{res.DateFrom:dd-MMM-yyyy} to {res.DateTo:dd-MMM-yyyy}'" },
                    { "ShowDetail", bShowDetail ? "true" : "false" }
                }
            };
            
            await ReportNavigation.PrintReportAsync(req);
        }
    }

    private async Task ShowBalanceSheet(bool bShowDetail)
    {
        var res = await singleModal.Show();
        
        if (res.Success)
        {
            var req = new ReportRequest
            {
                ReportName = "BalanceSheet.rpt",
                Parameters = new Dictionary<string, object>
                {
                    { "@DTTo", res.Date }
                },
                FormulaValues = new Dictionary<string, object>
                {
                    { "DateRange", $"'{res.Date:dd-MMM-yyyy}'" },
                    { "ShowDetail", bShowDetail ? "true" : "false" }
                }
            };
            
            await ReportNavigation.PrintReportAsync(req);
        }
    }

    private async Task ShowExpenseReport()
    {
        var res = await singleModal.Show();
        
        if (res.Success)
        {
            await AccountReportingService.PrepareExpenseReportDataAsync(res.Date);

            DateTime dtEnd = res.Date.AddMonths(12).AddDays(-1);

            var req = new ReportRequest
            {
                ReportName = "ExpenseReport6Months.rpt",
                Parameters = new Dictionary<string, object>(),
                FormulaValues = new Dictionary<string, object>
                {
                    { "DateRange", $"'{res.Date:dd-MMM-yyyy} to {dtEnd:dd-MMM-yyyy}'" }
                }
            };
            
            await ReportNavigation.PrintReportAsync(req);
        }
    }
}
