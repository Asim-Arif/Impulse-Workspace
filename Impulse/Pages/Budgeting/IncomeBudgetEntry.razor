@page "/budgeting/income/entry"
@page "/budgeting/income/entry-revision"
@attribute [Authorize]
@using DataAccessLibrary.Models.ViewModels.Budgeting
@using Blazored.Typeahead

<PageTitle>@(isRevision ? "Financial Budgeting (Revision)" : "Financial Budgeting") - Impulse</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <!-- Top Action Card -->
    <div class="card border-0 shadow-sm mb-2" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pb-2 mb-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center justify-content-center bg-success text-white rounded-circle shadow-sm" style="width: 38px; height: 38px;">
                        <i class="fas @(isRevision ? "fa-edit" : "fa-calculator") fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">@(isRevision ? "Financial Budgeting (Revision)" : "Financial Budgeting (Income)")</h5>
                        <small class="text-secondary">@(isRevision ? "Modify revised month-wise budget figures" : "Define original month-wise budget for Income Heads (31, 32, 33)")</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (!isRevision)
                    {
                        <button class="btn btn-warning btn-sm fw-semibold shadow-sm text-dark" @onclick="PromptUpdateRevision">
                            <i class="fas fa-sync-alt me-1"></i> Update Revision
                        </button>
                    }
                    <button class="btn btn-light btn-sm fw-semibold shadow-sm border" @onclick="PrintReportAsync">
                        <i class="fas fa-print me-1"></i> Print / Preview
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadBudgetDataAsync" title="Refresh">
                        <i class="fas fa-redo"></i>
                    </button>
                    <a class="btn btn-primary btn-sm fw-semibold shadow-sm" href="/budgeting/dashboard">
                        <i class="fas fa-chart-line me-1"></i> Dashboard
                    </a>
                    <a class="btn btn-outline-secondary btn-sm fw-semibold shadow-sm" href="/budgeting" title="Budgeting Hub">
                        <i class="fas fa-th-large"></i>
                    </a>
                </div>
            </div>

            <!-- Filters Bar with High Z-Index for Typeahead -->
            <div class="row g-2 align-items-center" style="position: relative !important; z-index: 9999 !important;">
                <!-- Financial Year -->
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">Financial Year</label>
                    <select class="form-select form-select-sm" value="@selectedFinYear" @onchange="OnFinYearChanged">
                        @foreach (var fy in financialYears)
                        {
                            <option value="@fy.Code">@fy.DisplayText</option>
                        }
                    </select>
                </div>

                <!-- Master Head Typeahead -->
                <div class="col-md-5">
                    <label class="form-label small fw-semibold text-secondary mb-1">Master Head</label>
                    <div class="typeahead-35px">
                        <BlazoredTypeahead SearchMethod="SearchMasterHeads"
                                          TValue="MasterHeadOption"
                                          TItem="MasterHeadOption"
                                          Value="SelectedMasterHead"
                                          ValueChanged="OnMasterHeadChanged"
                                          ValueExpression="@(() => SelectedMasterHead)"
                                          Placeholder="Search or select master head..."
                                          MaximumSuggestions="1000">
                            <SelectedTemplate Context="hd">
                                @hd.DisplayText
                            </SelectedTemplate>
                            <ResultTemplate Context="hd">
                                <div>
                                    <span class="fw-semibold">@hd.DisplayText</span>
                                </div>
                            </ResultTemplate>
                        </BlazoredTypeahead>
                    </div>
                </div>

                <!-- Account Search Query -->
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-secondary mb-1">Quick Search</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-secondary border-end-0"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="Search Account # or Title..."
                               value="@searchQuery" @oninput="OnSearchChanged" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Spreadsheet Data Grid Card -->
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px; position: relative !important; z-index: 1 !important;">
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-success" role="status"></div>
                    <div class="text-secondary mt-2 small">Loading budget accounts...</div>
                </div>
            }
            else if (!FilteredRows.Any())
            {
                <div class="text-center py-5 text-secondary">
                    <i class="fas fa-folder-open fa-2x mb-2 d-block text-muted"></i>
                    No budget accounts found for the selected criteria.
                    <div class="small mt-1 text-muted">
                        Ensure accounts have <strong>Budget Account = Yes</strong> in Chart of Accounts and match types 31, 32, 33.
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive" style="max-height: 68vh;">
                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.84rem;">
                        <thead class="table-light text-secondary sticky-top" style="font-size: 0.74rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                            <tr class="align-middle text-center">
                                <th style="width: 35px;">S#</th>
                                <th style="width: 100px;">Account #</th>
                                <th style="min-width: 220px;" class="text-start">Account Title</th>
                                <th style="width: 80px;">Jul</th>
                                <th style="width: 80px;">Aug</th>
                                <th style="width: 80px;">Sep</th>
                                <th style="width: 80px;">Oct</th>
                                <th style="width: 80px;">Nov</th>
                                <th style="width: 80px;">Dec</th>
                                <th style="width: 80px;">Jan</th>
                                <th style="width: 80px;">Feb</th>
                                <th style="width: 80px;">Mar</th>
                                <th style="width: 80px;">Apr</th>
                                <th style="width: 80px;">May</th>
                                <th style="width: 80px;">Jun</th>
                                <th style="width: 110px;" class="bg-success bg-opacity-10 text-success fw-bold">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int sNo = 1;
                            }
                            @foreach (var row in FilteredRows)
                            {
                                <tr>
                                    <td class="text-center text-muted small">@(sNo++)</td>
                                    <td class="fw-semibold text-center font-monospace small">@row.AccNo</td>
                                    <td class="text-start">
                                        <span class="fw-medium text-dark">@row.AccTitle</span>
                                        @if (!string.IsNullOrEmpty(row.HeadName))
                                        {
                                            <span class="badge bg-light text-secondary border ms-1" style="font-size: 0.7rem;">@row.HeadName</span>
                                        }
                                    </td>
                                    <td class="p-0"><input type="number" class="form-control form-control-sm border-0 text-end rounded-0 py-1 bg-transparent font-monospace" value="@row.MonthJuly" @onchange="@(async (ChangeEventArgs e) => await OnCellChangedAsync(row, "Month_July", e.Value))" /></td>
                                    <td class="p-0"><input type="number" class="form-control form-control-sm border-0 text-end rounded-0 py-1 bg-transparent font-monospace" value="@row.MonthAugust" @onchange="@(async (ChangeEventArgs e) => await OnCellChangedAsync(row, "Month_August", e.Value))" /></td>
                                    <td class="p-0"><input type="number" class="form-control form-control-sm border-0 text-end rounded-0 py-1 bg-transparent font-monospace" value="@row.MonthSeptember" @onchange="@(async (ChangeEventArgs e) => await OnCellChangedAsync(row, "Month_September", e.Value))" /></td>
                                    <td class="p-0"><input type="number" class="form-control form-control-sm border-0 text-end rounded-0 py-1 bg-transparent font-monospace" value="@row.MonthOctober" @onchange="@(async (ChangeEventArgs e) => await OnCellChangedAsync(row, "Month_October", e.Value))" /></td>
                                    <td class="p-0"><input type="number" class="form-control form-control-sm border-0 text-end rounded-0 py-1 bg-transparent font-monospace" value="@row.MonthNovember" @onchange="@(async (ChangeEventArgs e) => await OnCellChangedAsync(row, "Month_November", e.Value))" /></td>
                                    <td class="p-0"><input type="number" class="form-control form-control-sm border-0 text-end rounded-0 py-1 bg-transparent font-monospace" value="@row.MonthDecember" @onchange="@(async (ChangeEventArgs e) => await OnCellChangedAsync(row, "Month_December", e.Value))" /></td>
                                    <td class="p-0"><input type="number" class="form-control form-control-sm border-0 text-end rounded-0 py-1 bg-transparent font-monospace" value="@row.MonthJanuary" @onchange="@(async (ChangeEventArgs e) => await OnCellChangedAsync(row, "Month_January", e.Value))" /></td>
                                    <td class="p-0"><input type="number" class="form-control form-control-sm border-0 text-end rounded-0 py-1 bg-transparent font-monospace" value="@row.MonthFebruary" @onchange="@(async (ChangeEventArgs e) => await OnCellChangedAsync(row, "Month_February", e.Value))" /></td>
                                    <td class="p-0"><input type="number" class="form-control form-control-sm border-0 text-end rounded-0 py-1 bg-transparent font-monospace" value="@row.MonthMarch" @onchange="@(async (ChangeEventArgs e) => await OnCellChangedAsync(row, "Month_March", e.Value))" /></td>
                                    <td class="p-0"><input type="number" class="form-control form-control-sm border-0 text-end rounded-0 py-1 bg-transparent font-monospace" value="@row.MonthApril" @onchange="@(async (ChangeEventArgs e) => await OnCellChangedAsync(row, "Month_April", e.Value))" /></td>
                                    <td class="p-0"><input type="number" class="form-control form-control-sm border-0 text-end rounded-0 py-1 bg-transparent font-monospace" value="@row.MonthMay" @onchange="@(async (ChangeEventArgs e) => await OnCellChangedAsync(row, "Month_May", e.Value))" /></td>
                                    <td class="p-0"><input type="number" class="form-control form-control-sm border-0 text-end rounded-0 py-1 bg-transparent font-monospace" value="@row.MonthJune" @onchange="@(async (ChangeEventArgs e) => await OnCellChangedAsync(row, "Month_June", e.Value))" /></td>
                                    <td class="text-end font-monospace pe-2 fw-bold text-success bg-success bg-opacity-10">@row.RowTotal.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light sticky-bottom fw-bold text-dark" style="z-index: 2; box-shadow: 0 -1px 0 #dee2e6;">
                            <tr class="align-middle">
                                <td colspan="3" class="text-end text-uppercase pe-2 small">Totals:</td>
                                <td class="text-end font-monospace pe-1">@totals.July.ToString("N0")</td>
                                <td class="text-end font-monospace pe-1">@totals.August.ToString("N0")</td>
                                <td class="text-end font-monospace pe-1">@totals.September.ToString("N0")</td>
                                <td class="text-end font-monospace pe-1">@totals.October.ToString("N0")</td>
                                <td class="text-end font-monospace pe-1">@totals.November.ToString("N0")</td>
                                <td class="text-end font-monospace pe-1">@totals.December.ToString("N0")</td>
                                <td class="text-end font-monospace pe-1">@totals.January.ToString("N0")</td>
                                <td class="text-end font-monospace pe-1">@totals.February.ToString("N0")</td>
                                <td class="text-end font-monospace pe-1">@totals.March.ToString("N0")</td>
                                <td class="text-end font-monospace pe-1">@totals.April.ToString("N0")</td>
                                <td class="text-end font-monospace pe-1">@totals.May.ToString("N0")</td>
                                <td class="text-end font-monospace pe-1">@totals.June.ToString("N0")</td>
                                <td class="text-end font-monospace pe-2 text-success">@totals.GrandTotal.ToString("N0")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: Update Revision Confirmation -->
@if (showRevisionModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 12px;">
                <div class="modal-header border-bottom py-2">
                    <h6 class="modal-title fw-bold text-dark">
                        <i class="fas fa-exclamation-triangle text-warning me-2"></i> Update Income Revisions
                    </h6>
                    <button type="button" class="btn-close btn-sm" @onclick="CancelUpdateRevision"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="mb-2 text-dark">
                        Are you sure you want to update all 12-month <strong>Revised Budget</strong> figures from <strong>Proposed Budget</strong> amounts for Financial Year <strong>@selectedFinYear</strong>?
                    </p>
                    <div class="alert alert-warning py-2 mb-0 small">
                        <i class="fas fa-info-circle me-1"></i> This will overwrite all existing revised month figures for this year.
                    </div>
                </div>
                <div class="modal-footer border-top py-2">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CancelUpdateRevision">Cancel</button>
                    <button type="button" class="btn btn-warning btn-sm fw-bold text-dark" @onclick="ConfirmUpdateRevisionAsync">
                        <i class="fas fa-check me-1"></i> Yes, Update Revisions
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .typeahead-35px .blazored-typeahead {
        height: 35px !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        border-radius: 6px !important;
    }
    .typeahead-35px .blazored-typeahead__controls {
        height: 35px !important;
    }
    .typeahead-35px .blazored-typeahead__input {
        height: 33px !important;
        font-size: 0.88rem !important;
        padding: 4px 8px !important;
    }
</style>

