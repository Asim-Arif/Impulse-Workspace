@page "/budgeting/dashboard"
@page "/dashboard/budgeting"
@attribute [Authorize]
@using DataAccessLibrary.Models.ViewModels.Budgeting

<PageTitle>Budget Performance & Analytics - Impulse</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <!-- TOP HEADER WITH YEAR SELECTORS & TITLE -->
    <div class="card border-0 shadow-sm mb-3" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">
            <div class="row align-items-center g-3">
                <!-- Year Pills -->
                <div class="col-lg-3 col-md-4">
                    <div class="d-flex align-items-center gap-1 flex-wrap">
                        <span class="small fw-bold text-uppercase text-muted me-1"><i class="fas fa-calendar-alt me-1"></i>FY:</span>
                        @foreach (var fy in Data.FinancialYears.Take(5))
                        {
                            var fyCode = fy.Code;
                            var isSelected = string.Equals(Filter.FinancialYear, fyCode, StringComparison.OrdinalIgnoreCase);
                            <button type="button" class="btn btn-sm @(isSelected ? "btn-dark fw-bold" : "btn-outline-secondary")"
                                    @onclick="() => SelectYearAsync(fyCode)">
                                @fy.StartYear
                            </button>
                        }
                    </div>
                </div>

                <!-- Centered Header Title -->
                <div class="col-lg-6 col-md-4 text-center">
                    <h5 class="mb-0 fw-bold text-dark">Monthly Budget vs Actual</h5>
                    <div class="d-flex align-items-center justify-content-center gap-2 mt-1">
                        <span class="badge bg-light text-dark border px-2 py-1">FY @Filter.FinancialYear</span>
                        <span class="badge @(Filter.Mode == "Expenses" ? "bg-danger bg-opacity-10 text-danger border border-danger-subtle" : "bg-success bg-opacity-10 text-success border border-success-subtle") px-2 py-1">
                            @Filter.Mode
                        </span>
                        <span class="text-secondary small fw-medium">@SelectedPeriodLabel</span>
                    </div>
                </div>

                <!-- Right Actions: Mode Toggle & Entry Links -->
                <div class="col-lg-3 col-md-4 text-end">
                    <div class="d-inline-flex align-items-center gap-2">
                        <div class="btn-group btn-group-sm shadow-sm" role="group">
                            <button type="button" class="btn @(Filter.Mode == "Expenses" ? "btn-danger fw-bold" : "btn-outline-danger")"
                                    @onclick='() => SetModeAsync("Expenses")'>
                                <i class="fas fa-chart-line me-1"></i>Expenses
                            </button>
                            <button type="button" class="btn @(Filter.Mode == "Income" ? "btn-success fw-bold" : "btn-outline-success")"
                                    @onclick='() => SetModeAsync("Income")'>
                                <i class="fas fa-arrow-trend-up me-1"></i>Income
                            </button>
                        </div>
                        <a class="btn btn-sm btn-outline-secondary shadow-sm" href="/budgeting" title="Budgeting Hub">
                            <i class="fas fa-th-large"></i>
                        </a>
                        <a class="btn btn-sm btn-outline-secondary shadow-sm" href='@(Filter.Mode == "Expenses" ? "/budgeting/expense/entry" : "/budgeting/income/entry")' title="Open Budget Entry">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a class="btn btn-sm btn-outline-primary shadow-sm" href="/budgeting/reports" title="View Reports">
                            <i class="fas fa-file-invoice"></i>
                        </a>
                        <button class="btn btn-sm btn-light border shadow-sm" @onclick="LoadDashboardDataAsync" title="Refresh Live Data">
                            <i class="fas fa-redo @(IsLoading ? "fa-spin" : "")"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Quarter Selector Pills -->
            <div class="mt-3 pt-2 border-top">
                <div class="d-flex flex-wrap justify-content-center gap-1">
                    @foreach (var q in QuarterList)
                    {
                        var isSelected = Filter.QuarterIndex == q.Index && Filter.MonthIndex == 0;
                        <button type="button" class="btn btn-sm @(isSelected ? "btn-primary fw-bold" : "btn-outline-secondary")"
                                @onclick="() => SelectQuarterAsync(q.Index)">
                            @q.Name
                        </button>
                    }
                </div>
            </div>

            <!-- Month Selector Pills -->
            <div class="mt-2 pt-2 border-top">
                <div class="d-flex flex-wrap justify-content-center gap-1">
                    @foreach (var m in MonthList)
                    {
                        var isSelected = Filter.MonthIndex == m.Index;
                        <button type="button" class="btn btn-sm @(isSelected ? "btn-success fw-bold" : "btn-light border")"
                                style="font-size: 0.78rem;"
                                @onclick="() => SelectMonthAsync(m.Index)">
                            @m.Name
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 4 MAIN TOP KPI STATS CARDS -->
    <div class="row g-3 mb-3">
        <!-- CARD 1: TOTAL BUDGET -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold text-uppercase">Total Budget</span>
                        <div class="d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle" style="width: 34px; height: 34px;">
                            <i class="fas fa-file-invoice-dollar"></i>
                        </div>
                    </div>
                    <div class="fs-4 fw-bold text-dark font-monospace">Rs. @FormatShortNumber(Data.Summary.TotalBudget)</div>
                    <div class="small text-secondary mt-1">
                        <span>Prop: Rs. @FormatShortNumber(Data.Summary.BudgetProposed)</span>
                        @if (Data.Summary.BudgetRevised > 0)
                        {
                            <span class="ms-2">Rev: Rs. @FormatShortNumber(Data.Summary.BudgetRevised)</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- CARD 2: TOTAL ACTUAL / EXPENSES -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold text-uppercase">Total @(Filter.Mode == "Expenses" ? "Expenses" : "Income")</span>
                        <div class="d-flex align-items-center justify-content-center @(Filter.Mode == "Expenses" ? "bg-danger" : "bg-success") bg-opacity-10 @(Filter.Mode == "Expenses" ? "text-danger" : "text-success") rounded-circle" style="width: 34px; height: 34px;">
                            <i class="fas @(Filter.Mode == "Expenses" ? "fa-receipt" : "fa-wallet")"></i>
                        </div>
                    </div>
                    <div class="fs-4 fw-bold text-dark font-monospace">Rs. @FormatShortNumber(Data.Summary.TotalActual)</div>
                    <div class="small text-secondary mt-1">
                        <span>Actual Posted Vouchers</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- CARD 3: DIFFERENCE / VARIANCE -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold text-uppercase">Difference</span>
                        <div class="d-flex align-items-center justify-content-center @(Data.Summary.Variance >= 0 ? "bg-success text-success" : "bg-danger text-danger") bg-opacity-10 rounded-circle" style="width: 34px; height: 34px;">
                            <i class="fas @(Data.Summary.Variance >= 0 ? "fa-arrow-up" : "fa-arrow-down")"></i>
                        </div>
                    </div>
                    <div class="fs-4 fw-bold font-monospace @(Data.Summary.Variance >= 0 ? "text-success" : "text-danger")">
                        Rs. @FormatShortNumber(Math.Abs(Data.Summary.Variance))
                    </div>
                    <div class="mt-1">
                        <span class="badge @(Data.Summary.Variance >= 0 ? "bg-success bg-opacity-10 text-success" : "bg-danger bg-opacity-10 text-danger") fw-bold small">
                            @(Data.Summary.Variance >= 0 ? "Under Budget (Surplus)" : "Over Budget (Deficit)")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- CARD 4: % OF BUDGET USED -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold text-uppercase">% of Budget Used</span>
                        <div class="d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle" style="width: 34px; height: 34px;">
                            <i class="fas fa-bolt"></i>
                        </div>
                    </div>
                    <div class="fs-4 fw-bold font-monospace @(Data.Summary.PercentageUsed > 100 ? "text-danger" : "text-dark")">
                        @Data.Summary.PercentageUsed.ToString("0.1")%
                    </div>
                    <div class="progress mt-2" style="height: 6px;">
                        <div class="progress-bar @(Data.Summary.PercentageUsed > 100 ? "bg-danger" : (Data.Summary.PercentageUsed > 80 ? "bg-warning" : "bg-success"))"
                             style="width: @Math.Min(100, Math.Max(3, Data.Summary.PercentageUsed))%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2x2 MAIN ANALYTICAL VISUAL GRID -->
    <div class="row g-3 mb-3">
        <!-- TOP LEFT: EXPENSES BY CATEGORY (Donut Chart & Legend) -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
                <div class="card-header bg-transparent border-bottom p-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark">@(Filter.Mode == "Expenses" ? "Expenses" : "Income") by Category</h6>
                    <span class="badge bg-light text-secondary border">@Data.Categories.Count Categories</span>
                </div>
                <div class="card-body p-3">
                    <div class="row align-items-center">
                        <!-- SVG Donut Chart Visualizer -->
                        <div class="col-sm-5 text-center py-2">
                            <div class="position-relative d-inline-block">
                                <svg width="160" height="160" viewBox="0 0 170 170">
                                    <circle cx="85" cy="85" r="60" fill="transparent" stroke="#f1f5f9" stroke-width="26" />
                                    @{
                                        double cumulativePct = 0;
                                        double circumference = 2 * Math.PI * 60;
                                        foreach (var cat in Data.Categories)
                                        {
                                            double strokeLength = (cat.PercentageOfTotalBudget / 100.0) * circumference;
                                            double dashOffset = -((cumulativePct / 100.0) * circumference);
                                            <circle cx="85" cy="85" r="60" fill="transparent"
                                                    stroke="@cat.ColorHex"
                                                    stroke-width="26"
                                                    stroke-dasharray="@strokeLength @circumference"
                                                    stroke-dashoffset="@dashOffset"
                                                    transform="rotate(-90 85 85)"
                                                    style="transition: stroke-dasharray 0.5s ease;" />
                                            cumulativePct += cat.PercentageOfTotalBudget;
                                        }
                                    }
                                </svg>
                                <div class="position-absolute top-50 start-50 translate-middle text-center">
                                    <div class="fw-bold fs-5 text-dark font-monospace">@Data.Summary.PercentageUsed.ToString("0")%</div>
                                    <small class="text-secondary" style="font-size: 0.68rem; text-transform: uppercase;">Utilized</small>
                                </div>
                            </div>
                        </div>

                        <!-- Legend & Category Values -->
                        <div class="col-sm-7">
                            <div style="max-height: 200px; overflow-y: auto;">
                                @foreach (var cat in Data.Categories.Take(7))
                                {
                                    <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                                        <div class="d-flex align-items-center gap-2 text-truncate" style="max-width: 160px;">
                                            <span class="rounded-circle d-inline-block" style="width: 10px; height: 10px; background-color: @cat.ColorHex;"></span>
                                            <span class="small fw-semibold text-dark text-truncate" title="@cat.CategoryName">
                                                @cat.CategoryName
                                            </span>
                                        </div>
                                        <div class="text-end font-monospace">
                                            <span class="small fw-bold text-dark">Rs. @FormatShortNumber(cat.BudgetAmount)</span>
                                            <span class="small text-secondary ms-1">(@cat.PercentageOfTotalBudget.ToString("0.1")%)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TOP RIGHT: BUDGET VS EXPENSES BY MONTH -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
                <div class="card-header bg-transparent border-bottom p-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark">Budget vs @(Filter.Mode == "Expenses" ? "Expenses" : "Income") by Month</h6>
                    <div class="d-flex align-items-center gap-3 small">
                        <div class="d-flex align-items-center gap-1">
                            <span class="rounded-circle d-inline-block" style="width: 10px; height: 10px; background-color: #22c55e;"></span>
                            <span class="text-secondary">Total Budget</span>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <span class="rounded-circle d-inline-block" style="width: 10px; height: 10px; background-color: #1e3a8a;"></span>
                            <span class="text-secondary">Total @(Filter.Mode == "Expenses" ? "Expenses" : "Income")</span>
                        </div>
                    </div>
                </div>
                <div class="card-body p-3">
                    @{
                        decimal maxVal = Math.Max(1, Math.Max(
                            Data.MonthlyTrends.Count > 0 ? Data.MonthlyTrends.Max(x => x.BudgetAmount) : 0,
                            Data.MonthlyTrends.Count > 0 ? Data.MonthlyTrends.Max(x => x.ActualAmount) : 0
                        ));

                        int chartWidth = 600;
                        int chartHeight = 150;
                        int paddingX = 35;
                        int paddingY = 20;
                        int stepX = (chartWidth - (paddingX * 2)) / Math.Max(1, Data.MonthlyTrends.Count - 1);

                        var budgetPoints = new List<string>();
                        var actualPoints = new List<string>();

                        for (int i = 0; i < Data.MonthlyTrends.Count; i++)
                        {
                            int x = paddingX + (i * stepX);
                            int yBudget = chartHeight - paddingY - (int)((double)Data.MonthlyTrends[i].BudgetAmount / (double)maxVal * (chartHeight - (paddingY * 2)));
                            int yActual = chartHeight - paddingY - (int)((double)Data.MonthlyTrends[i].ActualAmount / (double)maxVal * (chartHeight - (paddingY * 2)));

                            budgetPoints.Add($"{x},{yBudget}");
                            actualPoints.Add($"{x},{yActual}");
                        }

                        string budgetPolyline = string.Join(" ", budgetPoints);
                        string actualPolyline = string.Join(" ", actualPoints);
                    }

                    <div style="overflow-x: auto;">
                        <svg width="100%" height="160" viewBox="0 0 600 160" preserveAspectRatio="none" style="min-width: 480px;">
                            <line x1="35" y1="20" x2="575" y2="20" stroke="#f1f5f9" stroke-width="1" stroke-dasharray="4" />
                            <line x1="35" y1="75" x2="575" y2="75" stroke="#f1f5f9" stroke-width="1" stroke-dasharray="4" />
                            <line x1="35" y1="130" x2="575" y2="130" stroke="#e2e8f0" stroke-width="1" />

                            @if (!string.IsNullOrWhiteSpace(budgetPolyline))
                            {
                                <polyline fill="none" stroke="#22c55e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" points="@budgetPolyline" />
                            }

                            @if (!string.IsNullOrWhiteSpace(actualPolyline))
                            {
                                <polyline fill="none" stroke="#1e3a8a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" points="@actualPolyline" />
                            }

                            @for (int i = 0; i < Data.MonthlyTrends.Count; i++)
                            {
                                int x = paddingX + (i * stepX);
                                int yBudget = chartHeight - paddingY - (int)((double)Data.MonthlyTrends[i].BudgetAmount / (double)maxVal * (chartHeight - (paddingY * 2)));
                                int yActual = chartHeight - paddingY - (int)((double)Data.MonthlyTrends[i].ActualAmount / (double)maxVal * (chartHeight - (paddingY * 2)));

                                <circle cx="@x" cy="@yBudget" r="4" fill="#22c55e" stroke="#ffffff" stroke-width="2" />
                                <circle cx="@x" cy="@yActual" r="4" fill="#1e3a8a" stroke="#ffffff" stroke-width="2" />
                                @((MarkupString)$"<text x=\"{x}\" y=\"152\" font-size=\"10\" fill=\"#64748b\" text-anchor=\"middle\" font-weight=\"600\">{Data.MonthlyTrends[i].MonthCode}</text>")
                            }
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- BOTTOM LEFT: LIST OF EXPENSES -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
                <div class="card-header bg-transparent border-bottom p-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark">List of @(Filter.Mode == "Expenses" ? "Expenses" : "Income")</h6>
                    <span class="small text-secondary">Performance by Head</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 280px; overflow-y: auto;">
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.84rem;">
                            <thead class="table-light sticky-top text-secondary small text-uppercase">
                                <tr>
                                    <th>Category</th>
                                    <th class="text-end">Budget</th>
                                    <th class="text-end">Spent</th>
                                    <th class="text-end">Variance</th>
                                    <th class="text-center">% Used</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Data.Categories.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">No budget records found</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var cat in Data.Categories)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="rounded-circle d-inline-block" style="width: 8px; height: 8px; background-color: @cat.ColorHex;"></span>
                                                    <span class="fw-semibold text-dark text-truncate" style="max-width: 130px;" title="@cat.CategoryName">
                                                        @cat.CategoryName
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="text-end fw-semibold font-monospace">Rs. @FormatShortNumber(cat.BudgetAmount)</td>
                                            <td class="text-end text-dark font-monospace">Rs. @FormatShortNumber(cat.ActualAmount)</td>
                                            <td class="text-end fw-semibold font-monospace @(cat.Variance >= 0 ? "text-success" : "text-danger")">
                                                Rs. @FormatShortNumber(Math.Abs(cat.Variance))
                                            </td>
                                            <td class="text-center font-monospace">
                                                @if (cat.IsOverBudget)
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger small">
                                                        @cat.PercentageUsed.ToString("0")%
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success small">
                                                        @cat.PercentageUsed.ToString("0")%
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- BOTTOM RIGHT: BUDGET VS EXPENSES BY CATEGORY -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
                <div class="card-header bg-transparent border-bottom p-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark">Budget vs @(Filter.Mode == "Expenses" ? "Expenses" : "Income") by Category</h6>
                    <div class="d-flex align-items-center gap-3 small">
                        <div class="d-flex align-items-center gap-1">
                            <span class="rounded-circle d-inline-block" style="width: 10px; height: 10px; background-color: #22c55e;"></span>
                            <span class="text-secondary">Total Budget</span>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <span class="rounded-circle d-inline-block" style="width: 10px; height: 10px; background-color: #1e3a8a;"></span>
                            <span class="text-secondary">Total @(Filter.Mode == "Expenses" ? "Expenses" : "Income")</span>
                        </div>
                    </div>
                </div>
                <div class="card-body p-3">
                    @foreach (var cat in Data.Categories.Take(5))
                    {
                        decimal higher = Math.Max(1, Math.Max(cat.BudgetAmount, cat.ActualAmount));
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1 small">
                                <span class="fw-semibold text-dark text-truncate" style="max-width: 220px;" title="@cat.CategoryName">
                                    @cat.CategoryName
                                </span>
                                <div class="font-monospace small">
                                    <span class="text-success fw-bold me-2">B: Rs. @FormatShortNumber(cat.BudgetAmount)</span>
                                    <span class="text-primary fw-bold">A: Rs. @FormatShortNumber(cat.ActualAmount)</span>
                                </div>
                            </div>
                            <div class="progress mb-1" style="height: 8px; background-color: #f1f5f9; border-radius: 4px;">
                                <div class="progress-bar bg-success" style="width: @Math.Max(3, (double)(cat.BudgetAmount / higher * 100))%"
                                     title="Budget: Rs. @FormatCurrency(cat.BudgetAmount)"></div>
                            </div>
                            <div class="progress" style="height: 8px; background-color: #f1f5f9; border-radius: 4px;">
                                <div class="progress-bar" style="background-color: #1e3a8a; width: @Math.Max(3, (double)(cat.ActualAmount / higher * 100))%"
                                     title="Actual: Rs. @FormatCurrency(cat.ActualAmount)"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

