@page "/budgeting"
@attribute [Authorize]

@using Impulse.Shared.Components

<PageTitle>Financial Budgeting - Impulse</PageTitle>

<div class="dashboard-shell">
    <div class="dashboard-hero">
        <div class="dashboard-icon-wrap">
            <i class="fas fa-calculator"></i>
        </div>
        <div>
            <h1 class="dashboard-title">Financial Budgeting</h1>
            <p class="dashboard-subtitle">Budget allocation, month-wise targets, variance analysis &amp; reports</p>
        </div>
    </div>

    <div class="dashboard-modules">
        <SecureDashCard Href="/budgeting/dashboard" OptionId="BudDashboard" Module="Budgeting">
            <i class="fas fa-chart-line"></i>
            <span>Performance Dashboard</span>
        </SecureDashCard>
        <SecureDashCard Href="/budgeting/expense/entry" OptionId="BudExpenseEntry" Module="Budgeting">
            <i class="fas fa-receipt"></i>
            <span>Expense Budget Entry</span>
        </SecureDashCard>
        <SecureDashCard Href="/budgeting/income/entry" OptionId="BudIncomeEntry" Module="Budgeting">
            <i class="fas fa-wallet"></i>
            <span>Income Budget Entry</span>
        </SecureDashCard>
        <SecureDashCard Href="/budgeting/income/entry-revision" OptionId="BudIncomeRevisions" Module="Budgeting">
            <i class="fas fa-edit"></i>
            <span>Income Budget Revisions</span>
        </SecureDashCard>
        <SecureDashCard Href="/budgeting/expense/reports/q1" OptionId="BudReports" Module="Budgeting">
            <i class="fas fa-file-invoice-dollar"></i>
            <span>Expense Quarterly Reports</span>
        </SecureDashCard>
        <SecureDashCard Href="/budgeting/income/reports/q1" OptionId="BudReports" Module="Budgeting">
            <i class="fas fa-money-check-dollar"></i>
            <span>Income Quarterly Reports</span>
        </SecureDashCard>
        <SecureDashCard Href="/budgeting/income/budget-at-glance" OptionId="BudReports" Module="Budgeting">
            <i class="fas fa-eye"></i>
            <span>Budget at Glance</span>
        </SecureDashCard>
        <SecureDashCard Href="/budgeting/reports" OptionId="BudReports" Module="Budgeting">
            <i class="fas fa-chart-pie"></i>
            <span>All Budget Reports</span>
        </SecureDashCard>
    </div>
</div>

<style>
    .dashboard-shell {
        padding: 2rem;
        max-width: 1100px;
    }

    .dashboard-hero {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-bottom: 2.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 2px solid #e0e2ec;
    }

    .dashboard-icon-wrap {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: #d3e3fd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        color: #041e49;
        flex-shrink: 0;
    }

    .dashboard-title {
        font-size: 2rem;
        font-weight: 700;
        color: #1b1b1f;
        margin: 0;
        line-height: 1.2;
    }

    .dashboard-subtitle {
        color: #44474f;
        margin: 0.25rem 0 0;
        font-size: 0.95rem;
    }

    .dashboard-modules {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 1rem;
    }

    .dash-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 1.5rem 1rem;
        background: #ffffff;
        border: 1px solid #e0e2ec;
        border-radius: 16px;
        text-decoration: none;
        color: #1b1b1f;
        font-weight: 500;
        font-size: 0.875rem;
        text-align: center;
        transition: background-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
        cursor: pointer;
    }

    .dash-card i {
        font-size: 1.75rem;
        color: #4a90e2;
    }

    .dash-card:hover {
        background: #f0f4ff;
        box-shadow: 0 4px 16px rgba(74, 144, 226, 0.12);
        transform: translateY(-2px);
        color: #041e49;
    }

    .dash-card:hover i {
        color: #041e49;
    }
</style>
