@page "/budgeting/income/reports/q1"
@page "/budgeting/income/reports/q2"
@page "/budgeting/income/reports/q3"
@page "/budgeting/income/reports/q4"
@page "/budgeting/income/reports/date-range"
@page "/budgeting/income/budget-at-glance"
@page "/budgeting/expense/reports/q1"
@page "/budgeting/expense/reports/q2"
@page "/budgeting/expense/reports/q3"
@page "/budgeting/expense/reports/q4"
@page "/budgeting/expense/reports/date-range"
@page "/budgeting/reports"
@attribute [Authorize]
@using DataAccessLibrary.Models.ViewModels.Budgeting
@using Blazored.Typeahead

<PageTitle>@pageTitle - Impulse</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <!-- Top Action Card -->
    <div class="card border-0 shadow-sm mb-2" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pb-2 mb-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center justify-content-center @(isExpenses ? "bg-danger" : "bg-primary") text-white rounded-circle shadow-sm" style="width: 38px; height: 38px;">
                        <i class="fas @(isExpenses ? "fa-chart-pie" : "fa-chart-line") fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">@pageTitle</h5>
                        <small class="text-secondary">@(isExpenses ? "Expenses Budget vs Actual performance comparison" : "Income Budget vs Actual revenue comparison")</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-light btn-sm fw-semibold shadow-sm border" @onclick="PrintReportAsync">
                        <i class="fas fa-print me-1 text-primary"></i> Print Report
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadReportAsync" title="Refresh">
                        <i class="fas fa-redo"></i>
                    </button>
                    <a class="btn btn-primary btn-sm fw-semibold shadow-sm" href="/budgeting/dashboard">
                        <i class="fas fa-chart-line me-1"></i> Dashboard
                    </a>
                    <a class="btn btn-outline-secondary btn-sm fw-semibold shadow-sm" href="/budgeting" title="Budgeting Hub">
                        <i class="fas fa-th-large"></i>
                    </a>
                </div>
            </div>

            <!-- Module & Report Switching Tabs / Navigation Pills -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <!-- Mode Switcher (Income vs Expenses) -->
                <div class="btn-group btn-group-sm shadow-sm" role="group">
                    <button type="button" class="btn @(!isExpenses ? "btn-primary" : "btn-outline-primary") fw-semibold"
                            @onclick="() => SwitchModule(false)">
                        <i class="fas fa-wallet me-1"></i> Income Reports
                    </button>
                    <button type="button" class="btn @(isExpenses ? "btn-danger" : "btn-outline-danger") fw-semibold"
                            @onclick="() => SwitchModule(true)">
                        <i class="fas fa-receipt me-1"></i> Expense Reports
                    </button>
                </div>

                <!-- Period Pills -->
                <div class="btn-group btn-group-sm shadow-sm" role="group">
                    <button type="button" class="btn @(reportType == "quarter" && quarterNo == 1 ? "btn-dark" : "btn-outline-secondary")"
                            @onclick="() => SwitchReportType(1)">
                        Q1 (Jul-Sep)
                    </button>
                    <button type="button" class="btn @(reportType == "quarter" && quarterNo == 2 ? "btn-dark" : "btn-outline-secondary")"
                            @onclick="() => SwitchReportType(2)">
                        Q2 (Oct-Dec)
                    </button>
                    <button type="button" class="btn @(reportType == "quarter" && quarterNo == 3 ? "btn-dark" : "btn-outline-secondary")"
                            @onclick="() => SwitchReportType(3)">
                        Q3 (Jan-Mar)
                    </button>
                    <button type="button" class="btn @(reportType == "quarter" && quarterNo == 4 ? "btn-dark" : "btn-outline-secondary")"
                            @onclick="() => SwitchReportType(4)">
                        Q4 (Apr-Jun)
                    </button>
                    <button type="button" class="btn @(reportType == "date-range" ? "btn-dark" : "btn-outline-secondary")"
                            @onclick="() => SwitchReportType(0, isDateRange: true)">
                        <i class="fas fa-calendar-alt me-1"></i> Date Range
                    </button>
                    @if (!isExpenses)
                    {
                        <button type="button" class="btn @(reportType == "glance" ? "btn-dark" : "btn-outline-secondary")"
                                @onclick="() => SwitchReportType(0, isGlance: true)">
                            <i class="fas fa-eye me-1"></i> At Glance
                        </button>
                    }
                </div>
            </div>

            <!-- Filters Bar with High Z-Index for Typeahead -->
            <div class="row g-2 align-items-center" style="position: relative !important; z-index: 9999 !important;">
                <!-- Financial Year -->
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">Financial Year</label>
                    <select class="form-select form-select-sm" value="@selectedFinYear" @onchange="OnFinYearChanged">
                        @foreach (var fy in financialYears)
                        {
                            <option value="@fy.Code">@fy.DisplayText</option>
                        }
                    </select>
                </div>

                <!-- Master Head Typeahead -->
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-secondary mb-1">Master Head</label>
                    <div class="typeahead-35px">
                        <BlazoredTypeahead SearchMethod="SearchMasterHeads"
                                           TValue="MasterHeadOption"
                                           TItem="MasterHeadOption"
                                           Value="SelectedMasterHead"
                                           ValueChanged="OnMasterHeadChanged"
                                           ValueExpression="@(() => SelectedMasterHead)"
                                           Placeholder="All Heads..."
                                           MaximumSuggestions="1000">
                            <SelectedTemplate Context="hd">
                                @hd.DisplayText
                            </SelectedTemplate>
                            <ResultTemplate Context="hd">
                                <div>
                                    <span class="fw-semibold">@hd.DisplayText</span>
                                </div>
                            </ResultTemplate>
                        </BlazoredTypeahead>
                    </div>
                </div>

                @if (reportType == "date-range")
                {
                    <!-- Date From -->
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary mb-1">From Date</label>
                        <input type="date" class="form-control form-control-sm" @bind="fromDate" @bind:after="LoadReportAsync" />
                    </div>

                    <!-- Date To -->
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary mb-1">To Date</label>
                        <input type="date" class="form-control form-control-sm" @bind="toDate" @bind:after="LoadReportAsync" />
                    </div>
                }
                else
                {
                    <!-- Quick Search Filter -->
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold text-secondary mb-1">Filter Results</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-secondary border-end-0"><i class="fas fa-search"></i></span>
                            <input type="text" class="form-control border-start-0" placeholder="Filter by Account # or Title..."
                                   value="@searchQuery" @oninput="OnSearchChanged" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Report Table Grid Card -->
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px; position: relative !important; z-index: 1 !important;">
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="text-secondary mt-2 small">Generating report data...</div>
                </div>
            }
            else if (!FilteredRows.Any())
            {
                <div class="text-center py-5 text-secondary">
                    <i class="fas fa-file-invoice-dollar fa-2x mb-2 d-block text-muted"></i>
                    No data available for the selected filters.
                </div>
            }
            else
            {
                <div class="table-responsive" style="max-height: 68vh;">
                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.86rem;">
                        <thead class="table-light text-secondary sticky-top" style="font-size: 0.76rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                            <tr class="text-center align-middle">
                                <th style="width: 45px;">S#</th>
                                <th style="width: 110px;">Account #</th>
                                <th class="text-start" style="min-width: 250px;">Account Title</th>
                                <th style="width: 130px;">Head</th>
                                <th style="width: 120px;" class="bg-primary bg-opacity-10 text-primary fw-bold">Proposed</th>
                                <th style="width: 120px;" class="bg-warning bg-opacity-10 text-dark fw-bold">Revised</th>
                                <th style="width: 120px;" class="bg-success bg-opacity-10 text-success fw-bold">Actual</th>
                                <th style="width: 120px;" class="fw-bold">Variance</th>
                                <th style="width: 80px;">% Var</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int sNo = 1;
                            }
                            @foreach (var row in FilteredRows)
                            {
                                <tr>
                                    <td class="text-center text-muted small">@(sNo++)</td>
                                    <td class="text-center fw-semibold font-monospace small">@row.AccNo</td>
                                    <td class="text-start fw-medium text-dark">@row.AccTitle</td>
                                    <td class="text-center"><span class="badge bg-light text-secondary border small">@row.HeadName</span></td>
                                    <td class="text-end font-monospace pe-2">@row.ProposedAmount.ToString("N0")</td>
                                    <td class="text-end font-monospace pe-2">@row.RevisedAmount.ToString("N0")</td>
                                    <td class="text-end font-monospace pe-2 fw-semibold">@row.ActualAmount.ToString("N0")</td>
                                    <td class="text-end font-monospace pe-2 fw-bold @(row.Variance >= 0 ? "text-success" : "text-danger")">
                                        @row.Variance.ToString("N0")
                                    </td>
                                    <td class="text-center font-monospace small @(row.VariancePercent >= 0 ? "text-success" : "text-danger")">
                                        @row.VariancePercent.ToString("N1")%
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light sticky-bottom fw-bold text-dark" style="z-index: 2; box-shadow: 0 -1px 0 #dee2e6;">
                            <tr class="align-middle">
                                <td colspan="4" class="text-end text-uppercase pe-3 small">Totals:</td>
                                <td class="text-end font-monospace pe-2 text-primary">@TotalProposed.ToString("N0")</td>
                                <td class="text-end font-monospace pe-2 text-dark">@TotalRevised.ToString("N0")</td>
                                <td class="text-end font-monospace pe-2 text-success">@TotalActual.ToString("N0")</td>
                                <td class="text-end font-monospace pe-2 @(TotalVariance >= 0 ? "text-success" : "text-danger")">
                                    @TotalVariance.ToString("N0")
                                </td>
                                <td class="text-center font-monospace small">
                                    @(TotalProposed != 0 ? (Math.Round((TotalVariance / TotalProposed) * 100, 1) + "%") : "-")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .typeahead-35px .blazored-typeahead {
        height: 35px !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        border-radius: 6px !important;
    }
    .typeahead-35px .blazored-typeahead__controls {
        height: 35px !important;
    }
    .typeahead-35px .blazored-typeahead__input {
        height: 33px !important;
        font-size: 0.88rem !important;
        padding: 4px 8px !important;
    }
</style>

