@page "/company/ports"
@attribute [Authorize]
@using DataAccessLibrary.Models.ViewModels.Company
@using BlazorContextMenu

<PageTitle>Ports & Locations</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body pt-3">
            <!-- Toolbar -->
            <div class="row g-2 mb-3 align-items-end">
                <div class="col-auto d-flex align-items-end pb-1">
                    <h5 class="mb-0 fw-bold text-dark-emphasis">
                        <i class="fas fa-globe-americas text-primary me-2"></i>
                        Ports & Locations
                    </h5>
                </div>
                <div class="col-md-4 ms-3">
                    <label class="form-label fw-bold text-secondary mb-1" style="font-size:0.8rem;"><i class="fas fa-search me-1"></i>Search</label>
                    <input type="text" class="form-control form-control-sm" placeholder="Search locations..." @bind="searchText" @bind:event="oninput" />
                </div>

                <div class="col d-flex align-items-end justify-content-end gap-2 pb-1">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RefreshTree" title="Refresh List">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ExpandAll">
                        <i class="fas fa-expand-arrows-alt me-1"></i> Expand All
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CollapseAll">
                        <i class="fas fa-compress-arrows-alt me-1"></i> Collapse All
                    </button>
                    <button type="button" class="btn btn-primary btn-sm ms-2" @onclick="AddNewCountry">
                        <i class="fas fa-plus me-1"></i> Add Country
                    </button>
                </div>
            </div>

            <!-- Main Workspace (Custom TreeView) -->
            @if (isLoading)
            {
                <div class="d-flex align-items-center justify-content-center py-5">
                    <div class="spinner-border text-primary me-2" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <span class="text-secondary fw-semibold">Loading data...</span>
                </div>
            }
            else
            {
                <div class="card border border-light-subtle rounded-3 overflow-auto shadow-xs" style="max-height: 65vh; background: #fff;">
                    <ul class="tree-list p-3 mb-0">
                        @foreach (var country in FilteredTreeData)
                        {
                            <li class="tree-node">
                                <div class="node-content d-flex align-items-center" @oncontextmenu="(e) => ShowCountryMenu(e, country)" @oncontextmenu:preventDefault="true">
                                    <span class="toggle-icon me-2" @onclick="() => ToggleCountry(country)">
                                        <i class="fas @(country.IsExpanded ? "fa-chevron-down" : "fa-chevron-right") text-muted" style="font-size: 0.8rem; width: 14px;"></i>
                                    </span>
                                    @{
                                        var cssClass = GetCountryFlagCssClass(country.CountryName);
                                        if (!string.IsNullOrEmpty(cssClass))
                                        {
                                            <span class="fi @cssClass me-2" style="font-size: 1.1rem; border-radius: 2px;"></span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-flag text-primary me-2"></i>
                                        }
                                    }
                                    <span class="fw-bold text-dark">@country.CountryName</span>
                                </div>
                                
                                @if (country.IsExpanded)
                                {
                                    <ul class="tree-list child-list">
                                        @foreach (var city in country.Cities)
                                        {
                                            <li class="tree-node">
                                                <div class="node-content d-flex align-items-center" @oncontextmenu="(e) => ShowCityMenu(e, city)" @oncontextmenu:preventDefault="true">
                                                    <span class="toggle-icon me-2" @onclick="() => ToggleCity(city)">
                                                        <i class="fas @(city.IsExpanded ? "fa-chevron-down" : "fa-chevron-right") text-muted" style="font-size: 0.8rem; width: 14px;"></i>
                                                    </span>
                                                    <i class="fas fa-building text-info me-2"></i>
                                                    <span class="fw-semibold text-secondary">@city.City</span>
                                                </div>
                                                
                                                @if (city.IsExpanded)
                                                {
                                                    <ul class="tree-list child-list">
                                                        @foreach (var port in city.Ports)
                                                        {
                                                            <li class="tree-node">
                                                                <div class="node-content d-flex align-items-center" @oncontextmenu="(e) => ShowPortMenu(e, port)" @oncontextmenu:preventDefault="true">
                                                                    <span class="toggle-icon me-2" style="width: 14px;"></span>
                                                                    <i class="fas fa-ship text-secondary me-2"></i>
                                                                    <span class="text-muted">@port.Port</span>
                                                                </div>
                                                            </li>
                                                        }
                                                        @if (!city.Ports.Any())
                                                        {
                                                            <li class="tree-node text-muted" style="font-style: italic; font-size: 0.85rem; padding-left: 2rem;">No ports defined.</li>
                                                        }
                                                    </ul>
                                                }
                                            </li>
                                        }
                                        @if (!country.Cities.Any())
                                        {
                                            <li class="tree-node text-muted" style="font-style: italic; font-size: 0.85rem; padding-left: 2rem;">No cities defined.</li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                        @if (!FilteredTreeData.Any())
                        {
                            <li class="text-muted text-center py-3">No data available matching your search.</li>
                        }
                    </ul>
                </div>
            }
            
            <!-- Bottom Actions -->
            <div class="mt-4 pt-3 border-top d-flex justify-content-end">
                <button type="button" class="btn btn-secondary px-4 rounded-pill shadow-sm" @onclick="NavigateToDashboard">
                    <i class="fas fa-times me-2"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Dynamic Modal for Add/Edit -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
                <div class="modal-header bg-light border-bottom-0 py-3" style="border-top-left-radius: 12px; border-top-right-radius: 12px;">
                    <h6 class="modal-title fw-bold text-dark">
                        <i class="fas @(isEditing ? "fa-edit" : "fa-plus-circle") text-primary me-2"></i>
                        @modalTitle
                    </h6>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body py-4 bg-white">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary" style="font-size:0.85rem;">Name</label>
                        <input type="text" class="form-control" @bind="modalInputText" placeholder="Enter name..." />
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-3 bg-white">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-4" @onclick="SaveRecord">
                        <i class="fas fa-save me-1"></i> Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Context Menus -->
<ContextMenu Id="countryContextMenu" UseDefaultEventHandlers="true" Template="Win11Style">
    <Item class="win11-menu-item" OnClick="@(() => AddNewCity((CountryNodeModel)context.Data))">
        <i class="fas fa-plus fa-fw win11-icon text-success"></i> Add New City
    </Item>
    <div class="win11-divider"></div>
    <Item class="win11-menu-item" OnClick="@(() => EditCountry((CountryNodeModel)context.Data))">
        <i class="fas fa-edit fa-fw win11-icon text-primary"></i> Rename Country
    </Item>
    <Item class="win11-menu-item" OnClick="@(() => ConfirmDeleteCountry((CountryNodeModel)context.Data))">
        <i class="fas fa-trash fa-fw win11-icon text-danger"></i> Delete Country
    </Item>
</ContextMenu>

<ContextMenu Id="cityContextMenu" UseDefaultEventHandlers="true" Template="Win11Style">
    <Item class="win11-menu-item" OnClick="@(() => AddNewPort((CityNodeModel)context.Data))">
        <i class="fas fa-plus fa-fw win11-icon text-success"></i> Add New Port
    </Item>
    <div class="win11-divider"></div>
    <Item class="win11-menu-item" OnClick="@(() => EditCity((CityNodeModel)context.Data))">
        <i class="fas fa-edit fa-fw win11-icon text-primary"></i> Rename City
    </Item>
    <Item class="win11-menu-item" OnClick="@(() => ConfirmDeleteCity((CityNodeModel)context.Data))">
        <i class="fas fa-trash fa-fw win11-icon text-danger"></i> Delete City
    </Item>
</ContextMenu>

<ContextMenu Id="portContextMenu" UseDefaultEventHandlers="true" Template="Win11Style">
    <Item class="win11-menu-item" OnClick="@(() => EditPort((PortNodeModel)context.Data))">
        <i class="fas fa-edit fa-fw win11-icon text-primary"></i> Rename Port
    </Item>
    <div class="win11-divider"></div>
    <Item class="win11-menu-item" OnClick="@(() => ConfirmDeletePort((PortNodeModel)context.Data))">
        <i class="fas fa-trash fa-fw win11-icon text-danger"></i> Delete Port
    </Item>
</ContextMenu>

<style>
    .tree-list { list-style-type: none; padding-left: 0; }
    .child-list { padding-left: 1.5rem; border-left: 1px dashed #dee2e6; margin-left: 0.5rem; margin-top: 0.25rem; }
    .tree-node { margin-bottom: 0.25rem; }
    .node-content { padding: 0.25rem 0.5rem; border-radius: 4px; cursor: pointer; transition: background-color 0.15s ease-in-out; }
    .node-content:hover { background-color: rgba(13, 110, 253, 0.05); }
    .toggle-icon { cursor: pointer; display: inline-block; text-align: center; }
</style>
