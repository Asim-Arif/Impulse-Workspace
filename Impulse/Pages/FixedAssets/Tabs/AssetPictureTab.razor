@using DataAccessLibrary.Models.ViewModels.FixedAssets

<div class="p-4 border rounded-3 bg-white shadow-xs text-center">
    <div class="d-inline-flex align-items-center justify-content-center p-4 bg-light rounded-circle mb-3" style="width: 100px; height: 100px;">
        <i class="fas fa-image fa-3x text-secondary opacity-50"></i>
    </div>
    <h6 class="fw-bold text-dark-emphasis mb-1">Asset Picture</h6>
    <p class="text-secondary small mb-3">Asset photograph attachments are preserved with the asset record.</p>
    <div class="alert alert-light border d-inline-block text-start small mb-0">
        <i class="fas fa-info-circle text-primary me-2"></i>
        <span>Image binding references the asset code: <strong>@(string.IsNullOrWhiteSpace(Model.AssetId) ? "Pending New Asset" : Model.AssetId)</strong></span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public FixedAssetProfileModel Model { get; set; } = null!;
    [Parameter] public bool IsDisabled { get; set; }
}

