@using DataAccessLibrary.Models.ViewModels.FixedAssets

<div class="border rounded-3 bg-white shadow-xs overflow-hidden">
    <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
            <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase;">
                <tr>
                    <th class="ps-3" style="width: 70px;">S. #</th>
                    <th style="width: 120px;">Date</th>
                    <th>Remarks</th>
                    <th style="width: 110px;">Reading</th>
                    <th style="width: 120px;">Sch. Date</th>
                    <th class="text-end" style="width: 120px;">Cost</th>
                    <th style="width: 140px;">Bill Ref.</th>
                </tr>
            </thead>
            <tbody>
                @if (RepairLogs == null || RepairLogs.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="fas fa-tools fa-2x mb-2 d-block text-secondary opacity-50"></i>
                            No repair log records found for this asset.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var row in RepairLogs)
                    {
                        <tr>
                            <td class="ps-3 text-secondary font-monospace">@row.SerialNo</td>
                            <td>@(row.Date?.ToString("dd-MMM-yyyy") ?? "-")</td>
                            <td>@row.Remarks</td>
                            <td>@row.MeterReading</td>
                            <td>@(row.ScheduleDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                            <td class="text-end fw-semibold">@row.Cost.ToString("N2")</td>
                            <td class="font-monospace small">@row.BillReference</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<FixedAssetRepairLogRow> RepairLogs { get; set; } = Array.Empty<FixedAssetRepairLogRow>();
}

