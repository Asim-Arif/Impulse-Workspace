@page "/fixedassets/dashboard"
@page "/fixed-assets/dashboard"
@attribute [Authorize]
@using DataAccessLibrary.Models.ViewModels.FixedAssets

<PageTitle>Fixed Assets Executive Dashboard - Impulse</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="fixed-assets-dashboard-wrapper">
    <!-- HERO HEADER WITH REAL-TIME BANNER -->
    <div class="dashboard-hero shadow-sm mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="hero-badge">
                    <i class="fas fa-cubes me-1"></i> Fixed Assets Management & Executive Valuation
                </div>
                <h1 class="hero-title">Fixed Assets Performance Dashboard</h1>
                <p class="hero-subtitle">
                    Live visibility into capital asset valuations, written-down values (WDV), depreciation schedules & department allocations.
                </p>
            </div>
            <div class="hero-actions d-flex flex-wrap gap-2">
                <a class="btn btn-hero-action" href="/fixedassets" title="Fixed Assets Hub"><i class="fas fa-th-large me-1"></i> Hub</a>
                <button class="btn btn-hero-action" @onclick='() => NavigateTo("/fixedassets/list")' title="Browse Asset Directory">
                    <i class="fas fa-list-check me-1"></i> Asset Catalog
                </button>
                <button class="btn btn-hero-action" @onclick='() => NavigateTo("/fixedassets/profile")' title="Register New Fixed Asset">
                    <i class="fas fa-plus-circle me-1"></i> Add Asset
                </button>
                <button class="btn btn-hero-action" @onclick='() => NavigateTo("/fixedassets/register")' title="Depreciation Register">
                    <i class="fas fa-calculator me-1"></i> Run Depreciation
                </button>
                <button class="btn btn-hero-action" @onclick='() => NavigateTo("/fixedassets/list?openAdjustment=true")' title="Cost Adjustments">
                    <i class="fas fa-sliders-h me-1"></i> Adjustments
                </button>
                <button class="btn btn-hero-action" @onclick='() => NavigateTo("/fixedassets/list?openDisposal=true")' title="Asset Disposals">
                    <i class="fas fa-trash-alt me-1"></i> Disposals
                </button>
                <button class="btn btn-hero-refresh @(IsLoading ? "disabled" : "")" @onclick="LoadDashboardDataAsync" title="Refresh Live Data">
                    <i class="fas fa-redo @(IsLoading ? "spin" : "")"></i> Refresh
                </button>
            </div>
        </div>

        <!-- QUICK FISCAL YEAR & QUARTER PILLS ON HEADER -->
        <div class="hero-fy-pills mt-3 pt-3 border-top border-secondary border-opacity-25 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="small text-white-50 fw-semibold text-uppercase"><i class="fas fa-filter me-1"></i>Fiscal Year:</span>
                <button type="button" class="btn btn-sm btn-hero-pill @(Filter.FiscalYear == "All" ? "active" : "")"
                        @onclick='() => SetFiscalYearAsync("All")'>
                    All Time
                </button>
                @foreach (var fy in Data.FiscalYears.Take(6))
                {
                    var isSelected = string.Equals(Filter.FiscalYear, fy, StringComparison.OrdinalIgnoreCase);
                    <button type="button" class="btn btn-sm btn-hero-pill @(isSelected ? "active" : "")"
                            @onclick='() => SetFiscalYearAsync(fy)'>
                        FY @fy
                    </button>
                }
            </div>
            <div class="d-flex flex-wrap align-items-center gap-1">
                <span class="small text-white-50 fw-semibold text-uppercase me-1"><i class="fas fa-history me-1"></i>Quarter:</span>
                @foreach (var q in QuarterList)
                {
                    var isSelected = Filter.QuarterIndex == q.Index;
                    <button type="button" class="btn btn-sm btn-hero-pill @(isSelected ? "active" : "")"
                            @onclick="() => SetQuarterAsync(q.Index)">
                        @q.ShortName
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- ERROR BANNER -->
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @ErrorMessage
            <button type="button" class="btn-close" @onclick='() => ErrorMessage = null'></button>
        </div>
    }

    <!-- FILTER TOOLBAR (Aligned Glass Bar) -->
    <div class="filter-card shadow-sm mb-3">
        <div class="row g-2 align-items-center">
            <div class="col-lg-3 col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-tags text-primary"></i></span>
                    <select class="form-select form-select-sm border-start-0" @bind="Filter.MasterId" @bind:after="OnFilterChangedAsync">
                        <option value="">All Categories / Masters</option>
                        @foreach (var cat in Data.LookupCategories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-sitemap text-primary"></i></span>
                    <select class="form-select form-select-sm border-start-0" @bind="Filter.DepartmentId" @bind:after="OnFilterChangedAsync">
                        <option value="">All Departments</option>
                        @foreach (var dept in Data.LookupDepartments)
                        {
                            <option value="@dept.Id">@dept.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="col-lg-2 col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-chart-line text-primary"></i></span>
                    <select class="form-select form-select-sm border-start-0" @bind="Filter.Status" @bind:after="OnFilterChangedAsync">
                        <option value="All">All Statuses</option>
                        <option value="Active">Active Only</option>
                        <option value="Disposed">Disposed Only</option>
                        <option value="Inactive">Inactive Only</option>
                    </select>
                </div>
            </div>

            <div class="col-lg-3 col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" class="form-control form-control-sm border-start-0" placeholder="Search asset name, code, location..."
                           @bind="Filter.SearchText" @bind:event="oninput" @bind:after="OnFilterChangedAsync" />
                </div>
            </div>

            <div class="col-lg-1 col-md-3 text-end">
                <button class="btn btn-sm btn-outline-secondary w-100" @onclick="ResetFilterAsync" title="Reset All Filters">
                    <i class="fas fa-undo me-1"></i>Reset
                </button>
            </div>
        </div>
    </div>

    <!-- MAIN KPI STATS CARDS (4 Executive Cards) -->
    <div class="row g-3 mb-4">
        <!-- CARD 1: GROSS BOOK VALUE -->
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-card-blue shadow-sm h-100">
                <div class="stat-card-header">
                    <span class="stat-card-title">Gross Book Value</span>
                    <div class="stat-icon-wrapper bg-blue-light">
                        <i class="fas fa-university text-primary"></i>
                    </div>
                </div>
                <div class="stat-card-body">
                    <div class="stat-card-value text-primary">Rs. @FormatShortNumber(Data.Summary.TotalGrossValue)</div>
                    <div class="stat-card-subvalue text-truncate" title="Rs. @FormatCurrency(Data.Summary.TotalGrossValue)">Rs. @FormatCurrency(Data.Summary.TotalGrossValue)</div>
                </div>
                <div class="stat-card-footer">
                    <span class="badge bg-primary-subtle text-primary fw-semibold">
                        <i class="fas fa-cube me-1"></i>@Data.Summary.TotalAssets Assets
                    </span>
                    <span class="stat-footer-text text-muted">
                        @(Data.Summary.TotalAdjustments != 0 ? $"Adj: Rs. {FormatShortNumber(Data.Summary.TotalAdjustments)}" : "Gross Cost")
                    </span>
                </div>
            </div>
        </div>

        <!-- CARD 2: ACCUMULATED DEPRECIATION -->
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-card-amber shadow-sm h-100">
                <div class="stat-card-header">
                    <span class="stat-card-title">Accumulated Depreciation</span>
                    <div class="stat-icon-wrapper bg-amber-light">
                        <i class="fas fa-arrow-trend-down-arrow text-warning"></i>
                    </div>
                </div>
                <div class="stat-card-body">
                    <div class="stat-card-value text-amber">Rs. @FormatShortNumber(Data.Summary.TotalAccumulatedDepreciation)</div>
                    <div class="stat-card-subvalue text-truncate" title="Rs. @FormatCurrency(Data.Summary.TotalAccumulatedDepreciation)">Rs. @FormatCurrency(Data.Summary.TotalAccumulatedDepreciation)</div>
                </div>
                <div class="stat-card-footer">
                    <span class="badge bg-warning-subtle text-warning-emphasis fw-semibold">
                        <i class="fas fa-percentage me-1"></i>@Data.Summary.DepreciationPercentage.ToString("0.1")% Depreciated
                    </span>
                    <span class="stat-footer-text text-muted">Lifetime Total</span>
                </div>
            </div>
        </div>

        <!-- CARD 3: NET BOOK VALUE (WDV) -->
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-card-emerald shadow-sm h-100">
                <div class="stat-card-header">
                    <span class="stat-card-title">Net Written-Down Value</span>
                    <div class="stat-icon-wrapper bg-emerald-light">
                        <i class="fas fa-shield-alt text-success"></i>
                    </div>
                </div>
                <div class="stat-card-body">
                    <div class="stat-card-value text-emerald">Rs. @FormatShortNumber(Data.Summary.TotalNetBookValue)</div>
                    <div class="stat-card-subvalue text-truncate" title="Rs. @FormatCurrency(Data.Summary.TotalNetBookValue)">Rs. @FormatCurrency(Data.Summary.TotalNetBookValue)</div>
                </div>
                <div class="stat-card-footer">
                    <span class="badge bg-success-subtle text-success fw-semibold">
                        <i class="fas fa-chart-pie me-1"></i>@((100 - Data.Summary.DepreciationPercentage).ToString("0.1"))% Value Retained
                    </span>
                    <span class="stat-footer-text text-muted">Balance Sheet WDV</span>
                </div>
            </div>
        </div>

        <!-- CARD 4: ACTIVE FLEET HEALTH -->
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-card-indigo shadow-sm h-100">
                <div class="stat-card-header">
                    <span class="stat-card-title">Active Asset Health</span>
                    <div class="stat-icon-wrapper bg-indigo-light">
                        <i class="fas fa-tachometer-alt text-indigo"></i>
                    </div>
                </div>
                <div class="stat-card-body">
                    <div class="stat-card-value text-indigo">@Data.Summary.ActiveAssets <small class="fs-6 text-muted">/ @Data.Summary.TotalAssets Active</small></div>
                    <div class="stat-card-subvalue">Active Rate: @Data.Summary.ActiveRate.ToString("0.1")%</div>
                </div>
                <div class="stat-card-footer">
                    <span class="badge bg-info-subtle text-info-emphasis fw-semibold">
                        <i class="fas fa-trash-alt me-1"></i>@Data.Summary.DisposedAssets Disposed
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary fw-semibold">
                        <i class="fas fa-pause-circle me-1"></i>@Data.Summary.InactiveAssets Inactive
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- MIDDLE ANALYTICS ROW -->
    <div class="row g-3 mb-4">
        <!-- CATEGORY DISTRIBUTION (Top Left 7 Cols) -->
        <div class="col-lg-7">
            <div class="card analytics-card shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <div>
                        <h6 class="card-title mb-0 fw-bold"><i class="fas fa-th-large text-primary me-2"></i>Asset Value by Category</h6>
                        <small class="text-muted">Breakdown of gross cost, asset counts & portfolio share</small>
                    </div>
                    <span class="badge bg-light text-dark border">@Data.Categories.Count Categories</span>
                </div>
                <div class="card-body p-3">
                    <div class="category-breakdown-list">
                        @foreach (var cat in Data.Categories.Take(8))
                        {
                            <div class="category-bar-item mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="category-indicator bg-@cat.BadgeColor"></span>
                                        <span class="fw-semibold text-dark text-truncate" style="max-width: 280px;" title="@cat.CategoryName">
                                            @cat.CategoryName
                                        </span>
                                        <span class="badge bg-light text-muted border small">@cat.AssetCount assets</span>
                                        @if (cat.DepreciationRate > 0)
                                        {
                                            <span class="badge bg-light text-secondary border small">@cat.DepreciationRate% Rate</span>
                                        }
                                    </div>
                                    <div class="text-end">
                                        <span class="fw-bold text-dark">Rs. @FormatShortNumber(cat.TotalCost)</span>
                                        <span class="text-muted small ms-1">(@cat.CostPercentage.ToString("0.1")%)</span>
                                    </div>
                                </div>
                                <div class="progress category-progress" style="height: 8px;">
                                    <div class="progress-bar bg-@cat.BadgeColor" role="progressbar" style="width: @Math.Max(3, cat.CostPercentage)%"
                                         aria-valuenow="@cat.CostPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- DEPARTMENT ALLOCATION & STATUS (Top Right 5 Cols) -->
        <div class="col-lg-5">
            <div class="card analytics-card shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <div>
                        <h6 class="card-title mb-0 fw-bold"><i class="fas fa-chart-pie text-success me-2"></i>Department Allocations</h6>
                        <small class="text-muted">Asset valuation across departments</small>
                    </div>
                    <span class="badge bg-light text-dark border">@Data.Departments.Count Depts</span>
                </div>
                <div class="card-body p-3">
                    <div class="department-list">
                        @foreach (var dept in Data.Departments.Take(6))
                        {
                            <div class="dept-row d-flex justify-content-between align-items-center py-2 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="dept-avatar">
                                        <i class="fas fa-building text-secondary"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark text-truncate" style="max-width: 180px;" title="@dept.DeptName">
                                            @dept.DeptName
                                        </div>
                                        <small class="text-muted">@dept.AssetCount Assets Assigned</small>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-dark">Rs. @FormatShortNumber(dept.TotalCost)</div>
                                    <small class="text-success fw-semibold">WDV: Rs. @FormatShortNumber(dept.NetBookValue)</small>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- FLEET STATUS MINI BAR -->
                    <div class="fleet-status-section mt-4 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold small text-uppercase text-muted">Fleet Lifecycle Status</span>
                            <span class="small text-muted">@Data.Summary.TotalAssets Total</span>
                        </div>
                        <div class="progress status-multi-progress mb-2" style="height: 12px; border-radius: 6px;">
                            @foreach (var st in Data.StatusBreakdown)
                            {
                                <div class="progress-bar @st.BadgeClass" role="progressbar" style="width: @Math.Max(2, st.Percentage)%"
                                     title="@st.StatusName: @st.Count (@st.Percentage%)"></div>
                            }
                        </div>
                        <div class="d-flex flex-wrap justify-content-between gap-2 small">
                            @foreach (var st in Data.StatusBreakdown)
                            {
                                <div class="d-flex align-items-center gap-1">
                                    <span class="status-dot" style="background-color: @st.ColorHex;"></span>
                                    <span class="text-muted">@st.StatusName:</span>
                                    <strong class="text-dark">@st.Count</strong>
                                    <span class="text-muted">(@st.Percentage%)</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- LOWER SECTION: TABBED ASSET PORTFOLIO -->
    <div class="card data-table-card shadow-sm mb-4">
        <div class="card-header bg-white p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="nav nav-pills custom-nav-pills" role="tablist">
                <button class="nav-link @(ActiveTab == "top-assets" ? "active" : "")" @onclick='() => SetActiveTab("top-assets")'>
                    <i class="fas fa-star text-warning me-1"></i> Top High-Value Assets
                </button>
                <button class="nav-link @(ActiveTab == "recent-assets" ? "active" : "")" @onclick='() => SetActiveTab("recent-assets")'>
                    <i class="fas fa-history text-primary me-1"></i> Recent Additions
                </button>
                <button class="nav-link @(ActiveTab == "disposals" ? "active" : "")" @onclick='() => SetActiveTab("disposals")'>
                    <i class="fas fa-trash-alt text-danger me-1"></i> Disposals & Salvage
                </button>
                <button class="nav-link @(ActiveTab == "category-matrix" ? "active" : "")" @onclick='() => SetActiveTab("category-matrix")'>
                    <i class="fas fa-table text-success me-1"></i> Category Matrix
                </button>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <button class="btn btn-sm btn-outline-primary" @onclick='() => NavigateTo("/fixedassets/list")'>
                    <i class="fas fa-arrow-circle-right me-1"></i> Full Assets Registry
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            <!-- TAB 1: TOP HIGH VALUE ASSETS -->
            @if (ActiveTab == "top-assets")
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 custom-dashboard-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 110px;">Asset ID</th>
                                <th>Description / Particulars</th>
                                <th>Category</th>
                                <th>Department</th>
                                <th>Location</th>
                                <th>Acquired</th>
                                <th class="text-end">Cost (Rs.)</th>
                                <th class="text-end">Acc. Dep. (Rs.)</th>
                                <th class="text-end">Net Book Value (Rs.)</th>
                                <th class="text-center" style="width: 90px;">Status</th>
                                <th class="text-center" style="width: 80px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Data.TopValueAssets.Count == 0)
                            {
                                <tr>
                                    <td colspan="11" class="text-center py-4 text-muted">
                                        <i class="fas fa-inbox fs-3 d-block mb-1"></i> No matching assets found
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in Data.TopValueAssets)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-light text-primary border fw-bold">@row.AssetId</span>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark text-truncate" style="max-width: 250px;" title="@row.Description">
                                                @row.Description
                                            </div>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@row.Category</span></td>
                                        <td><span class="text-secondary small">@row.Department</span></td>
                                        <td><span class="text-muted small">@row.Location</span></td>
                                        <td>@(row.AcquiredDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                        <td class="text-end fw-bold text-dark">@FormatCurrency(row.Cost)</td>
                                        <td class="text-end text-warning-emphasis">@FormatCurrency(row.AccumulatedDepreciation)</td>
                                        <td class="text-end fw-bold text-success">@FormatCurrency(row.BookValue)</td>
                                        <td class="text-center">
                                            @if (row.Disposed)
                                            {
                                                <span class="badge bg-danger-subtle text-danger">Disposed</span>
                                            }
                                            else if (row.InActive)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis">Inactive</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success">Active</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-xs btn-outline-primary" @onclick="() => NavigateToProfile(row.AssetId)" title="Open Asset Profile">
                                                <i class="fas fa-edit-square"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- TAB 2: RECENT ADDITIONS -->
            @if (ActiveTab == "recent-assets")
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 custom-dashboard-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 110px;">Asset ID</th>
                                <th>Description / Particulars</th>
                                <th>Category</th>
                                <th>Department</th>
                                <th>Location</th>
                                <th>Acquired Date</th>
                                <th class="text-end">Cost (Rs.)</th>
                                <th class="text-end">Net Book Value (Rs.)</th>
                                <th class="text-center" style="width: 90px;">Status</th>
                                <th class="text-center" style="width: 80px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Data.RecentAssets.Count == 0)
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-4 text-muted">
                                        <i class="fas fa-inbox fs-3 d-block mb-1"></i> No recent assets found
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in Data.RecentAssets)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-light text-primary border fw-bold">@row.AssetId</span>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark text-truncate" style="max-width: 250px;" title="@row.Description">
                                                @row.Description
                                            </div>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@row.Category</span></td>
                                        <td><span class="text-secondary small">@row.Department</span></td>
                                        <td><span class="text-muted small">@row.Location</span></td>
                                        <td>@(row.AcquiredDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                        <td class="text-end fw-bold text-dark">@FormatCurrency(row.Cost)</td>
                                        <td class="text-end fw-bold text-success">@FormatCurrency(row.BookValue)</td>
                                        <td class="text-center">
                                            @if (row.Disposed)
                                            {
                                                <span class="badge bg-danger-subtle text-danger">Disposed</span>
                                            }
                                            else if (row.InActive)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis">Inactive</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success">Active</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-xs btn-outline-primary" @onclick="() => NavigateToProfile(row.AssetId)" title="Open Asset Profile">
                                                <i class="fas fa-edit-square"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- TAB 3: DISPOSALS -->
            @if (ActiveTab == "disposals")
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 custom-dashboard-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 110px;">Asset ID</th>
                                <th>Description</th>
                                <th>Disposal Date</th>
                                <th>Disposal Type</th>
                                <th class="text-end">Original Cost (Rs.)</th>
                                <th class="text-end">Sale / Proceeds (Rs.)</th>
                                <th class="text-end">Gain / Loss (Rs.)</th>
                                <th>Buyer / Transferee</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Data.RecentDisposals.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        <i class="fas fa-check-circle fs-3 d-block mb-1 text-success"></i> No asset disposals recorded
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in Data.RecentDisposals)
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-danger border fw-bold">@row.AssetId</span></td>
                                        <td>@row.Description</td>
                                        <td>@(row.DisposalDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary">@row.DisposalType</span></td>
                                        <td class="text-end fw-semibold">@FormatCurrency(row.Cost)</td>
                                        <td class="text-end fw-bold text-dark">@FormatCurrency(row.SalePrice)</td>
                                        <td class="text-end fw-bold @(row.GainLoss >= 0 ? "text-success" : "text-danger")">
                                            @(row.GainLoss >= 0 ? "+" : "")@FormatCurrency(row.GainLoss)
                                        </td>
                                        <td><span class="text-muted">@(string.IsNullOrWhiteSpace(row.Buyer) ? "-" : row.Buyer)</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- TAB 4: CATEGORY MATRIX -->
            @if (ActiveTab == "category-matrix")
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 custom-dashboard-table">
                        <thead class="table-light">
                            <tr>
                                <th>Category / Asset Master</th>
                                <th class="text-center">Assets</th>
                                <th class="text-center">Dep. Rate</th>
                                <th class="text-end">Total Gross Cost (Rs.)</th>
                                <th class="text-end">Accumulated Dep. (Rs.)</th>
                                <th class="text-end">Net Book Value (Rs.)</th>
                                <th class="text-end">% of Portfolio</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in Data.Categories)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="category-indicator bg-@cat.BadgeColor"></span>
                                            <span class="fw-semibold text-dark">@cat.CategoryName</span>
                                        </div>
                                    </td>
                                    <td class="text-center"><span class="badge bg-light text-dark border">@cat.AssetCount</span></td>
                                    <td class="text-center">@(cat.DepreciationRate > 0 ? $"{cat.DepreciationRate}%" : "0%")</td>
                                    <td class="text-end fw-bold text-dark">@FormatCurrency(cat.TotalCost)</td>
                                    <td class="text-end text-warning-emphasis">@FormatCurrency(cat.AccumulatedDepreciation)</td>
                                    <td class="text-end fw-bold text-success">@FormatCurrency(cat.NetBookValue)</td>
                                    <td class="text-end">
                                        <div class="d-flex align-items-center justify-content-end gap-2">
                                            <div class="progress flex-grow-1" style="max-width: 60px; height: 6px;">
                                                <div class="progress-bar bg-@cat.BadgeColor" style="width: @Math.Max(4, cat.CostPercentage)%"></div>
                                            </div>
                                            <span class="small fw-semibold">@cat.CostPercentage.ToString("0.1")%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td>TOTAL PORTFOLIO</td>
                                <td class="text-center">@Data.Summary.TotalAssets</td>
                                <td class="text-center">-</td>
                                <td class="text-end">Rs. @FormatCurrency(Data.Summary.TotalGrossValue)</td>
                                <td class="text-end text-warning-emphasis">Rs. @FormatCurrency(Data.Summary.TotalAccumulatedDepreciation)</td>
                                <td class="text-end text-success">Rs. @FormatCurrency(Data.Summary.TotalNetBookValue)</td>
                                <td class="text-end">100.0%</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
</div>

<style>
    .fixed-assets-dashboard-wrapper {
        padding: 1.25rem;
        background: #f8fafc;
        min-height: 100vh;
    }

    /* HERO HEADER */
    .dashboard-hero {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border-radius: 12px;
        padding: 1.75rem 2rem;
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        background: rgba(59, 130, 246, 0.2);
        color: #93c5fd;
        border: 1px solid rgba(59, 130, 246, 0.3);
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .hero-title {
        font-size: 1.75rem;
        font-weight: 800;
        margin-bottom: 0.35rem;
        letter-spacing: -0.5px;
        color: #ffffff;
    }

    .hero-subtitle {
        color: #94a3b8;
        font-size: 0.92rem;
        margin-bottom: 0;
        max-width: 650px;
    }

    .btn-hero-action {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #ffffff;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .btn-hero-action:hover {
        background: #2563eb;
        color: #ffffff;
        border-color: #2563eb;
        transform: translateY(-1px);
    }

    .btn-hero-refresh {
        background: #3b82f6;
        border: 1px solid #3b82f6;
        color: #ffffff;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.5rem 1.1rem;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .btn-hero-refresh:hover {
        background: #1d4ed8;
        color: #ffffff;
    }

    .btn-hero-pill {
        background: rgba(255, 255, 255, 0.12);
        color: #e2e8f0;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 0.25rem 0.65rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.2s ease;
    }

    .btn-hero-pill:hover {
        background: rgba(255, 255, 255, 0.22);
        color: #ffffff;
    }

    .btn-hero-pill.active {
        background: #10b981 !important;
        color: #ffffff !important;
        border-color: #10b981 !important;
        box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);
    }

    /* FILTER CARD */
    .filter-card {
        background: #ffffff;
        border-radius: 10px;
        padding: 0.85rem 1.25rem;
        border: 1px solid #e2e8f0;
    }

    /* KPI STAT CARDS */
    .stat-card {
        background: #ffffff;
        border-radius: 12px;
        padding: 1.25rem;
        border: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.08) !important;
    }

    .stat-card-blue { border-top: 4px solid #3b82f6; }
    .stat-card-amber { border-top: 4px solid #f59e0b; }
    .stat-card-emerald { border-top: 4px solid #10b981; }
    .stat-card-indigo { border-top: 4px solid #6366f1; }

    .stat-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.6rem;
    }

    .stat-card-title {
        font-size: 0.78rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stat-icon-wrapper {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .bg-blue-light { background: #eff6ff; }
    .bg-amber-light { background: #fffbeb; }
    .bg-emerald-light { background: #ecfdf5; }
    .bg-indigo-light { background: #eef2ff; }

    .stat-card-body {
        margin-bottom: 0.6rem;
    }

    .stat-card-value {
        font-size: 1.6rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.2;
        letter-spacing: -0.5px;
    }

    .text-emerald { color: #059669 !important; }
    .text-amber { color: #d97706 !important; }
    .text-indigo { color: #4f46e5 !important; }

    .stat-card-subvalue {
        font-size: 0.78rem;
        color: #94a3b8;
        font-weight: 600;
        margin-top: 0.2rem;
    }

    .stat-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.65rem;
        border-top: 1px solid #f1f5f9;
        gap: 0.4rem;
        flex-wrap: wrap;
    }

    .stat-footer-text {
        font-size: 0.76rem;
        font-weight: 600;
    }

    /* ANALYTICS CARDS */
    .analytics-card {
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    .category-indicator {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 3px;
    }

    .category-progress {
        background-color: #f1f5f9;
        border-radius: 4px;
    }

    .dept-avatar {
        width: 34px;
        height: 34px;
        background: #f1f5f9;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .status-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    /* DATA TABLE & TABS */
    .data-table-card {
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }

    .custom-nav-pills .nav-link {
        color: #64748b;
        font-size: 0.88rem;
        font-weight: 600;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .custom-nav-pills .nav-link.active {
        background: #0f172a;
        color: #ffffff;
    }

    .custom-dashboard-table {
        font-size: 0.88rem;
    }

    .custom-dashboard-table thead th {
        font-weight: 700;
        color: #475569;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 0.75rem 1rem;
        border-bottom: 2px solid #e2e8f0;
    }

    .custom-dashboard-table tbody td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .btn-xs {
        padding: 0.2rem 0.5rem;
        font-size: 0.75rem;
        border-radius: 4px;
    }

    .spin {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        100% { transform: rotate(360deg); }
    }
</style>
