@page "/dashboards/command-center-analytics"
@page "/dashboards/command-center-visual"
@page "/dashboard/command-center-visual"
@attribute [Authorize]
@using DataAccessLibrary.Models.ViewModels.Dashboard
@using Radzen
@using Radzen.Blazor

<PageTitle>Command Center Visual Analytics | Impulse ERP</PageTitle>
<meta name="description" content="Executive Power BI Visual Analytics Command Center covering Treasury, Exports, Workforce, Multi-Tier Inventory, and Factory Bottlenecks." />

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="pbi-cc-container">

        <!-- ── Power BI Executive Cockpit Header ────────────────────────── -->
        <div class="card border-0 shadow-sm mb-3" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border-radius: 12px;">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    
                    <!-- Title & Brand -->
                    <div class="d-flex align-items-center gap-3">
                        <div style="width: 46px; height: 46px; background: linear-gradient(135deg, #005A9E 0%, #118DFF 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(0, 90, 158, 0.35);">
                            <i class="fas fa-tower-observation text-white" style="font-size: 1.35rem;"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h1 class="mb-0 fw-bold" style="font-size: 1.35rem; color: #005A9E; letter-spacing: -0.3px;">Enterprise Command Center</h1>
                                <span class="badge rounded-pill px-2 py-1" style="background: rgba(17, 141, 255, 0.12); color: #005A9E; font-size: 0.72rem; font-weight: 700; border: 1px solid rgba(17, 141, 255, 0.25);">
                                    <i class="fas fa-bolt me-1 text-warning"></i> POWER BI SUITE
                                </span>
                            </div>
                            <small class="text-muted" style="font-size: 0.78rem;">
                                Executive Cross-Functional Pulse: Treasury Liquidity, Global Exports, Workforce, Stock Valuation &amp; Shop Floor Throughput
                            </small>
                        </div>
                    </div>

                    <!-- Right Quick Actions & Sync Timestamp -->
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="d-none d-md-flex align-items-center px-2 py-1 bg-light rounded-pill border text-muted" style="font-size: 0.76rem;">
                            <i class="fas fa-satellite-dish me-1 text-success fa-beat"></i>
                            Live Sync: <strong class="text-dark ms-1">@Data.AsOfDate.ToString("dd-MMM-yyyy HH:mm")</strong>
                        </div>

                        <!-- View Mode Switcher -->
                        <div class="btn-group btn-group-sm p-1 rounded-pill bg-light border shadow-sm" role="group">
                            <button type="button" class="btn btn-sm rounded-pill px-3 @(ActiveViewMode == 0 ? "btn-primary shadow-sm" : "btn-light text-secondary")" @onclick="() => ActiveViewMode = 0">
                                <i class="fas fa-chart-pie me-1"></i> Visuals Cockpit
                            </button>
                            <button type="button" class="btn btn-sm rounded-pill px-3 @(ActiveViewMode == 1 ? "btn-primary shadow-sm" : "btn-light text-secondary")" @onclick="() => ActiveViewMode = 1">
                                <i class="fas fa-list-check me-1"></i> Executive Actions
                            </button>
                        </div>

                        <button type="button" class="btn btn-sm btn-primary fw-bold shadow-sm" @onclick="RefreshDataAsync" disabled="@IsLoading">
                            <i class="fas fa-sync-alt me-1 @(IsLoading ? "fa-spin" : "")"></i> Refresh
                        </button>
                    </div>

                </div>
            </div>
        </div>

        @if (IsLoading && !IsDataLoaded)
        {
            <!-- Skeleton Loader -->
            <div class="card border-0 shadow-sm p-5 text-center my-4" style="border-radius: 12px;">
                <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
                <h5 class="fw-bold text-dark">Aggregating Cross-Pillar ERP Intelligence...</h5>
                <p class="text-muted small">Loading live balances for Treasury, Exports, HR, Warehouse &amp; Manufacturing stations.</p>
            </div>
        }
        else
        {
            <!-- ── Top 5 Strategic Macro KPI Ribbon ────────────────────────── -->
            <div class="row g-2 mb-3">
                
                <!-- 1. Treasury & Liquidity -->
                <div class="col-12 col-sm-6 col-xl">
                    <div class="pbi-cc-kpi shadow-sm p-3 h-100" style="border-top: 4px solid #107C41 !important;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="pbi-cc-kpi-label">Net Liquid Cash</span>
                            <i class="fas fa-vault text-success fs-5"></i>
                        </div>
                        <div class="pbi-cc-kpi-val text-success">
                            PKR @((Data.Financial.NetLiquidCash / 1_000_000m).ToString("N2"))M
                        </div>
                        <div class="pbi-cc-kpi-sub d-flex justify-content-between">
                            <span>Cash: @((Data.Financial.CashInHand / 1_000m).ToString("N0"))k</span>
                            <span>Bank: @((Data.Financial.BankBalance / 1_000_000m).ToString("N2"))M</span>
                        </div>
                    </div>
                </div>

                <!-- 2. Unshipped Export Demand -->
                <div class="col-12 col-sm-6 col-xl">
                    <div class="pbi-cc-kpi shadow-sm p-3 h-100" style="border-top: 4px solid #118DFF !important;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="pbi-cc-kpi-label">In-Hand Export Demand</span>
                            <i class="fas fa-plane-departure text-primary fs-5"></i>
                        </div>
                        <div class="pbi-cc-kpi-val text-primary">
                            PKR @((Data.Export.InHandValue / 1_000_000m).ToString("N2"))M
                        </div>
                        <div class="pbi-cc-kpi-sub d-flex justify-content-between">
                            <span>@Data.Export.InHandQty.ToString("N0") Pcs</span>
                            <span class="text-primary fw-semibold">Foreign Orders</span>
                        </div>
                    </div>
                </div>

                <!-- 3. Workforce & Attendance -->
                <div class="col-12 col-sm-6 col-xl">
                    <div class="pbi-cc-kpi shadow-sm p-3 h-100" style="border-top: 4px solid #00BFA5 !important;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="pbi-cc-kpi-label">Workforce Attendance</span>
                            <i class="fas fa-users text-info fs-5"></i>
                        </div>
                        <div class="pbi-cc-kpi-val text-dark">
                            @Data.HR.AttendancePercentage% <span class="fs-6 fw-normal text-muted">Present</span>
                        </div>
                        <div class="pbi-cc-kpi-sub d-flex justify-content-between">
                            <span class="text-success fw-bold">@Data.HR.TotalPresentEmployees Active Today</span>
                            <span class="text-danger">@Data.HR.TotalAbsentEmployees Absent</span>
                        </div>
                    </div>
                </div>

                <!-- 4. Total Multi-Tier Inventory Valuation -->
                <div class="col-12 col-sm-6 col-xl">
                    <div class="pbi-cc-kpi shadow-sm p-3 h-100" style="border-top: 4px solid #EAA300 !important; cursor: pointer;"
                         @onclick='@(() => OpenStockGroupModal(0, "Finished Goods Inventory"))' title="Click to drill down into Inventory Valuation">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="pbi-cc-kpi-label">Total Inventory Asset</span>
                            <i class="fas fa-boxes-stacked text-warning fs-5"></i>
                        </div>
                        <div class="pbi-cc-kpi-val" style="color: #B78103;">
                            PKR @((Data.Stock.TotalInventoryValue / 1_000_000m).ToString("N2"))M
                        </div>
                        <div class="pbi-cc-kpi-sub d-flex justify-content-between">
                            <span>@Data.Stock.TotalInventoryQty.ToString("N0") Units</span>
                            <span class="text-warning fw-bold">4 Tiers ➔</span>
                        </div>
                    </div>
                </div>

                <!-- 5. Shop Floor WIP & Throughput -->
                <div class="col-12 col-sm-6 col-xl">
                    <div class="pbi-cc-kpi shadow-sm p-3 h-100" style="border-top: 4px solid #7B1FA2 !important;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="pbi-cc-kpi-label">Shop Floor WIP</span>
                            <i class="fas fa-industry fs-5" style="color: #7B1FA2;"></i>
                        </div>
                        <div class="pbi-cc-kpi-val" style="color: #7B1FA2;">
                            @Data.Production.RunningLotsQty.ToString("N0") <span class="fs-6 fw-normal text-muted">Pcs</span>
                        </div>
                        <div class="pbi-cc-kpi-sub d-flex justify-content-between">
                            <span>@Data.Production.RunningLotsCount Active Lots</span>
                            <span>@Data.Production.MakerOrdersCount Maker POs</span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ── Power BI Visuals Suite (View Mode 0) ─────────────────────── -->
            @if (ActiveViewMode == 0)
            {
                <div class="row g-3 mb-3">

                    <!-- VISUAL 1: Treasury & Liquidity Allocation Donut -->
                    <div class="col-12 col-xl-4 col-lg-6">
                        <div class="card border-0 shadow-sm h-100 pbi-cc-card">
                            <div class="pbi-cc-card-header d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="pbi-cc-icon-badge bg-success-subtle text-success"><i class="fas fa-coins"></i></span>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.88rem;">Treasury &amp; Liquidity Assets</h6>
                                        <small class="text-muted" style="font-size: 0.72rem;">Cash, Bank &amp; Accounts Receivable Balance</small>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-xs btn-outline-success" @onclick="PrintCashBookReport" title="Print Cash Book Report">
                                    <i class="fas fa-print me-1"></i> Cash Book
                                </button>
                            </div>
                            <div class="card-body p-3 d-flex flex-column justify-content-between" style="min-height: 270px;">
                                <div class="row align-items-center g-2 my-auto">
                                    <div class="col-6 text-center">
                                        <RadzenChart Style="height: 170px; width: 100%;">
                                            <RadzenDonutSeries Data="@FinancialAssetChartData" CategoryProperty="Category" ValueProperty="Value" Title="PKR">
                                                <TitleTemplate>
                                                    <div class="rz-donut-content text-center">
                                                        <div class="fw-bold text-dark" style="font-size: 0.85rem;">PKR @((Data.Financial.NetLiquidCash / 1_000_000m).ToString("N1"))M</div>
                                                        <div class="text-muted" style="font-size: 0.62rem;">Net Liquid</div>
                                                    </div>
                                                </TitleTemplate>
                                            </RadzenDonutSeries>
                                            <RadzenLegend Visible="false" />
                                        </RadzenChart>
                                    </div>
                                    <div class="col-6">
                                        <div class="d-flex flex-column gap-1" style="font-size: 0.75rem;">
                                            <div class="p-1 px-2 rounded bg-light border d-flex justify-content-between">
                                                <span><i class="fas fa-money-bill-wave text-success me-1"></i>Cash:</span>
                                                <strong>@((Data.Financial.CashInHand / 1_000m).ToString("N0"))k</strong>
                                            </div>
                                            <div class="p-1 px-2 rounded bg-light border d-flex justify-content-between">
                                                <span><i class="fas fa-building-columns text-primary me-1"></i>Bank:</span>
                                                <strong>PKR @((Data.Financial.BankBalance / 1_000_000m).ToString("N2"))M</strong>
                                            </div>
                                            <div class="p-1 px-2 rounded bg-light border d-flex justify-content-between">
                                                <span><i class="fas fa-hand-holding-dollar text-warning me-1"></i>Debtors:</span>
                                                <strong>PKR @((Data.Financial.AccountsReceivable / 1_000_000m).ToString("N2"))M</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Financial Obligations Bar -->
                                <div class="pt-2 border-top mt-2 d-flex justify-content-between align-items-center" style="font-size: 0.78rem;">
                                    <span class="text-muted"><i class="fas fa-file-invoice-dollar text-danger me-1"></i>Accounts Payable (Creditors):</span>
                                    <strong class="text-danger">PKR @((Data.Financial.AccountsPayable / 1_000_000m).ToString("N2"))M</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- VISUAL 2: Global Export Demand & FY Turnover Horizon -->
                    <div class="col-12 col-xl-4 col-lg-6">
                        <div class="card border-0 shadow-sm h-100 pbi-cc-card">
                            <div class="pbi-cc-card-header d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="pbi-cc-icon-badge bg-primary-subtle text-primary"><i class="fas fa-earth-americas"></i></span>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.88rem;">Global Demand &amp; Export Horizon</h6>
                                        <small class="text-muted" style="font-size: 0.72rem;">In-Hand Foreign Orders vs Realized Turnover</small>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-xs btn-outline-primary" @onclick="PrintUnshippedOrderList" title="Print Unshipped Orders">
                                    <i class="fas fa-print me-1"></i> Orders
                                </button>
                            </div>
                            <div class="card-body p-3 d-flex flex-column justify-content-between" style="min-height: 270px;">
                                
                                <div class="d-flex flex-column gap-2 my-auto">
                                    @foreach (var pt in ExportTurnoverChartData)
                                    {
                                        <div class="p-2 rounded border bg-light">
                                            <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 0.78rem;">
                                                <span class="fw-semibold text-dark">@pt.Category</span>
                                                <strong style="color: @pt.Color;">@pt.FormattedValue</strong>
                                            </div>
                                            <div class="progress" style="height: 7px; border-radius: 4px;">
                                                <div class="progress-bar" role="progressbar"
                                                     style="width: @(Math.Min(100, Math.Max(15, (pt.ValueInMillions / (ExportTurnoverChartData.Max(x => x.ValueInMillions) > 0 ? ExportTurnoverChartData.Max(x => x.ValueInMillions) : 1)) * 100)))%; background-color: @pt.Color;"></div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="pt-2 border-top mt-2 d-flex justify-content-between align-items-center" style="font-size: 0.78rem;">
                                    <span class="text-muted"><i class="fas fa-boxes-packing text-primary me-1"></i>Unshipped Volume:</span>
                                    <strong class="text-primary">@Data.Export.InHandQty.ToString("N0") Units</strong>
                                    <button type="button" class="btn btn-xs btn-link text-decoration-none p-0" @onclick="PrintTotalExportCurrentFY">
                                        <i class="fas fa-file-chart-column me-1"></i> FY Report
                                    </button>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- VISUAL 3: Workforce Velocity & Attendance Arc Gauge -->
                    <div class="col-12 col-xl-4 col-lg-6">
                        <div class="card border-0 shadow-sm h-100 pbi-cc-card">
                            <div class="pbi-cc-card-header d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="pbi-cc-icon-badge bg-info-subtle text-info"><i class="fas fa-id-badge"></i></span>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.88rem;">Human Capital &amp; Attendance</h6>
                                        <small class="text-muted" style="font-size: 0.72rem;">Today's Factory Attendance &amp; Payroll Commitment</small>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-xs btn-outline-info" @onclick="PrintAbsentSheet" title="Print Today's Absentee Sheet">
                                    <i class="fas fa-print me-1"></i> Absentees
                                </button>
                            </div>
                            <div class="card-body p-3 d-flex flex-column justify-content-between" style="min-height: 270px;">
                                
                                <div class="d-flex justify-content-center align-items-center my-auto">
                                    <RadzenArcGauge Style="width: 200px; height: 130px;">
                                        <RadzenArcGaugeScale Min="0" Max="100" StartAngle="-90" EndAngle="90" Step="25" Y="0.8" Radius="1.2">
                                            <RadzenArcGaugeScaleValue Value="@Data.HR.AttendancePercentage"
                                                                      Fill="@(Data.HR.AttendancePercentage >= 90 ? "#107C41" : (Data.HR.AttendancePercentage >= 75 ? "#EAA300" : "#E81123"))" />
                                        </RadzenArcGaugeScale>
                                    </RadzenArcGauge>
                                </div>

                                <div class="row g-1 pt-2 border-top text-center mt-2" style="font-size: 0.75rem;">
                                    <div class="col-4 border-end">
                                        <span class="text-muted d-block" style="font-size: 0.68rem;">ACTIVE STAFF</span>
                                        <strong class="text-dark">@Data.HR.TotalActiveEmployees</strong>
                                    </div>
                                    <div class="col-4 border-end">
                                        <span class="text-muted d-block" style="font-size: 0.68rem;">MONTHLY PAY</span>
                                        <strong class="text-primary">@((Data.HR.TotalMonthlyPayroll / 1_000_000m).ToString("N2"))M</strong>
                                    </div>
                                    <div class="col-4">
                                        <span class="text-muted d-block" style="font-size: 0.68rem;">LOAN BALANCES</span>
                                        <strong class="text-danger" style="cursor: pointer;" @onclick="PrintLoanBalance" title="Click to print loan balance">
                                            @(((Data.HR.LongTermLoansBalance + Data.HR.ShortTermAdvancesBalance) / 1_000m).ToString("N0"))k
                                        </strong>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- VISUAL 4A: 12-Month Export Demand Trajectory (Line Chart) -->
                    <div class="col-12 col-xl-6">
                        <div class="card border-0 shadow-sm h-100 pbi-cc-card">
                            <div class="pbi-cc-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="pbi-cc-icon-badge bg-primary-subtle text-primary"><i class="fas fa-chart-line"></i></span>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.88rem;">12-Month Export Trajectory (Line)</h6>
                                        <small class="text-muted" style="font-size: 0.72rem;">Shipment momentum &amp; trend curve</small>
                                    </div>
                                </div>

                                <!-- Trend Metric Switcher -->
                                <div class="btn-group btn-group-sm p-1 rounded-pill bg-light border shadow-sm" role="group">
                                    <button type="button" class="btn btn-xs rounded-pill px-2 @(SelectedTrendMetric == 0 ? "btn-primary shadow-sm" : "btn-light text-secondary")"
                                            @onclick="() => SelectedTrendMetric = 0">
                                        <i class="fas fa-boxes-packing me-1"></i> Volume
                                    </button>
                                    <button type="button" class="btn btn-xs rounded-pill px-2 @(SelectedTrendMetric == 1 ? "btn-primary shadow-sm" : "btn-light text-secondary")"
                                            @onclick="() => SelectedTrendMetric = 1">
                                        <i class="fas fa-file-invoice me-1"></i> Invoices
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-3">
                                @if (Data.Export.MonthlyTrend == null || !Data.Export.MonthlyTrend.Any())
                                {
                                    <div class="text-center py-4 text-muted small">No monthly shipment records found for the last 12 months.</div>
                                }
                                else
                                {
                                    <RadzenChart Style="height: 220px; width: 100%;">
                                        @if (SelectedTrendMetric == 0)
                                        {
                                            <RadzenLineSeries Data="@Data.Export.MonthlyTrend"
                                                              CategoryProperty="MonthLabel"
                                                              ValueProperty="TotalShippedQty"
                                                              Title="Shipped Volume (Pcs)"
                                                              Smooth="true"
                                                              Stroke="#118DFF"
                                                              StrokeWidth="3">
                                                <RadzenMarkers MarkerType="MarkerType.Circle" Fill="#118DFF" Size="5" />
                                            </RadzenLineSeries>
                                        }
                                        else
                                        {
                                            <RadzenLineSeries Data="@Data.Export.MonthlyTrend"
                                                              CategoryProperty="MonthLabel"
                                                              ValueProperty="InvoiceCount"
                                                              Title="Invoices Dispatched"
                                                              Smooth="true"
                                                              Stroke="#00BFA5"
                                                              StrokeWidth="3">
                                                <RadzenMarkers MarkerType="MarkerType.Square" Fill="#00BFA5" Size="5" />
                                            </RadzenLineSeries>
                                        }
                                        <RadzenCategoryAxis Padding="10">
                                            <RadzenGridLines Visible="true" Stroke="rgba(0,0,0,0.05)" />
                                        </RadzenCategoryAxis>
                                        <RadzenValueAxis>
                                            <RadzenGridLines Visible="true" Stroke="rgba(0,0,0,0.05)" />
                                        </RadzenValueAxis>
                                        <RadzenLegend Position="LegendPosition.Top" />
                                    </RadzenChart>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- VISUAL 4B: 12-Month Monthly Export Volume Distribution (Bar / Column Chart) -->
                    <div class="col-12 col-xl-6">
                        <div class="card border-0 shadow-sm h-100 pbi-cc-card">
                            <div class="pbi-cc-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="pbi-cc-icon-badge bg-info-subtle text-info"><i class="fas fa-chart-column"></i></span>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.88rem;">12-Month Export Distribution (Bar)</h6>
                                        <small class="text-muted" style="font-size: 0.72rem;">Monthly volume comparison &amp; peak delivery periods</small>
                                    </div>
                                </div>

                                <!-- Bar Metric Switcher -->
                                <div class="btn-group btn-group-sm p-1 rounded-pill bg-light border shadow-sm" role="group">
                                    <button type="button" class="btn btn-xs rounded-pill px-2 @(SelectedBarMetric == 0 ? "btn-primary shadow-sm" : "btn-light text-secondary")"
                                            @onclick="() => SelectedBarMetric = 0">
                                        <i class="fas fa-boxes-packing me-1"></i> Volume
                                    </button>
                                    <button type="button" class="btn btn-xs rounded-pill px-2 @(SelectedBarMetric == 1 ? "btn-primary shadow-sm" : "btn-light text-secondary")"
                                            @onclick="() => SelectedBarMetric = 1">
                                        <i class="fas fa-file-invoice me-1"></i> Invoices
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-3">
                                @if (Data.Export.MonthlyTrend == null || !Data.Export.MonthlyTrend.Any())
                                {
                                    <div class="text-center py-4 text-muted small">No monthly shipment records found for the last 12 months.</div>
                                }
                                else
                                {
                                    <RadzenChart Style="height: 220px; width: 100%;">
                                        @if (SelectedBarMetric == 0)
                                        {
                                            <RadzenColumnSeries Data="@Data.Export.MonthlyTrend"
                                                                CategoryProperty="MonthLabel"
                                                                ValueProperty="TotalShippedQty"
                                                                Title="Shipped Volume (Pcs)"
                                                                Fill="#005A9E" />
                                        }
                                        else
                                        {
                                            <RadzenColumnSeries Data="@Data.Export.MonthlyTrend"
                                                                CategoryProperty="MonthLabel"
                                                                ValueProperty="InvoiceCount"
                                                                Title="Invoices Dispatched"
                                                                Fill="#107C41" />
                                        }
                                        <RadzenCategoryAxis Padding="10">
                                            <RadzenGridLines Visible="true" Stroke="rgba(0,0,0,0.05)" />
                                        </RadzenCategoryAxis>
                                        <RadzenValueAxis>
                                            <RadzenGridLines Visible="true" Stroke="rgba(0,0,0,0.05)" />
                                        </RadzenValueAxis>
                                        <RadzenLegend Position="LegendPosition.Top" />
                                    </RadzenChart>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- VISUAL 5: Multi-Tier Warehouse Stock & Valuation Breakdown -->
                    <div class="col-12 col-xl-6">
                        <div class="card border-0 shadow-sm h-100 pbi-cc-card">
                            <div class="pbi-cc-card-header d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="pbi-cc-icon-badge bg-warning-subtle text-warning"><i class="fas fa-layer-group"></i></span>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.88rem;">Multi-Tier Inventory Valuation &amp; Quality Rework</h6>
                                        <small class="text-muted" style="font-size: 0.72rem;">Click any tier for interactive 2-level product group drilldown</small>
                                    </div>
                                </div>
                                <span class="badge bg-warning text-dark">
                                    Total: PKR @((Data.Stock.TotalInventoryValue / 1_000_000m).ToString("N2"))M
                                </span>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-2">
                                    @foreach (var tier in InventoryValuationChartData)
                                    {
                                        <div class="col-sm-6">
                                            <div class="p-2 rounded border bg-light pbi-hover-card"
                                                 style="cursor: pointer;"
                                                 @onclick="() => OpenStockGroupModal(tier.StockType, tier.TierName)"
                                                 title="Click to view @tier.TierName items breakdown">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="fw-bold" style="color: @tier.Color; font-size: 0.82rem;">
                                                        <i class="fas fa-cube me-1"></i>@tier.TierName
                                                    </span>
                                                    <span class="badge bg-white text-dark border" style="font-size: 0.68rem;">Drilldown ➔</span>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-baseline">
                                                    <strong class="fs-6 text-dark">@tier.FormattedValue</strong>
                                                    <span class="text-muted" style="font-size: 0.72rem;">@tier.Quantity.ToString("N0") Units</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Quality Rework Lots Warning Strip -->
                                @if (Data.Stock.TotalReWorkLots > 0)
                                {
                                    <div class="mt-2 p-2 rounded bg-danger-subtle border border-danger-subtle d-flex justify-content-between align-items-center" style="font-size: 0.78rem;">
                                        <span class="text-danger fw-bold">
                                            <i class="fas fa-triangle-exclamation me-1"></i> Quality Alert: @Data.Stock.TotalReWorkLots Rework Lots Pending (@Data.Stock.TotalReWorkQty.ToString("N0") Units)
                                        </span>
                                        <button type="button" class="btn btn-xs btn-outline-danger" @onclick="PrintReWorkLots">
                                            <i class="fas fa-print me-1"></i> Rework List
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- VISUAL 5: Shop Floor Bottleneck Stations & Subcontractor Load -->
                    <div class="col-12 col-xl-6">
                        <div class="card border-0 shadow-sm h-100 pbi-cc-card">
                            <div class="pbi-cc-card-header d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="pbi-cc-icon-badge" style="background: rgba(123, 31, 162, 0.12); color: #7B1FA2;"><i class="fas fa-industry"></i></span>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.88rem;">Manufacturing Bottleneck Stations &amp; Workload</h6>
                                        <small class="text-muted" style="font-size: 0.72rem;">Real-time queue at 4 critical manufacturing operations</small>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-xs btn-outline-dark" @onclick="() => PrintRunningLots(0)" title="Print All Running Lots">
                                    <i class="fas fa-print me-1"></i> All WIP
                                </button>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-2 mb-2">
                                    @foreach (var st in BottleneckStationsData)
                                    {
                                        <div class="col-sm-6">
                                            <div class="p-2 rounded border bg-light pbi-hover-card"
                                                 style="cursor: pointer;"
                                                 @onclick="() => PrintRunningLots(st.ProcessID)"
                                                 title="Click to print lots in @st.StationName">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="fw-bold text-dark" style="font-size: 0.8rem;">
                                                        <i class="@st.Icon me-1" style="color: @st.Color;"></i>@st.StationName
                                                    </span>
                                                    <span class="badge rounded-pill bg-primary text-white" style="font-size: 0.68rem;">@st.LotCount Lots</span>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-baseline mb-1">
                                                    <strong class="fs-6" style="color: @st.Color;">@st.Quantity.ToString("N0")</strong>
                                                    <span class="text-muted" style="font-size: 0.7rem;">@st.PercentageOfWip% of WIP</span>
                                                </div>
                                                <div class="progress" style="height: 5px;">
                                                    <div class="progress-bar" role="progressbar" style="width: @st.PercentageOfWip%; background-color: @st.Color;"></div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Subcontractor Maker & Forging Load -->
                                <div class="pt-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2" style="font-size: 0.78rem;">
                                    <div>
                                        <span class="text-muted">Maker POs:</span> <strong class="text-purple" style="color: #7B1FA2;">@Data.Production.MakerOrdersQty.ToString("N0") Pcs</strong> <small class="text-muted">(@Data.Production.MakerOrdersCount POs)</small>
                                        <button type="button" class="btn btn-xs btn-link text-decoration-none p-0 ms-1" @onclick="PrintOpenMakerOrders"><i class="fas fa-print"></i></button>
                                    </div>
                                    <div>
                                        <span class="text-muted">Forging POs:</span> <strong class="text-danger">@Data.Production.ForgingOrdersQty.ToString("N0") Pcs</strong> <small class="text-muted">(@Data.Production.ForgingOrdersCount POs)</small>
                                        <button type="button" class="btn btn-xs btn-link text-decoration-none p-0 ms-1" @onclick="PrintForgingOpenOrders"><i class="fas fa-print"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            }

            <!-- ── Executive Operations & Report Center (View Mode 1) ────────── -->
            @if (ActiveViewMode == 1)
            {
                <div class="card border-0 shadow-sm mb-3 pbi-cc-card">
                    <div class="card-header bg-white p-3 border-bottom d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-file-invoice text-primary fs-5"></i>
                            <h6 class="mb-0 fw-bold text-dark">Executive Reports &amp; Cross-Pillar Quick Audit</h6>
                        </div>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-3">
                            
                            <!-- Financial Audits -->
                            <div class="col-md-4">
                                <div class="p-3 rounded-3 border bg-light h-100">
                                    <h6 class="fw-bold text-success mb-2"><i class="fas fa-vault me-1"></i> Treasury &amp; Accounts</h6>
                                    <p class="text-muted small mb-3">Live liquidity registers, bank reconciliation, and cash flow reports.</p>
                                    <div class="d-flex flex-column gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-success text-start" @onclick="PrintCashBookReport">
                                            <i class="fas fa-print me-2"></i> Daily Cash Book Summary
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Export Audits -->
                            <div class="col-md-4">
                                <div class="p-3 rounded-3 border bg-light h-100">
                                    <h6 class="fw-bold text-primary mb-2"><i class="fas fa-plane-departure me-1"></i> Global Exports &amp; Sales</h6>
                                    <p class="text-muted small mb-3">Unshipped customer orders, shipping backlogs, and fiscal year progress.</p>
                                    <div class="d-flex flex-column gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary text-start" @onclick="PrintUnshippedOrderList">
                                            <i class="fas fa-print me-2"></i> Unshipped Export Order Backlog
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-info text-start" @onclick="PrintTotalExportCurrentFY">
                                            <i class="fas fa-print me-2"></i> Current Fiscal Year Export Turnover
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- HR & Manufacturing -->
                            <div class="col-md-4">
                                <div class="p-3 rounded-3 border bg-light h-100">
                                    <h6 class="fw-bold text-danger mb-2"><i class="fas fa-industry me-1"></i> Workforce &amp; Shop Floor</h6>
                                    <p class="text-muted small mb-3">Staff attendance registers, loan balances, and bottleneck station lots.</p>
                                    <div class="d-flex flex-column gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-danger text-start" @onclick="PrintAbsentSheet">
                                            <i class="fas fa-print me-2"></i> Today's Absent Employee Sheet
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-warning text-dark text-start" @onclick="PrintLoanBalance">
                                            <i class="fas fa-print me-2"></i> Employee Loan &amp; Advance Balances
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-dark text-start" @onclick="() => PrintRunningLots(0)">
                                            <i class="fas fa-print me-2"></i> Shop Floor Running Lots (All Stages)
                                        </button>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }

        }

    </div>
</div>

<!-- ── 2-Level Stock Group & Item Drilldown Modal ──────────────────────────── -->
@if (IsStockModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.5); z-index: 10000;" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
                <div class="modal-header py-2 px-3 bg-light border-bottom align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fas fa-boxes-stacked text-warning fs-5"></i>
                        <div>
                            <h6 class="modal-title fw-bold text-dark mb-0">@ModalStockTitle</h6>
                            <small class="text-muted">
                                @(IsShowingItemDetail ? $"Group: {SelectedGroupName} ➔ Item Level Breakdown" : "Level 1: Summary by Product Category & Group")
                            </small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-sm" @onclick="CloseStockModal"></button>
                </div>
                <div class="p-2 bg-light border-bottom d-flex align-items-center justify-content-between gap-2">
                    @if (IsShowingItemDetail)
                    {
                        <button type="button" class="btn btn-xs btn-outline-secondary" @onclick="BackToGroupSummary">
                            <i class="fas fa-arrow-left me-1"></i> Back to Categories
                        </button>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@GroupSummaries.Count Product Groups</span>
                    }
                    <div class="input-group input-group-sm" style="max-width: 260px;">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control" placeholder="Search..." @bind="ModalSearchText" @bind:event="oninput" />
                    </div>
                </div>
                <div class="modal-body p-0" style="max-height: 420px; overflow-y: auto;">
                    @if (IsModalLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <div class="text-muted small mt-2">Loading inventory valuation data...</div>
                        </div>
                    }
                    else if (!IsShowingItemDetail)
                    {
                        <!-- Level 1: Group Summary Table -->
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.86rem;">
                            <thead class="table-light text-secondary sticky-top">
                                <tr>
                                    <th>Product Category / Group</th>
                                    <th class="text-end">Available Stock</th>
                                    <th class="text-end">Valuation (PKR)</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!FilteredGroupSummary.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted small">No product groups found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var g in FilteredGroupSummary)
                                    {
                                        <tr style="cursor: pointer;" @onclick="() => DrillDownIntoGroup(g)">
                                            <td class="fw-bold text-primary"><i class="fas fa-folder-open text-warning me-2"></i>@g.GroupName</td>
                                            <td class="text-end fw-bold">@g.TotalStock.ToString("N0")</td>
                                            <td class="text-end fw-bold text-success">PKR @g.TotalValue.ToString("N0")</td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-xs btn-outline-primary">
                                                    View Items ➔
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td>Total Valuation</td>
                                    <td class="text-end">@GroupSummaries.Sum(x => x.TotalStock).ToString("N0")</td>
                                    <td class="text-end text-success">PKR @GroupSummaries.Sum(x => x.TotalValue).ToString("N0")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                    else
                    {
                        <!-- Level 2: Item Detail Table -->
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.86rem;">
                            <thead class="table-light text-secondary sticky-top">
                                <tr>
                                    <th>Article ID</th>
                                    <th>Description</th>
                                    <th class="text-end">Stock Balance</th>
                                    <th class="text-end">Total Valuation</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!FilteredItemDetails.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted small">No articles found in this category.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var itm in FilteredItemDetails)
                                    {
                                        <tr>
                                            <td class="fw-bold text-primary">@itm.ItemID</td>
                                            <td>@itm.ItemName</td>
                                            <td class="text-end fw-bold">@itm.TotalStock.ToString("N0")</td>
                                            <td class="text-end fw-bold text-success">PKR @itm.TotalValue.ToString("N0")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td colspan="2">Category Sub-Total</td>
                                    <td class="text-end">@ItemDetails.Sum(x => x.TotalStock).ToString("N0")</td>
                                    <td class="text-end text-success">PKR @ItemDetails.Sum(x => x.TotalValue).ToString("N0")</td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                </div>
                <div class="modal-footer py-2 px-3 bg-light border-top">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseStockModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    /* Power BI Command Center Canvas */
    .pbi-cc-container {
        max-width: 100%;
        margin: 0 auto;
    }

    /* KPI Cards */
    .pbi-cc-kpi {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .pbi-cc-kpi:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08) !important;
    }
    .pbi-cc-kpi-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #64748b;
        letter-spacing: 0.3px;
    }
    .pbi-cc-kpi-val {
        font-size: 1.35rem;
        font-weight: 800;
        line-height: 1.2;
        margin: 0.2rem 0;
    }
    .pbi-cc-kpi-sub {
        font-size: 0.7rem;
        color: #64748b;
    }

    /* Visual Containers */
    .pbi-cc-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
    }
    .pbi-cc-card-header {
        padding: 0.65rem 0.9rem;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }
    .pbi-cc-icon-badge {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
    }

    /* Hover Cards */
    .pbi-hover-card {
        transition: all 0.15s ease;
    }
    .pbi-hover-card:hover {
        background-color: #f1f5f9 !important;
        border-color: #cbd5e1 !important;
        transform: translateY(-1px);
    }
</style>
