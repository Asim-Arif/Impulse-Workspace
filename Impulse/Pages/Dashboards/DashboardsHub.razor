@page "/dashboards"
@page "/dashboard"
@attribute [Authorize]

@using Impulse.Shared.Components

<PageTitle>Dashboards Hub | Impulse ERP</PageTitle>

<div class="dashboard-shell">
    <div class="dashboard-hero">
        <div class="dashboard-icon-wrap" style="background: linear-gradient(135deg, #1565C0, #42A5F5); color: #ffffff;">
            <i class="fas fa-gauge-high"></i>
        </div>
        <div>
            <h1 class="dashboard-title">Dashboards &amp; Intelligence</h1>
            <p class="dashboard-subtitle">Executive analytics, demand forecasting, shop floor tracking, and capacity intelligence</p>
        </div>
    </div>

    <!-- Dashboard Module Grid -->
    <h5 class="fw-bold text-dark mb-3">All Dashboards</h5>
    <div class="dashboard-modules">
        <SecureDashCard Class="dash-card primary-featured" Href="/dashboards/executive" style="border-color: #8BAE26; background: linear-gradient(135deg, rgba(139, 174, 38, 0.12), #ffffff);">
            <i class="fas fa-chart-line" style="color: #4B6F05;"></i>
            <span class="fw-bold">Executive Dashboards</span>
            <small class="text-muted" style="font-size: 0.75rem;">Power BI Visual Suites &amp; KPIs</small>
        </SecureDashCard>

        <SecureDashCard Class="dash-card primary-featured" Href="/dashboards/command-center-analytics" style="border-color: #005A9E; background: linear-gradient(135deg, rgba(0, 90, 158, 0.08), #ffffff);">
            <i class="fas fa-tower-observation text-primary"></i>
            <span class="fw-bold">Command Center (Power BI)</span>
            <small class="text-muted" style="font-size: 0.75rem;">Executive Visual Analytics</small>
        </SecureDashCard>

        <SecureDashCard Class="dash-card" Href="/dashboards/command-center">
            <i class="fas fa-tower-control text-secondary"></i>
            <span>Command Center (Grid)</span>
            <small class="text-muted" style="font-size: 0.75rem;">Operational Metric Pulse</small>
        </SecureDashCard>

        <SecureDashCard Class="dash-card primary-featured" Href="/dashboards/production-planning-analytics" style="border-color: #118DFF; background: linear-gradient(135deg, rgba(17, 141, 255, 0.08), #ffffff);">
            <i class="fas fa-chart-pie text-primary"></i>
            <span class="fw-bold">Production Planning (Power BI)</span>
            <small class="text-muted" style="font-size: 0.75rem;">Visual Analytics &amp; WIP Series</small>
        </SecureDashCard>

        <SecureDashCard Class="dash-card primary-featured" Href="/dashboards/production-planning">
            <i class="fas fa-bullseye text-primary"></i>
            <span class="fw-bold">Production Planning (Grid)</span>
            <small class="text-muted" style="font-size: 0.75rem;">Demand &amp; Inventory Workbench</small>
        </SecureDashCard>

        <SecureDashCard Class="dash-card" Href="/production/statistics">
            <i class="fas fa-chart-pie text-info"></i>
            <span>Production Statistics</span>
            <small class="text-muted" style="font-size: 0.75rem;">Output &amp; Lots Running</small>
        </SecureDashCard>

        <SecureDashCard Class="dash-card" Href="/production/item-list">
            <i class="fas fa-layer-group text-primary"></i>
            <span>Production Item List</span>
            <small class="text-muted" style="font-size: 0.75rem;">Running Lots &amp; POs</small>
        </SecureDashCard>

        <SecureDashCard Class="dash-card" Href="/production/maker-billing-list">
            <i class="fas fa-file-invoice-dollar text-success"></i>
            <span>Maker Billing</span>
            <small class="text-muted" style="font-size: 0.75rem;">Posted Bills &amp; Vouchers</small>
        </SecureDashCard>

        <SecureDashCard Class="dash-card" Href="/production/receiving-list">
            <i class="fas fa-truck-loading text-warning"></i>
            <span>Maker Receiving</span>
            <small class="text-muted" style="font-size: 0.75rem;">Vendor Deliveries &amp; PTCs</small>
        </SecureDashCard>

        <SecureDashCard Class="dash-card" Href="/production/maker-po-list">
            <i class="fas fa-list-alt text-danger"></i>
            <span>Maker PO Tracking</span>
            <small class="text-muted" style="font-size: 0.75rem;">Vendor Issuances &amp; Auth</small>
        </SecureDashCard>
    </div>
</div>

<style>
    .dashboard-shell { padding: 2rem; max-width: 1150px; margin: 0 auto; font-family: 'Calibri', 'Segoe UI', sans-serif; }
    .dashboard-hero { display: flex; align-items: center; gap: 1.25rem; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 2px solid #e0e2ec; }
    .dashboard-icon-wrap { width: 64px; height: 64px; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; flex-shrink: 0; box-shadow: 0 4px 14px rgba(21, 101, 192, 0.25); }
    .dashboard-title { font-size: 2rem; font-weight: 700; color: #1565C0; margin: 0; line-height: 1.2; }
    .dashboard-subtitle { color: #5f6368; margin: 0.25rem 0 0; font-size: 0.95rem; }

    .featured-dash-banner {
        background: linear-gradient(135deg, rgba(21, 101, 192, 0.08), rgba(66, 165, 245, 0.15));
        border: 1px solid rgba(21, 101, 192, 0.25);
        border-radius: 20px;
        padding: 2rem;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .featured-dash-content { max-width: 650px; position: relative; z-index: 2; }
    .featured-dash-title { font-size: 1.65rem; font-weight: 700; color: #1565C0; margin-bottom: 0.6rem; }
    .featured-dash-desc { color: #3c4043; font-size: 0.95rem; line-height: 1.5; margin-bottom: 1.25rem; }
    .featured-dash-icon-bg {
        position: absolute;
        right: -20px;
        bottom: -30px;
        font-size: 11rem;
        color: rgba(21, 101, 192, 0.08);
        z-index: 1;
        pointer-events: none;
    }

    .dashboard-modules { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.2rem; }
    .dash-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1.5rem 1rem;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        border: 1px solid #dee2e6;
        border-radius: 16px;
        text-decoration: none;
        color: #1b1b1f;
        font-weight: 600;
        font-size: 0.9rem;
        text-align: center;
        transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        cursor: pointer;
    }
    .dash-card i { font-size: 1.85rem; }
    .dash-card:hover {
        background: #ffffff;
        box-shadow: 0 8px 24px rgba(21, 101, 192, 0.18);
        transform: translateY(-3px);
        text-decoration: none;
        border-color: #1565C0;
    }
    .dash-card.primary-featured {
        border-color: #1565C0;
        background: #ffffff;
        box-shadow: 0 4px 12px rgba(21, 101, 192, 0.12);
    }
</style>
