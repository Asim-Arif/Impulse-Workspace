@page "/qms/meetings/new"
@page "/qms/meetings/{Id:int}"
@attribute [Authorize]

<PageTitle>@(Id == 0 ? "New Meeting" : $"Edit Meeting: {model.Code}") - QMS</PageTitle>

@using Blazored.Typeahead
@using DataAccessLibrary.Models.QMS
@using Impulse.Components.Common

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">

            <!-- ── Top Header & Actions ── -->
            <div class="d-flex flex-wrap justify-content-between align-items-center pb-2 mb-3 border-bottom gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="fas fa-users-rectangle fa-lg"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="mb-0 fw-bold text-dark-emphasis">
                                @(Id == 0 ? "New Quality Meeting" : $"Edit Meeting: {model.Code}")
                            </h5>
                            @if (Id == 0)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">New Entry</span>
                            }
                            else
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">ID: @Id</span>
                            }
                        </div>
                        <small class="text-muted">Quality Management System Meeting Minutes, Action Items &amp; Attendees</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="NavigateBack">
                        <i class="fas fa-arrow-left me-1"></i> Back
                    </button>

                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="SaveAndNew" disabled="@isSaving">
                        <i class="fas fa-plus-circle me-1"></i> Save &amp; New
                    </button>

                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveAndClose" disabled="@isSaving">
                        <i class="fas fa-save me-1"></i>
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Save &amp; Close
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-secondary">Loading meeting details...</p>
                </div>
            }
            else
            {
                <!-- ── Navigation Tabs ── -->
                <ul class="nav nav-tabs mb-3" style="font-size: 0.9rem;">
                    <li class="nav-item">
                        <button type="button"
                                class="nav-link @(activeTab == "details" ? "active fw-bold text-primary border-bottom-0" : "text-secondary")"
                                @onclick='() => SetActiveTab("details")'>
                            <i class="fas fa-handshake me-1"></i> Meeting Details &amp; Attendees
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button"
                                class="nav-link @(activeTab == "attachments" ? "active fw-bold text-primary border-bottom-0" : "text-secondary")"
                                @onclick='() => SetActiveTab("attachments")'>
                            <i class="fas fa-paperclip me-1"></i> Attachments &amp; Documents
                            @if (attachmentCount > 0)
                            {
                                <span class="badge bg-primary rounded-pill ms-1">@attachmentCount</span>
                            }
                        </button>
                    </li>
                </ul>

                @if (activeTab == "details")
                {
                    <div class="row g-3">
                        <!-- Left Column: Meeting Master Information -->
                        <div class="col-lg-7">
                            <div class="card border rounded-3 p-3 bg-white shadow-none h-100">
                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 small text-uppercase">
                                    <i class="fas fa-info-circle text-primary me-1"></i> Meeting Details
                                </h6>

                                <div class="row g-2 mb-3">
                                    <!-- Meeting Code -->
                                    <div class="col-md-4">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Meeting Code <span class="text-danger">*</span>
                                        </label>
                                        <input type="text"
                                               class="form-control form-control-sm font-monospace fw-semibold text-primary"
                                               placeholder="e.g. 0001"
                                               @bind="model.Code" />
                                    </div>

                                    <!-- Meeting Type -->
                                    <div class="col-md-8">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Meeting Type <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-select form-select-sm" @bind="model.Type">
                                            <option value="">&lt;Select Meeting Type&gt;</option>
                                            @foreach (var mt in meetingTypes)
                                            {
                                                <option value="@mt">@mt</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="row g-2 mb-3">
                                    <!-- Date & Time -->
                                    <div class="col-md-5">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Date &amp; Time <span class="text-danger">*</span>
                                        </label>
                                        <input type="datetime-local"
                                               class="form-control form-control-sm"
                                               value="@(model.DT?.ToString("yyyy-MM-ddTHH:mm"))"
                                               @onchange="OnDateTimeChanged" />
                                    </div>

                                    <!-- Place / Venue -->
                                    <div class="col-md-4">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Place / Venue
                                        </label>
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               placeholder="e.g. Boardroom / QA Office"
                                               @bind="model.Place" />
                                    </div>

                                    <!-- Duration -->
                                    <div class="col-md-3">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Duration
                                        </label>
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               placeholder="e.g. 1 Hour"
                                               @bind="model.Duration" />
                                    </div>
                                </div>

                                <!-- Agenda -->
                                <div class="mb-3">
                                    <label class="form-label text-secondary fw-semibold small mb-1">
                                        Meeting Agenda
                                    </label>
                                    <textarea class="form-control form-control-sm"
                                              rows="3"
                                              placeholder="Enter agenda points discussed or planned for this session..."
                                              @bind="model.Agenda"></textarea>
                                </div>

                                <!-- Discussion & Action Items -->
                                <div class="mb-3">
                                    <label class="form-label text-secondary fw-semibold small mb-1">
                                        Discussion, Minutes &amp; Action Items
                                    </label>
                                    <textarea class="form-control form-control-sm"
                                              rows="4"
                                              placeholder="Record key discussion points, findings, decisions, and assigned actions..."
                                              @bind="model.Discussion"></textarea>
                                </div>

                                <!-- Keywords / Tags -->
                                <div>
                                    <label class="form-label text-secondary fw-semibold small mb-1">
                                        Keywords / Tags
                                    </label>
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           placeholder="e.g. Audit, ISO9001, Monthly Review..."
                                           @bind="model.Keywords" />
                                </div>

                            </div>
                        </div>

                        <!-- Right Column: Attendees Management -->
                        <div class="col-lg-5">
                            <div class="card border rounded-3 p-3 bg-white shadow-none h-100">
                                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-dark mb-0 small text-uppercase">
                                        <i class="fas fa-users text-primary me-1"></i> Meeting Attendees
                                    </h6>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        @model.Attendees.Count Attendee(s)
                                    </span>
                                </div>

                                <!-- Add Employee / Attendee Selector Row -->
                                <div class="row g-2 mb-3 align-items-end" style="position: relative !important; z-index: 9999 !important;">
                                    <div class="col">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Select Employee
                                        </label>
                                        <BlazoredTypeahead SearchMethod="SearchEmployees"
                                                           EnableDropDown="true"
                                                           Data="employees"
                                                           TValue="EmployeeDropdownDto"
                                                           TItem="EmployeeDropdownDto"
                                                           Value="selectedEmployee"
                                                           ValueChanged="@((EmployeeDropdownDto? emp) => OnEmployeeSelected(emp))"
                                                           ValueExpression="@(() => selectedEmployee)"
                                                           Placeholder="Select employee to add..."
                                                           MaximumSuggestions="1000">
                                            <SelectedTemplate Context="emp">
                                                @emp.DisplayText
                                            </SelectedTemplate>
                                            <ResultTemplate Context="emp">
                                                <div>
                                                    <span class="fw-bold text-dark">[@emp.EmpID]</span>
                                                    <span class="ms-1 text-secondary">@emp.Name</span>
                                                    @if (!string.IsNullOrWhiteSpace(emp.Designation))
                                                    {
                                                        <small class="text-muted ms-1">(@emp.Designation)</small>
                                                    }
                                                </div>
                                            </ResultTemplate>
                                        </BlazoredTypeahead>
                                    </div>
                                    <div class="col-auto">
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm"
                                                @onclick="AddSelectedEmployee"
                                                disabled="@(selectedEmployee == null)">
                                            <i class="fas fa-plus me-1"></i> Add
                                        </button>
                                    </div>
                                </div>

                                <!-- External / Custom Attendee Input Row -->
                                <div class="row g-2 mb-3 align-items-end">
                                    <div class="col">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Or Enter External Attendee Name
                                        </label>
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               placeholder="Type external visitor / auditor name..."
                                               @bind="customAttendeeName"
                                               @bind:event="oninput"
                                               @onkeydown="HandleCustomAttendeeKeyDown" />
                                    </div>
                                    <div class="col-auto">
                                        <button type="button"
                                                class="btn btn-outline-secondary btn-sm"
                                                @onclick="AddCustomAttendee"
                                                disabled="@(string.IsNullOrWhiteSpace(customAttendeeName))">
                                            <i class="fas fa-user-plus me-1"></i> Add Custom
                                        </button>
                                    </div>
                                </div>

                                <!-- Attendees List Table -->
                                <div class="table-responsive border rounded-3 flex-grow-1" style="max-height: 40vh; position: relative !important; z-index: 1 !important;">
                                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.85rem;">
                                        <thead class="table-light text-secondary sticky-top" style="font-size: 0.75rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                            <tr>
                                                <th style="width: 40px;" class="text-center">#</th>
                                                <th>Attendee Name</th>
                                                <th style="width: 45px;" class="text-center">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!model.Attendees.Any())
                                            {
                                                <tr>
                                                    <td colspan="3" class="text-center py-4 text-muted small">
                                                        <i class="fas fa-users-slash me-1"></i> No attendees added yet. Use the controls above to add participants.
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                for (int aIdx = 0; aIdx < model.Attendees.Count; aIdx++)
                                                {
                                                    int attendeeIndex = aIdx;
                                                    string att = model.Attendees[aIdx];
                                                    int displayNum = aIdx + 1;
                                                    <tr>
                                                        <td class="text-center text-muted small">@displayNum</td>
                                                        <td class="fw-semibold text-dark">
                                                            @att
                                                        </td>
                                                        <td class="text-center">
                                                            <button type="button"
                                                                    class="btn btn-outline-danger btn-xs"
                                                                    @onclick="@(() => RemoveAttendee(attendeeIndex))"
                                                                    title="Remove attendee">
                                                                <i class="fas fa-times"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
                                    <span>Attendees will appear in the printed meeting minutes.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (activeTab == "attachments")
                {
                    <div class="card border rounded-3 p-3 bg-white shadow-none">
                        @if (Id == 0)
                        {
                            <div class="alert alert-info d-flex align-items-center mb-0">
                                <i class="fas fa-info-circle fa-lg me-2"></i>
                                <div>
                                    <strong>Meeting must be saved first:</strong>
                                    Please save the meeting details before uploading minutes, signed attendance sheets, or presentation files.
                                </div>
                            </div>
                        }
                        else
                        {
                            <EntityAttachmentManager EntityType="QMSMeeting"
                                                     EntityId="@Id.ToString()"
                                                     Title="@($"Attachments for Meeting #{model.Code} - {model.Type}")"
                                                     OnAttachmentsChanged="LoadAttachmentCount" />
                        }
                    </div>
                }
            }

        </div>
    </div>
</div>

<style>
    .blazored-typeahead {
        height: 35px !important;
        min-height: 35px !important;
        font-size: 0.875rem !important;
        border: 1px solid #ced4da !important;
        border-radius: 0.375rem !important;
        background-color: #fff !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        display: flex !important;
        align-items: center !important;
        position: relative !important;
    }
    .blazored-typeahead:focus-within {
        border-color: #86b7fe !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
    }
    .blazored-typeahead__controls {
        height: 33px !important;
        min-height: 33px !important;
        width: 100% !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        background: transparent !important;
    }
    .blazored-typeahead__input {
        height: 31px !important;
        min-height: 31px !important;
        padding: 0 0.5rem !important;
        background: transparent !important;
        box-sizing: border-box !important;
        font-size: 0.875rem !important;
    }
    .blazored-typeahead__input-mask-wrapper {
        height: 33px !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow: hidden !important;
        background: transparent !important;
    }
    .blazored-typeahead__input-mask {
        height: 31px !important;
        line-height: 31px !important;
        display: block !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        background: transparent !important;
    }
    .blazored-typeahead__results {
        position: absolute !important;
        top: 100% !important;
        bottom: auto !important;
        left: 0 !important;
        right: auto !important;
        width: 100% !important;
        max-height: 280px !important;
        overflow-y: auto !important;
        margin-top: 2px !important;
        z-index: 10050 !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15) !important;
        border: 1px solid #ced4da !important;
        border-radius: 6px !important;
        background: #ffffff !important;
    }
    .blazored-typeahead__input-icon {
        padding: 0 0.5rem !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        cursor: pointer !important;
        height: 100% !important;
        background: transparent !important;
    }
    .blazored-typeahead__down-arrow {
        width: 11px !important;
        height: 11px !important;
        display: inline-block !important;
    }
    .blazored-typeahead__down-arrow path {
        fill: #6c757d !important;
    }
    .blazored-typeahead__input-icon:hover .blazored-typeahead__down-arrow path {
        fill: #212529 !important;
    }
    input.form-control-sm, select.form-select-sm, .input-group-text, .btn-sm {
        height: 35px !important;
    }
    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 0.75rem;
        border-radius: 4px;
    }
</style>

