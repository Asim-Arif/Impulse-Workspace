@page "/qms/meetings"
@attribute [Authorize]

<PageTitle>Quality Meetings - QMS</PageTitle>

@using BlazorContextMenu
@using DataAccessLibrary.Models.QMS
@using Impulse.Components.Common

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">

            <!-- ── Top Header & Actions ── -->
            <div class="d-flex flex-wrap justify-content-between align-items-center pb-2 mb-3 border-bottom gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="fas fa-users-rectangle fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark-emphasis">Quality Meetings</h5>
                        <small class="text-muted">Meeting Agendas, Discussions, Decisions &amp; Attendees</small>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="NavigateToHub">
                        <i class="fas fa-arrow-left me-1"></i> QMS Hub
                    </button>

                    <button type="button" class="btn btn-primary btn-sm" @onclick="NavigateToCreate">
                        <i class="fas fa-plus-circle me-1"></i> New Meeting
                    </button>
                </div>
            </div>

            <!-- ── Filter & Search Bar ── -->
            <div class="row g-2 mb-3 align-items-end" style="position: relative !important; z-index: 1000 !important;">
                <!-- Search Box -->
                <div class="col-md-4">
                    <label class="form-label text-secondary fw-semibold small mb-1">
                        <i class="fas fa-search me-1"></i> Search
                    </label>
                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="Code, type, place, agenda, attendee..."
                           value="@searchText"
                           @oninput="OnSearchInput" />
                </div>

                <!-- Meeting Type Filter -->
                <div class="col-md-3">
                    <label class="form-label text-secondary fw-semibold small mb-1">
                        <i class="fas fa-tag me-1"></i> Meeting Type
                    </label>
                    <select class="form-select form-select-sm"
                            value="@selectedType"
                            @onchange="OnTypeChanged">
                        <option value="">&lt;All Meeting Types&gt;</option>
                        @foreach (var type in meetingTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>

                <!-- Date Range Preset -->
                <div class="col-md-2">
                    <label class="form-label text-secondary fw-semibold small mb-1">
                        <i class="fas fa-calendar-alt me-1"></i> Meeting Period
                    </label>
                    <select class="form-select form-select-sm"
                            value="@selectedPeriodPreset"
                            @onchange="OnPeriodPresetChanged">
                        <option value="All">All Dates</option>
                        <option value="ThisMonth">Current Month</option>
                        <option value="Last30Days">Last 30 Days</option>
                        <option value="ThisYear">This Year</option>
                    </select>
                </div>

                <!-- Action Buttons -->
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ResetFilters" title="Reset Filters">
                        <i class="fas fa-undo me-1"></i> Reset
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="RefreshData" title="Refresh List">
                        <i class="fas fa-sync-alt @(isLoading ? "fa-spin" : "") me-1"></i> Refresh
                    </button>
                </div>
            </div>

            <!-- ── Meetings Grid ── -->
            <div class="table-responsive border rounded-3" style="max-height: 65vh; position: relative !important; z-index: 1 !important;">
                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                    <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                        <tr>
                            <th style="width: 50px;" class="text-center">#</th>
                            <th style="width: 100px;">Code</th>
                            <th style="width: 180px;">Meeting Type</th>
                            <th style="width: 160px;">Date &amp; Time</th>
                            <th style="width: 160px;">Place / Venue</th>
                            <th style="width: 100px;">Duration</th>
                            <th>Agenda / Summary</th>
                            <th style="width: 90px;" class="text-center">Attendees</th>
                            <th style="width: 75px;" class="text-center">Files</th>
                            <th style="width: 95px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                    Loading meetings...
                                </td>
                            </tr>
                        }
                        else if (meetings.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">
                                    <i class="fas fa-calendar-times fa-2x mb-2 text-secondary opacity-50 d-block"></i>
                                    No quality meetings found matching the filter criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            for (int i = 0; i < meetings.Count; i++)
                            {
                                var currentMeeting = meetings[i];
                                int displayIndex = i + 1;
                                <ContextMenuTrigger MenuId="meetingRowMenu" Data="@currentMeeting" WrapperTag="tr" class="clickable-row">
                                    <td class="text-center text-muted small">@displayIndex</td>
                                    <td>
                                        <span class="badge bg-light text-primary border font-monospace fw-semibold">
                                            @currentMeeting.Code
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info bg-opacity-10 text-dark border">
                                            @currentMeeting.Type
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark">
                                            @(currentMeeting.DT?.ToString("dd-MMM-yyyy HH:mm") ?? "-")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-secondary small">
                                            <i class="fas fa-map-marker-alt text-danger me-1"></i>
                                            @(string.IsNullOrWhiteSpace(currentMeeting.Place) ? "-" : currentMeeting.Place)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-secondary border">
                                            @(string.IsNullOrWhiteSpace(currentMeeting.Duration) ? "-" : currentMeeting.Duration)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 280px;" title="@currentMeeting.Agenda">
                                            @(string.IsNullOrWhiteSpace(currentMeeting.Agenda) ? "-" : currentMeeting.Agenda)
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(currentMeeting.AttendeeCount > 0 ? "bg-success bg-opacity-10 text-success border border-success-subtle" : "bg-light text-muted border")"
                                              title="@($"{currentMeeting.AttendeeCount} Attendees")">
                                            <i class="fas fa-users me-1"></i>@currentMeeting.AttendeeCount
                                        </span>
                                    </td>
                                    <td class="text-center" @onclick:stopPropagation="true">
                                        <button type="button"
                                                class="btn btn-xs @(currentMeeting.AttachmentCount > 0 ? "btn-outline-primary" : "btn-outline-secondary") position-relative"
                                                @onclick="@(() => OpenAttachmentModal(currentMeeting.EntryID, currentMeeting.Code ?? currentMeeting.Type ?? ""))"
                                                title="View / Manage Attachments">
                                            <i class="fas fa-paperclip"></i>
                                            @if (currentMeeting.AttachmentCount > 0)
                                            {
                                                <span class="badge bg-primary rounded-pill ms-1" style="font-size: 0.65rem;">@currentMeeting.AttachmentCount</span>
                                            }
                                        </button>
                                    </td>
                                    <td class="text-center" @onclick:stopPropagation="true">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button"
                                                    class="btn btn-outline-primary btn-xs"
                                                    @onclick="@(() => NavigateToEdit(currentMeeting.EntryID))"
                                                    title="Edit Meeting">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-outline-secondary btn-xs"
                                                    @onclick="@(() => PrintMeeting(currentMeeting.EntryID))"
                                                    title="Print Minutes">
                                                <i class="fas fa-print"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-xs"
                                                    @onclick="@(() => PromptDeleteMeeting(currentMeeting))"
                                                    title="Delete Meeting">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </ContextMenuTrigger>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- ── Status Bar ── -->
            <div class="d-flex justify-content-between align-items-center mt-2 px-1 text-secondary small">
                <span>Showing <strong>@meetings.Count</strong> meeting(s)</span>
            </div>

        </div>
    </div>
</div>

<!-- ── Row Context Menu ── -->
<ContextMenu Id="meetingRowMenu" Template="Win11Style">
    <Item class="win11-menu-item" OnClick="@((ItemClickEventArgs e) => OnContextMenuEdit(e.Data as QMSMeetingListItemModel))">
        <i class="fas fa-pencil-alt fa-fw win11-icon text-primary"></i> Edit Meeting
    </Item>
    <Item class="win11-menu-item" OnClick="@((ItemClickEventArgs e) => OnContextMenuPrint(e.Data as QMSMeetingListItemModel))">
        <i class="fas fa-print fa-fw win11-icon text-secondary"></i> Print Meeting Minutes
    </Item>
    <Item class="win11-menu-item" OnClick="@((ItemClickEventArgs e) => OnContextMenuAttachments(e.Data as QMSMeetingListItemModel))">
        <i class="fas fa-paperclip fa-fw win11-icon text-info"></i> Attachments &amp; Documents
    </Item>
    <div class="win11-divider"></div>
    <Item class="win11-menu-item" OnClick="@((ItemClickEventArgs e) => OnContextMenuDelete(e.Data as QMSMeetingListItemModel))">
        <i class="fas fa-trash fa-fw win11-icon text-danger"></i> Delete Meeting
    </Item>
</ContextMenu>

<!-- ── Attachment Quick-Access Modal ── -->
<AttachmentModal @ref="attachmentModalRef" />

<!-- ── Delete Confirmation Dialog ── -->
@if (meetingToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content shadow">
                <div class="modal-header py-2 border-bottom">
                    <h6 class="modal-title text-danger fw-bold">
                        <i class="fas fa-exclamation-triangle me-1"></i> Confirm Delete
                    </h6>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body py-3 small text-secondary">
                    Are you sure you want to delete meeting <strong class="text-dark">@meetingToDelete.Code</strong> (@meetingToDelete.Type)?
                    <div class="mt-2 text-danger">
                        <i class="fas fa-info-circle me-1"></i> This will also remove all attendee records and uploaded attachments.
                    </div>
                </div>
                <div class="modal-footer py-2 border-top">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger btn-sm" @onclick="ConfirmDelete">
                        <i class="fas fa-trash me-1"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .clickable-row:hover {
        background-color: rgba(13, 110, 253, 0.05) !important;
        cursor: pointer;
    }
    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 0.75rem;
        border-radius: 4px;
    }
    .win11-context-menu-container, .blazor-context-menu {
        max-height: 40vh !important;
        overflow-y: auto !important;
    }
    input.form-control-sm, select.form-select-sm, .btn-sm:not(.btn-xs) {
        height: 35px !important;
    }
</style>

