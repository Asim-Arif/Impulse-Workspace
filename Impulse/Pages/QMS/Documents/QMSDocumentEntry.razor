@page "/qms/documents/new"
@page "/qms/documents/{Id:int}"
@attribute [Authorize]

<PageTitle>@(Id == 0 ? "New Document" : $"Edit Document: {model.DocumentNumber}") - QMS</PageTitle>

@using Blazored.Typeahead
@using DataAccessLibrary.Models.QMS
@using Impulse.Components.Common

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">

            <!-- ── Top Header & Actions ── -->
            <div class="d-flex flex-wrap justify-content-between align-items-center pb-2 mb-3 border-bottom gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="fas fa-file-alt fa-lg"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="mb-0 fw-bold text-dark-emphasis">
                                @(Id == 0 ? "New Controlled Document" : $"Edit Document: {model.DocumentNumber}")
                            </h5>
                            @if (Id == 0)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">New Entry</span>
                            }
                            else
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">ID: @Id</span>
                            }
                        </div>
                        <small class="text-muted">Quality Management System Document Control &amp; Distribution</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="NavigateBack">
                        <i class="fas fa-arrow-left me-1"></i> Back
                    </button>

                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="SaveAndNew" disabled="@isSaving">
                        <i class="fas fa-plus-circle me-1"></i> Save &amp; New
                    </button>

                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveAndClose" disabled="@isSaving">
                        <i class="fas fa-save me-1"></i>
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Save &amp; Close
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-secondary">Loading document details...</p>
                </div>
            }
            else
            {
                <!-- ── Navigation Tabs ── -->
                <ul class="nav nav-tabs mb-3" style="font-size: 0.9rem;">
                    <li class="nav-item">
                        <button type="button"
                                class="nav-link @(activeTab == "details" ? "active fw-bold text-primary border-bottom-0" : "text-secondary")"
                                @onclick='() => SetActiveTab("details")'>
                            <i class="fas fa-info-circle me-1"></i> Document Details &amp; Distribution List
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button"
                                class="nav-link @(activeTab == "attachments" ? "active fw-bold text-primary border-bottom-0" : "text-secondary")"
                                @onclick='() => SetActiveTab("attachments")'>
                            <i class="fas fa-paperclip me-1"></i> Attachments &amp; Documents
                            @if (attachmentCount > 0)
                            {
                                <span class="badge bg-primary rounded-pill ms-1">@attachmentCount</span>
                            }
                        </button>
                    </li>
                </ul>

                @if (activeTab == "details")
                {
                    <div class="row g-3">
                        <!-- Left Column: Document Information -->
                        <div class="col-lg-6">
                            <div class="card border rounded-3 p-3 bg-white shadow-none h-100">
                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 small text-uppercase">
                                    <i class="fas fa-file-contract text-primary me-1"></i> Document Master Information
                                </h6>

                                <div class="row g-2 mb-3">
                                    <!-- Document Number -->
                                    <div class="col-md-7">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Document Number <span class="text-danger">*</span>
                                        </label>
                                        <input type="text"
                                               class="form-control form-control-sm font-monospace fw-semibold text-primary"
                                               placeholder="e.g. SOP-QMS-001"
                                               @bind="model.DocumentNumber" />
                                    </div>

                                    <!-- Revision -->
                                    <div class="col-md-5">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Revision <span class="text-danger">*</span>
                                        </label>
                                        <input type="text"
                                               class="form-control form-control-sm text-center"
                                               placeholder="e.g. 00, 01, A"
                                               @bind="model.Revision" />
                                    </div>
                                </div>

                                <!-- Document Name -->
                                <div class="mb-3">
                                    <label class="form-label text-secondary fw-semibold small mb-1">
                                        Document Name / Title <span class="text-danger">*</span>
                                    </label>
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           placeholder="Enter full document title..."
                                           @bind="model.DocumentName" />
                                </div>

                                <div class="row g-2 mb-3">
                                    <!-- Document Type -->
                                    <div class="col-md-6">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Document Type <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-select form-select-sm" @bind="model.DocumentType">
                                            <option value="">&lt;Select Type&gt;</option>
                                            @foreach (var dt in documentTypes)
                                            {
                                                <option value="@dt">@dt</option>
                                            }
                                        </select>
                                    </div>

                                    <!-- Scope -->
                                    <div class="col-md-6">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Scope
                                        </label>
                                        <select class="form-select form-select-sm"
                                                value="@(model.Internal ? 1 : 0)"
                                                @onchange="OnInternalScopeChanged">
                                            <option value="1">Internal</option>
                                            <option value="0">External</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row g-2 mb-3">
                                    <!-- Issue Date -->
                                    <div class="col-md-6">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Issue Date <span class="text-danger">*</span>
                                        </label>
                                        <input type="date"
                                               class="form-control form-control-sm"
                                               value="@(model.IssueDT?.ToString("yyyy-MM-dd"))"
                                               @onchange="OnIssueDateChanged" />
                                    </div>
                                </div>

                                <!-- Initiator Section -->
                                <div class="border rounded-2 p-2 bg-light-subtle mt-2">
                                    <label class="form-label text-secondary fw-semibold small mb-1">
                                        Initiator / Prepared By
                                    </label>
                                    <div class="mb-2">
                                        <BlazoredTypeahead SearchMethod="SearchEmployees"
                                                           EnableDropDown="true"
                                                           Data="employees"
                                                           TValue="EmployeeDropdownDto"
                                                           TItem="EmployeeDropdownDto"
                                                           Value="selectedInitiator"
                                                           ValueChanged="@((EmployeeDropdownDto? emp) => OnInitiatorSelected(emp))"
                                                           ValueExpression="@(() => selectedInitiator)"
                                                           Placeholder="Select Initiator employee..."
                                                           MaximumSuggestions="1000">
                                            <SelectedTemplate Context="emp">
                                                @emp.DisplayText
                                            </SelectedTemplate>
                                            <ResultTemplate Context="emp">
                                                <div>
                                                    <span class="fw-bold text-dark">[@emp.EmpID]</span>
                                                    <span class="ms-1 text-secondary">@emp.Name</span>
                                                    @if (!string.IsNullOrWhiteSpace(emp.Designation))
                                                    {
                                                        <small class="text-muted ms-1">(@emp.Designation)</small>
                                                    }
                                                </div>
                                            </ResultTemplate>
                                        </BlazoredTypeahead>
                                    </div>

                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label text-muted small mb-0" style="font-size: 0.75rem;">Department</label>
                                            <input type="text"
                                                   class="form-control form-control-sm bg-white"
                                                   readonly
                                                   value="@model.InitiatorDepartment"
                                                   placeholder="-" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label text-muted small mb-0" style="font-size: 0.75rem;">Designation</label>
                                            <input type="text"
                                                   class="form-control form-control-sm bg-white"
                                                   readonly
                                                   value="@model.InitiatorDesignation"
                                                   placeholder="-" />
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- Right Column: Employee Distribution List -->
                        <div class="col-lg-6">
                            <div class="card border rounded-3 p-3 bg-white shadow-none h-100">
                                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-dark mb-0 small text-uppercase">
                                        <i class="fas fa-users text-primary me-1"></i> Distribution List
                                    </h6>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        @activeDistributionCount Recipient(s)
                                    </span>
                                </div>

                                <!-- Add Employee to Distribution List Selector -->
                                <div class="row g-2 mb-3 align-items-end" style="position: relative !important; z-index: 9999 !important;">
                                    <div class="col">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Add Recipient Employee
                                        </label>
                                        <BlazoredTypeahead SearchMethod="SearchEmployees"
                                                           EnableDropDown="true"
                                                           Data="employees"
                                                           TValue="EmployeeDropdownDto"
                                                           TItem="EmployeeDropdownDto"
                                                           Value="selectedDistEmployee"
                                                           ValueChanged="@((EmployeeDropdownDto? emp) => selectedDistEmployee = emp)"
                                                           ValueExpression="@(() => selectedDistEmployee)"
                                                           Placeholder="Select employee to add..."
                                                           MaximumSuggestions="1000">
                                            <SelectedTemplate Context="emp">
                                                @emp.DisplayText
                                            </SelectedTemplate>
                                            <ResultTemplate Context="emp">
                                                <div>
                                                    <span class="fw-bold text-dark">[@emp.EmpID]</span>
                                                    <span class="ms-1 text-secondary">@emp.Name</span>
                                                    @if (!string.IsNullOrWhiteSpace(emp.Designation))
                                                    {
                                                        <small class="text-muted ms-1">(@emp.Designation)</small>
                                                    }
                                                </div>
                                            </ResultTemplate>
                                        </BlazoredTypeahead>
                                    </div>
                                    <div class="col-auto">
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm"
                                                @onclick="AddEmployeeToDistribution"
                                                disabled="@(selectedDistEmployee == null)">
                                            <i class="fas fa-user-plus me-1"></i> Add
                                        </button>
                                    </div>
                                </div>

                                <!-- Distribution List Table -->
                                <div class="table-responsive border rounded-3 flex-grow-1" style="max-height: 45vh; position: relative !important; z-index: 1 !important;">
                                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.85rem;">
                                        <thead class="table-light text-secondary sticky-top" style="font-size: 0.75rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                            <tr>
                                                <th style="width: 35px;" class="text-center">#</th>
                                                <th style="width: 75px;">Emp ID</th>
                                                <th>Employee Name</th>
                                                <th>Department</th>
                                                <th>Designation</th>
                                                <th style="width: 45px;" class="text-center">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var activeList = model.DistributionList.Where(d => !d.IsMarkedForDeletion).ToList();
                                            }
                                            @if (!activeList.Any())
                                            {
                                                <tr>
                                                    <td colspan="6" class="text-center py-4 text-muted small">
                                                        <i class="fas fa-users-slash me-1"></i> No employees in the distribution list. Use the selector above to add recipients.
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                for (int dIdx = 0; dIdx < activeList.Count; dIdx++)
                                                {
                                                    var currentItem = activeList[dIdx];
                                                    int distNum = dIdx + 1;
                                                    <tr>
                                                        <td class="text-center text-muted small">@distNum</td>
                                                        <td>
                                                            <span class="badge bg-light text-dark border font-monospace">
                                                                @currentItem.EmpID
                                                            </span>
                                                        </td>
                                                        <td class="fw-semibold text-dark">
                                                            @currentItem.EmpName
                                                        </td>
                                                        <td class="text-secondary small">
                                                            @currentItem.DeptName
                                                        </td>
                                                        <td class="text-secondary small">
                                                            @currentItem.Designation
                                                        </td>
                                                        <td class="text-center">
                                                            <button type="button"
                                                                    class="btn btn-outline-danger btn-xs"
                                                                    @onclick="@(() => RemoveEmployeeFromDistribution(currentItem))"
                                                                    title="Remove from distribution list">
                                                                <i class="fas fa-times"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
                                    <span>Added recipients will receive official document distribution copies.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (activeTab == "attachments")
                {
                    <div class="card border rounded-3 p-3 bg-white shadow-none">
                        @if (Id == 0)
                        {
                            <div class="alert alert-info d-flex align-items-center mb-0">
                                <i class="fas fa-info-circle fa-lg me-2"></i>
                                <div>
                                    <strong>Document must be saved first:</strong>
                                    Please save the document details before uploading files or attachments.
                                </div>
                            </div>
                        }
                        else
                        {
                            <EntityAttachmentManager EntityType="QMSDocument"
                                                     EntityId="@Id.ToString()"
                                                     Title="@($"Attachments for {model.DocumentNumber} - {model.DocumentName}")"
                                                     OnAttachmentsChanged="LoadAttachmentCount" />
                        }
                    </div>
                }
            }

        </div>
    </div>
</div>

<style>
    .blazored-typeahead {
        height: 35px !important;
        min-height: 35px !important;
        font-size: 0.875rem !important;
        border: 1px solid #ced4da !important;
        border-radius: 0.375rem !important;
        background-color: #fff !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        display: flex !important;
        align-items: center !important;
        position: relative !important;
    }
    .blazored-typeahead:focus-within {
        border-color: #86b7fe !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
    }
    .blazored-typeahead__controls {
        height: 33px !important;
        min-height: 33px !important;
        width: 100% !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        background: transparent !important;
    }
    .blazored-typeahead__input {
        height: 31px !important;
        min-height: 31px !important;
        padding: 0 0.5rem !important;
        background: transparent !important;
        box-sizing: border-box !important;
        font-size: 0.875rem !important;
    }
    .blazored-typeahead__input-mask-wrapper {
        height: 33px !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow: hidden !important;
        background: transparent !important;
    }
    .blazored-typeahead__input-mask {
        height: 31px !important;
        line-height: 31px !important;
        display: block !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        background: transparent !important;
    }
    .blazored-typeahead__results {
        position: absolute !important;
        top: 100% !important;
        bottom: auto !important;
        left: 0 !important;
        right: auto !important;
        width: 100% !important;
        max-height: 280px !important;
        overflow-y: auto !important;
        margin-top: 2px !important;
        z-index: 10050 !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15) !important;
        border: 1px solid #ced4da !important;
        border-radius: 6px !important;
        background: #ffffff !important;
    }
    .blazored-typeahead__input-icon {
        padding: 0 0.5rem !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        cursor: pointer !important;
        height: 100% !important;
        background: transparent !important;
    }
    .blazored-typeahead__down-arrow {
        width: 11px !important;
        height: 11px !important;
        display: inline-block !important;
    }
    .blazored-typeahead__down-arrow path {
        fill: #6c757d !important;
    }
    .blazored-typeahead__input-icon:hover .blazored-typeahead__down-arrow path {
        fill: #212529 !important;
    }
    input.form-control-sm, select.form-select-sm, .input-group-text, .btn-sm {
        height: 35px !important;
    }
    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 0.75rem;
        border-radius: 4px;
    }
</style>

