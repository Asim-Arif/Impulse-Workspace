@page "/qms/documents"
@attribute [Authorize]

<PageTitle>Document Control - QMS</PageTitle>

@using BlazorContextMenu
@using DataAccessLibrary.Models.QMS
@using Impulse.Components.Common

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">

            <!-- ── Top Header & Actions ── -->
            <div class="d-flex flex-wrap justify-content-between align-items-center pb-2 mb-3 border-bottom gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="fas fa-folder-open fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark-emphasis">Document Control</h5>
                        <small class="text-muted">Controlled Documents &amp; Employee Distribution Lists</small>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="NavigateToHub">
                        <i class="fas fa-arrow-left me-1"></i> QMS Hub
                    </button>

                    <button type="button"
                            class="btn btn-outline-primary btn-sm @(selectedCount == 0 ? "disabled" : "")"
                            @onclick="PrintSelectedDistributionList"
                            disabled="@(selectedCount == 0)">
                        <i class="fas fa-print me-1"></i> Dist. List (@selectedCount Selected)
                    </button>

                    <button type="button" class="btn btn-primary btn-sm" @onclick="NavigateToCreate">
                        <i class="fas fa-plus-circle me-1"></i> New Document
                    </button>
                </div>
            </div>

            <!-- ── Filter & Search Bar ── -->
            <div class="row g-2 mb-3 align-items-end" style="position: relative !important; z-index: 1000 !important;">
                <!-- Search Box -->
                <div class="col-md-3">
                    <label class="form-label text-secondary fw-semibold small mb-1">
                        <i class="fas fa-search me-1"></i> Search
                    </label>
                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="Doc #, title, type, initiator..."
                           value="@searchText"
                           @oninput="OnSearchInput" />
                </div>

                <!-- Document Type Filter -->
                <div class="col-md-2">
                    <label class="form-label text-secondary fw-semibold small mb-1">
                        <i class="fas fa-tag me-1"></i> Document Type
                    </label>
                    <select class="form-select form-select-sm"
                            value="@selectedDocType"
                            @onchange="OnDocTypeChanged">
                        <option value="">&lt;All Document Types&gt;</option>
                        @foreach (var type in documentTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>

                <!-- Scope Filter -->
                <div class="col-md-2">
                    <label class="form-label text-secondary fw-semibold small mb-1">
                        <i class="fas fa-globe me-1"></i> Scope
                    </label>
                    <select class="form-select form-select-sm"
                            value="@selectedInternalFilter"
                            @onchange="OnScopeFilterChanged">
                        <option value="-1">&lt;All Scopes&gt;</option>
                        <option value="1">Internal</option>
                        <option value="0">External</option>
                    </select>
                </div>

                <!-- Date Range Preset -->
                <div class="col-md-2">
                    <label class="form-label text-secondary fw-semibold small mb-1">
                        <i class="fas fa-calendar-alt me-1"></i> Issue Period
                    </label>
                    <select class="form-select form-select-sm"
                            value="@selectedPeriodPreset"
                            @onchange="OnPeriodPresetChanged">
                        <option value="All">All Dates</option>
                        <option value="ThisMonth">Current Month</option>
                        <option value="Last30Days">Last 30 Days</option>
                        <option value="ThisYear">This Year</option>
                    </select>
                </div>

                <!-- Action / Reset Buttons -->
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ResetFilters" title="Reset Filters">
                        <i class="fas fa-undo me-1"></i> Reset
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="RefreshData" title="Refresh List">
                        <i class="fas fa-sync-alt @(isLoading ? "fa-spin" : "") me-1"></i> Refresh
                    </button>
                </div>
            </div>

            <!-- ── Document Grid ── -->
            <div class="table-responsive border rounded-3" style="max-height: 65vh; position: relative !important; z-index: 1 !important;">
                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                    <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                        <tr>
                            <th class="text-center" style="width: 40px;">
                                <input type="checkbox"
                                       class="form-check-input"
                                       checked="@isAllSelected"
                                       @onchange="ToggleSelectAll" />
                            </th>
                            <th style="width: 45px;" class="text-center">#</th>
                            <th style="width: 140px;">Doc Number</th>
                            <th>Document Name</th>
                            <th style="width: 70px;" class="text-center">Rev</th>
                            <th style="width: 130px;">Type</th>
                            <th style="width: 85px;" class="text-center">Scope</th>
                            <th style="width: 105px;">Issue Date</th>
                            <th style="width: 180px;">Initiator</th>
                            <th style="width: 80px;" class="text-center">Dist. List</th>
                            <th style="width: 75px;" class="text-center">Files</th>
                            <th style="width: 90px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="12" class="text-center py-4 text-muted">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                    Loading documents...
                                </td>
                            </tr>
                        }
                        else if (documents.Count == 0)
                        {
                            <tr>
                                <td colspan="12" class="text-center py-4 text-muted">
                                    <i class="fas fa-folder-open fa-2x mb-2 text-secondary opacity-50 d-block"></i>
                                    No documents found matching the filter criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            for (int i = 0; i < documents.Count; i++)
                            {
                                var currentDoc = documents[i];
                                int displayIndex = i + 1;
                                <ContextMenuTrigger MenuId="docRowMenu" Data="@currentDoc" WrapperTag="tr" class="clickable-row">
                                    <td class="text-center" @onclick:stopPropagation="true">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               checked="@currentDoc.IsSelected"
                                               @onchange="@((ChangeEventArgs e) => ToggleRowSelection(currentDoc, e))" />
                                    </td>
                                    <td class="text-center text-muted small">@displayIndex</td>
                                    <td>
                                        <span class="badge bg-light text-primary border font-monospace fw-semibold">
                                            @currentDoc.DocumentNumber
                                        </span>
                                    </td>
                                    <td class="fw-semibold text-dark">
                                        @currentDoc.DocumentName
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border">
                                            @(string.IsNullOrWhiteSpace(currentDoc.Revision) ? "-" : currentDoc.Revision)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info bg-opacity-10 text-dark border">
                                            @currentDoc.DocumentType
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (currentDoc.Internal == true)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                Internal
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                                External
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @(currentDoc.IssueDT?.ToString("dd-MMM-yyyy") ?? "-")
                                    </td>
                                    <td>
                                        <small class="d-block text-truncate" style="max-width: 170px;" title="@currentDoc.InitiatorName">
                                            @if (!string.IsNullOrWhiteSpace(currentDoc.InitiaterEmpID))
                                            {
                                                <span class="fw-bold text-muted">[@currentDoc.InitiaterEmpID]</span>
                                            }
                                            @currentDoc.InitiatorName
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(currentDoc.DistributionCount > 0 ? "bg-success bg-opacity-10 text-success border border-success-subtle" : "bg-light text-muted border")"
                                              title="@($"{currentDoc.DistributionCount} Employees in Distribution List")">
                                            <i class="fas fa-users me-1"></i>@currentDoc.DistributionCount
                                        </span>
                                    </td>
                                    <td class="text-center" @onclick:stopPropagation="true">
                                        <button type="button"
                                                class="btn btn-xs @(currentDoc.AttachmentCount > 0 ? "btn-outline-primary" : "btn-outline-secondary") position-relative"
                                                @onclick="@(() => OpenAttachmentModal(currentDoc.EntryID, currentDoc.DocumentName ?? currentDoc.DocumentNumber ?? ""))"
                                                title="View / Manage Attachments">
                                            <i class="fas fa-paperclip"></i>
                                            @if (currentDoc.AttachmentCount > 0)
                                            {
                                                <span class="badge bg-primary rounded-pill ms-1" style="font-size: 0.65rem;">@currentDoc.AttachmentCount</span>
                                            }
                                        </button>
                                    </td>
                                    <td class="text-center" @onclick:stopPropagation="true">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button"
                                                    class="btn btn-outline-primary btn-xs"
                                                    @onclick="@(() => NavigateToEdit(currentDoc.EntryID))"
                                                    title="Edit Document">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-xs"
                                                    @onclick="@(() => PromptDeleteDocument(currentDoc))"
                                                    title="Delete Document">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </ContextMenuTrigger>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- ── Status Bar ── -->
            <div class="d-flex justify-content-between align-items-center mt-2 px-1 text-secondary small">
                <span>Showing <strong>@documents.Count</strong> document(s)</span>
                @if (selectedCount > 0)
                {
                    <span class="text-primary fw-semibold">
                        <i class="fas fa-check-square me-1"></i> @selectedCount document(s) selected for distribution list printing
                    </span>
                }
            </div>

        </div>
    </div>
</div>

<!-- ── Row Context Menu ── -->
<ContextMenu Id="docRowMenu" Template="Win11Style">
    <Item class="win11-menu-item" OnClick="@((ItemClickEventArgs e) => OnContextMenuEdit(e.Data as QMSDocumentListItemModel))">
        <i class="fas fa-pencil-alt fa-fw win11-icon text-primary"></i> Edit Document
    </Item>
    <Item class="win11-menu-item" OnClick="@((ItemClickEventArgs e) => OnContextMenuPrintDist(e.Data as QMSDocumentListItemModel))">
        <i class="fas fa-print fa-fw win11-icon text-secondary"></i> Print Distribution List
    </Item>
    <Item class="win11-menu-item" OnClick="@((ItemClickEventArgs e) => OnContextMenuAttachments(e.Data as QMSDocumentListItemModel))">
        <i class="fas fa-paperclip fa-fw win11-icon text-info"></i> Attachments &amp; Documents
    </Item>
    <div class="win11-divider"></div>
    <Item class="win11-menu-item" OnClick="@((ItemClickEventArgs e) => OnContextMenuDelete(e.Data as QMSDocumentListItemModel))">
        <i class="fas fa-trash fa-fw win11-icon text-danger"></i> Delete Document
    </Item>
</ContextMenu>

<!-- ── Attachment Quick-Access Modal ── -->
<AttachmentModal @ref="attachmentModalRef" />

<!-- ── Delete Confirmation Dialog ── -->
@if (documentToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content shadow">
                <div class="modal-header py-2 border-bottom">
                    <h6 class="modal-title text-danger fw-bold">
                        <i class="fas fa-exclamation-triangle me-1"></i> Confirm Delete
                    </h6>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body py-3 small text-secondary">
                    Are you sure you want to delete document <strong class="text-dark">@documentToDelete.DocumentNumber</strong> (@documentToDelete.DocumentName)?
                    <div class="mt-2 text-danger">
                        <i class="fas fa-info-circle me-1"></i> This will also remove its distribution list and attachments.
                    </div>
                </div>
                <div class="modal-footer py-2 border-top">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger btn-sm" @onclick="ConfirmDelete">
                        <i class="fas fa-trash me-1"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .clickable-row:hover {
        background-color: rgba(13, 110, 253, 0.05) !important;
        cursor: pointer;
    }
    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 0.75rem;
        border-radius: 4px;
    }
    .win11-context-menu-container, .blazor-context-menu {
        max-height: 40vh !important;
        overflow-y: auto !important;
    }
    input.form-control-sm, select.form-select-sm, .btn-sm:not(.btn-xs) {
        height: 35px !important;
    }
</style>

