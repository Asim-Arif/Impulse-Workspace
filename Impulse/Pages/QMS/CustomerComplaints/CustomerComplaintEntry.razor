@page "/qms/customer-complaint/new"
@page "/qms/customer-complaint/{Id:int}"
@attribute [Authorize]

@using DataAccessLibrary.Models.QMS
@using Impulse.Components.Common
@using Blazored.Typeahead

<PageTitle>@(IsEditMode ? $"Edit Complaint - {model.ComplaintNo}" : "New Customer Complaint")</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body pt-3">

            <!-- ── Top Header Toolbar ── -->
            <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center">
                    <button type="button" class="btn btn-outline-secondary btn-sm me-3" @onclick="Cancel" title="Go Back">
                        <i class="fas fa-arrow-left"></i>
                    </button>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark-emphasis">
                            <i class="fas @(IsEditMode ? "fa-edit text-primary" : "fa-plus-circle text-success") me-2"></i>
                            @(IsEditMode ? $"Edit Customer Complaint: {model.ComplaintNo}" : "New Customer Complaint")
                        </h5>
                        <small class="text-secondary">QMS Command Center &bull; Customer Complaint Logging</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-primary btn-sm px-3" @onclick="() => SaveComplaint(false)" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="fas fa-save me-1"></i>
                            <span>Save &amp; Close</span>
                        }
                    </button>
                    @if (!IsEditMode)
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm px-3" @onclick="() => SaveComplaint(true)" disabled="@isSaving">
                            <i class="fas fa-plus me-1"></i> Save &amp; New
                        </button>
                    }
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" @onclick="Cancel" disabled="@isSaving">
                        <i class="fas fa-times me-1"></i> Cancel
                    </button>
                </div>
            </div>

            <!-- ── MD3 Navigation Tabs ── -->
            <ul class="nav nav-tabs mb-3" style="font-size: 0.9rem;">
                <li class="nav-item">
                    <button type="button" class="nav-link @(activeTab == "details" ? "active fw-bold text-primary" : "text-secondary")"
                            @onclick='() => SetActiveTab("details")'>
                        <i class="fas fa-file-invoice me-2"></i> Complaint &amp; Items
                        @if (model.Details.Count(d => !d.IsDeleted) > 0)
                        {
                            <span class="badge bg-primary-subtle text-primary rounded-pill ms-2">
                                @model.Details.Count(d => !d.IsDeleted)
                            </span>
                        }
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link @(activeTab == "attachments" ? "active fw-bold text-primary" : "text-secondary")"
                            @onclick='() => SetActiveTab("attachments")'>
                        <i class="fas fa-paperclip me-2"></i> Attachments &amp; Documents
                        @if (IsEditMode && attachmentCount > 0)
                        {
                            <span class="badge bg-success-subtle text-success rounded-pill ms-2">@attachmentCount</span>
                        }
                    </button>
                </li>
            </ul>

            <!-- ── TAB 1: COMPLAINT & ITEMS ── -->
            @if (activeTab == "details")
            {
                @if (isLoading)
                {
                    <div class="d-flex align-items-center justify-content-center py-5">
                        <div class="spinner-border text-primary me-2" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <span class="text-secondary fw-semibold">Loading complaint details...</span>
                    </div>
                }
                else
                {
                    <!-- Master Details Card -->
                    <div class="card border rounded-3 mb-3 bg-light-subtle">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-secondary mb-3 pb-1 border-bottom" style="font-size: 0.85rem; text-transform: uppercase;">
                                <i class="fas fa-info-circle me-1 text-primary"></i> Complaint Information
                            </h6>

                            <!-- Row 1: Company, Customer, Country, Complaint No, Date -->
                            <div class="row g-2 mb-2" style="position: relative !important; z-index: 9999 !important;">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Company</label>
                                    <select class="form-select form-select-sm" @bind="model.Company_RefID">
                                        @foreach (var c in companies)
                                        {
                                            <option value="@c.EntryID">@c.CompanyName</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                                        Customer <span class="text-danger">*</span>
                                    </label>
                                    <BlazoredTypeahead SearchMethod="SearchCustomers"
                                                       EnableDropDown="true"
                                                       Data="customerList"
                                                       TValue="string"
                                                       TItem="string"
                                                       Value="model.CustCode"
                                                       ValueChanged="OnCustomerChanged"
                                                       ValueExpression="@(() => model.CustCode)"
                                                       Placeholder="Select Customer"
                                                       MaximumSuggestions="1000">
                                        <SelectedTemplate Context="cust">@cust</SelectedTemplate>
                                        <ResultTemplate Context="cust">@cust</ResultTemplate>
                                    </BlazoredTypeahead>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Country</label>
                                    <input type="text" class="form-control form-control-sm" @bind="model.Country" placeholder="Country" />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                                        Complaint # <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control form-control-sm font-monospace fw-bold text-primary" @bind="model.ComplaintNo" />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                                        Date <span class="text-danger">*</span>
                                    </label>
                                    <input type="date" class="form-control form-control-sm"
                                           value="@model.DT?.ToString("yyyy-MM-dd")"
                                           @onchange="OnComplaintDateChanged" />
                                </div>
                            </div>

                            <!-- Row 2: Department, Lodged By, Designation, Penalty, Qty, Amount, Currency -->
                            <div class="row g-2 mb-2">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                                        Unit / Department <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select form-select-sm" value="@model.Unit" @onchange="OnDepartmentChanged">
                                        <option value="">&lt;Select Department&gt;</option>
                                        @foreach (var d in departments)
                                        {
                                            <option value="@d.DeptID">@d.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Complaint Lodged By</label>
                                    <input type="text" class="form-control form-control-sm" @bind="model.ComplaintBy" placeholder="Contact person" />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Designation</label>
                                    <input type="text" class="form-control form-control-sm" @bind="model.Designation" placeholder="Designation" />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Penalty</label>
                                    <select class="form-select form-select-sm" value="@model.Penalty" @onchange="OnPenaltyChanged">
                                        <option value="0">None</option>
                                        <option value="1">Free Placement</option>
                                        <option value="2">Credit Note</option>
                                        <option value="3">Investigation</option>
                                    </select>
                                </div>

                                <div class="col-md-1">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Penalty Qty</label>
                                    <input type="number" class="form-control form-control-sm text-end"
                                           @bind="model.PenaltyQty"
                                           disabled="@(model.Penalty != 1)" />
                                </div>

                                <div class="col-md-1">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Penalty Amt</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                           @bind="model.PenaltyAmount"
                                           disabled="@(model.Penalty != 2)" />
                                </div>

                                <div class="col-md-1">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Currency</label>
                                    <input type="text" class="form-control form-control-sm"
                                           @bind="model.PenaltyCurrency"
                                           placeholder="USD"
                                           disabled="@(model.Penalty != 2)" />
                                </div>
                            </div>

                            <!-- Row 3: Email Notification (To & Cc) -->
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Email Notification: To</label>
                                    <select class="form-select form-select-sm" @bind="model.EmailTo">
                                        <option value="">&lt;Select Employee&gt;</option>
                                        @foreach (var emp in employeesByDept)
                                        {
                                            <option value="@emp.EmpID">@emp.DisplayName</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Email Notification: Cc</label>
                                    <select class="form-select form-select-sm" @bind="model.EmailCc">
                                        <option value="">&lt;Select Employee&gt;</option>
                                        @foreach (var emp in employeesByDept)
                                        {
                                            <option value="@emp.EmpID">@emp.DisplayName</option>
                                        }
                                    </select>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Defective Items Grid Card -->
                    <div class="card border rounded-3 shadow-xs">
                        <div class="card-header bg-light py-2 px-3 d-flex align-items-center justify-content-between">
                            <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.9rem;">
                                <i class="fas fa-boxes-stacked me-2 text-danger"></i> Defective Products &amp; Items
                            </h6>
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill">
                                @(model.Details.Count(d => !d.IsDeleted)) Item(s)
                            </span>
                        </div>

                        <div class="card-body p-3">
                            <!-- New Line Entry Bar -->
                            <div class="p-2 mb-3 bg-light rounded border border-light-subtle">
                                <div class="row g-2 align-items-end" style="position: relative !important; z-index: 9998 !important;">
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.78rem;">Invoice #</label>
                                        <select class="form-select form-select-sm" value="@newDetailInvoice" @onchange="OnInvoiceSelectionChanged">
                                            <option value="<All Items>">&lt;All Items&gt;</option>
                                            @foreach (var inv in invoiceList)
                                            {
                                                <option value="@inv">@inv</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.78rem;">Product / Item</label>
                                        <BlazoredTypeahead SearchMethod="SearchInvoiceItems"
                                                           EnableDropDown="true"
                                                           Data="invoiceItems"
                                                           TValue="InvoiceItemLookupDto"
                                                           TItem="InvoiceItemLookupDto"
                                                           Value="selectedInvoiceItem"
                                                           ValueChanged="OnInvoiceItemChanged"
                                                           ValueExpression="@(() => selectedInvoiceItem)"
                                                           Placeholder="Select Item"
                                                           MaximumSuggestions="1000">
                                            <SelectedTemplate Context="itm">@itm.DisplayName</SelectedTemplate>
                                            <ResultTemplate Context="itm">@itm.DisplayName</ResultTemplate>
                                        </BlazoredTypeahead>
                                    </div>

                                    <div class="col-md-1">
                                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.78rem;">Qty</label>
                                        <input type="number" class="form-control form-control-sm text-end" @bind="newDetailQty" min="1" />
                                    </div>

                                    <div class="col-md-2">
                                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.78rem;">QMS Reason</label>
                                        <select class="form-select form-select-sm" @bind="newDetailReasonMain">
                                            <option value="">&lt;Select Reason&gt;</option>
                                            @foreach (var r in qmsReasons)
                                            {
                                                <option value="@r.Reason_QMS">@r.Reason_QMS</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="col-md-2">
                                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.78rem;">Lot / Reference</label>
                                        @if (availableLots.Count > 0)
                                        {
                                            <select class="form-select form-select-sm" @bind="newDetailLotRef">
                                                <option value="">&lt;Select Lot&gt;</option>
                                                @foreach (var lot in availableLots)
                                                {
                                                    <option value="@lot">@lot</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <input type="text" class="form-control form-control-sm" @bind="newDetailLotRef" placeholder="Lot / Ref" />
                                        }
                                    </div>

                                    <div class="col-md-2">
                                        <button type="button" class="btn btn-success btn-sm w-100" @onclick="AddDetailLine">
                                            <i class="fas fa-plus me-1"></i> Add Line
                                        </button>
                                    </div>
                                </div>

                                <!-- Reason Details Row -->
                                <div class="row g-2 mt-1">
                                    <div class="col-12">
                                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.78rem;">Detailed Problem Description / Remarks</label>
                                        <input type="text" class="form-control form-control-sm"
                                               @bind="newDetailReason"
                                               placeholder="Enter detailed defect description..." />
                                    </div>
                                </div>
                            </div>

                            <!-- Detail Items Table -->
                            <div class="table-responsive rounded border" style="max-height: 38vh; overflow-y: auto;">
                                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.85rem;">
                                    <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 1;">
                                        <tr>
                                            <th class="ps-3" style="width: 140px;">Invoice #</th>
                                            <th>Product / Item</th>
                                            <th class="text-end" style="width: 90px;">Qty</th>
                                            <th>QMS Reason</th>
                                            <th>Lot / Ref</th>
                                            <th>Problem Description</th>
                                            <th class="text-center" style="width: 70px;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!model.Details.Any(d => !d.IsDeleted))
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center py-4 text-muted">
                                                    <i class="fas fa-box-open fa-2x mb-2 text-secondary opacity-50"></i>
                                                    <div>No items added yet. Use the bar above to add defective items.</div>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var detail in model.Details.Where(d => !d.IsDeleted))
                                            {
                                                <tr>
                                                    <td class="ps-3 fw-semibold text-secondary">@(!string.IsNullOrEmpty(detail.InvoiceNo) ? detail.InvoiceNo : "<All Items>")</td>
                                                    <td class="fw-bold text-dark">
                                                        @detail.ItemID
                                                        @if (!string.IsNullOrEmpty(detail.ItemCode) && detail.ItemCode != detail.ItemID)
                                                        {
                                                            <small class="text-muted ms-1">(@detail.ItemCode)</small>
                                                        }
                                                    </td>
                                                    <td class="text-end fw-bold text-danger">@detail.Qty</td>
                                                    <td>
                                                        <span class="badge bg-warning-subtle text-warning-emphasis border">@detail.ItemReason_Main</span>
                                                    </td>
                                                    <td class="font-monospace text-secondary">@(detail.EmailReference ?? "-")</td>
                                                    <td>@detail.ItemReason</td>
                                                    <td class="text-center">
                                                        <button type="button" class="btn btn-outline-danger btn-xs py-0 px-2"
                                                                @onclick="() => RemoveDetailLine(detail)"
                                                                title="Remove line">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                }
            }

            <!-- ── TAB 2: ATTACHMENTS & DOCUMENTS ── -->
            @if (activeTab == "attachments")
            {
                @if (!IsEditMode)
                {
                    <div class="alert alert-info py-4 text-center rounded-3 border-0 shadow-sm" style="background: rgba(13, 202, 240, 0.1);">
                        <i class="fas fa-cloud-arrow-up fa-3x text-info mb-3"></i>
                        <h6 class="fw-bold text-info-emphasis mb-1">Attachments available after saving</h6>
                        <p class="text-secondary mb-3" style="max-width: 500px; margin: 0 auto;">
                            Please save the complaint first. Once saved, you can upload unlimited photos, inspection PDFs, lab reports, and technical drawings.
                        </p>
                        <button type="button" class="btn btn-primary btn-sm px-4" @onclick="() => SaveComplaint(false)">
                            <i class="fas fa-save me-1"></i> Save Complaint Now
                        </button>
                    </div>
                }
                else
                {
                    <div class="card border rounded-3 p-3 bg-white">
                        <EntityAttachmentManager EntityType="CustomerComplaint"
                                                 EntityId="@Id.ToString()"
                                                 EntityDisplayName="@model.ComplaintNo"
                                                 OnCountChanged="HandleAttachmentCountChanged" />
                    </div>
                }
            }

        </div>
    </div>
</div>

<style>
    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 0.75rem;
        border-radius: 4px;
    }
    .blazored-typeahead {
        height: 35px !important;
        min-height: 35px !important;
        font-size: 0.875rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input, .blazored-typeahead__controls {
        height: 33px !important;
        min-height: 33px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input-mask-wrapper {
        height: 33px !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow: hidden !important;
    }
    .blazored-typeahead__input-mask {
        height: 33px !important;
        line-height: 33px !important;
        display: block !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }
    .blazored-typeahead__results {
        z-index: 1050 !important;
    }
    .blazored-typeahead__input-icon {
        padding: 0 0.5rem !important;
        display: flex !important;
        align-items: center !important;
    }
    input.form-control-sm, select.form-select-sm, .input-group-text, .btn-sm:not(.btn-xs) {
        height: 35px !important;
    }
    .disabled-typeahead-wrapper .blazored-typeahead {
        background-color: #e9ecef !important;
        overflow: hidden !important;
        border-radius: 4px;
        pointer-events: none;
        opacity: 0.7;
    }
</style>

