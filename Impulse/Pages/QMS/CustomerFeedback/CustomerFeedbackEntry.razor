@page "/qms/customer-feedback/new"
@page "/qms/customer-feedback/{Id:int}"
@namespace Impulse.Pages.QMS.CustomerFeedback
@using Blazored.Typeahead
@using DataAccessLibrary.Models.QMS
@using Impulse.Components.Common

<PageTitle>@(IsEditMode ? $"Edit Feedback #{model.ComplaintNo}" : "New Customer Feedback") - Impulse ERP</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">

            <!-- ── Header Bar ── -->
            <div class="d-flex align-items-end justify-content-between pb-2 mb-3 border-bottom">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="fas fa-comment-dots me-2 text-info"></i>
                        @(IsEditMode ? $"Customer Feedback: {model.ComplaintNo}" : "Add Customer Feedback / Observation")
                    </h5>
                    <small class="text-secondary">
                        @(IsEditMode ? $"Ref ID: #{Id} | Customer: {model.CustCode} ({model.Country})" : "Record customer feedback, compliments, or process observations")
                    </small>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Cancel" title="Back to list">
                        <i class="fas fa-arrow-left me-1"></i> Back
                    </button>
                    <button type="button" class="btn btn-outline-success btn-sm" @onclick="() => SaveFeedback(true)" disabled="@isSaving" title="Save & create another">
                        <i class="fas fa-plus-circle me-1"></i> Save &amp; New
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => SaveFeedback(false)" disabled="@isSaving" title="Save & return">
                        <i class="fas fa-check me-1"></i> Save &amp; Close
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="Cancel" title="Discard changes">
                        <i class="fas fa-times me-1"></i> Cancel
                    </button>
                </div>
            </div>

            <!-- ── MD3 Navigation Tabs ── -->
            <ul class="nav nav-tabs mb-3" style="font-size: 0.9rem;">
                <li class="nav-item">
                    <button type="button" class="nav-link @(activeTab == "details" ? "active fw-bold text-primary" : "text-secondary")"
                            @onclick='() => SetActiveTab("details")'>
                        <i class="fas fa-comment-dots me-2 text-info"></i> Feedback &amp; Items
                        @if (model.Details.Count(d => !d.IsDeleted) > 0)
                        {
                            <span class="badge bg-primary-subtle text-primary rounded-pill ms-2">
                                @model.Details.Count(d => !d.IsDeleted)
                            </span>
                        }
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link @(activeTab == "attachments" ? "active fw-bold text-primary" : "text-secondary")"
                            @onclick='() => SetActiveTab("attachments")'>
                        <i class="fas fa-paperclip me-2 text-primary"></i> Attachments &amp; Documents
                        @if (IsEditMode && attachmentCount > 0)
                        {
                            <span class="badge bg-success-subtle text-success rounded-pill ms-2">@attachmentCount</span>
                        }
                    </button>
                </li>
            </ul>

            <!-- ── TAB 1: FEEDBACK & ITEMS ── -->
            @if (activeTab == "details")
            {
                @if (isLoading)
                {
                    <div class="d-flex align-items-center justify-content-center py-5">
                        <div class="spinner-border text-info me-2" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <span class="text-secondary fw-semibold">Loading feedback details...</span>
                    </div>
                }
                else
                {
                    <!-- Master Details Card -->
                    <div class="card border rounded-3 mb-3 bg-light-subtle">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-secondary mb-3 pb-1 border-bottom" style="font-size: 0.85rem; text-transform: uppercase;">
                                <i class="fas fa-info-circle me-1 text-info"></i> Feedback Information
                            </h6>

                            <!-- Row 1: Customer, Country, Feedback No, Date -->
                            <div class="row g-2 mb-2 dropdown-row">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                                        Customer <span class="text-danger">*</span>
                                    </label>
                                    <BlazoredTypeahead SearchMethod="SearchCustomers"
                                                       EnableDropDown="true"
                                                       Data="customerList"
                                                       TValue="string"
                                                       TItem="string"
                                                       Value="model.CustCode"
                                                       ValueChanged="OnCustomerChanged"
                                                       ValueExpression="@(() => model.CustCode)"
                                                       Placeholder="Select Customer"
                                                       MaximumSuggestions="1000">
                                        <SelectedTemplate Context="cust">@cust</SelectedTemplate>
                                        <ResultTemplate Context="cust">@cust</ResultTemplate>
                                    </BlazoredTypeahead>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Country</label>
                                    @if (countryList.Count > 1)
                                    {
                                        <select class="form-select form-select-sm" value="@model.Country" @onchange="OnCountryChanged">
                                            @foreach (var c in countryList)
                                            {
                                                <option value="@c">@c</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control form-control-sm" @bind="model.Country" placeholder="Country" />
                                    }
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                                        Feedback # <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control form-control-sm font-monospace fw-bold text-info"
                                           @bind="model.ComplaintNo" readonly />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                                        Date <span class="text-danger">*</span>
                                    </label>
                                    <input type="date" class="form-control form-control-sm"
                                           value="@model.DT?.ToString("yyyy-MM-dd")"
                                           @onchange="OnFeedbackDateChanged" />
                                </div>
                            </div>

                            <!-- Row 2: Received by, Designation -->
                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Received by</label>
                                    <input type="text" class="form-control form-control-sm"
                                           @bind="model.ComplaintBy"
                                           placeholder="Contact person / recipient" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Designation</label>
                                    <input type="text" class="form-control form-control-sm"
                                           @bind="model.Designation"
                                           placeholder="Designation / Role" />
                                </div>
                            </div>

                            <!-- Row 3: Narrative Boxes (Description, Reason, Action Requested) -->
                            <div class="row g-2 mt-1">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                                        <i class="fas fa-align-left me-1 text-primary"></i> Description
                                    </label>
                                    <textarea class="form-control form-control-sm" rows="4"
                                              @bind="model.Description"
                                              placeholder="Enter detailed feedback description..."></textarea>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                                        <i class="fas fa-question-circle me-1 text-warning"></i> Reason for Feedback
                                    </label>
                                    <textarea class="form-control form-control-sm" rows="4"
                                              @bind="model.Reason"
                                              placeholder="Enter reason for feedback / background..."></textarea>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                                        <i class="fas fa-tasks me-1 text-success"></i> Action Requested
                                    </label>
                                    <textarea class="form-control form-control-sm" rows="4"
                                              @bind="model.ActionRequested"
                                              placeholder="Enter any required action or follow-up..."></textarea>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Defective / Discussed Products & Items Card -->
                    <div class="card border rounded-3 bg-white">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <h6 class="fw-bold text-dark mb-0" style="font-size: 0.9rem;">
                                    <i class="fas fa-boxes me-2 text-info"></i> Affected Products &amp; Items
                                </h6>
                                <span class="badge bg-secondary-subtle text-secondary border">
                                    @(model.Details.Count(d => !d.IsDeleted)) Item(s)
                                </span>
                            </div>

                            <!-- Add New Detail Line Inputs Row -->
                            <div class="bg-light p-2 rounded-2 border mb-3">
                                <div class="row g-2 align-items-end dropdown-row">
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.78rem;">Invoice #</label>
                                        <select class="form-select form-select-sm" value="@newDetailInvoice" @onchange="OnInvoiceChanged">
                                            <option value="<All Items>">&lt;All Items&gt;</option>
                                            @foreach (var inv in invoiceList)
                                            {
                                                <option value="@inv">@inv</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.78rem;">Product / Item</label>
                                        <BlazoredTypeahead SearchMethod="SearchInvoiceItems"
                                                           EnableDropDown="true"
                                                           Data="invoiceItems"
                                                           TValue="InvoiceItemLookupDto"
                                                           TItem="InvoiceItemLookupDto"
                                                           Value="selectedInvoiceItem"
                                                           ValueChanged="OnInvoiceItemChanged"
                                                           ValueExpression="@(() => selectedInvoiceItem)"
                                                           Placeholder="Select Item"
                                                           MaximumSuggestions="1000">
                                            <SelectedTemplate Context="itm">@itm.DisplayName</SelectedTemplate>
                                            <ResultTemplate Context="itm">@itm.DisplayName</ResultTemplate>
                                        </BlazoredTypeahead>
                                    </div>

                                    <div class="col-md-2">
                                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.78rem;">Qty</label>
                                        <input type="number" class="form-control form-control-sm text-end" @bind="newDetailQty" min="1" />
                                    </div>

                                    <div class="col-md-2">
                                        <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.78rem;">Reference</label>
                                        <input type="text" class="form-control form-control-sm"
                                               @bind="newDetailLotRef"
                                               placeholder="Lot / Ref"
                                               @onkeydown="HandleRefKeyDown" />
                                    </div>

                                    <div class="col-md-1">
                                        <button type="button" class="btn btn-success btn-sm w-100" @onclick="AddDetailLine" title="Add item to list">
                                            <i class="fas fa-plus"></i> Add
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Detail Items Table -->
                            <div class="table-responsive rounded border table-wrapper" style="max-height: 38vh; overflow-y: auto;">
                                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.85rem;">
                                    <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                        <tr>
                                            <th class="ps-3" style="width: 160px;">Invoice #</th>
                                            <th>Product / Item</th>
                                            <th class="text-end" style="width: 100px;">Qty</th>
                                            <th>Reference / Lot</th>
                                            <th class="text-center" style="width: 70px;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!model.Details.Any(d => !d.IsDeleted))
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center py-4 text-muted">
                                                    <i class="fas fa-box-open fa-2x mb-2 text-secondary opacity-50"></i>
                                                    <div>No products added yet. Use the bar above to add affected items if applicable.</div>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var detail in model.Details.Where(d => !d.IsDeleted))
                                            {
                                                <tr>
                                                    <td class="ps-3 fw-semibold text-secondary">
                                                        @(!string.IsNullOrEmpty(detail.InvoiceNo) ? detail.InvoiceNo : "<All Items>")
                                                    </td>
                                                    <td class="fw-bold text-dark">
                                                        @detail.ItemID
                                                        @if (!string.IsNullOrEmpty(detail.ItemCode) && detail.ItemCode != detail.ItemID)
                                                        {
                                                            <small class="text-muted ms-1">(@detail.ItemCode)</small>
                                                        }
                                                    </td>
                                                    <td class="text-end fw-bold text-primary">@detail.Qty</td>
                                                    <td class="font-monospace text-secondary">@(detail.EmailReference ?? "-")</td>
                                                    <td class="text-center">
                                                        <button type="button" class="btn btn-outline-danger btn-xs py-0 px-2"
                                                                @onclick="() => RemoveDetailLine(detail)"
                                                                title="Remove line">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                }
            }

            <!-- ── TAB 2: ATTACHMENTS & DOCUMENTS ── -->
            @if (activeTab == "attachments")
            {
                @if (!IsEditMode)
                {
                    <div class="alert alert-info py-4 text-center rounded-3 border-0 shadow-sm" style="background: rgba(13, 202, 240, 0.1);">
                        <i class="fas fa-cloud-arrow-up fa-3x text-info mb-3"></i>
                        <h6 class="fw-bold text-info-emphasis mb-1">Attachments available after saving</h6>
                        <p class="text-secondary mb-3" style="max-width: 500px; margin: 0 auto;">
                            Please save the feedback first. Once saved, you can upload unlimited photos, inspection PDFs, customer letters, and related documents.
                        </p>
                        <button type="button" class="btn btn-primary btn-sm px-4" @onclick="() => SaveFeedback(false)">
                            <i class="fas fa-save me-1"></i> Save Feedback Now
                        </button>
                    </div>
                }
                else
                {
                    <div class="card border rounded-3 p-3 bg-white">
                        <EntityAttachmentManager EntityType="CustomerComplaint"
                                                 EntityId="@Id.ToString()"
                                                 EntityDisplayName="@model.ComplaintNo"
                                                 OnCountChanged="HandleAttachmentCountChanged" />
                    </div>
                }
            }

        </div>
    </div>
</div>

<style>
    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 0.75rem;
        border-radius: 4px;
    }
    .blazored-typeahead {
        height: 35px !important;
        min-height: 35px !important;
        font-size: 0.875rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input, .blazored-typeahead__controls {
        height: 33px !important;
        min-height: 33px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        box-sizing: border-box !important;
    }
    .blazored-typeahead__input-mask-wrapper {
        height: 33px !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow: hidden !important;
    }
    .blazored-typeahead__input-mask {
        height: 33px !important;
        line-height: 33px !important;
        display: block !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }
    .blazored-typeahead__results {
        z-index: 1050 !important;
    }
    .blazored-typeahead__input-icon {
        padding: 0 0.5rem !important;
        display: flex !important;
        align-items: center !important;
    }
    input.form-control-sm, select.form-select-sm, .input-group-text, .btn-sm:not(.btn-xs) {
        height: 35px !important;
    }
    .disabled-typeahead-wrapper .blazored-typeahead {
        background-color: #e9ecef !important;
        overflow: hidden !important;
        border-radius: 4px;
        pointer-events: none;
        opacity: 0.7;
    }
    .dropdown-row {
        position: relative !important;
        z-index: 9999 !important;
    }
    .table-wrapper {
        position: relative !important;
        z-index: 1 !important;
    }
</style>

