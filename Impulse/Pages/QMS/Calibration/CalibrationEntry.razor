@page "/qms/calibrations/new"
@page "/qms/calibrations/{Id:int}"
@using Blazored.Typeahead
@using DataAccessLibrary.Models.QMS
@using Impulse.Components.Common

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">

            <!-- ── Top Action & Title Header ── -->
            <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4 text-warning"><i class="fas fa-wrench"></i></span>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">
                            @(IsEditMode ? $"Edit Calibration #{Id} - Asset: {model.AssetID}" : "New Calibration Log")
                        </h5>
                        <small class="text-secondary">
                            Fixed Asset Maintenance &amp; Calibration Schedule
                        </small>
                    </div>
                    @if (IsEditMode)
                    {
                        <span class="badge bg-primary-subtle text-primary border px-2 ms-2">Edit Mode</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success border px-2 ms-2">New Entry</span>
                    }
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" @onclick="Cancel" title="Go back">
                        <i class="fas fa-arrow-left me-1"></i> Back
                    </button>

                    <button type="button" class="btn btn-outline-primary btn-sm px-3" @onclick="() => SaveCalibration(true)" disabled="@isSaving">
                        <i class="fas fa-plus-circle me-1"></i> Save &amp; New
                    </button>

                    <button type="button" class="btn btn-primary btn-sm px-3" @onclick="() => SaveCalibration(false)" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="fas fa-save me-1"></i>
                            <span>Save &amp; Close</span>
                        }
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-secondary">Loading calibration details...</p>
                </div>
            }
            else
            {
                <!-- ── Navigation Tabs ── -->
                <ul class="nav nav-tabs mb-3" style="font-size: 0.9rem;">
                    <li class="nav-item">
                        <button type="button"
                                class="nav-link @(activeTab == "details" ? "active fw-bold text-primary border-bottom-0" : "text-secondary")"
                                @onclick='() => SetActiveTab("details")'>
                            <i class="fas fa-info-circle me-1"></i> Calibration Details
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button"
                                class="nav-link @(activeTab == "attachments" ? "active fw-bold text-primary border-bottom-0" : "text-secondary")"
                                @onclick='() => SetActiveTab("attachments")'>
                            <i class="fas fa-paperclip me-1"></i> Attachments &amp; Documents
                            @if (attachmentCount > 0)
                            {
                                <span class="badge bg-primary rounded-pill ms-1">@attachmentCount</span>
                            }
                        </button>
                    </li>
                </ul>

                @if (activeTab == "details")
                {
                    <div class="row g-3">
                        <!-- Left Column: Primary Asset & Schedule Information -->
                        <div class="col-lg-6">
                            <div class="card border rounded-3 p-3 mb-3 bg-white shadow-none">
                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 small text-uppercase">
                                    <i class="fas fa-cube text-primary me-1"></i> Asset &amp; Schedule
                                </h6>

                                <!-- Asset Selector -->
                                <div class="mb-3">
                                    <label class="form-label text-secondary fw-semibold small mb-1">
                                        Fixed Asset <span class="text-danger">*</span>
                                    </label>
                                    <BlazoredTypeahead SearchMethod="SearchAssets"
                                                       EnableDropDown="true"
                                                       Data="assets"
                                                       TValue="FixedAssetLookupDto"
                                                       TItem="FixedAssetLookupDto"
                                                       Value="selectedAsset"
                                                       ValueChanged="@((FixedAssetLookupDto? a) => OnAssetSelected(a))"
                                                       ValueExpression="@(() => selectedAsset)"
                                                       Placeholder="Select or type to search Asset..."
                                                       MaximumSuggestions="1000">
                                        <SelectedTemplate Context="asset">
                                            @asset.DisplayText
                                        </SelectedTemplate>
                                        <ResultTemplate Context="asset">
                                            <div>
                                                <span class="fw-bold text-dark">[@asset.AssetID]</span>
                                                <span class="ms-1 text-secondary">@asset.Description</span>
                                            </div>
                                        </ResultTemplate>
                                    </BlazoredTypeahead>
                                </div>

                                <div class="row g-2 mb-3">
                                    <!-- Calibration Date -->
                                    <div class="col-md-4">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Calibration Date <span class="text-danger">*</span>
                                        </label>
                                        <input type="date"
                                               class="form-control form-control-sm"
                                               value="@(model.DT?.ToString("yyyy-MM-dd"))"
                                               @onchange="OnCalibrationDateChanged" />
                                    </div>

                                    <!-- Next Due Date -->
                                    <div class="col-md-4">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Next Due Date <span class="text-danger">*</span>
                                        </label>
                                        <input type="date"
                                               class="form-control form-control-sm"
                                               value="@(model.NextDueDT?.ToString("yyyy-MM-dd"))"
                                               @onchange="OnNextDueDateChanged" />
                                    </div>

                                    <!-- Calibration Frequency -->
                                    <div class="col-md-4">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Frequency
                                        </label>
                                        <select class="form-select form-select-sm"
                                                value="@(model.CalibrationFrequency ?? 0)"
                                                @onchange="OnFrequencyChanged">
                                            <option value="0">Monthly</option>
                                            <option value="1">Yearly</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Remarks -->
                                <div>
                                    <label class="form-label text-secondary fw-semibold small mb-1">
                                        Remarks
                                    </label>
                                    <textarea class="form-control form-control-sm"
                                              rows="4"
                                              placeholder="Enter calibration observations, standards used, or equipment condition..."
                                              @bind="model.Remarks"></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Certificate & Vendor Information -->
                        <div class="col-lg-6">
                            <div class="card border rounded-3 p-3 bg-white shadow-none">
                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 small text-uppercase">
                                    <i class="fas fa-certificate text-warning me-1"></i> Calibration Certificate &amp; Calibration Agency
                                </h6>

                                <div class="row g-2 mb-3">
                                    <!-- Certificate No -->
                                    <div class="col-md-5">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Certificate No.
                                        </label>
                                        <input type="text"
                                               class="form-control form-control-sm fw-semibold text-primary"
                                               placeholder="e.g. CAL-2026-001"
                                               @bind="model.CertificateNo" />
                                    </div>

                                    <!-- Master Calibrator Reference -->
                                    <div class="col-md-7">
                                        <label class="form-label text-secondary fw-semibold small mb-1">
                                            Master Calibrator Reference
                                        </label>
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               placeholder="e.g. Fluke 5500A / Cal Standard #..."
                                               @bind="model.MasterReference" />
                                    </div>
                                </div>

                                <!-- Calibrating Vendor -->
                                <div class="mb-3">
                                    <label class="form-label text-secondary fw-semibold small mb-1">
                                        Calibration Agency / Vendor
                                    </label>
                                    <BlazoredTypeahead SearchMethod="SearchVendors"
                                                       EnableDropDown="true"
                                                       Data="vendors"
                                                       TValue="VendorLookupDto"
                                                       TItem="VendorLookupDto"
                                                       Value="selectedVendor"
                                                       ValueChanged="@((VendorLookupDto? v) => OnVendorSelected(v))"
                                                       ValueExpression="@(() => selectedVendor)"
                                                       Placeholder="Select or type to search Vendor / Agency..."
                                                       MaximumSuggestions="1000">
                                        <SelectedTemplate Context="vendor">
                                            @vendor.DisplayText
                                        </SelectedTemplate>
                                        <ResultTemplate Context="vendor">
                                            <div>
                                                <span class="fw-bold text-dark">@vendor.AccTitle</span>
                                                <small class="ms-1 text-muted">(@vendor.AccNo)</small>
                                            </div>
                                        </ResultTemplate>
                                    </BlazoredTypeahead>
                                </div>

                                @if (IsEditMode)
                                {
                                    <div class="p-3 bg-light rounded-2 border">
                                        <div class="row g-2" style="font-size: 0.82rem;">
                                            <div class="col-sm-4 text-muted">Created By:</div>
                                            <div class="col-sm-8 fw-semibold text-dark">@(model.UserName ?? "System")</div>

                                            <div class="col-sm-4 text-muted">Computer Name:</div>
                                            <div class="col-sm-8 text-secondary">@(model.MachineName ?? "-")</div>

                                            <div class="col-sm-4 text-muted">Entry Timestamp:</div>
                                            <div class="col-sm-8 text-secondary">@(model.DTEntry?.ToString("dd-MMM-yyyy HH:mm") ?? "-")</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (activeTab == "attachments")
                {
                    if (!IsEditMode)
                    {
                        <div class="card border rounded-3 p-4 text-center bg-white">
                            <i class="fas fa-paperclip text-muted fs-1 mb-2"></i>
                            <h6 class="text-secondary fw-semibold">Save Calibration Record First</h6>
                            <p class="text-muted small mb-3">
                                You must save this calibration log before uploading calibration certificates or PDF documents.
                            </p>
                            <button type="button" class="btn btn-primary btn-sm px-4 mx-auto" @onclick="() => SaveCalibration(false)">
                                <i class="fas fa-save me-1"></i> Save Calibration Now
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="card border rounded-3 p-3 bg-white">
                            <EntityAttachmentManager EntityType="Calibration"
                                                     EntityId="@Id.ToString()"
                                                     EntityDisplayName="@($"Cert #{model.CertificateNo} - Asset {model.AssetID}")"
                                                     OnCountChanged="HandleAttachmentCountChanged" />
                        </div>
                    }
                }
            }

        </div>
    </div>
</div>

<style>
    .blazored-typeahead {
        height: 35px !important;
        min-height: 35px !important;
        font-size: 0.875rem !important;
        border: 1px solid #ced4da !important;
        border-radius: 0.375rem !important;
        background-color: #fff !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        display: flex !important;
        align-items: center !important;
        position: relative !important;
    }
    .blazored-typeahead:focus-within {
        border-color: #86b7fe !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
    }
    .blazored-typeahead__controls {
        height: 33px !important;
        min-height: 33px !important;
        width: 100% !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        background: transparent !important;
    }
    .blazored-typeahead__input {
        height: 31px !important;
        min-height: 31px !important;
        padding: 0 0.5rem !important;
        background: transparent !important;
        box-sizing: border-box !important;
        font-size: 0.875rem !important;
    }
    .blazored-typeahead__input-mask-wrapper {
        height: 33px !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow: hidden !important;
        background: transparent !important;
    }
    .blazored-typeahead__input-mask {
        height: 31px !important;
        line-height: 31px !important;
        display: block !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        background: transparent !important;
    }
    .blazored-typeahead__results {
        z-index: 1050 !important;
    }
    .blazored-typeahead__input-icon {
        padding: 0 0.5rem !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        cursor: pointer !important;
        height: 100% !important;
        background: transparent !important;
    }
    .blazored-typeahead__down-arrow {
        width: 11px !important;
        height: 11px !important;
        display: inline-block !important;
    }
    .blazored-typeahead__down-arrow path {
        fill: #6c757d !important;
    }
    .blazored-typeahead__input-icon:hover .blazored-typeahead__down-arrow path {
        fill: #212529 !important;
    }
    input.form-control-sm, select.form-select-sm, .input-group-text, .btn-sm {
        height: 35px !important;
    }
</style>

