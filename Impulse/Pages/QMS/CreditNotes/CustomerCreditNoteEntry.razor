@page "/qms/credit-note/new"
@page "/qms/credit-note/{ComplaintId:int}"
@namespace Impulse.Pages.QMS.CreditNotes
@using DataAccessLibrary.Models.QMS
@using Impulse.Components.Common

<PageTitle>@(string.IsNullOrWhiteSpace(creditNoteNo) ? "Credit Note" : $"Credit Note #{creditNoteNo}") - Impulse ERP</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">

            <!-- ── Header Bar ── -->
            <div class="d-flex align-items-end justify-content-between pb-2 mb-3 border-bottom">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="fas fa-receipt me-2 text-success"></i>
                        @(!string.IsNullOrWhiteSpace(creditNoteNo) ? $"Credit Note: {creditNoteNo}" : "Generate Credit Note")
                    </h5>
                    <small class="text-secondary">
                        Complaint Ref: @(complaint?.ComplaintNo ?? $"#{effectiveComplaintId}") | Customer: @(complaint?.CustCode ?? "-") (@(complaint?.Country ?? "-"))
                    </small>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Cancel" title="Back to list">
                        <i class="fas fa-arrow-left me-1"></i> Back
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="PrintCreditNote" disabled="@(string.IsNullOrWhiteSpace(creditNoteNo))" title="Print Credit Note">
                        <i class="fas fa-print me-1"></i> Print Credit Note
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveCreditNote" disabled="@isSaving" title="Save Credit Note">
                        <i class="fas fa-check me-1"></i> Save &amp; Close
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="Cancel" title="Discard changes">
                        <i class="fas fa-times me-1"></i> Cancel
                    </button>
                </div>
            </div>

            <!-- ── MD3 Navigation Tabs ── -->
            <ul class="nav nav-tabs mb-3" style="font-size: 0.9rem;">
                <li class="nav-item">
                    <button type="button" class="nav-link @(activeTab == "details" ? "active fw-bold text-primary" : "text-secondary")"
                            @onclick='() => SetActiveTab("details")'>
                        <i class="fas fa-receipt me-2 text-success"></i> Credit Note &amp; Pricing
                        @if (complaint?.Details.Count(d => !d.IsDeleted) > 0)
                        {
                            <span class="badge bg-primary-subtle text-primary rounded-pill ms-2">
                                @complaint.Details.Count(d => !d.IsDeleted)
                            </span>
                        }
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link @(activeTab == "attachments" ? "active fw-bold text-primary" : "text-secondary")"
                            @onclick='() => SetActiveTab("attachments")'>
                        <i class="fas fa-paperclip me-2 text-primary"></i> Attachments &amp; Documents
                        @if (attachmentCount > 0)
                        {
                            <span class="badge bg-success-subtle text-success rounded-pill ms-2">@attachmentCount</span>
                        }
                    </button>
                </li>
            </ul>

            <!-- ── TAB 1: CREDIT NOTE & PRICING ── -->
            @if (activeTab == "details")
            {
                @if (isLoading)
                {
                    <div class="d-flex align-items-center justify-content-center py-5">
                        <div class="spinner-border text-success me-2" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <span class="text-secondary fw-semibold">Loading credit note details...</span>
                    </div>
                }
                else if (complaint == null)
                {
                    <div class="alert alert-warning py-4 text-center rounded-3 border-0 shadow-sm">
                        <i class="fas fa-exclamation-triangle fa-2x text-warning mb-2"></i>
                        <h6 class="fw-bold mb-1">Customer Complaint Not Found</h6>
                        <p class="text-secondary mb-3">Unable to find complaint details for ID #@effectiveComplaintId.</p>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Cancel">
                            <i class="fas fa-arrow-left me-1"></i> Back to Command Center
                        </button>
                    </div>
                }
                else
                {
                    <!-- Master Details & Credit Note Info Card -->
                    <div class="card border rounded-3 mb-3 bg-light-subtle">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-secondary mb-3 pb-1 border-bottom" style="font-size: 0.85rem; text-transform: uppercase;">
                                <i class="fas fa-info-circle me-1 text-success"></i> Credit Note Information
                            </h6>

                            <div class="row g-2 mb-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Credit Note # <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm font-monospace fw-bold text-success-emphasis bg-white"
                                           @bind="creditNoteNo" />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Credit Note Date <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control form-control-sm"
                                           value="@creditNoteDate.ToString("yyyy-MM-dd")"
                                           @onchange="OnCreditNoteDateChanged" />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Complaint #</label>
                                    <input type="text" class="form-control form-control-sm font-monospace bg-light"
                                           value="@complaint.ComplaintNo" readonly />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Customer</label>
                                    <input type="text" class="form-control form-control-sm bg-light"
                                           value="@($"{complaint.CustCode} ({complaint.Country})")" readonly />
                                </div>
                            </div>

                            <div class="row g-2" style="font-size: 0.85rem;">
                                <div class="col-md-3">
                                    <span class="text-secondary fw-semibold">Complaint Date:</span>
                                    <span class="ms-1">@(complaint.DT?.ToString("dd-MMM-yyyy") ?? "-")</span>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-secondary fw-semibold">Lodged By:</span>
                                    <span class="ms-1">@(complaint.ComplaintBy ?? "-") @(!string.IsNullOrWhiteSpace(complaint.Designation) ? $"({complaint.Designation})" : "")</span>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-secondary fw-semibold">Total Line Items:</span>
                                    <span class="badge bg-secondary-subtle text-secondary ms-1">@(complaint.Details.Count(d => !d.IsDeleted)) Items</span>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-secondary fw-semibold">Credit Total:</span>
                                    <span class="badge bg-success text-white ms-1 fw-bold fs-6">
                                        @TotalAmount.ToString("N2") @(complaint.PenaltyCurrency ?? "USD")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Defective Items & Pricing Table Card -->
                    <div class="card border rounded-3 bg-white">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <h6 class="fw-bold text-dark mb-0" style="font-size: 0.9rem;">
                                    <i class="fas fa-tags me-2 text-success"></i> Items &amp; Credit Pricing
                                </h6>
                                <small class="text-secondary">
                                    Enter or adjust the unit price for each defective item to compute credit amount.
                                </small>
                            </div>

                            <div class="table-responsive rounded border" style="max-height: 48vh; overflow-y: auto;">
                                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                                    <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                        <tr>
                                            <th class="ps-3" style="width: 50px;">S.#</th>
                                            <th style="width: 150px;">Invoice #</th>
                                            <th>Product / Item</th>
                                            <th class="text-end" style="width: 90px;">Qty</th>
                                            <th class="text-end" style="width: 130px;">Price / Unit</th>
                                            <th class="text-end" style="width: 140px;">Line Total</th>
                                            <th>Reason / Remarks</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!complaint.Details.Any(d => !d.IsDeleted))
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center py-4 text-muted">
                                                    <i class="fas fa-box-open fa-2x mb-2 text-secondary opacity-50"></i>
                                                    <div>No products attached to this complaint.</div>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            int sno = 1;
                                            @foreach (var detail in complaint.Details.Where(d => !d.IsDeleted))
                                            {
                                                var lineTotal = (detail.Qty ?? 0) * (detail.Price ?? 0);
                                                <tr>
                                                    <td class="ps-3 text-secondary" style="font-size: 0.8rem;">@(sno++)</td>
                                                    <td class="fw-semibold text-secondary">
                                                        @(!string.IsNullOrEmpty(detail.InvoiceNo) ? detail.InvoiceNo : "<All Items>")
                                                    </td>
                                                    <td>
                                                        <span class="fw-bold text-dark">@detail.ItemID</span>
                                                        @if (!string.IsNullOrEmpty(detail.ItemCode) && detail.ItemCode != detail.ItemID)
                                                        {
                                                            <small class="text-muted ms-1">(@detail.ItemCode)</small>
                                                        }
                                                    </td>
                                                    <td class="text-end fw-bold text-danger">@detail.Qty</td>
                                                    <td class="text-end">
                                                        <input type="number" step="0.01" class="form-control form-control-sm text-end font-monospace fw-bold"
                                                               style="height: 31px !important;"
                                                               value="@detail.Price"
                                                               @onchange="@((ChangeEventArgs e) => OnPriceChanged(detail, e))" />
                                                    </td>
                                                    <td class="text-end fw-bold text-success font-monospace">
                                                        @lineTotal.ToString("N2")
                                                    </td>
                                                    <td class="text-secondary small">
                                                        @(!string.IsNullOrEmpty(detail.ItemReason_Main) ? $"[{detail.ItemReason_Main}] " : "")
                                                        @detail.ItemReason
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                    @if (complaint.Details.Any(d => !d.IsDeleted))
                                    {
                                        <tfoot class="table-light fw-bold border-top">
                                            <tr>
                                                <td colspan="3" class="ps-3 text-end text-secondary text-uppercase" style="font-size: 0.8rem;">Total:</td>
                                                <td class="text-end text-danger">@complaint.Details.Where(d => !d.IsDeleted).Sum(d => d.Qty ?? 0)</td>
                                                <td class="text-end">-</td>
                                                <td class="text-end text-success font-monospace fs-6">
                                                    @TotalAmount.ToString("N2")
                                                </td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    }
                                </table>
                            </div>

                        </div>
                    </div>
                }
            }

            <!-- ── TAB 2: ATTACHMENTS & DOCUMENTS ── -->
            @if (activeTab == "attachments")
            {
                <div class="card border rounded-3 p-3 bg-white">
                    <EntityAttachmentManager EntityType="CustomerComplaint"
                                             EntityId="@effectiveComplaintId.ToString()"
                                             EntityDisplayName="@creditNoteNo"
                                             OnCountChanged="HandleAttachmentCountChanged" />
                </div>
            }

        </div>
    </div>
</div>

<style>
    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 0.75rem;
        border-radius: 4px;
    }
    input.form-control-sm, select.form-select-sm, .input-group-text, .btn-sm:not(.btn-xs) {
        height: 35px !important;
    }
</style>

