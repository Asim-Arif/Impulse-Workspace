@page "/qms/non-compliance/new"
@page "/qms/non-compliance/{Id:int}"
@namespace Impulse.Pages.QMS.NonCompliance
@using DataAccessLibrary.Models.QMS
@using Impulse.Components.Common

<PageTitle>@(IsEditMode ? $"Edit NC #{model.NCNo}" : "New Non-Compliance (NC)") - Impulse ERP</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">

            <!-- ── Header Bar ── -->
            <div class="d-flex align-items-end justify-content-between pb-2 mb-3 border-bottom">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="fas fa-file-signature me-2 text-warning"></i>
                        @(IsEditMode ? $"Non-Compliance: {model.NCNo}" : "Generate Non-Compliance (NC)")
                    </h5>
                    <small class="text-secondary">
                        @(IsEditMode ? $"Ref ID: #{Id} | Source: {model.Source}" : "Record quality non-conformance against customer complaint, audit, or process deviation")
                    </small>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Cancel" title="Back to list">
                        <i class="fas fa-arrow-left me-1"></i> Back
                    </button>
                    <button type="button" class="btn btn-outline-success btn-sm" @onclick="() => SaveNC(true)" disabled="@isSaving" title="Save & create another">
                        <i class="fas fa-plus-circle me-1"></i> Save &amp; New
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => SaveNC(false)" disabled="@isSaving" title="Save & return">
                        <i class="fas fa-check me-1"></i> Save &amp; Close
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="Cancel" title="Discard changes">
                        <i class="fas fa-times me-1"></i> Cancel
                    </button>
                </div>
            </div>

            <!-- ── MD3 Navigation Tabs ── -->
            <ul class="nav nav-tabs mb-3" style="font-size: 0.9rem;">
                <li class="nav-item">
                    <button type="button" class="nav-link @(activeTab == "details" ? "active fw-bold text-primary" : "text-secondary")"
                            @onclick='() => SetActiveTab("details")'>
                        <i class="fas fa-file-signature me-2 text-warning"></i> Non-Compliance Details
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link @(activeTab == "attachments" ? "active fw-bold text-primary" : "text-secondary")"
                            @onclick='() => SetActiveTab("attachments")'>
                        <i class="fas fa-paperclip me-2 text-primary"></i> Attachments &amp; Documents
                        @if (IsEditMode && attachmentCount > 0)
                        {
                            <span class="badge bg-success-subtle text-success rounded-pill ms-2">@attachmentCount</span>
                        }
                    </button>
                </li>
            </ul>

            <!-- ── TAB 1: NC DETAILS ── -->
            @if (activeTab == "details")
            {
                @if (isLoading)
                {
                    <div class="d-flex align-items-center justify-content-center py-5">
                        <div class="spinner-border text-warning me-2" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <span class="text-secondary fw-semibold">Loading non-compliance details...</span>
                    </div>
                }
                else
                {
                    <!-- Associated Source / Customer Complaint Details Card -->
                    @if (!string.IsNullOrWhiteSpace(model.ComplaintNo))
                    {
                        <div class="card border rounded-3 mb-3 bg-light-subtle">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                                    <h6 class="fw-bold text-secondary mb-0" style="font-size: 0.85rem; text-transform: uppercase;">
                                        <i class="fas fa-link me-1 text-primary"></i> Source Complaint Information
                                    </h6>
                                    <span class="badge bg-primary-subtle text-primary border">
                                        @model.Source: @model.ComplaintNo
                                    </span>
                                </div>

                                <div class="row g-2" style="font-size: 0.85rem;">
                                    <div class="col-md-3">
                                        <span class="text-secondary fw-semibold d-block">Customer:</span>
                                        <span class="fw-bold text-dark">@model.CustCode</span>
                                        @if (!string.IsNullOrWhiteSpace(model.Country))
                                        {
                                            <span class="text-muted ms-1">(@model.Country)</span>
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        <span class="text-secondary fw-semibold d-block">Complaint Date:</span>
                                        <span>@(model.ComplaintDate?.ToString("dd-MMM-yyyy") ?? "-")</span>
                                    </div>
                                    <div class="col-md-3">
                                        <span class="text-secondary fw-semibold d-block">Complaint By:</span>
                                        <span>@(model.ComplaintBy ?? "-") @(!string.IsNullOrWhiteSpace(model.Designation) ? $"({model.Designation})" : "")</span>
                                    </div>
                                    <div class="col-md-3">
                                        <span class="text-secondary fw-semibold d-block">Penalty:</span>
                                        <span class="badge bg-danger-subtle text-danger border">@model.PenaltyDisplay</span>
                                        @if (model.PenaltyQty.HasValue && model.PenaltyQty > 0)
                                        {
                                            <span class="ms-1 text-muted">Qty: @model.PenaltyQty</span>
                                        }
                                        @if (model.PenaltyAmount.HasValue && model.PenaltyAmount > 0)
                                        {
                                            <span class="ms-1 fw-bold text-danger">@model.PenaltyCurrency @model.PenaltyAmount</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- NC Master Form Card -->
                    <div class="card border rounded-3 mb-3 bg-white">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-secondary mb-3 pb-1 border-bottom" style="font-size: 0.85rem; text-transform: uppercase;">
                                <i class="fas fa-exclamation-triangle me-1 text-warning"></i> Non-Compliance Entry
                            </h6>

                            <!-- Row 1: NC #, Date, NC Type, Source -->
                            <div class="row g-2 mb-3">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                                        NC # <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control form-control-sm font-monospace fw-bold text-warning-emphasis bg-light"
                                           @bind="model.NCNo" readonly />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                                        Date <span class="text-danger">*</span>
                                    </label>
                                    <input type="date" class="form-control form-control-sm"
                                           value="@model.DT?.ToString("yyyy-MM-dd")"
                                           @onchange="OnNCDateChanged" />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                                        NC Type <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select form-select-sm" @bind="model.NCType">
                                        <option value="Minor">Minor</option>
                                        <option value="Major">Major</option>
                                        <option value="Critical">Critical</option>
                                        <option value="Observation">Observation</option>
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">Source</label>
                                    <input type="text" class="form-control form-control-sm bg-light" @bind="model.Source" readonly />
                                </div>
                            </div>

                            <!-- Row 2: Department -->
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                                        Department <span class="text-danger">*</span>
                                    </label>
                                    @if (departments.Count > 0)
                                    {
                                        <select class="form-select form-select-sm" @bind="model.Department">
                                            <option value="">&lt;Select Department&gt;</option>
                                            @foreach (var d in departments)
                                            {
                                                <option value="@d.Name">@d.Name</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control form-control-sm" @bind="model.Department" placeholder="Department" />
                                    }
                                </div>
                            </div>

                            <!-- Row 3: Description -->
                            <div class="mb-1">
                                <label class="form-label fw-bold text-secondary mb-1" style="font-size: 0.8rem;">
                                    <i class="fas fa-align-left me-1 text-primary"></i> Description of Non-Compliance <span class="text-danger">*</span>
                                </label>
                                <textarea class="form-control form-control-sm" rows="6"
                                          @bind="model.Description"
                                          placeholder="Enter detailed description of non-compliance, root cause observation, specification deviation..."></textarea>
                            </div>

                        </div>
                    </div>
                }
            }

            <!-- ── TAB 2: ATTACHMENTS & DOCUMENTS ── -->
            @if (activeTab == "attachments")
            {
                @if (!IsEditMode)
                {
                    <div class="alert alert-info py-4 text-center rounded-3 border-0 shadow-sm" style="background: rgba(13, 202, 240, 0.1);">
                        <i class="fas fa-cloud-arrow-up fa-3x text-info mb-3"></i>
                        <h6 class="fw-bold text-info-emphasis mb-1">Attachments available after saving</h6>
                        <p class="text-secondary mb-3" style="max-width: 500px; margin: 0 auto;">
                            Please save the non-compliance report first. Once saved, you can upload inspection evidence, photos, technical lab reports, and deviation notices.
                        </p>
                        <button type="button" class="btn btn-primary btn-sm px-4" @onclick="() => SaveNC(false)">
                            <i class="fas fa-save me-1"></i> Save NC Now
                        </button>
                    </div>
                }
                else
                {
                    <div class="card border rounded-3 p-3 bg-white">
                        <EntityAttachmentManager EntityType="NonCompliance"
                                                 EntityId="@Id.ToString()"
                                                 EntityDisplayName="@model.NCNo"
                                                 OnCountChanged="HandleAttachmentCountChanged" />
                    </div>
                }
            }

        </div>
    </div>
</div>

<style>
    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 0.75rem;
        border-radius: 4px;
    }
    input.form-control-sm, select.form-select-sm, .input-group-text, .btn-sm:not(.btn-xs) {
        height: 35px !important;
    }
</style>

