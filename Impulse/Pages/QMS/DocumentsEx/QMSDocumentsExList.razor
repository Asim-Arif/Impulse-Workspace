@page "/qms/standards"
@page "/qms/manuals"
@page "/qms/procedures"
@page "/qms/work-instructions"
@page "/qms/technical-files"
@page "/qms/lean-management"
@page "/qms/documents-ex/{Category}"
@attribute [Authorize]

@using BlazorContextMenu
@using DataAccessLibrary.Models.QMS
@using Impulse.Components.Common

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">

            <!-- ── Top Action & Title Header ── -->
            <div class="d-flex flex-wrap align-items-center justify-content-between pb-2 mb-3 border-bottom gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4 text-primary"><i class="@CategoryIcon"></i></span>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">@CategoryTitle</h5>
                        <small class="text-secondary">@CategorySubtitle</small>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border px-2 ms-2">@documents.Count Items</span>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <NavLink href="/qms" class="btn btn-outline-secondary btn-sm px-3" title="Back to QMS Hub">
                        <i class="fas fa-arrow-left me-1"></i> QMS Hub
                    </NavLink>

                    <button type="button"
                            class="btn btn-outline-primary btn-sm px-3"
                            @onclick="PrintSelectedDistributionList"
                            disabled="@(SelectedCount == 0)">
                        <i class="fas fa-print me-1"></i> Dist. List (@SelectedCount)
                    </button>

                    <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm" @onclick="NavigateToCreate">
                        <i class="fas fa-plus-circle me-1"></i> New Document
                    </button>
                </div>
            </div>

            <!-- ── Filter & Search Bar ── -->
            <div class="card border rounded-3 p-3 mb-3 bg-light-subtle shadow-none">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label text-secondary fw-semibold small mb-1">
                            <i class="fas fa-search text-muted me-1"></i> Search
                        </label>
                        <input type="text"
                               class="form-control form-control-sm"
                               placeholder="Doc #, title, type, initiator..."
                               @bind="searchText"
                               @bind:event="oninput"
                               @onkeyup="HandleSearchKeyUp" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label text-secondary fw-semibold small mb-1">
                            <i class="fas fa-calendar-alt text-muted me-1"></i> Issue From
                        </label>
                        <input type="date" class="form-control form-control-sm" @bind="fromDate" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label text-secondary fw-semibold small mb-1">
                            <i class="fas fa-calendar-check text-muted me-1"></i> Issue To
                        </label>
                        <input type="date" class="form-control form-control-sm" @bind="toDate" />
                    </div>

                    <div class="col-md-2 d-flex gap-1">
                        <button type="button" class="btn btn-primary btn-sm flex-grow-1" @onclick="LoadDocumentsAsync">
                            <i class="fas fa-filter me-1"></i> Filter
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ResetFilters" title="Reset Filters">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- ── Data Table ── -->
            <div class="card border rounded-3 overflow-hidden shadow-none">
                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 text-secondary">Loading @CategoryTitle...</p>
                    </div>
                }
                else if (documents.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="@CategoryIcon fs-1 mb-3 text-secondary opacity-50"></i>
                        <h6>No Documents Found</h6>
                        <p class="small mb-3">Add your first document to @CategoryTitle using the button above.</p>
                        <button type="button" class="btn btn-primary btn-sm" @onclick="NavigateToCreate">
                            <i class="fas fa-plus me-1"></i> Add Document
                        </button>
                    </div>
                }
                else
                {
                    <div class="table-responsive" style="max-height: 65vh;">
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                            <thead class="table-light text-secondary sticky-top" style="font-size: 0.78rem; text-transform: uppercase; z-index: 2; box-shadow: 0 1px 0 #dee2e6;">
                                <tr>
                                    <th style="width: 40px;" class="text-center">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               checked="@IsAllSelected"
                                               @onchange="ToggleSelectAll" />
                                    </th>
                                    <th style="width: 50px;" class="text-center">S. #</th>
                                    <th style="width: 140px;">Doc #</th>
                                    <th>Document Title / Name</th>
                                    <th style="width: 80px;" class="text-center">Rev</th>
                                    <th style="width: 150px;">Document Type</th>
                                    <th style="width: 110px;" class="text-center">Issue Date</th>
                                    <th style="width: 180px;">Initiator / Dept</th>
                                    <th style="width: 140px;" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int serial = 1; }
                                @foreach (var item in documents)
                                {
                                    <ContextMenuTrigger MenuId="docExRowMenu" Data="item" WrapperTag="tr">
                                        <td class="text-center" @onclick:stopPropagation="true">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   @bind="item.IsSelected" />
                                        </td>
                                        <td class="text-center text-muted small">@(serial++)</td>
                                        <td>
                                            <a href="javascript:void(0)"
                                               class="fw-bold text-decoration-none text-primary"
                                               @onclick="() => NavigateToEdit(item.EntryID)">
                                                @item.DocumentNumber
                                            </a>
                                        </td>
                                        <td>
                                            <span class="fw-semibold text-dark">@item.DocumentName</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary-subtle text-secondary border">@(string.IsNullOrWhiteSpace(item.Revision) ? "00" : item.Revision)</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@item.DocumentType</span>
                                        </td>
                                        <td class="text-center small">
                                            @(item.IssueDT?.ToString("dd-MMM-yyyy") ?? "—")
                                        </td>
                                        <td class="small">
                                            @if (!string.IsNullOrWhiteSpace(item.InitiatorName))
                                            {
                                                <div>@item.InitiatorName</div>
                                                <small class="text-muted">@item.DeptName</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-end" @onclick:stopPropagation="true">
                                            <div class="d-inline-flex gap-1">
                                                <button type="button"
                                                        class="btn btn-outline-primary btn-xs"
                                                        @onclick="() => NavigateToEdit(item.EntryID)"
                                                        title="Edit Document">
                                                    <i class="fas fa-pencil-alt"></i>
                                                </button>
                                                <button type="button"
                                                        class="btn btn-outline-secondary btn-xs"
                                                        @onclick="() => OpenAttachments(item)"
                                                        title="Attachments">
                                                    <i class="fas fa-paperclip"></i>
                                                </button>
                                                <button type="button"
                                                        class="btn btn-outline-danger btn-xs"
                                                        @onclick="() => ConfirmDelete(item)"
                                                        title="Delete Document">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </ContextMenuTrigger>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<!-- ── Row Context Menu ── -->
<ContextMenu Id="docExRowMenu" Template="Win11Style">
    <Item class="win11-menu-item" OnClick="@((ItemClickEventArgs e) => NavigateToEdit((e.Data as QMSDocumentExListItemDto)!.EntryID))">
        <i class="fas fa-pencil-alt fa-fw win11-icon text-primary"></i> Edit Document
    </Item>
    <Item class="win11-menu-item" OnClick="@((ItemClickEventArgs e) => OpenAttachments((e.Data as QMSDocumentExListItemDto)!))">
        <i class="fas fa-paperclip fa-fw win11-icon text-secondary"></i> Attachments
    </Item>
    <Item class="win11-menu-item" OnClick="@((ItemClickEventArgs e) => PrintDistributionListSingle((e.Data as QMSDocumentExListItemDto)!))">
        <i class="fas fa-print fa-fw win11-icon text-info"></i> Print Distribution List
    </Item>
    <Item class="win11-menu-item" OnClick="@((ItemClickEventArgs e) => ConfirmDelete((e.Data as QMSDocumentExListItemDto)!))">
        <i class="fas fa-trash fa-fw win11-icon text-danger"></i> Delete Document
    </Item>
</ContextMenu>

<!-- ── Delete Confirmation Modal ── -->
@if (showDeleteModal && itemToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.5); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
                <div class="modal-header py-2 px-3 border-bottom bg-danger-subtle text-danger">
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>Confirm Document Deletion
                    </h6>
                    <button type="button" class="btn-close" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body p-3">
                    <p class="mb-2">Are you sure you want to permanently delete this document and its distribution list?</p>
                    <div class="p-2 bg-light rounded border">
                        <div class="fw-bold text-dark">[@itemToDelete.DocumentNumber] @itemToDelete.DocumentName</div>
                        <small class="text-secondary">Category: @itemToDelete.Master_DocumentType | Type: @itemToDelete.DocumentType</small>
                    </div>
                    <small class="text-muted d-block mt-2">This action cannot be undone.</small>
                </div>
                <div class="modal-footer py-2 px-3 border-top">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseDeleteModal">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger btn-sm px-3" @onclick="ExecuteDelete">
                        <i class="fas fa-trash me-1"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Entity Attachment Modal ── -->
<AttachmentModal @ref="attachmentModalRef" />

<style>
    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 0.75rem;
        border-radius: 4px;
    }
    input.form-control-sm, .input-group-text, .btn-sm:not(.btn-xs) {
        height: 35px !important;
    }
</style>

