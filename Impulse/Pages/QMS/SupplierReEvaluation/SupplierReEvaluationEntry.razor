@page "/qms/supplier-reevaluations/new"
@page "/qms/supplier-reevaluations/edit/{Id:int}"
@attribute [Authorize]

@using Blazored.Typeahead
@using DataAccessLibrary.Models.QMS
@using Impulse.Components.Common

<PageTitle>@(isEditMode ? $"Edit Re-Evaluation #{Id}" : "New Supplier Re-Evaluation") - QMS</PageTitle>

<div class="container-fluid py-2" style="font-family: 'Calibri', 'Segoe UI', sans-serif;">
    <div class="card border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-radius: 12px;">
        <div class="card-body p-3">

            <!-- ── Top Header & Actions ── -->
            <div class="d-flex flex-wrap justify-content-between align-items-center pb-2 mb-3 border-bottom gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="fas fa-tasks fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark-emphasis">
                            @(isEditMode ? $"Edit Supplier Re-Evaluation #{Id}" : "New Supplier Re-Evaluation")
                        </h5>
                        <small class="text-muted">
                            @(string.IsNullOrWhiteSpace(model.AccTitle) ? "Periodic quality, performance and environmental audit" : $"[{model.AccNo}] {model.AccTitle}")
                        </small>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="NavigateBack">
                        <i class="fas fa-arrow-left me-1"></i> Back
                    </button>

                    <!-- Attachment Modal Trigger -->
                    <button type="button"
                            class="btn btn-outline-info btn-sm position-relative"
                            @onclick="OpenAttachmentModal"
                            disabled="@(model.EntryID == 0 && string.IsNullOrWhiteSpace(model.AccNo))"
                            title="Manage file attachments">
                        <i class="fas fa-paperclip me-1"></i> Attachments
                        @if (attachmentCount > 0)
                        {
                            <span class="badge bg-danger ms-1">@attachmentCount</span>
                        }
                    </button>

                    @if (isEditMode)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="PrintCurrentReEvaluation" title="Print Evaluation Slip">
                            <i class="fas fa-print me-1"></i> Print
                        </button>
                    }

                    <button type="button"
                            class="btn btn-primary btn-sm px-3"
                            @onclick="SaveReEvaluationAsync"
                            disabled="@(isSaving || string.IsNullOrWhiteSpace(model.AccNo))">
                        <i class="fas @(isSaving ? "fa-spinner fa-spin" : "fa-save") me-1"></i> Save Re-Evaluation
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                    Loading supplier re-evaluation...
                </div>
            }
            else
            {
                <!-- ── Top Info Card: Supplier, Review Date & Sign-Off ── -->
                <div class="card border rounded-3 p-3 bg-white shadow-none mb-3" style="position: relative !important; z-index: 9999 !important;">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label text-secondary fw-semibold small mb-1">
                                <i class="fas fa-store me-1 text-primary"></i> Select Maker / Vendor <span class="text-danger">*</span>
                            </label>
                            <BlazoredTypeahead SearchMethod="SearchSuppliers"
                                               EnableDropDown="true"
                                               Data="suppliers"
                                               TValue="SupplierDropdownDto"
                                               TItem="SupplierDropdownDto"
                                               Value="selectedSupplier"
                                               ValueChanged="@((SupplierDropdownDto? sup) => OnSupplierSelected(sup))"
                                               ValueExpression="@(() => selectedSupplier)"
                                               Disabled="@(isEditMode)"
                                               Placeholder="Select Maker or Vendor..."
                                               MaximumSuggestions="1000">
                                <SelectedTemplate Context="sup">
                                    @sup.DisplayText
                                </SelectedTemplate>
                                <ResultTemplate Context="sup">
                                    <div>
                                        <span class="badge @(sup.Vender == 1 ? "bg-info-subtle text-info border border-info-subtle" : "bg-secondary-subtle text-secondary border") me-1 font-monospace">
                                            @(sup.Vender == 1 ? "Vendor" : "Maker")
                                        </span>
                                        <span class="fw-bold text-dark font-monospace">[@sup.AccNo]</span>
                                        <span class="ms-1 text-secondary">@sup.AccTitle</span>
                                    </div>
                                </ResultTemplate>
                            </BlazoredTypeahead>
                        </div>

                        <div class="col-md-3 col-sm-6">
                            <label class="form-label text-secondary fw-semibold small mb-1">
                                <i class="fas fa-calendar-alt me-1 text-primary"></i> Review Date <span class="text-danger">*</span>
                            </label>
                            <input type="date"
                                   class="form-control form-control-sm"
                                   value="@(model.ReviewDT?.ToString("yyyy-MM-dd"))"
                                   @onchange="OnDateChanged" />
                        </div>

                        <!-- Live Score Summary Badge -->
                        <div class="col-md-4 col-sm-6 text-md-end">
                            <div class="p-2 border rounded-2 bg-light-subtle d-inline-block text-start">
                                <div class="d-flex align-items-center gap-3">
                                    <div>
                                        <div class="text-muted small" style="font-size: 0.72rem; text-transform: uppercase;">Total Score</div>
                                        <div class="fw-bold text-dark fs-6 font-monospace mb-0">
                                            @model.TotalScore <span class="text-muted fs-7">/ @model.MaxScore</span>
                                        </div>
                                    </div>
                                    <div class="border-start ps-3">
                                        <div class="text-muted small" style="font-size: 0.72rem; text-transform: uppercase;">Rating</div>
                                        <span class="badge @(model.ScorePercentage >= 80 ? "bg-success" : model.ScorePercentage >= 60 ? "bg-primary" : model.ScorePercentage >= 40 ? "bg-warning text-dark" : "bg-danger")">
                                            @model.ScorePercentage.ToString("F0")%
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sign-Off Row -->
                    <div class="row g-2 mt-2 pt-2 border-top">
                        <div class="col-md-4">
                            <label class="form-label text-secondary fw-semibold small mb-1">Prepared By</label>
                            <input type="text" class="form-control form-control-sm" @bind="model.PreparedBy" placeholder="Quality officer name..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-secondary fw-semibold small mb-1">Evaluated / Reviewed By</label>
                            <input type="text" class="form-control form-control-sm" @bind="model.ReviewBy" placeholder="Reviewer name..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-secondary fw-semibold small mb-1">Approved By</label>
                            <input type="text" class="form-control form-control-sm" @bind="model.ApprovedBy" placeholder="Approving authority..." />
                        </div>
                    </div>
                </div>

                <!-- ── Evaluation Criteria Breakdown ── -->
                <div class="row g-3" style="position: relative !important; z-index: 1 !important;">

                    <!-- 1. Quality Criteria (9 Items) -->
                    <div class="col-12">
                        <div class="card border rounded-3 p-3 bg-white shadow-none">
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                <h6 class="fw-bold text-dark mb-0 small text-uppercase">
                                    <i class="fas fa-check-double text-primary me-1"></i> 1. Quality Criteria
                                </h6>
                                <span class="text-muted small">Score range: 0 – 10 points per criterion</span>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                                    <thead class="table-light text-secondary" style="font-size: 0.75rem; text-transform: uppercase;">
                                        <tr>
                                            <th style="width: 40px;" class="text-center">#</th>
                                            <th style="width: 380px;">Audit / Evaluation Criterion</th>
                                            <th style="width: 120px;" class="text-center">Score (0-10)</th>
                                            <th>Comments &amp; Evidence Observations</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="text-center text-muted fw-bold">A</td>
                                            <td class="fw-semibold text-dark">Quality of Product (According to Specification)</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="10" class="form-control form-control-sm text-center fw-bold" @bind="model.QualityOfProduction" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="model.QualityOfProductionComments" placeholder="Product quality conformance notes..." />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-center text-muted fw-bold">B</td>
                                            <td class="fw-semibold text-dark">Price Competitiveness</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="10" class="form-control form-control-sm text-center fw-bold" @bind="model.Price" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="model.PriceComments" placeholder="Pricing stability and market comparison..." />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-center text-muted fw-bold">C</td>
                                            <td class="fw-semibold text-dark">Packing &amp; Protection</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="10" class="form-control form-control-sm text-center fw-bold" @bind="model.Packing" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="model.PackingComments" placeholder="Packaging condition upon arrival..." />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-center text-muted fw-bold">D</td>
                                            <td class="fw-semibold text-dark">Rejection Rate &lt; 10%</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="10" class="form-control form-control-sm text-center fw-bold" @bind="model.RejectionRate" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="model.RejectionRateComments" placeholder="Percentage rejected at incoming inspection..." />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-center text-muted fw-bold">E</td>
                                            <td class="fw-semibold text-dark">Delivery in Time (Must be &gt; 50%)</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="10" class="form-control form-control-sm text-center fw-bold" @bind="model.DeliveryInTime" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="model.DeliveryInTimeComments" placeholder="On-time delivery percentage history..." />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-center text-muted fw-bold">F</td>
                                            <td class="fw-semibold text-dark">Re-Work Rate &lt; 15%</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="10" class="form-control form-control-sm text-center fw-bold" @bind="model.ReWorkRate" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="model.ReWorkRateComments" placeholder="Internal or supplier rework instances..." />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-center text-muted fw-bold">G</td>
                                            <td class="fw-semibold text-dark">No. of Orders Completed &gt; 80%</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="10" class="form-control form-control-sm text-center fw-bold" @bind="model.NoOfOrdersCompleted" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="model.NoOfOrdersCompletedComments" placeholder="Completed PO fulfillment ratio..." />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-center text-muted fw-bold">H</td>
                                            <td class="fw-semibold text-dark">Cancelled Orders &lt; 20%</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="10" class="form-control form-control-sm text-center fw-bold" @bind="model.CancelledOrders" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="model.CancelledOrdersComments" placeholder="Orders cancelled due to default..." />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-center text-muted fw-bold">I</td>
                                            <td class="fw-semibold text-dark">Response Time &amp; Communication</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="10" class="form-control form-control-sm text-center fw-bold" @bind="model.ResponseTime" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="model.ResponseTimeComments" placeholder="Query turnaround and complaint responsiveness..." />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Performance Criteria (2 Items) -->
                    <div class="col-lg-6">
                        <div class="card border rounded-3 p-3 bg-white shadow-none h-100">
                            <h6 class="fw-bold text-dark mb-3 small text-uppercase border-bottom pb-2">
                                <i class="fas fa-cogs text-primary me-1"></i> 2. Performance Criteria
                            </h6>

                            <div class="table-responsive">
                                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                                    <thead class="table-light text-secondary" style="font-size: 0.75rem; text-transform: uppercase;">
                                        <tr>
                                            <th style="width: 35px;" class="text-center">#</th>
                                            <th style="width: 180px;">Criterion</th>
                                            <th style="width: 100px;" class="text-center">Score</th>
                                            <th>Comments</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="text-center text-muted fw-bold">A</td>
                                            <td class="fw-semibold text-dark">Technical Ability</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="10" class="form-control form-control-sm text-center fw-bold" @bind="model.TechnicalAbility" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="model.TechnicalAbilityComments" placeholder="Tooling, machinery, engineering..." />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-center text-muted fw-bold">B</td>
                                            <td class="fw-semibold text-dark">Production Capacity</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="10" class="form-control form-control-sm text-center fw-bold" @bind="model.ProductionCapacity" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="model.ProductionCapacityComments" placeholder="Output volume capability..." />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Environment System Criteria (2 Items) -->
                    <div class="col-lg-6">
                        <div class="card border rounded-3 p-3 bg-white shadow-none h-100">
                            <h6 class="fw-bold text-dark mb-3 small text-uppercase border-bottom pb-2">
                                <i class="fas fa-leaf text-success me-1"></i> 3. Environment &amp; Safety System
                            </h6>

                            <div class="table-responsive">
                                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.88rem;">
                                    <thead class="table-light text-secondary" style="font-size: 0.75rem; text-transform: uppercase;">
                                        <tr>
                                            <th style="width: 35px;" class="text-center">#</th>
                                            <th style="width: 180px;">Criterion</th>
                                            <th style="width: 100px;" class="text-center">Score</th>
                                            <th>Comments</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="text-center text-muted fw-bold">A</td>
                                            <td class="fw-semibold text-dark">Environment Requirements</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="10" class="form-control form-control-sm text-center fw-bold" @bind="model.EnvironmentRequirements" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="model.EnvironmentRequirementsComments" placeholder="Waste management &amp; legal compliance..." />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-center text-muted fw-bold">B</td>
                                            <td class="fw-semibold text-dark">Lighting &amp; Smoke-Free Facility</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="10" class="form-control form-control-sm text-center fw-bold" @bind="model.LightingEtc" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="model.LightingEtcComments" placeholder="Ventilation, lighting, emission-free..." />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            }

        </div>
    </div>
</div>

<!-- ── Entity Attachment Modal ── -->
<AttachmentModal @ref="attachmentModalRef" />

<style>
    .blazored-typeahead {
        height: 35px !important;
        min-height: 35px !important;
        font-size: 0.875rem !important;
        border: 1px solid #ced4da !important;
        border-radius: 0.375rem !important;
        background-color: #fff !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        display: flex !important;
        align-items: center !important;
        position: relative !important;
    }
    .blazored-typeahead:focus-within {
        border-color: #86b7fe !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
    }
    .blazored-typeahead__controls {
        height: 33px !important;
        min-height: 33px !important;
        width: 100% !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        background: transparent !important;
    }
    .blazored-typeahead__input {
        height: 31px !important;
        min-height: 31px !important;
        padding: 0 0.5rem !important;
        background: transparent !important;
        box-sizing: border-box !important;
        font-size: 0.875rem !important;
    }
    .blazored-typeahead__input-mask-wrapper {
        height: 33px !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow: hidden !important;
        background: transparent !important;
    }
    .blazored-typeahead__input-mask {
        height: 31px !important;
        line-height: 31px !important;
        display: block !important;
        box-sizing: border-box !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        background: transparent !important;
    }
    .blazored-typeahead__results {
        position: absolute !important;
        top: 100% !important;
        bottom: auto !important;
        left: 0 !important;
        right: auto !important;
        width: 100% !important;
        max-height: 280px !important;
        overflow-y: auto !important;
        margin-top: 2px !important;
        z-index: 10050 !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15) !important;
        border: 1px solid #ced4da !important;
        border-radius: 6px !important;
        background: #ffffff !important;
    }
    .blazored-typeahead__down-arrow path {
        fill: #6c757d !important;
    }
    .blazored-typeahead__input-icon:hover .blazored-typeahead__down-arrow path {
        fill: #212529 !important;
    }
    input.form-control-sm, select.form-select-sm, .input-group-text, .btn-sm {
        height: 35px !important;
    }
</style>

