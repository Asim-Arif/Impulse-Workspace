@page "/office/minutes-approval"
@page "/minutes-approval"
@using DataAccessLibrary.Models.IntraOffice
@using Impulse.Services.IntraOffice
@using System.Text.Json
@inject IMinuteApprovalService MinuteApprovalService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IIntraOfficeService IntraOfficeService
@inject IMessageService MessageService
@inject IMinuteTypeService MinuteTypeService
@inject IAiService AiService
@inject IJSRuntime JS

<PageTitle>IntraCom-CRM | Executive Minutes & Approval Form</PageTitle>

<div class="minutes-approval-page">

    <!-- 1. COMPACT GLASSMORPHIC HERO BANNER -->
    <div class="minutes-hero-banner-compact mb-2">
        <div class="banner-orb-glow-1"></div>
        <div class="banner-orb-glow-2"></div>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 position-relative">
            <div class="d-flex align-items-center gap-2">
                <a href="/minutes-list" class="btn btn-banner-back-sm" title="Back to Minutes Archive">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div class="banner-icon-orb-sm">
                    <i class="bi bi-file-earmark-text-fill"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h4 class="banner-title-sm mb-0">Executive Minutes & Approval</h4>
                        <span class="banner-live-badge-sm">
                            <span class="banner-live-dot"></span>
                            GOVERNANCE ENGINE • WORKFLOW ROUTING
                        </span>
                    </div>
                </div>
            </div>

            <!-- Integrated Meta Chips & Quick Actions -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="meta-chip-badge">
                    <i class="bi bi-hash text-primary"></i> Reference: <strong>#@minute.No</strong>
                </span>
                <span class="meta-chip-badge">
                    <i class="bi bi-tag-fill text-success"></i> Type: <strong>@(string.IsNullOrEmpty(minute.Type) ? "Unassigned" : minute.Type)</strong>
                </span>
                <a href="/minutes-list" class="btn btn-banner-action-sm">
                    <i class="bi bi-list-columns-reverse me-1"></i> Archive
                </a>
            </div>
        </div>
    </div>

    <!-- 2. MAIN FORM CONTAINER -->
    <EditForm EditContext="editContext">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-2 py-2 px-3 rounded-3 small border border-danger">
                <i class="bi bi-exclamation-octagon-fill fs-6"></i>
                <div>@errorMessage</div>
            </div>
        }

        <div class="row g-2">
            
            <!-- LEFT MAIN COLUMN: Session, Subject, Points & Attachments (8 Cols) -->
            <div class="col-xl-8 col-lg-7 col-12">
                
                <!-- Card 1: Session Details & Classification -->
                <div class="compact-glass-card mb-2 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="card-icon-tag bg-primary text-white">
                                <i class="bi bi-card-heading"></i>
                            </div>
                            <span class="card-title-sm mb-0">Session Details & Classification</span>
                        </div>
                        <span class="text-muted text-xs">Official Corporate Ledger Record</span>
                    </div>

                    <div class="row g-2">
                        <div class="col-sm-4 col-12">
                            <label class="compact-label">
                                <i class="bi bi-calendar3 me-1 text-primary"></i> Minute Date <span class="text-danger">*</span>
                            </label>
                            <InputDate class="form-control form-control-sm compact-input" @bind-Value="minute.Date" />
                        </div>

                        <div class="col-sm-4 col-6">
                            <label class="compact-label">
                                <i class="bi bi-hash me-1 text-primary"></i> Reference No. <span class="text-danger">*</span>
                            </label>
                            <InputText class="form-control form-control-sm compact-input fw-bold text-primary" @bind-Value="minute.No" />
                        </div>

                        <div class="col-sm-4 col-6">
                            <label class="compact-label">
                                <i class="bi bi-tag-fill me-1 text-primary"></i> Classification Type <span class="text-danger">*</span>
                            </label>
                            <InputSelect class="form-select form-select-sm compact-input" @bind-Value="minute.Type">
                                <option value="">-- Select Type --</option>
                                @foreach (var type in minuteTypes)
                                {
                                    <option value="@type.Name">@type.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <!-- Dynamic Classification Parameters (Compact) -->
                    @if (minute.Type == "Purchase")
                    {
                        <div class="dynamic-panel-compact purchase-panel mt-2 p-2 rounded-2">
                            <div class="d-flex align-items-center gap-1 mb-1 text-warning fw-bold text-xs">
                                <i class="bi bi-cart-check-fill"></i> Purchase Order Financial Parameters
                            </div>
                            <div class="row g-2">
                                <div class="col-4">
                                    <label class="compact-label text-xs mb-0">Total PO Value (PKR)</label>
                                    <InputNumber class="form-control form-control-sm compact-input" @bind-Value="minute.PurchaseOrderValue" placeholder="0.00" />
                                </div>
                                <div class="col-4">
                                    <label class="compact-label text-xs mb-0">Advance Rec. (PKR)</label>
                                    <InputNumber class="form-control form-control-sm compact-input" @bind-Value="minute.PurchaseAdvanceRecommend" placeholder="0.00" />
                                </div>
                                <div class="col-4">
                                    <label class="compact-label text-xs mb-0">Approved (PKR)</label>
                                    <InputNumber class="form-control form-control-sm compact-input" @bind-Value="minute.PurchaseApprovedAmount" placeholder="0.00" />
                                </div>
                            </div>
                        </div>
                    }
                    else if (minute.Type == "Stocks Requsition" || minute.Type == "Stock Requisition")
                    {
                        <div class="dynamic-panel-compact stocks-panel mt-2 p-2 rounded-2">
                            <div class="d-flex align-items-center gap-1 mb-1 text-info fw-bold text-xs">
                                <i class="bi bi-boxes"></i> Inventory & Stock Requisition Criteria
                            </div>
                            <div class="row g-2">
                                <div class="col-4">
                                    <label class="compact-label text-xs mb-0">Requested Qty</label>
                                    <InputNumber class="form-control form-control-sm compact-input" @bind-Value="minute.RequestedStockQty" placeholder="Units" />
                                </div>
                                <div class="col-4">
                                    <label class="compact-label text-xs mb-0">Current In-Stock</label>
                                    <InputNumber class="form-control form-control-sm compact-input" @bind-Value="minute.CurrentStockQty" placeholder="Units" />
                                </div>
                                <div class="col-4">
                                    <label class="compact-label text-xs mb-0">Approved Qty</label>
                                    <InputNumber class="form-control form-control-sm compact-input" @bind-Value="minute.ApprovedStockQty" placeholder="Units" />
                                </div>
                            </div>
                        </div>
                    }
                    else if (minute.Type == "HR")
                    {
                        <div class="dynamic-panel-compact hr-panel mt-2 p-2 rounded-2">
                            <div class="d-flex align-items-center gap-1 mb-1 text-danger fw-bold text-xs">
                                <i class="bi bi-person-badge-fill"></i> HR Leave Authorization
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <InputSelect class="form-select form-select-sm compact-input" @bind-Value="minute.HRLeaveType">
                                        <option value="">-- Select Leave Category --</option>
                                        <option value="Sick Leave">Sick Leave</option>
                                        <option value="Casual Leave">Casual Leave</option>
                                        <option value="Annual Leave">Annual Leave</option>
                                        <option value="Maternity Leave">Maternity Leave</option>
                                        <option value="Leave Without Pay">Leave Without Pay</option>
                                        <option value="Bereavement Leave">Bereavement Leave</option>
                                    </InputSelect>
                                </div>
                            </div>
                        </div>
                    }
                    else if (minute.Type == "Financial")
                    {
                        <div class="dynamic-panel-compact financial-panel mt-2 p-2 rounded-2">
                            <div class="d-flex align-items-center gap-1 mb-1 text-success fw-bold text-xs">
                                <i class="bi bi-cash-stack"></i> Financial Action Category
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <InputSelect class="form-select form-select-sm compact-input" @bind-Value="minute.FinancialType">
                                        <option value="">-- Select Action --</option>
                                        <option value="Payment to Payables">Payment to Payables</option>
                                        <option value="Budget Allocation">Budget Allocation</option>
                                        <option value="Capital Expenditure">Capital Expenditure</option>
                                        <option value="Others">Others</option>
                                    </InputSelect>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Card 2: Subject & Executive Agenda -->
                <div class="compact-glass-card mb-2 p-3">
                    <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-1">
                        <label class="compact-label mb-0">
                            <i class="bi bi-chat-left-quote-fill me-1 text-primary"></i> Minute Subject & Agenda <span class="text-danger">*</span>
                        </label>
                        <button type="button" class="btn btn-ai-polish-sm" @onclick="CheckSubjectSpelling" disabled="@isAiLoading">
                            @if (isAiLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>Refining...</span>
                            }
                            else
                            {
                                <i class="bi bi-magic me-1"></i>
                                <span>AI Polish Subject</span>
                            }
                        </button>
                    </div>

                    <InputText class="form-control form-control-sm compact-input" 
                               @bind-Value="minute.Subject" 
                               placeholder="e.g. Q4 Commercial Supplier Terms & Export Machinery Procurement" 
                               disabled="@isAiLoading" />
                    <ValidationMessage For="@(() => minute.Subject)" class="text-danger small mt-1" />
                </div>

                <!-- Card 3: Discussion Points & Resolutions Stream -->
                <div class="compact-glass-card mb-2 p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-1">
                        <div class="d-flex align-items-center gap-2">
                            <div class="card-icon-tag bg-success text-white">
                                <i class="bi bi-list-check"></i>
                            </div>
                            <span class="card-title-sm mb-0">Discussion Points & Resolutions</span>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-0 text-xs">
                                @pointItems.Count Added
                            </span>
                        </div>
                        <button type="button" class="btn btn-ai-polish-sm" @onclick="CheckPointSpelling" disabled="@isAiLoading">
                            <i class="bi bi-magic me-1"></i> AI Polish Points
                        </button>
                    </div>

                    <!-- Add Point Input Bar -->
                    <div class="d-flex gap-2 mb-2">
                        <input type="text" class="form-control form-control-sm compact-input flex-grow-1" 
                               @bind="newPointText" 
                               @bind:event="oninput" 
                               placeholder="Type point or resolution (Press Enter to add)..." 
                               @onkeypress="HandlePointKeyPress" 
                               disabled="@isAiLoading" />
                        <button type="button" class="btn btn-add-point-sm px-3 fw-bold" 
                                @onclick="AddPoint" 
                                disabled="@(string.IsNullOrWhiteSpace(newPointText) || isAiLoading)">
                            <i class="bi bi-plus-circle-fill me-1"></i> Add Point
                        </button>
                    </div>

                    <!-- Scrollable Points Stream -->
                    @if (pointItems.Any())
                    {
                        <div class="compact-points-scroll d-flex flex-column gap-1">
                            @for (int i = 0; i < pointItems.Count; i++)
                            {
                                var idx = i;
                                var pt = pointItems[idx];
                                <div class="compact-point-row d-flex align-items-center justify-content-between gap-2 px-2 py-1 rounded-2 border">
                                    <div class="d-flex align-items-center gap-2 text-truncate">
                                        <span class="compact-point-pill">@(idx + 1 < 10 ? $"0{idx + 1}" : (idx + 1).ToString())</span>
                                        <span class="compact-point-text text-truncate">@pt</span>
                                    </div>
                                    <button type="button" class="btn btn-point-del-sm p-0 text-danger" 
                                            title="Delete Point" 
                                            @onclick="() => pointItems.RemoveAt(idx)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="compact-empty-deck py-2 px-3 text-center rounded-2">
                            <span class="text-muted text-xs">
                                <i class="bi bi-card-checklist me-1"></i> No points added yet. Type resolution above and press Enter.
                            </span>
                        </div>
                    }
                </div>

                <!-- Card 4: Multi-File Regulatory Attachments Matrix (4x2 Compact Grid) -->
                <div class="compact-glass-card mb-2 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="card-icon-tag bg-info text-white">
                                <i class="bi bi-paperclip"></i>
                            </div>
                            <span class="card-title-sm mb-0">Regulatory Attachments Matrix (Slots I - VIII)</span>
                        </div>
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-0 rounded-pill text-xs">
                            @attachments.Count / 8 Slots Active
                        </span>
                    </div>

                    <div class="row g-2">
                        @for (int i = 0; i < 8; i++)
                        {
                            var slotIndex = i;
                            var roman = GetRomanNumeral(slotIndex + 1);
                            var hasFile = attachments.ContainsKey(slotIndex);
                            var file = hasFile ? attachments[slotIndex] : null;

                            <div class="col-md-3 col-6">
                                <div class="compact-slot-pill @(hasFile ? "slot-filled" : "") p-2 rounded-2 border d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2 text-truncate flex-grow-1">
                                        <span class="slot-roman-badge">@roman</span>
                                        @if (hasFile && file != null)
                                        {
                                            <div class="text-truncate">
                                                <div class="fw-bold text-dark text-truncate text-xs" title="@file.Name">@file.Name</div>
                                                <div class="text-success text-xxs">@((file.Size / 1024.0).ToString("F0")) KB</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <label for="@($"file-{slotIndex}")" class="slot-click-upload mb-0 text-truncate text-xs text-primary" style="cursor: pointer;">
                                                <i class="bi bi-upload me-1"></i> Upload
                                            </label>
                                        }
                                    </div>

                                    @if (hasFile)
                                    {
                                        <button type="button" class="btn btn-slot-clear-sm p-0 ms-1 text-danger" title="Clear slot" @onclick="() => RemoveAttachment(slotIndex)">
                                            <i class="bi bi-x-circle-fill"></i>
                                        </button>
                                    }
                                    <InputFile id="@($"file-{slotIndex}")" OnChange="@((e) => HandleFileSelected(e, slotIndex))" style="display: none;" />
                                </div>
                            </div>
                        }
                    </div>
                </div>

            </div>

            <!-- RIGHT SIDEBAR: Routing, Flags, Protocol & Actions (4 Cols) -->
            <div class="col-xl-4 col-lg-5 col-12">
                
                <!-- Card 1: Forward To Signee & Governance Switches -->
                <div class="compact-glass-card mb-2 p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="card-icon-tag bg-indigo text-white">
                            <i class="bi bi-person-check-fill"></i>
                        </div>
                        <span class="card-title-sm mb-0">Approval Routing & Hierarchy</span>
                    </div>

                    <div class="mb-2">
                        <label class="compact-label mb-1">
                            Forward To Signee <span class="text-danger">*</span>
                        </label>
                        <InputSelect class="form-select form-select-sm compact-input" @bind-Value="minute.ForwardToUserId">
                            <option value="">-- Select Assignee --</option>
                            @foreach (var u in users)
                            {
                                <option value="@u.Id">@u.FullName (@(u.JobTitle ?? u.Email))</option>
                            }
                        </InputSelect>
                    </div>

                    @if (!string.IsNullOrEmpty(minute.ForwardToUserId))
                    {
                        var assignedUser = users.FirstOrDefault(u => u.Id == minute.ForwardToUserId);
                        if (assignedUser != null)
                        {
                            <div class="compact-assignee-pill p-2 rounded-2 border d-flex align-items-center gap-2 mb-2">
                                <div class="assignee-avatar-sm">
                                    @(assignedUser.FullName?.Length > 0 ? assignedUser.FullName[0].ToString().ToUpper() : "U")
                                </div>
                                <div class="text-truncate flex-grow-1">
                                    <div class="fw-bold text-dark text-xs text-truncate">@assignedUser.FullName</div>
                                    <div class="text-muted text-xxs text-truncate">@(assignedUser.JobTitle ?? "Approver")</div>
                                </div>
                                <span class="badge bg-success bg-opacity-15 text-success text-xxs border border-success border-opacity-25 rounded-pill px-2">
                                    WhatsApp Alert
                                </span>
                            </div>
                        }
                    }

                    <!-- Dual Switches in 1 Compact Row -->
                    <div class="row g-2 p-2 rounded-2 bg-light border mb-0">
                        <div class="col-6">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="urgentSwitch" @bind="minute.IsUrgent" />
                                <label class="form-check-label fw-bold text-dark text-xs" for="urgentSwitch">
                                    <span class="text-danger">🔥 Urgent</span>
                                </label>
                            </div>
                            <small class="text-muted text-xxs d-block">Priority review</small>
                        </div>
                        <div class="col-6">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="closeSwitch" @bind="minute.CloseByInitiator" />
                                <label class="form-check-label fw-bold text-dark text-xs" for="closeSwitch">
                                    <span class="text-secondary">🔒 Close Self</span>
                                </label>
                            </div>
                            <small class="text-muted text-xxs d-block">Auto-close signoff</small>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Executive Protocol Info Deck (Compact) -->
                <div class="compact-protocol-card mb-2 p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-shield-check text-success fs-6"></i>
                        <span class="fw-bold text-white text-xs">Governance Protocol Summary</span>
                    </div>

                    <ul class="compact-protocol-list list-unstyled mb-0 text-xxs">
                        <li class="d-flex align-items-center gap-2 mb-1 text-light text-opacity-90">
                            <i class="bi bi-check2 text-success"></i> Instant WhatsApp & In-App dispatch
                        </li>
                        <li class="d-flex align-items-center gap-2 mb-1 text-light text-opacity-90">
                            <i class="bi bi-check2 text-success"></i> Cryptographic signatures with audit trail
                        </li>
                        <li class="d-flex align-items-center gap-2 text-light text-opacity-90">
                            <i class="bi bi-check2 text-success"></i> Auto-compiled official PDF dossier
                        </li>
                    </ul>
                </div>

                <!-- Card 3: Form Action Controls (Compact Dock) -->
                <div class="compact-action-dock p-3 rounded-3 border bg-white shadow-sm">
                    <!-- Primary Submit Button -->
                    <button type="button" class="btn btn-submit-primary-compact w-100 py-2 fw-bold shadow-sm mb-2" 
                            @onclick="() => TriggerSubmit(SaveAction.Close)" 
                            disabled="@isSaving">
                        @if (isSaving && saveAction == SaveAction.Close)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Submitting...</span>
                        }
                        else
                        {
                            <i class="bi bi-send-check-fill me-1"></i>
                            <span>Submit & Route for Approval</span>
                        }
                    </button>

                    <!-- Secondary Fast Actions -->
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-secondary w-100 rounded-pill py-1 fw-semibold text-xs" 
                                    @onclick="() => TriggerSubmit(SaveAction.Stay)" 
                                    disabled="@isSaving">
                                <i class="bi bi-save me-1"></i> Save & Stay
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-primary w-100 rounded-pill py-1 fw-semibold text-xs" 
                                    @onclick="() => TriggerSubmit(SaveAction.New)" 
                                    disabled="@isSaving">
                                <i class="bi bi-plus-circle me-1"></i> Save & New
                            </button>
                        </div>
                    </div>

                    <button type="button" class="btn btn-link text-muted text-decoration-none w-100 p-0 text-center text-xs" 
                            @onclick="Cancel" 
                            disabled="@isSaving">
                        <i class="bi bi-x-circle me-1"></i> Cancel & Return to Archive
                    </button>
                </div>

            </div>

        </div>
    </EditForm>

</div>

<style>
    /* PAGE CONTAINER */
    .minutes-approval-page {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 4px 10px 24px 10px;
        box-sizing: border-box;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .text-xxs {
        font-size: 0.72rem !important;
    }

    /* 1. COMPACT HERO BANNER */
    .minutes-hero-banner-compact {
        background: linear-gradient(135deg, #090d16 0%, #111827 45%, #1e1b4b 100%);
        border-radius: 12px;
        padding: 0.75rem 1.25rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 20px -6px rgba(15, 23, 42, 0.4), 0 0 15px rgba(99, 102, 241, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .banner-orb-glow-1 {
        position: absolute;
        top: -60px;
        left: -60px;
        width: 200px;
        height: 200px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.35) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    .banner-orb-glow-2 {
        position: absolute;
        bottom: -60px;
        right: 15%;
        width: 200px;
        height: 200px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.2) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .btn-banner-back-sm {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        transition: all 0.2s;
        text-decoration: none;
    }
    .btn-banner-back-sm:hover {
        background: rgba(255, 255, 255, 0.25);
        color: #ffffff;
        transform: translateX(-2px);
    }

    .banner-icon-orb-sm {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: linear-gradient(135deg, #4f46e5, #818cf8);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 1.1rem;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.35);
    }

    .banner-title-sm {
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: -0.3px;
        color: #ffffff;
    }

    .banner-live-badge-sm {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: #34d399;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        padding: 2px 8px;
        border-radius: 9999px;
    }

    .banner-live-dot {
        width: 6px;
        height: 6px;
