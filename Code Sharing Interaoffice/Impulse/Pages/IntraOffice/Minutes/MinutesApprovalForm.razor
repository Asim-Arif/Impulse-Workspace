@code {
    private MinuteApproval minute = new MinuteApproval { Date = DateTime.Today, No = $"{DateTime.Today.Month}/{new Random().Next(100, 9999).ToString("D4")}" };
    private List<IntraUserProfile> users = new();
    private List<MinuteType> minuteTypes = new();
    private Dictionary<int, IBrowserFile> attachments = new();
    private bool isSaving = false;
    private SaveAction saveAction = SaveAction.Stay;
    private string? currentUserId;
    private string? errorMessage;
    private EditContext? editContext;
    
    private string newPointText = "";
    private List<string> pointItems = new();
    private bool isAiLoading = false;

    private enum SaveAction { Stay, New, Close }

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(minute);
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserId = user.Identity?.Name
            ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? user.FindFirst("sub")?.Value;

        var rawUsers = await IntraOfficeService.GetActiveUsersAsync();
        users = rawUsers.OrderBy(u => u.FullName).ToList();
        minuteTypes = await MinuteTypeService.GetActiveAsync();
        
        CalculateAdvanceAmount();
    }
    
    private void CalculateAdvanceAmount()
    {
        minute.AdvanceAmount = (minute.TotalAmount ?? 0) * ((minute.AdvancePercentage ?? 0) / 100m);
    }
    
    private void HandlePointKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddPoint();
        }
    }
    
    private void AddPoint()
    {
        if (!string.IsNullOrWhiteSpace(newPointText))
        {
            pointItems.Add(newPointText.Trim());
            newPointText = "";
        }
    }

    private async Task CheckSubjectSpelling()
    {
        if (string.IsNullOrWhiteSpace(minute.Subject)) return;
        isAiLoading = true;
        StateHasChanged();
        try
        {
            minute.Subject = await AiService.CheckSpellingAndGrammarAsync(minute.Subject);
        }
        catch (Exception ex)
        {
            errorMessage = "AI Error: " + ex.Message;
        }
        isAiLoading = false;
        StateHasChanged();
    }

    private async Task CheckPointSpelling()
    {
        if (string.IsNullOrWhiteSpace(newPointText) && !pointItems.Any()) return;
        isAiLoading = true;
        StateHasChanged();
        try
        {
            if (!string.IsNullOrWhiteSpace(newPointText))
            {
                newPointText = await AiService.CheckSpellingAndGrammarAsync(newPointText);
            }
            else if (pointItems.Any())
            {
                for (int i = 0; i < pointItems.Count; i++)
                {
                    pointItems[i] = await AiService.CheckSpellingAndGrammarAsync(pointItems[i]);
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "AI Error: " + ex.Message;
        }
        isAiLoading = false;
        StateHasChanged();
    }

    private void HandleFileSelected(InputFileChangeEventArgs e, int index)
    {
        attachments[index] = e.File;
    }

    private void RemoveAttachment(int index)
    {
        attachments.Remove(index);
    }

    private async Task TriggerSubmit(SaveAction action)
    {
        saveAction = action;
        if (editContext != null && editContext.Validate())
        {
            await SaveMinute();
        }
        else
        {
            StateHasChanged();
        }
    }

    private async Task SaveMinute()
    {
        errorMessage = null;
        if (string.IsNullOrEmpty(currentUserId)) return;
        
        isSaving = true;
        try
        {
            minute.CreatedByUserId = currentUserId;
            
            // Serialize points to JSON
            if (pointItems.Any())
            {
                minute.Points = JsonSerializer.Serialize(pointItems);
            }
            else
            {
                minute.Points = "";
            }
            
            CalculateAdvanceAmount();

            var filesToUpload = attachments.Values.ToList();
            await MinuteApprovalService.CreateMinuteAsync(minute, filesToUpload, null);

            // Send Alert to the assigned user
            if (!string.IsNullOrEmpty(minute.ForwardToUserId))
            {
                var content = $"You have a new Minute ({minute.No}) pending your approval.\n\n[Click here to view Minute Approval](/minutes-workflow/{minute.Id})";
                await MessageService.SendMessageAsync(new Message
                {
                    SenderId = currentUserId,
                    ReceiverId = minute.ForwardToUserId,
                    Content = content,
                    SentAt = DateTime.UtcNow
                });
            }

            if (saveAction == SaveAction.New)
            {
                minute = new MinuteApproval { Date = DateTime.Today, No = $"{DateTime.Today.Month}/{new Random().Next(100, 9999).ToString("D4")}" };
                attachments.Clear();
                pointItems.Clear();
                newPointText = "";
                editContext = new EditContext(minute);
            }
            else if (saveAction == SaveAction.Close)
            {
                Navigation.NavigateTo("/minutes-list");
            }
            // If Stay, we keep the form as is
        }
        catch (Exception ex)
        {
            errorMessage = "Error saving minutes: " + ex.Message;
            Console.WriteLine(errorMessage);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/minutes-list");
    }

    private string GetRomanNumeral(int number)
    {
        if (number < 1 || number > 8) return number.ToString();
        string[] romans = { "I", "II", "III", "IV", "V", "VI", "VII", "VIII" };
        return romans[number - 1];
    }
}
