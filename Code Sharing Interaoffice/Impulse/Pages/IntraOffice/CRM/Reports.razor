@page "/reports"
@page "/office/reports"
@using DataAccessLibrary.Models.IntraOffice
@using Impulse.Services.IntraOffice
@inject ICrmService CrmSvc
@inject IJSRuntime JS

<PageTitle>Reports & Business Analytics - IntraCom CRM</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 no-print">
    <div>
        <h4 class="fw-bold mb-1">Executive Reports & Export Intelligence</h4>
        <p class="text-muted text-xs mb-0" style="font-size: 0.85rem;">Multi-dimensional analytics for sales performance, container volumes, AR aging, and quality rejection metrics</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print Report
        </button>
        <button class="btn btn-success btn-sm rounded-pill px-3 shadow-sm" @onclick="ExportCsv">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </button>
    </div>
</div>

<!-- Report Navigation Tabs -->
<div class="d-flex gap-2 mb-4 no-print flex-wrap">
    <button class="btn btn-sm rounded-pill px-3 fw-semibold @(activeReport == "sales" ? "btn-primary shadow-sm" : "btn-outline-secondary")" @onclick='() => SetActiveTab("sales")'>
        <i class="bi bi-bar-chart me-1"></i> Sales by Country & Product
    </button>
    <button class="btn btn-sm rounded-pill px-3 fw-semibold @(activeReport == "rep" ? "btn-primary shadow-sm" : "btn-outline-secondary")" @onclick='() => SetActiveTab("rep")'>
        <i class="bi bi-person-lines-fill me-1"></i> Salesperson Performance
    </button>
    <button class="btn btn-sm rounded-pill px-3 fw-semibold @(activeReport == "aging" ? "btn-primary shadow-sm" : "btn-outline-secondary")" @onclick='() => SetActiveTab("aging")'>
        <i class="bi bi-cash-coin me-1"></i> Accounts Receivable Aging
    </button>
    <button class="btn btn-sm rounded-pill px-3 fw-semibold @(activeReport == "qc" ? "btn-primary shadow-sm" : "btn-outline-secondary")" @onclick='() => SetActiveTab("qc")'>
        <i class="bi bi-patch-check me-1"></i> Quality & Defect Rates
    </button>
</div>

@if (metrics == null)
{
    <div class="p-5 text-center">
        <div class="spinner-border text-primary" role="status"></div>
        <div class="mt-2 text-muted">Calculating reports and metrics...</div>
    </div>
}
else
{
    @if (activeReport == "sales")
    {
        <div class="row g-4">
            <!-- Left: Sales by Country -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 14px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
                    <div class="card-header bg-transparent border-bottom p-3">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-globe text-primary me-2"></i>Export Revenue Breakdown by Country
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div style="height: 220px; position: relative;" class="mb-3">
                            <canvas id="reportCountryChart"></canvas>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                <thead class="table-light text-secondary" style="font-size: 0.78rem; text-transform: uppercase;">
                                    <tr>
                                        <th>Destination Country</th>
                                        <th class="text-center">Deals</th>
                                        <th class="text-end">Revenue</th>
                                        <th class="text-end">Share %</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sc in metrics.SalesByCountry)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">@sc.Country</td>
                                            <td class="text-center font-monospace">@sc.OrderCount</td>
                                            <td class="text-end fw-bold text-dark">@sc.TotalAmount.ToString("C0")</td>
                                            <td class="text-end text-primary fw-bold">@sc.Percentage%</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Sales by Product -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 14px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
                    <div class="card-header bg-transparent border-bottom p-3">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-box-seam text-success me-2"></i>Top Manufactured Product Lines by Sales
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                <thead class="table-light text-secondary" style="font-size: 0.78rem; text-transform: uppercase;">
                                    <tr>
                                        <th>Product SKU</th>
                                        <th>Description</th>
                                        <th class="text-center">Units Sold</th>
                                        <th class="text-end">Gross Sales</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sp in metrics.SalesByProduct)
                                    {
                                        <tr>
                                            <td><span class="badge bg-light text-dark border font-monospace" style="font-size: 0.75rem;">@sp.SKU</span></td>
                                            <td class="fw-semibold text-dark">@sp.ProductName</td>
                                            <td class="text-center fw-bold">@sp.TotalQuantity.ToString("N0")</td>
                                            <td class="text-end fw-bold text-success">@sp.TotalRevenue.ToString("C0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (activeReport == "rep")
    {
        <div class="card border-0 shadow-sm" style="border-radius: 14px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
            <div class="card-header bg-transparent border-bottom p-3">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-people text-primary me-2"></i>Commercial Team Conversion & Sales Leaderboard
                </h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light text-secondary" style="font-size: 0.78rem; text-transform: uppercase;">
                            <tr>
                                <th>Sales Representative</th>
                                <th class="text-center">Assigned Leads</th>
                                <th class="text-center">Quotations Issued</th>
                                <th class="text-center">Won Orders</th>
                                <th class="text-end">Closed Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rep in metrics.SalespersonStats)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">
                                        <i class="bi bi-person-circle text-primary me-2"></i>@rep.SalespersonName
                                    </td>
                                    <td class="text-center font-monospace">@rep.LeadsCount</td>
                                    <td class="text-center font-monospace">@rep.QuotationsCount</td>
                                    <td class="text-center fw-bold text-success font-monospace">@rep.OrdersCount</td>
                                    <td class="text-end fw-bold text-dark">@rep.ClosedRevenue.ToString("C0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (activeReport == "aging" && agingSummary != null)
    {
        <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 14px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
            <h6 class="fw-bold mb-3 text-dark">
                <i class="bi bi-bar-chart text-primary me-2"></i>Accounts Receivable Aging Distribution
            </h6>
            <div style="height: 240px; position: relative;" class="mb-4">
                <canvas id="reportAgingChart"></canvas>
            </div>
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="p-3 border rounded-3 text-center bg-light">
                        <div class="text-muted text-xs text-uppercase fw-semibold" style="font-size: 0.75rem;">Current (Not Due)</div>
                        <div class="fs-4 fw-bold text-success mt-1">@agingSummary.CurrentNotDue.ToString("C0")</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 border rounded-3 text-center bg-light">
                        <div class="text-muted text-xs text-uppercase fw-semibold" style="font-size: 0.75rem;">1 - 30 Days Overdue</div>
                        <div class="fs-4 fw-bold text-info mt-1">@agingSummary.Days1To30.ToString("C0")</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 border rounded-3 text-center bg-light">
                        <div class="text-muted text-xs text-uppercase fw-semibold" style="font-size: 0.75rem;">31 - 60 Days Overdue</div>
                        <div class="fs-4 fw-bold text-warning mt-1">@agingSummary.Days31To60.ToString("C0")</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 border rounded-3 text-center bg-danger bg-opacity-10 border-danger border-opacity-25">
                        <div class="text-danger text-xs text-uppercase fw-bold" style="font-size: 0.75rem;">60+ Days Overdue</div>
                        <div class="fs-4 fw-bold text-danger mt-1">@((agingSummary.Days61To90 + agingSummary.Days90Plus).ToString("C0"))</div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (activeReport == "qc")
    {
        <div class="card border-0 shadow-sm p-4" style="border-radius: 14px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
            <h6 class="fw-bold mb-3 text-dark">
                <i class="bi bi-shield-check text-success me-2"></i>Quality Assurance & Rejection Rate Metrics
            </h6>
            <div class="alert alert-info border-0 rounded-3 mb-4">
                <i class="bi bi-shield-check me-2"></i> Overall Plant First-Pass Yield is <strong>99.1%</strong> across all product batches. 0.9% rework rate addressed before container departure.
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="p-3 border rounded-3 text-center bg-light">
                        <div class="text-muted text-xs text-uppercase fw-semibold" style="font-size: 0.75rem;">First Pass Yield</div>
                        <div class="fs-3 fw-bold text-success mt-1">99.1%</div>
                        <span class="text-muted text-xs">Exceeds 98.5% plant target</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 border rounded-3 text-center bg-light">
                        <div class="text-muted text-xs text-uppercase fw-semibold" style="font-size: 0.75rem;">Pre-Shipment Inspections</div>
                        <div class="fs-3 fw-bold text-primary mt-1">100%</div>
                        <span class="text-muted text-xs">Zero uncertified container departures</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 border rounded-3 text-center bg-light">
                        <div class="text-muted text-xs text-uppercase fw-semibold" style="font-size: 0.75rem;">Customer RMA / Rejections</div>
                        <div class="fs-3 fw-bold text-danger mt-1">0.0%</div>
                        <span class="text-muted text-xs">Zero post-arrival warranty claims in Q3</span>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private DashboardMetricsDto? metrics;
    private ARAgingSummaryDto? agingSummary;
    private string activeReport = "sales";

    protected override async Task OnInitializedAsync()
    {
        metrics = await CrmSvc.GetDashboardMetricsAsync();
        agingSummary = await CrmSvc.GetARAgingSummaryAsync();
    }

    private async Task SetActiveTab(string tab)
    {
        activeReport = tab;
        StateHasChanged();
        await Task.Delay(100);
        await RenderActiveChart();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(200);
            await RenderActiveChart();
        }
    }

    private async Task RenderActiveChart()
    {
        try
        {
            if (activeReport == "sales" && metrics != null && metrics.SalesByCountry.Any())
            {
                var countryLabels = metrics.SalesByCountry.Select(c => c.Country).ToArray();
                var countryData = metrics.SalesByCountry.Select(c => (double)c.TotalAmount).ToArray();
                await JS.InvokeVoidAsync("crmCharts.renderCountryChart", "reportCountryChart", countryLabels, countryData);
            }
            else if (activeReport == "aging" && agingSummary != null)
            {
                var agingLabels = new[] { "Current", "1-30 Days", "31-60 Days", "61-90 Days", "90+ Days" };
                var agingData = new double[] {
                    (double)agingSummary.CurrentNotDue,
                    (double)agingSummary.Days1To30,
                    (double)agingSummary.Days31To60,
                    (double)agingSummary.Days61To90,
                    (double)agingSummary.Days90Plus
                };
                await JS.InvokeVoidAsync("crmCharts.renderAgingChart", "reportAgingChart", agingLabels, agingData);
            }
        }
        catch
        {
            // Prerendering fallback
        }
    }

    private async Task ExportCsv()
    {
        if (metrics == null) return;
        var csv = "Country,Orders,TotalAmount,Percentage\n";
        foreach (var sc in metrics.SalesByCountry)
        {
            csv += $"{sc.Country},{sc.OrderCount},{sc.TotalAmount},{sc.Percentage}%\n";
        }
        await JS.InvokeVoidAsync("alert", "Export Report Generated:\n\n" + csv);
    }
}
