@code {
    private IntraUserProfile? currentUser;
    private int unreadMessages;
    private int channelCount;
    private int announcementCount;
    private int pendingTasks;
    private int upcomingMeetingsCount;
    private int pendingMinutes;
    private List<Announcement>? recentAnnouncements;
    private List<TaskItem>? myTasks;
    private List<Meeting>? upcomingMeetings;
    private List<StickyNote>? upcomingReminders;

    [SupplyParameterFromForm]
    private string newReminderContent { get; set; } = "";

    [SupplyParameterFromForm]
    private DateTime newReminderTime { get; set; } = DateTime.Now.AddHours(1);

    private string whatsAppStatus = "INITIALIZING";
    private string whatsAppErrorMessage = "this may take a few moments";
    private string? whatsAppQrUrl;
    private bool _isDisposed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userPrincipal = authState.User;
            string? userId = userPrincipal.Identity?.Name;

            if (!string.IsNullOrEmpty(userId))
            {
                currentUser = await IntraOfficeService.GetUserProfileAsync(userId);
                if (currentUser == null)
                {
                    currentUser = new IntraUserProfile { UserName = userId, FullUserName = userId };
                }

                var channels = await IntraOfficeService.GetChannelsForUserAsync(userId);
                channelCount = channels.Count;
                recentAnnouncements = await IntraOfficeService.GetAnnouncementsAsync(userId);
                announcementCount = recentAnnouncements.Count;
                myTasks = await IntraOfficeService.GetTasksAsync(assignedTo: userId);
                pendingTasks = myTasks.Count(t => t.Status == TaskItemStatus.Pending || t.Status == TaskItemStatus.InProgress);
                upcomingMeetings = await IntraOfficeService.GetMeetingsForUserAsync(userId);
                upcomingMeetingsCount = upcomingMeetings.Count;

                var minList = await IntraOfficeService.GetMinutesAsync(new MinuteFilter { ForwardToUserId = userId, Status = "Pending" });
                pendingMinutes = minList.Count;

                var allNotes = await IntraOfficeService.GetStickyNotesAsync(userId);
                upcomingReminders = allNotes
                    .Where(s => s.ReminderTime != null && s.ReminderTime > DateTime.UtcNow)
                    .OrderBy(s => s.ReminderTime)
                    .Take(5)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing OfficeDashboard data");
        }

        await CheckWhatsAppStatus();
        _ = StartWhatsAppPoller();
    }

    private async Task StartWhatsAppPoller()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
            while (!_isDisposed && await timer.WaitForNextTickAsync())
            {
                if (whatsAppStatus == "CONNECTED")
                {
                    await Task.Delay(TimeSpan.FromSeconds(26));
                }
                await CheckWhatsAppStatus();
            }
        }
        catch
        {
            // Ignore timer teardown
        }
    }

    private bool taskChartRendered = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (myTasks != null && (!taskChartRendered || firstRender))
        {
            await RenderOfficeTaskChartAsync();
        }
    }

    private async Task RenderOfficeTaskChartAsync()
    {
        if (myTasks == null) return;
        int p = myTasks.Count(t => t.Status == TaskItemStatus.Pending);
        int ip = myTasks.Count(t => t.Status == TaskItemStatus.InProgress);
        int c = myTasks.Count(t => t.Status == TaskItemStatus.Completed);
        try
        {
            await JS.InvokeVoidAsync("crmCharts.renderOfficeTaskChart", "officeTaskChart", p, ip, c);
            taskChartRendered = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not render office task doughnut chart");
        }
    }

    private void NavigateToAi(string prompt)
    {
        Nav.NavigateTo($"/office/ai-assistant?prompt={Uri.EscapeDataString(prompt)}");
    }

    private async Task CheckWhatsAppStatus()
    {
        try
        {
            using var http = new HttpClient();
            http.Timeout = TimeSpan.FromSeconds(2);
            var response = await http.GetAsync("http://127.0.0.1:3001/qr");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var doc = System.Text.Json.JsonDocument.Parse(json);
                
                string? parsedStatus = null;
                string? parsedQr = null;

                if (doc.RootElement.TryGetProperty("status", out var statusEl))
                {
                    parsedStatus = statusEl.GetString();
                }
                if (doc.RootElement.TryGetProperty("qr", out var qrEl) && qrEl.ValueKind != System.Text.Json.JsonValueKind.Null)
                {
                    parsedQr = qrEl.GetString();
                }

                whatsAppStatus = parsedStatus ?? "INITIALIZING";
                whatsAppQrUrl = parsedQr;
                whatsAppErrorMessage = "";
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                whatsAppStatus = "DISCONNECTED";
                whatsAppErrorMessage = $"HTTP {(int)response.StatusCode}";
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            whatsAppStatus = "DISCONNECTED";
            whatsAppErrorMessage = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string? reminderErrorMessage;

    private async Task AddReminder()
    {
        reminderErrorMessage = null;
        try
        {
            if (string.IsNullOrWhiteSpace(newReminderContent) || currentUser == null)
            {
                reminderErrorMessage = "Please enter a reminder and ensure you are logged in.";
                StateHasChanged();
                return;
            }
            
            var note = new StickyNote
            {
                UserId = currentUser.UserName,
                Content = newReminderContent,
                ReminderTime = newReminderTime.ToUniversalTime(),
                Color = "yellow",
                XPos = -1,
                YPos = -1
            };
            note.Id = await IntraOfficeService.SaveStickyNoteAsync(note);
            
            if (upcomingReminders == null) upcomingReminders = new();
            upcomingReminders.Add(note);
            upcomingReminders = upcomingReminders.OrderBy(r => r.ReminderTime).Take(5).ToList();
            
            newReminderContent = "";
            newReminderTime = DateTime.Now.AddHours(1);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving reminder");
            reminderErrorMessage = $"Error saving reminder: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task DeleteReminder(StickyNote note)
    {
        await IntraOfficeService.DeleteStickyNoteAsync(note.Id, currentUser?.UserName ?? "");
        upcomingReminders?.RemoveAll(r => r.Id == note.Id);
    }

    public void Dispose()
    {
        _isDisposed = true;
    }
}
