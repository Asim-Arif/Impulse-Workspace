@page "/office/hub"
@page "/intraoffice/hub"
@page "/intraoffice/dashboard"
@layout IntraOfficeLayout
@attribute [Authorize]
@using DataAccessLibrary.Models.IntraOffice
@using Impulse.Services.IntraOffice
@inject AuthenticationStateProvider AuthStateProvider
@inject IIntraOfficeService IntraOfficeService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<OfficeHub> Logger
@implements IDisposable

<PageTitle>IntraCom-CRM | Office Collaboration Hub</PageTitle>

<div class="office-hub-wrapper">

    <!-- 1. HERO OFFICE COLLABORATION DECK -->
    <div class="office-hero-banner">
        <div class="office-hero-glow-1"></div>
        <div class="office-hero-glow-2"></div>

        <div class="office-hero-content position-relative">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="office-live-beacon">
                        <span class="beacon-dot"></span>
                        WORKPLACE PULSE • ACTIVE SYNC
                    </span>
                    <span class="office-status-pill"><i class="bi bi-chat-dots-fill text-success me-1"></i>Chat & SignalR Live</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="/office" class="btn btn-outline-light btn-sm rounded-pill px-3 py-1" style="font-size: 0.78rem; border-color: rgba(255,255,255,0.3); background: rgba(255,255,255,0.08);">
                        <i class="fas fa-th-large me-1"></i>All Forms &amp; Directory
                    </a>
                    <div class="office-date-badge">
                        <i class="bi bi-calendar3 me-1 text-info"></i>
                        <span>@DateTime.Now.ToString("dddd, dd MMM yyyy")</span>
                        <span class="mx-1 text-secondary">•</span>
                        <span class="text-light fw-bold">@DateTime.Now.ToString("HH:mm")</span>
                    </div>
                </div>
            </div>

            <div class="row align-items-center g-3">
                <div class="col-lg-7">
                    <h2 class="office-title">
                        Office Collaboration Hub
                    </h2>
                    <p class="office-subtitle mb-3">
                        Welcome, <strong class="text-white">@(currentUser?.FullName ?? "Team Member")</strong>. Centralized workplace station for internal corporate communications, departmental channels, project task velocity, meeting rooms, and governance sign-offs.
                    </p>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="office-tag"><i class="bi bi-person-badge text-primary me-1"></i>@(currentUser?.JobTitle ?? "Staff Associate")</span>
                        <span class="office-tag"><i class="bi bi-building text-info me-1"></i>@(currentUser?.Department?.Name ?? "General Operations")</span>
                        <span class="office-tag"><i class="bi bi-envelope text-success me-1"></i>@(currentUser?.Email ?? "")</span>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="office-quick-actions-card">
                        <div class="text-xs text-uppercase tracking-wider fw-bold text-muted mb-2" style="font-size: 0.68rem; letter-spacing: 0.8px;">
                            <i class="bi bi-lightning-charge-fill text-warning me-1"></i>WORKPLACE QUICK ACTIONS
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <a href="/office/messages" class="office-action-btn btn-indigo">
                                <i class="bi bi-chat-left-text"></i>
                                <span>New Message</span>
                            </a>
                            <a href="/office/channels" class="office-action-btn btn-teal">
                                <i class="bi bi-hash"></i>
                                <span>Channels</span>
                            </a>
                            <a href="/office/announcements" class="office-action-btn btn-blue">
                                <i class="bi bi-megaphone"></i>
                                <span>Post Bulletin</span>
                            </a>
                            <a href="/office/tasks" class="office-action-btn btn-amber">
                                <i class="bi bi-kanban"></i>
                                <span>Task Board</span>
                            </a>
                            <a href="/office/meetings" class="office-action-btn btn-rose">
                                <i class="bi bi-camera-video"></i>
                                <span>Schedule Meeting</span>
                            </a>
                            <a href="/office/minutes-approval" class="office-action-btn btn-emerald">
                                <i class="bi bi-file-earmark-check"></i>
                                <span>Sign Minutes</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. LIVE OFFICE RADAR MARQUEE -->
    <div class="office-radar-bar mb-4">
        <div class="office-radar-badge">
            <i class="bi bi-activity text-success me-1"></i>
            <span>OFFICE RADAR</span>
        </div>
        <div class="office-radar-content">
            <div class="radar-item">
                <i class="bi bi-chat-left-dots text-primary me-1"></i>
                <span><strong>@unreadMessages Unread Messages</strong> awaiting your response in Direct Messages</span>
            </div>
            <span class="radar-divider">•</span>
            <div class="radar-item">
                <i class="bi bi-kanban text-warning me-1"></i>
                <span><strong>@pendingTasks Tasks in Queue</strong> across your active project boards</span>
            </div>
            <span class="radar-divider">•</span>
            <div class="radar-item">
                <i class="bi bi-camera-video text-danger me-1"></i>
                <span><strong>@upcomingMeetingsCount Meetings Scheduled</strong> for today and this week</span>
            </div>
            <span class="radar-divider">•</span>
            <div class="radar-item">
                <i class="bi bi-file-earmark-check text-info me-1"></i>
                <span><strong>@pendingMinutes Minutes Approvals</strong> assigned for your sign-off</span>
            </div>
        </div>
    </div>

    <!-- 3. FLASHY 6-CARD OFFICE KPI GRID -->
    <div class="row g-3 mb-4">
        <!-- KPI 1: Direct Messages -->
        <div class="col-xl-4 col-md-6">
            <a href="/office/messages" class="text-decoration-none">
                <div class="office-kpi-card kpi-purple">
                    <div class="kpi-top-bar"></div>
                    <div class="d-flex align-items-start justify-content-between">
                        <div>
                            <div class="kpi-tag-label">DIRECT COMMUNICATIONS</div>
                            <div class="kpi-main-val">@unreadMessages <span class="kpi-unit">Unread DMs</span></div>
                            <div class="kpi-sub-text">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">
                                    <i class="bi bi-chat-dots-fill me-1"></i>Real-Time Chat
                                </span>
                                <span class="text-muted small">Peer & Group Messages</span>
                            </div>
                        </div>
                        <div class="kpi-icon-orb orb-purple">
                            <i class="bi bi-chat-dots"></i>
                        </div>
                    </div>
                    <div class="kpi-link-arrow mt-3">
                        <span>Open Messages Inbox</span>
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </div>
            </a>
        </div>

        <!-- KPI 2: Active Channels -->
        <div class="col-xl-4 col-md-6">
            <a href="/office/channels" class="text-decoration-none">
                <div class="office-kpi-card kpi-emerald">
                    <div class="kpi-top-bar"></div>
                    <div class="d-flex align-items-start justify-content-between">
                        <div>
                            <div class="kpi-tag-label">TEAM CHANNELS</div>
                            <div class="kpi-main-val">@channelCount <span class="kpi-unit">Channels</span></div>
                            <div class="kpi-sub-text">
                                <span class="badge bg-success-subtle text-success border border-success-subtle me-1">
                                    <i class="bi bi-people-fill me-1"></i>Collaborative
                                </span>
                                <span class="text-muted small">Department Workspaces</span>
                            </div>
                        </div>
                        <div class="kpi-icon-orb orb-emerald">
                            <i class="bi bi-hash"></i>
                        </div>
                    </div>
                    <div class="kpi-link-arrow mt-3">
                        <span>Explore Channels</span>
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </div>
            </a>
        </div>

        <!-- KPI 3: Announcements -->
        <div class="col-xl-4 col-md-6">
            <a href="/office/announcements" class="text-decoration-none">
                <div class="office-kpi-card kpi-blue">
                    <div class="kpi-top-bar"></div>
                    <div class="d-flex align-items-start justify-content-between">
                        <div>
                            <div class="kpi-tag-label">COMPANY BULLETINS</div>
                            <div class="kpi-main-val">@announcementCount <span class="kpi-unit">Bulletins</span></div>
                            <div class="kpi-sub-text">
                                <span class="badge bg-info-subtle text-info border border-info-subtle me-1">
                                    <i class="bi bi-megaphone-fill me-1"></i>Official
                                </span>
                                <span class="text-muted small">Corporate Directives</span>
                            </div>
                        </div>
                        <div class="kpi-icon-orb orb-blue">
                            <i class="bi bi-megaphone"></i>
                        </div>
                    </div>
                    <div class="kpi-link-arrow mt-3">
                        <span>View Announcements</span>
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </div>
            </a>
        </div>

        <!-- KPI 4: Pending Tasks -->
        <div class="col-xl-4 col-md-6">
            <a href="/office/tasks" class="text-decoration-none">
                <div class="office-kpi-card kpi-amber">
                    <div class="kpi-top-bar"></div>
                    <div class="d-flex align-items-start justify-content-between">
                        <div>
                            <div class="kpi-tag-label">MY ACTIVE TASKS</div>
                            <div class="kpi-main-val">@pendingTasks <span class="kpi-unit">In Queue</span></div>
                            <div class="kpi-sub-text">
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle me-1">
                                    <i class="bi bi-clock-history me-1"></i>Action Required
                                </span>
                                <span class="text-muted small">Assigned To Me</span>
                            </div>
                        </div>
                        <div class="kpi-icon-orb orb-amber">
                            <i class="bi bi-kanban"></i>
                        </div>
                    </div>
                    <div class="kpi-link-arrow mt-3">
                        <span>Go to Kanban Board</span>
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </div>
            </a>
        </div>

        <!-- KPI 5: Upcoming Meetings -->
        <div class="col-xl-4 col-md-6">
            <a href="/office/meetings" class="text-decoration-none">
                <div class="office-kpi-card kpi-rose">
                    <div class="kpi-top-bar"></div>
                    <div class="d-flex align-items-start justify-content-between">
                        <div>
                            <div class="kpi-tag-label">CONFERENCE MEETINGS</div>
                            <div class="kpi-main-val">@upcomingMeetingsCount <span class="kpi-unit">Scheduled</span></div>
                            <div class="kpi-sub-text">
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle me-1">
                                    <i class="bi bi-camera-video-fill me-1"></i>Video Rooms
                                </span>
                                <span class="text-muted small">WebRTC Live Sessions</span>
                            </div>
                        </div>
                        <div class="kpi-icon-orb orb-rose">
                            <i class="bi bi-camera-video"></i>
                        </div>
                    </div>
                    <div class="kpi-link-arrow mt-3">
                        <span>View Schedule</span>
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </div>
            </a>
        </div>

        <!-- KPI 6: Pending Minutes -->
        <div class="col-xl-4 col-md-6">
            <a href="/office/minutes-list" class="text-decoration-none">
                <div class="office-kpi-card kpi-gold">
                    <div class="kpi-top-bar"></div>
                    <div class="d-flex align-items-start justify-content-between">
                        <div>
                            <div class="kpi-tag-label">MINUTES APPROVALS</div>
                            <div class="kpi-main-val">@pendingMinutes <span class="kpi-unit">Awaiting</span></div>
                            <div class="kpi-sub-text">
                                <span class="badge bg-warning-subtle text-dark border border-warning-subtle me-1">
                                    <i class="bi bi-pen-fill me-1"></i>Governance
                                </span>
                                <span class="text-muted small">Sign-off Approvals</span>
                            </div>
                        </div>
                        <div class="kpi-icon-orb orb-gold">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>
                    </div>
                    <div class="kpi-link-arrow mt-3">
                        <span>Review Minutes List</span>
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- 4. DUAL PRODUCTIVITY & CONFERENCES SUITE -->
    <div class="row g-4 mb-4">
        <!-- Left: Task Workload Distribution Donut Chart -->
        <div class="col-lg-5">
            <div class="office-panel-card h-100 p-4">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <div>
                        <h6 class="fw-bold mb-1 text-dark">
                            <i class="bi bi-pie-chart-fill text-primary me-2"></i>My Task Workload Distribution
                        </h6>
                        <span class="text-muted text-xs" style="font-size: 0.78rem;">Status breakdown across assigned projects</span>
                    </div>
                    <a href="/office/tasks" class="btn btn-outline-primary btn-xs rounded-pill px-2 py-1" style="font-size: 0.72rem;">Board →</a>
                </div>

                <div class="chart-canvas-container position-relative d-flex align-items-center justify-content-center" style="height: 200px;">
                    <canvas id="officeTaskChart"></canvas>
                    <div class="position-absolute top-50 start-50 translate-middle text-center" style="pointer-events: none;">
                        <span class="d-block fw-bold fs-3 text-dark mb-0 lh-1">@(myTasks?.Count ?? 0)</span>
                        <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Total Tasks</small>
                    </div>
                </div>

                <div class="row g-2 mt-3 pt-2 border-top text-center">
                    <div class="col-4">
                        <span class="indicator-dot bg-warning me-1"></span>
                        <small class="text-muted d-block" style="font-size: 0.7rem;">Pending</small>
                        <span class="fw-bold text-dark fs-6">@(myTasks?.Count(t => t.Status == TaskItemStatus.Pending) ?? 0)</span>
                    </div>
                    <div class="col-4 border-start border-end">
                        <span class="indicator-dot bg-primary me-1"></span>
                        <small class="text-muted d-block" style="font-size: 0.7rem;">In Progress</small>
                        <span class="fw-bold text-primary fs-6">@(myTasks?.Count(t => t.Status == TaskItemStatus.InProgress) ?? 0)</span>
                    </div>
                    <div class="col-4">
                        <span class="indicator-dot bg-success me-1"></span>
                        <small class="text-muted d-block" style="font-size: 0.7rem;">Completed</small>
                        <span class="fw-bold text-success fs-6">@(myTasks?.Count(t => t.Status == TaskItemStatus.Completed) ?? 0)</span>
                    </div>
                </div>

                @{
                    int totalTasks = myTasks?.Count ?? 0;
                    int pCount = myTasks?.Count(t => t.Status == TaskItemStatus.Pending) ?? 0;
                    int ipCount = myTasks?.Count(t => t.Status == TaskItemStatus.InProgress) ?? 0;
                    int cCount = myTasks?.Count(t => t.Status == TaskItemStatus.Completed) ?? 0;
                    double pPct = totalTasks > 0 ? (double)pCount / totalTasks * 100 : 0;
                    double ipPct = totalTasks > 0 ? (double)ipCount / totalTasks * 100 : 0;
                    double cPct = totalTasks > 0 ? (double)cCount / totalTasks * 100 : 0;
                    int urgentCount = myTasks?.Count(t => t.Priority == TaskPriority.Urgent || t.Priority == TaskPriority.High) ?? 0;
                }

                <div class="mt-3 pt-2 border-top">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <small class="text-muted fw-semibold" style="font-size: 0.72rem;">Completion Rate</small>
                        <span class="badge bg-success-subtle text-success fw-bold" style="font-size: 0.72rem;">
                            @(totalTasks > 0 ? $"{Math.Round(cPct, 1)}%" : "0%")
                        </span>
                    </div>
                    <div class="progress" style="height: 6px; border-radius: 999px; background: rgba(0,0,0,0.06); overflow: hidden;">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: @pPct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%" title="Pending: @pCount"></div>
                        <div class="progress-bar bg-primary" role="progressbar" style="width: @ipPct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%" title="In Progress: @ipCount"></div>
                        <div class="progress-bar bg-success" role="progressbar" style="width: @cPct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%" title="Completed: @cCount"></div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mt-2 pt-1 text-muted" style="font-size: 0.72rem;">
                        <span><i class="bi bi-fire text-danger me-1"></i>Urgent / High: <strong class="text-dark">@urgentCount</strong></span>
                        <span><i class="bi bi-clock-history text-primary me-1"></i>Active: <strong class="text-primary">@(pCount + ipCount)</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Upcoming Executive Meetings & Conferences -->
        <div class="col-lg-7">
            <div class="office-panel-card h-100 p-4">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <div>
                        <h6 class="fw-bold mb-1 text-dark">
                            <i class="bi bi-camera-video-fill text-danger me-2"></i>Upcoming Conferences & Rooms
                        </h6>
                        <span class="text-muted text-xs" style="font-size: 0.78rem;">Scheduled live WebRTC conference rooms</span>
                    </div>
                    <a href="/office/meetings" class="btn btn-outline-danger btn-xs rounded-pill px-2 py-1" style="font-size: 0.72rem;">Schedule →</a>
                </div>

                @if (upcomingMeetings == null || !upcomingMeetings.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-calendar-check fs-2 text-secondary d-block mb-1"></i>
                        <span class="fw-semibold">No upcoming meetings scheduled</span>
                        <p class="text-xs mb-0">Use "+ Schedule Meeting" to start or book a conference.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var meeting in upcomingMeetings.Take(3))
                        {
                            <div class="office-meeting-card p-3 rounded-3 border d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="meeting-time-block">
                                        <div class="mt-hour">@meeting.ScheduledStartTime.ToLocalTime().ToString("HH:mm")</div>
                                        <div class="mt-period">@meeting.ScheduledStartTime.ToLocalTime().ToString("tt")</div>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark" style="font-size: 0.88rem;">@meeting.Title</div>
                                        <div class="text-muted text-xs mt-1" style="font-size: 0.75rem;">
                                            <i class="bi bi-calendar-event me-1"></i>@meeting.ScheduledStartTime.ToLocalTime().ToString("MMM dd, yyyy")
                                            <span class="mx-1">•</span>
                                            <i class="bi bi-person me-1"></i>Host: @(meeting.OrganizerName ?? "Executive Host")
                                        </div>
                                    </div>
                                </div>
                                <a href="/office/meetings/live/@meeting.Id" class="btn btn-success btn-sm rounded-pill px-3 py-1 fw-bold" style="font-size: 0.75rem;">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Join Room
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 5. SPLIT OPERATIONAL ACTIVITY CENTERS -->
    <div class="row g-4 mb-4">
        <!-- Left Column: Tasks & Announcements -->
        <div class="col-lg-6">
            <!-- Active Tasks -->
            <div class="office-panel-card mb-4">
                <div class="panel-header d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <div class="panel-icon bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-kanban"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0 text-dark">My Active Tasks</h6>
                            <small class="text-muted" style="font-size: 0.72rem;">Tasks assigned to you awaiting completion</small>
                        </div>
                    </div>
                    <a href="/office/tasks" class="btn btn-outline-warning btn-sm rounded-pill px-3" style="font-size: 0.75rem;">
                        View All
                    </a>
                </div>

                <div class="panel-body p-3">
                    @if (myTasks == null || !myTasks.Any())
                    {
                        <div class="p-3 text-center text-muted">
                            <i class="bi bi-check2-circle text-success fs-2 d-block mb-1"></i>
                            <span>All tasks caught up!</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var task in myTasks.Take(5))
                            {
                                <div class="task-item-card p-2 rounded-3 border d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2 flex-grow-1 text-truncate">
                                        <span class="badge @(task.Priority == TaskPriority.Urgent ? "bg-danger" : task.Priority == TaskPriority.High ? "bg-warning text-dark" : "bg-light text-muted border") text-xs">
                                            @task.Priority
                                        </span>
                                        <span class="fw-semibold text-dark text-truncate" style="font-size: 0.85rem;">@task.Title</span>
                                    </div>
                                    <span class="badge @(task.Status == TaskItemStatus.InProgress ? "bg-primary-subtle text-primary border border-primary-subtle" : task.Status == TaskItemStatus.Pending ? "bg-warning-subtle text-warning border border-warning-subtle" : "bg-success-subtle text-success") text-xs ms-2">
                                        @task.Status
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Recent Bulletins -->
            <div class="office-panel-card">
                <div class="panel-header d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <div class="panel-icon bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-megaphone"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0 text-dark">Recent Announcements</h6>
                            <small class="text-muted" style="font-size: 0.72rem;">Company-wide directives & official communications</small>
                        </div>
                    </div>
                    <a href="/office/announcements" class="btn btn-outline-primary btn-sm rounded-pill px-3" style="font-size: 0.75rem;">
                        View All
                    </a>
                </div>

                <div class="panel-body p-3">
                    @if (recentAnnouncements == null || !recentAnnouncements.Any())
                    {
                        <div class="p-3 text-center text-muted">No announcements posted.</div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var ann in recentAnnouncements.Take(3))
                            {
                                <div class="announcement-item-card p-3 rounded-3 border">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="fw-bold text-dark" style="font-size: 0.85rem;">@ann.Title</span>
                                        <span class="badge @(ann.Priority == AnnouncementPriority.Critical ? "bg-danger" : ann.Priority == AnnouncementPriority.Important ? "bg-warning text-dark" : "bg-light text-muted border") text-xs">
                                            @ann.Priority
                                        </span>
                                    </div>
                                    <p class="text-muted mb-1 text-truncate" style="font-size: 0.78rem;">@ann.Content</p>
                                    <div class="d-flex align-items-center justify-content-between text-muted" style="font-size: 0.7rem;">
                                        <span><i class="bi bi-person me-1"></i>@(ann.CreatorName ?? "Corporate Board")</span>
                                        <span><i class="bi bi-clock me-1"></i>@ann.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: WhatsApp & Smart Sticky Reminders -->
        <div class="col-lg-6">
            <!-- WhatsApp Enterprise Gateway -->
            <div class="office-panel-card mb-4" style="border: 1px solid rgba(255, 255, 255, 0.08); background: rgba(18, 24, 38, 0.7); backdrop-filter: blur(16px); border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);">
                <div class="panel-header d-flex align-items-center justify-content-between p-3" style="border-bottom: 1px solid rgba(255, 255, 255, 0.08); background: rgba(255, 255, 255, 0.02);">
                    <div class="d-flex align-items-center gap-2">
                        <div class="panel-icon d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; border-radius: 10px; background: rgba(37, 211, 102, 0.15); color: #25D366; font-size: 1.25rem;">
                            <i class="bi bi-whatsapp"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0 text-white" style="font-size: 0.95rem;">WhatsApp Enterprise Notification Gateway</h6>
                            <small class="text-white-50" style="font-size: 0.72rem;">Automated mobile alerts for tasks & corporate approvals</small>
                        </div>
                    </div>
                    @if (whatsAppStatus == "CONNECTED")
                    {
                        <span class="badge bg-success text-white px-3 py-1 rounded-pill" style="font-size: 0.72rem; letter-spacing: 0.5px; box-shadow: 0 0 10px rgba(37, 211, 102, 0.4);">
                            <i class="bi bi-check-circle me-1"></i>CONNECTED
                        </span>
                    }
                    else if (whatsAppStatus == "QR_READY")
                    {
                        <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px; box-shadow: 0 0 10px rgba(245, 158, 11, 0.4);">
                            <i class="bi bi-qr-code-scan me-1"></i>QR READY - SCAN NOW
                        </span>
                    }
                    else if (whatsAppStatus == "INITIALIZING")
                    {
                        <span class="badge bg-info text-dark px-3 py-1 rounded-pill" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            <i class="bi bi-hourglass-split me-1"></i>INITIALIZING...
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger text-white px-3 py-1 rounded-pill" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            <i class="bi bi-exclamation-triangle me-1"></i>DISCONNECTED
                        </span>
                    }
                </div>

                <div class="panel-body p-3">
                    @if (whatsAppStatus == "CONNECTED")
                    {
                        <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background: rgba(37, 211, 102, 0.1); border: 1px solid rgba(37, 211, 102, 0.3);">
                            <i class="bi bi-check-circle-fill fs-1" style="color: #25D366;"></i>
                            <div>
                                <h6 class="fw-bold text-white mb-1" style="font-size: 0.92rem;">WhatsApp Gateway Active & Ready</h6>
                                <p class="text-white-50 text-xs mb-0">Automatic task assignments, minute approvals, and urgent reminders are delivered directly to WhatsApp via 127.0.0.1:3001.</p>
                            </div>
                        </div>
                    }
                    else if (whatsAppStatus == "QR_READY" && !string.IsNullOrEmpty(whatsAppQrUrl))
                    {
                        <div class="d-flex flex-column flex-sm-row align-items-center gap-3 p-3 rounded-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1);">
                            <div class="p-2 bg-white rounded-3 shadow-sm text-center" style="display: inline-block;">
                                <img src="@whatsAppQrUrl" alt="WhatsApp QR Code" style="width: 140px; height: 140px; display: block; border-radius: 6px;" />
                                <small class="text-muted fw-bold d-block mt-1" style="font-size: 0.65rem;">Scan with WhatsApp</small>
                            </div>
                            <div>
                                <h6 class="fw-bold text-white mb-1" style="font-size: 0.95rem;">Scan QR to Link WhatsApp</h6>
                                <ol class="text-white-50 text-xs mb-2 ps-3" style="font-size: 0.78rem; line-height: 1.5;">
                                    <li>Open <strong>WhatsApp</strong> on your phone</li>
                                    <li>Tap <strong>Menu (⋮)</strong> or <strong>Settings</strong> &gt; <strong>Linked Devices</strong></li>
                                    <li>Tap <strong>Link a Device</strong> and scan this QR code</li>
                                </ol>
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-2 py-1 text-xs">
                                    <i class="bi bi-broadcast me-1"></i>Live auto-detecting scan...
                                </span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.25);">
                            <div class="d-flex align-items-center gap-2">
                                <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
                                <div>
                                    <div class="text-white fw-bold" style="font-size: 0.82rem;">WhatsApp Service: @whatsAppStatus</div>
                                    <div class="text-white-50" style="font-size: 0.72rem;">@(string.IsNullOrWhiteSpace(whatsAppErrorMessage) ? "Waiting for gateway on port 3001..." : whatsAppErrorMessage)</div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-outline-light btn-sm rounded-pill px-3 py-1" @onclick="CheckWhatsAppStatus" style="font-size: 0.75rem;">
                                <i class="bi bi-arrow-clockwise me-1"></i>Retry
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Smart Sticky Reminders -->
            <div class="office-panel-card">
                <div class="panel-header d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <div class="panel-icon bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-bell-fill"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0 text-dark">Quick Smart Sticky Reminders</h6>
                            <small class="text-muted" style="font-size: 0.72rem;">Fast reminders with audio alerts & calendar sync</small>
                        </div>
                    </div>
                </div>

                <div class="panel-body p-3">
                    @if (!string.IsNullOrEmpty(reminderErrorMessage))
                    {
                        <div class="alert alert-danger py-1 px-2 text-xs mb-2">@reminderErrorMessage</div>
                    }

                    <div class="d-flex gap-2 mb-3">
                        <input type="text" class="form-control form-control-sm" placeholder="Add quick note or reminder..." @bind="newReminderContent" />
                        <input type="datetime-local" class="form-control form-control-sm" style="max-width: 175px;" @bind="newReminderTime" />
                        <button type="button" class="btn btn-primary btn-sm rounded-3 px-3" @onclick="AddReminder" title="Add Reminder">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-3" onclick="window.playReminderSound()" title="Test Chime">
                            <i class="bi bi-volume-up"></i>
                        </button>
                    </div>

                    @if (upcomingReminders != null && upcomingReminders.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var reminder in upcomingReminders)
                            {
                                <div class="reminder-item-card p-2 rounded-3 border d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="fw-semibold text-dark" style="font-size: 0.82rem;">@reminder.Content</div>
                                        <small class="text-muted" style="font-size: 0.7rem;">
                                            <i class="bi bi-alarm me-1 text-warning"></i>@(reminder.ReminderTime?.ToLocalTime().ToString("g") ?? "")
                                        </small>
                                    </div>
                                    <button class="btn btn-outline-danger btn-xs rounded-circle p-1" @onclick="() => DeleteReminder(reminder)" title="Dismiss">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-3 text-center text-muted">
                            <small>No active reminders. Add one above for automated alerts.</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>

<style>
